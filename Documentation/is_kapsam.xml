<?xml version="1.0" encoding="UTF-8"?>
<TeknikGereksinimDokumani>
  <Baslik>GİZLİ MÜŞTERİ / DEĞERLENDİRME PLATFORMU – TEKNİK GEREKSİNİM DÖKÜMANI</Baslik>

  <Bolum id="1">
    <Baslik>Amaç</Baslik>
    <Aciklama>
      Kurumların çağrı merkezi, şube ve saha operasyonlarında yapılan değerlendirmeleri
      tek bir dijital platform üzerinden toplamak, yönetmek, analiz etmek ve raporlamaktır.
    </Aciklama>
    <DegerlendirmeTurleri>
      <Tur>Gizli müşteri ziyaretleri</Tur>
      <Tur>Denetim kontrolleri</Tur>
      <Tur>Memnuniyet anketleri</Tur>
    </DegerlendirmeTurleri>
    <AnaModuller>
      <Modul id="1">Kontrol Listesi (Checklist &amp; Form Builder) Modülü</Modul>
      <Modul id="2">Atama Modülü (İç Değerlendirici + Dış Müşteri Anketi)</Modul>
      <Modul id="3">Dashboard &amp; Raporlama Modülü</Modul>
    </AnaModuller>
  </Bolum>

  <Bolum id="2">
    <Baslik>KONTROL LİSTESİ (FORM BUILDER) MODÜLÜ</Baslik>

    <AltBolum id="2.1">
      <Baslik>Form Türleri</Baslik>
      <Aciklama>Platform, farklı yapıda formlar oluşturulmasına izin vermelidir</Aciklama>
      <SoruTurleri>
        <SoruTuru>Puanlı sorular (admin soru başına puan/puan ağırlığı tanımlayabilir)</SoruTuru>
        <SoruTuru>Puansız / bilgi amaçlı sorular</SoruTuru>
      </SoruTurleri>
      <SoruTipleri>
        <Tip>Çoktan Seçmeli</Tip>
        <Tip>Likert (1-5, 1-7 vb.)</Tip>
        <Tip>Yıldızlı değerlendirme</Tip>
        <Tip>Metin alanı</Tip>
        <Tip>Evet / Hayır</Tip>
        <Tip>N/A (Gerekmedi) opsiyonu</Tip>
      </SoruTipleri>
    </AltBolum>

    <AltBolum id="2.2">
      <Baslik>Form Akışı</Baslik>
      <Ozellikler>
        <Ozellik>Formlar bölümlere ayrılabilir (Örn: Karşılama → Ağırlama → Uğurlama)</Ozellik>
        <Ozellik>Admin sınırsız bölüm ekleyebilir</Ozellik>
      </Ozellikler>
    </AltBolum>

    <AltBolum id="2.3">
      <Baslik>Puanlama Mantığı</Baslik>
      <AgirlikliPuanSistemi>
        <Aciklama>Her sorunun ağırlığı admin tarafından belirlenebilir</Aciklama>
      </AgirlikliPuanSistemi>
      <NAMantigi kritik="true">
        <Baslik>N/A Mantığı (Önemli Gereksinim)</Baslik>
        <Kurallar>
          <Kural>Bir soru N/A (Gerekmedi) işaretlendiğinde sorunun puanı toplam hesaplamadan tamamen çıkarılır</Kural>
          <Kural>Soru ağırlığı devre dışı kalır</Kural>
          <Kural>Formun toplam puanı hesaplanırken, N/A olan soruların ağırlığı kalan sorulara oransal olarak yeniden dağıtılır</Kural>
          <Kural>Kullanıcıya yansıtılan nihai puanda hiçbir adaletsizlik olmadan normalize edilmiş toplam puan verilir</Kural>
        </Kurallar>
      </NAMantigi>
    </AltBolum>

    <AltBolum id="2.4">
      <Baslik>Ek Özellikler</Baslik>
      <Ozellikler>
        <Ozellik>Soru kopyalama, bölüm kopyalama</Ozellik>
        <Ozellik opsiyonel="true">Form versiyonlama</Ozellik>
        <Ozellik>Zorunlu / zorunlu olmayan soru desteği</Ozellik>
        <Ozellik>Soruya açıklama / ipucu ekleme</Ozellik>
      </Ozellikler>
    </AltBolum>
  </Bolum>

  <Bolum id="3">
    <Baslik>ATAMA MODÜLÜ</Baslik>

    <AltBolum id="3.1">
      <Baslik>İç Değerlendiricilere Atama</Baslik>
      <AdminYetkileri>
        <Yetki>Bir kontrol listesini belirli değerlendiricilere atamak</Yetki>
        <AtamaParametreleri>
          <Parametre>Proje adı (örn. "2026 Q1 Gizli Müşteri Projesi")</Parametre>
          <Parametre>Şube/Lokasyon</Parametre>
          <Parametre>Değerlendirici seçimi</Parametre>
          <Parametre>Son tarih</Parametre>
        </AtamaParametreleri>
        <Yetki>Çoklu atama yapılabilmelidir (Excel yükleme ile toplu atama)</Yetki>
      </AdminYetkileri>
      <IslevselGereksinimler>
        <Gereksinim>Her değerlendiricinin kendi paneli vardır</Gereksinim>
        <Gereksinim>Değerlendirici sadece kendisine atanmış formları görür ve doldurur</Gereksinim>
        <Gereksinim>Form linki proje–değerlendirici ilişkisine göre tekil olarak üretilir</Gereksinim>
        <Gereksinim>Atanan formlar sistemde kaydedilir ve süresi takip edilir</Gereksinim>
      </IslevselGereksinimler>
    </AltBolum>

    <AltBolum id="3.2">
      <Baslik>Dış Müşterilere Gönderim (Memnuniyet Anketi)</Baslik>
      <GenelMantik>
        <Kural>Her müşteri için bireysel proje ataması yapılmaz</Kural>
        <Kural>Sistem tek bir açık form linki üretir</Kural>
        <DagitimKanallari>
          <Kanal>E-posta</Kanal>
          <Kanal>SMS</Kanal>
          <Kanal>QR kod</Kanal>
        </DagitimKanallari>
      </GenelMantik>
      <Kisitlar>
        <Kisit>Bir müşteri aynı formu yalnızca 1 kez doldurabilir</Kisit>
        <Kisit>Admin gerekirse kaydı silip kişiye tekrar doldurma hakkı verebilir</Kisit>
      </Kisitlar>
      <KaydetmeMantigi>
        <KayitAlani>Müşteri kimliği (ID, telefon, mail vb.)</KayitAlani>
        <KayitAlani>Form tarihi</KayitAlani>
        <KayitAlani>Soru bazlı cevaplar</KayitAlani>
      </KaydetmeMantigi>
    </AltBolum>
  </Bolum>

  <Bolum id="4">
    <Baslik>RAPORLAMA MODÜLÜ</Baslik>

    <AltBolum id="4.1">
      <Baslik>Admin Raporlama Yetkileri</Baslik>
      <Yetkiler>
        <Yetki>Tüm ham datayı Excel olarak indirebilir</Yetki>
        <Yetki>Her tekil değerlendirmeyi görüntüleyebilir</Yetki>
      </Yetkiler>
      <DegerlendirmeDetaylari>
        <Detay>Cevaplar</Detay>
        <Detay>Soru bazlı puanlar</Detay>
        <Detay>Toplam puan</Detay>
        <Detay>Açıklamalar</Detay>
        <Detay>Değerlendiricinin/şubenin bilgisi</Detay>
      </DegerlendirmeDetaylari>
      <FiltrelemeSecenekleri>
        <Filtre>Proje</Filtre>
        <Filtre>Şube</Filtre>
        <Filtre>Değerlendirici</Filtre>
        <Filtre>Tarih aralığı</Filtre>
        <Filtre>Bölge</Filtre>
        <Filtre>Form tipi</Filtre>
      </FiltrelemeSecenekleri>
    </AltBolum>

    <AltBolum id="4.2">
      <Baslik>PowerPoint Rapor Çıktısı</Baslik>
      <Aciklama>Sistem tüm verilerden otomatik olarak grafiklerle PPT üretebilmelidir</Aciklama>
      <GrafikTurleri>
        <Grafik>Aylık ortalama puan grafikleri</Grafik>
        <Grafik>Bölge/şube karşılaştırmaları</Grafik>
        <Grafik>En yüksek/en düşük performans listeleri</Grafik>
        <Grafik>Trend çizgileri</Grafik>
      </GrafikTurleri>
    </AltBolum>
  </Bolum>

  <Bolum id="5">
    <Baslik>DASHBOARD MODÜLÜ</Baslik>
    <Aciklama>Dashboard rol bazlı görünüm sağlar</Aciklama>

    <AltBolum id="5.1">
      <Baslik>Yönetici Ekranı</Baslik>
      <KPIAlanlari>
        <KPI>Toplam ziyaret sayısı</KPI>
        <KPI>Genel ortalama puan</KPI>
        <KPI>Bir önceki aya göre artış/azalış yüzdesi</KPI>
        <KPI>En yüksek puanlı ilk 5 şube</KPI>
        <KPI>En düşük puanlı son 5 şube</KPI>
      </KPIAlanlari>
      <Grafikler>
        <Grafik tip="cizgi">
          <Baslik>Aylık Performans Trend Grafiği</Baslik>
          <XEkseni>Aylar (son 12 ay)</XEkseni>
          <YEkseni>Ortalama toplam puan</YEkseni>
          <Tooltip>Ay bazlı detaylar (ziyaret sayısı, ortalama puan)</Tooltip>
        </Grafik>
        <Grafik tip="cubuk">
          <Baslik>Bölge / Şube Karşılaştırma Grafiği</Baslik>
          <Veri>Şube veya bölge ortalama puanları</Veri>
          <Filtreler>
            <Filtre>Bölge</Filtre>
            <Filtre>Tarih aralığı</Filtre>
            <Filtre>Proje adı</Filtre>
          </Filtreler>
        </Grafik>
      </Grafikler>
    </AltBolum>

    <AltBolum id="5.2">
      <Baslik>Takım Lideri Görünümü</Baslik>
      <Aciklama>Yönetici ekranındaki tüm metrikler yalnızca kendi bağlı olduğu şubeler için görünür</Aciklama>
    </AltBolum>

    <AltBolum id="5.3">
      <Baslik>Müşteri Temsilcisi Görünümü</Baslik>
      <Kurallar>
        <Kural>Sadece kendi yaptığı değerlendirmeleri görür</Kural>
        <Kural>Başkasının verisine erişemez</Kural>
      </Kurallar>
    </AltBolum>
  </Bolum>

  <Bolum id="6">
    <Baslik>TEKNİK GEREKSİNİMLER (ÖNERİLEN)</Baslik>

    <AltBolum id="6.1">
      <Baslik>Kullanıcı Rolleri</Baslik>
      <Roller>
        <Rol>Admin</Rol>
        <Rol>Takım Lideri</Rol>
        <Rol>Değerlendirici (İç)</Rol>
        <Rol>Müşteri Temsilcisi</Rol>
        <Rol>Dış Müşteri (Anonim)</Rol>
      </Roller>
    </AltBolum>

    <AltBolum id="6.2">
      <Baslik>Yetkilendirme &amp; Güvenlik</Baslik>
      <Gereksinimler>
        <Gereksinim>JWT veya OAuth2 tabanlı kimlik doğrulama</Gereksinim>
        <Gereksinim>API tabanlı modüler mimari</Gereksinim>
        <Gereksinim>Form linkleri tekil token ile korunmalıdır</Gereksinim>
      </Gereksinimler>
    </AltBolum>

    <AltBolum id="6.3">
      <Baslik>Veri Yapısı (Özet)</Baslik>
      <Entityler>
        <Entity name="Form">
          <Alan>FormID</Alan>
          <Alan>Form Adı</Alan>
          <Alan>Bölümler[]</Alan>
          <Alan>Sorular[] (Tip, Ağırlık, Puan, Zorunlu, N/A desteği)</Alan>
        </Entity>
        <Entity name="Atama">
          <Alan>AssignmentID</Alan>
          <Alan>Proje</Alan>
          <Alan>FormID</Alan>
          <Alan>Şube</Alan>
          <Alan>Değerlendirici</Alan>
          <Alan>Deadline</Alan>
          <Alan>Status</Alan>
        </Entity>
        <Entity name="Cevap">
          <Alan>ResponseID</Alan>
          <Alan>AssignmentID veya Anonim Müşteri ID</Alan>
          <Alan>Soru Cevapları[]</Alan>
          <Alan>Toplam Puan (N/A normalize edilmiş)</Alan>
        </Entity>
      </Entityler>
    </AltBolum>
  </Bolum>

  <Bolum id="7">
    <Baslik>EK ÖZELLİKLER</Baslik>
    <Ozellikler>
      <Ozellik>Mobil uyumlu form doldurma</Ozellik>
      <Ozellik opsiyonel="true">Offline doldurup online olunca senkronlama</Ozellik>
      <Ozellik>API ile CRM entegrasyonuna açık yapı</Ozellik>
      <Ozellik>Inspect/History: Form kim tarafından ne zaman dolduruldu logları</Ozellik>
    </Ozellikler>
  </Bolum>

  <Bolum id="8">
    <Baslik>ÖZET</Baslik>
    <Aciklama>
      Bu dökümantasyon, geliştiricinin rahatlıkla kullanıcı arayüzlerini, API endpoint'lerini,
      veri modelini ve iş kurallarını tasarlayabileceği kadar detaylı hazırlanmıştır.
      Her modül kapsamı net, iş mantığı tam ve gereksinimler eksiksiz şekilde açıklanmıştır.
    </Aciklama>
  </Bolum>

</TeknikGereksinimDokumani>
