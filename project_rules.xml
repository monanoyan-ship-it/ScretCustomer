<?xml version="1.0" encoding="UTF-8"?>
<ProjectRules>
  <ProjectInfo>
    <Name>SecretCustomer - Gizli Müşteri Değerlendirme Sistemi</Name>
    <Type>.NET Core 9.0 MVC + Web API</Type>
    <Architecture>Clean Architecture (Core, Data, Services, API)</Architecture>
    <Database>PostgreSQL 15+ with Entity Framework Core</Database>
    <Frontend>KnockoutJS 3.5.1 MVVM + Bootstrap 5.3.0</Frontend>
    <Pattern>SPA (Single Page Application) with Razor Views</Pattern>
    <Authentication>Dual (Cookie-based for MVC, JWT for API)</Authentication>
    <LastUpdated>2025-12-06</LastUpdated>
  </ProjectInfo>

  <CriticalRules>
    <Rule id="R001" priority="CRITICAL">
      <Title>NO HTML FILES - Use Razor Views Only</Title>
      <Description>This is a .NET MVC project. NEVER create standalone HTML files (index.html, templates/*.html). Always use Razor Views (.cshtml).</Description>
      <Forbidden>
        <Item>Frontend/wwwroot/index.html</Item>
        <Item>Frontend/wwwroot/templates/*.html</Item>
        <Item>Any standalone HTML files</Item>
      </Forbidden>
      <Correct>
        <Item>Backend/SecretCustomer.API/Views/**/*.cshtml</Item>
        <Item>Use Razor syntax with @model, @section Scripts, etc.</Item>
      </Correct>
    </Rule>

    <Rule id="R002" priority="CRITICAL">
      <Title>NO Separate Frontend Folder</Title>
      <Description>All frontend assets MUST be in Backend/SecretCustomer.API/wwwroot/</Description>
      <Forbidden>
        <Item>Frontend/ folder at root level</Item>
        <Item>Separate wwwroot outside of API project</Item>
      </Forbidden>
      <Correct>
        <Item>Backend/SecretCustomer.API/wwwroot/js/</Item>
        <Item>Backend/SecretCustomer.API/wwwroot/css/</Item>
        <Item>Backend/SecretCustomer.API/Views/</Item>
      </Correct>
    </Rule>

    <Rule id="R003" priority="CRITICAL">
      <Title>JavaScript File Naming Convention</Title>
      <Description>Use descriptive names, avoid generic "Index.js". Each module has ONE main JS file.</Description>
      <Forbidden>
        <Item>Customers/Index.js (duplicate with customers.js)</Item>
        <Item>Dashboard/Index.js (duplicate with dashboard.js)</Item>
        <Item>Generic naming that conflicts</Item>
      </Forbidden>
      <Correct>
        <Item>Customers/customers.js (main ViewModel)</Item>
        <Item>CustomerPersonnel/customer-personnel.js</Item>
        <Item>Dashboard/dashboard.js</Item>
        <Item>Shared/customer.api.service.js (descriptive service name)</Item>
      </Correct>
    </Rule>

    <Rule id="R004" priority="HIGH">
      <Title>SPA Pattern - No Page Refreshes</Title>
      <Description>All CRUD operations happen via AJAX with KnockoutJS. Use Bootstrap modals for forms. NO separate pages for create/edit/delete.</Description>
      <Implementation>
        <Item>Use KnockoutJS observables and computed observables</Item>
        <Item>All forms in Bootstrap modals</Item>
        <Item>AJAX calls via Shared/api.service.js</Item>
        <Item>Update observable arrays after CRUD operations</Item>
      </Implementation>
    </Rule>

    <Rule id="R005" priority="HIGH">
      <Title>Clean Architecture Layers</Title>
      <Description>Maintain strict separation of concerns across layers</Description>
      <Layers>
        <Layer name="Core">
          <Path>Backend/SecretCustomer.Core/</Path>
          <Contains>Entities, DTOs, Enums, Interfaces</Contains>
          <Dependencies>None (zero dependencies)</Dependencies>
        </Layer>
        <Layer name="Data">
          <Path>Backend/SecretCustomer.Data/</Path>
          <Contains>DbContext, Repositories, Configurations, Migrations</Contains>
          <Dependencies>Core, EF Core</Dependencies>
        </Layer>
        <Layer name="Services">
          <Path>Backend/SecretCustomer.Services/</Path>
          <Contains>Business logic, Service implementations</Contains>
          <Dependencies>Core, Data</Dependencies>
        </Layer>
        <Layer name="API">
          <Path>Backend/SecretCustomer.API/</Path>
          <Contains>Controllers, Views, ViewModels, wwwroot</Contains>
          <Dependencies>Core, Services</Dependencies>
        </Layer>
      </Layers>
    </Rule>
  </CriticalRules>

  <FileStructure>
    <Directory path="Backend/SecretCustomer.API/wwwroot/js/">
      <Folder name="Shared">
        <Description>Ortak servisler - tüm modüller tarafından kullanılır</Description>
        <Files>
          <File>api.service.js - Generic API wrapper (GET, POST, PUT, DELETE)</File>
          <File>auth.service.js - Authentication service</File>
          <File>customer.api.service.js - Customer-specific API calls</File>
        </Files>
      </Folder>
      <Folder name="Account">
        <Description>Login, register işlemleri</Description>
        <Files>
          <File>login.js - Login ViewModel</File>
        </Files>
      </Folder>
      <Folder name="Customers">
        <Description>Müşteri yönetimi</Description>
        <Files>
          <File>customers.js - Customer CRUD ViewModel (NO Index.js)</File>
        </Files>
      </Folder>
      <Folder name="CustomerPersonnel">
        <Description>Müşteri personeli yönetimi</Description>
        <Files>
          <File>customer-personnel.js - Personnel CRUD ViewModel</File>
        </Files>
      </Folder>
      <Folder name="Dashboard">
        <Description>Dashboard ve raporlama</Description>
        <Files>
          <File>dashboard.js - Dashboard ViewModel (NO Index.js)</File>
        </Files>
      </Folder>
      <Folder name="Checklists">
        <Description>Kontrol listeleri</Description>
        <Files>
          <File>checklist.js - Checklist ViewModel</File>
        </Files>
      </Folder>
      <File>sidebar.js - Sidebar navigation logic</File>
    </Directory>

    <Directory path="Backend/SecretCustomer.API/Views/">
      <Folder name="Shared">
        <Files>
          <File>_Layout.cshtml - Master layout</File>
          <File>_ValidationScriptsPartial.cshtml</File>
        </Files>
      </Folder>
      <Folder name="Customers">
        <Files>
          <File>Index.cshtml - Main customer page with KnockoutJS bindings</File>
        </Files>
      </Folder>
      <Folder name="CustomerPersonnel">
        <Files>
          <File>Index.cshtml - Personnel management page</File>
        </Files>
      </Folder>
      <Note>Each view uses @section Scripts {} to load module-specific JS files</Note>
    </Directory>
  </FileStructure>

  <NamingConventions>
    <Backend>
      <Entities>PascalCase (Customer, CustomerPersonnel, Branch)</Entities>
      <Properties>PascalCase (CompanyName, TaxNumber, CreatedAt)</Properties>
      <Methods>PascalCase (GetAllAsync, CreateAsync, UpdateAsync)</Methods>
      <Interfaces>I + PascalCase (ICustomerService, IRepository&lt;T&gt;)</Interfaces>
      <DTOs>EntityName + Dto (CreateCustomerDto, UpdateCustomerDto)</DTOs>
      <ApiControllers>Plural + ApiController (CustomersApiController)</ApiControls>
      <MvcControllers>Plural + Controller (CustomersController)</MvcControllers>
    </Backend>
    <Frontend>
      <Files>kebab-case (customer-personnel.js, api.service.js)</Files>
      <ViewModels>camelCase with ViewModel suffix (customersViewModel)</ViewModels>
      <Observables>camelCase (customers, selectedCustomer, isLoading)</Observables>
      <Functions>camelCase (loadCustomers, saveCustomer, deleteCustomer)</Functions>
      <ApiService>camelCase with descriptive name (getAllCustomers, getCustomerById)</ApiService>
    </Frontend>
  </NamingConventions>

  <TechnicalPatterns>
    <Pattern name="Repository Pattern">
      <Description>Generic repository with specific implementations</Description>
      <Implementation>
        <Interface>IRepository&lt;T&gt; in Core/Interfaces/</Interface>
        <GenericImpl>Repository&lt;T&gt; in Data/Repositories/</GenericImpl>
        <SpecificImpl>CustomerRepository, BranchRepository, etc.</SpecificImpl>
      </Implementation>
    </Pattern>

    <Pattern name="Service Layer">
      <Description>Business logic separated from controllers</Description>
      <Implementation>
        <Interface>I{Entity}Service in Core/Interfaces/</Interface>
        <Implementation>{Entity}Service in Services/Services/</Implementation>
        <DI>Register in Program.cs with scoped lifetime</DI>
      </Implementation>
    </Pattern>

    <Pattern name="DTO Pattern">
      <Description>Separate DTOs for Create and Update operations</Description>
      <Implementation>
        <CreateDto>CreateCustomerDto - for POST requests</CreateDto>
        <UpdateDto>UpdateCustomerDto - for PUT requests</UpdateDto>
        <Validation>Use DataAnnotations ([Required], [MaxLength], etc.)</Validation>
      </Implementation>
    </Pattern>

    <Pattern name="KnockoutJS MVVM">
      <Description>Observable-based reactive UI without page refreshes</Description>
      <Implementation>
        <ViewModel>Define ViewModel with ko.observable() and ko.observableArray()</ViewModel>
        <Binding>Use data-bind attributes in Razor views</Binding>
        <Apply>ko.applyBindings(viewModel) after DOM ready</Apply>
        <Modal>Bootstrap modals for all forms (create, edit)</Modal>
        <AJAX>All API calls via Shared/api.service.js</AJAX>
      </Implementation>
    </Pattern>

    <Pattern name="API Response Structure">
      <Description>Consistent API response format</Description>
      <Success>
        <Code>200 OK, 201 Created</Code>
        <Body>Return DTO or list of DTOs</Body>
      </Success>
      <Error>
        <Code>400 Bad Request, 404 Not Found, 500 Internal Server Error</Code>
        <Body>{ "message": "Error description" }</Body>
      </Error>
    </Pattern>
  </TechnicalPatterns>

  <CommonMistakes>
    <Mistake id="M001">
      <Description>Creating separate HTML files for SPA</Description>
      <Wrong>Frontend/wwwroot/templates/customers.html</Wrong>
      <Correct>Backend/SecretCustomer.API/Views/Customers/Index.cshtml</Correct>
      <Reason>This is a .NET MVC project, not a pure SPA. Use Razor Views.</Reason>
    </Mistake>

    <Mistake id="M002">
      <Description>Creating duplicate Index.js files</Description>
      <Wrong>Customers/Index.js AND Customers/customers.js</Wrong>
      <Correct>Only Customers/customers.js</Correct>
      <Reason>Avoid naming conflicts and confusion</Reason>
    </Mistake>

    <Mistake id="M003">
      <Description>Putting frontend code in separate Frontend folder</Description>
      <Wrong>Frontend/wwwroot/js/</Wrong>
      <Correct>Backend/SecretCustomer.API/wwwroot/js/</Correct>
      <Reason>.NET Core serves static files from API project's wwwroot</Reason>
    </Mistake>

    <Mistake id="M004">
      <Description>Navigating to different pages for CRUD operations</Description>
      <Wrong>Redirect to /Customers/Create, /Customers/Edit/{id}</Wrong>
      <Correct>Show Bootstrap modal, perform AJAX, update observable array</Correct>
      <Reason>SPA pattern - no page refreshes</Reason>
    </Mistake>

    <Mistake id="M005">
      <Description>Not using Shared services for common functionality</Description>
      <Wrong>Duplicate API call logic in each ViewModel</Wrong>
      <Correct>Centralize in Shared/customer.api.service.js</Correct>
      <Reason>DRY principle, easier maintenance</Reason>
    </Mistake>
  </CommonMistakes>

  <EntityRelationships>
    <Entity name="Customer">
      <Description>Müşteri şirketi</Description>
      <Relationships>
        <HasMany target="CustomerPersonnel">Customer'ın personelleri</HasMany>
        <HasMany target="Branch">Customer'ın şubeleri</HasMany>
        <HasMany target="Project">Customer'ın projeleri</HasMany>
        <HasMany target="CustomerTaskList">Customer'a özel görev listeleri</HasMany>
      </Relationships>
    </Entity>

    <Entity name="CustomerPersonnel">
      <Description>Müşteri personeli - müşterinin çalışanı</Description>
      <Relationships>
        <BelongsTo target="Customer">Hangi müşteriye ait</BelongsTo>
        <HasMany target="CustomerPersonnelTaskAssignment">Atanan görevler</HasMany>
        <HasMany target="CustomerPersonnelPermission">Yetkiler</HasMany>
      </Relationships>
      <Roles>
        <Role>Admin - Tam yetki</Role>
        <Role>Manager - Yönetici seviyesi</Role>
        <Role>Viewer - Sadece görüntüleme</Role>
      </Roles>
    </Entity>

    <Entity name="FieldWorker">
      <Description>Saha çalışanı - değerlendirme yapan kişi</Description>
      <Note>This is DIFFERENT from CustomerPersonnel. FieldWorker does evaluations, CustomerPersonnel belongs to customer company.</Note>
    </Entity>

    <Entity name="Assignment">
      <Description>Saha çalışanına verilen görev</Description>
      <Relationships>
        <BelongsTo target="FieldWorker">Hangi saha çalışanı</BelongsTo>
        <BelongsTo target="Branch">Hangi şube</BelongsTo>
        <BelongsTo target="Project">Hangi proje</BelongsTo>
        <BelongsTo target="Checklist">Hangi kontrol listesi</BelongsTo>
      </Relationships>
    </Entity>
  </EntityRelationships>

  <ScriptReferences>
    <RazorViewPattern>
      <Location>@section Scripts { ... } at bottom of .cshtml file</Location>
      <Order>
        <Step>1. Bootstrap bundle (if not in _Layout.cshtml)</Step>
        <Step>2. KnockoutJS (if not in _Layout.cshtml)</Step>
        <Step>3. Shared/api.service.js</Step>
        <Step>4. Shared/auth.service.js (if needed)</Step>
        <Step>5. Module-specific service (e.g., Shared/customer.api.service.js)</Step>
        <Step>6. Module ViewModel (e.g., Customers/customers.js)</Step>
      </Order>
      <Example><![CDATA[
@section Scripts {
    <script src="~/js/Shared/api.service.js"></script>
    <script src="~/js/Shared/customer.api.service.js"></script>
    <script src="~/js/Customers/customers.js"></script>
}
      ]]></Example>
    </RazorViewPattern>
  </ScriptReferences>

  <DevelopmentWorkflow>
    <NewFeature>
      <Step num="1">Create entity in Core/Entities/</Step>
      <Step num="2">Create DTOs in Core/DTOs/</Step>
      <Step num="3">Create interface in Core/Interfaces/</Step>
      <Step num="4">Create repository in Data/Repositories/</Step>
      <Step num="5">Create service in Services/Services/</Step>
      <Step num="6">Register DI in Program.cs</Step>
      <Step num="7">Create API controller in API/Controllers/Api/</Step>
      <Step num="8">Create MVC controller in API/Controllers/ (if needed)</Step>
      <Step num="9">Create Razor view in API/Views/{Module}/</Step>
      <Step num="10">Create API service in wwwroot/js/Shared/{module}.api.service.js</Step>
      <Step num="11">Create ViewModel in wwwroot/js/{Module}/{module}.js</Step>
      <Step num="12">Add navigation to sidebar</Step>
      <Step num="13">Test CRUD operations</Step>
    </NewFeature>
  </DevelopmentWorkflow>

