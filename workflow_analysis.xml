  <KeyBusinessProcesses>
    <Process name="MysteryShoppingEvaluation">
      <Description>Complete mystery shopping evaluation workflow</Description>
      <Steps>
        <Step order="1">Proje oluştur ve tanımla</Step>
        <Step order="2">Kontrol listesi oluştur (gruplar ve sorular)</Step>
        <Step order="3">Saha görevlisi ata</Step>
        <Step order="4">Görevlendirme (Assignment) oluştur</Step>
        <Step order="5">Saha görevlisi değerlendirme formunu doldurur</Step>
        <Step order="6">Sistem otomatik puan hesaplar</Step>
        <Step order="7">Raporlama ve analiz yapılır</Step>
      </Steps>
    </Process>

    <Process name="CallQualityAssurance">
      <Description>Call center quality assurance workflow</Description>
      <Steps>
        <Step order="1">Çağrı demeleme planı oluştur</Step>
        <Step order="2">Çağrı standartları kontrol listesi tanımla</Step>
        <Step order="3">Çağrı kayıtlarını değerlendir</Step>
        <Step order="4">Puan ve geri bildirim gir</Step>
        <Step order="5">ÇD raporlarını oluştur ve analiz et</Step>
      </Steps>
    </Process>
  </KeyBusinessProcesses>

