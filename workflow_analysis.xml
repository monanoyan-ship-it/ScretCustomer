    <!-- Checklist Management Module -->
    <Module id="checklist-management">
      <Name>Kontrol Listesi Yönetimi</Name>
      <Description>Creating and managing evaluation checklists with groups and questions</Description>
      <Entities>
        <Entity>Checklist</Entity>
        <Entity>Section (Group)</Entity>
        <Entity>Question</Entity>
      </Entities>
      <Features>
        <Feature>Grup bazlı soru organizasyonu</Feature>
        <Feature>Puanlama sistemi (Scoring system)</Feature>
        <Feature>Çoklu soru tipleri (Multiple question types)</Feature>
        <Feature>N/A (Uygulanamaz) seçeneği</Feature>
        <Feature>Belge ekleme (Document attachment)</Feature>
        <Feature>Zorunlu alan tanımlama</Feature>
        <Feature>Sıralama ve düzenleme</Feature>
      </Features>
      <QuestionTypes>
        <Type>Puanlı (Scored)</Type>
        <Type>Evet/Hayır (Yes/No)</Type>
        <Type>Metin (Text)</Type>
        <Type>Dropdown (Seçim listesi)</Type>
      </QuestionTypes>
      <ScoringSystem>
        <Rule>Her soru için Atanlı Puan (Assigned Points) tanımlanır</Rule>
        <Rule>Alınan Puan (Earned Points) değerlendirmede hesaplanır</Rule>
        <Rule>Sonuç tipi: Puan A, Puan B, Puan C, Puan E</Rule>
        <Rule>Toplam ve yüzdelik hesaplama</Rule>
      </ScoringSystem>
      <WorkflowSteps>
        <Step order="1">Kontrol listesi oluştur</Step>
        <Step order="2">Gruplar (Sections) ekle</Step>
        <Step order="3">Her gruba sorular ekle</Step>
        <Step order="4">Soru tipini ve puanı belirle</Step>
        <Step order="5">Sıralama ve önizleme</Step>
        <Step order="6">Kontrol listesini aktifleştir</Step>
      </WorkflowSteps>
      <Screenshots>
        <Screenshot>video1_frame_001.png</Screenshot>
        <Screenshot>video1_frame_008.png</Screenshot>
        <Screenshot>Screenshot 2025-11-24 165156.png</Screenshot>
        <Screenshot>Screenshot 2025-11-24 165209.png</Screenshot>
        <Screenshot>Screenshot 2025-11-24 172812.png</Screenshot>
      </Screenshots>
      <ModalFields>
        <Field name="Kontrol Grubu">Section/Group selection</Field>
        <Field name="Kontrol Sorusu">Question text</Field>
        <Field name="Notlar">Notes</Field>
        <Field name="Önerilen Açıklama">Suggested explanation dropdown</Field>
        <Field name="Yeniden Puan">Reassign points</Field>
        <Field name="N/A">Not applicable checkbox</Field>
        <Field name="Belge">Document upload area</Field>
      </ModalFields>
    </Module>

    <!-- Evaluation/Assessment Module -->
    <Module id="evaluation">
      <Name>Değerlendirme Formu</Name>
      <Description>Multi-page evaluation forms for conducting audits and mystery shopping with wizard-style stepper</Description>
      <Entities>
        <Entity>Evaluation</Entity>
        <Entity>Answer</Entity>
      </Entities>
      <Features>
        <Feature>Çok adımlı wizard/stepper arayüzü (Multi-step wizard/stepper UI)</Feature>
        <Feature>4 adımlı değerlendirme süreci (4-step evaluation process)</Feature>
        <Feature>Dinamik soru gösterimi</Feature>
        <Feature>Anlık puan hesaplama</Feature>
        <Feature>Denetim yorumu (Audit comment) ekleme</Feature>
        <Feature>Belge yükleme (drag-drop support)</Feature>
        <Feature>Sayfa bazlı ilerleme tracking</Feature>
        <Feature>Kaydet ve devam et / Kaydet ve Çık</Feature>
        <Feature>Form iptal etme</Feature>
        <Feature>Özet ekran</Feature>
      </Features>
      <WizardSteps>
        <Step number="1" status="completed">
          <Name>Gencel Bilgiler (General Information)</Name>
          <Icon>1 with checkmark</Icon>
          <Color>Green</Color>
          <Fields>
            <Field name="No">Evaluation number (auto-generated, e.g., 37500182433)</Field>
            <Field name="Değerlendirme Yapan">Evaluator (e.g., Didem Aktaşç - Van Yöneticisi 2)</Field>
            <Field name="Kontrol Tipi">Control type (e.g., Çağrı Performans)</Field>
            <Field name="Kontrol Listesi">Checklist selection</Field>
            <Field name="Değerlendirmein">Assignment/Evaluation ID with full description</Field>
            <Field name="Periyotçüm">Period</Field>
            <Field name="Ç.Ç Türi">Call type (if applicable)</Field>
            <Field name="Ç.Ç. Tarihi">Call date</Field>
            <Field name="K.L. Sürüü">Checklist start time (e.g., 16:26)</Field>
            <Field name="K.L. Süresi (Dk.)">Checklist duration in minutes (e.g., 11,11)</Field>
            <Field name="Açıklama">Explanation/notes text area</Field>
            <Field name="Belge">Document upload with drag-drop area</Field>
            <Field name="Puan">Score field</Field>
          </Fields>
          <Navigation>
            <Button>İleri (Next)</Button>
          </Navigation>
        </Step>
        <Step number="2" status="current">
          <Name>Kontrol Listesi (Checklist)</Name>
          <Icon>2 with highlight</Icon>
          <Color>Green (when active)</Color>
          <Description>Main evaluation grid with all questions</Description>
          <TableColumns>
            <Column>Kontrol Grubu (Control Group/Section)</Column>
            <Column>Kontrol Sorısıı (Control Question)</Column>
            <Column>Notlar (Notes)</Column>
            <Column>Önerilen Açıklama (Suggested Explanation)</Column>
            <Column>Atanlı Puan (Assigned Points)</Column>
            <Column>Alınan Puan (Earned Points)</Column>
            <Column>Sonö Tipi (Result Type)</Column>
            <Column>Öranklar (Ratings)</Column>
            <Column>Belge (Document)</Column>
            <Column>İşlem (Actions)</Column>
          </TableColumns>
          <Navigation>
            <Button>Geri (Back)</Button>
            <Button>İleri (Next)</Button>
          </Navigation>
        </Step>
        <Step number="3" status="pending">
          <Name>Denetimi Yorumu (Audit Comment)</Name>
          <Icon>3</Icon>
          <Color>Gray (when pending)</Color>
          <Description>Add overall audit comments and observations</Description>
          <Fields>
            <Field name="Gözlem">Observation text area</Field>
          </Fields>
          <Actions>
            <Action>Kaydet (Save)</Action>
            <Action>İletmez (Don't send/Cancel)</Action>
          </Actions>
          <Navigation>
            <Button>Geri (Back)</Button>
            <Button>İleri (Next)</Button>
          </Navigation>
        </Step>
        <Step number="4" status="pending">
          <Name>Özet Bilgiler (Summary Information)</Name>
          <Icon>4</Icon>
          <Color>Orange/Yellow (when pending)</Color>
          <Description>Review all information before final submission</Description>
          <Navigation>
            <Button>Geri (Back)</Button>
            <Button>Tamamla (Complete)</Button>
          </Navigation>
        </Step>
      </WizardSteps>
      <SaveOptions>
        <Option>Geri Dön (Go Back)</Option>
        <Option>Kaydet ve Çık (Save and Exit)</Option>
        <Option>Formu İptal Et (Cancel Form)</Option>
        <Option>Formu Kaydet (Save Form)</Option>
      </SaveOptions>
      <FormPages>
        <Page number="1">
          <Name>Çağrı Standartları</Name>
          <Questions>
            <Question>Çağrı Standartlarına Uygun</Question>
            <Question>Müşteri Öncemeleri</Question>
            <Question>Site Tanıı &amp; Site Envanter</Question>
          </Questions>
        </Page>
        <Page number="2">
          <Name>Marka İnsaas Uygun Görünme</Name>
        </Page>
        <Page number="3">
          <Name>Doğru İletişim Kurulması</Name>
        </Page>
        <Page number="4">
          <Name>Uygun Duruş Kullanılanı</Name>
        </Page>
      </FormPages>
      <WorkflowSteps>
        <Step order="1">Görevlendirmeyi aç (Open assignment)</Step>
        <Step order="2">Her sayfadaki soruları cevapla</Step>
        <Step order="3">Gerekirse belge ekle</Step>
        <Step order="4">Denetim yorumu ekle (opsiyonel)</Step>
        <Step order="5">"İleri" ile sonraki sayfaya geç</Step>
        <Step order="6">Özet ekranda kontrol et</Step>
        <Step order="7">Değerlendirmeyi tamamla ve gönder</Step>
      </WorkflowSteps>
      <NavigationButtons>
        <Button>Geri (Back)</Button>
        <Button>Kayıt (Save)</Button>
        <Button>Güncelle ve Devam (Update and Continue)</Button>
        <Button>Güncelle (Update)</Button>
        <Button>Özet Ekran (Summary Screen)</Button>
        <Button>İleri (Next)</Button>
      </NavigationButtons>
      <Screenshots>
        <Screenshot>video1_frame_001.png</Screenshot>
        <Screenshot>video1_frame_008.png</Screenshot>
        <Screenshot>video2_frame_001.png</Screenshot>
        <Screenshot>Screenshot 2025-11-24 165310.png</Screenshot>
        <Screenshot>Screenshot 2025-11-24 165325.png</Screenshot>
        <Screenshot>Screenshot 2025-11-24 165340.png</Screenshot>
      </Screenshots>
      <DenetimYorumu>
        <Description>Audit comment section that expands below the question table</Description>
        <Fields>
          <Field name="Gözlem">Observation text area</Field>
        </Fields>
        <Actions>
          <Action>Kaydet (Save)</Action>
          <Action>İletmez (Cancel/Don't send)</Action>
        </Actions>
      </DenetimYorumu>
    </Module>

