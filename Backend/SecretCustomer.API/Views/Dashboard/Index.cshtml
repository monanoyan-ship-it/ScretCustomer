@{
    ViewData["Title"] = Html.T("Dashboard.Title", "Dashboard").ToString();
}

<div id="dashboard-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-speedometer2"></i> @Html.T("Dashboard.Title", "Dashboard")</h2>
        <div class="d-flex gap-2 align-items-center">
            <!-- Date Range Filter -->
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-calendar"></i></span>
                <input type="date" class="form-control" data-bind="value: startDate" style="max-width: 140px;">
                <span class="input-group-text">-</span>
                <input type="date" class="form-control" data-bind="value: endDate" style="max-width: 140px;">
            </div>
            <button class="btn btn-sm btn-primary" data-bind="click: loadDashboard">
                <i class="bi bi-arrow-clockwise"></i> @Html.T("Common.Refresh", "Yenile")
            </button>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Veriler yükleniyor...")</p>
    </div>

    <!-- Dashboard Content -->
    <div data-bind="visible: !isLoading()">
        <!-- Daily Metrics Row (Günlük Dinleme) -->
        <div class="row mb-4">
            <!-- Bugün -->
            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card bg-primary text-white shadow h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-1">@Html.T("Dashboard.Today", "Bugün")</h6>
                                <h2 class="mb-0" data-bind="text: dailyMetrics().todayEvaluations"></h2>
                                <small class="text-white-50">@Html.T("Dashboard.Evaluation", "Değerlendirme")</small>
                            </div>
                            <i class="bi bi-headphones fs-1 opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Günlük Hedef -->
            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card shadow h-100" data-bind="css: dailyMetrics().dailyTargetPercentage >= 100 ? 'bg-success text-white' : 'bg-light'">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <h6 class="mb-1" data-bind="css: dailyMetrics().dailyTargetPercentage >= 100 ? 'text-white-50' : 'text-muted'">@Html.T("Dashboard.DailyTarget", "Günlük Hedef")</h6>
                                <h4 class="mb-0">
                                    <span data-bind="text: dailyMetrics().todayEvaluations"></span> /
                                    <span data-bind="text: dailyMetrics().dailyTarget"></span>
                                </h4>
                            </div>
                            <i class="bi bi-bullseye fs-1 opacity-50"></i>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar" role="progressbar"
                                 data-bind="style: { width: Math.min(100, dailyMetrics().dailyTargetPercentage) + '%' },
                                            css: dailyMetrics().dailyTargetPercentage >= 100 ? 'bg-white' : (dailyMetrics().dailyTargetPercentage >= 50 ? 'bg-success' : 'bg-warning')">
                            </div>
                        </div>
                        <small data-bind="text: dailyMetrics().dailyTargetPercentage.toFixed(2) + '%', css: dailyMetrics().dailyTargetPercentage >= 100 ? 'text-white-50' : 'text-muted'"></small>
                    </div>
                </div>
            </div>

            <!-- Bu Hafta -->
            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card bg-info text-white shadow h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-1">@Html.T("Dashboard.ThisWeek", "Bu Hafta")</h6>
                                <h2 class="mb-0" data-bind="text: dailyMetrics().thisWeekEvaluations"></h2>
                                <small class="text-white-50">@Html.T("Common.Avg", "Ort"): <span data-bind="text: dailyMetrics().thisWeekAverageScore.toFixed(2)"></span>%</small>
                            </div>
                            <i class="bi bi-calendar-week fs-1 opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bu Ay -->
            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card bg-secondary text-white shadow h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-1">@Html.T("Common.ThisMonth", "Bu Ay")</h6>
                                <h2 class="mb-0" data-bind="text: dailyMetrics().thisMonthEvaluations"></h2>
                                <small class="text-white-50">@Html.T("Dashboard.Total", "Toplam")</small>
                            </div>
                            <i class="bi bi-calendar-month fs-1 opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hedef Takibi & Haftalık Trend Row -->
        <div class="row mb-4">
            <!-- Dönem Hedefi -->
            <div class="col-xl-4 mb-4" data-bind="visible: targetProgress().currentPeriodName">
                <div class="card shadow h-100">
                    <div class="card-header bg-gradient bg-warning text-dark">
                        <h5 class="mb-0"><i class="bi bi-flag"></i> @Html.T("Dashboard.PeriodTarget", "Dönem Hedefi")</h5>
                    </div>
                    <div class="card-body">
                        <h6 class="text-muted mb-3" data-bind="text: targetProgress().currentPeriodName"></h6>
                        <div class="d-flex justify-content-between mb-2">
                            <span>@Html.T("Dashboard.Completed", "Tamamlanan")</span>
                            <strong>
                                <span data-bind="text: targetProgress().periodCompleted"></span> /
                                <span data-bind="text: targetProgress().periodTarget"></span>
                            </strong>
                        </div>
                        <div class="progress mb-3" style="height: 20px;">
                            <div class="progress-bar" role="progressbar"
                                 data-bind="style: { width: targetProgress().periodPercentage + '%' },
                                            css: targetProgress().periodPercentage >= 100 ? 'bg-success' : (targetProgress().periodPercentage >= 75 ? 'bg-info' : (targetProgress().periodPercentage >= 50 ? 'bg-warning' : 'bg-danger'))">
                                <span data-bind="text: targetProgress().periodPercentage.toFixed(2) + '%'"></span>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between text-muted small">
                            <span>@Html.T("Dashboard.Remaining", "Kalan"): <strong data-bind="text: targetProgress().remaining"></strong></span>
                            <span data-bind="text: formatDate(targetProgress().periodEndDate) + ' @Html.T("Dashboard.EndDateSuffix", "bitiş")'"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Haftalık Trend Chart -->
            <div class="col-xl-8 mb-4">
                <div class="card shadow h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-bar-chart-line"></i> @Html.T("Dashboard.WeeklyTrend", "Son 7 Gün")</h5>
                        <span class="badge bg-primary">@Html.T("Dashboard.DailyTarget", "Günlük Hedef"): <span data-bind="text: dailyMetrics().dailyTarget"></span></span>
                    </div>
                    <div class="card-body">
                        <canvas id="dailyTrendChart" style="max-height: 200px;"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top Evaluators Row -->
        <div class="row mb-4">
            <!-- Bugün En Çok Dinleyen -->
            <div class="col-md-6 mb-4">
                <div class="card shadow h-100">
                    <div class="card-header bg-gradient bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-trophy"></i> @Html.T("Dashboard.TopEvaluatorsToday", "Bugün En Çok Dinleyenler")</h5>
                    </div>
                    <div class="card-body card-body-scrollable p-0" style="max-height: 250px;">
                        <div data-bind="visible: userPerformance().topEvaluatorsToday.length === 0" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-1"></i>
                            <p class="mt-2">@Html.T("Dashboard.NoDataToday", "Bugün henüz dinleme yapılmadı")</p>
                        </div>
                        <table class="table table-sm table-hover mb-0" data-bind="visible: userPerformance().topEvaluatorsToday.length > 0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>@Html.T("Common.User", "Kullanıcı")</th>
                                    <th class="text-center">@Html.T("Dashboard.Count", "Adet")</th>
                                    <th class="text-end">@Html.T("Common.Average", "Ortalama")</th>
                                    <th class="text-center" style="width: 50px;"></th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: userPerformance().topEvaluatorsToday">
                                <tr>
                                    <td>
                                        <span class="badge" data-bind="css: $index() < 3 ? 'bg-success' : 'bg-secondary', text: $index() + 1"></span>
                                    </td>
                                    <td data-bind="text: userName"></td>
                                    <td class="text-center"><strong data-bind="text: evaluationCount"></strong></td>
                                    <td class="text-end"><span data-bind="text: averageScore.toFixed(2)"></span>%</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-success" title="@Html.T("Common.Detail", "Detay")"
                                                data-bind="click: function() { $parent.showUserProjectDetailToday(userId, userName); }">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Bu Ay En Çok Dinleyen -->
            <div class="col-md-6 mb-4">
                <div class="card shadow h-100">
                    <div class="card-header bg-gradient bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-award"></i> @Html.T("Dashboard.TopEvaluatorsMonth", "Bu Ay En Çok Dinleyenler")</h5>
                    </div>
                    <div class="card-body card-body-scrollable p-0" style="max-height: 250px;">
                        <div data-bind="visible: userPerformance().topEvaluatorsMonth.length === 0" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-1"></i>
                            <p class="mt-2">@Html.T("Common.NoData", "Henüz veri bulunmamaktadır.")</p>
                        </div>
                        <table class="table table-sm table-hover mb-0" data-bind="visible: userPerformance().topEvaluatorsMonth.length > 0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>@Html.T("Common.User", "Kullanıcı")</th>
                                    <th class="text-center">@Html.T("Dashboard.Count", "Adet")</th>
                                    <th class="text-end">@Html.T("Common.Average", "Ortalama")</th>
                                    <th class="text-center" style="width: 50px;"></th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: userPerformance().topEvaluatorsMonth">
                                <tr>
                                    <td>
                                        <span class="badge" data-bind="css: $index() < 3 ? 'bg-primary' : 'bg-secondary', text: $index() + 1"></span>
                                    </td>
                                    <td data-bind="text: userName"></td>
                                    <td class="text-center"><strong data-bind="text: evaluationCount"></strong></td>
                                    <td class="text-end"><span data-bind="text: averageScore.toFixed(2)"></span>%</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary" title="@Html.T("Common.Detail", "Detay")"
                                                data-bind="click: function() { $parent.showUserProjectDetail(userId, userName); }">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Scorecard & Announcements Row -->
        <div class="row mb-4">
            <!-- Scorecard -->
            <div class="col-xl-8 mb-4">
                <div class="card shadow h-100">
                    <div class="card-header bg-gradient bg-primary text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-person-badge"></i> @Html.T("Dashboard.PersonalScorecard", "Kişisel Performans Kartı")</h5>
                        <span class="badge bg-light text-primary" data-bind="text: scorecard().userName"></span>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <!-- Bu Ay -->
                            <div class="col-md-4 mb-3">
                                <div class="border rounded p-3 h-100">
                                    <h6 class="text-muted mb-2"><i class="bi bi-calendar-month"></i> @Html.T("Common.ThisMonth", "Bu Ay")</h6>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h3 class="mb-0" data-bind="text: scorecard().currentMonthEvaluations"></h3>
                                            <small class="text-muted">@Html.T("Dashboard.Evaluation", "Değerlendirme")</small>
                                        </div>
                                        <div class="text-end">
                                            <h3 class="mb-0"><span data-bind="text: scorecard().currentMonthAverage.toFixed(2)"></span>%</h3>
                                            <small class="text-muted">@Html.T("Common.Average", "Ortalama")</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Geçen Ay -->
                            <div class="col-md-4 mb-3">
                                <div class="border rounded p-3 h-100">
                                    <h6 class="text-muted mb-2"><i class="bi bi-calendar"></i> @Html.T("Common.LastMonth", "Geçen Ay")</h6>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h3 class="mb-0" data-bind="text: scorecard().lastMonthEvaluations"></h3>
                                            <small class="text-muted">@Html.T("Dashboard.Evaluation", "Değerlendirme")</small>
                                        </div>
                                        <div class="text-end">
                                            <h3 class="mb-0"><span data-bind="text: scorecard().lastMonthAverage.toFixed(2)"></span>%</h3>
                                            <small class="text-muted">@Html.T("Common.Average", "Ortalama")</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Toplam & Sıralama -->
                            <div class="col-md-4 mb-3">
                                <div class="border rounded p-3 h-100">
                                    <h6 class="text-muted mb-2"><i class="bi bi-trophy"></i> @Html.T("Common.Total", "Toplam")</h6>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h3 class="mb-0" data-bind="text: scorecard().totalEvaluations"></h3>
                                            <small class="text-muted">@Html.T("Dashboard.Evaluation", "Değerlendirme")</small>
                                        </div>
                                        <div class="text-end">
                                            <h3 class="mb-0"><span data-bind="text: scorecard().userRank"></span>/<span data-bind="text: scorecard().totalUsers"></span></h3>
                                            <small class="text-muted">@Html.T("Dashboard.Ranking", "Sıralama")</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Performans Karşılaştırması -->
                        <div class="row mt-2">
                            <div class="col-12">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="flex-grow-1">
                                        <small class="text-muted">@Html.T("Dashboard.YourAverage", "Sizin Ortalamanız")</small>
                                        <div class="progress" style="height: 25px;">
                                            <div class="progress-bar bg-primary" role="progressbar"
                                                 data-bind="style: { width: scorecard().totalAverage + '%' }">
                                                <span data-bind="text: scorecard().totalAverage.toFixed(2) + '%'"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1">
                                        <small class="text-muted">@Html.T("Dashboard.CompanyAverage", "Şirket Ortalaması")</small>
                                        <div class="progress" style="height: 25px;">
                                            <div class="progress-bar bg-secondary" role="progressbar"
                                                 data-bind="style: { width: scorecard().companyAverage + '%' }">
                                                <span data-bind="text: scorecard().companyAverage.toFixed(2) + '%'"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-center" style="min-width: 80px;">
                                        <span class="badge fs-6" data-bind="css: scorecard().monthlyChange >= 0 ? 'bg-success' : 'bg-danger'">
                                            <i data-bind="css: scorecard().monthlyChange >= 0 ? 'bi-arrow-up' : 'bi-arrow-down'"></i>
                                            <span data-bind="text: Math.abs(scorecard().monthlyChange).toFixed(2)"></span>%
                                        </span>
                                        <small class="d-block text-muted">@Html.T("Dashboard.MonthlyChange", "Aylık Değişim")</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Duyurular -->
            <div class="col-xl-4 mb-4">
                <div class="card shadow h-100">
                    <div class="card-header bg-gradient bg-info text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-megaphone"></i> @Html.T("Menu.Announcements", "Duyurular")</h5>
                        <span class="badge bg-light text-info" data-bind="text: announcements().length"></span>
                    </div>
                    <div class="card-body card-body-scrollable p-0" style="max-height: 300px;">
                        <div data-bind="visible: announcements().length === 0" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-1"></i>
                            <p class="mt-2">@Html.T("Dashboard.NoAnnouncements", "Yeni duyuru bulunmamaktadır.")</p>
                        </div>
                        <div class="list-group list-group-flush" data-bind="foreach: announcements">
                            <a href="#" class="list-group-item list-group-item-action py-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <!-- ko if: isPinned -->
                                            <i class="bi bi-pin-fill text-primary" title="@Html.T("Dashboard.Pinned", "Sabitlenmiş")"></i>
                                            <!-- /ko -->
                                            <strong data-bind="text: title"></strong>
                                        </div>
                                        <small class="text-muted" data-bind="text: summary"></small>
                                    </div>
                                    <div class="text-end ms-2">
                                        <span class="badge" data-bind="css: $parent.getAnnouncementTypeClass(type), text: $parent.getAnnouncementTypeName(type)"></span>
                                        <small class="d-block text-muted mt-1" data-bind="text: $parent.formatDate(publishDate)"></small>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPI Cards - Admin Only -->
        <div data-bind="visible: hasAdminAccess">
        <div class="row mb-4">
            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card bg-primary text-white shadow h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-1">@Html.T("Dashboard.TotalEvaluations", "Toplam Değerlendirme")</h6>
                                <h2 class="mb-0" data-bind="text: stats().totalEvaluations"></h2>
                            </div>
                            <i class="bi bi-clipboard-check fs-1 opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card bg-success text-white shadow h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-1">@Html.T("Dealer.AverageScore", "Ortalama Puan")</h6>
                                <h2 class="mb-0">
                                    <span data-bind="text: stats().averageScore.toFixed(2)"></span>%
                                </h2>
                            </div>
                            <i class="bi bi-star-fill fs-1 opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-3">
                <div class="card shadow h-100" data-bind="css: { 'bg-info text-white': stats().percentageChange >= 0, 'bg-warning text-dark': stats().percentageChange < 0 }">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1" data-bind="css: { 'text-white-50': stats().percentageChange >= 0, 'text-dark-50': stats().percentageChange < 0 }">@Html.T("Dashboard.MonthlyChange", "Aylık Değişim")</h6>
                                <h2 class="mb-0">
                                    <i data-bind="css: stats().percentageChange >= 0 ? 'bi-arrow-up' : 'bi-arrow-down'"></i>
                                    <span data-bind="text: Math.abs(stats().percentageChange).toFixed(2)"></span>%
                                </h2>
                            </div>
                            <i class="bi bi-graph-up fs-1 opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        </div>

        <!-- Charts Row - Admin Only -->
        <div data-bind="visible: hasAdminAccess">
        <div class="row mb-4">
            <!-- Monthly Trend Chart -->
            <div class="col-xl-8 mb-4">
                <div class="card shadow h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-graph-up"></i> @Html.T("Dashboard.MonthlyTrend", "Aylık Performans Trendi")</h5>
                        <span class="badge bg-primary" data-bind="text: 'Son ' + stats().monthlyTrends.length + ' ay'"></span>
                    </div>
                    <div class="card-body">
                        <canvas id="monthlyTrendChart" style="max-height: 300px;"></canvas>
                    </div>
                </div>
            </div>

            <!-- Firma Bazlı Aylık Trend -->
            <div class="col-xl-4 mb-4">
                <div class="card shadow h-100">
                    <div class="card-header bg-gradient bg-secondary text-white">
                        <h5 class="mb-0"><i class="bi bi-building"></i> @Html.T("Dashboard.CustomerTrend", "Bu Ay Firma Bazlı")</h5>
                    </div>
                    <div class="card-body card-body-scrollable p-0" style="max-height: 300px;">
                        <div data-bind="visible: customerTrend().length === 0" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-1"></i>
                            <p class="mt-2">@Html.T("Common.NoData", "Henüz veri bulunmamaktadır.")</p>
                        </div>
                        <table class="table table-sm table-hover mb-0" data-bind="visible: customerTrend().length > 0">
                            <thead class="table-light">
                                <tr>
                                    <th>@Html.T("Common.Customer", "Firma")</th>
                                    <th class="text-center">@Html.T("Dashboard.Count", "Adet")</th>
                                    <th class="text-end">@Html.T("Common.Average", "Ort.")</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: customerTrend">
                                <tr>
                                    <td data-bind="text: customerName"></td>
                                    <td class="text-center"><strong data-bind="text: evaluationCount"></strong></td>
                                    <td class="text-end"><span data-bind="text: averageScore.toFixed(2)"></span>%</td>
                                </tr>
                            </tbody>
                            <tfoot class="table-light" data-bind="visible: customerTrend().length > 0">
                                <tr>
                                    <td><strong>@Html.T("Common.Total", "Toplam")</strong></td>
                                    <td class="text-center"><strong data-bind="text: customerTrendTotal().count"></strong></td>
                                    <td class="text-end"><strong><span data-bind="text: customerTrendTotal().average.toFixed(2)"></span>%</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        </div>

    <!-- User Project Detail Modal -->
<div class="modal fade" id="userProjectDetailModal" tabindex="-1" aria-labelledby="userProjectDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="userProjectDetailModalLabel">
                    <i class="bi bi-person-lines-fill"></i> <span data-bind="text: selectedUserName"></span> - @Html.T("Dashboard.ProjectBreakdown", "Proje Kırılımı")
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div data-bind="visible: isLoadingProjectDetail" class="text-center py-4">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2 text-muted">@Html.T("Common.Loading", "Yükleniyor...")</p>
                </div>
                <div data-bind="visible: !isLoadingProjectDetail()">
                    <div class="alert alert-info mb-3">
                        <strong>@Html.T("Dashboard.TotalThisMonth", "Bu Ay Toplam"):</strong>
                        <span data-bind="text: selectedUserProjectDetail().totalEvaluations"></span> @Html.T("Dashboard.Evaluation", "değerlendirme")
                    </div>
                    <div data-bind="visible: selectedUserProjectDetail().projects.length === 0" class="text-center text-muted py-3">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">@Html.T("Common.NoData", "Veri bulunmamaktadır.")</p>
                    </div>
                    <table class="table table-striped table-hover" data-bind="visible: selectedUserProjectDetail().projects.length > 0">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.T("Common.Project", "Proje")</th>
                                <th>@Html.T("Common.Code", "Kod")</th>
                                <th>@Html.T("Common.Customer", "Firma")</th>
                                <th class="text-center">@Html.T("Dashboard.Count", "Adet")</th>
                                <th class="text-end">@Html.T("Common.Average", "Ortalama")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: selectedUserProjectDetail().projects">
                            <tr>
                                <td data-bind="text: projectName"></td>
                                <td><code data-bind="text: projectCode || '-'"></code></td>
                                <td data-bind="text: customerName || '-'"></td>
                                <td class="text-center"><strong data-bind="text: evaluationCount"></strong></td>
                                <td class="text-end"><span data-bind="text: averageScore.toFixed(2)"></span>%</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i> @Html.T("Common.Close", "Kapat")
                </button>
            </div>
        </div>
    </div>
</div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Dashboard/Index.js" asp-append-version="true"></script>
}
