@{
    ViewData["Title"] = Html.T("Menu.InternalAssignments", "İç Değerlendirme Atamaları").ToString();
}

<div id="internal-assignments-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-person-check"></i> @Html.T("Menu.InternalAssignments", "İç Değerlendirme Atamaları")</h2>
        <button class="btn btn-primary" data-bind="click: openCreateModal">
            <i class="bi bi-plus-circle"></i> @Html.T("InternalAssignments.NewAssignment", "Yeni Atama")
        </button>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4" data-bind="with: summary">
        <div class="col-md-3 col-sm-6 mb-2">
            <div class="card bg-primary text-white h-100">
                <div class="card-body py-2 px-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0 small">@Html.T("Common.Total", "Toplam")</h6>
                            <h4 class="mb-0" data-bind="text: totalAssignments"></h4>
                        </div>
                        <i class="bi bi-clipboard-data fs-3 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-2">
            <div class="card bg-warning text-dark h-100">
                <div class="card-body py-2 px-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0 small">@Html.T("Common.Status.Pending", "Bekleyen")</h6>
                            <h4 class="mb-0" data-bind="text: pendingAssignments"></h4>
                        </div>
                        <i class="bi bi-hourglass-split fs-3 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-2">
            <div class="card bg-success text-white h-100">
                <div class="card-body py-2 px-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0 small">@Html.T("Status.Completed", "Tamamlanan")</h6>
                            <h4 class="mb-0" data-bind="text: completedAssignments"></h4>
                        </div>
                        <i class="bi bi-check-circle fs-3 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-2">
            <div class="card bg-danger text-white h-100">
                <div class="card-body py-2 px-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0 small">@Html.T("Status.Expired", "Süresi Dolan")</h6>
                            <h4 class="mb-0" data-bind="text: overdueAssignments"></h4>
                        </div>
                        <i class="bi bi-exclamation-triangle fs-3 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters (Chip-based) -->
    <div class="card shadow-sm mb-4">
        <div class="card-body py-2">
            <!-- Filter Add Row -->
            <div class="row g-2 align-items-end">
                <!-- Filter Type Select -->
                <div class="col-md-2">
                    <label class="form-label small text-muted">@Html.T("Common.FilterType", "Filtre Tipi")</label>
                    <select class="form-select form-select-sm" data-bind="value: selectedFilterType">
                        <option value="">@Html.T("Common.SelectFilter", "Filtre Seçin...")</option>
                        <option value="customer">@Html.T("Customer.Title", "Müşteri")</option>
                        <option value="project">@Html.T("Project.Title", "Proje")</option>
                        <option value="status">@Html.T("Common.Status", "Durum")</option>
                        <option value="dueDate">@Html.T("Common.DueDate", "Son Tarih")</option>
                    </select>
                </div>

                <!-- Dynamic Filter Input -->
                <div class="col-md-8">
                    <!-- Customer Filter -->
                    <div data-bind="visible: selectedFilterType() === 'customer'">
                        <label class="form-label small text-muted">@Html.T("Customer.Title", "Müşteri")</label>
                        <select class="form-select form-select-sm" data-bind="value: tempFilter.customerId, options: customers, optionsValue: 'id', optionsText: 'name', optionsCaption: '@Html.T("Common.Select", "Seçiniz...")'"></select>
                    </div>

                    <!-- Project Filter -->
                    <div data-bind="visible: selectedFilterType() === 'project'">
                        <label class="form-label small text-muted">@Html.T("Project.Title", "Proje")</label>
                        <select class="form-select form-select-sm" data-bind="value: tempFilter.projectId, options: projects, optionsValue: 'id', optionsText: 'name', optionsCaption: '@Html.T("Common.Select", "Seçiniz...")'"></select>
                    </div>

                    <!-- Status Filter -->
                    <div data-bind="visible: selectedFilterType() === 'status'">
                        <label class="form-label small text-muted">@Html.T("Common.Status", "Durum")</label>
                        <select class="form-select form-select-sm" data-bind="value: tempFilter.status, options: statusOptions, optionsValue: 'id', optionsText: 'name', optionsCaption: '@Html.T("Common.Select", "Seçiniz...")'"></select>
                    </div>

                    <!-- Due Date Filter (Projects pattern) -->
                    <div data-bind="visible: selectedFilterType() === 'dueDate'">
                        <label class="form-label small text-muted">@Html.T("Common.DueDate", "Son Tarih")</label>
                        <select class="form-select form-select-sm" data-bind="value: tempFilter.selectedDueDateType, options: dueDateOptions, optionsValue: 'systemName', optionsText: 'name', optionsCaption: '@Html.T("Common.Select", "Seçiniz...")'"></select>
                    </div>

                    <!-- No filter selected message -->
                    <div data-bind="visible: !selectedFilterType()" class="text-muted small pt-4">
                        <i class="bi bi-info-circle"></i> @Html.T("Common.SelectFilterToAdd", "Eklemek için bir filtre tipi seçin")
                    </div>
                </div>

                <!-- Add Filter Button -->
                <div class="col-md-2">
                    <button type="button" class="btn btn-sm btn-primary w-100" data-bind="click: addFilter, enable: canAddFilter">
                        <i class="bi bi-plus-circle"></i> @Html.T("Common.AddFilter", "Filtre Ekle")
                    </button>
                </div>
            </div>

            <!-- Active Filters (Chips) -->
            <div class="mt-3" data-bind="visible: activeFilters().length > 0">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="text-muted small">@Html.T("Common.ActiveFilters", "Aktif Filtreler"):</span>
                    <!-- ko foreach: activeFilters -->
                    <span class="badge bg-primary d-flex align-items-center gap-1" style="font-size: 0.9em;">
                        <span data-bind="text: label"></span>: <span data-bind="text: displayValue"></span>
                        <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.6em;" data-bind="click: $parent.removeFilter"></button>
                    </span>
                    <!-- /ko -->
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bind="click: clearFilters">
                        <i class="bi bi-x-circle"></i> @Html.T("Common.ClearAll", "Temizle")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Yükleniyor...")</p>
    </div>

    <!-- Assignments -->
    <div data-bind="visible: !isLoading()">
        <!-- Empty State -->
        <div data-bind="visible: assignments().length === 0" class="alert alert-info">
            <i class="bi bi-info-circle"></i> @Html.T("InternalAssignments.NoAssignments", "Henüz atama bulunmamaktadır.")
        </div>

        <!-- Assignments Table -->
        <div data-bind="visible: assignments().length > 0" class="card shadow">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="sortable" data-bind="click: function() { sorting.toggleSort('assignedCustomerPersonnelName'); }, css: sorting.getSortClass('assignedCustomerPersonnelName')">
                                    @Html.T("InternalAssignments.Personnel", "Personel")
                                    <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('assignedCustomerPersonnelName')"></i>
                                </th>
                                <th class="sortable" data-bind="click: function() { sorting.toggleSort('projectName'); }, css: sorting.getSortClass('projectName')">
                                    @Html.T("Project.Title", "Proje")
                                    <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('projectName')"></i>
                                </th>
                                <th class="sortable" data-bind="click: function() { sorting.toggleSort('checklistName'); }, css: sorting.getSortClass('checklistName')">
                                    @Html.T("Menu.Checklists", "Kontrol Listesi")
                                    <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('checklistName')"></i>
                                </th>
                                <th class="sortable" data-bind="click: function() { sorting.toggleSort('dueDate'); }, css: sorting.getSortClass('dueDate')">
                                    @Html.T("Common.DueDate", "Son Tarih")
                                    <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('dueDate')"></i>
                                </th>
                                <th class="sortable" data-bind="click: function() { sorting.toggleSort('status'); }, css: sorting.getSortClass('status')">
                                    @Html.T("Common.Status", "Durum")
                                    <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('status')"></i>
                                </th>
                                <th class="sortable" data-bind="click: function() { sorting.toggleSort('evaluationScore'); }, css: sorting.getSortClass('evaluationScore')">
                                    @Html.T("Common.Score", "Puan")
                                    <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('evaluationScore')"></i>
                                </th>
                                <th class="text-center">@Html.T("Common.Actions", "İşlemler")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: sortedAssignments">
                            <tr data-bind="css: $parent.getRowClass($data)">
                                <td>
                                    <span data-bind="text: assignedCustomerPersonnelName || '-'"></span>
                                </td>
                                <td>
                                    <span data-bind="text: projectName"></span>
                                    <small class="text-muted d-block" data-bind="text: projectCode"></small>
                                </td>
                                <td data-bind="text: checklistName"></td>
                                <td>
                                    <span data-bind="text: dueDate ? new Date(dueDate).toLocaleDateString('tr-TR') : '-'"></span>
                                    <small class="d-block" data-bind="visible: daysRemaining !== undefined, text: $parent.getDaysRemainingText(daysRemaining), css: { 'text-danger': daysRemaining < 0, 'text-warning': daysRemaining >= 0 && daysRemaining <= 3, 'text-muted': daysRemaining > 3 }"></small>
                                </td>
                                <td>
                                    <span class="badge" data-bind="css: $parent.getStatusBadgeClass(status), text: $parent.getStatusText(status)"></span>
                                </td>
                                <td>
                                    <span data-bind="visible: evaluationScore !== null && evaluationScore !== undefined">
                                        <span data-bind="text: evaluationScore ? evaluationScore.toFixed(1) + '%' : '-'"></span>
                                    </span>
                                    <span data-bind="visible: evaluationScore === null || evaluationScore === undefined" class="text-muted">-</span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-info" data-bind="click: $parent.showDetail" title="@Html.T("Common.Detail", "Detay")">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" title="@Html.T("Button.More", "Daha Fazla")">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <a class="dropdown-item" href="#" data-bind="click: $parent.copyLink">
                                                        <i class="bi bi-link-45deg"></i> @Html.T("Button.CopyLink", "Link Kopyala")
                                                    </a>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item text-danger" href="#" data-bind="click: $parent.deleteAssignment">
                                                        <i class="bi bi-trash"></i> @Html.T("Common.Delete", "Sil")
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Create Modal -->
    <div class="modal fade" id="createModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-plus-circle"></i> @Html.T("InternalAssignments.NewAssignment", "Yeni İç Değerlendirme Ataması")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <!-- Sol Kolon: Müşteri, Proje, Tarih -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">@Html.T("Customer.Title", "Müşteri") <span class="text-danger">*</span></label>
                                <select class="form-select" data-bind="options: customers, optionsText: 'name', optionsValue: 'id', value: newAssignment.customerId, optionsCaption: '@Html.T("Common.Select", "Seçiniz...")'"></select>
                            </div>
                            <!-- Project Picker -->
                            <div class="mb-3">
                                <label class="form-label">@Html.T("Project.Title", "Proje") <span class="text-danger">*</span></label>

                                <!-- Selected Project Display -->
                                <div data-bind="visible: selectedProjectForDisplay()" class="card bg-light mb-2">
                                    <div class="card-body py-2 px-3">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong data-bind="text: selectedProjectForDisplay()?.name"></strong>
                                                <span class="text-muted ms-2" data-bind="text: selectedProjectForDisplay()?.code"></span>
                                                <div class="small text-muted" data-bind="visible: selectedProjectForDisplay()?.organizationName">
                                                    <span data-bind="text: selectedProjectForDisplay()?.organizationName"></span>
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-danger" data-bind="click: clearSelectedProject">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Project Picker Button -->
                                <div data-bind="visible: !selectedProjectForDisplay()">
                                    <button type="button" class="btn btn-outline-secondary w-100 text-start"
                                            data-bind="click: toggleProjectPicker, css: { 'disabled': !newAssignment.customerId() }">
                                        <i class="bi bi-folder2-open me-2"></i>@Html.T("Assignment.ChooseProject", "Proje Seçiniz...")
                                    </button>
                                    <small class="text-muted" data-bind="visible: !newAssignment.customerId()">
                                        @Html.T("InternalAssignments.SelectCustomerFirst", "Önce müşteri seçiniz")
                                    </small>
                                </div>

                                <!-- Project Picker Dropdown -->
                                <div data-bind="visible: isProjectPickerOpen()" class="card mt-2 shadow">
                                    <div class="card-header py-2">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                                            <input type="text" class="form-control" placeholder="@Html.T("Assignment.SearchProject", "Proje ara...")"
                                                   data-bind="value: projectPickerSearch, valueUpdate: 'afterkeydown'">
                                        </div>
                                    </div>
                                    <div class="card-body p-0" style="max-height: 300px; overflow-y: auto;">
                                        <table class="table table-hover table-sm mb-0">
                                            <thead class="table-light sticky-top">
                                                <tr>
                                                    <th>@Html.T("Project.Title", "Proje")</th>
                                                    <th>@Html.T("Organization.Title", "Organizasyon")</th>
                                                </tr>
                                            </thead>
                                            <tbody data-bind="foreach: filteredProjectsForPicker">
                                                <tr style="cursor: pointer;" data-bind="click: $root.selectProject">
                                                    <td>
                                                        <strong data-bind="text: name"></strong>
                                                        <small class="text-muted d-block" data-bind="text: code"></small>
                                                    </td>
                                                    <td data-bind="text: organizationName || '-'"></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                        <div class="text-center text-muted py-3" data-bind="visible: filteredProjectsForPicker().length === 0">
                                            <i class="bi bi-inbox"></i> @Html.T("Common.NoResults", "Sonuç bulunamadı")
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3" data-bind="visible: selectedProjectChecklist()">
                                <label class="form-label">@Html.T("Menu.Checklists", "Kontrol Listesi")</label>
                                <input type="text" class="form-control" readonly data-bind="value: selectedProjectChecklist()">
                                <small class="text-muted">@Html.T("Assignment.ChecklistAutoFilled", "Kontrol listesi proje tanımından otomatik alınır")</small>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">@Html.T("Common.DueDate", "Son Tarih") <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" data-bind="value: newAssignment.dueDate">
                            </div>
                        </div>

                        <!-- Sağ Kolon: Personel Seçimi -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">@Html.T("Question.SelectionType", "Seçim Tipi")</label>
                                <div class="btn-group w-100" role="group">
                                    <input type="radio" class="btn-check" name="selectionType" id="selByRole" value="role" data-bind="checked: selectionType">
                                    <label class="btn btn-outline-primary" for="selByRole">@Html.T("InternalAssignments.ByRole", "Role Göre")</label>
                                    <input type="radio" class="btn-check" name="selectionType" id="selByPerson" value="individual" data-bind="checked: selectionType">
                                    <label class="btn btn-outline-primary" for="selByPerson">@Html.T("InternalAssignments.Individual", "Tek Tek")</label>
                                </div>
                            </div>

                            <!-- Rol Seçimi -->
                            <div data-bind="visible: selectionType() === 'role'" class="mb-3">
                                <label class="form-label">@Html.T("Permission.SelectRole", "Rol Seçin")</label>
                                <select class="form-select" data-bind="value: newAssignment.roleFilter">
                                    <option value="">@Html.T("Common.AllRoles", "Tüm Roller")</option>
                                    <option value="1">@Html.T("Role.CustomerManager", "Müşteri Yöneticisi")</option>
                                    <option value="2">@Html.T("Role.CustomerSupervisor", "Müşteri Süpervizörü")</option>
                                </select>
                                <div class="form-text" data-bind="visible: selectedPersonnelCount() > 0">
                                    <i class="bi bi-people me-1"></i>
                                    <span data-bind="text: selectedPersonnelCount"></span> @Html.T("InternalAssignments.PersonnelWillBeAssigned", "personele atama yapılacak")
                                </div>
                            </div>

                            <!-- Tek Tek Seçim -->
                            <div data-bind="visible: selectionType() === 'individual'" class="mb-3">
                                <label class="form-label">@Html.T("Evaluation.SelectPersonnel", "Personel Seçin")</label>
                                <div class="border rounded p-2" style="max-height: 250px; overflow-y: auto;">
                                    <div data-bind="visible: isLoadingPersonnel" class="text-center py-3">
                                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                    </div>
                                    <div data-bind="visible: !isLoadingPersonnel() && availablePersonnel().length === 0" class="text-center text-muted py-3">
                                        <i class="bi bi-people"></i> @Html.T("InternalAssignments.SelectCustomerFirst", "Önce müşteri seçin")
                                    </div>
                                    <div data-bind="visible: !isLoadingPersonnel() && availablePersonnel().length > 0, foreach: availablePersonnel">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" data-bind="value: id, checked: $parent.newAssignment.personnelIds">
                                            <label class="form-check-label">
                                                <span data-bind="text: fullName"></span>
                                                <small class="text-muted" data-bind="text: '(' + roleName + ')'"></small>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-text" data-bind="visible: newAssignment.personnelIds().length > 0">
                                    <i class="bi bi-check-circle me-1"></i>
                                    <span data-bind="text: newAssignment.personnelIds().length"></span> @Html.T("InternalAssignments.PersonnelSelected", "personel seçildi")
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Hata Mesajı -->
                    <div class="alert alert-danger" data-bind="visible: createError, text: createError"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Button.Cancel", "İptal")</button>
                    <button type="button" class="btn btn-success" data-bind="click: createAssignments, enable: canCreate, disable: isCreating">
                        <span data-bind="visible: !isCreating()"><i class="bi bi-check-lg me-1"></i> @Html.T("InternalAssignments.CreateAssignments", "Atamaları Oluştur")</span>
                        <span data-bind="visible: isCreating"><span class="spinner-border spinner-border-sm me-1"></span> @Html.T("Common.Creating", "Oluşturuluyor...")</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Result Modal -->
    <div class="modal fade" id="resultModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Html.T("InternalAssignments.Result", "Atama Sonucu")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center mb-3">
                        <i class="bi bi-check-circle text-success" style="font-size: 3rem;" data-bind="visible: createResult().successCount > 0"></i>
                    </div>
                    <div class="row text-center mb-3">
                        <div class="col-4">
                            <div class="h4 text-success" data-bind="text: createResult().successCount || 0">0</div>
                            <small class="text-muted">@Html.T("Call.Created", "Oluşturuldu")</small>
                        </div>
                        <div class="col-4">
                            <div class="h4 text-warning" data-bind="text: createResult().skippedCount || 0">0</div>
                            <small class="text-muted">@Html.T("Import.Skipped", "Atlandı")</small>
                        </div>
                        <div class="col-4">
                            <div class="h4 text-danger" data-bind="text: createResult().failedCount || 0">0</div>
                            <small class="text-muted">@Html.T("InternalAssignments.Failed", "Hatalı")</small>
                        </div>
                    </div>
                    <div data-bind="visible: createResult().errors && createResult().errors.length > 0">
                        <hr>
                        <h6>@Html.T("Import.Errors", "Hatalar"):</h6>
                        <ul class="list-unstyled text-danger small" data-bind="foreach: createResult().errors">
                            <li><i class="bi bi-exclamation-triangle me-1"></i><span data-bind="text: $data"></span></li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">@Html.T("Common.Close", "Kapat")</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Detail Modal -->
    <div class="modal fade" id="detailModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-info-circle"></i> @Html.T("Assignment.Detail", "Atama Detayı")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" data-bind="with: selectedDetail">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>@Html.T("Project.Title", "Proje"):</strong> <span data-bind="text: projectName"></span>
                        </div>
                        <div class="col-md-6">
                            <strong>@Html.T("Menu.Checklists", "Kontrol Listesi"):</strong> <span data-bind="text: checklistName"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>@Html.T("Assignment.Assignee", "Atanan"):</strong> <span data-bind="text: assigneeName"></span>
                        </div>
                        <div class="col-md-6">
                            <strong>@Html.T("Common.DueDate", "Son Tarih"):</strong> <span data-bind="text: dueDate ? new Date(dueDate).toLocaleDateString('tr-TR') : '-'"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>@Html.T("Common.Status", "Durum"):</strong> <span class="badge" data-bind="css: $parent.getStatusBadgeClass(status), text: $parent.getStatusText(status)"></span>
                        </div>
                        <div class="col-md-6" data-bind="visible: evaluationScore !== null && evaluationScore !== undefined">
                            <strong>@Html.T("Common.Score", "Puan"):</strong> <span data-bind="text: evaluationScore ? evaluationScore.toFixed(1) + '%' : '-'"></span>
                        </div>
                    </div>
                    <div data-bind="visible: $data.evaluatorName" class="mb-3">
                        <strong>@Html.T("Evaluation.Evaluator", "Değerlendiren"):</strong> <span data-bind="text: $data.evaluatorName"></span>
                        <span data-bind="visible: $data.evaluationDate">
                            - <span data-bind="text: $data.evaluationDate ? new Date($data.evaluationDate).toLocaleString('tr-TR') : ''"></span>
                        </span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Close", "Kapat")</button>
                </div>
            </div>
        </div>
    </div>

    <partial name="_DeleteConfirmationModal" />
</div>

@section Scripts {
    <script src="~/js/Shared/enums.service.js"></script>
    <script src="~/js/Shared/delete-confirmation.js"></script>
    <script src="~/js/InternalAssignments/Index.js"></script>
}
