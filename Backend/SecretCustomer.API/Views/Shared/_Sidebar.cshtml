@using System.Security.Claims

<div class="sidebar d-flex flex-column flex-shrink-0 p-3 text-white bg-dark" style="width: 280px;">
    <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
        <i class="bi bi-clipboard-check fs-4 me-2"></i>
        <span class="fs-5">Gizli Müşteri</span>
    </a>
    <hr>
    <ul class="nav nav-pills flex-column mb-auto">
        <li class="nav-item">
            <a asp-controller="Dashboard" asp-action="Index" class="nav-link text-white" aria-current="page">
                <i class="bi bi-speedometer2 me-2"></i>
                Dashboard
            </a>
        </li>

        @if (User.IsInRole("Admin"))
        {
            <li>
                <a asp-controller="Checklists" asp-action="Index" class="nav-link text-white">
                    <i class="bi bi-list-check me-2"></i>
                    Kontrol Listeleri
                </a>
            </li>
            <li>
                <a asp-controller="Projects" asp-action="Index" class="nav-link text-white">
                    <i class="bi bi-folder me-2"></i>
                    Projeler
                </a>
            </li>
        }

        <li>
            <a asp-controller="Assignments" asp-action="Index" class="nav-link text-white">
                <i class="bi bi-clipboard me-2"></i>
                Atamalarım
            </a>
        </li>

        @if (User.IsInRole("Evaluator") || User.IsInRole("Admin"))
        {
            <li>
                <a asp-controller="Evaluations" asp-action="Index" class="nav-link text-white">
                    <i class="bi bi-pencil-square me-2"></i>
                    Değerlendirmeler
                </a>
            </li>
        }
    </ul>
</div>
