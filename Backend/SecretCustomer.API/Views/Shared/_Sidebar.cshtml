<!-- Sidebar Component -->
<div id="sidebar-component">
    <!-- Sidebar Overlay (closes menu on mobile) -->
    <div class="sidebar-overlay" data-bind="visible: isOpen, click: toggle"></div>

    <!-- Sidebar Menu -->
    <div class="sidebar d-flex flex-column flex-shrink-0 p-3 text-white bg-dark" data-bind="css: { 'sidebar-open': isOpen }">
        <!-- Close Button (Mobile) -->
        <button class="btn btn-close btn-close-white position-absolute d-lg-none" style="top: 10px; right: 10px;" data-bind="click: toggle"></button>

        <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
            <i class="bi bi-clipboard-check fs-4 me-2"></i>
            <span class="fs-5">@Html.T("Common.AppName", "Gizli Müşteri")</span>
        </a>
        <hr>

        <ul class="nav nav-pills flex-column flex-grow-1 sidebar-nav" style="overflow-y: auto; min-height: 0;">
            <!-- Dashboard - Not for FieldWorker or CustomerPersonnel -->
            <li class="nav-item" data-bind="visible: !isFieldWorker() && !isCustomerPersonnel()">
                <a href="/Dashboard" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-speedometer2 me-2"></i>
                    @Html.T("Menu.Dashboard", "Dashboard")
                </a>
            </li>

            <!-- Değerlendirmeler - FieldWorker -->
            <li class="nav-item" data-bind="visible: isFieldWorker">
                <a href="/Evaluations" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-clipboard-check me-2"></i>
                    @Html.T("Menu.Evaluations", "Değerlendirmeler")
                </a>
            </li>

            <!-- Değerlendirmeler - QualitySpecialist & Admin -->
            <li class="nav-item" data-bind="visible: isQualitySpecialist() || isAdmin()">
                <a href="/Evaluations" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-pencil-square me-2"></i>
                    @Html.T("Menu.Evaluations", "Değerlendirmeler")
                </a>
            </li>

            <!-- ==================== TANIMLAR (Admin Only) ==================== -->
            <li class="nav-item" data-bind="visible: isAdmin">
                <a class="nav-link text-white d-flex justify-content-between align-items-center collapsed"
                   data-bs-toggle="collapse" href="#menuDefinitions" role="button" aria-expanded="false">
                    <span><i class="bi bi-database me-2"></i>@Html.T("Menu.Definitions", "Tanımlar")</span>
                    <i class="bi bi-chevron-down collapse-icon"></i>
                </a>
                <div class="collapse" id="menuDefinitions">
                    <ul class="nav flex-column submenu">
                        <li>
                            <a href="/Checklists" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-list-check me-2"></i>@Html.T("Menu.Checklists", "Kontrol Listeleri")
                            </a>
                        </li>
                        <li>
                            <a href="/Projects" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-folder me-2"></i>@Html.T("Menu.Projects", "Projeler")
                            </a>
                        </li>
                        <li>
                            <a href="/Assignments" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-clipboard me-2"></i>@Html.T("Menu.Assignments", "Atamalar")
                            </a>
                        </li>
                        <li>
                            <a href="/InternalAssignments" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-clipboard-check me-2"></i>@Html.T("Menu.InternalAssignments", "İç Değerlendirme Atamaları")
                            </a>
                        </li>
                        <li>
                            <a href="/UserRequests" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-inbox me-2"></i>@Html.T("Menu.UserRequests", "Kullanıcı Talepleri")
                            </a>
                        </li>
                        <li>
                            <a href="/EmailTemplates" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-envelope-paper me-2"></i>@Html.T("Menu.EmailTemplates", "Email Şablonları")
                            </a>
                        </li>
                    </ul>
                </div>
            </li>

            <!-- ==================== KULLANICI YÖNETİMİ (Admin Only) ==================== -->
            <li class="nav-item" data-bind="visible: isAdmin">
                <a class="nav-link text-white d-flex justify-content-between align-items-center collapsed"
                   data-bs-toggle="collapse" href="#menuUsers" role="button" aria-expanded="false">
                    <span><i class="bi bi-people me-2"></i>@Html.T("Menu.UserManagement", "Kullanıcı Yönetimi")</span>
                    <i class="bi bi-chevron-down collapse-icon"></i>
                </a>
                <div class="collapse" id="menuUsers">
                    <ul class="nav flex-column submenu">
                        <li>
                            <a href="/Users" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-person-gear me-2"></i>@Html.T("Menu.Users", "Kullanıcılar")
                            </a>
                        </li>
                        <li>
                            <a href="/Customers" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-briefcase me-2"></i>@Html.T("Menu.Customers", "Müşteriler")
                            </a>
                        </li>
                        <li>
                            <a href="/CustomerOrganizations" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-diagram-3 me-2"></i>@Html.T("Menu.CustomerOrganizations", "Müşteri Organizasyonları")
                            </a>
                        </li>
                    </ul>
                </div>
            </li>

            <!-- ==================== AKTİVİTELER (Admin Only) ==================== -->
            <li class="nav-item" data-bind="visible: isAdmin()">
                <a class="nav-link text-white d-flex justify-content-between align-items-center collapsed"
                   data-bs-toggle="collapse" href="#menuActivities" role="button" aria-expanded="false">
                    <span><i class="bi bi-calendar3 me-2"></i>@Html.T("Menu.Activities", "Aktiviteler")</span>
                    <i class="bi bi-chevron-down collapse-icon"></i>
                </a>
                <div class="collapse" id="menuActivities">
                    <ul class="nav flex-column submenu">
                        <li>
                            <a href="/Meetings" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-calendar-event me-2"></i>@Html.T("Menu.Meetings", "Toplantılar")
                            </a>
                        </li>
                        <li>
                            <a href="/Trainings" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-mortarboard me-2"></i>@Html.T("Menu.Trainings", "Eğitimler")
                            </a>
                        </li>
                        <li>
                            <a href="/Approvals" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-check-circle me-2"></i>@Html.T("Menu.Approvals", "Onaylar")
                            </a>
                        </li>
                    </ul>
                </div>
            </li>

            <!-- ==================== RAPORLAR (Admin Only) ==================== -->
            <li class="nav-item" data-bind="visible: isAdmin()">
                <a class="nav-link text-white d-flex justify-content-between align-items-center collapsed"
                   data-bs-toggle="collapse" href="#menuReports" role="button" aria-expanded="false">
                    <span><i class="bi bi-graph-up me-2"></i>@Html.T("Menu.ReportsMenu", "Raporlar")</span>
                    <i class="bi bi-chevron-down collapse-icon"></i>
                </a>
                <div class="collapse" id="menuReports">
                    <ul class="nav flex-column submenu">
                        <li>
                            <a href="/Listenings" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-headphones me-2"></i>@Html.T("Menu.Listenings", "Dinlemeler")
                            </a>
                        </li>
                        <li>
                            <a href="/Reports" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-bar-chart me-2"></i>@Html.T("Menu.Reports", "Genel Raporlar")
                            </a>
                        </li>
                        <li>
                            <a href="/Reports/Penalties" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-card-checklist text-danger me-2"></i>@Html.T("Menu.PenaltyReport", "Cezalı KL Raporu")
                            </a>
                        </li>
                        <li>
                            <a href="/Reports/PersonnelReportCard" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-person-badge text-info me-2"></i>@Html.T("Menu.PersonnelReportCard", "Temsilci Karnesi")
                            </a>
                        </li>
                        <li>
                            <a href="/Reports/Suggestions" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-chat-quote text-info me-2"></i>@Html.T("Menu.SuggestionsReport", "Öneriler Raporu")
                            </a>
                        </li>
                    </ul>
                </div>
            </li>

            <!-- ==================== SİSTEM (Admin Only) ==================== -->
            <li class="nav-item" data-bind="visible: isAdmin">
                <a class="nav-link text-white d-flex justify-content-between align-items-center collapsed"
                   data-bs-toggle="collapse" href="#menuSystem" role="button" aria-expanded="false">
                    <span><i class="bi bi-gear me-2"></i>@Html.T("Menu.SystemMenu", "Sistem")</span>
                    <i class="bi bi-chevron-down collapse-icon"></i>
                </a>
                <div class="collapse" id="menuSystem">
                    <ul class="nav flex-column submenu">
                        <li>
                            <a href="/Permissions" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-shield-lock me-2"></i>@Html.T("Menu.Permissions", "Yetkiler")
                            </a>
                        </li>
                        <li>
                            <a href="/Settings" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-sliders me-2"></i>@Html.T("Menu.Settings", "Sistem Ayarları")
                            </a>
                        </li>
                        <li>
                            <a href="/Settings/Smtp" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-envelope-at me-2"></i>@Html.T("Menu.SmtpSettings", "SMTP Ayarları")
                            </a>
                        </li>
                        <li>
                            <a href="/Languages" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-globe me-2"></i>@Html.T("Menu.Languages", "Diller")
                            </a>
                        </li>
                        <li>
                            <a href="/Notifications" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-bell me-2"></i>@Html.T("Menu.Notifications", "Bildirimler")
                            </a>
                        </li>
                        <li>
                            <a href="/AuditLogs" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-journal-text me-2"></i>@Html.T("Menu.AuditLogs", "Sistem Logları")
                            </a>
                        </li>
                        <li>
                            <a href="/Import" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-upload me-2"></i>@Html.T("Menu.Import", "Veri İçe Aktarma")
                            </a>
                        </li>
                        <li>
                            <a href="/ExcelTemplates" class="nav-link text-white-50 py-1" data-bind="click: closeSidebar">
                                <i class="bi bi-file-earmark-spreadsheet me-2"></i>@Html.T("Menu.ExcelTemplates", "Excel Şablonları")
                            </a>
                        </li>
                    </ul>
                </div>
            </li>

            <!-- Notifications - Non-Admin users -->
            <li class="nav-item" data-bind="visible: !isAdmin()">
                <a href="/Notifications" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-bell me-2"></i>
                    @Html.T("Menu.Notifications", "Bildirimler")
                </a>
            </li>
        </ul>

        <!-- Profile Link at Bottom -->
        <hr>
        <div class="dropdown">
            <a href="/Profile" class="d-flex align-items-center text-white text-decoration-none" data-bind="click: closeSidebar">
                <i class="bi bi-person-circle me-2"></i>
                <span data-bind="text: userName">@Html.T("Menu.MyProfile", "Profilim")</span>
            </a>
        </div>
    </div>
</div>

<script>
    // Sidebar Component ViewModel
    function SidebarViewModel() {
        var self = this;

        self.isOpen = ko.observable(false);
        self.userRole = ko.observable('');
        self.userType = ko.observable('User');
        self.userName = ko.observable('Profilim');

        self.isAdmin = ko.computed(function() {
            return self.userRole() === 'Admin';
        });

        self.isQualitySpecialist = ko.computed(function() {
            return self.userRole() === 'QualitySpecialist';
        });

        self.isFieldWorker = ko.computed(function() {
            return self.userRole() === 'FieldWorker';
        });

        // CustomerPersonnel rolleri
        self.isCustomerPersonnel = ko.computed(function() {
            return self.userType() === 'CustomerPersonnel';
        });

        self.isCustomerManager = ko.computed(function() {
            return self.isCustomerPersonnel() && self.userRole() === 'CustomerManager';
        });

        self.isCustomerSupervisor = ko.computed(function() {
            return self.isCustomerPersonnel() && self.userRole() === 'CustomerSupervisor';
        });

        self.isCustomerOperator = ko.computed(function() {
            return self.isCustomerPersonnel() && self.userRole() === 'CustomerOperator';
        });

        // Toggle sidebar
        self.toggle = function() {
            self.isOpen(!self.isOpen());
        };

        // Close sidebar (for menu clicks)
        self.closeSidebar = function() {
            if (window.innerWidth < 992) {
                self.isOpen(false);
            }
            return true; // Allow navigation
        };

        // Load current user info
        fetch('/api/auth/me', {
            credentials: 'include'
        })
        .then(res => res.json())
        .then(data => {
            self.userRole(data.role);
            self.userType(data.userType || 'User');
            self.userName(data.fullName || 'Profilim');
        })
        .catch(error => {
            console.error('Error loading user info:', error);
        });

        // Expose toggle globally for hamburger button
        window.toggleSidebar = self.toggle;
    }

    // Apply binding to sidebar component
    $(document).ready(function() {
        if (document.getElementById('sidebar-component')) {
            ko.applyBindings(
                new SidebarViewModel(),
                document.getElementById('sidebar-component')
            );
        }

        // Highlight active menu item and expand parent accordion
        highlightActiveMenu();
    });

    function highlightActiveMenu() {
        var currentPath = window.location.pathname.toLowerCase();
        // Normalize: remove trailing slash and /index suffix, convert backslash to forward slash
        var normalizedCurrent = currentPath
            .replace(/\\/g, '/')
            .replace(/\/index$/i, '')
            .replace(/\/$/, '');

        // First: CLEAR all active states
        var allLinks = document.querySelectorAll('.sidebar-nav .nav-link');
        allLinks.forEach(function(link) {
            link.classList.remove('active');
            link.style.backgroundColor = '';
            link.style.borderRadius = '';
        });

        // Second: find exact match (prioritize longer/more specific paths)
        var menuLinks = document.querySelectorAll('.sidebar-nav .submenu .nav-link');
        var bestMatch = null;
        var bestMatchLength = 0;

        menuLinks.forEach(function(link) {
            var href = link.getAttribute('href');
            if (href) {
                var linkPath = href.toLowerCase()
                    .replace(/\\/g, '/')
                    .replace(/\/index$/i, '')
                    .replace(/\/$/, '');

                // Exact match - prioritize longer paths (more specific)
                if (normalizedCurrent === linkPath && linkPath.length > bestMatchLength) {
                    bestMatch = link;
                    bestMatchLength = linkPath.length;
                }
            }
        });

        // Apply active state only to the best (most specific) match
        if (bestMatch) {
            bestMatch.classList.add('active');
            bestMatch.classList.remove('text-white-50');
            bestMatch.classList.add('text-white');
            bestMatch.style.backgroundColor = 'rgba(13, 110, 253, 0.2)';
            bestMatch.style.borderRadius = '4px';

            // Find and expand parent collapse
            var parentCollapse = bestMatch.closest('.collapse');
            if (parentCollapse) {
                parentCollapse.classList.add('show');

                // Update the toggle button state
                var toggleBtn = document.querySelector('[href="#' + parentCollapse.id + '"]');
                if (toggleBtn) {
                    toggleBtn.classList.remove('collapsed');
                    toggleBtn.setAttribute('aria-expanded', 'true');
                }
            }
            return; // Exit after applying submenu match
        }

        // Only check top-level if no submenu match found
        var topLevelLinks = document.querySelectorAll('.sidebar-nav > .nav-item > a.nav-link:not([data-bs-toggle])');
        topLevelLinks.forEach(function(link) {
            var href = link.getAttribute('href');
            if (href) {
                var linkPath = href.toLowerCase()
                    .replace(/\\/g, '/')
                    .replace(/\/index$/i, '')
                    .replace(/\/$/, '');
                if (normalizedCurrent === linkPath) {
                    link.classList.add('active');
                    link.style.backgroundColor = 'rgba(13, 110, 253, 0.3)';
                }
            }
        });
    }
</script>
