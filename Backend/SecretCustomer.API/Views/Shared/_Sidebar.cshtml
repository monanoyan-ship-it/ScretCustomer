<!-- Sidebar Component -->
<div id="sidebar-component">
    <!-- Sidebar Overlay (closes menu on mobile) -->
    <div class="sidebar-overlay" data-bind="visible: isOpen, click: toggle"></div>

    <!-- Sidebar Menu -->
    <div class="sidebar d-flex flex-column flex-shrink-0 p-3 text-white bg-dark" data-bind="css: { 'sidebar-open': isOpen }">
        <!-- Close Button (Mobile) -->
        <button class="btn btn-close btn-close-white position-absolute d-lg-none" style="top: 10px; right: 10px;" data-bind="click: toggle"></button>

        <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
            <i class="bi bi-clipboard-check fs-4 me-2"></i>
            <span class="fs-5">Gizli Müşteri</span>
        </a>
        <hr>
        <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item">
                <a href="/Dashboard/Index" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-speedometer2 me-2"></i>
                    Dashboard
                </a>
            </li>

            <!-- Admin Only Menu Items -->
            <li data-bind="visible: isAdmin">
                <a href="/Checklists/Index" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-list-check me-2"></i>
                    Kontrol Listeleri
                </a>
            </li>
            <li data-bind="visible: isAdmin">
                <a href="/Projects/Index" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-folder me-2"></i>
                    Projeler
                </a>
            </li>
            <li data-bind="visible: isAdmin">
                <a href="/Branches/Index" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-building me-2"></i>
                    Şubeler
                </a>
            </li>
            <li data-bind="visible: isAdmin">
                <a href="/Users/Index" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-person-badge me-2"></i>
                    Kullanıcılar
                </a>
            </li>
            <li data-bind="visible: isAdmin">
                <a href="/FieldWorkers/Index" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-people me-2"></i>
                    Saha Çalışanları
                </a>
            </li>
            <li data-bind="visible: isAdmin || isTeamLeader">
                <a href="/Personnel/Index" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-person-badge-fill me-2"></i>
                    Personel
                </a>
            </li>
            <li data-bind="visible: isAdmin">
                <a href="/Customers/Index" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-briefcase me-2"></i>
                    Müşteriler
                </a>
            </li>
            <li data-bind="visible: isAdmin">
                <a href="/CustomerPersonnel/Index" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-person-vcard me-2"></i>
                    Müşteri Personeli
                </a>
            </li>
            <li data-bind="visible: isAdmin">
                <a href="/ExcelTemplates/Index" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-file-earmark-spreadsheet me-2"></i>
                    Excel Şablonları
                </a>
            </li>
            <li data-bind="visible: isAdmin">
                <a href="/Organization/Index" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-diagram-3 me-2"></i>
                    Organizasyon
                </a>
            </li>
            <li data-bind="visible: isAdmin">
                <a href="/Organization/Delegations" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-arrow-left-right me-2"></i>
                    Vekaletler
                </a>
            </li>
            <li data-bind="visible: isAdmin">
                <a href="/Permissions/Index" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-shield-lock me-2"></i>
                    Yetkiler
                </a>
            </li>

            <li>
                <a href="/Assignments/Index" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-clipboard me-2"></i>
                    Atamalarım
                </a>
            </li>

            <!-- Field Worker Menu -->
            <li data-bind="visible: isFieldWorker">
                <a href="/MyAssignments/Index" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-list-task me-2"></i>
                    Görevlerim
                </a>
            </li>

            <li data-bind="visible: isEvaluator || isAdmin">
                <a href="/Evaluations/Index" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-pencil-square me-2"></i>
                    Değerlendirmeler
                </a>
            </li>

            <!-- Meetings -->
            <li>
                <a href="/Meetings/Index" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-calendar-event me-2"></i>
                    Toplantılar
                </a>
            </li>

            <!-- Calls -->
            <li>
                <a href="/Calls/Index" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-telephone me-2"></i>
                    Çağrılar
                </a>
            </li>

            <!-- Trainings -->
            <li>
                <a href="/Trainings/Index" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-mortarboard me-2"></i>
                    Eğitimler
                </a>
            </li>

            <!-- Approvals -->
            <li>
                <a href="/Approvals/Index" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-clipboard-check me-2"></i>
                    Onaylar
                </a>
            </li>

            <!-- Notifications -->
            <li>
                <a href="/Notifications/Index" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-bell me-2"></i>
                    Bildirimler
                </a>
            </li>

            <!-- Reports - Admin & TeamLeader Only -->
            <li data-bind="visible: isAdmin || isTeamLeader">
                <a href="/Reports/Index" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-graph-up me-2"></i>
                    Raporlar
                </a>
            </li>
            <li data-bind="visible: isAdmin || isTeamLeader">
                <a href="/Reports/Penalties" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-card-checklist text-danger me-2"></i>
                    Cezalı KL Raporu
                </a>
            </li>
            <li data-bind="visible: isAdmin || isTeamLeader">
                <a href="/Reports/PersonnelReportCard" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-person-badge text-info me-2"></i>
                    Temsilci Karnesi
                </a>
            </li>
            <li data-bind="visible: isAdmin || isTeamLeader">
                <a href="/Reports/Suggestions" class="nav-link text-white" data-bind="click: closeSidebar">
                    <i class="bi bi-chat-quote text-info me-2"></i>
                    Öneriler Raporu
                </a>
            </li>
        </ul>

        <!-- Impersonation Button (Admin Only) -->
        <div data-bind="visible: isAdmin" class="mt-3 px-2">
            <button class="btn btn-outline-info w-100" onclick="openImpersonationModal()">
                <i class="bi bi-person-badge-fill me-2"></i>
                Firma Olarak Goruntule
            </button>
        </div>

        <!-- Profile Link at Bottom -->
        <hr>
        <div class="dropdown">
            <a href="/Profile/Index" class="d-flex align-items-center text-white text-decoration-none" data-bind="click: closeSidebar">
                <i class="bi bi-person-circle me-2"></i>
                <span data-bind="text: userName">Profilim</span>
            </a>
        </div>
    </div>
</div>

<script>
    // Sidebar Component ViewModel
    function SidebarViewModel() {
        var self = this;

        self.isOpen = ko.observable(false);
        self.userRole = ko.observable('');
        self.userName = ko.observable('Profilim');

        self.isAdmin = ko.computed(function() {
            return self.userRole() === 'Admin';
        });

        self.isEvaluator = ko.computed(function() {
            return self.userRole() === 'Evaluator' || self.userRole() === 'CustomerRepresentative';
        });

        self.isFieldWorker = ko.computed(function() {
            return self.userRole() === 'FieldWorker';
        });

        self.isTeamLeader = ko.computed(function() {
            return self.userRole() === 'TeamLeader';
        });

        // Toggle sidebar
        self.toggle = function() {
            self.isOpen(!self.isOpen());
        };

        // Close sidebar (for menu clicks)
        self.closeSidebar = function() {
            if (window.innerWidth < 992) {
                self.isOpen(false);
            }
            return true; // Allow navigation
        };

        // Load current user info
        fetch('/api/auth/me', {
            credentials: 'include'
        })
        .then(res => res.json())
        .then(data => {
            self.userRole(data.role);
            self.userName(data.fullName || 'Profilim');
        })
        .catch(error => {
            console.error('Error loading user info:', error);
        });

        // Expose toggle globally for hamburger button
        window.toggleSidebar = self.toggle;
    }

    // Apply binding to sidebar component
    $(document).ready(function() {
        if (document.getElementById('sidebar-component')) {
            ko.applyBindings(
                new SidebarViewModel(),
                document.getElementById('sidebar-component')
            );
        }
    });
</script>
