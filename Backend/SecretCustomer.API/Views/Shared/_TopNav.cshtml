<!-- TopNav Component -->
<nav id="topnav-component" class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">

    <!-- Customer Portal Selection Modal (Admin Only) -->
    <!-- ko if: isAdmin -->
    <div class="modal fade" data-bind="css: { show: showCustomerModal }, style: { display: showCustomerModal() ? 'block' : 'none' }" tabindex="-1" style="z-index: 1060;">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-building me-2"></i>@Html.T("Layout.SelectCustomer", "Müşteri Portalına Git")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bind="click: closeCustomerModal"></button>
                </div>
                <div class="modal-body">
                    <!-- Search -->
                    <div class="mb-3">
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" placeholder="@Html.T("Layout.SearchCustomer", "Müşteri ara (ad veya kod)...")" data-bind="value: customerSearchText, valueUpdate: 'afterkeydown'" autofocus>
                        </div>
                    </div>

                    <!-- Loading -->
                    <div data-bind="visible: isLoadingCustomers" class="text-center py-4">
                        <div class="spinner-border text-primary"></div>
                    </div>

                    <!-- Customer List -->
                    <div data-bind="visible: !isLoadingCustomers()" style="max-height: 400px; overflow-y: auto;">
                        <div data-bind="visible: filteredCustomers().length === 0" class="alert alert-info">
                            <i class="bi bi-info-circle"></i> @Html.T("Layout.NoCustomersFound", "Müşteri bulunamadı.")
                        </div>
                        <div class="list-group" data-bind="foreach: filteredCustomers">
                            <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" data-bind="click: $parent.selectCustomer">
                                <div>
                                    <strong data-bind="text: companyName"></strong>
                                    <!-- ko if: code -->
                                    <span class="badge bg-secondary ms-2" data-bind="text: code"></span>
                                    <!-- /ko -->
                                </div>
                                <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? '@Html.T("Common.Active", "Aktif")' : '@Html.T("Common.Inactive", "Pasif")'"></span>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeCustomerModal">
                        <i class="bi bi-x-circle me-1"></i>@Html.T("Common.Cancel", "İptal")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showCustomerModal }, style: { display: showCustomerModal() ? 'block' : 'none' }" style="z-index: 1055;"></div>
    <!-- /ko -->
    <div class="container-fluid">
        <!-- Hamburger Menu Button -->
        <button class="btn btn-outline-secondary d-lg-none me-2" type="button" onclick="window.toggleSidebar()">
            <i class="bi bi-list fs-4"></i>
        </button>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
            <ul class="navbar-nav">
                <!-- Language Selector -->
                <li class="nav-item dropdown me-2">
                    <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-globe me-1"></i>
                        <span data-bind="text: currentLanguageName">TR</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" data-bind="foreach: languages">
                        <li>
                            <a class="dropdown-item d-flex align-items-center" href="#" data-bind="click: $parent.changeLanguage, css: { 'active': isCurrent }">
                                <span class="me-2" data-bind="text: uniqueSeoCode.toUpperCase()"></span>
                                <span data-bind="text: name"></span>
                                <!-- ko if: isCurrent -->
                                <i class="bi bi-check ms-auto"></i>
                                <!-- /ko -->
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- Notification Bell -->
                <li class="nav-item dropdown me-2">
                    <a class="nav-link position-relative" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" id="notification-bell-toggle">
                        <i class="bi bi-bell fs-5"></i>
                        <span id="notification-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none; font-size: 0.65rem;">
                            0
                        </span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end shadow" style="width: 360px; max-height: 440px; overflow: hidden;">
                        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                            <h6 class="mb-0"><i class="bi bi-bell me-1"></i> @Html.T("Notifications.Title", "Bildirimler")</h6>
                            <a href="#" id="notification-mark-all-read" class="text-primary small text-decoration-none">
                                @Html.T("Notifications.MarkAllRead", "Tümünü Oku")
                            </a>
                        </div>
                        <div id="notification-dropdown-items" style="max-height: 340px; overflow-y: auto;">
                            <div class="text-center text-muted py-3 px-2">
                                <div class="spinner-border spinner-border-sm"></div>
                            </div>
                        </div>
                        <div class="border-top text-center py-2">
                            <a href="/Notifications" class="text-primary small text-decoration-none">
                                <i class="bi bi-arrow-right me-1"></i>@Html.T("Notifications.ViewAll", "Tümünü Gör")
                            </a>
                        </div>
                    </div>
                </li>

                <!-- User Menu -->
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle me-2 fs-5"></i>
                        <span data-bind="text: userName"></span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <h6 class="dropdown-header">
                                <i class="bi bi-shield-check me-1"></i>
                                <span data-bind="text: userRole"></span>
                            </h6>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <!-- ko if: isAdmin -->
                        <li>
                            <a class="dropdown-item" href="#" data-bind="click: openCustomerPortalModal">
                                <i class="bi bi-building me-2"></i>
                                @Html.T("Layout.CustomerPortal", "Müşteri Portalı")
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <!-- /ko -->
                        <li>
                            <form method="post" action="/Account/Logout">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger" style="border: none; background: none; cursor: pointer; width: 100%; text-align: left;">
                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    @Html.T("Common.Logout", "Çıkış Yap")
                                </button>
                            </form>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>

<script>
    // TopNav Component ViewModel
    function TopNavViewModel() {
        var self = this;

        self.userName = ko.observable('...');
        self.userRole = ko.observable('...');
        self.isAdmin = ko.observable(false);
        self.languages = ko.observableArray([]);
        self.currentLanguageId = ko.observable(null);
        self.currentLanguageName = ko.observable('TR');

        // Customer Portal Modal
        self.showCustomerModal = ko.observable(false);
        self.customerSearchText = ko.observable('');
        self.allCustomers = ko.observableArray([]);
        self.isLoadingCustomers = ko.observable(false);

        self.filteredCustomers = ko.computed(function() {
            var search = (self.customerSearchText() || '').toLowerCase();
            var list = self.allCustomers();
            if (!search) return list;
            return list.filter(function(c) {
                return (c.companyName || '').toLowerCase().indexOf(search) >= 0 ||
                       (c.code || '').toLowerCase().indexOf(search) >= 0;
            });
        });

        // Load current user info
        fetch('/api/auth/me', {
            credentials: 'include'
        })
        .then(res => res.json())
        .then(data => {
            self.userName(data.username || 'Kullanıcı');
            self.userRole(data.role || 'User');
            self.isAdmin(data.role === 'Admin');
        })
        .catch(error => {
            console.error('Error loading user info:', error);
        });

        // Open Customer Portal Modal
        self.openCustomerPortalModal = function() {
            self.showCustomerModal(true);
            self.customerSearchText('');
            self.loadCustomers();
        };

        // Close modal
        self.closeCustomerModal = function() {
            self.showCustomerModal(false);
        };

        // Load customers for selection
        self.loadCustomers = function() {
            self.isLoadingCustomers(true);
            fetch('/api/customer/portal/admin/customers?includeInactive=true', {
                credentials: 'include'
            })
            .then(res => res.json())
            .then(data => {
                self.allCustomers(data || []);
            })
            .catch(error => {
                console.error('Error loading customers:', error);
            })
            .finally(function() {
                self.isLoadingCustomers(false);
            });
        };

        // Select customer and go to portal
        self.selectCustomer = function(customer) {
            fetch('/api/customer/portal/admin/view-as-customer/' + customer.id, {
                method: 'POST',
                credentials: 'include'
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    window.location.href = '/CustomerPortal/Dashboard';
                }
            })
            .catch(error => {
                console.error('Error selecting customer:', error);
            });
        };

        // Load languages
        fetch('/api/localization/languages?onlyActive=true')
        .then(res => res.json())
        .then(data => {
            // isDefault'u temizle (sadece ayarlarda görünsün)
            data.forEach(function(l) { l.isCurrent = false; });
            self.languages(data);
            // Get current language
            fetch('/api/localization/current')
            .then(res => res.json())
            .then(current => {
                if (current && current.id) {
                    self.currentLanguageId(current.id);
                    self.currentLanguageName(current.uniqueSeoCode ? current.uniqueSeoCode.toUpperCase() : 'TR');
                    // Mark current language in list
                    var langs = self.languages();
                    langs.forEach(function(l) {
                        l.isCurrent = l.id === current.id;
                    });
                    self.languages(langs);
                }
            });
        })
        .catch(error => {
            console.error('Error loading languages:', error);
        });

        // Change language
        self.changeLanguage = function(language) {
            fetch('/api/localization/current/' + language.id, {
                method: 'POST',
                credentials: 'include'
            })
            .then(res => res.json())
            .then(data => {
                // Reload page to apply new language
                window.location.reload();
            })
            .catch(error => {
                console.error('Error changing language:', error);
            });
        };
    }

    // Apply binding to topnav component
    $(document).ready(function() {
        if (document.getElementById('topnav-component')) {
            ko.applyBindings(
                new TopNavViewModel(),
                document.getElementById('topnav-component')
            );
        }
    });
</script>
