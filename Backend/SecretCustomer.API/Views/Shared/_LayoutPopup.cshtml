@* Popup sayfaları için minimal layout - sidebar yok *@
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg">

    <!-- Bootstrap CSS -->
    <link href="~/lib/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css">

    <!-- jQuery -->
    <script src="~/lib/jquery/jquery.min.js"></script>

    <!-- KnockoutJS -->
    <script src="~/lib/knockout/knockout-latest.min.js"></script>

    <!-- Toastr CSS -->
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/app.css">
    <link rel="stylesheet" href="~/css/layouts/popup-layout.css">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="popup-container">
        @RenderBody()
    </div>

    <!-- Shared Confirm Modal -->
    <partial name="_ConfirmModal" />

    <!-- Bootstrap JS -->
    <script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>

    <!-- Toastr JS -->
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script>
        toastr.options = {
            closeButton: true,
            progressBar: true,
            positionClass: "toast-top-right",
            timeOut: "3000"
        };
    </script>

    <!-- Localization -->
    <script src="~/js/Shared/localization.js" asp-append-version="true"></script>

    <!-- Confirm Modal -->
    <script src="~/js/Shared/confirm-modal.js" asp-append-version="true"></script>

    <!-- Inputmask -->
    <script src="~/lib/inputmask.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
