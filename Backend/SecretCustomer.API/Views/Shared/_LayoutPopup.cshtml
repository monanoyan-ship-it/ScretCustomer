@* Popup sayfaları için minimal layout - sidebar yok *@
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg">

    <!-- Bootstrap CSS -->
    <link href="~/lib/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css">

    <!-- jQuery -->
    <script src="~/lib/jquery/jquery.min.js"></script>

    <!-- KnockoutJS -->
    <script src="~/lib/knockout/knockout-latest.min.js"></script>

    <!-- Toastr CSS -->
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/app.css">

    <style>
        body {
            background-color: #f8f9fa;
        }
        .popup-container {
            padding: 1.5rem;
            max-width: 1400px;
            margin: 0 auto;
        }
        .popup-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #dee2e6;
        }
        .popup-header h4 {
            margin: 0;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="popup-container">
        @RenderBody()
    </div>

    <!-- Bootstrap JS -->
    <script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>

    <!-- Toastr JS -->
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script>
        toastr.options = {
            closeButton: true,
            progressBar: true,
            positionClass: "toast-top-right",
            timeOut: "3000"
        };
    </script>

    <!-- Localization -->
    <script src="~/js/Shared/localization.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
