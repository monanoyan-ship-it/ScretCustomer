<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - @Html.T("CustomerPortal.Title", "Müşteri Portalı")</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg">

    <!-- Bootstrap CSS (Local) -->
    <link href="~/lib/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css">

    <!-- jQuery (Must be loaded before KnockoutJS) -->
    <script src="~/lib/jquery/jquery.min.js"></script>

    <!-- KnockoutJS -->
    <script src="~/lib/knockout/knockout-latest.min.js"></script>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/app.css">
    <link rel="stylesheet" href="~/css/layouts/customer-layout.css">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="d-flex">
        <!-- Customer Sidebar -->
        <nav class="customer-sidebar">
            <div class="brand">
                <i class="bi bi-building fs-2"></i>
                <h5 class="mt-2 mb-0">@Html.T("CustomerPortal.Title", "Müşteri Portalı")</h5>
                <small class="text-white-50" id="customer-company-name"></small>
            </div>

            @{
                var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                var managementPages = new[] { "Projects", "Organizations", "Supervisors", "InternalEvaluations", "ExternalEvaluations", "StaffTrainings" };
                var reportPages = new[] { "Reports", "Penalties", "Suggestions", "PersonnelReportCard", "PerformanceByPeriod", "SurveyResults", "EnneagramResults" };
                var isManagementActive = managementPages.Contains(currentAction);
                var isReportActive = reportPages.Contains(currentAction);
            }

            <ul class="nav flex-column mt-3">
                <!-- ===== ANA MENÜLER (Her zaman görünür) ===== -->
                <li class="nav-item">
                    <a class="nav-link @(currentAction == "Dashboard" ? "active" : "")" href="/CustomerPortal/Dashboard">
                        <i class="bi bi-speedometer2"></i>
                        @Html.T("CustomerPortal.Menu.Dashboard", "Dashboard")
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentAction == "Evaluations" ? "active" : "")" href="/CustomerPortal/Evaluations">
                        <i class="bi bi-clipboard-check"></i>
                        @Html.T("CustomerPortal.Menu.Evaluations", "Degerlendirmeler")
                    </a>
                </li>

                <!-- ===== EĞİTİM VİDEOLARI ===== -->
                @if (User.IsInRole("CustomerOperator"))
                {
                <li class="nav-item">
                    <a class="nav-link @(currentAction == "MyTrainings" ? "active" : "")" href="/CustomerPortal/MyTrainings">
                        <i class="bi bi-mortarboard text-info"></i>
                        @Html.T("CustomerPortal.Menu.MyTrainings", "Egitimlerim")
                    </a>
                </li>
                }
                @if (User.IsInRole("CustomerManager") || User.IsInRole("CustomerSupervisor") || User.IsInRole("Admin"))
                {
                <!-- ===== YÖNETİM (Açılır-Kapanır) ===== -->
                <li class="nav-item mt-2">
                    <a class="nav-link d-flex justify-content-between align-items-center @(isManagementActive ? "" : "collapsed")"
                       data-bs-toggle="collapse" href="#managementMenu" role="button"
                       aria-expanded="@(isManagementActive ? "true" : "false")" aria-controls="managementMenu">
                        <span><i class="bi bi-gear"></i> @Html.T("CustomerPortal.Menu.Management", "Yonetim")</span>
                        <i class="bi bi-chevron-down collapse-icon"></i>
                    </a>
                    <div class="collapse @(isManagementActive ? "show" : "")" id="managementMenu">
                        <ul class="nav flex-column ms-3 submenu">
                            <li class="nav-item">
                                <a class="nav-link @(currentAction == "StaffTrainings" ? "active" : "")" href="/CustomerPortal/StaffTrainings">
                                    <i class="bi bi-people-fill text-warning"></i>
                                    @Html.T("CustomerPortal.Menu.StaffTrainings", "Personel Egitimleri")
                                </a>
                            </li>
                            @if (User.IsInRole("CustomerManager") || User.IsInRole("Admin"))
                            {
                            <li class="nav-item">
                                <a class="nav-link @(currentAction == "Projects" ? "active" : "")" href="/CustomerPortal/Projects">
                                    <i class="bi bi-folder"></i>
                                    @Html.T("CustomerPortal.Menu.Projects", "Projeler")
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentAction == "Organizations" ? "active" : "")" href="/CustomerPortal/Organizations">
                                    <i class="bi bi-diagram-3"></i>
                                    @Html.T("CustomerPortal.Menu.Organizations", "Organizasyonlar")
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentAction == "Supervisors" ? "active" : "")" href="/CustomerPortal/Supervisors">
                                    <i class="bi bi-people"></i>
                                    @Html.T("CustomerPortal.Menu.Supervisors", "Supervizorler")
                                </a>
                            </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link @(currentAction == "InternalEvaluations" ? "active" : "")" href="/CustomerPortal/InternalEvaluations">
                                    <i class="bi bi-clipboard-check"></i>
                                    @Html.T("CustomerPortal.Menu.InternalEvaluations", "Ic Dinlemeler")
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentAction == "ExternalEvaluations" ? "active" : "")" href="/CustomerPortal/ExternalEvaluations">
                                    <i class="bi bi-clipboard-data"></i>
                                    @Html.T("CustomerPortal.Menu.ExternalEvaluations", "Dis Dinlemeler")
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>
                }

                @if (User.IsInRole("CustomerManager") || User.IsInRole("CustomerSupervisor") || User.IsInRole("Admin"))
                {
                <!-- ===== RAPORLAR (Açılır-Kapanır) ===== -->
                <li class="nav-item">
                    <a class="nav-link d-flex justify-content-between align-items-center @(isReportActive ? "" : "collapsed")"
                       data-bs-toggle="collapse" href="#reportsMenu" role="button"
                       aria-expanded="@(isReportActive ? "true" : "false")" aria-controls="reportsMenu">
                        <span><i class="bi bi-bar-chart"></i> @Html.T("CustomerPortal.Menu.ReportsGroup", "Raporlar")</span>
                        <i class="bi bi-chevron-down collapse-icon"></i>
                    </a>
                    <div class="collapse @(isReportActive ? "show" : "")" id="reportsMenu">
                        <ul class="nav flex-column ms-3 submenu">
                            <li class="nav-item">
                                <a class="nav-link @(currentAction == "Reports" ? "active" : "")" href="/CustomerPortal/Reports">
                                    <i class="bi bi-graph-up"></i>
                                    @Html.T("CustomerPortal.Menu.Reports", "Genel Raporlar")
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentAction == "Penalties" ? "active" : "")" href="/CustomerPortal/Penalties">
                                    <i class="bi bi-card-checklist text-warning"></i>
                                    @Html.T("CustomerPortal.Menu.Penalties", "Cezali KL Raporu")
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentAction == "Suggestions" ? "active" : "")" href="/CustomerPortal/Suggestions">
                                    <i class="bi bi-chat-quote text-info"></i>
                                    @Html.T("CustomerPortal.Menu.Suggestions", "Oneriler Raporu")
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentAction == "PersonnelReportCard" ? "active" : "")" href="/CustomerPortal/PersonnelReportCard">
                                    <i class="bi bi-person-badge text-primary"></i>
                                    @Html.T("CustomerPortal.Menu.PersonnelReportCard", "Temsilci Karnesi")
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentAction == "PerformanceByPeriod" ? "active" : "")" href="/CustomerPortal/PerformanceByPeriod">
                                    <i class="bi bi-calendar3 text-success"></i>
                                    @Html.T("CustomerPortal.Menu.PerformanceByPeriod", "Donem Bazli Basari")
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentAction == "SurveyResults" ? "active" : "")" href="/CustomerPortal/SurveyResults">
                                    <i class="bi bi-clipboard-data text-info"></i>
                                    @Html.T("CustomerPortal.Menu.SurveyResults", "Anket Sonuclari")
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentAction == "EnneagramResults" ? "active" : "")" href="/CustomerPortal/EnneagramResults">
                                    <i class="bi bi-people text-purple"></i>
                                    @Html.T("CustomerPortal.Menu.EnneagramResults", "Enneagram Sonuclari")
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>
                }
            </ul>
        </nav>

        <!-- Main Content -->
        <div class="customer-main flex-grow-1">
            <!-- Admin Banner -->
            @if (User.IsInRole("Admin"))
            {
            <div id="admin-customer-banner" class="bg-warning text-dark py-2 px-3 d-flex justify-content-between align-items-center" style="display: none !important;">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-eye-fill"></i>
                    <span>@Html.T("CustomerPortal.AdminViewing", "Admin olarak görüntülüyorsunuz:")
                        <strong id="admin-viewing-customer-name"></strong>
                    </span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <!-- Customer Selector Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-dark dropdown-toggle" type="button" data-bs-toggle="dropdown" id="admin-customer-dropdown-btn">
                            <i class="bi bi-arrow-repeat"></i> @Html.T("CustomerPortal.ChangeCustomer", "Müşteri Değiştir")
                        </button>
                        <div class="dropdown-menu dropdown-menu-end p-2 admin-customer-dropdown">
                            <input type="text" class="form-control form-control-sm mb-2" id="admin-customer-search" placeholder="@Html.T("Layout.SearchCustomer", "Müşteri ara...")">
                            <div id="admin-customer-list" class="admin-customer-list">
                                <div class="text-center py-2"><div class="spinner-border spinner-border-sm"></div></div>
                            </div>
                        </div>
                    </div>
                    <a href="/" class="btn btn-sm btn-dark">
                        <i class="bi bi-arrow-left"></i> @Html.T("CustomerPortal.BackToAdmin", "Admin Paneli")
                    </a>
                </div>
            </div>
            }

            <!-- Top Bar -->
            <div class="customer-topbar" id="customer-topbar">
                <h4 class="mb-0">@ViewData["Title"]</h4>
                <div class="d-flex align-items-center gap-3">
                    <!-- Language Selector -->
                    <div class="dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center text-decoration-none" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-globe me-1"></i>
                            <span data-bind="text: currentLanguageName">TR</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" data-bind="foreach: languages">
                            <li>
                                <a class="dropdown-item d-flex align-items-center" href="#" data-bind="click: $parent.changeLanguage, css: { 'active': isCurrent }">
                                    <span class="me-2" data-bind="text: uniqueSeoCode.toUpperCase()"></span>
                                    <span data-bind="text: name"></span>
                                    <!-- ko if: isCurrent -->
                                    <i class="bi bi-check ms-auto"></i>
                                    <!-- /ko -->
                                </a>
                            </li>
                        </ul>
                    </div>
                    <!-- User Menu -->
                    <div class="dropdown">
                        <a href="#" class="user-info text-decoration-none" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="text-end">
                            <div class="user-name" id="customer-user-name"></div>
                            <div class="company-name" id="customer-user-role"></div>
                        </div>
                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center user-avatar">
                            <i class="bi bi-person"></i>
                        </div>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" href="/CustomerPortal/Profile">
                                <i class="bi bi-person-circle me-2"></i>@Html.T("CustomerPortal.Menu.Profile", "Profil")
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline w-100">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-left me-2"></i>@Html.T("CustomerPortal.Menu.Logout", "Çıkış Yap")
                                </button>
                            </form>
                        </li>
                    </ul>
                    </div>
                </div>
            </div>

            <!-- Page Content -->
            <div class="customer-content">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Support Request Widget -->
    <partial name="_SupportRequestWidget" />

    <!-- Shared Confirm Modal -->
    <partial name="_ConfirmModal" />

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Toastr (Notifications) -->
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css">
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script>
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "3000"
        };
    </script>

    <!-- API Service (required by widgets and components) -->
    <script src="~/js/Shared/api.service.js"></script>

    <!-- Localization System -->
    <script src="~/js/shared/localization.js"></script>

    <!-- Confirm Modal -->
    <script src="~/js/shared/confirm-modal.js"></script>

    <!-- Inputmask (for time/duration fields) -->
    <script src="~/lib/inputmask.min.js"></script>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <!-- Customer Portal Auth Check - Uses main JWT auth -->
    <script>
        (function() {
            var isAdminUser = false;
            var allCustomers = [];

            // Load user info from main auth API
            fetch('/api/auth/me', { credentials: 'include' })
                .then(function(res) {
                    if (!res.ok) {
                        throw new Error('Not authenticated');
                    }
                    return res.json();
                })
                .then(function(user) {
                    // Kullanıcı bilgilerini göster (redirect yok - server-side kontrol yeterli)
                    document.getElementById('customer-user-name').textContent = user.fullName || user.username;
                    document.getElementById('customer-user-role').textContent = getRoleName(user.role);
                    document.getElementById('customer-company-name').textContent = user.customerName || '';

                    // Admin ise banner'ı kontrol et
                    isAdminUser = user.role === 'Admin';
                    if (isAdminUser) {
                        checkAdminCustomerSelection();
                    }
                })
                .catch(function(e) {
                    console.error('Auth check failed:', e);
                });

            function getRoleName(role) {
                var roles = {
                    'CustomerManager': '@Html.T("CustomerPersonnel.Role.Manager", "Müşteri Yöneticisi")',
                    'CustomerSupervisor': '@Html.T("CustomerPersonnel.Role.Supervisor", "Müşteri Süpervizörü")',
                    'CustomerOperator': '@Html.T("CustomerPersonnel.Role.Operator", "Müşteri Operatörü")',
                    'Admin': '@Html.T("Role.Admin", "Admin")'
                };
                return roles[role] || role;
            }

            // Admin: Seçili müşteri kontrolü
            function checkAdminCustomerSelection() {
                fetch('/api/customer/portal/admin/current-customer', { credentials: 'include' })
                    .then(function(res) { return res.json(); })
                    .then(function(data) {
                        var banner = document.getElementById('admin-customer-banner');
                        if (banner) {
                            if (data.hasSelection) {
                                document.getElementById('admin-viewing-customer-name').textContent = data.customerName;
                                document.getElementById('customer-company-name').textContent = data.customerName;
                                banner.style.cssText = 'display: flex !important;';
                                loadAdminCustomerList();
                            } else {
                                // Müşteri seçilmemiş, seç diye modal aç
                                banner.style.cssText = 'display: flex !important;';
                                document.getElementById('admin-viewing-customer-name').textContent = '@Html.T("CustomerPortal.NoCustomerSelected", "Seçilmedi")';
                                loadAdminCustomerList();
                            }
                        }
                    })
                    .catch(function(e) {
                        console.error('Admin customer check failed:', e);
                    });
            }

            // Admin: Müşteri listesini yükle
            function loadAdminCustomerList() {
                fetch('/api/customer/portal/admin/customers?includeInactive=true', { credentials: 'include' })
                    .then(function(res) { return res.json(); })
                    .then(function(data) {
                        allCustomers = data || [];
                        renderAdminCustomerList(allCustomers);
                    })
                    .catch(function(e) {
                        console.error('Failed to load customers:', e);
                    });
            }

            // Admin: Müşteri listesini render et
            function renderAdminCustomerList(customers) {
                var listContainer = document.getElementById('admin-customer-list');
                if (!listContainer) return;

                if (customers.length === 0) {
                    listContainer.innerHTML = '<div class="text-muted text-center py-2">@Html.T("Layout.NoCustomersFound", "Müşteri bulunamadı")</div>';
                    return;
                }

                var html = '<div class="list-group list-group-flush">';
                customers.forEach(function(c) {
                    var statusBadge = c.isActive
                        ? '<span class="badge bg-success">@Html.T("Common.Active", "Aktif")</span>'
                        : '<span class="badge bg-secondary">@Html.T("Common.Inactive", "Pasif")</span>';
                    html += '<a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2" onclick="selectAdminCustomer(' + c.id + '); return false;">';
                    html += '<div><strong>' + escapeHtml(c.companyName) + '</strong>';
                    if (c.code) html += ' <small class="text-muted">(' + escapeHtml(c.code) + ')</small>';
                    html += '</div>' + statusBadge + '</a>';
                });
                html += '</div>';
                listContainer.innerHTML = html;
            }

            // Admin: Müşteri ara
            var searchInput = document.getElementById('admin-customer-search');
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    var search = this.value.toLowerCase();
                    var filtered = allCustomers.filter(function(c) {
                        return (c.companyName || '').toLowerCase().indexOf(search) >= 0 ||
                               (c.code || '').toLowerCase().indexOf(search) >= 0;
                    });
                    renderAdminCustomerList(filtered);
                });
            }

            // Admin: Müşteri seç (global fonksiyon)
            window.selectAdminCustomer = function(customerId) {
                fetch('/api/customer/portal/admin/view-as-customer/' + customerId, {
                    method: 'POST',
                    credentials: 'include'
                })
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    if (data.success) {
                        window.location.reload();
                    }
                })
                .catch(function(e) {
                    console.error('Failed to select customer:', e);
                });
            };

            function escapeHtml(text) {
                if (!text) return '';
                var div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }
        })();

        // API helper - uses credentials: include for cookie-based JWT
        function customerApiFetch(url, options) {
            options = options || {};
            options.credentials = 'include';

            return fetch(url, options).then(function(response) {
                if (response.status === 401) {
                    window.location.href = '/Account/Login';
                    throw new Error('Unauthorized');
                }
                return response;
            });
        }

        // API helper for downloading files (POST request with JSON body)
        function customerApiDownloadPost(url, data, filename) {
            return fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify(data)
            })
            .then(function(response) {
                if (response.status === 401) {
                    window.location.href = '/Account/Login';
                    throw new Error('Unauthorized');
                }
                if (!response.ok) throw new Error('Download failed');
                return response.blob();
            })
            .then(function(blob) {
                var url = window.URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);
            });
        }

        // API helper for downloading files (GET request)
        function customerApiDownloadGet(url, filename) {
            return fetch(url, {
                method: 'GET',
                credentials: 'include'
            })
            .then(function(response) {
                if (response.status === 401) {
                    window.location.href = '/Account/Login';
                    throw new Error('Unauthorized');
                }
                if (!response.ok) throw new Error('Download failed');
                return response.blob();
            })
            .then(function(blob) {
                var url = window.URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);
            });
        }
    </script>

    <!-- Customer Topbar Language Selector -->
    <script>
        function CustomerTopbarViewModel() {
            var self = this;

            self.languages = ko.observableArray([]);
            self.currentLanguageId = ko.observable(null);
            self.currentLanguageName = ko.observable('TR');

            // Load languages
            fetch('/api/localization/languages?onlyActive=true')
            .then(function(res) { return res.json(); })
            .then(function(data) {
                data.forEach(function(l) { l.isCurrent = false; });
                self.languages(data);
                // Get current language
                fetch('/api/localization/current')
                .then(function(res) { return res.json(); })
                .then(function(current) {
                    if (current && current.id) {
                        self.currentLanguageId(current.id);
                        self.currentLanguageName(current.uniqueSeoCode ? current.uniqueSeoCode.toUpperCase() : 'TR');
                        // Mark current language in list
                        var langs = self.languages();
                        langs.forEach(function(l) {
                            l.isCurrent = l.id === current.id;
                        });
                        self.languages(langs);
                    }
                });
            })
            .catch(function(error) {
                console.error('Error loading languages:', error);
            });

            // Change language
            self.changeLanguage = function(language) {
                fetch('/api/localization/current/' + language.id, {
                    method: 'POST',
                    credentials: 'include'
                })
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    // Reload page to apply new language
                    window.location.reload();
                })
                .catch(function(error) {
                    console.error('Error changing language:', error);
                });
            };
        }

        // Apply binding to customer topbar
        $(document).ready(function() {
            var topbar = document.getElementById('customer-topbar');
            if (topbar) {
                ko.applyBindings(new CustomerTopbarViewModel(), topbar);
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
