<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - @Html.T("CustomerPortal.Title", "Müşteri Portalı")</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <!-- jQuery (Must be loaded before KnockoutJS) -->
    <script src="~/lib/jquery/jquery.min.js"></script>

    <!-- KnockoutJS -->
    <script src="~/lib/knockout/knockout-latest.min.js"></script>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/app.css">

    <style>
        .customer-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            width: 260px;
            background: linear-gradient(180deg, #198754 0%, #146c43 100%);
            color: white;
            padding: 0;
            z-index: 1000;
            overflow-y: auto;
        }

        .customer-sidebar .brand {
            padding: 1.5rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            text-align: center;
        }

        .customer-sidebar .nav-link {
            color: rgba(255,255,255,0.8);
            padding: 0.75rem 1.5rem;
            display: flex;
            align-items: center;
            transition: all 0.2s;
        }

        .customer-sidebar .nav-link:hover {
            color: white;
            background: rgba(255,255,255,0.1);
        }

        .customer-sidebar .nav-link.active {
            color: white;
            background: rgba(255,255,255,0.2);
            border-left: 3px solid white;
        }

        .customer-sidebar .nav-link i {
            margin-right: 0.75rem;
            font-size: 1.1rem;
        }

        .customer-main {
            margin-left: 260px;
            min-height: 100vh;
            background-color: #f8f9fa;
        }

        .customer-topbar {
            background: white;
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #dee2e6;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .customer-content {
            padding: 1.5rem;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .user-info .user-name {
            font-weight: 500;
        }

        .user-info .company-name {
            font-size: 0.85rem;
            color: #6c757d;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="d-flex">
        <!-- Customer Sidebar -->
        <nav class="customer-sidebar">
            <div class="brand">
                <i class="bi bi-building fs-2"></i>
                <h5 class="mt-2 mb-0">@Html.T("CustomerPortal.Title", "Müşteri Portalı")</h5>
                <small class="text-white-50" id="customer-company-name"></small>
            </div>

            <ul class="nav flex-column mt-3">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" href="/CustomerPortal/Dashboard">
                        <i class="bi bi-speedometer2"></i>
                        @Html.T("CustomerPortal.Menu.Dashboard", "Dashboard")
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Evaluations" ? "active" : "")" href="/CustomerPortal/Evaluations">
                        <i class="bi bi-clipboard-check"></i>
                        @Html.T("CustomerPortal.Menu.Evaluations", "Değerlendirmeler")
                    </a>
                </li>
                @if (User.IsInRole("CustomerManager"))
                {
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Branches" ? "active" : "")" href="/CustomerPortal/Branches">
                        <i class="bi bi-folder"></i>
                        @Html.T("CustomerPortal.Menu.Projects", "Projeler")
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Organizations" ? "active" : "")" href="/CustomerPortal/Organizations">
                        <i class="bi bi-diagram-3"></i>
                        @Html.T("CustomerPortal.Menu.Organizations", "Subeler")
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Supervisors" ? "active" : "")" href="/CustomerPortal/Supervisors">
                        <i class="bi bi-people"></i>
                        @Html.T("CustomerPortal.Menu.Supervisors", "Supervizorler")
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "InternalEvaluations" ? "active" : "")" href="/CustomerPortal/InternalEvaluations">
                        <i class="bi bi-clipboard-check"></i>
                        @Html.T("CustomerPortal.Menu.InternalEvaluations", "Ic Dinlemeler")
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "ExternalEvaluations" ? "active" : "")" href="/CustomerPortal/ExternalEvaluations">
                        <i class="bi bi-clipboard-data"></i>
                        @Html.T("CustomerPortal.Menu.ExternalEvaluations", "Dis Dinlemeler")
                    </a>
                </li>
                }
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Reports" ? "active" : "")" href="/CustomerPortal/Reports">
                        <i class="bi bi-graph-up"></i>
                        @Html.T("CustomerPortal.Menu.Reports", "Raporlar")
                    </a>
                </li>
                @if (User.IsInRole("CustomerManager"))
                {
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Penalties" ? "active" : "")" href="/CustomerPortal/Penalties">
                        <i class="bi bi-card-checklist text-warning"></i>
                        @Html.T("CustomerPortal.Menu.Penalties", "Cezali KL Raporu")
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Suggestions" ? "active" : "")" href="/CustomerPortal/Suggestions">
                        <i class="bi bi-chat-quote text-info"></i>
                        @Html.T("CustomerPortal.Menu.Suggestions", "Oneriler Raporu")
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "PersonnelReportCard" ? "active" : "")" href="/CustomerPortal/PersonnelReportCard">
                        <i class="bi bi-person-badge text-primary"></i>
                        @Html.T("CustomerPortal.Menu.PersonnelReportCard", "Temsilci Karnesi")
                    </a>
                </li>
                }
            </ul>

        </nav>

        <!-- Main Content -->
        <div class="customer-main flex-grow-1">
            <!-- Top Bar -->
            <div class="customer-topbar" id="customer-topbar">
                <h4 class="mb-0">@ViewData["Title"]</h4>
                <div class="d-flex align-items-center gap-3">
                    <!-- Language Selector -->
                    <div class="dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center text-decoration-none" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-globe me-1"></i>
                            <span data-bind="text: currentLanguageName">TR</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" data-bind="foreach: languages">
                            <li>
                                <a class="dropdown-item d-flex align-items-center" href="#" data-bind="click: $parent.changeLanguage, css: { 'active': isCurrent }">
                                    <span class="me-2" data-bind="text: uniqueSeoCode.toUpperCase()"></span>
                                    <span data-bind="text: name"></span>
                                    <!-- ko if: isCurrent -->
                                    <i class="bi bi-check ms-auto"></i>
                                    <!-- /ko -->
                                </a>
                            </li>
                        </ul>
                    </div>
                    <!-- User Menu -->
                    <div class="dropdown">
                        <a href="#" class="user-info text-decoration-none" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="text-end">
                            <div class="user-name" id="customer-user-name"></div>
                            <div class="company-name" id="customer-user-role"></div>
                        </div>
                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="bi bi-person"></i>
                        </div>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" href="/CustomerPortal/Profile">
                                <i class="bi bi-person-circle me-2"></i>@Html.T("CustomerPortal.Menu.Profile", "Profil")
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline w-100">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-left me-2"></i>@Html.T("CustomerPortal.Menu.Logout", "Çıkış Yap")
                                </button>
                            </form>
                        </li>
                    </ul>
                    </div>
                </div>
            </div>

            <!-- Page Content -->
            <div class="customer-content">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Support Request Widget -->
    <partial name="_SupportRequestWidget" />

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Toastr (Notifications) -->
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css">
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script>
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "3000"
        };
    </script>

    <!-- API Service (required by widgets and components) -->
    <script src="~/js/Shared/api.service.js"></script>

    <!-- Localization System -->
    <script src="~/js/shared/localization.js"></script>

    <!-- Inputmask (for time/duration fields) -->
    <script src="~/lib/inputmask.min.js"></script>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <!-- Customer Portal Auth Check - Uses main JWT auth -->
    <script>
        (function() {
            // Load user info from main auth API
            fetch('/api/auth/me', { credentials: 'include' })
                .then(function(res) {
                    if (!res.ok) {
                        throw new Error('Not authenticated');
                    }
                    return res.json();
                })
                .then(function(user) {
                    // Kullanıcı bilgilerini göster (redirect yok - server-side kontrol yeterli)
                    document.getElementById('customer-user-name').textContent = user.fullName || user.username;
                    document.getElementById('customer-user-role').textContent = getRoleName(user.role);
                    document.getElementById('customer-company-name').textContent = user.customerName || '';
                })
                .catch(function(e) {
                    console.error('Auth check failed:', e);
                });

            function getRoleName(role) {
                var roles = {
                    'CustomerManager': '@Html.T("CustomerPersonnel.Role.Manager", "Müşteri Yöneticisi")',
                    'CustomerSupervisor': '@Html.T("CustomerPersonnel.Role.Supervisor", "Müşteri Süpervizörü")',
                    'CustomerOperator': '@Html.T("CustomerPersonnel.Role.Operator", "Müşteri Operatörü")'
                };
                return roles[role] || role;
            }
        })();

        // API helper - uses credentials: include for cookie-based JWT
        function customerApiFetch(url, options) {
            options = options || {};
            options.credentials = 'include';

            return fetch(url, options).then(function(response) {
                if (response.status === 401) {
                    window.location.href = '/Account/Login';
                    throw new Error('Unauthorized');
                }
                return response;
            });
        }

        // API helper for downloading files (POST request with JSON body)
        function customerApiDownloadPost(url, data, filename) {
            return fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify(data)
            })
            .then(function(response) {
                if (response.status === 401) {
                    window.location.href = '/Account/Login';
                    throw new Error('Unauthorized');
                }
                if (!response.ok) throw new Error('Download failed');
                return response.blob();
            })
            .then(function(blob) {
                var url = window.URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);
            });
        }

        // API helper for downloading files (GET request)
        function customerApiDownloadGet(url, filename) {
            return fetch(url, {
                method: 'GET',
                credentials: 'include'
            })
            .then(function(response) {
                if (response.status === 401) {
                    window.location.href = '/Account/Login';
                    throw new Error('Unauthorized');
                }
                if (!response.ok) throw new Error('Download failed');
                return response.blob();
            })
            .then(function(blob) {
                var url = window.URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(url);
            });
        }
    </script>

    <!-- Customer Topbar Language Selector -->
    <script>
        function CustomerTopbarViewModel() {
            var self = this;

            self.languages = ko.observableArray([]);
            self.currentLanguageId = ko.observable(null);
            self.currentLanguageName = ko.observable('TR');

            // Load languages
            fetch('/api/localization/languages?onlyActive=true')
            .then(function(res) { return res.json(); })
            .then(function(data) {
                data.forEach(function(l) { l.isCurrent = false; });
                self.languages(data);
                // Get current language
                fetch('/api/localization/current')
                .then(function(res) { return res.json(); })
                .then(function(current) {
                    if (current && current.id) {
                        self.currentLanguageId(current.id);
                        self.currentLanguageName(current.uniqueSeoCode ? current.uniqueSeoCode.toUpperCase() : 'TR');
                        // Mark current language in list
                        var langs = self.languages();
                        langs.forEach(function(l) {
                            l.isCurrent = l.id === current.id;
                        });
                        self.languages(langs);
                    }
                });
            })
            .catch(function(error) {
                console.error('Error loading languages:', error);
            });

            // Change language
            self.changeLanguage = function(language) {
                fetch('/api/localization/current/' + language.id, {
                    method: 'POST',
                    credentials: 'include'
                })
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    // Reload page to apply new language
                    window.location.reload();
                })
                .catch(function(error) {
                    console.error('Error changing language:', error);
                });
            };
        }

        // Apply binding to customer topbar
        $(document).ready(function() {
            var topbar = document.getElementById('customer-topbar');
            if (topbar) {
                ko.applyBindings(new CustomerTopbarViewModel(), topbar);
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
