<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Müşteri Portalı</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <!-- jQuery (Must be loaded before KnockoutJS) -->
    <script src="~/lib/jquery/jquery.min.js"></script>

    <!-- KnockoutJS -->
    <script src="~/lib/knockout/knockout-latest.min.js"></script>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/app.css">

    <style>
        .customer-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            width: 260px;
            background: linear-gradient(180deg, #198754 0%, #146c43 100%);
            color: white;
            padding: 0;
            z-index: 1000;
            overflow-y: auto;
        }

        .customer-sidebar .brand {
            padding: 1.5rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            text-align: center;
        }

        .customer-sidebar .nav-link {
            color: rgba(255,255,255,0.8);
            padding: 0.75rem 1.5rem;
            display: flex;
            align-items: center;
            transition: all 0.2s;
        }

        .customer-sidebar .nav-link:hover {
            color: white;
            background: rgba(255,255,255,0.1);
        }

        .customer-sidebar .nav-link.active {
            color: white;
            background: rgba(255,255,255,0.2);
            border-left: 3px solid white;
        }

        .customer-sidebar .nav-link i {
            margin-right: 0.75rem;
            font-size: 1.1rem;
        }

        .customer-main {
            margin-left: 260px;
            min-height: 100vh;
            background-color: #f8f9fa;
        }

        .customer-topbar {
            background: white;
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #dee2e6;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .customer-content {
            padding: 1.5rem;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .user-info .user-name {
            font-weight: 500;
        }

        .user-info .company-name {
            font-size: 0.85rem;
            color: #6c757d;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="d-flex">
        <!-- Customer Sidebar -->
        <nav class="customer-sidebar">
            <div class="brand">
                <i class="bi bi-building fs-2"></i>
                <h5 class="mt-2 mb-0">Müşteri Portalı</h5>
                <small class="text-white-50" id="customer-company-name"></small>
            </div>

            <ul class="nav flex-column mt-3">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" href="/CustomerPortal/Dashboard">
                        <i class="bi bi-speedometer2"></i>
                        Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Evaluations" ? "active" : "")" href="/CustomerPortal/Evaluations">
                        <i class="bi bi-clipboard-check"></i>
                        Değerlendirmeler
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Branches" ? "active" : "")" href="/CustomerPortal/Branches">
                        <i class="bi bi-building"></i>
                        Şubeler
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Reports" ? "active" : "")" href="/CustomerPortal/Reports">
                        <i class="bi bi-graph-up"></i>
                        Raporlar
                    </a>
                </li>
            </ul>

            <div class="mt-auto p-3 border-top" style="position: absolute; bottom: 0; width: 100%; border-top-color: rgba(255,255,255,0.1) !important;">
                <a class="nav-link text-white-50" href="/CustomerPortal/Logout">
                    <i class="bi bi-box-arrow-left"></i>
                    Çıkış Yap
                </a>
            </div>
        </nav>

        <!-- Main Content -->
        <div class="customer-main flex-grow-1">
            <!-- Top Bar -->
            <div class="customer-topbar">
                <h4 class="mb-0">@ViewData["Title"]</h4>
                <div class="user-info">
                    <div class="text-end">
                        <div class="user-name" id="customer-user-name"></div>
                        <div class="company-name" id="customer-user-role"></div>
                    </div>
                    <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-person"></i>
                    </div>
                </div>
            </div>

            <!-- Page Content -->
            <div class="customer-content">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <!-- Customer Portal Auth Check -->
    <script>
        (function() {
            // Check if user is authenticated
            var token = getCookie('CustomerToken');
            var userInfo = localStorage.getItem('customerUser');

            if (!token || !userInfo) {
                window.location.href = '/CustomerPortal/Login';
                return;
            }

            // Display user info
            try {
                var user = JSON.parse(userInfo);
                document.getElementById('customer-user-name').textContent = user.fullName || user.username;
                document.getElementById('customer-user-role').textContent = getRoleName(user.role);
                document.getElementById('customer-company-name').textContent = user.customerName || '';
            } catch (e) {
                console.error('Error parsing user info:', e);
            }

            function getCookie(name) {
                var value = '; ' + document.cookie;
                var parts = value.split('; ' + name + '=');
                if (parts.length === 2) return parts.pop().split(';').shift();
                return null;
            }

            function getRoleName(role) {
                var roles = {
                    'CustomerManager': 'Müşteri Yöneticisi',
                    'CustomerSupervisor': 'Müşteri Süpervizörü',
                    'CustomerOperator': 'Müşteri Operatörü',
                    'CustomerViewer': 'Müşteri Görüntüleyici'
                };
                return roles[role] || role;
            }
        })();

        // API helper with auth token
        function customerApiFetch(url, options) {
            options = options || {};
            options.headers = options.headers || {};

            var token = getCookie('CustomerToken');
            if (token) {
                options.headers['Authorization'] = 'Bearer ' + token;
            }

            return fetch(url, options).then(function(response) {
                if (response.status === 401) {
                    // Token expired, redirect to login
                    localStorage.removeItem('customerUser');
                    document.cookie = 'CustomerToken=; path=/; max-age=0';
                    window.location.href = '/CustomerPortal/Login';
                    throw new Error('Unauthorized');
                }
                return response;
            });
        }

        function getCookie(name) {
            var value = '; ' + document.cookie;
            var parts = value.split('; ' + name + '=');
            if (parts.length === 2) return parts.pop().split(';').shift();
            return null;
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
