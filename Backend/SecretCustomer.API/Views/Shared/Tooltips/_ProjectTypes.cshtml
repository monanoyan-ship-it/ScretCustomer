@* Proje Tipleri ve Atanabilecek Roller Tooltip *@
<table class="table table-sm table-bordered mb-0" style="font-size: 12px;">
    <thead class="table-light">
        <tr>
            <th>@Html.T("Project.Type", "Proje Tipi")</th>
            <th>@Html.T("Project.AssignableRoles", "Atanabilecek Roller")</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><span class="badge bg-secondary">@Html.T("ProjectType.PhysicalAudit", "Fiziksel Denetim")</span></td>
            <td><span class="badge bg-success">@Html.T("Role.FieldWorker", "Saha Çalışanı")</span></td>
        </tr>
        <tr>
            <td><span class="badge bg-info">@Html.T("Project.Type.CallAuditing", "Çağrı Denetimi")</span></td>
            <td><span class="badge bg-danger">@Html.T("Role.Admin", "Admin")</span> <span class="badge bg-primary">@Html.T("Role.QualitySpecialist", "Kalite Uzmanı")</span></td>
        </tr>
        <tr>
            <td><span class="badge bg-primary">@Html.T("Project.Type.MysteryShopping", "Gizli Müşteri")</span></td>
            <td><span class="badge bg-success">@Html.T("Role.FieldWorker", "Saha Çalışanı")</span></td>
        </tr>
        <tr>
            <td><span class="badge bg-success">@Html.T("ProjectType.OnlineSurvey", "Online Anket")</span></td>
            <td><span class="badge bg-danger">@Html.T("Role.Admin", "Admin")</span> <span class="badge bg-primary">@Html.T("Role.QualitySpecialist", "Kalite Uzmanı")</span></td>
        </tr>
        <tr>
            <td><span class="badge bg-warning text-dark">@Html.T("ProjectType.CustomerSatisfaction", "Müşteri Memnuniyeti")</span></td>
            <td><span class="badge bg-danger">@Html.T("Role.Admin", "Admin")</span> <span class="badge bg-primary">@Html.T("Role.QualitySpecialist", "Kalite Uzmanı")</span></td>
        </tr>
        <tr>
            <td><span class="badge bg-dark">@Html.T("Project.Type.TrainingEvaluation", "Eğitim Değerlendirme")</span></td>
            <td><span class="badge bg-danger">@Html.T("Role.Admin", "Admin")</span> <span class="badge bg-primary">@Html.T("Role.QualitySpecialist", "Kalite Uzmanı")</span></td>
        </tr>
        <tr>
            <td><span class="badge bg-danger">@Html.T("ProjectType.QualityControl", "Kalite Kontrol")</span></td>
            <td><span class="badge bg-danger">@Html.T("Role.Admin", "Admin")</span> <span class="badge bg-primary">@Html.T("Role.QualitySpecialist", "Kalite Uzmanı")</span></td>
        </tr>
    </tbody>
</table>
