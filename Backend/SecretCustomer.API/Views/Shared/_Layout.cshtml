<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Gizli Müşteri Değerlendirme Sistemi</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <!-- jQuery (Must be loaded before KnockoutJS) -->
    <script src="~/lib/jquery/jquery.min.js"></script>

    <!-- KnockoutJS -->
    <script src="~/lib/knockout/knockout-latest.min.js"></script>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/app.css">
    <link rel="stylesheet" href="~/css/sidebar.css">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <div class="d-flex" style="min-height: 100vh;">
            <!-- Sidebar -->
            <partial name="_Sidebar" />

            <!-- Main Content -->
            <div class="flex-grow-1 d-flex flex-column" style="margin-left: 280px;">
                <!-- Top Navigation Bar -->
                <partial name="_TopNav" />

                <!-- Page Content -->
                <main class="flex-grow-1 p-4" style="background-color: #f8f9fa;">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <main role="main">
            @RenderBody()
        </main>
    }

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Custom JS -->
    <script src="~/js/sidebar.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
