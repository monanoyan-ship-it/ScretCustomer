<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - @Html.T("Layout.AppTitle", "Gizli Müşteri Değerlendirme Sistemi")</title>

    <!-- Bootstrap CSS (Local) -->
    <link href="~/lib/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css">

    <!-- jQuery (Must be loaded before KnockoutJS) -->
    <script src="~/lib/jquery/jquery.min.js"></script>

    <!-- KnockoutJS -->
    <script src="~/lib/knockout/knockout-latest.min.js"></script>

    <!-- Toastr CSS (Local) -->
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/app.css">
    <link rel="stylesheet" href="~/css/sidebar.css">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <div class="d-flex" style="min-height: 100vh;">
            <!-- Sidebar -->
            <partial name="_Sidebar" />

            <!-- Main Content -->
            <div class="flex-grow-1 d-flex flex-column" style="margin-left: 280px;">
                <!-- Impersonation Banner -->
                <div id="impersonation-banner" class="alert alert-warning alert-dismissible mb-0 rounded-0 d-flex align-items-center justify-content-between py-2" style="display: none !important;">
                    <div>
                        <i class="bi bi-person-badge-fill me-2"></i>
                        <strong id="impersonation-customer-name"></strong> @Html.T("Layout.ViewingAs", "olarak görüntüleniyor")
                        <small class="text-muted ms-2">(<span id="impersonation-original-user"></span>)</small>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-dark" onclick="endImpersonation()">
                        <i class="bi bi-x-circle"></i> @Html.T("Layout.Exit", "Çıkış")
                    </button>
                </div>

                <!-- Top Navigation Bar -->
                <partial name="_TopNav" />

                <!-- Page Content -->
                <main class="flex-grow-1 p-4" style="background-color: #f8f9fa;">
                    @RenderBody()
                </main>
            </div>
        </div>

        <!-- Impersonation Modal -->
        <div class="modal fade" id="impersonationModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-info text-white">
                        <h5 class="modal-title"><i class="bi bi-person-badge"></i> @Html.T("Layout.ViewAsCompany", "Firma Olarak Görüntüle")</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">@Html.T("Layout.SelectCustomer", "Müşteri Seçin")</label>
                            <select id="impersonation-customer-select" class="form-select">
                                <option value="">@Html.T("Layout.SelectCustomerPlaceholder", "Müşteri Seçin...")</option>
                            </select>
                        </div>
                        <p class="text-muted small">
                            <i class="bi bi-info-circle"></i>
                            @Html.T("Layout.ImpersonationDescription", "Bu özellik, seçilen müşterinin görünümüne geçmenizi sağlar. Gerçekleştirdiğiniz işlemler kayıt altına alınır.")
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Cancel", "Vazgeç")</button>
                        <button type="button" class="btn btn-info text-white" onclick="startImpersonation()">
                            <i class="bi bi-play-fill"></i> @Html.T("Layout.StartViewing", "Görüntülemeyi Başlat")
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <!-- Shared Confirmation Modal -->
        <div class="modal fade" id="sharedConfirmModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header" id="confirmModalHeader">
                        <h5 class="modal-title text-white">
                            <i class="bi" id="confirmModalIcon"></i>
                            <span id="confirmModalTitle">@Html.T("Common.Confirmation", "Onay")</span>
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p id="confirmModalMessage">@Html.T("Common.ConfirmMessage", "Bu işlemi onaylıyor musunuz?")</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle"></i> @Html.T("Common.Cancel", "İptal")
                        </button>
                        <button type="button" class="btn" id="confirmModalBtn">
                            <i class="bi" id="confirmModalBtnIcon"></i>
                            <span id="confirmModalBtnText">@Html.T("Common.Confirm", "Onayla")</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <main role="main">
            @RenderBody()
        </main>
    }

    <!-- Bootstrap JS (Local) -->
    <script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>

    <!-- Toastr JS (Local) -->
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script>
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "3000"
        };
    </script>

    <!-- Chart.js (Local) -->
    <script src="~/lib/chartjs/chart.umd.min.js"></script>

    <!-- Localization System -->
    <script src="~/js/shared/localization.js"></script>

    <!-- Shared Confirmation Modal Helper -->
    <script src="~/js/shared/confirm-modal.js"></script>

    <!-- Custom JS -->
    <script src="~/js/sidebar.js"></script>

    <!-- Impersonation JS -->
    <script>
        // Check impersonation status on page load
        document.addEventListener('DOMContentLoaded', function() {
            checkImpersonationStatus();
        });

        function checkImpersonationStatus() {
            fetch('/api/auth/impersonation/status', { credentials: 'include' })
                .then(function(response) {
                    if (!response.ok) return;
                    return response.json();
                })
                .then(function(data) {
                    if (data && data.isImpersonating) {
                        showImpersonationBanner(data);
                    } else {
                        hideImpersonationBanner();
                    }
                })
                .catch(function(error) {
                    console.error('Impersonation status check error:', error);
                });
        }

        function showImpersonationBanner(data) {
            var banner = document.getElementById('impersonation-banner');
            var customerName = document.getElementById('impersonation-customer-name');
            var originalUser = document.getElementById('impersonation-original-user');

            if (banner && customerName && originalUser) {
                customerName.textContent = data.customerName || 'Musteri';
                originalUser.textContent = data.originalUserName || 'Admin';
                banner.style.display = 'flex !important';
                banner.classList.remove('d-none');
                banner.style.cssText = 'display: flex !important;';
            }
        }

        function hideImpersonationBanner() {
            var banner = document.getElementById('impersonation-banner');
            if (banner) {
                banner.style.cssText = 'display: none !important;';
            }
        }

        function openImpersonationModal() {
            // Load customers
            fetch('/api/auth/impersonation/customers', { credentials: 'include' })
                .then(function(response) {
                    if (!response.ok) throw new Error('Musteriler yuklenemedi');
                    return response.json();
                })
                .then(function(customers) {
                    var select = document.getElementById('impersonation-customer-select');
                    select.innerHTML = '<option value="">Musteri Secin...</option>';
                    customers.forEach(function(c) {
                        var option = document.createElement('option');
                        option.value = c.id;
                        option.textContent = c.companyName + (c.taxNumber ? ' (' + c.taxNumber + ')' : '');
                        select.appendChild(option);
                    });

                    var modal = new bootstrap.Modal(document.getElementById('impersonationModal'));
                    modal.show();
                })
                .catch(function(error) {
                    console.error('Error loading customers:', error);
                    alert('Musteri listesi yuklenemedi.');
                });
        }

        function startImpersonation() {
            var customerId = document.getElementById('impersonation-customer-select').value;
            if (!customerId) {
                alert('Lutfen bir musteri secin.');
                return;
            }

            fetch('/api/auth/impersonation/start', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({ customerId: customerId })
            })
            .then(function(response) {
                if (!response.ok) {
                    return response.json().then(function(err) {
                        throw new Error(err.message || 'Bir hata olustu');
                    });
                }
                return response.json();
            })
            .then(function(data) {
                if (data.success && data.token) {
                    // Token'i localStorage'a kaydet
                    localStorage.setItem('auth_token', data.token);

                    // Modal'i kapat
                    var modal = bootstrap.Modal.getInstance(document.getElementById('impersonationModal'));
                    if (modal) modal.hide();

                    // Sayfayi yenile
                    window.location.reload();
                } else {
                    alert(data.message || 'Bir hata olustu');
                }
            })
            .catch(function(error) {
                console.error('Impersonation error:', error);
                alert('Hata: ' + error.message);
            });
        }

        function endImpersonation() {
            fetch('/api/auth/impersonation/end', {
                method: 'POST',
                credentials: 'include'
            })
            .then(function(response) {
                if (!response.ok) throw new Error('Bir hata olustu');
                return response.json();
            })
            .then(function(data) {
                if (data.success && data.token) {
                    // Token'i guncelle
                    localStorage.setItem('auth_token', data.token);

                    // Sayfayi yenile
                    window.location.reload();
                }
            })
            .catch(function(error) {
                console.error('End impersonation error:', error);
                alert('Hata: ' + error.message);
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
