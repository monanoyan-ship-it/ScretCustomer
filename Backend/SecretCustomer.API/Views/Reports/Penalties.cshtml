@{
    ViewData["Title"] = @Html.T("Menu.PenaltyReport", "Cezali KL Raporu");
}

<div id="penalties-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-card-checklist text-danger"></i> @Html.T("Menu.PenaltyReport", "Cezali KL Raporu")</h2>
        <div class="btn-group">
            <button class="btn btn-success" data-bind="click: exportToExcel, disable: isExporting">
                <span data-bind="visible: !isExporting()">
                    <i class="bi bi-file-earmark-excel"></i> @Html.T("Common.ExportExcel", "Excel Indir")
                </span>
                <span data-bind="visible: isExporting">
                    <span class="spinner-border spinner-border-sm"></span> @Html.T("Report.Downloading", "Indiriliyor...")
                </span>
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body py-2">
            <!-- Filter Selector & Active Filters -->
            <div class="d-flex flex-wrap align-items-center gap-2">
                <!-- Add Filter Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-outline-danger btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                        <i class="bi bi-plus-circle me-1"></i>@Html.T("Common.AddFilter", "Filtre Ekle")
                    </button>
                    <div class="dropdown-menu p-3 filter-dropdown">
                        <!-- Filter Type Selector -->
                        <div class="mb-2">
                            <select class="form-select form-select-sm" data-bind="value: selectedFilterType">
                                <option value="">@Html.T("Common.SelectFilter", "Filtre Secin...")</option>
                                <option value="customerOrganization">@Html.T("Filter.CustomerOrganization", "Musteri / Organizasyon")</option>
                                <option value="project">@Html.T("Common.Project", "Proje")</option>
                                <option value="checklist">@Html.T("Report.Checklist", "Kontrol Listesi")</option>
                                <option value="evaluator">@Html.T("Report.Evaluator", "Degerlendirici")</option>
                                <option value="penaltyType">@Html.T("Report.PenaltyType", "Ceza Tipi")</option>
                                <option value="dateRange">@Html.T("Common.DateRange", "Tarih Araligi")</option>
                            </select>
                        </div>
                        <!-- Dynamic Filter Input -->
                        <!-- Customer / Organization (Combined) -->
                        <div data-bind="visible: selectedFilterType() === 'customerOrganization'" class="mb-2">
                            <select class="form-select form-select-sm mb-1" data-bind="options: customers, optionsText: 'companyName', optionsValue: 'id', value: tempFilter.customerIdForFilter, optionsCaption: '@Html.T("Common.SelectCustomer", "Musteri Secin...")', event: { change: onCustomerChangeForFilter }"></select>
                            <select class="form-select form-select-sm" data-bind="options: filteredOrganizationsForFilter, optionsText: 'name', optionsValue: 'id', value: tempFilter.organizationId, optionsCaption: '@Html.T("Common.OrganizationOptional", "Organizasyon (Opsiyonel)")', enable: filteredOrganizationsForFilter().length > 0"></select>
                        </div>
                        <!-- Project -->
                        <div data-bind="visible: selectedFilterType() === 'project'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="options: filteredProjectsForFilter, optionsText: function(item) { return item.code ? item.code + ' - ' + item.name : item.name; }, optionsValue: 'id', value: tempFilter.projectId, optionsCaption: '@Html.T("Common.Select", "Secin...")'"></select>
                        </div>
                        <!-- Checklist -->
                        <div data-bind="visible: selectedFilterType() === 'checklist'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="options: checklists, optionsText: 'name', optionsValue: 'id', value: tempFilter.checklistId, optionsCaption: '@Html.T("Common.Select", "Secin...")'"></select>
                        </div>
                        <!-- Evaluator -->
                        <div data-bind="visible: selectedFilterType() === 'evaluator'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="options: evaluators, optionsText: 'fullName', optionsValue: 'id', value: tempFilter.evaluatorId, optionsCaption: '@Html.T("Common.Select", "Secin...")'"></select>
                        </div>
                        <!-- Penalty Type -->
                        <div data-bind="visible: selectedFilterType() === 'penaltyType'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="value: tempFilter.penaltyType">
                                <option value="">@Html.T("Common.Select", "Secin...")</option>
                                <option value="YellowCard">@Html.T("Report.YellowCard", "Sari Kart")</option>
                                <option value="RedCard">@Html.T("Report.RedCard", "Kirmizi Kart")</option>
                            </select>
                        </div>
                        <!-- Date Range -->
                        <div data-bind="visible: selectedFilterType() === 'dateRange'" class="mb-2">
                            <div class="d-flex gap-1 mb-1">
                                <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.startDate">
                                <span class="align-self-center">-</span>
                                <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.endDate">
                            </div>
                            <div class="d-flex flex-wrap gap-1">
                                <!-- ko foreach: dateRanges -->
                                <button type="button" class="btn btn-sm"
                                    data-bind="click: function() { $parent.setTempDateRange(systemName); },
                                               text: name,
                                               css: $parent.tempFilter.selectedDateRangeType() === systemName ? 'btn-danger' : 'btn-outline-secondary'"></button>
                                <!-- /ko -->
                            </div>
                        </div>
                        <!-- Add Button -->
                        <button type="button" class="btn btn-danger btn-sm w-100" data-bind="click: addFilter, enable: canAddFilter">
                            <i class="bi bi-plus"></i> @Html.T("Common.Add", "Ekle")
                        </button>
                    </div>
                </div>

                <!-- Active Filters (Chips) -->
                <!-- ko foreach: activeFilters -->
                <span class="badge bg-danger d-flex align-items-center gap-1 py-2 px-2">
                    <span data-bind="text: label"></span>: <strong data-bind="text: displayValue"></strong>
                    <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.6rem;" data-bind="click: $parent.removeFilter"></button>
                </span>
                <!-- /ko -->

                <!-- Clear All -->
                <button class="btn btn-outline-secondary btn-sm" data-bind="visible: activeFilters().length > 0, click: clearFilters">
                    <i class="bi bi-x-circle"></i> @Html.T("Common.ClearAll", "Temizle")
                </button>

                <!-- Spacer -->
                <div class="flex-grow-1"></div>

                <!-- Search Button -->
                <button class="btn btn-danger btn-sm" data-bind="click: search">
                    <i class="bi bi-search me-1"></i>@Html.T("Common.Search", "Ara")
                </button>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-danger text-white h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-1">@Html.T("Report.TotalPenalties", "Toplam Cezali")</h6>
                            <h2 class="mb-0" data-bind="text: summary().totalPenalties"></h2>
                        </div>
                        <i class="bi bi-card-fill fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-dark-50 mb-1">@Html.T("Report.YellowCard", "Sari Kart")</h6>
                            <h2 class="mb-0" data-bind="text: summary().totalYellowCards"></h2>
                        </div>
                        <i class="bi bi-exclamation-triangle fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark text-white h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-1">@Html.T("Report.RedCard", "Kirmizi Kart")</h6>
                            <h2 class="mb-0" data-bind="text: summary().totalRedCards"></h2>
                        </div>
                        <i class="bi bi-x-circle fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-secondary text-white h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-1">@Html.T("Report.AffectedEvaluations", "Etkilenen Degerlendirme")</h6>
                            <h2 class="mb-0" data-bind="text: summary().affectedEvaluations"></h2>
                        </div>
                        <i class="bi bi-clipboard-x fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Veriler yukleniyor...")</p>
    </div>

    <div data-bind="visible: !isLoading()" class="row">
        <!-- Top Penalty Questions -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-question-circle"></i> @Html.T("Report.TopPenaltyQuestions", "En Cok Ceza Alan Sorular")</h5>
                </div>
                <div class="card-body p-0">
                    <div data-bind="visible: topPenaltyQuestions().length === 0" class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">@Html.T("Report.NoDataYet", "Henuz veri bulunmamaktadir.")</p>
                    </div>
                    <ul class="list-group list-group-flush" data-bind="foreach: topPenaltyQuestions">
                        <li class="list-group-item d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <div class="fw-bold" data-bind="text: questionText"></div>
                                <small class="text-muted" data-bind="text: checklistName + ' - ' + groupName"></small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-warning text-dark me-1" data-bind="visible: yellowCardCount > 0">
                                    <i class="bi bi-card-fill"></i> <span data-bind="text: yellowCardCount"></span>
                                </span>
                                <span class="badge bg-danger" data-bind="visible: redCardCount > 0">
                                    <i class="bi bi-card-fill"></i> <span data-bind="text: redCardCount"></span>
                                </span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Top Penalty Organizations -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="bi bi-building"></i> @Html.T("Report.TopPenaltyOrganizations", "En Cok Ceza Alan Organizasyonlar")</h5>
                </div>
                <div class="card-body p-0">
                    <div data-bind="visible: topPenaltyOrganizations().length === 0" class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">@Html.T("Report.NoDataYet", "Henuz veri bulunmamaktadir.")</p>
                    </div>
                    <ul class="list-group list-group-flush" data-bind="foreach: topPenaltyOrganizations">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold" data-bind="text: organizationName"></span>
                                <small class="text-muted d-block" data-bind="text: customerName"></small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-warning text-dark me-1" data-bind="visible: yellowCardCount > 0">
                                    <i class="bi bi-card-fill"></i> <span data-bind="text: yellowCardCount"></span>
                                </span>
                                <span class="badge bg-danger" data-bind="visible: redCardCount > 0">
                                    <i class="bi bi-card-fill"></i> <span data-bind="text: redCardCount"></span>
                                </span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Top Penalty Personnel -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-person-x"></i> @Html.T("Report.TopPenaltyPersonnel", "En Cok Ceza Alan Personeller")</h5>
                </div>
                <div class="card-body p-0">
                    <div data-bind="visible: topPenaltyPersonnel().length === 0" class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">@Html.T("Report.NoDataYet", "Henuz veri bulunmamaktadir.")</p>
                    </div>
                    <ul class="list-group list-group-flush" data-bind="foreach: topPenaltyPersonnel">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold" data-bind="text: personnelName"></span>
                                <small class="text-muted d-block" data-bind="text: organizationName"></small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-secondary me-1" data-bind="text: evaluationCount + ' deg.'"></span>
                                <span class="badge bg-warning text-dark me-1" data-bind="visible: yellowCardCount > 0">
                                    <i class="bi bi-card-fill"></i> <span data-bind="text: yellowCardCount"></span>
                                </span>
                                <span class="badge bg-danger" data-bind="visible: redCardCount > 0">
                                    <i class="bi bi-card-fill"></i> <span data-bind="text: redCardCount"></span>
                                </span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Monthly Trend Chart -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-graph-up"></i> @Html.T("Report.MonthlyPenaltyTrend", "Aylik Ceza Trendi")</h5>
                </div>
                <div class="card-body">
                    <canvas id="penaltyTrendChart" style="max-height: 250px;"></canvas>
                </div>
            </div>
        </div>

        <!-- Detailed Penalty List -->
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-list-ul"></i> @Html.T("Report.PenaltyEvaluations", "Cezali Degerlendirmeler")</h5>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-danger" data-bind="text: totalCount() + ' @Html.T("Report.Records", "kayit")'"></span>
                        <!-- Pagination -->
                        <div class="btn-group btn-group-sm" data-bind="visible: totalPages() > 1">
                            <button class="btn btn-outline-secondary" data-bind="click: previousPage, disable: page() <= 1">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <span class="btn btn-outline-secondary disabled" data-bind="text: page() + ' / ' + totalPages()"></span>
                            <button class="btn btn-outline-secondary" data-bind="click: nextPage, disable: page() >= totalPages()">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div data-bind="visible: penalties().length === 0" class="text-center text-muted py-5">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">@Html.T("Report.NoPenaltyEvaluations", "Cezali degerlendirme bulunamadi.")</p>
                    </div>
                    <div data-bind="visible: penalties().length > 0" class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>@Html.T("Report.Date", "Tarih")</th>
                                    <th>@Html.T("Report.ProjectOrg", "Proje / Organizasyon")</th>
                                    <th>@Html.T("Report.Question", "Soru")</th>
                                    <th>@Html.T("Report.PenaltyType", "Ceza Tipi")</th>
                                    <th>@Html.T("Report.Evaluator", "Degerlendirici")</th>
                                    <th>@Html.T("Report.EvaluatedPerson", "Denetlenen")</th>
                                    <th class="text-center" style="width: 50px;">@Html.T("Common.Actions", "Islem")</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: penalties">
                                <tr data-bind="css: { 'table-warning': penaltyType === 'YellowCard', 'table-danger': penaltyType === 'RedCard' }">
                                    <td>
                                        <span data-bind="text: evaluationDate ? new Date(evaluationDate).toLocaleDateString('tr-TR') : '-'"></span>
                                    </td>
                                    <td>
                                        <span data-bind="text: projectName"></span>
                                        <small class="text-muted d-block" data-bind="text: organizationName || checklistName || '-'"></small>
                                    </td>
                                    <td>
                                        <span data-bind="text: questionText"></span>
                                        <small class="text-muted d-block" data-bind="text: groupName"></small>
                                    </td>
                                    <td>
                                        <span data-bind="visible: penaltyType === 'YellowCard'" class="badge bg-warning text-dark">
                                            <i class="bi bi-card-fill"></i> @Html.T("Report.YellowCard", "Sari Kart")
                                        </span>
                                        <span data-bind="visible: penaltyType === 'RedCard'" class="badge bg-danger">
                                            <i class="bi bi-card-fill"></i> @Html.T("Report.RedCard", "Kirmizi Kart")
                                        </span>
                                    </td>
                                    <td data-bind="text: evaluatorName || '-'"></td>
                                    <td data-bind="text: evaluatedPersonnelName || dealerName || '-'"></td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-bind="click: $parent.showEvaluationDetail" title="@Html.T("Report.ViewEvaluation", "Degerlendirmeyi Gor")">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- Bottom Pagination -->
                <div class="card-footer bg-white d-flex align-items-center gap-3" data-bind="visible: totalPages() > 1">
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-primary" data-bind="click: previousPage, disable: page() <= 1">
                            <i class="bi bi-chevron-left"></i> @Html.T("Common.Previous", "Onceki")
                        </button>
                        <button class="btn btn-outline-primary" data-bind="click: nextPage, disable: page() >= totalPages()">
                            @Html.T("Common.Next", "Sonraki") <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Evaluation Detail Modal -->
    <div class="modal fade" data-bind="css: { show: isDetailModalOpen }, style: { display: isDetailModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-clipboard-check"></i>
                        <!-- ko if: detailData() -->
                        <span data-bind="text: detailData().checklistName || '@Html.T("Evaluation.Details", "Degerlendirme Detayi")'"></span>
                        <!-- /ko -->
                    </h5>
                    <div>
                        <button type="button" class="btn btn-light btn-sm me-2" data-bind="click: $root.exportDetailToExcel, disable: $root.isExporting">
                            <i class="bi bi-file-earmark-excel"></i> @Html.T("Common.ExportExcel", "Excel")
                        </button>
                        <button type="button" class="btn-close btn-close-white" data-bind="click: closeDetailModal"></button>
                    </div>
                </div>
                <div class="modal-body">
                    <!-- Loading -->
                    <div data-bind="visible: isDetailLoading" class="text-center py-4">
                        <div class="spinner-border text-primary"></div>
                    </div>

                    <!-- Content -->
                    <div data-bind="visible: !isDetailLoading() && detailData(), with: detailData">
                        <!-- Summary Cards -->
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h2 class="mb-0" data-bind="text: (scorePercentage || 0).toFixed(2) + '%', css: scorePercentage >= 70 ? 'text-success' : (scorePercentage >= 50 ? 'text-warning' : 'text-danger')"></h2>
                                        <small class="text-muted">@Html.T("Report.TotalScore", "Toplam Puan")</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h2 class="mb-0 text-primary" data-bind="text: (totalScore || 0).toFixed(1) + ' / ' + (maxScore || 0).toFixed(1)"></h2>
                                        <small class="text-muted">@Html.T("Evaluation.RawScore", "Ham Puan")</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center bg-warning">
                                    <div class="card-body">
                                        <h2 class="mb-0" data-bind="text: yellowCardCount || 0"></h2>
                                        <small>@Html.T("Report.Yellow", "Sari Kart")</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center bg-danger text-white">
                                    <div class="card-body">
                                        <h2 class="mb-0" data-bind="text: redCardCount || 0"></h2>
                                        <small>@Html.T("Report.Red", "Kirmizi Kart")</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Info Cards -->
                        <div class="row mb-4">
                            <div class="col-md-4">
                                <div class="card h-100">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0"><i class="bi bi-building"></i> @Html.T("Evaluation.EvaluatedInfo", "Degerlendirilen Bilgileri")</h6>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr>
                                                <th style="width: 40%;">@Html.T("Common.Customer", "Firma")</th>
                                                <td data-bind="text: customerName || '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Common.Organization", "Organizasyon")</th>
                                                <td data-bind="text: organizationName || '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Report.Evaluated", "Degerlendirilen")</th>
                                                <td data-bind="text: evaluatedPersonnelName || dealerName || '-'"></td>
                                            </tr>
                                            <!-- ko if: supervisorName -->
                                            <tr>
                                                <th>@Html.T("Evaluation.Supervisor", "Musteri Yoneticisi")</th>
                                                <td data-bind="text: supervisorName"></td>
                                            </tr>
                                            <!-- /ko -->
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card h-100">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0"><i class="bi bi-telephone"></i> @Html.T("Call.CallInfo", "Cagri Bilgileri")</h6>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr>
                                                <th style="width: 40%;">@Html.T("Common.CallId", "Cagri ID")</th>
                                                <td>
                                                    <!-- ko if: callId -->
                                                    <span class="d-inline-flex align-items-center gap-1">
                                                        <span data-bind="text: $root.truncateCallId(callId), attr: { title: callId }"></span>
                                                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-1" data-bind="click: function() { $root.copyToClipboard(callId); }" title="@Html.T("Common.Copy", "Kopyala")">
                                                            <i class="bi bi-clipboard"></i>
                                                        </button>
                                                    </span>
                                                    <!-- /ko -->
                                                    <!-- ko ifnot: callId -->
                                                    <span>-</span>
                                                    <!-- /ko -->
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Report.CallDate", "Cagri Tarihi")</th>
                                                <td data-bind="text: callDate ? new Date(callDate).toLocaleDateString('tr-TR') : '-'"></td>
                                            </tr>
                                            <!-- ko if: callTime -->
                                            <tr>
                                                <th>@Html.T("Report.CallTime", "Cagri Saati")</th>
                                                <td data-bind="text: callTime"></td>
                                            </tr>
                                            <!-- /ko -->
                                            <tr>
                                                <th>@Html.T("Evaluation.Duration", "Sure")</th>
                                                <td data-bind="text: duration || '-'"></td>
                                            </tr>
                                            <!-- ko if: controlTime -->
                                            <tr>
                                                <th>@Html.T("Evaluation.ControlTime", "Kontrol Saati")</th>
                                                <td data-bind="text: controlTime"></td>
                                            </tr>
                                            <!-- /ko -->
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card h-100">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0"><i class="bi bi-person"></i> @Html.T("Evaluation.EvaluationInfo", "Degerlendirme Bilgileri")</h6>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr>
                                                <th style="width: 40%;">@Html.T("Evaluation.Evaluator", "Degerlendiren")</th>
                                                <td data-bind="text: evaluatorName || '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Evaluation.CompletedAt", "Tamamlanma")</th>
                                                <td data-bind="text: completedAt ? new Date(completedAt).toLocaleString('tr-TR') : '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Common.Status", "Durum")</th>
                                                <td><span class="badge bg-success" data-bind="text: status"></span></td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Descriptions -->
                        <div class="card mb-4" data-bind="visible: descriptions && descriptions.length > 0">
                            <div class="card-header bg-secondary text-white">
                                <h6 class="mb-0"><i class="bi bi-list-ul"></i> @Html.T("Evaluation.Descriptions", "Aciklamalar")</h6>
                            </div>
                            <div class="card-body">
                                <ul class="mb-0" data-bind="foreach: descriptions">
                                    <li data-bind="text: $data"></li>
                                </ul>
                            </div>
                        </div>

                        <!-- Evaluation Comment -->
                        <div class="card mb-4" data-bind="visible: evaluationComment">
                            <div class="card-header bg-info text-white">
                                <h6 class="mb-0"><i class="bi bi-chat-quote"></i> @Html.T("Evaluation.EvaluationComment", "Denetim Yorumu")</h6>
                            </div>
                            <div class="card-body">
                                <p class="mb-0" data-bind="text: evaluationComment"></p>
                            </div>
                        </div>

                        <!-- Answers -->
                        <div class="card">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="bi bi-list-check"></i> @Html.T("Evaluation.Answers", "Verilen Cevaplar")</h6>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-sm table-striped table-hover mb-0" style="table-layout: fixed;">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 18%;">@Html.T("Evaluation.Group", "Grup")</th>
                                                <th style="width: 25%;">@Html.T("Report.Question", "Soru")</th>
                                                <th class="text-center" style="width: 9%;">@Html.T("Common.Answer", "Cevap")</th>
                                                <th class="text-center" style="width: 9%;">@Html.T("Excel.Weight", "Agirlik")</th>
                                                <th class="text-center" style="width: 9%;">@Html.T("Evaluation.Earned", "Kazanilan")</th>
                                                <th style="width: 30%;">@Html.T("Evaluation.Notes", "Notlar")</th>
                                            </tr>
                                        </thead>
                                        <tbody data-bind="foreach: answers">
                                            <tr data-bind="css: { 'table-warning': penaltyType === 'YellowCard', 'table-danger': penaltyType === 'RedCard' }">
                                                <td class="text-wrap" data-bind="text: groupName || '-'"></td>
                                                <td class="text-wrap">
                                                    <span data-bind="text: questionText"></span>
                                                    <!-- ko if: selectedSubCriteria && selectedSubCriteria.length > 0 -->
                                                    <br><small class="text-warning"><i class="bi bi-exclamation-triangle"></i> <span data-bind="text: selectedSubCriteria.join(', ')"></span></small>
                                                    <!-- /ko -->
                                                </td>
                                                <td class="text-center">
                                                    <!-- ko if: answerNumeric !== null && answerNumeric !== undefined -->
                                                    <span class="badge bg-primary" data-bind="text: answerNumeric + '/' + (questionMaxPoints || 5)"></span>
                                                    <!-- /ko -->
                                                    <!-- ko if: (answerNumeric === null || answerNumeric === undefined) && answerText -->
                                                    <span data-bind="text: answerText"></span>
                                                    <!-- /ko -->
                                                    <!-- ko if: (answerNumeric === null || answerNumeric === undefined) && !answerText -->
                                                    <span class="text-muted">-</span>
                                                    <!-- /ko -->
                                                </td>
                                                <td class="text-center">
                                                    <!-- ko if: scoringType !== 'Unscored' -->
                                                    <span data-bind="text: weightPoints || 0"></span>
                                                    <!-- /ko -->
                                                    <!-- ko if: scoringType === 'Unscored' -->
                                                    <span class="text-muted">-</span>
                                                    <!-- /ko -->
                                                </td>
                                                <td class="text-center">
                                                    <!-- ko if: scoringType === 'Scored' -->
                                                    <span class="text-success" data-bind="text: (earnedPoints || 0).toFixed(1)"></span>
                                                    <!-- /ko -->
                                                    <!-- ko if: scoringType === 'Penalty' && isPenaltyApplied -->
                                                    <span class="text-danger fw-bold" data-bind="text: '-' + (earnedPoints || 0).toFixed(1)"></span>
                                                    <span class="badge ms-1" data-bind="css: penaltyType === 'YellowCard' ? 'bg-warning text-dark' : 'bg-danger', text: penaltyType === 'YellowCard' ? 'Sari' : 'Kirmizi'"></span>
                                                    <!-- /ko -->
                                                    <!-- ko if: scoringType === 'Penalty' && !isPenaltyApplied -->
                                                    <span class="text-muted">-</span>
                                                    <!-- /ko -->
                                                    <!-- ko if: scoringType === 'Unscored' -->
                                                    <span class="text-muted">-</span>
                                                    <!-- /ko -->
                                                </td>
                                                <td class="text-wrap" data-bind="text: notes || '-'"></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeDetailModal">
                        @Html.T("Common.Close", "Kapat")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="visible: isDetailModalOpen, css: { show: isDetailModalOpen }"></div>
</div>

@section Scripts {
    <script src="~/js/Reports/Penalties.js" asp-append-version="true"></script>
}
