@{
    ViewData["Title"] = @Html.T("Report.PersonnelQuestionPerformance", "Personel Soru Performans Raporu");
}

<div id="personnel-question-performance-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-person-lines-fill text-primary"></i> @Html.T("Report.PersonnelQuestionPerformance", "Personel Soru Performans Raporu")</h2>
    </div>

    <!-- Description -->
    <div class="alert alert-info mb-4">
        <i class="bi bi-info-circle me-2"></i>
        @Html.T("Report.PersonnelQuestionPerformanceDesc", "Bu rapor, personel ve soru grubu bazında performans verilerini Excel formatında indirir. Proje, personel, departman, kontrol sorusu, periyot, ortalama puan ve hata sayısı bilgilerini içerir.")
    </div>

    <!-- Filters Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="bi bi-funnel"></i> @Html.T("Common.Filters", "Filtreler")</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <!-- Customer -->
                <div class="col-md-4">
                    <label class="form-label">@Html.T("Common.Customer", "Müşteri")</label>
                    <select class="form-select" data-bind="value: filter.customerId, options: customers, optionsValue: 'id', optionsText: 'companyName', optionsCaption: '@Html.T("Common.All", "Tümü")', event: { change: onCustomerChange }"></select>
                </div>

                <!-- Project -->
                <div class="col-md-4">
                    <label class="form-label">@Html.T("Common.Project", "Proje")</label>
                    <select class="form-select" data-bind="value: filter.projectId, options: filteredProjects, optionsValue: 'id', optionsText: 'name', optionsCaption: '@Html.T("Common.All", "Tümü")'"></select>
                </div>

                <!-- Organization -->
                <div class="col-md-4">
                    <label class="form-label">@Html.T("Common.Organization", "Organizasyon")</label>
                    <select class="form-select" data-bind="value: filter.organizationId, options: filteredOrganizations, optionsValue: 'id', optionsText: 'name', optionsCaption: '@Html.T("Common.All", "Tümü")'"></select>
                </div>

                <!-- Period -->
                <div class="col-md-4">
                    <label class="form-label">@Html.T("Common.Period", "Periyot")</label>
                    <select class="form-select" data-bind="value: filter.periodId, options: periods, optionsValue: 'id', optionsText: 'name', optionsCaption: '@Html.T("Common.All", "Tümü")'"></select>
                </div>

                <!-- Start Date -->
                <div class="col-md-4">
                    <label class="form-label">@Html.T("Report.StartDate", "Başlangıç Tarihi")</label>
                    <input type="date" class="form-control" data-bind="value: filter.startDate" />
                </div>

                <!-- End Date -->
                <div class="col-md-4">
                    <label class="form-label">@Html.T("Report.EndDate", "Bitiş Tarihi")</label>
                    <input type="date" class="form-control" data-bind="value: filter.endDate" />
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-end gap-2 mt-4">
                <button class="btn btn-outline-secondary" data-bind="click: clearFilters">
                    <i class="bi bi-x-circle"></i> @Html.T("Common.ClearFilters", "Filtreleri Temizle")
                </button>
                <button class="btn btn-success" data-bind="click: exportReport, disable: isExporting">
                    <span data-bind="visible: !isExporting()">
                        <i class="bi bi-file-earmark-excel"></i> @Html.T("Common.ExportExcel", "Excel İndir")
                    </span>
                    <span data-bind="visible: isExporting">
                        <span class="spinner-border spinner-border-sm"></span> @Html.T("Common.Exporting", "İndiriliyor...")
                    </span>
                </button>
            </div>
        </div>
    </div>

    <!-- Report Info -->
    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="bi bi-table"></i> @Html.T("Report.ReportColumns", "Rapor Kolonları")</h5>
        </div>
        <div class="card-body">
            <table class="table table-sm table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>@Html.T("Common.Column", "Kolon")</th>
                        <th>@Html.T("Common.Description", "Açıklama")</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Proje</strong></td>
                        <td>Değerlendirmenin yapıldığı proje adı</td>
                    </tr>
                    <tr>
                        <td><strong>Müşteri Temsilcisi</strong></td>
                        <td>Değerlendirilen personelin adı soyadı</td>
                    </tr>
                    <tr>
                        <td><strong>Departman</strong></td>
                        <td>Personelin departmanı</td>
                    </tr>
                    <tr>
                        <td><strong>Kontrol Sorusu</strong></td>
                        <td>Soru grubu adı (GroupName)</td>
                    </tr>
                    <tr>
                        <td><strong>Periyot</strong></td>
                        <td>Yıl</td>
                    </tr>
                    <tr>
                        <td><strong>Periyot (Ay)</strong></td>
                        <td>YYYYMM formatında yıl ve ay</td>
                    </tr>
                    <tr>
                        <td><strong>Ortalama Puan</strong></td>
                        <td>Personelin o soru grubundaki ortalama puanı (%)</td>
                    </tr>
                    <tr>
                        <td><strong>Hata Sayısı</strong></td>
                        <td>Tam puan alınamayan cevap sayısı</td>
                    </tr>
                    <tr>
                        <td><strong>Değerlendirme Sayısı</strong></td>
                        <td>Toplam değerlendirme sayısı</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Reports/PersonnelQuestionPerformance.js"></script>
}
