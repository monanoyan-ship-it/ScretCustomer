@{
    ViewData["Title"] = @Html.T("Report.PersonnelQuestionPerformance", "Personel Soru Performans Raporu");
}

<div id="personnel-question-performance-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-person-lines-fill text-primary"></i> @Html.T("Report.PersonnelQuestionPerformance", "Personel Soru Performans Raporu")</h2>
    </div>

    <!-- Description -->
    <div class="alert alert-info mb-4">
        <i class="bi bi-info-circle me-2"></i>
        @Html.T("Report.PersonnelQuestionPerformanceDesc", "Bu rapor, personel ve soru grubu bazında performans verilerini Excel formatında indirir. Proje, personel, departman, kontrol sorusu, periyot, ortalama puan ve hata sayısı bilgilerini içerir.")
    </div>

    <!-- Filters Card - Chip-based -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-2">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <!-- Add Filter Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-outline-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                        <i class="bi bi-plus-circle me-1"></i>@Html.T("Common.AddFilter", "Filtre Ekle")
                    </button>
                    <div class="dropdown-menu p-3 filter-dropdown">
                        <!-- Filter Type Selector -->
                        <div class="mb-2">
                            <select class="form-select form-select-sm" data-bind="value: selectedFilterType">
                                <option value="">@Html.T("Common.SelectFilter", "Filtre Seçin...")</option>
                                <option value="customer">@Html.T("Common.Customer", "Müşteri")</option>
                                <option value="project">@Html.T("Common.Project", "Proje")</option>
                                <option value="organization">@Html.T("Common.Organization", "Organizasyon")</option>
                                <option value="dateRange">@Html.T("Common.DateRange", "Tarih Aralığı")</option>
                            </select>
                        </div>
                        <!-- Dynamic Filter Input -->
                        <!-- Customer -->
                        <div data-bind="visible: selectedFilterType() === 'customer'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="options: customers, optionsText: 'companyName', optionsValue: 'id', value: tempFilter.customerId, optionsCaption: '@Html.T("Common.Select", "Seçin...")'"></select>
                        </div>
                        <!-- Project -->
                        <div data-bind="visible: selectedFilterType() === 'project'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="options: filteredProjects, optionsText: 'name', optionsValue: 'id', value: tempFilter.projectId, optionsCaption: '@Html.T("Common.Select", "Seçin...")'"></select>
                        </div>
                        <!-- Organization -->
                        <div data-bind="visible: selectedFilterType() === 'organization'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="options: filteredOrganizations, optionsText: 'name', optionsValue: 'id', value: tempFilter.organizationId, optionsCaption: '@Html.T("Common.Select", "Seçin...")'"></select>
                        </div>
                        <!-- Date Range -->
                        <div data-bind="visible: selectedFilterType() === 'dateRange'" class="mb-2">
                            <div class="d-flex gap-1 mb-2">
                                <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.startDate">
                                <span class="align-self-center">-</span>
                                <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.endDate">
                            </div>
                            <div class="d-flex flex-wrap gap-1">
                                <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('today'); }, css: tempFilter.dateRangeType() === 'today' ? 'btn-primary' : 'btn-outline-secondary'">Bugün</button>
                                <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('yesterday'); }, css: tempFilter.dateRangeType() === 'yesterday' ? 'btn-primary' : 'btn-outline-secondary'">Dün</button>
                                <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('thisWeek'); }, css: tempFilter.dateRangeType() === 'thisWeek' ? 'btn-primary' : 'btn-outline-secondary'">Bu Hafta</button>
                                <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('lastWeek'); }, css: tempFilter.dateRangeType() === 'lastWeek' ? 'btn-primary' : 'btn-outline-secondary'">Geçen Hafta</button>
                            </div>
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('thisMonth'); }, css: tempFilter.dateRangeType() === 'thisMonth' ? 'btn-primary' : 'btn-outline-secondary'">Bu Ay</button>
                                <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('lastMonth'); }, css: tempFilter.dateRangeType() === 'lastMonth' ? 'btn-primary' : 'btn-outline-secondary'">Geçen Ay</button>
                                <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('last3Months'); }, css: tempFilter.dateRangeType() === 'last3Months' ? 'btn-primary' : 'btn-outline-secondary'">Son 3 Ay</button>
                                <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('last6Months'); }, css: tempFilter.dateRangeType() === 'last6Months' ? 'btn-primary' : 'btn-outline-secondary'">Son 6 Ay</button>
                            </div>
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('thisYear'); }, css: tempFilter.dateRangeType() === 'thisYear' ? 'btn-primary' : 'btn-outline-secondary'">Bu Yıl</button>
                                <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('lastYear'); }, css: tempFilter.dateRangeType() === 'lastYear' ? 'btn-primary' : 'btn-outline-secondary'">Geçen Yıl</button>
                            </div>
                        </div>
                        <!-- Add Button -->
                        <button type="button" class="btn btn-primary btn-sm w-100" data-bind="click: addFilter, enable: canAddFilter">
                            <i class="bi bi-plus"></i> @Html.T("Common.Add", "Ekle")
                        </button>
                    </div>
                </div>

                <!-- Active Filters (Chips) -->
                <!-- ko foreach: activeFilters -->
                <span class="badge bg-primary d-flex align-items-center gap-1 py-2 px-2">
                    <span data-bind="text: label"></span>: <strong data-bind="text: displayValue"></strong>
                    <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.6rem;" data-bind="click: $parent.removeFilter"></button>
                </span>
                <!-- /ko -->

                <!-- Clear All -->
                <button class="btn btn-outline-danger btn-sm" data-bind="visible: activeFilters().length > 0, click: clearFilters">
                    <i class="bi bi-x-circle"></i> @Html.T("Common.ClearAll", "Temizle")
                </button>

                <!-- Spacer -->
                <div class="flex-grow-1"></div>

                <!-- Export Button -->
                <button class="btn btn-success" data-bind="click: exportReport, disable: isExporting">
                    <span data-bind="visible: !isExporting()">
                        <i class="bi bi-file-earmark-excel"></i> @Html.T("Common.ExportExcel", "Excel İndir")
                    </span>
                    <span data-bind="visible: isExporting">
                        <span class="spinner-border spinner-border-sm"></span> @Html.T("Common.Exporting", "İndiriliyor...")
                    </span>
                </button>
            </div>

        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="text-muted mt-2">@Html.T("Common.Loading", "Yükleniyor...")</p>
    </div>

    <!-- Report Info -->
    <div data-bind="visible: !isLoading()" class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="bi bi-table"></i> @Html.T("Report.ReportColumns", "Rapor Kolonları")</h5>
        </div>
        <div class="card-body">
            <table class="table table-sm table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>@Html.T("Common.Column", "Kolon")</th>
                        <th>@Html.T("Common.Description", "Açıklama")</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Proje</strong></td>
                        <td>Değerlendirmenin yapıldığı proje adı</td>
                    </tr>
                    <tr>
                        <td><strong>Müşteri Temsilcisi</strong></td>
                        <td>Değerlendirilen personelin adı soyadı</td>
                    </tr>
                    <tr>
                        <td><strong>Departman</strong></td>
                        <td>Personelin departmanı</td>
                    </tr>
                    <tr>
                        <td><strong>Kontrol Sorusu</strong></td>
                        <td>Soru grubu adı (GroupName)</td>
                    </tr>
                    <tr>
                        <td><strong>Periyot</strong></td>
                        <td>Yıl</td>
                    </tr>
                    <tr>
                        <td><strong>Periyot (Ay)</strong></td>
                        <td>YYYYMM formatında yıl ve ay</td>
                    </tr>
                    <tr>
                        <td><strong>Ortalama Puan</strong></td>
                        <td>Personelin o soru grubundaki ortalama puanı (%)</td>
                    </tr>
                    <tr>
                        <td><strong>Hata Sayısı</strong></td>
                        <td>Tam puan alınamayan cevap sayısı</td>
                    </tr>
                    <tr>
                        <td><strong>Değerlendirme Sayısı</strong></td>
                        <td>Toplam değerlendirme sayısı</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Reports/PersonnelQuestionPerformance.js"></script>
}
