@{
    ViewData["Title"] = @Html.T("Menu.PersonnelQuestionPerformance", "Personel Soru Performans Raporu");
}

<div id="personnel-question-performance-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-person-lines-fill text-primary"></i> @Html.T("Menu.PersonnelQuestionPerformance", "Personel Soru Performans Raporu")</h2>
        <div class="btn-group" data-bind="visible: report()">
            <button class="btn btn-success" data-bind="click: exportToExcel, disable: isExporting">
                <span data-bind="visible: !isExporting()">
                    <i class="bi bi-file-earmark-excel"></i> @Html.T("Common.ExportExcel", "Excel Indir")
                </span>
                <span data-bind="visible: isExporting">
                    <span class="spinner-border spinner-border-sm"></span> @Html.T("Report.Downloading", "Indiriliyor...")
                </span>
            </button>
        </div>
    </div>

    <!-- Filters Card - Two Stage (PersonnelReportCard pattern) -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-funnel"></i> @Html.T("Common.Filters", "Filtreler")</h5>
        </div>
        <div class="card-body">
            <!-- Stage 1: Hiyerarsik Secim -->
            <div class="row g-2 mb-3">
                <div class="col-md-3">
                    <label class="form-label small mb-1">@Html.T("Report.Customer", "Musteri")</label>
                    <select class="form-select form-select-sm" data-bind="value: selectedCustomerId, options: customers, optionsValue: 'id', optionsText: 'companyName', optionsCaption: '@Html.T("Common.AllCustomers", "Tum Musteriler")', event: { change: onCustomerChange }"></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">@Html.T("Report.Organization", "Sube")</label>
                    <select class="form-select form-select-sm" data-bind="value: selectedOrganizationId, options: organizations, optionsValue: 'id', optionsText: 'name', optionsCaption: '@Html.T("Common.AllOrganizations", "Tum Subeler")', event: { change: onOrganizationChange }, enable: organizations().length > 0"></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-1">@Html.T("Common.Project", "Proje")</label>
                    <select class="form-select form-select-sm" data-bind="value: selectedProjectId, options: filteredProjects, optionsValue: 'id', optionsText: 'name', optionsCaption: '@Html.T("Common.AllProjects", "Tum Projeler")'"></select>
                </div>
                <div class="col-md-3 d-flex align-items-end gap-1">
                    <button class="btn btn-primary btn-sm" data-bind="click: loadReport, disable: isLoading">
                        <i class="bi bi-search"></i> @Html.T("Common.Fetch", "Getir")
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" data-bind="click: clearFilters">
                        <i class="bi bi-x-circle"></i> @Html.T("Common.Clear", "Temizle")
                    </button>
                </div>
            </div>

            <!-- Stage 2: Ek Filtreler (Chip-based) -->
            <div class="border-top pt-3">
                <div class="row g-2 align-items-end">
                    <!-- Filtre Tipi Secimi -->
                    <div class="col-md-2">
                        <label class="form-label small mb-1">@Html.T("Report.AddFilter", "Filtre Ekle")</label>
                        <select class="form-select form-select-sm" data-bind="value: selectedFilterType">
                            <option value="">@Html.T("Common.Select", "Secin...")</option>
                            <option value="dateRange">@Html.T("Common.DateRange", "Tarih Araligi")</option>
                        </select>
                    </div>

                    <!-- Tarih Araligi Secimi -->
                    <div class="col-md-6" data-bind="visible: selectedFilterType() === 'dateRange'">
                        <label class="form-label small mb-1">@Html.T("Report.DateRange", "Tarih Araligi")</label>
                        <div class="d-flex gap-1 align-items-center flex-wrap">
                            <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.startDate" style="width: 130px;">
                            <span class="text-muted">-</span>
                            <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.endDate" style="width: 130px;">
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <span data-bind="text: tempFilter.dateRangeType() ? dateRangeLabels[tempFilter.dateRangeType()] : '@Html.T("Common.QuickSelect", "Hizli Sec")'"></span>
                                </button>
                                <ul class="dropdown-menu">
                                    <li><h6 class="dropdown-header">@Html.T("Common.Day", "Gun")</h6></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('today'); }">@Html.T("Common.Today", "Bugun")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('yesterday'); }">@Html.T("Common.Yesterday", "Dun")</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">@Html.T("Common.Week", "Hafta")</h6></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('thisWeek'); }">@Html.T("Common.ThisWeek", "Bu Hafta")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('lastWeek'); }">@Html.T("Common.LastWeek", "Gecen Hafta")</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">@Html.T("Common.Month", "Ay")</h6></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('thisMonth'); }">@Html.T("Common.ThisMonth", "Bu Ay")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('lastMonth'); }">@Html.T("Common.LastMonth", "Gecen Ay")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('last3Months'); }">@Html.T("Common.Last3Months", "Son 3 Ay")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('last6Months'); }">@Html.T("Common.Last6Months", "Son 6 Ay")</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">@Html.T("Common.Year", "Yil")</h6></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('thisYear'); }">@Html.T("Common.ThisYear", "Bu Yil")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('lastYear'); }">@Html.T("Common.LastYear", "Gecen Yil")</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Filtre Ekle Butonu -->
                    <div class="col-auto" data-bind="visible: selectedFilterType()">
                        <button class="btn btn-success btn-sm" data-bind="click: addFilter, enable: canAddFilter">
                            <i class="bi bi-plus-circle"></i> @Html.T("Common.Add", "Ekle")
                        </button>
                    </div>
                </div>

                <!-- Aktif Filtreler (Chips) -->
                <div class="mt-2" data-bind="visible: activeFilters().length > 0">
                    <div class="d-flex flex-wrap gap-1 align-items-center">
                        <small class="text-muted me-1">@Html.T("Common.Filters", "Filtreler"):</small>
                        <!-- ko foreach: activeFilters -->
                        <span class="badge bg-primary d-flex align-items-center">
                            <span data-bind="text: label + ': ' + displayValue"></span>
                            <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.6rem;" data-bind="click: $parent.removeFilter"></button>
                        </span>
                        <!-- /ko -->
                        <button class="btn btn-outline-danger btn-sm" data-bind="click: clearAllFilters, visible: activeFilters().length > 1">
                            <i class="bi bi-x-circle"></i> @Html.T("Common.ClearAll", "Tumunu Temizle")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="text-muted mt-2">@Html.T("Common.Loading", "Yukleniyor...")</p>
    </div>

    <!-- No Data -->
    <div data-bind="visible: !isLoading() && !report()" class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-bar-chart fs-1 text-muted"></i>
            <p class="mt-3 text-muted">@Html.T("Report.SelectFiltersAndLoad", "Filtreleri secip 'Getir' butonuna tiklayin.")</p>
        </div>
    </div>

    <!-- Report Table -->
    <div data-bind="visible: !isLoading() && report()" class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-table"></i> @Html.T("Report.QuestionGroupPerformance", "Soru Grubu Performansi")</h5>
            <span class="badge bg-primary" data-bind="text: report() ? report().rows.length + ' @Html.T("Common.PersonnelSuffix", "Personel")' + ', ' + report().totalEvaluations + ' @Html.T("Common.EvaluationSuffix", "Degerlendirme")' : ''"></span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark sticky-top">
                        <tr>
                            <th class="sticky-col bg-dark" style="min-width: 180px; left: 0; z-index: 10;">@Html.T("Report.Personnel", "Personel")</th>
                            <th style="min-width: 120px;">@Html.T("Report.Organization", "Sube")</th>
                            <!-- Dynamic GroupName columns -->
                            <!-- ko foreach: report() ? report().groupNames : [] -->
                            <th class="text-center" style="min-width: 100px;" data-bind="text: $data"></th>
                            <!-- /ko -->
                            <th class="text-center bg-secondary text-white" style="min-width: 80px;">@Html.T("Report.OverallAverage", "Genel Ort.")</th>
                            <th class="text-center" style="min-width: 60px;">@Html.T("Report.EvaluationCount", "Deg.")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: report() ? report().rows : []">
                        <tr>
                            <td class="sticky-col bg-white fw-bold" style="left: 0;">
                                <span data-bind="text: personnelName"></span>
                                <!-- ko if: department -->
                                <br><small class="text-muted" data-bind="text: department"></small>
                                <!-- /ko -->
                            </td>
                            <td>
                                <small class="text-muted" data-bind="text: organizationName || '-'"></small>
                            </td>
                            <!-- ko foreach: groupScores -->
                            <td class="text-center" data-bind="css: $root.getScoreCellClass(averageScore)">
                                <!-- ko if: averageScore !== null -->
                                <span data-bind="text: averageScore.toFixed(1) + '%'"></span>
                                <small class="d-block text-muted" data-bind="text: '(' + evaluationCount + ')'"></small>
                                <!-- ko if: errorCount > 0 -->
                                <span class="badge bg-danger badge-sm" data-bind="text: errorCount + ' @Html.T("Common.Error", "hata")'"></span>
                                <!-- /ko -->
                                <!-- /ko -->
                                <!-- ko if: averageScore === null -->
                                <span class="text-muted">-</span>
                                <!-- /ko -->
                            </td>
                            <!-- /ko -->
                            <td class="text-center fw-bold" data-bind="css: $root.getScoreCellClass(overallAverage)">
                                <span data-bind="text: overallAverage.toFixed(1) + '%'"></span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary" data-bind="text: totalEvaluations"></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <!-- Legend -->
        <div class="card-footer bg-white">
            <small class="text-muted">
                <span class="badge bg-success me-2">&nbsp;</span> 80%+ |
                <span class="badge bg-warning text-dark me-2">&nbsp;</span> 60-79% |
                <span class="badge bg-danger me-2">&nbsp;</span> &lt;60%
            </small>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Reports/PersonnelQuestionPerformance.js"></script>
}
