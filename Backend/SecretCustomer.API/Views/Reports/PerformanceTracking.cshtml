@{
    ViewData["Title"] = @Html.T("Menu.PerformanceTracking", "Performans Takibi");
}

<div id="performance-tracking-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-graph-up text-primary"></i> @Html.T("Menu.PerformanceTracking", "Performans Takibi")</h2>
        <button class="btn btn-outline-primary" data-bind="click: refresh, disable: isLoading">
            <span data-bind="visible: !isLoading()">
                <i class="bi bi-arrow-clockwise"></i> @Html.T("Common.Refresh", "Yenile")
            </span>
            <span data-bind="visible: isLoading">
                <span class="spinner-border spinner-border-sm"></span>
            </span>
        </button>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body py-2">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <!-- Add Filter Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-outline-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                        <i class="bi bi-plus-circle me-1"></i>@Html.T("Common.AddFilter", "Filtre Ekle")
                    </button>
                    <div class="dropdown-menu p-3 filter-dropdown">
                        <!-- Filter Type Selector -->
                        <div class="mb-2">
                            <select class="form-select form-select-sm" data-bind="value: selectedFilterType">
                                <option value="">@Html.T("Common.SelectFilter", "Filtre Seçin...")</option>
                                <option value="customer">@Html.T("Report.Customer", "Firma")</option>
                                <option value="evaluator">@Html.T("Report.Evaluator", "Dinleyici")</option>
                                <option value="project">@Html.T("Common.Project", "Proje")</option>
                                <option value="dateRange">@Html.T("Common.DateRange", "Tarih Aralığı")</option>
                            </select>
                        </div>
                        <!-- Customer -->
                        <div data-bind="visible: selectedFilterType() === 'customer'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="options: customers, optionsText: 'companyName', optionsValue: 'id', value: tempFilter.customerId, optionsCaption: '@Html.T("Common.Select", "Seçin...")'"></select>
                        </div>
                        <!-- Evaluator -->
                        <div data-bind="visible: selectedFilterType() === 'evaluator'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="options: evaluators, optionsText: 'fullName', optionsValue: 'id', value: tempFilter.evaluatorId, optionsCaption: '@Html.T("Common.Select", "Seçin...")'"></select>
                        </div>
                        <!-- Project -->
                        <div data-bind="visible: selectedFilterType() === 'project'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="options: projects, optionsText: function(item) { return item.code ? item.code + ' - ' + item.name : item.name; }, optionsValue: 'id', value: tempFilter.projectId, optionsCaption: '@Html.T("Common.Select", "Seçin...")'"></select>
                        </div>
                        <!-- Date Range -->
                        <div data-bind="visible: selectedFilterType() === 'dateRange'" class="mb-2">
                            <div class="d-flex gap-1 mb-1">
                                <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.startDate" autocomplete="off">
                                <span class="align-self-center">-</span>
                                <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.endDate" autocomplete="off">
                            </div>
                            <div class="d-flex flex-wrap gap-1">
                                <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('today'); }, css: tempFilter.dateRangeType() === 'today' ? 'btn-primary' : 'btn-outline-secondary'">@Html.T("DateRange.Today", "Bugün")</button>
                                <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('yesterday'); }, css: tempFilter.dateRangeType() === 'yesterday' ? 'btn-primary' : 'btn-outline-secondary'">@Html.T("DateRange.Yesterday", "Dün")</button>
                                <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('thisWeek'); }, css: tempFilter.dateRangeType() === 'thisWeek' ? 'btn-primary' : 'btn-outline-secondary'">@Html.T("DateRange.ThisWeek", "Bu Hafta")</button>
                                <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('lastWeek'); }, css: tempFilter.dateRangeType() === 'lastWeek' ? 'btn-primary' : 'btn-outline-secondary'">@Html.T("DateRange.LastWeek", "Geçen Hafta")</button>
                            </div>
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('thisMonth'); }, css: tempFilter.dateRangeType() === 'thisMonth' ? 'btn-primary' : 'btn-outline-secondary'">@Html.T("DateRange.ThisMonth", "Bu Ay")</button>
                                <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('lastMonth'); }, css: tempFilter.dateRangeType() === 'lastMonth' ? 'btn-primary' : 'btn-outline-secondary'">@Html.T("DateRange.LastMonth", "Geçen Ay")</button>
                                <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('last3Months'); }, css: tempFilter.dateRangeType() === 'last3Months' ? 'btn-primary' : 'btn-outline-secondary'">@Html.T("DateRange.Last3Months", "Son 3 Ay")</button>
                                <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('last6Months'); }, css: tempFilter.dateRangeType() === 'last6Months' ? 'btn-primary' : 'btn-outline-secondary'">@Html.T("DateRange.Last6Months", "Son 6 Ay")</button>
                            </div>
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('thisYear'); }, css: tempFilter.dateRangeType() === 'thisYear' ? 'btn-primary' : 'btn-outline-secondary'">@Html.T("DateRange.ThisYear", "Bu Yıl")</button>
                                <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('lastYear'); }, css: tempFilter.dateRangeType() === 'lastYear' ? 'btn-primary' : 'btn-outline-secondary'">@Html.T("DateRange.LastYear", "Geçen Yıl")</button>
                            </div>
                        </div>
                        <!-- Add Button -->
                        <button type="button" class="btn btn-primary btn-sm w-100" data-bind="click: addFilter, enable: canAddFilter">
                            <i class="bi bi-plus"></i> @Html.T("Common.Add", "Ekle")
                        </button>
                    </div>
                </div>

                <!-- Active Filters (Chips) -->
                <!-- ko foreach: activeFilters -->
                <span class="badge bg-primary d-flex align-items-center gap-1 py-2 px-2">
                    <span data-bind="text: label"></span>: <strong data-bind="text: displayValue"></strong>
                    <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.6rem;" data-bind="click: $parent.removeFilter"></button>
                </span>
                <!-- /ko -->

                <!-- Clear All -->
                <button class="btn btn-outline-danger btn-sm" data-bind="visible: activeFilters().length > 0, click: clearFilters">
                    <i class="bi bi-x-circle"></i> @Html.T("Common.ClearAll", "Temizle")
                </button>

                <!-- Spacer -->
                <div class="flex-grow-1"></div>

                <!-- Search Button -->
                <button class="btn btn-primary btn-sm" data-bind="click: search, disable: isLoading">
                    <i class="bi bi-search me-1"></i>@Html.T("Common.Search", "Ara")
                </button>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Yükleniyor...")</p>
    </div>

    <div data-bind="visible: !isLoading()">
        <!-- Summary Cards -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-info text-white h-100">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-1">@Html.T("Report.TodayEvaluations", "Bugün")</h6>
                                <h2 class="mb-0" data-bind="text: summary().totalTodayEvaluations"></h2>
                            </div>
                            <i class="bi bi-calendar-day fs-1 opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-primary text-white h-100">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-1">@Html.T("Report.WeekEvaluations", "Bu Hafta")</h6>
                                <h2 class="mb-0" data-bind="text: summary().totalWeekEvaluations"></h2>
                            </div>
                            <i class="bi bi-calendar-week fs-1 opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white h-100">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-1">@Html.T("Common.ThisMonth", "Bu Ay")</h6>
                                <h2 class="mb-0" data-bind="text: summary().totalMonthEvaluations"></h2>
                            </div>
                            <i class="bi bi-calendar-month fs-1 opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-dark h-100">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-dark-50 mb-1">@Html.T("Common.ThisYear", "Bu Yıl")</h6>
                                <h2 class="mb-0" data-bind="text: summary().totalYearEvaluations"></h2>
                            </div>
                            <i class="bi bi-calendar fs-1 opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Evaluator Performance Table -->
            <div class="col-lg-6 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-people"></i> @Html.T("Report.EvaluatorPerformance", "Dinleyici Performansı")</h5>
                    </div>
                    <div class="card-body p-0">
                        <!-- ko if: evaluatorPerformances().length === 0 -->
                        <div class="alert alert-info m-3">
                            <i class="bi bi-info-circle"></i> @Html.T("Report.NoEvaluatorData", "Henüz dinleme verisi bulunmuyor.")
                        </div>
                        <!-- /ko -->
                        <!-- ko if: evaluatorPerformances().length > 0 -->
                        <div style="max-height: 350px; overflow-y: auto; overflow-x: auto;">
                            <table class="table table-hover table-sm mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>@Html.T("Report.Evaluator", "Dinleyici")</th>
                                        <th class="text-center">@Html.T("Report.Today", "Bugün")</th>
                                        <th class="text-center">@Html.T("Common.Week", "Hafta")</th>
                                        <th class="text-center">@Html.T("Common.Month", "Ay")</th>
                                        <th class="text-center">@Html.T("Common.Year", "Yıl")</th>
                                        <th class="text-center">@Html.T("Report.Total", "Toplam")</th>
                                        <th class="text-center">@Html.T("Report.AvgScore", "Ort. Puan")</th>
                                    </tr>
                                </thead>
                                <tbody data-bind="foreach: evaluatorPerformances">
                                    <tr>
                                        <td>
                                            <strong data-bind="text: evaluatorName"></strong>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge" data-bind="text: todayCount, css: todayCount > 0 ? 'bg-info' : 'bg-secondary'"></span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-primary" data-bind="text: weekCount"></span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-success" data-bind="text: monthCount"></span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-warning text-dark" data-bind="text: yearCount"></span>
                                        </td>
                                        <td class="text-center">
                                            <strong data-bind="text: totalCount"></strong>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge" data-bind="text: averageScore.toFixed(2) + '%', css: averageScore >= 80 ? 'bg-success' : (averageScore >= 60 ? 'bg-warning text-dark' : 'bg-danger')"></span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <!-- /ko -->
                    </div>
                    <div class="card-footer text-muted small">
                        <i class="bi bi-info-circle"></i> @Html.T("Report.EvaluatorCount", "Toplam Dinleyici"): <strong data-bind="text: summary().totalEvaluators"></strong>
                    </div>
                </div>
            </div>

            <!-- Customer Quota Status Table -->
            <div class="col-lg-6 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-building"></i> @Html.T("Report.CustomerQuotaStatus", "Firma Kota Durumu")</h5>
                    </div>
                    <div class="card-body p-0">
                        <!-- ko if: customerQuotaStatuses().length === 0 -->
                        <div class="alert alert-info m-3">
                            <i class="bi bi-info-circle"></i> @Html.T("Report.NoCustomerData", "Henüz firma verisi bulunmuyor.")
                        </div>
                        <!-- /ko -->
                        <!-- ko if: customerQuotaStatuses().length > 0 -->
                        <div style="max-height: 350px; overflow-y: auto; overflow-x: auto;">
                            <table class="table table-hover table-sm mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>@Html.T("Report.Customer", "Firma")</th>
                                        <th class="text-center">@Html.T("Report.Target", "Hedef")</th>
                                        <th class="text-center">@Html.T("Report.Done", "Yapılan")</th>
                                        <th class="text-center">@Html.T("Report.Completion", "Tamamlanma")</th>
                                        <th class="text-center">@Html.T("Report.DailyQuota", "Günlük")</th>
                                        <th class="text-center">@Html.T("Report.MonthlyQuota", "Aylık")</th>
                                    </tr>
                                </thead>
                                <tbody data-bind="foreach: customerQuotaStatuses">
                                    <tr>
                                        <td>
                                            <div>
                                                <strong data-bind="text: customerName"></strong>
                                                <!-- ko if: customerCode -->
                                                <br><small class="text-muted" data-bind="text: customerCode"></small>
                                                <!-- /ko -->
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <span data-bind="text: targetCount || '-'"></span>
                                        </td>
                                        <td class="text-center">
                                            <strong data-bind="text: totalCount"></strong>
                                        </td>
                                        <td class="text-center">
                                            <!-- ko if: targetCompletionPercentage !== null -->
                                            <div class="progress" style="height: 20px; min-width: 80px;">
                                                <div class="progress-bar" role="progressbar"
                                                     data-bind="style: { width: Math.min(targetCompletionPercentage, 100) + '%' },
                                                                css: targetCompletionPercentage >= 100 ? 'bg-success' : (targetCompletionPercentage >= 50 ? 'bg-primary' : 'bg-warning'),
                                                                text: targetCompletionPercentage.toFixed(2) + '%'">
                                                </div>
                                            </div>
                                            <!-- /ko -->
                                            <!-- ko if: targetCompletionPercentage === null -->
                                            <span class="text-muted">-</span>
                                            <!-- /ko -->
                                        </td>
                                        <td class="text-center">
                                            <!-- ko if: dailyQuota -->
                                            <span data-bind="text: todayCount + '/' + dailyQuota"></span>
                                            <br>
                                            <small class="badge" data-bind="text: (dailyQuotaUsagePercentage || 0).toFixed(2) + '%',
                                                   css: dailyQuotaUsagePercentage >= 100 ? 'bg-success' : (dailyQuotaUsagePercentage >= 50 ? 'bg-primary' : 'bg-secondary')"></small>
                                            <!-- /ko -->
                                            <!-- ko ifnot: dailyQuota -->
                                            <span class="text-muted">-</span>
                                            <!-- /ko -->
                                        </td>
                                        <td class="text-center">
                                            <!-- ko if: monthlyQuota -->
                                            <span data-bind="text: monthCount + '/' + monthlyQuota"></span>
                                            <br>
                                            <small class="badge" data-bind="text: (monthlyQuotaUsagePercentage || 0).toFixed(2) + '%',
                                                   css: monthlyQuotaUsagePercentage >= 100 ? 'bg-success' : (monthlyQuotaUsagePercentage >= 50 ? 'bg-primary' : 'bg-secondary')"></small>
                                            <!-- /ko -->
                                            <!-- ko ifnot: monthlyQuota -->
                                            <span class="text-muted">-</span>
                                            <!-- /ko -->
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <!-- /ko -->
                    </div>
                    <div class="card-footer text-muted small">
                        <i class="bi bi-info-circle"></i> @Html.T("Report.ActiveCustomers", "Aktif Firma"): <strong data-bind="text: summary().totalActiveCustomers"></strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Proje Tipi Performans Karşılaştırması -->
        <div class="row" data-bind="visible: projectTypePerformances().length > 0">
            <div class="col-12 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="bi bi-bullseye"></i> @Html.T("Report.ProjectTypeTargets", "Proje Tipi Hedef Karşılaştırması")</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>@Html.T("Report.ProjectType", "Proje Tipi")</th>
                                        <th class="text-center">@Html.T("Report.DailyTarget", "Günlük Hedef")</th>
                                        <th class="text-center">@Html.T("Report.WeeklyTarget", "Haftalık Hedef")</th>
                                        <th class="text-center">@Html.T("Report.MonthlyTarget", "Aylık Hedef")</th>
                                        <th class="text-center">@Html.T("Report.YearlyTarget", "Yıllık Hedef")</th>
                                        <th class="text-center">@Html.T("Report.AvgScore", "Ort. Puan")</th>
                                    </tr>
                                </thead>
                                <tbody data-bind="foreach: projectTypePerformances">
                                    <tr>
                                        <td>
                                            <strong data-bind="text: projectTypeName"></strong>
                                        </td>
                                        <td class="text-center">
                                            <!-- ko if: dailyTarget -->
                                            <div>
                                                <span data-bind="text: todayCount + '/' + dailyTarget"></span>
                                                <div class="progress mt-1" style="height: 6px;">
                                                    <div class="progress-bar" role="progressbar"
                                                         data-bind="style: { width: Math.min(dailyPercentage || 0, 100) + '%' },
                                                                    css: (dailyPercentage || 0) >= 100 ? 'bg-success' : ((dailyPercentage || 0) >= 50 ? 'bg-primary' : 'bg-danger')">
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- /ko -->
                                            <!-- ko ifnot: dailyTarget -->
                                            <span class="text-muted" data-bind="text: todayCount > 0 ? todayCount : '-'"></span>
                                            <!-- /ko -->
                                        </td>
                                        <td class="text-center">
                                            <!-- ko if: weeklyTarget -->
                                            <div>
                                                <span data-bind="text: weekCount + '/' + weeklyTarget"></span>
                                                <div class="progress mt-1" style="height: 6px;">
                                                    <div class="progress-bar" role="progressbar"
                                                         data-bind="style: { width: Math.min(weeklyPercentage || 0, 100) + '%' },
                                                                    css: (weeklyPercentage || 0) >= 100 ? 'bg-success' : ((weeklyPercentage || 0) >= 50 ? 'bg-primary' : 'bg-danger')">
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- /ko -->
                                            <!-- ko ifnot: weeklyTarget -->
                                            <span class="text-muted" data-bind="text: weekCount > 0 ? weekCount : '-'"></span>
                                            <!-- /ko -->
                                        </td>
                                        <td class="text-center">
                                            <!-- ko if: monthlyTarget -->
                                            <div>
                                                <span data-bind="text: monthCount + '/' + monthlyTarget"></span>
                                                <div class="progress mt-1" style="height: 6px;">
                                                    <div class="progress-bar" role="progressbar"
                                                         data-bind="style: { width: Math.min(monthlyPercentage || 0, 100) + '%' },
                                                                    css: (monthlyPercentage || 0) >= 100 ? 'bg-success' : ((monthlyPercentage || 0) >= 50 ? 'bg-primary' : 'bg-danger')">
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- /ko -->
                                            <!-- ko ifnot: monthlyTarget -->
                                            <span class="text-muted" data-bind="text: monthCount > 0 ? monthCount : '-'"></span>
                                            <!-- /ko -->
                                        </td>
                                        <td class="text-center">
                                            <!-- ko if: yearlyTarget -->
                                            <div>
                                                <span data-bind="text: yearCount + '/' + yearlyTarget"></span>
                                                <div class="progress mt-1" style="height: 6px;">
                                                    <div class="progress-bar" role="progressbar"
                                                         data-bind="style: { width: Math.min(yearlyPercentage || 0, 100) + '%' },
                                                                    css: (yearlyPercentage || 0) >= 100 ? 'bg-success' : ((yearlyPercentage || 0) >= 50 ? 'bg-primary' : 'bg-danger')">
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- /ko -->
                                            <!-- ko ifnot: yearlyTarget -->
                                            <span class="text-muted" data-bind="text: yearCount > 0 ? yearCount : '-'"></span>
                                            <!-- /ko -->
                                        </td>
                                        <td class="text-center">
                                            <!-- ko if: averageScore > 0 -->
                                            <span class="badge" data-bind="text: averageScore.toFixed(2) + '%',
                                                   css: averageScore >= (successThreshold || 80) ? 'bg-success' : (averageScore >= (warningThreshold || 60) ? 'bg-warning text-dark' : 'bg-danger')"></span>
                                            <!-- /ko -->
                                            <!-- ko if: averageScore === 0 -->
                                            <span class="badge bg-secondary">-</span>
                                            <!-- /ko -->
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer text-muted small">
                        <i class="bi bi-info-circle"></i> @Html.T("Report.TargetsFromSettings", "Hedefler Performans Ayarları'ndan alınmaktadır.")
                        <a href="/Settings/PerformanceSettings" class="ms-2"><i class="bi bi-gear"></i> @Html.T("Report.EditSettings", "Ayarları Düzenle")</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Reports/performanceTracking.js" asp-append-version="true"></script>
}
