@{
    ViewData["Title"] = @Html.T("Report.DealerReportCard", "Şube Karnesi");
}

<div id="dealer-report-card-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-shop"></i> @Html.T("Report.DealerReportCard", "Şube Karnesi")</h2>
        <div class="btn-group" data-bind="visible: report()">
            <button class="btn btn-success" data-bind="click: exportToExcel, disable: isExporting">
                <span data-bind="visible: !isExporting()">
                    <i class="bi bi-file-earmark-excel"></i> @Html.T("Common.ExportExcel", "Excel İndir")
                </span>
                <span data-bind="visible: isExporting">
                    <span class="spinner-border spinner-border-sm"></span> @Html.T("Report.Downloading", "İndiriliyor...")
                </span>
            </button>
            <button class="btn btn-danger" data-bind="click: exportToPdf, disable: isExporting">
                <span data-bind="visible: !isExporting()">
                    <i class="bi bi-file-pdf"></i> @Html.T("Report.ExportPdf", "PDF İndir")
                </span>
                <span data-bind="visible: isExporting">
                    <span class="spinner-border spinner-border-sm"></span> @Html.T("Report.Downloading", "İndiriliyor...")
                </span>
            </button>
        </div>
    </div>

    <!-- Dealer Selection -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-shop"></i> @Html.T("Report.DealerSelection", "Şube Seçimi")</h5>
        </div>
        <div class="card-body">
            <!-- Hiyerarşik Seçim -->
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <label class="form-label small mb-1">@Html.T("Report.Customer", "Müşteri")</label>
                    <select class="form-select form-select-sm" data-bind="value: selectedCustomerId, options: customers, optionsValue: 'id', optionsText: 'companyName', optionsCaption: '@Html.T("Common.AllCustomers", "Tüm Müşteriler")', event: { change: onCustomerChange }"></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-1">@Html.T("Report.Dealer", "Şube")</label>
                    <select class="form-select form-select-sm" data-bind="value: selectedDealerId, options: filteredDealerList, optionsValue: 'id', optionsText: 'name', optionsCaption: '@Html.T("Common.Select", "Seçin...")', enable: dealerList().length > 0, event: { change: onDealerChange }"></select>
                </div>
                <div class="col-md-4 d-flex align-items-end gap-1">
                    <button class="btn btn-primary btn-sm" data-bind="click: loadReport, disable: !selectedDealerId()">
                        <i class="bi bi-search"></i> @Html.T("Common.Fetch", "Getir")
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" data-bind="click: clearFilters">
                        <i class="bi bi-x-circle"></i> @Html.T("Common.Clear", "Temizle")
                    </button>
                </div>
            </div>

            <!-- Filtre Sistemi -->
            <div class="border-top pt-3" data-bind="visible: selectedDealerId()">
                <div class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label small mb-1">@Html.T("Report.AddFilter", "Filtre Ekle")</label>
                        <select class="form-select form-select-sm" data-bind="value: selectedFilterType">
                            <option value="">@Html.T("Common.Select", "Seçin...")</option>
                            <option value="project">@Html.T("Common.Project", "Proje")</option>
                            <option value="dateRange">@Html.T("Common.DateRange", "Tarih Aralığı")</option>
                        </select>
                    </div>

                    <div class="col-md-3" data-bind="visible: selectedFilterType() === 'project'">
                        <label class="form-label small mb-1">@Html.T("Common.Project", "Proje")</label>
                        <select class="form-select form-select-sm" data-bind="value: tempFilter.projectId, options: projects, optionsValue: 'id', optionsText: function(item) { return item.code ? item.code + ' - ' + item.name : item.name; }, optionsCaption: '@Html.T("Common.Select", "Seçin...")'"></select>
                    </div>

                    <div class="col-md-6" data-bind="visible: selectedFilterType() === 'dateRange'">
                        <label class="form-label small mb-1">@Html.T("Report.DateRange", "Tarih Aralığı")</label>
                        <div class="d-flex gap-1 align-items-center flex-wrap">
                            <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.startDate" style="width: 130px;">
                            <span class="text-muted">-</span>
                            <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.endDate" style="width: 130px;">
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <span data-bind="text: tempFilter.dateRangeType() ? dateRanges().find(function(d) { return d.systemName === tempFilter.dateRangeType(); })?.name : '@Html.T("DateRange.QuickSelect", "Hızlı Seç")'"></span>
                                </button>
                                <ul class="dropdown-menu">
                                    <li><h6 class="dropdown-header">@Html.T("DateRange.Day", "Gün")</h6></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('today'); }">@Html.T("DateRange.Today", "Bugün")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('yesterday'); }">@Html.T("DateRange.Yesterday", "Dün")</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">@Html.T("DateRange.Week", "Hafta")</h6></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('thisWeek'); }">@Html.T("DateRange.ThisWeek", "Bu Hafta")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('lastWeek'); }">@Html.T("DateRange.LastWeek", "Geçen Hafta")</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">@Html.T("DateRange.Month", "Ay")</h6></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('thisMonth'); }">@Html.T("DateRange.ThisMonth", "Bu Ay")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('lastMonth'); }">@Html.T("DateRange.LastMonth", "Geçen Ay")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('last3Months'); }">@Html.T("DateRange.Last3Months", "Son 3 Ay")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('last6Months'); }">@Html.T("DateRange.Last6Months", "Son 6 Ay")</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">@Html.T("DateRange.Year", "Yıl")</h6></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('thisYear'); }">@Html.T("DateRange.ThisYear", "Bu Yıl")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('lastYear'); }">@Html.T("DateRange.LastYear", "Geçen Yıl")</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="col-auto" data-bind="visible: selectedFilterType()">
                        <button class="btn btn-success btn-sm" data-bind="click: addFilter, enable: canAddFilter">
                            <i class="bi bi-plus-circle"></i> @Html.T("Common.Add", "Ekle")
                        </button>
                    </div>
                </div>

                <!-- Aktif Filtreler -->
                <div class="mt-2" data-bind="visible: activeFilters().length > 0">
                    <div class="d-flex flex-wrap gap-1 align-items-center">
                        <small class="text-muted me-1">@Html.T("Common.Filters", "Filtreler"):</small>
                        <!-- ko foreach: activeFilters -->
                        <span class="badge bg-primary d-flex align-items-center">
                            <span data-bind="text: label + ': ' + displayValue"></span>
                            <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.6rem;" data-bind="click: $parent.removeFilter"></button>
                        </span>
                        <!-- /ko -->
                        <button class="btn btn-outline-danger btn-sm" data-bind="click: clearAllFilters, visible: activeFilters().length > 1">
                            <i class="bi bi-x-circle"></i> @Html.T("Common.ClearAll", "Tümünü Temizle")
                        </button>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-12">
                    <small class="text-muted">
                        <i class="bi bi-info-circle"></i> @Html.T("Report.DealerHierarchyHint", "Müşteri seçince o müşterinin şubeleri filtrelenir.")
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yükleniyor...")</span>
        </div>
        <p class="mt-2 text-muted">@Html.T("Report.LoadingReportCard", "Karne yükleniyor...")</p>
    </div>

    <!-- Report Content -->
    <div id="printable-report" data-bind="visible: report() && !isLoading()">
        <!-- Dealer Info Header -->
        <div class="card shadow-sm mb-4" data-bind="with: report">
            <div class="card-header bg-dark text-white">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <h4 class="mb-0">
                            <i class="bi bi-shop"></i>
                            <span data-bind="text: dealerName"></span>
                        </h4>
                        <small>
                            <span data-bind="text: (dealerCode || '') + (city ? ' | ' + city : '') + (district ? ' / ' + district : '')"></span>
                        </small>
                    </div>
                    <div class="col-md-6 text-end">
                        <span class="badge bg-light text-dark fs-5" data-bind="text: totalEvaluations + ' @Html.T("Report.Evaluation", "Değerlendirme")'"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="row mb-4" data-bind="with: report">
            <div class="col-md-2">
                <div class="card text-center h-100">
                    <div class="card-body py-3">
                        <h2 class="mb-0" data-bind="text: averageScore.toFixed(1) + '%', css: averageScore >= successThreshold ? 'text-success' : (averageScore >= warningThreshold ? 'text-warning' : 'text-danger')"></h2>
                        <small class="text-muted">@Html.T("Report.AverageScore", "Ortalama Puan")</small>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-center h-100 bg-success text-white">
                    <div class="card-body py-3">
                        <h2 class="mb-0" data-bind="text: bestScore.toFixed(1) + '%'"></h2>
                        <small>@Html.T("Report.HighestScore", "En Yüksek")</small>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-center h-100 bg-danger text-white">
                    <div class="card-body py-3">
                        <h2 class="mb-0" data-bind="text: worstScore.toFixed(1) + '%'"></h2>
                        <small>@Html.T("Report.LowestScore", "En Düşük")</small>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-center h-100">
                    <div class="card-body py-3">
                        <h2 class="mb-0 text-primary" data-bind="text: totalEvaluations"></h2>
                        <small class="text-muted">@Html.T("Report.Total", "Toplam")</small>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-center h-100 bg-warning">
                    <div class="card-body py-3">
                        <h2 class="mb-0" data-bind="text: totalYellowCards"></h2>
                        <small>@Html.T("Report.YellowCard", "Sarı Kart")</small>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-center h-100 bg-danger text-white">
                    <div class="card-body py-3">
                        <h2 class="mb-0" data-bind="text: totalRedCards"></h2>
                        <small>@Html.T("Report.RedCard", "Kırmızı Kart")</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Monthly Trend -->
        <div class="row mb-4" data-bind="visible: report() && report().monthlyTrend.length > 0">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h6 class="mb-0"><i class="bi bi-graph-up"></i> @Html.T("Report.MonthlyPerformanceTrend", "Aylık Performans Trendi")</h6>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>@Html.T("Report.Period", "Dönem")</th>
                                        <th class="text-center">@Html.T("Report.Evaluation", "Değerlendirme")</th>
                                        <th class="text-center">@Html.T("Report.AverageScore", "Ort. Puan")</th>
                                        <th class="text-center">@Html.T("Report.YellowCard", "Sarı Kart")</th>
                                        <th class="text-center">@Html.T("Report.RedCard", "Kırmızı Kart")</th>
                                    </tr>
                                </thead>
                                <tbody data-bind="foreach: report() ? report().monthlyTrend : []">
                                    <tr>
                                        <td data-bind="text: monthName"></td>
                                        <td class="text-center" data-bind="text: evaluationCount"></td>
                                        <td class="text-center">
                                            <span class="badge" data-bind="text: averageScore.toFixed(1) + '%', css: averageScore >= $root.report().successThreshold ? 'bg-success' : (averageScore >= $root.report().warningThreshold ? 'bg-warning text-dark' : 'bg-danger')"></span>
                                        </td>
                                        <td class="text-center" data-bind="text: yellowCards"></td>
                                        <td class="text-center" data-bind="text: redCards"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Group Performance & Strengths/Weaknesses -->
        <div class="row mb-4">
            <div class="col-md-6" data-bind="visible: report() && report().groupPerformances && report().groupPerformances.length > 0">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-secondary text-white">
                        <h6 class="mb-0"><i class="bi bi-list-task"></i> @Html.T("Report.GroupPerformance", "Grup Performansı")</h6>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@Html.T("Report.QuestionGroup", "Soru Grubu")</th>
                                    <th class="text-center">@Html.T("Report.SuccessRate", "Başarı %")</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: report() ? report().groupPerformances : []">
                                <tr>
                                    <td data-bind="text: groupName"></td>
                                    <td class="text-center">
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar" role="progressbar"
                                                 data-bind="style: { width: percentageScore + '%' },
                                                            css: percentageScore >= $root.report().successThreshold ? 'bg-success' : (percentageScore >= $root.report().warningThreshold ? 'bg-warning' : 'bg-danger'),
                                                            text: percentageScore.toFixed(1) + '%'">
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-secondary text-white">
                        <h6 class="mb-0"><i class="bi bi-bar-chart"></i> @Html.T("Report.StrengthsWeaknesses", "Güçlü ve Zayıf Yönler")</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="p-2 bg-success bg-opacity-10" data-bind="visible: report() && report().strengths.length > 0">
                            <small class="text-success fw-bold"><i class="bi bi-arrow-up-circle"></i> @Html.T("Report.Strengths", "Güçlü Yönler")</small>
                        </div>
                        <ul class="list-group list-group-flush" data-bind="foreach: report() ? report().strengths : []">
                            <li class="list-group-item py-1 small">
                                <span class="badge bg-success me-1" data-bind="text: percentageScore.toFixed(0) + '%'"></span>
                                <span data-bind="text: questionText"></span>
                            </li>
                        </ul>

                        <div class="p-2 bg-danger bg-opacity-10" data-bind="visible: report() && report().weaknesses.length > 0">
                            <small class="text-danger fw-bold"><i class="bi bi-arrow-down-circle"></i> @Html.T("Report.NeedsImprovement", "Geliştirilmesi Gereken")</small>
                        </div>
                        <ul class="list-group list-group-flush" data-bind="foreach: report() ? report().weaknesses : []">
                            <li class="list-group-item py-1 small">
                                <span class="badge bg-danger me-1" data-bind="text: percentageScore.toFixed(0) + '%'"></span>
                                <span data-bind="text: questionText"></span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Evaluations -->
        <div class="card shadow-sm" data-bind="visible: report() && report().recentEvaluations.length > 0">
            <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="bi bi-clock-history"></i> @Html.T("Report.RecentEvaluations", "Son Değerlendirmeler")</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.T("Report.Date", "Tarih")</th>
                                <th>@Html.T("Report.EvaluatedPerson", "Denetlenen")</th>
                                <th>@Html.T("Report.ControlDate", "Kontrol Tarihi")</th>
                                <th>@Html.T("Common.Project", "Proje")</th>
                                <th>@Html.T("Report.Checklist", "Kontrol Listesi")</th>
                                <th>@Html.T("Report.Evaluator", "Değerlendirici")</th>
                                <th class="text-center">@Html.T("Report.Score", "Puan")</th>
                                <th class="text-center">@Html.T("Report.Cards", "Kartlar")</th>
                                <th class="text-center">@Html.T("Common.Actions", "İşlem")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: report() ? report().recentEvaluations : []">
                            <tr>
                                <td data-bind="text: evaluationDate ? new Date(evaluationDate).toLocaleDateString('tr-TR') : '-'"></td>
                                <td data-bind="text: personnelName || '-'"></td>
                                <td data-bind="text: (controlDate || '-') + (controlTime ? ' ' + controlTime : '')"></td>
                                <td data-bind="text: projectName"></td>
                                <td data-bind="text: checklistName"></td>
                                <td data-bind="text: evaluatorName || '-'"></td>
                                <td class="text-center">
                                    <span class="badge" data-bind="text: scorePercentage.toFixed(2) + '%', css: scorePercentage >= $root.report().successThreshold ? 'bg-success' : (scorePercentage >= $root.report().warningThreshold ? 'bg-warning text-dark' : 'bg-danger')"></span>
                                </td>
                                <td class="text-center">
                                    <span data-bind="visible: yellowCards > 0" class="badge bg-warning text-dark me-1" data-bind="text: yellowCards"></span>
                                    <span data-bind="visible: redCards > 0" class="badge bg-danger" data-bind="text: redCards"></span>
                                    <span data-bind="visible: yellowCards === 0 && redCards === 0">-</span>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary" data-bind="click: $parent.viewDetail" title="@Html.T("Common.Detail", "Detay")">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Empty State -->
    <div data-bind="visible: !report() && !isLoading() && selectedDealerId()" class="text-center text-muted py-5">
        <i class="bi bi-inbox fs-1"></i>
        <p class="mt-2">@Html.T("Report.NoEvaluationsForDealer", "Bu şube için değerlendirme bulunamadı.")</p>
    </div>

    <!-- Initial State -->
    <div data-bind="visible: !report() && !isLoading() && !selectedDealerId()" class="text-center text-muted py-5">
        <i class="bi bi-shop fs-1"></i>
        <p class="mt-2">@Html.T("Report.SelectDealerToViewReport", "Karne görmek için bir şube seçin.")</p>
    </div>

    <!-- Detail Modal -->
    <div class="modal fade" id="detailModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-file-earmark-text"></i> @Html.T("Report.EvaluationDetail", "Değerlendirme Detayı")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" data-bind="with: selectedDetail">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="border-bottom pb-2">@Html.T("Report.GeneralInfo", "Genel Bilgiler")</h6>
                            <dl class="row mb-0">
                                <dt class="col-sm-4">@Html.T("Common.Project", "Proje"):</dt>
                                <dd class="col-sm-8" data-bind="text: projectName"></dd>
                                <dt class="col-sm-4">@Html.T("Report.Checklist", "Kontrol Listesi"):</dt>
                                <dd class="col-sm-8" data-bind="text: checklistName"></dd>
                                <dt class="col-sm-4">@Html.T("Report.Evaluator", "Değerlendirici"):</dt>
                                <dd class="col-sm-8" data-bind="text: $data.evaluatorName || '-'"></dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <h6 class="border-bottom pb-2">@Html.T("Report.Scoring", "Puanlama")</h6>
                            <div class="row text-center">
                                <div class="col">
                                    <h2 class="mb-0 text-primary" data-bind="text: (scorePercentage || 0).toFixed(2) + '%'"></h2>
                                    <small class="text-muted">@Html.T("Report.Score", "Puan")</small>
                                </div>
                                <div class="col">
                                    <h2 class="mb-0 text-warning" data-bind="text: yellowCardCount"></h2>
                                    <small class="text-muted">@Html.T("Report.YellowCard", "Sarı Kart")</small>
                                </div>
                                <div class="col">
                                    <h2 class="mb-0 text-danger" data-bind="text: redCardCount"></h2>
                                    <small class="text-muted">@Html.T("Report.RedCard", "Kırmızı Kart")</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header bg-light">
                            <h6 class="mb-0"><i class="bi bi-list-check"></i> @Html.T("Evaluation.Answers", "Verilen Cevaplar")</h6>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm table-striped table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 15%;">@Html.T("Evaluation.Group", "Grup")</th>
                                            <th style="width: 35%;">@Html.T("Report.Question", "Soru")</th>
                                            <th class="text-center" style="width: 15%;">@Html.T("Report.Score", "Puan")</th>
                                            <th style="width: 35%;">@Html.T("Common.Note", "Not")</th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: $data.answers || []">
                                        <tr data-bind="css: { 'table-warning': appliedPenaltyType === 'YellowCard', 'table-danger': appliedPenaltyType === 'RedCard' }">
                                            <td class="text-wrap" data-bind="text: groupName || '-'"></td>
                                            <td class="text-wrap" data-bind="text: questionText"></td>
                                            <td class="text-center">
                                                <!-- ko if: givenPoints !== null && givenPoints !== undefined -->
                                                <span class="badge bg-primary" data-bind="text: givenPoints + '/' + maxPoints"></span>
                                                <!-- /ko -->
                                                <!-- ko if: givenPoints === null || givenPoints === undefined -->
                                                <span class="text-muted">-</span>
                                                <!-- /ko -->
                                            </td>
                                            <td>
                                                <span data-bind="visible: appliedPenaltyType === 'YellowCard'" class="badge bg-warning text-dark me-1">@Html.T("Report.YellowCard", "Sarı Kart")</span>
                                                <span data-bind="visible: appliedPenaltyType === 'RedCard'" class="badge bg-danger me-1">@Html.T("Report.RedCard", "Kırmızı Kart")</span>
                                                <small data-bind="text: notes" class="text-muted"></small>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Descriptions -->
                    <div data-bind="visible: $data.descriptions && $data.descriptions.length > 0" class="card mt-3">
                        <div class="card-header bg-secondary text-white">
                            <h6 class="mb-0"><i class="bi bi-list-ul"></i> @Html.T("Evaluation.Descriptions", "Aciklamalar")</h6>
                        </div>
                        <div class="card-body">
                            <ul class="mb-0" data-bind="foreach: $data.descriptions">
                                <li data-bind="text: $data"></li>
                            </ul>
                        </div>
                    </div>

                    <!-- Evaluation Comment -->
                    <div data-bind="visible: $data.evaluationComment" class="card mt-3">
                        <div class="card-header bg-info text-white">
                            <h6 class="mb-0"><i class="bi bi-chat-quote"></i> @Html.T("Evaluation.EvaluationComment", "Denetim Yorumu")</h6>
                        </div>
                        <div class="card-body">
                            <p class="mb-0" data-bind="text: $data.evaluationComment"></p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Close", "Kapat")</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Reports/DealerReportCard.js"></script>
}
