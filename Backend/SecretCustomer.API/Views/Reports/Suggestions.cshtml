@{
    ViewData["Title"] = @Html.T("Report.SuggestionsReport", "Oneriler Raporu");
}

<div id="suggestions-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-chat-quote text-info"></i> @Html.T("Report.SuggestionsReport", "Oneriler Raporu")</h2>
        <div class="btn-group">
            <button class="btn btn-success" data-bind="click: exportToExcel, disable: isExporting">
                <span data-bind="visible: !isExporting()">
                    <i class="bi bi-file-earmark-excel"></i> @Html.T("Report.ExportExcel", "Excel Indir")
                </span>
                <span data-bind="visible: isExporting">
                    <span class="spinner-border spinner-border-sm"></span> @Html.T("Report.Downloading", "Indiriliyor...")
                </span>
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body py-2">
            <!-- Filter Selector & Active Filters -->
            <div class="d-flex flex-wrap align-items-center gap-2">
                <!-- Add Filter Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-outline-info btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                        <i class="bi bi-plus-circle me-1"></i>@Html.T("Common.AddFilter", "Filtre Ekle")
                    </button>
                    <div class="dropdown-menu p-3 filter-dropdown">
                        <!-- Filter Type Selector -->
                        <div class="mb-2">
                            <select class="form-select form-select-sm" data-bind="value: selectedFilterType">
                                <option value="">@Html.T("Common.SelectFilter", "Filtre Secin...")</option>
                                <option value="project">@Html.T("Report.Project", "Proje")</option>
                                <option value="branch">@Html.T("Report.Branch", "Sube/Organizasyon")</option>
                                <option value="checklist">@Html.T("Report.Checklist", "Kontrol Listesi")</option>
                                <option value="search">@Html.T("Report.TextSearch", "Metin Arama")</option>
                                <option value="dateRange">@Html.T("Common.DateRange", "Tarih Araligi")</option>
                            </select>
                        </div>
                        <!-- Dynamic Filter Input -->
                        <!-- Project -->
                        <div data-bind="visible: selectedFilterType() === 'project'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="options: projects, optionsText: 'name', optionsValue: 'id', value: tempFilter.projectId, optionsCaption: '@Html.T("Common.Select", "Secin...")'"></select>
                        </div>
                        <!-- Branch/Organization -->
                        <div data-bind="visible: selectedFilterType() === 'branch'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="options: branches, optionsText: 'name', optionsValue: 'id', value: tempFilter.branchId, optionsCaption: '@Html.T("Common.Select", "Secin...")'"></select>
                        </div>
                        <!-- Checklist -->
                        <div data-bind="visible: selectedFilterType() === 'checklist'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="options: checklists, optionsText: 'name', optionsValue: 'id', value: tempFilter.checklistId, optionsCaption: '@Html.T("Common.Select", "Secin...")'"></select>
                        </div>
                        <!-- Search Text -->
                        <div data-bind="visible: selectedFilterType() === 'search'" class="mb-2">
                            <input type="text" class="form-control form-control-sm" placeholder="@Html.T("Report.SearchInSuggestion", "Oneri metninde ara...")" data-bind="value: tempFilter.searchText">
                        </div>
                        <!-- Date Range -->
                        <div data-bind="visible: selectedFilterType() === 'dateRange'" class="mb-2">
                            <div class="d-flex gap-1 mb-1">
                                <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.startDate">
                                <span class="align-self-center">-</span>
                                <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.endDate">
                            </div>
                            <div class="d-flex flex-wrap gap-1">
                                <!-- ko foreach: dateRanges -->
                                <button type="button" class="btn btn-sm"
                                    data-bind="click: function() { $parent.setTempDateRange(systemName); },
                                               text: name,
                                               css: $parent.tempFilter.selectedDateRangeType() === systemName ? 'btn-info' : 'btn-outline-secondary'"></button>
                                <!-- /ko -->
                            </div>
                        </div>
                        <!-- Add Button -->
                        <button type="button" class="btn btn-info btn-sm w-100" data-bind="click: addFilter, enable: canAddFilter">
                            <i class="bi bi-plus"></i> @Html.T("Common.Add", "Ekle")
                        </button>
                    </div>
                </div>

                <!-- Active Filters (Chips) -->
                <!-- ko foreach: activeFilters -->
                <span class="badge bg-info d-flex align-items-center gap-1 py-2 px-2">
                    <span data-bind="text: label"></span>: <strong data-bind="text: displayValue"></strong>
                    <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.6rem;" data-bind="click: $parent.removeFilter"></button>
                </span>
                <!-- /ko -->

                <!-- Clear All -->
                <button class="btn btn-outline-secondary btn-sm" data-bind="visible: activeFilters().length > 0, click: clearFilters">
                    <i class="bi bi-x-circle"></i> @Html.T("Common.ClearAll", "Temizle")
                </button>

                <!-- Spacer -->
                <div class="flex-grow-1"></div>

                <!-- Search Button -->
                <button class="btn btn-info btn-sm" data-bind="click: search">
                    <i class="bi bi-search me-1"></i>@Html.T("Common.Search", "Ara")
                </button>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-info text-white h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-1">@Html.T("Report.TotalSuggestions", "Toplam Oneri/Not")</h6>
                            <h2 class="mb-0" data-bind="text: summary().totalSuggestions"></h2>
                        </div>
                        <i class="bi bi-chat-quote fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-primary text-white h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-1">@Html.T("Report.EvaluationsWithSuggestions", "Onerili Degerlendirme")</h6>
                            <h2 class="mb-0" data-bind="text: summary().totalEvaluationsWithSuggestions"></h2>
                        </div>
                        <i class="bi bi-clipboard-check fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-1">@Html.T("Report.EvaluatorCount", "Degerlendirici Sayisi")</h6>
                            <h2 class="mb-0" data-bind="text: summary().uniqueEvaluators"></h2>
                        </div>
                        <i class="bi bi-person-check fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-secondary text-white h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-1">@Html.T("Report.PersonnelCount", "Personel Sayisi")</h6>
                            <h2 class="mb-0" data-bind="text: summary().uniquePersonnel"></h2>
                        </div>
                        <i class="bi bi-people fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Veriler yukleniyor...")</p>
    </div>

    <div data-bind="visible: !isLoading()" class="row">
        <!-- Top Suggested Questions -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-question-circle"></i> @Html.T("Report.TopSuggestedQuestions", "En Cok Oneri Yazilan Sorular")</h5>
                </div>
                <div class="card-body p-0">
                    <div data-bind="visible: topSuggestedQuestions().length === 0" class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">@Html.T("Report.NoDataYet", "Henuz veri bulunmamaktadir.")</p>
                    </div>
                    <ul class="list-group list-group-flush" data-bind="foreach: topSuggestedQuestions">
                        <li class="list-group-item d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <div class="fw-bold" data-bind="text: questionText"></div>
                                <small class="text-muted" data-bind="text: checklistName + ' - ' + groupName"></small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-info me-1" data-bind="text: suggestionCount + ' @Html.T("Report.Suggestion", "oneri")'"></span>
                                <span class="badge bg-secondary" data-bind="text: averageScore.toFixed(1) + '%'"></span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Pagination Info -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> @Html.T("Report.ReportInfo", "Rapor Bilgileri")</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-6 mb-3">
                            <small class="text-muted d-block">@Html.T("Report.Page", "Sayfa")</small>
                            <strong data-bind="text: currentPage() + ' / ' + totalPages()"></strong>
                        </div>
                        <div class="col-6 mb-3">
                            <small class="text-muted d-block">@Html.T("Report.TotalRecords", "Toplam Kayit")</small>
                            <strong data-bind="text: totalCount()"></strong>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">
                        <i class="bi bi-lightbulb"></i>
                        @Html.T("Report.SuggestionsDescription", "Bu rapor, tum degerlendirmelerde degerlendiricilerin girdigi notlari ve onerileri listeler.")
                    </p>
                </div>
            </div>
        </div>

        <!-- Detailed Suggestions List -->
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-list-ul"></i> @Html.T("Report.SuggestionList", "Oneri Listesi")</h5>
                    <span class="badge bg-info" data-bind="text: totalCount() + ' @Html.T("Report.Records", "kayit")'"></span>
                </div>
                <div class="card-body p-0">
                    <div data-bind="visible: suggestions().length === 0" class="text-center text-muted py-5">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">@Html.T("Report.NoSuggestions", "Oneri bulunamadi.")</p>
                    </div>
                    <div data-bind="visible: suggestions().length > 0" class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@Html.T("Report.Date", "Tarih")</th>
                                    <th>@Html.T("Report.ProjectBranch", "Proje / Sube")</th>
                                    <th>@Html.T("Report.Question", "Soru")</th>
                                    <th>@Html.T("Report.NoteSuggestion", "Not / Oneri")</th>
                                    <th>@Html.T("Report.Score", "Puan")</th>
                                    <th>@Html.T("Report.Evaluator", "Degerlendirici")</th>
                                    <th>@Html.T("Report.Personnel", "Personel")</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: suggestions">
                                <tr data-bind="css: { 'table-warning': isPenaltyApplied }">
                                    <td>
                                        <span data-bind="text: evaluationDate ? new Date(evaluationDate).toLocaleDateString('tr-TR') : '-'"></span>
                                    </td>
                                    <td>
                                        <span data-bind="text: projectName"></span>
                                        <small class="text-muted d-block" data-bind="text: checklistName"></small>
                                    </td>
                                    <td style="max-width: 200px;">
                                        <div class="text-truncate" data-bind="text: questionText, attr: { title: questionText }"></div>
                                        <small class="text-muted" data-bind="text: groupName"></small>
                                    </td>
                                    <td style="max-width: 300px;">
                                        <!-- ko if: notes -->
                                        <div class="mb-1">
                                            <span class="badge bg-secondary me-1">@Html.T("Report.Note", "Not")</span>
                                            <span class="text-truncate" data-bind="text: notes, attr: { title: notes }"></span>
                                        </div>
                                        <!-- /ko -->
                                        <!-- ko if: recommendationNotes -->
                                        <div>
                                            <span class="badge bg-info me-1">@Html.T("Report.Suggestion", "Oneri")</span>
                                            <span class="text-truncate" data-bind="text: recommendationNotes, attr: { title: recommendationNotes }"></span>
                                        </div>
                                        <!-- /ko -->
                                    </td>
                                    <td>
                                        <span data-bind="text: givenPoints != null ? givenPoints.toFixed(1) : '-'"></span>
                                        <span class="text-muted" data-bind="text: ' / ' + (maxPoints || 0)"></span>
                                        <!-- ko if: percentageScore != null -->
                                        <small class="d-block" data-bind="text: '(' + percentageScore.toFixed(1) + '%)', css: { 'text-success': percentageScore >= 70, 'text-warning': percentageScore >= 40 && percentageScore < 70, 'text-danger': percentageScore < 40 }"></small>
                                        <!-- /ko -->
                                    </td>
                                    <td data-bind="text: evaluatorName || '-'"></td>
                                    <td data-bind="text: evaluatedPersonnelName || dealerName || '-'"></td>
                                    <td>
                                        <a class="btn btn-sm btn-outline-primary" data-bind="attr: { href: '/Evaluations?evaluationId=' + evaluationId }" title="@Html.T("Report.GoToEvaluation", "Degerlendirmeye Git")">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div data-bind="visible: totalPages() > 1" class="py-3 border-top">
                        <nav>
                            <ul class="pagination mb-0">
                                <li class="page-item" data-bind="css: { disabled: currentPage() <= 1 }">
                                    <a class="page-link" href="javascript:void(0)" data-bind="click: previousPage">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                                <!-- ko foreach: visiblePages -->
                                <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }">
                                    <a class="page-link" href="javascript:void(0)" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                                </li>
                                <!-- /ko -->
                                <li class="page-item" data-bind="css: { disabled: currentPage() >= totalPages() }">
                                    <a class="page-link" href="javascript:void(0)" data-bind="click: nextPage">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>

        <!-- Evaluation General Notes List -->
        <div class="col-12 mt-4">
            <div class="card shadow">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-chat-left-text"></i> Değerlendirme Genel Notları</h5>
                    <span class="badge bg-secondary" data-bind="text: evaluationNotesCount() + ' kayıt'"></span>
                </div>
                <div class="card-body p-0">
                    <div data-bind="visible: evaluationNotes().length === 0" class="text-center text-muted py-5">
                        <i class="bi bi-chat-left fs-1"></i>
                        <p class="mt-2">Genel not bulunamadı.</p>
                    </div>
                    <div data-bind="visible: evaluationNotes().length > 0" class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Tarih</th>
                                    <th>Proje</th>
                                    <th>Personel</th>
                                    <th>Puan</th>
                                    <th>Genel Not</th>
                                    <th>Denetim Yorumu</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: evaluationNotes">
                                <tr>
                                    <td>
                                        <span data-bind="text: evaluationDate ? new Date(evaluationDate).toLocaleDateString('tr-TR') : '-'"></span>
                                        <!-- ko if: callId -->
                                        <div class="d-flex align-items-center gap-1">
                                            <code class="text-muted small" data-bind="text: $root.truncateCallId(callId), attr: { title: callId }" style="cursor: help;"></code>
                                            <button type="button" class="btn btn-link btn-sm p-0 text-secondary" data-bind="click: function() { $root.copyToClipboard(callId); }" title="Kopyala">
                                                <i class="bi bi-clipboard" style="font-size: 0.75rem;"></i>
                                            </button>
                                        </div>
                                        <!-- /ko -->
                                    </td>
                                    <td data-bind="text: projectName || '-'"></td>
                                    <td data-bind="text: evaluatedPersonnelName || dealerName || '-'"></td>
                                    <td>
                                        <!-- ko if: scorePercentage != null -->
                                        <span data-bind="text: scorePercentage.toFixed(1) + '%', css: { 'text-success': scorePercentage >= 70, 'text-warning': scorePercentage >= 40 && scorePercentage < 70, 'text-danger': scorePercentage < 40 }"></span>
                                        <!-- /ko -->
                                        <!-- ko if: scorePercentage == null -->
                                        <span class="text-muted">-</span>
                                        <!-- /ko -->
                                    </td>
                                    <td style="max-width: 250px;">
                                        <!-- ko if: notes -->
                                        <div class="small" style="white-space: pre-wrap; word-break: break-word;" data-bind="text: notes.length > 100 ? notes.substring(0, 100) + '...' : notes, attr: { title: notes }"></div>
                                        <!-- /ko -->
                                        <!-- ko ifnot: notes -->
                                        <span class="text-muted">-</span>
                                        <!-- /ko -->
                                    </td>
                                    <td style="max-width: 250px;">
                                        <!-- ko if: evaluationComment -->
                                        <div class="small" style="white-space: pre-wrap; word-break: break-word;" data-bind="text: evaluationComment.length > 100 ? evaluationComment.substring(0, 100) + '...' : evaluationComment, attr: { title: evaluationComment }"></div>
                                        <!-- /ko -->
                                        <!-- ko ifnot: evaluationComment -->
                                        <span class="text-muted">-</span>
                                        <!-- /ko -->
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Reports/Suggestions.js"></script>
}
