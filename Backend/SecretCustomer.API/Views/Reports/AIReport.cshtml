@{
    ViewData["Title"] = "AI Rapor";
}

<div id="ai-report-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-robot"></i> AI Destekli Rapor</h2>
    </div>

    <div class="row">
        <!-- Sol Panel: Filtreler -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-sliders"></i> Rapor Ayarları
                </div>
                <div class="card-body">
                    <!-- Müşteri Seçimi -->
                    <div class="mb-3">
                        <label class="form-label">Müşteri <span class="text-danger">*</span></label>
                        <select class="form-select" data-bind="options: customers, optionsText: 'companyName', optionsValue: 'id', value: selectedCustomerId, optionsCaption: 'Müşteri seçin...'" id="customerSelect"></select>
                    </div>

                    <!-- Yıl Seçimi -->
                    <div class="mb-3">
                        <label class="form-label">Rapor Yılı <span class="text-danger">*</span></label>
                        <select class="form-select" data-bind="options: years, value: selectedYear"></select>
                    </div>

                    <!-- Karşılaştırma Yılı -->
                    <div class="mb-3">
                        <label class="form-label">Karşılaştırma Yılı (Opsiyonel)</label>
                        <select class="form-select" data-bind="options: compareYears, value: compareYear, optionsCaption: 'Seçilmedi'"></select>
                    </div>

                    <hr>

                    <!-- Hedef Puanlar -->
                    <h6 class="mb-3"><i class="bi bi-bullseye"></i> Hedef Puanlar</h6>

                    <div class="mb-3">
                        <label class="form-label">Önceki Yıl Hedefi</label>
                        <div class="input-group">
                            <span class="input-group-text">%</span>
                            <input type="number" class="form-control" data-bind="value: previousYearTarget" min="0" max="100">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mevcut Yıl Hedefi</label>
                        <div class="input-group">
                            <span class="input-group-text">%</span>
                            <input type="number" class="form-control" data-bind="value: currentYearTarget" min="0" max="100">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Üst Hedef</label>
                        <div class="input-group">
                            <span class="input-group-text">%</span>
                            <input type="number" class="form-control" data-bind="value: stretchTarget" min="0" max="100">
                        </div>
                    </div>

                    <hr>

                    <!-- Butonlar -->
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary btn-lg" data-bind="click: generateReport, disable: isGenerating() || !canGenerate()">
                            <span data-bind="visible: !isGenerating()">
                                <i class="bi bi-magic"></i> Rapor Oluştur
                            </span>
                            <span data-bind="visible: isGenerating">
                                <span class="spinner-border spinner-border-sm"></span> Oluşturuluyor...
                            </span>
                        </button>
                        <button class="btn btn-outline-secondary" data-bind="click: previewData, disable: isGenerating() || !canGenerate()">
                            <i class="bi bi-code-slash"></i> Veri Önizleme (JSON)
                        </button>
                    </div>
                </div>
            </div>

            <!-- Bilgi Kartı -->
            <div class="card mt-3">
                <div class="card-body">
                    <small class="text-muted">
                        <i class="bi bi-info-circle"></i> Bu özellik Google Gemini AI kullanarak otomatik rapor oluşturur.
                        Rapor oluşturma işlemi 10-30 saniye sürebilir.
                    </small>
                </div>
            </div>

            <!-- İstatistikler -->
            <div class="card mt-3" data-bind="visible: lastReport()">
                <div class="card-body">
                    <small class="text-muted">
                        <div><i class="bi bi-clock"></i> Süre: <span data-bind="text: processingTime"></span></div>
                        <div><i class="bi bi-hash"></i> Token: <span data-bind="text: tokensUsed"></span></div>
                    </small>
                </div>
            </div>
        </div>

        <!-- Sağ Panel: Rapor Çıktısı -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-file-text"></i> Rapor Çıktısı</span>
                    <div data-bind="visible: lastReport()">
                        <button class="btn btn-sm btn-outline-primary" data-bind="click: copyToClipboard">
                            <i class="bi bi-clipboard"></i> Kopyala
                        </button>
                        <button class="btn btn-sm btn-outline-success" data-bind="click: downloadAsMarkdown">
                            <i class="bi bi-download"></i> İndir (.md)
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Yükleniyor -->
                    <div data-bind="visible: isGenerating" class="text-center py-5">
                        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Yükleniyor...</span>
                        </div>
                        <p class="mt-3 text-muted">AI rapor oluşturuyor, lütfen bekleyin...</p>
                    </div>

                    <!-- Hata Mesajı -->
                    <div data-bind="visible: errorMessage" class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle"></i> <span data-bind="text: errorMessage"></span>
                    </div>

                    <!-- Boş Durum -->
                    <div data-bind="visible: !isGenerating() && !lastReport() && !errorMessage()" class="text-center py-5 text-muted">
                        <i class="bi bi-file-earmark-text" style="font-size: 4rem;"></i>
                        <p class="mt-3">Sol panelden ayarları yapın ve "Rapor Oluştur" butonuna tıklayın.</p>
                    </div>

                    <!-- Rapor İçeriği (Markdown) -->
                    <div data-bind="visible: lastReport() && !isGenerating()" class="report-content">
                        <div data-bind="html: renderedReport"></div>
                    </div>

                    <!-- JSON Önizleme -->
                    <div data-bind="visible: showJsonPreview() && !isGenerating()">
                        <pre class="bg-light p-3 rounded" style="max-height: 600px; overflow-y: auto;"><code data-bind="text: jsonPreview"></code></pre>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .report-content {
        font-size: 0.95rem;
        line-height: 1.6;
    }
    .report-content h1 { font-size: 1.75rem; margin-top: 1.5rem; margin-bottom: 1rem; border-bottom: 2px solid #dee2e6; padding-bottom: 0.5rem; }
    .report-content h2 { font-size: 1.5rem; margin-top: 1.25rem; margin-bottom: 0.75rem; color: #495057; }
    .report-content h3 { font-size: 1.25rem; margin-top: 1rem; margin-bottom: 0.5rem; color: #6c757d; }
    .report-content table { width: 100%; margin: 1rem 0; border-collapse: collapse; }
    .report-content th, .report-content td { padding: 0.5rem; border: 1px solid #dee2e6; text-align: left; }
    .report-content th { background-color: #f8f9fa; font-weight: 600; }
    .report-content ul, .report-content ol { margin: 0.5rem 0; padding-left: 1.5rem; }
    .report-content li { margin-bottom: 0.25rem; }
    .report-content strong { color: #212529; }
    .report-content code { background-color: #f8f9fa; padding: 0.2rem 0.4rem; border-radius: 0.25rem; }
    .report-content blockquote { border-left: 4px solid #0d6efd; padding-left: 1rem; margin: 1rem 0; color: #6c757d; }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="~/js/Reports/AIReport.js"></script>
}
