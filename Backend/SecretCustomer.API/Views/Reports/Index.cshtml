@{
    ViewData["Title"] = @Html.T("Common.Reports", "Raporlar");
}

<div id="reports-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-file-earmark-bar-graph"></i> @Html.T("Common.Reports", "Raporlar")</h2>
        <div class="btn-group">
            <button class="btn btn-success" data-bind="click: exportToExcel, disable: isExporting">
                <span data-bind="visible: !isExporting()">
                    <i class="bi bi-file-earmark-excel"></i> @Html.T("Common.ExportExcel", "Excel Indir")
                </span>
                <span data-bind="visible: isExporting">
                    <span class="spinner-border spinner-border-sm"></span> @Html.T("Report.Downloading", "Indiriliyor...")
                </span>
            </button>
            <button class="btn btn-outline-success" data-bind="click: exportDetailedToExcel, disable: isExporting">
                <i class="bi bi-file-earmark-spreadsheet"></i> @Html.T("Report.DetailedExcel", "Detayli Excel")
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body py-2">
            <!-- Filter Selector & Active Filters -->
            <div class="d-flex flex-wrap align-items-center gap-2">
                <!-- Add Filter Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-outline-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                        <i class="bi bi-plus-circle me-1"></i>@Html.T("Common.AddFilter", "Filtre Ekle")
                    </button>
                    <div class="dropdown-menu p-3 filter-dropdown">
                        <!-- Filter Type Selector -->
                        <div class="mb-2">
                            <select class="form-select form-select-sm" data-bind="value: selectedFilterType">
                                <option value="">@Html.T("Common.SelectFilter", "Filtre Secin...")</option>
                                <option value="project">@Html.T("Common.Project", "Proje")</option>
                                <option value="branch">@Html.T("Report.Branch", "Sube/Organizasyon")</option>
                                <option value="evaluator">@Html.T("Report.Evaluator", "Degerlendirici")</option>
                                <option value="checklist">@Html.T("Report.Checklist", "Kontrol Listesi")</option>
                                <option value="status">@Html.T("Common.Status", "Durum")</option>
                                <option value="dateRange">@Html.T("Common.DateRange", "Tarih Araligi")</option>
                            </select>
                        </div>
                        <!-- Dynamic Filter Input -->
                        <!-- Project -->
                        <div data-bind="visible: selectedFilterType() === 'project'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="options: projects, optionsText: function(item) { return item.code ? item.code + ' - ' + item.name : item.name; }, optionsValue: 'id', value: tempFilter.projectId, optionsCaption: '@Html.T("Common.Select", "Secin...")'"></select>
                        </div>
                        <!-- Branch/Organization -->
                        <div data-bind="visible: selectedFilterType() === 'branch'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="options: branches, optionsText: 'name', optionsValue: 'id', value: tempFilter.branchId, optionsCaption: '@Html.T("Common.Select", "Secin...")'"></select>
                        </div>
                        <!-- Evaluator -->
                        <div data-bind="visible: selectedFilterType() === 'evaluator'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="options: evaluators, optionsText: 'fullName', optionsValue: 'id', value: tempFilter.evaluatorId, optionsCaption: '@Html.T("Common.Select", "Secin...")'"></select>
                        </div>
                        <!-- Checklist -->
                        <div data-bind="visible: selectedFilterType() === 'checklist'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="options: checklists, optionsText: 'name', optionsValue: 'id', value: tempFilter.checklistId, optionsCaption: '@Html.T("Common.Select", "Secin...")'"></select>
                        </div>
                        <!-- Status -->
                        <div data-bind="visible: selectedFilterType() === 'status'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="value: tempFilter.status">
                                <option value="">@Html.T("Common.Select", "Secin...")</option>
                                <option value="Completed">@Html.T("Status.Completed", "Tamamlandi")</option>
                                <option value="Draft">@Html.T("Common.Status.Draft", "Taslak")</option>
                                <option value="InProgress">@Html.T("Common.Status.InProgress", "Devam Eden")</option>
                            </select>
                        </div>
                        <!-- Date Range -->
                        <div data-bind="visible: selectedFilterType() === 'dateRange'" class="mb-2">
                            <div class="d-flex gap-1 mb-1">
                                <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.startDate">
                                <span class="align-self-center">-</span>
                                <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.endDate">
                            </div>
                            <div class="d-flex flex-wrap gap-1">
                                <!-- ko foreach: dateRanges -->
                                <button type="button" class="btn btn-sm"
                                    data-bind="click: function() { $parent.setTempDateRange(systemName); },
                                               text: name,
                                               css: $parent.tempFilter.selectedDateRangeType() === systemName ? 'btn-primary' : 'btn-outline-secondary'"></button>
                                <!-- /ko -->
                            </div>
                        </div>
                        <!-- Add Button -->
                        <button type="button" class="btn btn-primary btn-sm w-100" data-bind="click: addFilter, enable: canAddFilter">
                            <i class="bi bi-plus"></i> @Html.T("Common.Add", "Ekle")
                        </button>
                    </div>
                </div>

                <!-- Active Filters (Chips) -->
                <!-- ko foreach: activeFilters -->
                <span class="badge bg-primary d-flex align-items-center gap-1 py-2 px-2">
                    <span data-bind="text: label"></span>: <strong data-bind="text: displayValue"></strong>
                    <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.6rem;" data-bind="click: $parent.removeFilter"></button>
                </span>
                <!-- /ko -->

                <!-- Clear All -->
                <button class="btn btn-outline-danger btn-sm" data-bind="visible: activeFilters().length > 0, click: clearFilters">
                    <i class="bi bi-x-circle"></i> @Html.T("Common.ClearAll", "Temizle")
                </button>

                <!-- Spacer -->
                <div class="flex-grow-1"></div>

                <!-- Search Button -->
                <button class="btn btn-primary btn-sm" data-bind="click: search">
                    <i class="bi bi-search me-1"></i>@Html.T("Common.Search", "Ara")
                </button>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4" data-bind="with: summary">
        <div class="col-md-2">
            <div class="card bg-primary text-white h-100">
                <div class="card-body py-2">
                    <h6 class="text-white-50 mb-0">@Html.T("Report.Total", "Toplam")</h6>
                    <h3 class="mb-0" data-bind="text: totalEvaluations"></h3>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-success text-white h-100">
                <div class="card-body py-2">
                    <h6 class="text-white-50 mb-0">@Html.T("Report.Completed", "Tamamlanan")</h6>
                    <h3 class="mb-0" data-bind="text: completedEvaluations"></h3>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-warning text-dark h-100">
                <div class="card-body py-2">
                    <h6 class="text-dark-50 mb-0">@Html.T("Common.Status.Pending", "Bekleyen")</h6>
                    <h3 class="mb-0" data-bind="text: pendingEvaluations"></h3>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-info text-white h-100">
                <div class="card-body py-2">
                    <h6 class="text-white-50 mb-0">@Html.T("Report.AverageScore", "Ort. Puan")</h6>
                    <h3 class="mb-0" data-bind="text: averageScore.toFixed(1) + '%'"></h3>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-secondary text-white h-100">
                <div class="card-body py-2">
                    <h6 class="text-white-50 mb-0">@Html.T("Report.YellowCard", "Sari Kart")</h6>
                    <h3 class="mb-0" data-bind="text: totalYellowCards"></h3>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-danger text-white h-100">
                <div class="card-body py-2">
                    <h6 class="text-white-50 mb-0">@Html.T("Report.RedCard", "Kirmizi Kart")</h6>
                    <h3 class="mb-0" data-bind="text: totalRedCards"></h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Veriler yukleniyor...")</p>
    </div>

    <!-- Results Table -->
    <div data-bind="visible: !isLoading()" class="card shadow">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span>
                <strong data-bind="text: paginationInfo().totalCount"></strong> @Html.T("Report.ResultsFound", "sonuc bulundu")
                <span class="text-muted" data-bind="visible: paginationInfo().totalPages > 1">
                    (@Html.T("Report.Page", "Sayfa") <span data-bind="text: page"></span> / <span data-bind="text: paginationInfo().totalPages"></span>)
                </span>
            </span>
            <div class="btn-group btn-group-sm">
                <button class="btn btn-outline-secondary" data-bind="click: previousPage, disable: !paginationInfo().hasPreviousPage">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <button class="btn btn-outline-secondary" data-bind="click: nextPage, disable: !paginationInfo().hasNextPage">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <!-- Empty State -->
            <div data-bind="visible: evaluations().length === 0" class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mt-2">@Html.T("Report.NoResults", "Sonuc bulunamadi.")</p>
            </div>

            <!-- Table -->
            <div data-bind="visible: evaluations().length > 0" class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>@Html.T("Common.Project", "Proje")</th>
                            <th>@Html.T("Report.Branch", "Sube")</th>
                            <th>@Html.T("Report.Evaluator", "Degerlendirici")</th>
                            <th>@Html.T("Report.Date", "Tarih")</th>
                            <th>@Html.T("Report.Score", "Puan")</th>
                            <th>@Html.T("Report.Cards", "Kartlar")</th>
                            <th>@Html.T("Common.Status", "Durum")</th>
                            <th class="text-center">@Html.T("Common.Actions", "Islemler")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: evaluations">
                        <tr>
                            <td>
                                <span data-bind="text: projectName"></span>
                                <small class="text-muted d-block" data-bind="text: checklistName"></small>
                            </td>
                            <td>
                                <span data-bind="text: $data.assigneeName || '-'"></span>
                            </td>
                            <td>
                                <span data-bind="text: $data.evaluatorName || '-'"></span>
                                <small class="text-muted d-block" data-bind="visible: $data.evaluatedPersonnelName || $data.dealerName, text: '@Html.T("Report.EvaluatedPerson", "Denetlenen"): ' + ($data.evaluatedPersonnelName || $data.dealerName || '')"></small>
                            </td>
                            <td>
                                <span data-bind="text: completedAt ? new Date(completedAt).toLocaleDateString('tr-TR') : '-'"></span>
                                <small class="text-muted d-block" data-bind="text: completedAt ? new Date(completedAt).toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }) : ''"></small>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="progress flex-grow-1 me-2" style="height: 20px; min-width: 80px;">
                                        <div class="progress-bar" role="progressbar"
                                             data-bind="style: { width: (scorePercentage || 0) + '%' },
                                                        css: (scorePercentage || 0) >= 70 ? 'bg-success' : ((scorePercentage || 0) >= 50 ? 'bg-warning' : 'bg-danger')">
                                        </div>
                                    </div>
                                    <strong data-bind="text: (scorePercentage || 0).toFixed(2) + '%'"></strong>
                                </div>
                            </td>
                            <td>
                                <span data-bind="visible: yellowCardCount > 0" class="badge bg-warning text-dark me-1">
                                    <i class="bi bi-card-fill"></i> <span data-bind="text: yellowCardCount"></span>
                                </span>
                                <span data-bind="visible: redCardCount > 0" class="badge bg-danger">
                                    <i class="bi bi-card-fill"></i> <span data-bind="text: redCardCount"></span>
                                </span>
                                <span data-bind="visible: yellowCardCount === 0 && redCardCount === 0" class="text-muted">-</span>
                            </td>
                            <td>
                                <span class="badge" data-bind="css: $parent.getStatusBadgeClass(status), text: $parent.getStatusText(status)"></span>
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary" data-bind="click: $parent.viewDetail" title="@Html.T("Common.Detail", "Detay")">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <!-- Pagination Footer -->
        <div class="card-footer bg-white" data-bind="visible: paginationInfo().totalPages > 1">
            <nav>
                <ul class="pagination mb-0">
                    <li class="page-item" data-bind="css: { disabled: !paginationInfo().hasPreviousPage }">
                        <a class="page-link" href="#" data-bind="click: previousPage">@Html.T("Common.Previous", "Onceki")</a>
                    </li>
                    <!-- ko foreach: pageNumbers -->
                    <li class="page-item" data-bind="css: { active: $data === $parent.page() }">
                        <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                    </li>
                    <!-- /ko -->
                    <li class="page-item" data-bind="css: { disabled: !paginationInfo().hasNextPage }">
                        <a class="page-link" href="#" data-bind="click: nextPage">@Html.T("Pagination.Next", "Sonraki")</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

    <!-- Detail Modal -->
    <div class="modal fade" id="detailModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-file-earmark-text"></i> @Html.T("Report.EvaluationDetail", "Degerlendirme Detayi")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" data-bind="with: selectedDetail">
                    <!-- Header Info -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="border-bottom pb-2">@Html.T("Report.GeneralInfo", "Genel Bilgiler")</h6>
                            <dl class="row mb-0">
                                <dt class="col-sm-4">@Html.T("Common.Project", "Proje"):</dt>
                                <dd class="col-sm-8" data-bind="text: projectName"></dd>
                                <dt class="col-sm-4">@Html.T("Report.Checklist", "Kontrol Listesi"):</dt>
                                <dd class="col-sm-8" data-bind="text: checklistName"></dd>
                                <dt class="col-sm-4">@Html.T("Report.Evaluator", "Degerlendirici"):</dt>
                                <dd class="col-sm-8" data-bind="text: $data.evaluatorName || '-'"></dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <h6 class="border-bottom pb-2">@Html.T("Report.Scoring", "Puanlama")</h6>
                            <div class="row text-center">
                                <div class="col">
                                    <h2 class="mb-0 text-primary" data-bind="text: (scorePercentage || 0).toFixed(2) + '%'"></h2>
                                    <small class="text-muted">@Html.T("Report.Score", "Puan")</small>
                                </div>
                                <div class="col">
                                    <h2 class="mb-0 text-warning" data-bind="text: yellowCardCount"></h2>
                                    <small class="text-muted">@Html.T("Report.YellowCard", "Sari Kart")</small>
                                </div>
                                <div class="col">
                                    <h2 class="mb-0 text-danger" data-bind="text: redCardCount"></h2>
                                    <small class="text-muted">@Html.T("Report.RedCard", "Kirmizi Kart")</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Answers Table -->
                    <div class="card">
                        <div class="card-header bg-light">
                            <h6 class="mb-0"><i class="bi bi-list-check"></i> @Html.T("Evaluation.Answers", "Verilen Cevaplar")</h6>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm table-striped table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 15%;">@Html.T("Evaluation.Group", "Grup")</th>
                                            <th style="width: 35%;">@Html.T("Report.Question", "Soru")</th>
                                            <th class="text-center" style="width: 15%;">@Html.T("Report.Score", "Puan")</th>
                                            <th style="width: 35%;">@Html.T("Common.Note", "Not")</th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: $data.answers || []">
                                        <tr data-bind="css: { 'table-warning': $data.appliedPenaltyType === 'YellowCard', 'table-danger': $data.appliedPenaltyType === 'RedCard' }">
                                            <td class="text-wrap" data-bind="text: $data.groupName || '-'"></td>
                                            <td class="text-wrap">
                                                <span data-bind="text: $data.questionText"></span>
                                                <!-- ko if: $data.selectedSubCriteria && $data.selectedSubCriteria.length > 0 -->
                                                <br><small class="text-warning"><i class="bi bi-exclamation-triangle"></i> <span data-bind="text: $data.selectedSubCriteria.join(', ')"></span></small>
                                                <!-- /ko -->
                                            </td>
                                            <td class="text-center">
                                                <!-- ko if: $data.scoringType !== 'Unscored' && $data.givenPoints !== null && $data.givenPoints !== undefined -->
                                                <span class="badge bg-primary" data-bind="text: $data.givenPoints + '/' + $data.maxPoints"></span>
                                                <!-- /ko -->
                                                <!-- ko if: $data.scoringType === 'Unscored' || $data.givenPoints === null || $data.givenPoints === undefined -->
                                                <span class="text-muted">-</span>
                                                <!-- /ko -->
                                            </td>
                                            <td>
                                                <span data-bind="visible: $data.appliedPenaltyType === 'YellowCard'" class="badge bg-warning text-dark me-1">@Html.T("Report.YellowCard", "Sarı Kart")</span>
                                                <span data-bind="visible: $data.appliedPenaltyType === 'RedCard'" class="badge bg-danger me-1">@Html.T("Report.RedCard", "Kırmızı Kart")</span>
                                                <small data-bind="text: $data.notes" class="text-muted"></small>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Descriptions -->
                    <div data-bind="visible: $data.descriptions && $data.descriptions.length > 0" class="card mt-3">
                        <div class="card-header bg-secondary text-white">
                            <h6 class="mb-0"><i class="bi bi-list-ul"></i> @Html.T("Evaluation.Descriptions", "Aciklamalar")</h6>
                        </div>
                        <div class="card-body">
                            <ul class="mb-0" data-bind="foreach: $data.descriptions">
                                <li data-bind="text: $data"></li>
                            </ul>
                        </div>
                    </div>

                    <!-- Evaluation Comment -->
                    <div data-bind="visible: $data.evaluationComment" class="card mt-3">
                        <div class="card-header bg-info text-white">
                            <h6 class="mb-0"><i class="bi bi-chat-quote"></i> @Html.T("Evaluation.EvaluationComment", "Denetim Yorumu")</h6>
                        </div>
                        <div class="card-body">
                            <p class="mb-0" data-bind="text: $data.evaluationComment"></p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Close", "Kapat")</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Reports/Index.js" asp-append-version="true"></script>
}
