@{
    ViewData["Title"] = @Html.T("Report.PersonnelReportCard", "Temsilci Karnesi");
    var selectedPersonnelId = ViewBag.SelectedPersonnelId as Guid?;
}

<div id="personnel-report-card-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-person-badge"></i> @Html.T("Report.PersonnelReportCard", "Temsilci Karnesi")</h2>
        <div class="btn-group" data-bind="visible: report()">
            <button class="btn btn-success" data-bind="click: exportToExcel, disable: isExporting">
                <span data-bind="visible: !isExporting()">
                    <i class="bi bi-file-earmark-excel"></i> @Html.T("Report.ExportExcel", "Excel İndir")
                </span>
                <span data-bind="visible: isExporting">
                    <span class="spinner-border spinner-border-sm"></span> @Html.T("Report.Downloading", "İndiriliyor...")
                </span>
            </button>
            <button class="btn btn-danger" data-bind="click: printReport">
                <i class="bi bi-file-pdf"></i> @Html.T("Report.PrintPdf", "PDF Yazdır")
            </button>
        </div>
    </div>

    <!-- Personnel Selection -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-person-check"></i> @Html.T("Report.PersonnelSelection", "Temsilci Seçimi")</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <!-- Müşteri Seçimi -->
                <div class="col-md-3">
                    <label class="form-label">@Html.T("Report.Customer", "Müşteri")</label>
                    <select class="form-select" data-bind="value: selectedCustomerId, options: customers, optionsValue: 'id', optionsText: 'companyName', optionsCaption: '@Html.T("Report.AllCustomers", "Tüm Müşteriler")', event: { change: onCustomerChange }"></select>
                </div>
                <!-- Organizasyon Seçimi -->
                <div class="col-md-3">
                    <label class="form-label">@Html.T("Report.Organization", "Şube/Organizasyon")</label>
                    <select class="form-select" data-bind="value: selectedOrganizationId, options: filteredOrganizations, optionsValue: 'id', optionsText: 'name', optionsCaption: '@Html.T("Report.AllOrganizations", "Tüm Şubeler")', event: { change: onOrganizationChange }, enable: organizations().length > 0"></select>
                </div>
                <!-- Temsilci Seçimi -->
                <div class="col-md-3">
                    <label class="form-label">@Html.T("Report.Personnel", "Temsilci")</label>
                    <select class="form-select" data-bind="value: selectedPersonnelId, options: filteredPersonnelList, optionsValue: 'id', optionsText: 'name', optionsCaption: '@Html.T("Report.SelectPersonnel", "Temsilci Seçin...")', enable: personnelList().length > 0"></select>
                </div>
                <!-- Tarih Aralığı -->
                <div class="col-md-3">
                    <label class="form-label">@Html.T("Report.DateRange", "Tarih Aralığı")</label>
                    <div class="input-group">
                        <input type="date" class="form-control" data-bind="value: filter.startDate" placeholder="Başlangıç">
                        <span class="input-group-text">-</span>
                        <input type="date" class="form-control" data-bind="value: filter.endDate" placeholder="Bitiş">
                    </div>
                </div>
            </div>
            <div class="row g-3 mt-2">
                <div class="col-md-6">
                    <small class="text-muted">
                        <i class="bi bi-info-circle"></i> @Html.T("Report.HierarchyHint", "Müşteri seçince şubeler, şube seçince o şubenin temsilcileri filtrelenir.")
                    </small>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-primary w-100" data-bind="click: loadReport, disable: !selectedPersonnelId()">
                        <i class="bi bi-search"></i> @Html.T("Report.GetReport", "Rapor Getir")
                    </button>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-outline-secondary w-100" data-bind="click: clearFilters">
                        <i class="bi bi-x-circle"></i> @Html.T("Common.Clear", "Temizle")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yükleniyor...")</span>
        </div>
        <p class="mt-2 text-muted">@Html.T("Report.LoadingReportCard", "Karne yükleniyor...")</p>
    </div>

    <!-- Report Content (printable area) -->
    <div id="printable-report" data-bind="visible: report() && !isLoading()">
        <!-- Personnel Info Header -->
        <div class="card shadow-sm mb-4" data-bind="with: report">
            <div class="card-header bg-dark text-white">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <h4 class="mb-0">
                            <i class="bi bi-person-circle"></i>
                            <span data-bind="text: personnelName"></span>
                        </h4>
                        <small>
                            <span data-bind="text: title || ''"></span>
                        </small>
                    </div>
                    <div class="col-md-6 text-end">
                        <span class="badge bg-light text-dark fs-5" data-bind="text: totalEvaluations + ' @Html.T("Report.Evaluation", "Değerlendirme")'"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="row mb-4" data-bind="with: report">
            <div class="col-md-2">
                <div class="card text-center h-100">
                    <div class="card-body py-3">
                        <h2 class="mb-0" data-bind="text: averageScore.toFixed(1) + '%', css: averageScore >= 70 ? 'text-success' : (averageScore >= 50 ? 'text-warning' : 'text-danger')"></h2>
                        <small class="text-muted">@Html.T("Report.AverageScore", "Ortalama Puan")</small>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-center h-100 bg-success text-white">
                    <div class="card-body py-3">
                        <h2 class="mb-0" data-bind="text: bestScore.toFixed(1) + '%'"></h2>
                        <small>@Html.T("Report.HighestScore", "En Yüksek")</small>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-center h-100 bg-danger text-white">
                    <div class="card-body py-3">
                        <h2 class="mb-0" data-bind="text: worstScore.toFixed(1) + '%'"></h2>
                        <small>@Html.T("Report.LowestScore", "En Düşük")</small>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-center h-100">
                    <div class="card-body py-3">
                        <h2 class="mb-0 text-primary" data-bind="text: totalEvaluations"></h2>
                        <small class="text-muted">@Html.T("Report.Total", "Toplam")</small>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-center h-100 bg-warning">
                    <div class="card-body py-3">
                        <h2 class="mb-0" data-bind="text: totalYellowCards"></h2>
                        <small>@Html.T("Report.YellowCard", "Sarı Kart")</small>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-center h-100 bg-danger text-white">
                    <div class="card-body py-3">
                        <h2 class="mb-0" data-bind="text: totalRedCards"></h2>
                        <small>@Html.T("Report.RedCard", "Kırmızı Kart")</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Monthly Trend Chart -->
        <div class="row mb-4" data-bind="visible: report() && report().monthlyTrend.length > 0">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h6 class="mb-0"><i class="bi bi-graph-up"></i> @Html.T("Report.MonthlyPerformanceTrend", "Aylık Performans Trendi")</h6>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>@Html.T("Report.Period", "Dönem")</th>
                                        <th class="text-center">@Html.T("Report.Evaluation", "Değerlendirme")</th>
                                        <th class="text-center">@Html.T("Report.AverageScore", "Ort. Puan")</th>
                                        <th class="text-center">@Html.T("Report.YellowCard", "Sarı Kart")</th>
                                        <th class="text-center">@Html.T("Report.RedCard", "Kırmızı Kart")</th>
                                    </tr>
                                </thead>
                                <tbody data-bind="foreach: report().monthlyTrend">
                                    <tr>
                                        <td data-bind="text: monthName"></td>
                                        <td class="text-center" data-bind="text: evaluationCount"></td>
                                        <td class="text-center">
                                            <span class="badge" data-bind="text: averageScore.toFixed(1) + '%', css: averageScore >= 70 ? 'bg-success' : (averageScore >= 50 ? 'bg-warning text-dark' : 'bg-danger')"></span>
                                        </td>
                                        <td class="text-center" data-bind="text: yellowCards"></td>
                                        <td class="text-center" data-bind="text: redCards"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Group Performance & Strengths/Weaknesses -->
        <div class="row mb-4">
            <!-- Group Performance -->
            <div class="col-md-6" data-bind="visible: report() && report().groupPerformances && report().groupPerformances.length > 0">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-secondary text-white">
                        <h6 class="mb-0"><i class="bi bi-list-task"></i> @Html.T("Report.GroupPerformance", "Grup Performansı")</h6>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@Html.T("Report.QuestionGroup", "Soru Grubu")</th>
                                    <th class="text-center">@Html.T("Report.SuccessRate", "Başarı %")</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: report().groupPerformances">
                                <tr>
                                    <td data-bind="text: groupName"></td>
                                    <td class="text-center">
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar" role="progressbar"
                                                 data-bind="style: { width: percentageScore + '%' },
                                                            css: percentageScore >= 70 ? 'bg-success' : (percentageScore >= 50 ? 'bg-warning' : 'bg-danger'),
                                                            text: percentageScore.toFixed(1) + '%'">
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Strengths & Weaknesses -->
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-secondary text-white">
                        <h6 class="mb-0"><i class="bi bi-bar-chart"></i> @Html.T("Report.StrengthsWeaknesses", "Güçlü ve Zayıf Yönler")</h6>
                    </div>
                    <div class="card-body p-0">
                        <!-- Strengths -->
                        <div class="p-2 bg-success bg-opacity-10" data-bind="visible: report() && report().strengths.length > 0">
                            <small class="text-success fw-bold"><i class="bi bi-arrow-up-circle"></i> @Html.T("Report.Strengths", "Güçlü Yönler")</small>
                        </div>
                        <ul class="list-group list-group-flush" data-bind="foreach: report().strengths">
                            <li class="list-group-item py-1 small">
                                <span class="badge bg-success me-1" data-bind="text: percentageScore.toFixed(0) + '%'"></span>
                                <span data-bind="text: questionText"></span>
                            </li>
                        </ul>

                        <!-- Weaknesses -->
                        <div class="p-2 bg-danger bg-opacity-10" data-bind="visible: report() && report().weaknesses.length > 0">
                            <small class="text-danger fw-bold"><i class="bi bi-arrow-down-circle"></i> @Html.T("Report.NeedsImprovement", "Geliştirilmesi Gereken")</small>
                        </div>
                        <ul class="list-group list-group-flush" data-bind="foreach: report().weaknesses">
                            <li class="list-group-item py-1 small">
                                <span class="badge bg-danger me-1" data-bind="text: percentageScore.toFixed(0) + '%'"></span>
                                <span data-bind="text: questionText"></span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Evaluations -->
        <div class="card shadow-sm" data-bind="visible: report() && report().recentEvaluations.length > 0">
            <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="bi bi-clock-history"></i> @Html.T("Report.RecentEvaluations", "Son Değerlendirmeler")</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.T("Report.Date", "Tarih")</th>
                                <th>@Html.T("Report.Project", "Proje")</th>
                                <th>@Html.T("Report.Checklist", "Kontrol Listesi")</th>
                                <th>@Html.T("Report.Evaluator", "Değerlendirici")</th>
                                <th class="text-center">@Html.T("Report.Score", "Puan")</th>
                                <th class="text-center">@Html.T("Report.Cards", "Kartlar")</th>
                                <th class="text-center">@Html.T("Common.Actions", "İşlem")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: report().recentEvaluations">
                            <tr>
                                <td data-bind="text: evaluationDate ? new Date(evaluationDate).toLocaleDateString('tr-TR') : '-'"></td>
                                <td data-bind="text: projectName"></td>
                                <td data-bind="text: checklistName"></td>
                                <td data-bind="text: evaluatorName || '-'"></td>
                                <td class="text-center">
                                    <span class="badge" data-bind="text: scorePercentage.toFixed(1) + '%', css: scorePercentage >= 70 ? 'bg-success' : (scorePercentage >= 50 ? 'bg-warning text-dark' : 'bg-danger')"></span>
                                </td>
                                <td class="text-center">
                                    <span data-bind="visible: yellowCards > 0" class="badge bg-warning text-dark me-1" data-bind="text: yellowCards"></span>
                                    <span data-bind="visible: redCards > 0" class="badge bg-danger" data-bind="text: redCards"></span>
                                    <span data-bind="visible: yellowCards === 0 && redCards === 0">-</span>
                                </td>
                                <td class="text-center">
                                    <a data-bind="attr: { href: '/Evaluations/Details/' + evaluationId }" class="btn btn-sm btn-outline-primary" target="_blank">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Empty State -->
    <div data-bind="visible: !report() && !isLoading() && selectedPersonnelId()" class="text-center text-muted py-5">
        <i class="bi bi-inbox fs-1"></i>
        <p class="mt-2">@Html.T("Report.NoEvaluationsForPersonnel", "Bu temsilci için değerlendirme bulunamadı.")</p>
    </div>

    <!-- Initial State -->
    <div data-bind="visible: !report() && !isLoading() && !selectedPersonnelId()" class="text-center text-muted py-5">
        <i class="bi bi-person-badge fs-1"></i>
        <p class="mt-2">@Html.T("Report.SelectPersonnelToViewReport", "Karne görmek için bir temsilci seçin.")</p>
    </div>
</div>

@section Scripts {
    <script src="~/js/Reports/PersonnelReportCard.js"></script>
    <script>
        var initialPersonnelId = '@(selectedPersonnelId?.ToString() ?? "")';
    </script>
}

<style>
    @@media print {
        .card-header.bg-primary { background-color: #0d6efd !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .card-header.bg-dark { background-color: #212529 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .card-header.bg-info { background-color: #0dcaf0 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .card-header.bg-secondary { background-color: #6c757d !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .bg-success { background-color: #198754 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .bg-warning { background-color: #ffc107 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .bg-danger { background-color: #dc3545 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .text-white { color: white !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .badge { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .progress-bar { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
</style>
