@{
    ViewData["Title"] = @Html.T("Report.SurveyResults", "Anket Sonuçları");
}

<div id="survey-results-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-clipboard-data text-primary"></i> @Html.T("Report.SurveyResults", "Anket Sonuçları")</h2>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Veriler yükleniyor...")</p>
    </div>

    <!-- Main Content -->
    <div data-bind="visible: !isLoading()" class="row">
        <!-- Sol Panel: Son Anket Yanıtları -->
        <div class="col-lg-5 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-clock-history"></i> @Html.T("Report.RecentResponses", "Son Yanıtlar")</h5>
                    <button class="btn btn-sm btn-light" data-bind="click: showAllResponsesPopup">
                        <i class="bi bi-arrows-fullscreen"></i> @Html.T("Report.ViewAll", "Tümünü İncele")
                    </button>
                </div>
                <div class="card-body p-0">
                    <!-- Empty State -->
                    <div data-bind="visible: recentResponses().length === 0" class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">@Html.T("Report.NoResponses", "Henüz yanıt bulunmuyor.")</p>
                    </div>
                    <!-- Response List -->
                    <div class="list-group list-group-flush" data-bind="foreach: recentResponses">
                        <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1 me-2">
                                <div class="d-flex align-items-center">
                                    <strong data-bind="text: respondentName || 'Anonim'" class="me-2"></strong>
                                    <span class="badge" data-bind="text: score !== null ? score.toFixed(1) + '%' : '-', css: { 'bg-success': score >= 70, 'bg-warning': score >= 40 && score < 70, 'bg-danger': score < 40, 'bg-secondary': score === null }"></span>
                                </div>
                                <small class="text-muted">
                                    <span data-bind="text: projectName"></span>
                                    <span class="ms-2" data-bind="text: completedAt ? new Date(completedAt).toLocaleString('tr-TR') : ''"></span>
                                </small>
                            </div>
                            <button class="btn btn-sm btn-outline-primary" data-bind="click: $parent.showResponseDetail" title="@Html.T("Report.ViewDetails", "Detay")">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sağ Panel: Online Anket Projeleri -->
        <div class="col-lg-7 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-collection"></i> @Html.T("Report.SurveyProjects", "Online Anket Projeleri")</h5>
                </div>
                <div class="card-body p-0">
                    <!-- Empty State -->
                    <div data-bind="visible: surveyProjects().length === 0" class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">@Html.T("Report.NoProjects", "Henüz proje bulunmuyor.")</p>
                    </div>
                    <!-- Project List -->
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" data-bind="visible: surveyProjects().length > 0">
                            <thead class="table-light">
                                <tr>
                                    <th>@Html.T("Report.Project", "Proje")</th>
                                    <th class="text-center">@Html.T("Report.Invitations", "Davetiye")</th>
                                    <th class="text-center">@Html.T("Report.Responses", "Yanıt")</th>
                                    <th class="text-center">@Html.T("Report.Rate", "Oran")</th>
                                    <th class="text-center">@Html.T("Report.AvgScore", "Ort. Puan")</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: surveyProjects">
                                <tr>
                                    <td>
                                        <div>
                                            <strong data-bind="text: projectName"></strong>
                                            <!-- ko if: !isActive -->
                                            <span class="badge bg-secondary ms-1">Pasif</span>
                                            <!-- /ko -->
                                        </div>
                                        <small class="text-muted" data-bind="text: customerName || '-'"></small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary" data-bind="text: totalInvitations"></span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary" data-bind="text: totalResponses"></span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge" data-bind="text: responseRate.toFixed(1) + '%', css: { 'bg-success': responseRate >= 50, 'bg-warning': responseRate >= 20 && responseRate < 50, 'bg-danger': responseRate < 20 }"></span>
                                    </td>
                                    <td class="text-center">
                                        <!-- ko if: averageScore !== null -->
                                        <span class="badge" data-bind="text: averageScore.toFixed(1) + '%', css: { 'bg-success': averageScore >= 70, 'bg-warning': averageScore >= 40 && averageScore < 70, 'bg-danger': averageScore < 40 }"></span>
                                        <!-- /ko -->
                                        <!-- ko if: averageScore === null -->
                                        <span class="badge bg-secondary">-</span>
                                        <!-- /ko -->
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-info" data-bind="click: $parent.showProjectDetail" title="@Html.T("Report.ViewProjectDetail", "Proje Detayı")">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tüm Yanıtlar Popup Modal -->
<div class="modal fade" id="allResponsesModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-list-ul"></i> @Html.T("Report.AllResponses", "Tüm Anket Yanıtları")</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Filters -->
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">@Html.T("Report.FilterProject", "Proje")</label>
                        <select class="form-select" data-bind="value: popupFilter.projectId, options: surveyProjects, optionsValue: 'projectId', optionsText: 'projectName', optionsCaption: '@Html.T("Common.All", "Tümü")'"></select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Html.T("Report.StartDate", "Başlangıç")</label>
                        <input type="date" class="form-control" data-bind="value: popupFilter.startDate">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Html.T("Report.EndDate", "Bitiş")</label>
                        <input type="date" class="form-control" data-bind="value: popupFilter.endDate">
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-primary w-100" data-bind="click: loadAllResponses">
                            <i class="bi bi-search"></i> @Html.T("Common.Filter", "Filtrele")
                        </button>
                    </div>
                </div>
                <!-- Loading -->
                <div data-bind="visible: isLoadingPopup" class="text-center py-4">
                    <div class="spinner-border text-primary"></div>
                </div>
                <!-- Response Table -->
                <div class="table-responsive" data-bind="visible: !isLoadingPopup()">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.T("Report.Respondent", "Katılımcı")</th>
                                <th>@Html.T("Report.Project", "Proje")</th>
                                <th class="text-center">@Html.T("Report.Score", "Puan")</th>
                                <th>@Html.T("Report.Date", "Tarih")</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: allResponses">
                            <tr>
                                <td>
                                    <div data-bind="text: respondentName || 'Anonim'"></div>
                                    <small class="text-muted" data-bind="text: respondentEmail || ''"></small>
                                </td>
                                <td data-bind="text: projectName"></td>
                                <td class="text-center">
                                    <span class="badge" data-bind="text: score !== null ? score.toFixed(1) + '%' : '-', css: { 'bg-success': score >= 70, 'bg-warning': score >= 40 && score < 70, 'bg-danger': score < 40, 'bg-secondary': score === null }"></span>
                                </td>
                                <td>
                                    <small data-bind="text: completedAt ? new Date(completedAt).toLocaleString('tr-TR') : '-'"></small>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" data-bind="click: $parent.showResponseDetail" title="@Html.T("Report.ViewDetails", "Detay")">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <!-- Empty -->
                    <div data-bind="visible: allResponses().length === 0 && !isLoadingPopup()" class="text-center py-4 text-muted">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">@Html.T("Report.NoMatchingResponses", "Filtreye uygun yanıt bulunamadı.")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Proje Detay Modal -->
<div class="modal fade" id="projectDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="bi bi-bar-chart"></i> @Html.T("Report.ProjectDetail", "Proje Detayı")</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" data-bind="with: projectDetail">
                <!-- Summary -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h5 data-bind="text: projectName"></h5>
                        <p class="text-muted mb-0" data-bind="text: customerName || ''"></p>
                    </div>
                    <div class="col-md-6 text-end">
                        <div class="d-flex justify-content-end gap-3">
                            <div class="text-center">
                                <small class="text-muted d-block">@Html.T("Report.Invitations", "Davetiye")</small>
                                <strong class="fs-5" data-bind="text: totalInvitations"></strong>
                            </div>
                            <div class="text-center">
                                <small class="text-muted d-block">@Html.T("Report.Responses", "Yanıt")</small>
                                <strong class="fs-5" data-bind="text: totalResponses"></strong>
                            </div>
                            <div class="text-center">
                                <small class="text-muted d-block">@Html.T("Report.Rate", "Oran")</small>
                                <strong class="fs-5" data-bind="text: responseRate.toFixed(1) + '%'"></strong>
                            </div>
                            <div class="text-center">
                                <small class="text-muted d-block">@Html.T("Report.AvgScore", "Ort. Puan")</small>
                                <span class="badge fs-6" data-bind="text: averageScore !== null ? averageScore.toFixed(1) + '%' : '-', css: { 'bg-success': averageScore >= 70, 'bg-warning': averageScore >= 40 && averageScore < 70, 'bg-danger': averageScore < 40, 'bg-secondary': averageScore === null }"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Grup Bazlı Puanlar -->
                <!-- ko if: groupScores && groupScores.length > 0 -->
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="bi bi-collection"></i> @Html.T("Report.GroupScores", "Grup Bazlı Puanlar")</h6>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>@Html.T("Report.GroupName", "Grup")</th>
                                    <th class="text-center">@Html.T("Report.QuestionCount", "Soru")</th>
                                    <th class="text-center">@Html.T("Report.AvgScore", "Ort. Puan")</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: groupScores">
                                <tr>
                                    <td data-bind="text: groupName"></td>
                                    <td class="text-center" data-bind="text: questionCount"></td>
                                    <td class="text-center">
                                        <!-- ko if: averageScore !== null -->
                                        <span class="badge" data-bind="text: averageScore.toFixed(1) + '%', css: { 'bg-success': averageScore >= 70, 'bg-warning': averageScore >= 40 && averageScore < 70, 'bg-danger': averageScore < 40 }"></span>
                                        <!-- /ko -->
                                        <!-- ko if: averageScore === null -->
                                        <span class="badge bg-secondary">-</span>
                                        <!-- /ko -->
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- /ko -->

                <!-- Son Katılımcılar -->
                <!-- ko if: recentRespondents && recentRespondents.length > 0 -->
                <div class="card">
                    <div class="card-header bg-light">
                        <h6 class="mb-0"><i class="bi bi-people"></i> @Html.T("Report.RecentRespondents", "Son Katılımcılar")</h6>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>@Html.T("Report.Respondent", "Katılımcı")</th>
                                    <th class="text-center">@Html.T("Report.Score", "Puan")</th>
                                    <th>@Html.T("Report.Date", "Tarih")</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: recentRespondents">
                                <tr>
                                    <td>
                                        <span data-bind="text: fullName || 'Anonim'"></span>
                                        <!-- ko if: email -->
                                        <small class="text-muted d-block" data-bind="text: email"></small>
                                        <!-- /ko -->
                                    </td>
                                    <td class="text-center">
                                        <span class="badge" data-bind="text: score !== null ? score.toFixed(1) + '%' : '-', css: { 'bg-success': score >= 70, 'bg-warning': score >= 40 && score < 70, 'bg-danger': score < 40, 'bg-secondary': score === null }"></span>
                                    </td>
                                    <td>
                                        <small data-bind="text: completedAt ? new Date(completedAt).toLocaleDateString('tr-TR') : '-'"></small>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" data-bind="click: $parents[1].showResponseDetailFromProject" title="@Html.T("Report.ViewDetails", "Detay")">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- /ko -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> @Html.T("Common.Close", "Kapat")
                </button>
                <div class="btn-group" data-bind="visible: projectDetail()">
                    <button type="button" class="btn btn-success dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="bi bi-file-earmark-excel"></i> @Html.T("Report.ExportExcel", "Excel İndir")
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#" data-bind="click: exportGroupScores"><i class="bi bi-collection me-2"></i>@Html.T("Report.ExportGroupScores", "Grup Bazlı Puan Raporu")</a></li>
                        <li><a class="dropdown-item" href="#" data-bind="click: exportQuestionStats"><i class="bi bi-bar-chart me-2"></i>@Html.T("Report.ExportQuestionStats", "Soru İstatistik Raporu")</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#" data-bind="click: exportDetailReport"><i class="bi bi-list-check me-2"></i>@Html.T("Report.ExportDetail", "Detay Raporu")</a></li>
                        <li><a class="dropdown-item" href="#" data-bind="click: exportFullDetailReport"><i class="bi bi-file-text me-2"></i>@Html.T("Report.ExportFullDetail", "Tam Detay Raporu (Yorumlarla)")</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Yanıt Detay Modal -->
<div class="modal fade" id="responseDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-file-text"></i> @Html.T("Report.ResponseDetail", "Yanıt Detayı")</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Loading -->
                <div data-bind="visible: isLoadingResponseDetail" class="text-center py-4">
                    <div class="spinner-border text-primary"></div>
                </div>
                <!-- Detail -->
                <div data-bind="visible: !isLoadingResponseDetail() && responseDetail()">
                    <!-- Respondent Info -->
                    <div class="row mb-4" data-bind="with: responseDetail">
                        <div class="col-md-6">
                            <h5 data-bind="text: respondentName || 'Anonim'"></h5>
                            <p class="text-muted mb-0" data-bind="text: respondentEmail || ''"></p>
                            <small class="text-muted" data-bind="text: projectName"></small>
                        </div>
                        <div class="col-md-6 text-end">
                            <span class="badge fs-5" data-bind="text: score !== null ? score.toFixed(1) + '%' : '-', css: { 'bg-success': score >= 70, 'bg-warning': score >= 40 && score < 70, 'bg-danger': score < 40, 'bg-secondary': score === null }"></span>
                            <small class="text-muted d-block" data-bind="text: completedAt ? new Date(completedAt).toLocaleString('tr-TR') : ''"></small>
                        </div>
                    </div>

                    <!-- Answers -->
                    <div class="card" data-bind="with: responseDetail">
                        <div class="card-header bg-light">
                            <h6 class="mb-0"><i class="bi bi-list-check"></i> @Html.T("Report.Answers", "Cevaplar")</h6>
                        </div>
                        <div class="card-body p-0">
                            <div class="list-group list-group-flush" data-bind="foreach: answers">
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <div class="fw-bold" data-bind="text: questionText"></div>
                                            <!-- ko if: groupName -->
                                            <small class="text-muted" data-bind="text: '(' + groupName + ')'"></small>
                                            <!-- /ko -->
                                        </div>
                                        <!-- ko if: score !== null -->
                                        <span class="badge bg-primary ms-2" data-bind="text: score + ' / ' + maxPoints"></span>
                                        <!-- /ko -->
                                    </div>
                                    <!-- SubCriteria -->
                                    <!-- ko if: selectedSubCriteria && selectedSubCriteria.length > 0 -->
                                    <div class="mt-2">
                                        <small class="text-muted">@Html.T("Report.SelectedCriteria", "Seçilen Kriterler"):</small>
                                        <div data-bind="foreach: selectedSubCriteria">
                                            <span class="badge bg-info me-1" data-bind="text: $data"></span>
                                        </div>
                                    </div>
                                    <!-- /ko -->
                                    <!-- Comment -->
                                    <!-- ko if: comment -->
                                    <div class="mt-2">
                                        <small class="text-muted">@Html.T("Report.Comment", "Yorum"):</small>
                                        <div class="fst-italic" data-bind="text: comment"></div>
                                    </div>
                                    <!-- /ko -->
                                </div>
                            </div>
                            <!-- Empty -->
                            <div data-bind="visible: !answers || answers.length === 0" class="text-center py-4 text-muted">
                                <p>@Html.T("Report.NoAnswers", "Cevap bulunamadı.")</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> @Html.T("Common.Close", "Kapat")
                </button>
            </div>
        </div>
    </div>
</div>
</div><!-- /survey-results-app -->

@section Scripts {
    <script src="~/js/Reports/SurveyResults.js"></script>
}
