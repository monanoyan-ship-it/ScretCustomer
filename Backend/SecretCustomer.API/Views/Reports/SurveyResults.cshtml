@{
    ViewData["Title"] = @Html.T("Report.SurveyResults", "Anket Sonuçları");
}

<div id="survey-results-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-clipboard-data text-primary"></i> @Html.T("Report.SurveyResults", "Anket Sonuçları")</h2>
        <div class="btn-group">
            <button class="btn btn-success" data-bind="click: exportToExcel, disable: isExporting() || !selectedProjectId()">
                <span data-bind="visible: !isExporting()">
                    <i class="bi bi-file-earmark-excel"></i> @Html.T("Report.ExportExcel", "Excel İndir")
                </span>
                <span data-bind="visible: isExporting">
                    <span class="spinner-border spinner-border-sm"></span> @Html.T("Report.Downloading", "İndiriliyor...")
                </span>
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-funnel"></i> @Html.T("Common.Filters", "Filtreler")</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">@Html.T("Report.SurveyProject", "Anket Projesi") <span class="text-danger">*</span></label>
                    <select class="form-select" data-bind="value: selectedProjectId, options: surveyProjects, optionsValue: 'id', optionsText: function(p) { return p.name + (p.customerName ? ' (' + p.customerName + ')' : ''); }, optionsCaption: '@Html.T("Report.SelectProject", "Proje Seçin...")'"></select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Html.T("Report.StartDate", "Başlangıç")</label>
                    <input type="date" class="form-control" data-bind="value: startDate">
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Html.T("Report.EndDate", "Bitiş")</label>
                    <input type="date" class="form-control" data-bind="value: endDate">
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="btn-group w-100">
                        <button class="btn btn-primary" data-bind="click: loadResults, disable: !selectedProjectId()">
                            <i class="bi bi-search"></i> @Html.T("Common.LoadReport", "Raporu Yükle")
                        </button>
                        <button class="btn btn-outline-secondary" data-bind="click: clearFilters">
                            <i class="bi bi-x-circle"></i> @Html.T("Common.Clear", "Temizle")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Veriler yükleniyor...")</p>
    </div>

    <!-- No Project Selected -->
    <div data-bind="visible: !isLoading() && !selectedProjectId()" class="text-center py-5 text-muted">
        <i class="bi bi-clipboard2-data fs-1"></i>
        <p class="mt-2">@Html.T("Report.SelectProjectToView", "Raporu görüntülemek için bir anket projesi seçin.")</p>
    </div>

    <!-- Results -->
    <div data-bind="visible: !isLoading() && selectedProjectId() && results()">
        <!-- Summary Cards -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white h-100">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-1">@Html.T("Report.TotalResponses", "Toplam Yanıt")</h6>
                                <h2 class="mb-0" data-bind="text: results() ? results().totalResponses : 0"></h2>
                            </div>
                            <i class="bi bi-people fs-1 opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white h-100">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-1">@Html.T("Report.CompletionRate", "Tamamlanma")</h6>
                                <h2 class="mb-0" data-bind="text: results() ? results().completionRate.toFixed(1) + '%' : '0%'"></h2>
                            </div>
                            <i class="bi bi-check2-circle fs-1 opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white h-100">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-1">@Html.T("Report.AverageScore", "Ort. Puan")</h6>
                                <h2 class="mb-0" data-bind="text: results() ? results().averageScore.toFixed(1) : '0'"></h2>
                            </div>
                            <i class="bi bi-star-half fs-1 opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-white h-100">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 mb-1">@Html.T("Report.TotalQuestions", "Soru Sayısı")</h6>
                                <h2 class="mb-0" data-bind="text: results() ? results().totalQuestions : 0"></h2>
                            </div>
                            <i class="bi bi-question-circle fs-1 opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Question Results -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-bar-chart"></i> @Html.T("Report.QuestionResults", "Soru Bazlı Sonuçlar")</h5>
            </div>
            <div class="card-body p-0">
                <div data-bind="visible: !results() || !results().questionResults || results().questionResults.length === 0" class="text-center py-4 text-muted">
                    <i class="bi bi-inbox fs-1"></i>
                    <p class="mt-2">@Html.T("Report.NoQuestionResults", "Henüz soru sonucu bulunmuyor.")</p>
                </div>
                <div class="accordion" id="questionAccordion" data-bind="foreach: results() ? results().questionResults : []">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bind="attr: { 'data-bs-target': '#q' + questionId, 'aria-controls': 'q' + questionId }">
                                <div class="d-flex justify-content-between align-items-center w-100 me-3">
                                    <div>
                                        <span class="badge bg-secondary me-2" data-bind="text: '#' + order"></span>
                                        <strong data-bind="text: questionText"></strong>
                                        <small class="text-muted ms-2" data-bind="text: '(' + groupName + ')'"></small>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-primary me-2" data-bind="text: responseCount + ' yanıt'"></span>
                                        <!-- ko if: averageScore !== null -->
                                        <span class="badge" data-bind="text: averageScore.toFixed(1) + '%', css: { 'bg-success': averageScore >= 70, 'bg-warning': averageScore >= 40 && averageScore < 70, 'bg-danger': averageScore < 40 }"></span>
                                        <!-- /ko -->
                                    </div>
                                </div>
                            </button>
                        </h2>
                        <div class="accordion-collapse collapse" data-bind="attr: { id: 'q' + questionId }">
                            <div class="accordion-body">
                                <div class="row">
                                    <!-- Score Distribution (if showScoreInput) -->
                                    <!-- ko if: showScoreInput && scoreDistribution && scoreDistribution.length > 0 -->
                                    <div class="col-md-6 mb-3">
                                        <h6><i class="bi bi-graph-up"></i> @Html.T("Report.ScoreDistribution", "Puan Dağılımı")</h6>
                                        <div data-bind="foreach: scoreDistribution">
                                            <div class="d-flex align-items-center mb-2">
                                                <span class="badge bg-secondary me-2" style="width: 40px;" data-bind="text: score"></span>
                                                <div class="progress flex-grow-1" style="height: 20px;">
                                                    <div class="progress-bar" role="progressbar"
                                                         data-bind="style: { width: percentage + '%' }, text: count + ' (' + percentage.toFixed(1) + '%)'">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- /ko -->

                                    <!-- SubCriteria Results -->
                                    <!-- ko if: subCriteriaResults && subCriteriaResults.length > 0 -->
                                    <div class="col-md-6 mb-3">
                                        <h6><i class="bi bi-list-check"></i> @Html.T("Report.SubCriteriaResults", "Alt Kriter Seçimleri")</h6>
                                        <div data-bind="foreach: subCriteriaResults">
                                            <div class="d-flex align-items-center mb-2">
                                                <span class="flex-grow-1 text-truncate" data-bind="text: description, attr: { title: description }"></span>
                                                <span class="badge bg-info ms-2" data-bind="text: selectionCount + ' (' + selectionPercentage.toFixed(1) + '%)'"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- /ko -->

                                    <!-- Comments -->
                                    <!-- ko if: comments && comments.length > 0 -->
                                    <div class="col-12">
                                        <h6><i class="bi bi-chat-quote"></i> @Html.T("Report.Comments", "Yorumlar") <span class="badge bg-secondary" data-bind="text: comments.length"></span></h6>
                                        <div class="list-group list-group-flush" style="max-height: 200px; overflow-y: auto;">
                                            <!-- ko foreach: comments.slice(0, 5) -->
                                            <div class="list-group-item py-2">
                                                <small class="text-muted d-block" data-bind="text: respondentName || 'Anonim'"></small>
                                                <span data-bind="text: comment"></span>
                                            </div>
                                            <!-- /ko -->
                                            <!-- ko if: comments.length > 5 -->
                                            <div class="list-group-item text-center text-muted py-2">
                                                <small data-bind="text: '... ve ' + (comments.length - 5) + ' yorum daha'"></small>
                                            </div>
                                            <!-- /ko -->
                                        </div>
                                    </div>
                                    <!-- /ko -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Respondent List -->
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-people"></i> @Html.T("Report.RespondentList", "Katılımcı Listesi")</h5>
                <span class="badge bg-primary" data-bind="text: results() ? results().respondents.length + ' kişi' : ''"></span>
            </div>
            <div class="card-body p-0">
                <div data-bind="visible: !results() || !results().respondents || results().respondents.length === 0" class="text-center py-4 text-muted">
                    <i class="bi bi-inbox fs-1"></i>
                    <p class="mt-2">@Html.T("Report.NoRespondents", "Henüz katılımcı bulunmuyor.")</p>
                </div>
                <div data-bind="visible: results() && results().respondents && results().respondents.length > 0" class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.T("Report.Respondent", "Katılımcı")</th>
                                <th>@Html.T("Report.Email", "Email")</th>
                                <th>@Html.T("Report.Organization", "Organizasyon")</th>
                                <th class="text-center">@Html.T("Report.Score", "Puan")</th>
                                <th class="text-center">@Html.T("Report.CompletedAt", "Tamamlanma")</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: results() ? results().respondents : []">
                            <tr>
                                <td data-bind="text: fullName || 'Anonim'"></td>
                                <td><small class="text-muted" data-bind="text: email || '-'"></small></td>
                                <td><small data-bind="text: organizationName || '-'"></small></td>
                                <td class="text-center">
                                    <span class="badge" data-bind="text: score !== null ? score.toFixed(1) + '%' : '-', css: { 'bg-success': score >= 70, 'bg-warning': score >= 40 && score < 70, 'bg-danger': score < 40, 'bg-secondary': score === null }"></span>
                                </td>
                                <td class="text-center">
                                    <small data-bind="text: completedAt ? new Date(completedAt).toLocaleDateString('tr-TR') : '-'"></small>
                                </td>
                                <td>
                                    <a class="btn btn-sm btn-outline-primary" data-bind="attr: { href: '/Evaluations/Details/' + evaluationId }, visible: evaluationId" title="@Html.T("Report.ViewDetails", "Detay")">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Reports/SurveyResults.js"></script>
}
