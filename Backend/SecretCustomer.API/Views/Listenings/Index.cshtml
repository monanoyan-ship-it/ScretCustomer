@{
    ViewData["Title"] = Html.T("Listenings.Title", "Dinlemeler");
}

<div id="listenings-app" class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-headphones me-2"></i>@Html.T("Listenings.Title", "Dinlemeler")</h2>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" data-bind="click: openLoadFilterModal">
                <i class="bi bi-bookmark me-1"></i> @Html.T("Listenings.SavedFilters", "Kayıtlı Filtreler")
            </button>
            <!-- Raporlar Button -->
            <button class="btn btn-outline-success" data-bind="click: openReportsModal, disable: isExporting">
                <span data-bind="visible: !isExporting()"><i class="bi bi-file-earmark-spreadsheet me-1"></i> @Html.T("Common.Reports", "Raporlar")</span>
                <span data-bind="visible: isExporting"><span class="spinner-border spinner-border-sm"></span></span>
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body py-2">
            <!-- Filter Selector & Active Filters -->
            <div class="d-flex flex-wrap align-items-center gap-2">
                <!-- Add Filter Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-outline-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                        <i class="bi bi-plus-circle me-1"></i>@Html.T("Common.AddFilter", "Filtre Ekle")
                    </button>
                    <div class="dropdown-menu p-3 filter-dropdown">
                        <!-- Filter Type Selector -->
                        <div class="mb-2">
                            <select class="form-select form-select-sm" data-bind="value: selectedFilterType">
                                <option value="">@Html.T("Common.SelectFilter", "Filtre Seçin...")</option>
                                <option value="customerOrganization">Müşteri / Organizasyon</option>
                                <option value="project">@Html.T("Common.Project", "Proje")</option>
                                <option value="projectType">@Html.T("Project.Type", "Proje Tipi")</option>
                                <option value="evaluator">@Html.T("Listenings.Evaluator", "Değerlendiren")</option>
                                <option value="personnel">@Html.T("Listenings.Personnel", "Temsilci")</option>
                                <option value="supervisor">@Html.T("Listenings.Supervisor", "Yönetici")</option>
                                <option value="callId">@Html.T("Listenings.CallId", "Çağrı No")</option>
                                <option value="status">@Html.T("Common.Status", "Durum")</option>
                                <option value="evaluationSource">@Html.T("Listenings.EvaluationSource", "Değerlendirme Kaynağı")</option>
                                <option value="callDateRange">@Html.T("Listenings.CallDateRange", "Çağrı Tarihi")</option>
                                <option value="dateRange">@Html.T("Listenings.CreatedAtRange", "Kayıt Tarihi")</option>
                            </select>
                        </div>
                        <!-- Dynamic Filter Input -->
                        <!-- Customer / Organization (Combined - Two Dropdowns) -->
                        <div data-bind="visible: selectedFilterType() === 'customerOrganization'" class="mb-2">
                            <select class="form-select form-select-sm mb-1" data-bind="options: customers, optionsText: 'companyName', optionsValue: 'id', value: tempFilter.customerIdForOrg, optionsCaption: 'Müşteri Seçin...', event: { change: loadOrganizationsForFilter }"></select>
                            <select class="form-select form-select-sm" data-bind="options: organizationsForFilter, optionsText: 'name', optionsValue: 'id', value: tempFilter.organizationId, optionsCaption: 'Organizasyon (Opsiyonel)', enable: organizationsForFilter().length > 0"></select>
                        </div>
                        <!-- Project -->
                        <div data-bind="visible: selectedFilterType() === 'project'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="options: projectsForFilter, optionsText: 'name', optionsValue: 'id', value: tempFilter.projectId, optionsCaption: '@Html.T("Common.Select", "Seçin...")'"></select>
                        </div>
                        <!-- Project Type -->
                        <div data-bind="visible: selectedFilterType() === 'projectType'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="options: projectTypes, optionsText: function(item) { return T(item.nameKey, item.systemName); }, optionsValue: 'id', value: tempFilter.projectType, optionsCaption: '@Html.T("Common.Select", "Seçin...")'"></select>
                        </div>
                        <!-- Evaluator -->
                        <div data-bind="visible: selectedFilterType() === 'evaluator'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="options: evaluators, optionsText: 'name', optionsValue: 'id', value: tempFilter.evaluatorId, optionsCaption: '@Html.T("Common.Select", "Seçin...")'"></select>
                        </div>
                        <!-- Personnel (text) -->
                        <div data-bind="visible: selectedFilterType() === 'personnel'" class="mb-2">
                            <input type="text" class="form-control form-control-sm" autocomplete="off" data-bind="value: tempFilter.personnelName" placeholder="@Html.T("Listenings.Personnel", "Temsilci adı...")">
                        </div>
                        <!-- Supervisor (text) -->
                        <div data-bind="visible: selectedFilterType() === 'supervisor'" class="mb-2">
                            <input type="text" class="form-control form-control-sm" autocomplete="off" data-bind="value: tempFilter.supervisorName" placeholder="@Html.T("Listenings.Supervisor", "Yönetici adı...")">
                        </div>
                        <!-- CallId (text) -->
                        <div data-bind="visible: selectedFilterType() === 'callId'" class="mb-2">
                            <input type="text" class="form-control form-control-sm" autocomplete="off" data-bind="value: tempFilter.callId" placeholder="@Html.T("Listenings.CallId", "Çağrı No...")">
                        </div>
                        <!-- Status -->
                        <div data-bind="visible: selectedFilterType() === 'status'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="value: tempFilter.status">
                                <option value="">@Html.T("Common.Select", "Seçin...")</option>
                                <option value="Completed">@Html.T("Status.Completed", "Tamamlandı")</option>
                                <option value="InProgress">@Html.T("Evaluation.Status.InProgress", "Devam Ediyor")</option>
                                <option value="Draft">@Html.T("Common.Status.Draft", "Taslak")</option>
                            </select>
                        </div>
                        <!-- Evaluation Source -->
                        <div data-bind="visible: selectedFilterType() === 'evaluationSource'" class="mb-2">
                            <select class="form-select form-select-sm" data-bind="options: evaluationSources, optionsText: 'name', optionsValue: 'id', value: tempFilter.evaluationSource, optionsCaption: '@Html.T("Common.Select", "Seçin...")'"></select>
                        </div>
                        <!-- Date Range (Çağrı Tarihi ve Kayıt Tarihi) -->
                        <div data-bind="visible: selectedFilterType() === 'dateRange' || selectedFilterType() === 'callDateRange'" class="mb-2">
                            <div class="d-flex gap-1 mb-1">
                                <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.startDate">
                                <span class="align-self-center">-</span>
                                <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.endDate">
                            </div>
                            <div class="d-flex flex-wrap gap-1">
                                <!-- ko foreach: dateRanges -->
                                <button type="button" class="btn btn-sm"
                                    data-bind="click: function() { $parent.setTempDateRange(systemName); },
                                               text: name,
                                               css: $parent.tempFilter.selectedDateRangeType() === systemName ? 'btn-primary' : 'btn-outline-secondary'"></button>
                                <!-- /ko -->
                            </div>
                        </div>
                        <!-- Add Button -->
                        <button type="button" class="btn btn-primary btn-sm w-100" data-bind="click: addFilter, enable: canAddFilter">
                            <i class="bi bi-plus"></i> @Html.T("Common.Add", "Ekle")
                        </button>
                    </div>
                </div>

                <!-- Active Filters (Chips) -->
                <!-- ko foreach: activeFilters -->
                <span class="badge bg-primary d-flex align-items-center gap-1 py-2 px-2">
                    <span data-bind="text: label"></span>: <strong data-bind="text: displayValue"></strong>
                    <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.6rem;" data-bind="click: $parent.removeFilter"></button>
                </span>
                <!-- /ko -->

                <!-- Clear All -->
                <button class="btn btn-outline-danger btn-sm" data-bind="visible: activeFilters().length > 0, click: clearFilters">
                    <i class="bi bi-x-circle"></i> @Html.T("Common.ClearAll", "Temizle")
                </button>

                <!-- Save Filter Button -->
                <button class="btn btn-outline-secondary btn-sm" data-bind="visible: activeFilters().length > 0, click: openSaveFilterModal">
                    <i class="bi bi-bookmark-plus"></i> Kaydet
                </button>

                <!-- Spacer -->
                <div class="flex-grow-1"></div>

                <!-- Search Button -->
                <button class="btn btn-primary btn-sm" data-bind="click: search">
                    <i class="bi bi-search me-1"></i>@Html.T("Common.Search", "Ara")
                </button>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Yükleniyor...")</p>
    </div>

    <!-- Results -->
    <div data-bind="visible: !isLoading()">
        <!-- Summary -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-muted">
                @Html.T("Common.TotalRecords", "Toplam"): <strong data-bind="text: totalCount"></strong> @Html.T("Common.Records", "kayıt")
            </span>
            <div class="d-flex align-items-center gap-2">
                <label class="form-label mb-0 me-2">@Html.T("Common.PageSize", "Sayfa Boyutu"):</label>
                <select class="form-select form-select-sm" style="width: auto;" data-bind="value: pageSize, event: { change: search }">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: evaluations().length === 0" class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>@Html.T("Listenings.NoRecords", "Kayıt bulunamadı.")
        </div>

        <!-- Table -->
        <div data-bind="visible: evaluations().length > 0" class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="sortable" data-bind="click: function() { toggleSort('projectName'); }">
                                @Html.T("Common.Project", "Proje")
                                <i class="bi" data-bind="css: getSortIcon('projectName')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { toggleSort('periodName'); }">
                                @Html.T("Listenings.Period", "Dönem")
                                <i class="bi" data-bind="css: getSortIcon('periodName')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { toggleSort('evaluatedPersonnelName'); }">
                                @Html.T("Listenings.Personnel", "Temsilci")
                                <i class="bi" data-bind="css: getSortIcon('evaluatedPersonnelName')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { toggleSort('supervisorName'); }">
                                @Html.T("Listenings.Supervisor", "Yönetici")
                                <i class="bi" data-bind="css: getSortIcon('supervisorName')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { toggleSort('callId'); }">
                                @Html.T("Listenings.CallId", "Çağrı No")
                                <i class="bi" data-bind="css: getSortIcon('callId')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { toggleSort('evaluatorName'); }">
                                @Html.T("Listenings.Evaluator", "Değerlendiren")
                                <i class="bi" data-bind="css: getSortIcon('evaluatorName')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { toggleSort('callDate'); }">
                                @Html.T("Listenings.CallDate", "Tarih")
                                <i class="bi" data-bind="css: getSortIcon('callDate')"></i>
                            </th>
                            <th>@Html.T("Listenings.CallTime", "Saat")</th>
                            <th class="sortable" data-bind="click: function() { toggleSort('duration'); }">
                                @Html.T("Listenings.Duration", "Süre")
                                <i class="bi" data-bind="css: getSortIcon('duration')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { toggleSort('scorePercentage'); }">
                                @Html.T("Listenings.Score", "Puan")
                                <i class="bi" data-bind="css: getSortIcon('scorePercentage')"></i>
                            </th>
                            <th>@Html.T("Listenings.Cards", "Kartlar")</th>
                            <th class="sortable" data-bind="click: function() { toggleSort('status'); }">
                                @Html.T("Common.Status", "Durum")
                                <i class="bi" data-bind="css: getSortIcon('status')"></i>
                            </th>
                            <th>@Html.T("Common.Actions", "İşlemler")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: evaluations">
                        <tr>
                            <td>
                                <span class="fw-semibold" data-bind="text: projectName"></span>
                                <br><small class="text-muted" data-bind="text: checklistName"></small>
                            </td>
                            <td><span class="badge bg-info" data-bind="text: $parent.formatPeriod(periodName, callDate)"></span></td>
                            <td data-bind="text: evaluatedPersonnelName || dealerName || '-'"></td>
                            <td data-bind="text: supervisorName || '-'"></td>
                            <td>
                                <!-- ko if: callId -->
                                <code data-bind="text: callId.length > 20 ? callId.substring(0, 8) + '...' + callId.substring(callId.length - 8) : callId, attr: { title: callId }" style="cursor: help;"></code>
                                <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-secondary" data-bind="click: function() { var t = callId; (navigator.clipboard && window.isSecureContext) ? navigator.clipboard.writeText(t).then(function() { toastr.success('Panoya kopyalandı'); }).catch(function() { var a = document.createElement('textarea'); a.value = t; document.body.appendChild(a); a.select(); document.execCommand('copy'); document.body.removeChild(a); toastr.success('Panoya kopyalandı'); }) : (function() { var a = document.createElement('textarea'); a.value = t; document.body.appendChild(a); a.select(); document.execCommand('copy'); document.body.removeChild(a); toastr.success('Panoya kopyalandı'); })(); }" title="@Html.T("Common.Copy", "Kopyala")">
                                    <i class="bi bi-clipboard" style="font-size: 0.75rem;"></i>
                                </button>
                                <!-- /ko -->
                                <!-- ko ifnot: callId --><span>-</span><!-- /ko -->
                            </td>
                            <td data-bind="text: evaluatorName || '-'"></td>
                            <td data-bind="text: $parent.formatDate(callDate)"></td>
                            <td data-bind="text: $parent.formatTime(callTime) || '-'"></td>
                            <td data-bind="text: duration ? duration + ' dk' : '-'"></td>
                            <td>
                                <span class="badge fs-6" data-bind="text: scorePercentage != null ? scorePercentage.toFixed(2) + '%' : '-', css: $parent.getScoreClass(scorePercentage)"></span>
                            </td>
                            <td>
                                <!-- ko if: yellowCardCount > 0 -->
                                <span class="badge bg-warning text-dark me-1" data-bind="text: yellowCardCount" title="Sarı Kart"></span>
                                <!-- /ko -->
                                <!-- ko if: redCardCount > 0 -->
                                <span class="badge bg-danger" data-bind="text: redCardCount" title="Kırmızı Kart"></span>
                                <!-- /ko -->
                                <!-- ko if: yellowCardCount === 0 && redCardCount === 0 -->
                                <span class="text-muted">-</span>
                                <!-- /ko -->
                            </td>
                            <td>
                                <span class="badge" data-bind="text: $parent.getStatusText(status), css: $parent.getStatusClass(status)"></span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary" data-bind="click: $parent.viewDetail" title="@Html.T("Common.Detail", "Detay")">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="btn btn-outline-secondary" data-bind="click: $parent.showAttachments" title="@Html.T("Evaluation.Attachments", "Dosyalar")">
                                        <i class="bi bi-paperclip"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        <div data-bind="visible: totalPages() > 1" class="d-flex align-items-center gap-3 mt-3">
            <nav>
                <ul class="pagination mb-0">
                    <li class="page-item" data-bind="css: { disabled: page() <= 1 }">
                        <a class="page-link" href="#" data-bind="click: prevPage"><i class="bi bi-chevron-left"></i></a>
                    </li>
                    <!-- ko foreach: visiblePages -->
                    <li class="page-item" data-bind="css: { active: $data === $parent.page() }">
                        <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                    </li>
                    <!-- /ko -->
                    <li class="page-item" data-bind="css: { disabled: page() >= totalPages() }">
                        <a class="page-link" href="#" data-bind="click: nextPage"><i class="bi bi-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

    <!-- Detail Modal -->
    <div class="modal fade" data-bind="css: { show: showDetailModal }, style: { display: showDetailModal() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content" data-bind="with: selectedEvaluation">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-clipboard-check"></i>
                        <span data-bind="text: checklistName || '@Html.T("Listenings.Detail", "Dinleme Detayı")'"></span>
                    </h5>
                    <div>
                        <button type="button" class="btn btn-light btn-sm me-2" data-bind="click: $parent.exportDetailToExcel, disable: $parent.isExporting">
                            <i class="bi bi-file-earmark-excel"></i> @Html.T("Common.ExportExcel", "Excel")
                        </button>
                        <button type="button" class="btn-close btn-close-white" data-bind="click: $parent.closeDetailModal"></button>
                    </div>
                </div>
                <div class="modal-body">
                    <!-- Loading -->
                    <div data-bind="visible: $parent.isLoadingDetail" class="text-center py-4">
                        <div class="spinner-border text-primary"></div>
                    </div>

                    <!-- Content -->
                    <div data-bind="visible: !$parent.isLoadingDetail()">
                        <!-- Summary Cards -->
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h2 class="mb-0" data-bind="text: (scorePercentage || 0).toFixed(2) + '%', css: scorePercentage >= 70 ? 'text-success' : (scorePercentage >= 50 ? 'text-warning' : 'text-danger')"></h2>
                                        <small class="text-muted">@Html.T("Report.TotalScore", "Toplam Puan")</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h2 class="mb-0 text-primary" data-bind="text: (totalScore || 0).toFixed(1) + ' / ' + (maxScore || 0).toFixed(1)"></h2>
                                        <small class="text-muted">@Html.T("Evaluation.RawScore", "Ham Puan")</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center bg-warning">
                                    <div class="card-body">
                                        <h2 class="mb-0" data-bind="text: yellowCardCount || 0"></h2>
                                        <small>@Html.T("Report.Yellow", "Sarı Kart")</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center bg-danger text-white">
                                    <div class="card-body">
                                        <h2 class="mb-0" data-bind="text: redCardCount || 0"></h2>
                                        <small>@Html.T("Report.Red", "Kırmızı Kart")</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Info Cards -->
                        <div class="row mb-4">
                            <div class="col-md-4">
                                <div class="card h-100">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0"><i class="bi bi-building"></i> @Html.T("Evaluation.EvaluatedInfo", "Değerlendirilen Bilgileri")</h6>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr>
                                                <th style="width: 40%;">@Html.T("Common.Customer", "Firma")</th>
                                                <td data-bind="text: customerName || '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Common.Organization", "Organizasyon")</th>
                                                <td data-bind="text: organizationName || '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Report.Evaluated", "Değerlendirilen")</th>
                                                <td data-bind="text: evaluatedPersonnelName || dealerName || '-'"></td>
                                            </tr>
                                            <!-- ko if: supervisorName -->
                                            <tr>
                                                <th>@Html.T("Evaluation.Supervisor", "Müşteri Yöneticisi")</th>
                                                <td data-bind="text: supervisorName"></td>
                                            </tr>
                                            <!-- /ko -->
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card h-100">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0"><i class="bi bi-telephone"></i> @Html.T("Call.CallInfo", "Çağrı Bilgileri")</h6>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr>
                                                <th style="width: 40%;">@Html.T("Common.CallId", "Çağrı ID")</th>
                                                <td>
                                                    <!-- ko if: callId -->
                                                    <code data-bind="text: callId.length > 20 ? callId.substring(0, 8) + '...' + callId.substring(callId.length - 8) : callId, attr: { title: callId }" style="cursor: help;"></code>
                                                    <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-secondary" data-bind="click: function() { var t = callId; (navigator.clipboard && window.isSecureContext) ? navigator.clipboard.writeText(t).then(function() { toastr.success('Panoya kopyalandı'); }).catch(function() { var a = document.createElement('textarea'); a.value = t; document.body.appendChild(a); a.select(); document.execCommand('copy'); document.body.removeChild(a); toastr.success('Panoya kopyalandı'); }) : (function() { var a = document.createElement('textarea'); a.value = t; document.body.appendChild(a); a.select(); document.execCommand('copy'); document.body.removeChild(a); toastr.success('Panoya kopyalandı'); })(); }" title="@Html.T("Common.Copy", "Kopyala")">
                                                        <i class="bi bi-clipboard" style="font-size: 0.75rem;"></i>
                                                    </button>
                                                    <!-- /ko -->
                                                    <!-- ko ifnot: callId --><span>-</span><!-- /ko -->
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Report.CallDate", "Çağrı Tarihi")</th>
                                                <td data-bind="text: callDate ? new Date(callDate).toLocaleDateString('tr-TR') : '-'"></td>
                                            </tr>
                                            <!-- ko if: callTime -->
                                            <tr>
                                                <th>@Html.T("Report.CallTime", "Çağrı Saati")</th>
                                                <td data-bind="text: callTime"></td>
                                            </tr>
                                            <!-- /ko -->
                                            <tr>
                                                <th>@Html.T("Evaluation.Duration", "Süre")</th>
                                                <td data-bind="text: duration || '-'"></td>
                                            </tr>
                                            <!-- ko if: controlTime -->
                                            <tr>
                                                <th>@Html.T("Evaluation.ControlTime", "Kontrol Saati")</th>
                                                <td data-bind="text: controlTime"></td>
                                            </tr>
                                            <!-- /ko -->
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card h-100">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0"><i class="bi bi-person"></i> @Html.T("Evaluation.EvaluationInfo", "Değerlendirme Bilgileri")</h6>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr>
                                                <th style="width: 40%;">@Html.T("Evaluation.Evaluator", "Değerlendiren")</th>
                                                <td data-bind="text: evaluatorName || '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Evaluation.CompletedAt", "Tamamlanma")</th>
                                                <td data-bind="text: completedAt ? new Date(completedAt).toLocaleString('tr-TR') : '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Common.Status", "Durum")</th>
                                                <td><span class="badge bg-success" data-bind="text: status"></span></td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Evaluation Comment -->
                        <div class="card mb-4" data-bind="visible: $data.evaluationComment">
                            <div class="card-header bg-info text-white">
                                <h6 class="mb-0"><i class="bi bi-chat-quote"></i> @Html.T("Evaluation.EvaluationComment", "Denetim Yorumu")</h6>
                            </div>
                            <div class="card-body">
                                <p class="mb-0" data-bind="text: $data.evaluationComment"></p>
                            </div>
                        </div>

                        <!-- Answers -->
                        <div class="card">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="bi bi-list-check"></i> @Html.T("Evaluation.Answers", "Verilen Cevaplar")</h6>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-sm table-striped table-hover mb-0" style="table-layout: fixed;">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 12%;">@Html.T("Evaluation.Group", "Grup")</th>
                                                <th style="width: 28%;">@Html.T("Report.Question", "Soru")</th>
                                                <th class="text-center" style="width: 10%;">@Html.T("Common.Answer", "Cevap")</th>
                                                <th class="text-center" style="width: 10%;">@Html.T("Excel.Weight", "Ağırlık")</th>
                                                <th class="text-center" style="width: 10%;">@Html.T("Evaluation.Earned", "Kazanılan")</th>
                                                <th style="width: 30%;">@Html.T("Evaluation.Notes", "Notlar")</th>
                                            </tr>
                                        </thead>
                                        <tbody data-bind="foreach: $data.answers || []">
                                            <tr data-bind="css: { 'table-warning': appliedPenaltyType === 'YellowCard', 'table-danger': appliedPenaltyType === 'RedCard' }">
                                                <td class="text-wrap" data-bind="text: groupName || '-'"></td>
                                                <td class="text-wrap">
                                                    <span data-bind="text: questionText"></span>
                                                </td>
                                                <td class="text-center">
                                                    <!-- ko if: givenPoints !== null && givenPoints !== undefined && maxPoints > 0 -->
                                                    <span class="badge bg-primary" data-bind="text: givenPoints + '/' + maxPoints"></span>
                                                    <!-- /ko -->
                                                    <!-- ko if: maxPoints <= 0 || (givenPoints === null && givenPoints === undefined) -->
                                                    <span class="text-muted">-</span>
                                                    <!-- /ko -->
                                                </td>
                                                <td class="text-center">
                                                    <!-- ko if: maxPoints > 0 -->
                                                    <span data-bind="text: maxPoints"></span>
                                                    <!-- /ko -->
                                                    <!-- ko ifnot: maxPoints > 0 -->
                                                    <span class="text-muted">-</span>
                                                    <!-- /ko -->
                                                </td>
                                                <td class="text-center">
                                                    <!-- ko if: maxPoints > 0 -->
                                                    <span class="text-success" data-bind="text: (givenPoints || 0).toFixed(1)"></span>
                                                    <!-- /ko -->
                                                    <!-- ko ifnot: maxPoints > 0 -->
                                                    <span class="text-muted">-</span>
                                                    <!-- /ko -->
                                                </td>
                                                <td class="text-wrap">
                                                    <span data-bind="text: notes || '-'"></span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Notlar -->
                        <div class="card mt-3" data-bind="visible: $data.notes">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="bi bi-chat-square-text"></i> @Html.T("Evaluation.Notes", "Notlar")</h6>
                            </div>
                            <div class="card-body">
                                <p class="mb-0" data-bind="text: $data.notes"></p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closeDetailModal">
                        @Html.T("Common.Close", "Kapat")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showDetailModal }, style: { display: showDetailModal() ? 'block' : 'none' }"></div>

    <!-- Save Filter Modal -->
    <div class="modal fade" data-bind="css: { show: showSaveFilterModal }, style: { display: showSaveFilterModal() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-bookmark-plus me-2"></i>Sorguyu Kaydet
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bind="click: closeSaveFilterModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Filtre Adı <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" data-bind="value: saveFilterName" placeholder="Örn: Ocak Ayı Raporları" maxlength="100">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Açıklama (Opsiyonel)</label>
                        <textarea class="form-control" rows="2" data-bind="value: saveFilterDescription" placeholder="Bu filtrenin ne için kullanıldığını açıklayın..." maxlength="500"></textarea>
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="saveFilterIsDefault" data-bind="checked: saveFilterIsDefault">
                        <label class="form-check-label" for="saveFilterIsDefault">Varsayılan filtre olarak ayarla</label>
                        <small class="form-text text-muted d-block">Sayfa açıldığında bu filtre otomatik uygulanacak</small>
                    </div>
                    <hr>
                    <div class="mb-0">
                        <label class="form-label">Seçilen Filtreler:</label>
                        <ul class="list-group list-group-flush">
                            <!-- ko foreach: getFilterSummary() -->
                            <li class="list-group-item py-1 px-0"><i class="bi bi-check-circle text-success me-2"></i><span data-bind="text: $data"></span></li>
                            <!-- /ko -->
                        </ul>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeSaveFilterModal">İptal</button>
                    <button type="button" class="btn btn-primary" data-bind="click: saveFilter, disable: isSavingFilter">
                        <span data-bind="visible: !isSavingFilter()"><i class="bi bi-bookmark-check me-1"></i>Kaydet</span>
                        <span data-bind="visible: isSavingFilter"><span class="spinner-border spinner-border-sm"></span> Kaydediliyor...</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showSaveFilterModal }, style: { display: showSaveFilterModal() ? 'block' : 'none' }"></div>

    <!-- Load Filter Modal -->
    <div class="modal fade" data-bind="css: { show: showLoadFilterModal }, style: { display: showLoadFilterModal() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-bookmark me-2"></i>Kayıtlı Filtreler
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bind="click: closeLoadFilterModal"></button>
                </div>
                <div class="modal-body">
                    <!-- Search Box -->
                    <div class="mb-3" data-bind="visible: savedFilters().length > 0">
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" placeholder="Filtre ara..."
                                   data-bind="value: savedFilterSearch, valueUpdate: 'afterkeydown'">
                            <button class="btn btn-outline-secondary" type="button" data-bind="click: function() { savedFilterSearch(''); }, visible: savedFilterSearch()">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Loading -->
                    <div data-bind="visible: isLoadingFilters" class="text-center py-4">
                        <div class="spinner-border text-primary"></div>
                    </div>

                    <!-- Empty State -->
                    <div data-bind="visible: !isLoadingFilters() && savedFilters().length === 0" class="text-center py-4">
                        <i class="bi bi-bookmark text-muted" style="font-size: 3rem;"></i>
                        <p class="text-muted mt-2">Henüz kayıtlı filtre yok.</p>
                        <p class="text-muted small">Filtreleri kaydederek hızlıca tekrar kullanabilirsiniz.</p>
                    </div>

                    <!-- No Search Results -->
                    <div data-bind="visible: !isLoadingFilters() && savedFilters().length > 0 && filteredSavedFilters().length === 0" class="text-center py-4">
                        <i class="bi bi-search text-muted" style="font-size: 2rem;"></i>
                        <p class="text-muted mt-2">Aramayla eşleşen filtre bulunamadı.</p>
                    </div>

                    <!-- Filter List -->
                    <div data-bind="visible: !isLoadingFilters() && filteredSavedFilters().length > 0">
                        <div class="list-group">
                            <!-- ko foreach: filteredSavedFilters -->
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">
                                            <span data-bind="text: name"></span>
                                            <!-- ko if: isDefault() -->
                                            <span class="badge bg-warning text-dark ms-2"><i class="bi bi-pin-angle-fill"></i> Varsayılan</span>
                                            <!-- /ko -->
                                        </h6>
                                        <!-- ko if: description -->
                                        <p class="mb-1 text-muted small" data-bind="text: description"></p>
                                        <!-- /ko -->
                                        <small class="text-muted" data-bind="text: 'Oluşturulma: ' + new Date(createdAt).toLocaleDateString('tr-TR')"></small>
                                    </div>
                                    <div class="d-flex gap-1 align-items-center">
                                        <button class="btn btn-sm btn-primary" data-bind="click: $parent.applySavedFilter" title="Uygula">
                                            <i class="bi bi-play-fill"></i> Uygula
                                        </button>
                                        <!-- ko if: !isDefault() -->
                                        <button class="btn btn-sm btn-outline-secondary" data-bind="click: $parent.setFilterAsDefault" title="Varsayılan Yap">
                                            <i class="bi bi-pin-angle"></i>
                                        </button>
                                        <!-- /ko -->
                                        <!-- ko if: isDefault() -->
                                        <button class="btn btn-sm btn-warning" data-bind="click: $parent.clearFilterDefault" title="Varsayılanı Kaldır">
                                            <i class="bi bi-pin-angle-fill"></i>
                                        </button>
                                        <!-- /ko -->
                                        <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deleteSavedFilter" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeLoadFilterModal">@Html.T("Common.Close", "Kapat")</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showLoadFilterModal }, style: { display: showLoadFilterModal() ? 'block' : 'none' }"></div>

    <!-- Reports Modal -->
    <div class="modal fade" data-bind="css: { show: showReportsModal }, style: { display: showReportsModal() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-file-earmark-spreadsheet me-2"></i>@Html.T("Common.Reports", "Raporlar")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bind="click: closeReportsModal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted mb-3">@Html.T("Listenings.ReportsDescription", "Mevcut filtrelere göre rapor oluşturun.")</p>

                    <div class="list-group">
                        <!-- Çağrı Denetleme Raporu -->
                        <button type="button" class="list-group-item list-group-item-action d-flex align-items-center"
                                data-bind="click: exportCallAuditReport, disable: isExporting">
                            <div class="me-3">
                                <i class="bi bi-telephone fs-4 text-primary"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-0">@Html.T("Report.Sheet.CallAudit", "Çağrı Denetleme Raporu")</h6>
                                <small class="text-muted">@Html.T("Listenings.Report.CallAuditDesc", "Proje, değerlendiren, temsilci, çağrı no, tarih, süre, yorum ve puan bilgileri")</small>
                            </div>
                            <div>
                                <span class="badge bg-success"><i class="bi bi-file-earmark-excel"></i> Excel</span>
                            </div>
                        </button>

                        @* Genel Excel Export - Pasif (içerik değişecek)
                        <button type="button" class="list-group-item list-group-item-action d-flex align-items-center"
                                data-bind="click: exportToExcel, disable: isExporting">
                            <div class="me-3">
                                <i class="bi bi-table fs-4 text-success"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-0">@Html.T("Listenings.Report.GeneralExcel", "Genel Excel Export")</h6>
                                <small class="text-muted">@Html.T("Listenings.Report.GeneralExcelDesc", "Tüm dinleme kayıtlarının özet bilgileri")</small>
                            </div>
                            <div>
                                <span class="badge bg-success"><i class="bi bi-file-earmark-excel"></i> Excel</span>
                            </div>
                        </button>
                        *@

                        @* Detaylı Excel Export - Pasif (içerik değişecek)
                        <button type="button" class="list-group-item list-group-item-action d-flex align-items-center"
                                data-bind="click: exportDetailedToExcel, disable: isExporting">
                            <div class="me-3">
                                <i class="bi bi-list-columns-reverse fs-4 text-info"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-0">@Html.T("Listenings.Report.DetailedExcel", "Detaylı Excel (Soru-Cevaplar)")</h6>
                                <small class="text-muted">@Html.T("Listenings.Report.DetailedExcelDesc", "Tüm soru ve cevapları içeren detaylı rapor")</small>
                            </div>
                            <div>
                                <span class="badge bg-success"><i class="bi bi-file-earmark-excel"></i> Excel</span>
                            </div>
                        </button>
                        *@

                        <!-- Soru Grubu Ortalama Raporu -->
                        <button type="button" class="list-group-item list-group-item-action d-flex align-items-center"
                                data-bind="click: exportQuestionGroupAverageReport, disable: isExporting">
                            <div class="me-3">
                                <i class="bi bi-bar-chart-steps fs-4 text-warning"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-0">@Html.T("Report.QuestionGroupAverage", "Soru Grubu Ortalama Raporu")</h6>
                                <small class="text-muted">@Html.T("Listenings.Report.QuestionGroupAverageDesc", "Proje, dönem ve soru grubu bazında ortalama puanlar")</small>
                            </div>
                            <div>
                                <span class="badge bg-success"><i class="bi bi-file-earmark-excel"></i> Excel</span>
                            </div>
                        </button>

                        <!-- Müşteri Değerlendirme Raporu -->
                        <button type="button" class="list-group-item list-group-item-action d-flex align-items-center"
                                data-bind="click: exportCustomerEvaluationReport, disable: isExporting">
                            <div class="me-3">
                                <i class="bi bi-building fs-4 text-danger"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-0">@Html.T("Report.CustomerEvaluation", "Müşteri Değerlendirme Raporu")</h6>
                                <small class="text-muted">@Html.T("Listenings.Report.CustomerEvaluationDesc", "Firma, departman, kişi ve tüm değerlendirme detayları")</small>
                            </div>
                            <div>
                                <span class="badge bg-success"><i class="bi bi-file-earmark-excel"></i> Excel</span>
                            </div>
                        </button>

                        <!-- Proje Performans Raporu -->
                        <button type="button" class="list-group-item list-group-item-action d-flex align-items-center"
                                data-bind="click: exportProjectPerformanceReport, disable: isExporting">
                            <div class="me-3">
                                <i class="bi bi-graph-up-arrow fs-4 text-success"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-0">@Html.T("Report.ProjectPerformance", "Proje Performans Raporu")</h6>
                                <small class="text-muted">@Html.T("Listenings.Report.ProjectPerformanceDesc", "Dönem bazında proje ortalama puanları ve sıralaması")</small>
                            </div>
                            <div>
                                <span class="badge bg-success"><i class="bi bi-file-earmark-excel"></i> Excel</span>
                            </div>
                        </button>

                        <!-- MT Raporu -->
                        <button type="button" class="list-group-item list-group-item-action d-flex align-items-center"
                                data-bind="click: exportMTReport, disable: isExporting">
                            <div class="me-3">
                                <i class="bi bi-file-earmark-bar-graph fs-4 text-info"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-0">@Html.T("Listenings.Report.MT", "MT Raporu")</h6>
                                <small class="text-muted">@Html.T("Listenings.Report.MTDesc", "Başarı, gelişim alanı, süreç analizi ve endeks başarı (4 sheet)")</small>
                            </div>
                            <div>
                                <span class="badge bg-success"><i class="bi bi-file-earmark-excel"></i> Excel</span>
                            </div>
                        </button>
                    </div>

                    <!-- Aktif Filtreler Özeti -->
                    <div class="mt-3" data-bind="visible: activeFilters().length > 0">
                        <small class="text-muted"><i class="bi bi-funnel me-1"></i>@Html.T("Listenings.ActiveFiltersNote", "Aktif filtreler rapora uygulanacaktır:"):</small>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            <!-- ko foreach: activeFilters -->
                            <span class="badge bg-secondary" data-bind="text: label + ': ' + displayValue"></span>
                            <!-- /ko -->
                        </div>
                    </div>

                    <!-- Export işlemi sırasında gösterilecek -->
                    <div data-bind="visible: isExporting" class="text-center mt-3">
                        <div class="spinner-border text-success"></div>
                        <p class="mb-0 mt-2">@Html.T("Report.Downloading", "Rapor indiriliyor...")</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeReportsModal">@Html.T("Common.Close", "Kapat")</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showReportsModal }, style: { display: showReportsModal() ? 'block' : 'none' }"></div>

    <!-- Attachments Modal -->
    <div class="modal fade" data-bind="css: { show: isAttachmentsModalOpen }, style: { display: isAttachmentsModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-secondary text-white">
                    <h5 class="modal-title"><i class="bi bi-paperclip me-2"></i>@Html.T("Evaluation.Attachments", "Ekli Dosyalar")</h5>
                    <button type="button" class="btn-close btn-close-white" data-bind="click: closeAttachmentsModal"></button>
                </div>
                <div class="modal-body">
                    <!-- Loading -->
                    <div data-bind="visible: isAttachmentsLoading" class="text-center py-4">
                        <div class="spinner-border text-secondary"></div>
                    </div>
                    <!-- Empty -->
                    <div data-bind="visible: !isAttachmentsLoading() && attachments().length === 0" class="text-center py-4">
                        <i class="bi bi-folder2-open text-muted fs-1"></i>
                        <p class="text-muted mt-2">@Html.T("Evaluation.NoAttachments", "Bu dinlemede ekli dosya bulunmuyor.")</p>
                    </div>
                    <!-- List -->
                    <div data-bind="visible: !isAttachmentsLoading() && attachments().length > 0" class="list-group">
                        <!-- ko foreach: attachments -->
                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" data-bind="click: $parent.downloadAttachment">
                            <div>
                                <i class="bi bi-file-earmark me-2"></i>
                                <span data-bind="text: fileName"></span>
                                <!-- ko if: fileSize -->
                                <small class="text-muted ms-2" data-bind="text: $parent.formatFileSize(fileSize)"></small>
                                <!-- /ko -->
                            </div>
                            <i class="bi bi-download"></i>
                        </a>
                        <!-- /ko -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeAttachmentsModal">@Html.T("Common.Close", "Kapat")</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isAttachmentsModalOpen }, style: { display: isAttachmentsModalOpen() ? 'block' : 'none' }"></div>
</div>

@section Scripts {
    <script src="~/js/Shared/app.config.js"></script>
    <script src="~/js/Shared/api.service.js"></script>
    <script src="~/js/Shared/enums.service.js"></script>
    <script src="~/js/Listenings/index.js"></script>
}
