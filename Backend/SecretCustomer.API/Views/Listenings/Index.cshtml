@{
    ViewData["Title"] = Html.T("Listenings.Title", "Dinlemeler");
}

<div id="listenings-app" class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-headphones me-2"></i>@Html.T("Listenings.Title", "Dinlemeler")</h2>
        <div>
            <button class="btn btn-outline-success" data-bind="click: exportToExcel, disable: isExporting">
                <span data-bind="visible: !isExporting()"><i class="bi bi-file-earmark-excel me-1"></i> Excel</span>
                <span data-bind="visible: isExporting"><span class="spinner-border spinner-border-sm"></span></span>
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">@Html.T("Common.Project", "Proje")</label>
                    <select class="form-select" data-bind="options: projects, optionsText: 'name', optionsValue: 'id', value: filter.projectId, optionsCaption: '@Html.T("Common.All", "Tümü")'"></select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Html.T("Common.StartDate", "Başlangıç")</label>
                    <input type="date" class="form-control" data-bind="value: filter.startDate" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Html.T("Common.EndDate", "Bitiş")</label>
                    <input type="date" class="form-control" data-bind="value: filter.endDate" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Html.T("Common.Status", "Durum")</label>
                    <select class="form-select" data-bind="value: filter.status">
                        <option value="">@Html.T("Common.All", "Tümü")</option>
                        <option value="Completed">@Html.T("Evaluation.Status.Completed", "Tamamlandı")</option>
                        <option value="InProgress">@Html.T("Evaluation.Status.InProgress", "Devam Ediyor")</option>
                        <option value="Draft">@Html.T("Evaluation.Status.Draft", "Taslak")</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button class="btn btn-primary" data-bind="click: search">
                        <i class="bi bi-search me-1"></i> @Html.T("Common.Search", "Ara")
                    </button>
                    <button class="btn btn-outline-secondary" data-bind="click: clearFilters">
                        <i class="bi bi-x-circle me-1"></i> @Html.T("Common.Clear", "Temizle")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Yükleniyor...")</p>
    </div>

    <!-- Results -->
    <div data-bind="visible: !isLoading()">
        <!-- Summary -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-muted">
                @Html.T("Common.TotalRecords", "Toplam"): <strong data-bind="text: totalCount"></strong> @Html.T("Common.Records", "kayıt")
            </span>
            <div class="d-flex align-items-center gap-2">
                <label class="form-label mb-0 me-2">@Html.T("Common.PageSize", "Sayfa Boyutu"):</label>
                <select class="form-select form-select-sm" style="width: auto;" data-bind="value: filter.pageSize, event: { change: search }">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: evaluations().length === 0" class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>@Html.T("Listenings.NoRecords", "Kayıt bulunamadı.")
        </div>

        <!-- Table -->
        <div data-bind="visible: evaluations().length > 0" class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="sortable" data-bind="click: function() { toggleSort('projectName'); }">
                                @Html.T("Common.Project", "Proje")
                                <i class="bi" data-bind="css: getSortIcon('projectName')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { toggleSort('periodName'); }">
                                @Html.T("Listenings.Period", "Dönem")
                                <i class="bi" data-bind="css: getSortIcon('periodName')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { toggleSort('evaluatedPersonnelName'); }">
                                @Html.T("Listenings.Personnel", "Temsilci")
                                <i class="bi" data-bind="css: getSortIcon('evaluatedPersonnelName')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { toggleSort('supervisorName'); }">
                                @Html.T("Listenings.Supervisor", "Yönetici")
                                <i class="bi" data-bind="css: getSortIcon('supervisorName')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { toggleSort('callId'); }">
                                @Html.T("Listenings.CallId", "Çağrı No")
                                <i class="bi" data-bind="css: getSortIcon('callId')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { toggleSort('evaluatorName'); }">
                                @Html.T("Listenings.Evaluator", "Değerlendiren")
                                <i class="bi" data-bind="css: getSortIcon('evaluatorName')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { toggleSort('callDate'); }">
                                @Html.T("Listenings.CallDate", "Tarih")
                                <i class="bi" data-bind="css: getSortIcon('callDate')"></i>
                            </th>
                            <th>@Html.T("Listenings.CallTime", "Saat")</th>
                            <th class="sortable" data-bind="click: function() { toggleSort('duration'); }">
                                @Html.T("Listenings.Duration", "Süre")
                                <i class="bi" data-bind="css: getSortIcon('duration')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { toggleSort('scorePercentage'); }">
                                @Html.T("Listenings.Score", "Puan")
                                <i class="bi" data-bind="css: getSortIcon('scorePercentage')"></i>
                            </th>
                            <th>@Html.T("Listenings.Cards", "Kartlar")</th>
                            <th class="sortable" data-bind="click: function() { toggleSort('status'); }">
                                @Html.T("Common.Status", "Durum")
                                <i class="bi" data-bind="css: getSortIcon('status')"></i>
                            </th>
                            <th>@Html.T("Common.Actions", "İşlemler")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: evaluations">
                        <tr>
                            <td>
                                <span class="fw-semibold" data-bind="text: projectName"></span>
                                <br><small class="text-muted" data-bind="text: checklistName"></small>
                            </td>
                            <td><span class="badge bg-info" data-bind="text: periodName || '-'"></span></td>
                            <td data-bind="text: evaluatedPersonnelName || '-'"></td>
                            <td data-bind="text: supervisorName || '-'"></td>
                            <td><code data-bind="text: callId || '-'"></code></td>
                            <td data-bind="text: evaluatorName || '-'"></td>
                            <td data-bind="text: $parent.formatDate(callDate)"></td>
                            <td data-bind="text: $parent.formatTime(callTime) || '-'"></td>
                            <td data-bind="text: duration ? duration + ' dk' : '-'"></td>
                            <td>
                                <span class="badge fs-6" data-bind="text: scorePercentage != null ? scorePercentage.toFixed(1) + '%' : '-', css: $parent.getScoreClass(scorePercentage)"></span>
                            </td>
                            <td>
                                <!-- ko if: yellowCardCount > 0 -->
                                <span class="badge bg-warning text-dark me-1" data-bind="text: yellowCardCount" title="Sarı Kart"></span>
                                <!-- /ko -->
                                <!-- ko if: redCardCount > 0 -->
                                <span class="badge bg-danger" data-bind="text: redCardCount" title="Kırmızı Kart"></span>
                                <!-- /ko -->
                                <!-- ko if: yellowCardCount === 0 && redCardCount === 0 -->
                                <span class="text-muted">-</span>
                                <!-- /ko -->
                            </td>
                            <td>
                                <span class="badge" data-bind="text: $parent.getStatusText(status), css: $parent.getStatusClass(status)"></span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" data-bind="click: $parent.viewDetail" title="@Html.T("Common.Detail", "Detay")">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        <div data-bind="visible: totalPages() > 1" class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted">
                @Html.T("Common.Page", "Sayfa") <span data-bind="text: filter.page"></span> / <span data-bind="text: totalPages"></span>
            </div>
            <nav>
                <ul class="pagination mb-0">
                    <li class="page-item" data-bind="css: { disabled: filter.page() <= 1 }">
                        <a class="page-link" href="#" data-bind="click: prevPage"><i class="bi bi-chevron-left"></i></a>
                    </li>
                    <!-- ko foreach: visiblePages -->
                    <li class="page-item" data-bind="css: { active: $data === $parent.filter.page() }">
                        <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                    </li>
                    <!-- /ko -->
                    <li class="page-item" data-bind="css: { disabled: filter.page() >= totalPages() }">
                        <a class="page-link" href="#" data-bind="click: nextPage"><i class="bi bi-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

    <!-- Detail Modal -->
    <div class="modal fade" data-bind="css: { show: showDetailModal }, style: { display: showDetailModal() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content" data-bind="with: selectedEvaluation">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-clipboard-check"></i>
                        <span data-bind="text: checklistName || '@Html.T("Listenings.Detail", "Dinleme Detayı")'"></span>
                    </h5>
                    <div>
                        <button type="button" class="btn btn-light btn-sm me-2" onclick="window.print()">
                            <i class="bi bi-printer"></i> @Html.T("Common.Print", "Yazdır")
                        </button>
                        <button type="button" class="btn-close btn-close-white" data-bind="click: $parent.closeDetailModal"></button>
                    </div>
                </div>
                <div class="modal-body">
                    <!-- Loading -->
                    <div data-bind="visible: $parent.isLoadingDetail" class="text-center py-4">
                        <div class="spinner-border text-primary"></div>
                    </div>

                    <!-- Content -->
                    <div data-bind="visible: !$parent.isLoadingDetail()">
                        <!-- Summary Cards -->
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h2 class="mb-0" data-bind="text: (scorePercentage || 0).toFixed(1) + '%', css: scorePercentage >= 70 ? 'text-success' : (scorePercentage >= 50 ? 'text-warning' : 'text-danger')"></h2>
                                        <small class="text-muted">@Html.T("Evaluation.TotalScore", "Toplam Puan")</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h2 class="mb-0 text-primary" data-bind="text: (totalScore || 0).toFixed(1) + ' / ' + (maxScore || 0).toFixed(1)"></h2>
                                        <small class="text-muted">@Html.T("Evaluation.RawScore", "Ham Puan")</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center bg-warning">
                                    <div class="card-body">
                                        <h2 class="mb-0" data-bind="text: yellowCardCount || 0"></h2>
                                        <small>@Html.T("Evaluation.YellowCard", "Sarı Kart")</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center bg-danger text-white">
                                    <div class="card-body">
                                        <h2 class="mb-0" data-bind="text: redCardCount || 0"></h2>
                                        <small>@Html.T("Evaluation.RedCard", "Kırmızı Kart")</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Info Cards -->
                        <div class="row mb-4">
                            <div class="col-md-4">
                                <div class="card h-100">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0"><i class="bi bi-building"></i> @Html.T("Evaluation.EvaluatedInfo", "Değerlendirilen Bilgileri")</h6>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr>
                                                <th style="width: 40%;">@Html.T("Common.Customer", "Firma")</th>
                                                <td data-bind="text: customerName || '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Common.Organization", "Organizasyon")</th>
                                                <td data-bind="text: organizationName || '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Evaluation.Evaluated", "Değerlendirilen")</th>
                                                <td data-bind="text: evaluatedPersonnelName || '-'"></td>
                                            </tr>
                                            <!-- ko if: supervisorName -->
                                            <tr>
                                                <th>@Html.T("Evaluation.Supervisor", "Müşteri Yöneticisi")</th>
                                                <td data-bind="text: supervisorName"></td>
                                            </tr>
                                            <!-- /ko -->
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card h-100">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0"><i class="bi bi-telephone"></i> @Html.T("Evaluation.CallInfo", "Çağrı Bilgileri")</h6>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr>
                                                <th style="width: 40%;">@Html.T("Evaluation.CallId", "Çağrı ID")</th>
                                                <td data-bind="text: callId || '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Evaluation.CallDate", "Çağrı Tarihi")</th>
                                                <td data-bind="text: callDate ? new Date(callDate).toLocaleDateString('tr-TR') : '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Evaluation.Duration", "Süre")</th>
                                                <td data-bind="text: duration || '-'"></td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card h-100">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0"><i class="bi bi-person"></i> @Html.T("Evaluation.EvaluationInfo", "Değerlendirme Bilgileri")</h6>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr>
                                                <th style="width: 40%;">@Html.T("Evaluation.Evaluator", "Değerlendiren")</th>
                                                <td data-bind="text: evaluatorName || '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Evaluation.CompletedAt", "Tamamlanma")</th>
                                                <td data-bind="text: completedAt ? new Date(completedAt).toLocaleString('tr-TR') : '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Common.Status", "Durum")</th>
                                                <td><span class="badge bg-success" data-bind="text: status"></span></td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Evaluation Comment -->
                        <div class="card mb-4" data-bind="visible: comment">
                            <div class="card-header bg-info text-white">
                                <h6 class="mb-0"><i class="bi bi-chat-quote"></i> @Html.T("Evaluation.EvaluationComment", "Denetim Yorumu")</h6>
                            </div>
                            <div class="card-body">
                                <p class="mb-0" data-bind="text: comment"></p>
                            </div>
                        </div>

                        <!-- Answers -->
                        <div class="card">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="bi bi-list-check"></i> @Html.T("Evaluation.Answers", "Verilen Cevaplar")</h6>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-sm table-striped table-hover mb-0" style="table-layout: fixed;">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 15%;">@Html.T("Evaluation.Group", "Grup")</th>
                                                <th style="width: 40%;">@Html.T("Evaluation.Question", "Soru")</th>
                                                <th class="text-center" style="width: 15%;">@Html.T("Evaluation.Answer", "Cevap")</th>
                                                <th class="text-center" style="width: 15%;">@Html.T("Evaluation.Weight", "Ağırlık")</th>
                                                <th class="text-center" style="width: 15%;">@Html.T("Evaluation.Earned", "Kazanılan")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        <!-- ko foreach: $data.groups || [] -->
                                            <!-- ko foreach: questions -->
                                            <tr data-bind="css: { 'table-warning': penaltyType === 'YellowCard', 'table-danger': penaltyType === 'RedCard' }">
                                                <td class="text-wrap" data-bind="text: $parent.groupName"></td>
                                                <td class="text-wrap">
                                                    <span data-bind="text: questionText"></span>
                                                    <!-- ko if: selectedSubCriteria && selectedSubCriteria.length > 0 -->
                                                    <br><small class="text-warning"><i class="bi bi-exclamation-triangle"></i> <span data-bind="text: selectedSubCriteria.join(', ')"></span></small>
                                                    <!-- /ko -->
                                                    <!-- ko if: notes -->
                                                    <br><small class="text-muted"><i class="bi bi-chat-dots"></i> <span data-bind="text: notes"></span></small>
                                                    <!-- /ko -->
                                                </td>
                                                <td class="text-center">
                                                    <!-- ko if: givenPoints !== null && givenPoints !== undefined && maxPoints > 0 -->
                                                    <span class="badge bg-primary" data-bind="text: givenPoints + '/' + maxPoints"></span>
                                                    <!-- /ko -->
                                                    <!-- ko if: maxPoints <= 0 || (givenPoints === null && givenPoints === undefined) -->
                                                    <span class="text-muted">-</span>
                                                    <!-- /ko -->
                                                </td>
                                                <td class="text-center">
                                                    <!-- ko if: maxPoints > 0 -->
                                                    <span data-bind="text: maxPoints"></span>
                                                    <!-- /ko -->
                                                    <!-- ko ifnot: maxPoints > 0 -->
                                                    <span class="text-muted">-</span>
                                                    <!-- /ko -->
                                                </td>
                                                <td class="text-center">
                                                    <!-- ko if: maxPoints > 0 -->
                                                    <span class="text-success" data-bind="text: (givenPoints || 0).toFixed(1)"></span>
                                                    <!-- /ko -->
                                                    <!-- ko ifnot: maxPoints > 0 -->
                                                    <span class="text-muted">-</span>
                                                    <!-- /ko -->
                                                </td>
                                            </tr>
                                            <!-- /ko -->
                                        <!-- /ko -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closeDetailModal">
                        @Html.T("Common.Close", "Kapat")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showDetailModal }, style: { display: showDetailModal() ? 'block' : 'none' }"></div>
</div>

@section Scripts {
    <script src="~/js/Shared/app.config.js"></script>
    <script src="~/js/Shared/api.service.js"></script>
    <script src="~/js/Listenings/index.js"></script>
}
