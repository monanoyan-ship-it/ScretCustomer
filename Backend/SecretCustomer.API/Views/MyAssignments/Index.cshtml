@model IEnumerable<SecretCustomer.Core.DTOs.Assignment.AssignmentDto>
@{
    ViewData["Title"] = @Html.T("Menu.MyTasks", "Görevlerim");
    var fieldWorkerName = ViewData["FieldWorkerName"] as string ?? Html.T("Role.FieldWorker", "Saha Çalışanı").ToString();
}

<div class="container-fluid" id="myassignments-app">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>
                <i class="bi bi-list-check"></i> @Html.T("Menu.MyTasks", "Görevlerim")
            </h2>
            <p class="text-muted">@Html.T("Login.Welcome", "Hoş geldiniz"), <strong>@fieldWorkerName</strong></p>
        </div>
        <div>
            <span class="badge bg-primary fs-6">@Html.T("Common.Total", "Toplam"): @Model.Count()</span>
            <span class="badge bg-success fs-6">@Html.T("Status.Completed", "Tamamlanan"): @Model.Count(a => a.IsCompleted)</span>
            <span class="badge bg-warning fs-6">@Html.T("Status.Pending", "Bekleyen"): @Model.Count(a => !a.IsCompleted)</span>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> @Html.T("Assignment.NoTasks", "Henüz size atanmış bir görev bulunmuyor.")
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                var isExpired = !item.IsCompleted && item.DueDate < DateTime.UtcNow;
                var borderClass = item.IsCompleted ? "border-success" : (isExpired ? "border-warning" : "border-primary");
                var headerClass = item.IsCompleted ? "bg-success text-white" : (isExpired ? "bg-warning" : "bg-primary text-white");

                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm @borderClass">
                        <div class="card-header @headerClass">
                            <h5 class="mb-0">@item.ProjectName</h5>
                        </div>
                        <div class="card-body">
                            <h6 class="card-subtitle mb-2 text-muted">
                                <i class="bi bi-clipboard-check"></i> @item.ChecklistName
                            </h6>

                            <div class="mb-2">
                                <i class="bi bi-calendar-event"></i>
                                <strong>@Html.T("Assignment.DueDate", "Teslim Tarihi"):</strong> @item.DueDate.ToString("dd.MM.yyyy HH:mm")
                                @if (isExpired)
                                {
                                    <span class="badge bg-danger ms-2">@Html.T("Status.Overdue", "GECİKMİŞ")</span>
                                }
                            </div>

                            @if (item.IsCompleted)
                            {
                                <div class="mb-2 text-success">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <strong>@Html.T("Status.Completed", "Tamamlandı"):</strong> @item.CompletedAt?.ToString("dd.MM.yyyy HH:mm")
                                </div>
                            }
                            else
                            {
                                <div class="mb-2">
                                    <i class="bi bi-clock"></i>
                                    <strong>@Html.T("Common.Status", "Durum"):</strong>
                                    <span class="badge bg-warning">@Html.T("Status.Waiting", "Bekliyor")</span>
                                </div>
                            }
                        </div>
                        <div class="card-footer">
                            @if (!item.IsCompleted)
                            {
                                <a href="/Evaluation/Start/@item.UniqueLink" class="btn btn-primary btn-sm w-100">
                                    <i class="bi bi-play-circle"></i> @Html.T("Evaluation.StartEvaluation", "Değerlendirmeyi Başlat")
                                </a>
                            }
                            else
                            {
                                <a href="/Evaluation/View/@item.EvaluationId" class="btn btn-outline-secondary btn-sm w-100">
                                    <i class="bi bi-eye"></i> @Html.T("Evaluation.ViewEvaluation", "Değerlendirmeyi Görüntüle")
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

