@{
    ViewData["Title"] = "Değerlendirmelerim";
}

<h2 class="mb-4">Değerlendirmelerim</h2>

<!-- Evaluations List Component -->
<div id="evaluations-list-component">
    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>

    <!-- Error -->
    <div data-bind="visible: errorMessage" class="alert alert-danger alert-dismissible fade show">
        <span data-bind="text: errorMessage"></span>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>

    <!-- Evaluations -->
    <div data-bind="visible: !isLoading()">
        <!-- Empty State -->
        <div data-bind="visible: evaluations().length === 0" class="alert alert-info">
            <i class="bi bi-info-circle"></i> Henüz değerlendirme bulunmamaktadır.
        </div>

        <!-- Evaluations Grid -->
        <div class="row" data-bind="foreach: evaluations">
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm h-100" style="cursor: pointer;" data-bind="click: $parent.openEvaluation">
                    <div class="card-body">
                        <h5 class="card-title" data-bind="text: projectName || 'Proje'"></h5>
                        <p class="text-muted">
                            <i class="bi bi-building"></i> <span data-bind="text: branchName || 'N/A'"></span>
                        </p>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <span>Puan</span>
                                <strong>
                                    <span data-bind="text: (scorePercentage || 0).toFixed(1)"></span>%
                                </strong>
                            </div>
                            <div class="progress mt-2" style="height: 8px;">
                                <div class="progress-bar" data-bind="style: { width: (scorePercentage || 0) + '%' }, css: scorePercentage >= 70 ? 'bg-success' : (scorePercentage >= 50 ? 'bg-warning' : 'bg-danger')"></div>
                            </div>
                        </div>

                        <p class="text-muted small">
                            <i class="bi bi-calendar"></i>
                            <span data-bind="text: completedAt ? new Date(completedAt).toLocaleDateString('tr-TR') : 'Tarih yok'"></span>
                        </p>

                        <span class="badge" data-bind="css: status === 'Completed' ? 'bg-success' : 'bg-warning', text: status === 'Completed' ? 'Tamamlandı' : 'Bekliyor'"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Evaluation Modal -->
<div class="modal fade" id="evaluationModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Değerlendirme Formu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div data-bind="if: selectedEvaluation">
                    <p class="text-muted">Değerlendirme formu burada gösterilecek.</p>
                    <p>ID: <span data-bind="text: selectedEvaluation().id"></span></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Evaluations/Index.js"></script>
}
