@{
    ViewData["Title"] = Html.T("Evaluation.Title", "Çağrı Denetleme");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-clipboard-check"></i> @Html.T("Evaluation.Title", "Çağrı Denetleme")</h2>
</div>

<div id="evaluations-app">

    <!-- Loading State -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yükleniyor...")</span>
        </div>
    </div>

    <!-- Error State -->
    <div data-bind="visible: errorMessage" class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i>
        <span data-bind="text: errorMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { errorMessage(''); }"></button>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3" data-bind="visible: !isLoading()">
        <li class="nav-item">
            <a class="nav-link" data-bind="css: { active: activeTab() === 'assignments' }, click: function() { activeTab('assignments'); }" href="#">
                <i class="bi bi-clipboard-check"></i> @Html.T("Evaluation.Assignments", "Atamalar")
                <span class="badge bg-primary" data-bind="text: activeAssignments().length"></span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bind="css: { active: activeTab() === 'evaluations' }, click: function() { activeTab('evaluations'); }" href="#">
                <i class="bi bi-headphones"></i> @Html.T("Evaluation.ListeningsVisits", "Dinlemeler/Ziyaretler")
                <span class="badge bg-success" data-bind="text: allEvaluationsList().length"></span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bind="css: { active: activeTab() === 'expired' }, click: function() { activeTab('expired'); }" href="#">
                <i class="bi bi-calendar-x"></i> @Html.T("Evaluation.ExpiredAssignments", "Tarihi Geçmiş")
                <span class="badge bg-warning text-dark" data-bind="text: expiredAssignments().length"></span>
            </a>
        </li>
    </ul>

    <!-- Aktif Atamalar Tab -->
    <div data-bind="visible: activeTab() === 'assignments' && !isLoading()">
        <!-- Search -->
        <div class="mb-3">
            <div class="input-group" style="max-width: 400px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" data-bind="value: assignmentsSearch, valueUpdate: 'afterkeydown'" placeholder="@Html.T("Evaluation.SearchAssignments", "Proje veya kontrol listesi ara...")">
            </div>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: activeAssignments().length === 0" class="alert alert-info">
            <i class="bi bi-info-circle"></i> @Html.T("Evaluation.NoActiveAssignments", "Aktif atama bulunmamaktadır.")
        </div>

        <!-- Assignments Table -->
        <div class="card shadow-sm" data-bind="visible: activeAssignments().length > 0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Html.T("Common.Project", "Proje")</th>
                            <th>@Html.T("Common.Checklist", "Kontrol Listesi")</th>
                            <th>@Html.T("Evaluation.Assignee", "Atanan")</th>
                            <th>@Html.T("Common.DueDate", "Son Tarih")</th>
                            <th>@Html.T("Evaluation.EvaluationCount", "Dinleme")</th>
                            <th style="width: 150px;">@Html.T("Common.Actions", "İşlemler")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: activeAssignments">
                        <tr>
                            <td><strong data-bind="text: projectName"></strong></td>
                            <td data-bind="text: checklistName"></td>
                            <td data-bind="text: assigneeName || '-'"></td>
                            <td>
                                <span data-bind="text: dueDate ? new Date(dueDate).toLocaleDateString('tr-TR') : '-'"></span>
                                <!-- ko if: daysRemaining <= 3 && daysRemaining >= 0 -->
                                <span class="badge bg-warning text-dark ms-1" data-bind="text: daysRemaining + ' gün'"></span>
                                <!-- /ko -->
                            </td>
                            <td>
                                <span class="badge bg-secondary" data-bind="text: evaluationCount || 0"></span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-primary" data-bind="click: $parent.startEvaluation">
                                    <i class="bi bi-plus-circle"></i> @Html.T("Evaluation.AddListening", "Dinleme Ekle")
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Dinlemeler/Ziyaretler Tab -->
    <div data-bind="visible: activeTab() === 'evaluations' && !isLoading()">
        <!-- Search -->
        <div class="mb-3">
            <div class="input-group" style="max-width: 400px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" data-bind="value: evaluationsSearch, valueUpdate: 'afterkeydown'" placeholder="@Html.T("Evaluation.SearchEvaluations", "Proje, kontrol listesi veya personel ara...")">
            </div>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: allEvaluationsList().length === 0" class="alert alert-info">
            <i class="bi bi-info-circle"></i> @Html.T("Evaluation.NoEvaluations", "Henüz dinleme/ziyaret kaydı bulunmamaktadır.")
        </div>

        <!-- Evaluations Table -->
        <div class="card shadow-sm" data-bind="visible: allEvaluationsList().length > 0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Html.T("Common.Project", "Proje")</th>
                            <th>@Html.T("Common.Checklist", "Kontrol Listesi")</th>
                            <th>@Html.T("Evaluation.EvaluatedPerson", "Değerlendirilen")</th>
                            <th>@Html.T("Evaluation.Score", "Puan")</th>
                            <th>@Html.T("Evaluation.Penalty", "Ceza")</th>
                            <th>@Html.T("Common.Date", "Tarih")</th>
                            <th>@Html.T("Common.Status", "Durum")</th>
                            <th style="width: 150px;">@Html.T("Common.Actions", "İşlemler")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: allEvaluationsList">
                        <tr>
                            <td><strong data-bind="text: projectName"></strong></td>
                            <td data-bind="text: checklistName"></td>
                            <td data-bind="text: evaluatedPersonnelName || evaluatedUnknownPersonnel || '-'"></td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="progress flex-grow-1 me-2" style="height: 6px; width: 60px;">
                                        <div class="progress-bar" data-bind="style: { width: (scorePercentage || 0) + '%' }, css: scorePercentage >= 70 ? 'bg-success' : (scorePercentage >= 50 ? 'bg-warning' : 'bg-danger')"></div>
                                    </div>
                                    <span data-bind="text: (scorePercentage || 0).toFixed(1) + '%'"></span>
                                </div>
                            </td>
                            <td>
                                <!-- ko if: yellowCardCount > 0 -->
                                <span class="badge bg-warning text-dark me-1"><span data-bind="text: yellowCardCount"></span> S</span>
                                <!-- /ko -->
                                <!-- ko if: redCardCount > 0 -->
                                <span class="badge bg-danger"><span data-bind="text: redCardCount"></span> K</span>
                                <!-- /ko -->
                                <!-- ko if: !yellowCardCount && !redCardCount -->
                                <span class="text-muted">-</span>
                                <!-- /ko -->
                            </td>
                            <td data-bind="text: completedAt ? new Date(completedAt).toLocaleDateString('tr-TR') : (startedAt ? new Date(startedAt).toLocaleDateString('tr-TR') : '-')"></td>
                            <td>
                                <!-- ko if: status === 'Completed' -->
                                <span class="badge bg-success">@Html.T("Common.Status.Completed", "Tamamlandı")</span>
                                <!-- /ko -->
                                <!-- ko if: status === 'Draft' -->
                                <span class="badge bg-secondary">@Html.T("Common.Status.Draft", "Taslak")</span>
                                <!-- /ko -->
                                <!-- ko if: status === 'InProgress' -->
                                <span class="badge bg-info">@Html.T("Common.Status.InProgress", "Devam Ediyor")</span>
                                <!-- /ko -->
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary" data-bind="click: $parent.showDetails" title="@Html.T("Common.ViewDetails", "Detay")">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <!-- ko if: $parent.canEditEvaluation($data) -->
                                    <button class="btn btn-outline-warning" data-bind="click: $parent.continueEvaluation" title="@Html.T("Common.Edit", "Düzenle")">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <!-- /ko -->
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Tarihi Geçmiş Atamalar Tab -->
    <div data-bind="visible: activeTab() === 'expired' && !isLoading()">
        <!-- Search -->
        <div class="mb-3">
            <div class="input-group" style="max-width: 400px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" data-bind="value: expiredSearch, valueUpdate: 'afterkeydown'" placeholder="@Html.T("Evaluation.SearchExpired", "Proje veya kontrol listesi ara...")">
            </div>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: expiredAssignments().length === 0" class="alert alert-info">
            <i class="bi bi-info-circle"></i> @Html.T("Evaluation.NoExpiredAssignments", "Tarihi geçmiş atama bulunmamaktadır.")
        </div>

        <!-- Expired Assignments Table -->
        <div class="card shadow-sm" data-bind="visible: expiredAssignments().length > 0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-warning">
                        <tr>
                            <th>@Html.T("Common.Project", "Proje")</th>
                            <th>@Html.T("Common.Checklist", "Kontrol Listesi")</th>
                            <th>@Html.T("Evaluation.Assignee", "Atanan")</th>
                            <th>@Html.T("Common.DueDate", "Son Tarih")</th>
                            <th>@Html.T("Evaluation.Overdue", "Gecikme")</th>
                            <th>@Html.T("Evaluation.EvaluationCount", "Dinleme")</th>
                            <th style="width: 150px;">@Html.T("Common.Actions", "İşlemler")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: expiredAssignments">
                        <tr class="table-warning">
                            <td><strong data-bind="text: projectName"></strong></td>
                            <td data-bind="text: checklistName"></td>
                            <td data-bind="text: assigneeName || '-'"></td>
                            <td data-bind="text: dueDate ? new Date(dueDate).toLocaleDateString('tr-TR') : '-'"></td>
                            <td>
                                <span class="badge bg-danger" data-bind="text: Math.abs(daysRemaining) + ' gün'"></span>
                            </td>
                            <td>
                                <span class="badge bg-secondary" data-bind="text: evaluationCount || 0"></span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-warning" data-bind="click: $parent.startEvaluation">
                                    <i class="bi bi-plus-circle"></i> @Html.T("Evaluation.AddListening", "Dinleme Ekle")
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Details Modal -->
    <div class="modal fade" data-bind="css: { show: isDetailsModalOpen }, style: { display: isDetailsModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-clipboard-check"></i>
                        <!-- ko if: detailsData() -->
                        <span data-bind="text: detailsData().checklistName || '@Html.T("Evaluation.Details", "Değerlendirme Detayı")'"></span>
                        <!-- /ko -->
                    </h5>
                    <div>
                        <button type="button" class="btn btn-light btn-sm me-2" onclick="window.print()">
                            <i class="bi bi-printer"></i> @Html.T("Common.Print", "Yazdır")
                        </button>
                        <button type="button" class="btn-close btn-close-white" data-bind="click: closeDetailsModal"></button>
                    </div>
                </div>
                <div class="modal-body" data-bind="with: detailsData">
                    <!-- Loading -->
                    <div data-bind="visible: $parent.isDetailsLoading" class="text-center py-4">
                        <div class="spinner-border text-primary"></div>
                    </div>

                    <!-- Content -->
                    <div data-bind="visible: !$parent.isDetailsLoading()">
                        <!-- Summary Cards -->
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h2 class="mb-0" data-bind="text: (scorePercentage || 0).toFixed(1) + '%', css: scorePercentage >= 70 ? 'text-success' : (scorePercentage >= 50 ? 'text-warning' : 'text-danger')"></h2>
                                        <small class="text-muted">@Html.T("Evaluation.TotalScore", "Toplam Puan")</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h2 class="mb-0 text-primary" data-bind="text: (totalScore || 0).toFixed(1) + ' / ' + (maxScore || 0).toFixed(1)"></h2>
                                        <small class="text-muted">@Html.T("Evaluation.RawScore", "Ham Puan")</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center bg-warning">
                                    <div class="card-body">
                                        <h2 class="mb-0" data-bind="text: yellowCardCount || 0"></h2>
                                        <small>@Html.T("Evaluation.YellowCard", "Sarı Kart")</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center bg-danger text-white">
                                    <div class="card-body">
                                        <h2 class="mb-0" data-bind="text: redCardCount || 0"></h2>
                                        <small>@Html.T("Evaluation.RedCard", "Kırmızı Kart")</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Info Cards -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="card h-100">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0"><i class="bi bi-telephone"></i> @Html.T("Evaluation.CallInfo", "Çağrı Bilgileri")</h6>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr>
                                                <th style="width: 40%;">@Html.T("Evaluation.CallId", "Çağrı ID")</th>
                                                <td data-bind="text: callId || '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Evaluation.CallDate", "Çağrı Tarihi")</th>
                                                <td data-bind="text: callDate ? new Date(callDate).toLocaleDateString('tr-TR') : '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Evaluation.Duration", "Süre")</th>
                                                <td data-bind="text: duration || '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Evaluation.ControlTime", "Kontrol Saati")</th>
                                                <td data-bind="text: controlTime || '-'"></td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card h-100">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0"><i class="bi bi-person"></i> @Html.T("Evaluation.EvaluationInfo", "Değerlendirme Bilgileri")</h6>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr>
                                                <th style="width: 40%;">@Html.T("Evaluation.Evaluator", "Değerlendiren")</th>
                                                <td data-bind="text: evaluatorName || '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Evaluation.Evaluated", "Değerlendirilen")</th>
                                                <td data-bind="text: evaluatedPersonnelName || evaluatedUnknownPersonnel || '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Evaluation.CompletedAt", "Tamamlanma")</th>
                                                <td data-bind="text: completedAt ? new Date(completedAt).toLocaleString('tr-TR') : '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Common.Status", "Durum")</th>
                                                <td><span class="badge bg-success" data-bind="text: status"></span></td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Evaluation Comment -->
                        <div class="card mb-4" data-bind="visible: evaluationComment">
                            <div class="card-header bg-info text-white">
                                <h6 class="mb-0"><i class="bi bi-chat-quote"></i> @Html.T("Evaluation.EvaluationComment", "Denetim Yorumu")</h6>
                            </div>
                            <div class="card-body">
                                <p class="mb-0" data-bind="text: evaluationComment"></p>
                            </div>
                        </div>

                        <!-- Answers -->
                        <div class="card">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="bi bi-list-check"></i> @Html.T("Evaluation.Answers", "Cevaplar")</h6>
                            </div>
                            <div class="card-body p-0">
                                <table class="table table-striped mb-0">
                                    <thead>
                                        <tr>
                                            <th style="width: 5%;">#</th>
                                            <th style="width: 45%;">@Html.T("Evaluation.Question", "Soru")</th>
                                            <th style="width: 20%;">@Html.T("Evaluation.Answer", "Cevap")</th>
                                            <th style="width: 15%;">@Html.T("Evaluation.Score", "Puan")</th>
                                            <th style="width: 15%;">@Html.T("Common.Status", "Durum")</th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: answers">
                                        <tr>
                                            <td>
                                                <span data-bind="text: (sectionOrder || 1) + '.' + (questionOrder || 1)"></span>
                                            </td>
                                            <td>
                                                <strong data-bind="text: questionText"></strong>
                                                <!-- ko if: notes -->
                                                <br><small class="text-muted"><i class="bi bi-sticky"></i> <span data-bind="text: notes"></span></small>
                                                <!-- /ko -->
                                            </td>
                                            <td>
                                                <!-- ko if: isNA -->
                                                <span class="badge bg-secondary">N/A</span>
                                                <!-- /ko -->
                                                <!-- ko if: !isNA && answerNumeric -->
                                                <span class="badge bg-primary" data-bind="text: answerNumeric + '/5'"></span>
                                                <!-- /ko -->
                                                <!-- ko if: !isNA && answerText -->
                                                <span data-bind="text: answerText"></span>
                                                <!-- /ko -->
                                            </td>
                                            <td>
                                                <!-- ko if: !isNA -->
                                                <span data-bind="text: (givenPoints || earnedPoints || 0).toFixed(1)"></span>
                                                / <span data-bind="text: (maxPoints || 0).toFixed(1)"></span>
                                                <!-- /ko -->
                                            </td>
                                            <td>
                                                <!-- ko if: isPenaltyApplied -->
                                                <span class="badge" data-bind="css: appliedPenaltyType === 'YellowCard' ? 'bg-warning text-dark' : 'bg-danger', text: appliedPenaltyType === 'YellowCard' ? '@Html.T("Evaluation.YellowCard", "Sarı Kart")' : '@Html.T("Evaluation.RedCard", "Kırmızı Kart")'"></span>
                                                <!-- /ko -->
                                                <!-- ko if: !isPenaltyApplied && !isNA -->
                                                <i class="bi bi-check-circle text-success"></i>
                                                <!-- /ko -->
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeDetailsModal">
                        @Html.T("Common.Close", "Kapat")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="visible: isDetailsModalOpen, css: { show: isDetailsModalOpen }"></div>

    <!-- Evaluate Modal (Full Screen) -->
    <div class="modal fade" data-bind="css: { show: isEvaluateModalOpen }, style: { display: isEvaluateModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-clipboard-check"></i>
                        <!-- ko if: formData() -->
                        <span data-bind="text: formData().checklistName"></span>
                        <small data-bind="text: ' - ' + formData().projectName"></small>
                        <!-- ko if: formData().customerName -->
                        <span class="badge bg-light text-primary ms-2" data-bind="text: formData().customerName"></span>
                        <!-- /ko -->
                        <!-- /ko -->
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bind="click: closeEvaluateModal"></button>
                </div>
                <div class="modal-body" style="overflow-y: auto;">
                    <!-- Loading -->
                    <div data-bind="visible: isFormLoading" class="text-center py-5">
                        <div class="spinner-border text-primary"></div>
                        <p class="mt-2">@Html.T("Evaluation.FormLoading", "Form yükleniyor...")</p>
                    </div>

                    <!-- Error Message -->
                    <div data-bind="visible: modalErrorMessage" class="alert alert-danger alert-dismissible fade show">
                        <i class="bi bi-exclamation-triangle"></i>
                        <span data-bind="text: modalErrorMessage"></span>
                        <button type="button" class="btn-close" data-bind="click: function() { modalErrorMessage(''); }"></button>
                    </div>

                    <!-- Success Message -->
                    <div data-bind="visible: formSuccessMessage" class="alert alert-success alert-dismissible fade show">
                        <i class="bi bi-check-circle"></i>
                        <span data-bind="text: formSuccessMessage"></span>
                        <button type="button" class="btn-close" data-bind="click: function() { formSuccessMessage(''); }"></button>
                    </div>

                    <!-- Form Content -->
                    <div data-bind="visible: !isFormLoading() && formData()">
                        <div class="container-fluid">
                            <!-- Period & Call Info -->
                            <div class="row mb-4">
                                <!-- Dönem Seçimi -->
                                <div class="col-12 mb-3" data-bind="visible: availablePeriods().length > 0">
                                    <div class="card border-info">
                                        <div class="card-header bg-info text-white">
                                            <h6 class="mb-0"><i class="bi bi-calendar-range"></i> @Html.T("Evaluation.Period", "Dönem")</h6>
                                        </div>
                                        <div class="card-body py-2">
                                            <div class="row align-items-center">
                                                <div class="col-md-6">
                                                    <select class="form-select" data-bind="value: selectedPeriodId, options: availablePeriods, optionsText: function(p) { return p.name + ' (' + new Date(p.startDate).toLocaleDateString('tr-TR') + ' - ' + new Date(p.endDate).toLocaleDateString('tr-TR') + ')'; }, optionsValue: 'id', optionsCaption: '@Html.T("Evaluation.SelectPeriod", "-- Dönem Seçin --")'"></select>
                                                </div>
                                                <div class="col-md-6">
                                                    <!-- ko if: selectedPeriodId() -->
                                                    <!-- ko with: availablePeriods().find(function(p) { return p.id === selectedPeriodId(); }) -->
                                                    <div class="d-flex align-items-center gap-3">
                                                        <span class="badge" data-bind="css: status === 'Open' ? 'bg-success' : 'bg-secondary', text: status === 'Open' ? '@Html.T("Evaluation.PeriodOpen", "Aktif")' : '@Html.T("Evaluation.PeriodClosed", "Kapalı")'"></span>
                                                        <span class="text-muted">
                                                            @Html.T("Evaluation.Completed", "Tamamlanan"): <strong data-bind="text: completedCount"></strong> / <span data-bind="text: targetCount"></span>
                                                        </span>
                                                        <div class="progress flex-grow-1" style="height: 8px; max-width: 150px;">
                                                            <div class="progress-bar bg-success" data-bind="style: { width: (targetCount > 0 ? (completedCount / targetCount * 100) : 0) + '%' }"></div>
                                                        </div>
                                                    </div>
                                                    <!-- /ko -->
                                                    <!-- /ko -->
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Dönem yoksa uyarı -->
                                <div class="col-12 mb-3" data-bind="visible: availablePeriods().length === 0">
                                    <div class="alert alert-warning mb-0">
                                        <i class="bi bi-exclamation-triangle"></i>
                                        @Html.T("Evaluation.NoPeriodWarning", "Bu atama için tanımlı dönem bulunmuyor. Dönem seçimi yapılmadan dinleme kaydedilebilir.")
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card">
                                        <div class="card-header bg-light">
                                            <h6 class="mb-0"><i class="bi bi-telephone"></i> @Html.T("Evaluation.CallInfo", "Çağrı Bilgileri")</h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label class="form-label">@Html.T("Evaluation.CallId", "Çağrı ID")</label>
                                                    <input type="text" class="form-control" data-bind="value: callId" placeholder="@Html.T("Evaluation.CallIdPlaceholder", "Çağrı numarası")">
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">@Html.T("Evaluation.CallDate", "Çağrı Tarihi")</label>
                                                    <input type="date" class="form-control" data-bind="value: callDate">
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label">@Html.T("Evaluation.Duration", "Süre")</label>
                                                    <input type="time" step="1" class="form-control" data-bind="value: duration" placeholder="SS:DD:SN">
                                                </div>
                                                <!-- Kontrol Saati backend'de otomatik kaydedilir -->
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card">
                                        <div class="card-header bg-light">
                                            <h6 class="mb-0"><i class="bi bi-person"></i> @Html.T("Evaluation.EvaluatedPersonnel", "Değerlendirilen Personel")</h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="row g-3">
                                                <!-- Checklist Organizasyon Bilgisi -->
                                                <!-- ko if: formData() && formData().checklistOrganizationName -->
                                                <div class="col-12">
                                                    <div class="alert alert-info py-2 mb-2">
                                                        <i class="bi bi-building"></i>
                                                        <strong>@Html.T("Evaluation.Organization", "Organizasyon"):</strong>
                                                        <span data-bind="text: formData().checklistOrganizationName"></span>
                                                    </div>
                                                </div>
                                                <!-- /ko -->

                                                <!-- Personel Seçimi -->
                                                <div class="col-12">
                                                    <label class="form-label">@Html.T("Evaluation.SelectPersonnel", "Personel Seç")</label>
                                                    <div class="input-group">
                                                        <select class="form-select" data-bind="value: evaluatedPersonnelId, options: availablePersonnel, optionsText: 'name', optionsValue: 'id', optionsCaption: '@Html.T("Evaluation.SelectPersonnelPlaceholder", "-- Personel Seçin --")'"></select>
                                                        <!-- ko if: isLoadingPersonnel() -->
                                                        <span class="input-group-text">
                                                            <span class="spinner-border spinner-border-sm"></span>
                                                        </span>
                                                        <!-- /ko -->
                                                    </div>
                                                </div>
                                                <div class="col-12">
                                                    <label class="form-label">@Html.T("Evaluation.OrUnknownPersonnel", "veya Tanımsız Personel")</label>
                                                    <input type="text" class="form-control" data-bind="value: evaluatedUnknownPersonnel" placeholder="@Html.T("Evaluation.UnknownPersonnelPlaceholder", "Tanımsız personel adı")">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Score Summary (Sticky) -->
                            <div class="sticky-top bg-white py-2 mb-3" style="top: 0; z-index: 1020;">
                                <div class="card border-primary">
                                    <div class="card-body py-2">
                                        <div class="row align-items-center">
                                            <div class="col-auto">
                                                <h5 class="mb-0">
                                                    @Html.T("Evaluation.Score", "Puan"): <span class="text-primary" data-bind="text: totalScoreCalc().toFixed(1)"></span>
                                                    / <span data-bind="text: maxScoreCalc().toFixed(1)"></span>
                                                    (<span data-bind="text: scorePercentageCalc().toFixed(1)"></span>%)
                                                </h5>
                                            </div>
                                            <div class="col">
                                                <div class="progress" style="height: 20px;">
                                                    <div class="progress-bar" role="progressbar"
                                                         data-bind="style: { width: scorePercentageCalc() + '%' },
                                                                    css: scorePercentageCalc() >= 70 ? 'bg-success' : (scorePercentageCalc() >= 50 ? 'bg-warning' : 'bg-danger')">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-auto">
                                                <span class="badge bg-warning text-dark me-2" data-bind="visible: yellowCardCountCalc() > 0">
                                                    <i class="bi bi-card-fill"></i> <span data-bind="text: yellowCardCountCalc()"></span> @Html.T("Evaluation.Yellow", "Sarı")
                                                </span>
                                                <span class="badge bg-danger" data-bind="visible: redCardCountCalc() > 0">
                                                    <i class="bi bi-card-fill"></i> <span data-bind="text: redCardCountCalc()"></span> @Html.T("Evaluation.Red", "Kırmızı")
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Sections -->
                            <!-- ko if: formData() -->
                            <div data-bind="foreach: formData().sections">
                                <div class="card shadow-sm mb-4">
                                    <div class="card-header" data-bind="css: groupType === 'Penalty' ? 'bg-danger text-white' : (groupType === 'Unscored' ? 'bg-secondary text-white' : 'bg-light')">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h5 class="mb-0">
                                                <span data-bind="text: order"></span>.
                                                <span data-bind="text: name"></span>
                                                <!-- ko if: groupType === 'Penalty' -->
                                                <span class="badge bg-white text-danger ms-2">@Html.T("Evaluation.PenaltySection", "Cezalı Bölüm")</span>
                                                <!-- /ko -->
                                                <!-- ko if: groupType === 'Unscored' -->
                                                <span class="badge bg-white text-secondary ms-2">@Html.T("Evaluation.Unscored", "Puansız")</span>
                                                <!-- /ko -->
                                            </h5>
                                            <div>
                                                <small>
                                                    @Html.T("Evaluation.Weight", "Ağırlık"): <span data-bind="text: weightPoints"></span> |
                                                    @Html.T("Evaluation.Max", "Maks"): <span data-bind="text: maxPoints"></span> @Html.T("Evaluation.Points", "puan")
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <!-- Questions -->
                                        <div data-bind="foreach: questions">
                                            <div class="border rounded p-3 mb-3" data-bind="css: { 'border-danger': penaltyType !== 'None', 'border-warning': $parent.groupType === 'Unscored' }">
                                                <div class="row">
                                                    <div class="col-md-8">
                                                        <!-- Question Header -->
                                                        <div class="d-flex align-items-start mb-2">
                                                            <span class="badge bg-secondary me-2" data-bind="text: $parent.order + '.' + order"></span>
                                                            <div class="flex-grow-1">
                                                                <strong data-bind="text: text"></strong>
                                                                <!-- ko if: helpText -->
                                                                <button type="button" class="btn btn-sm btn-link p-0 ms-1" data-bs-toggle="tooltip" data-bind="attr: { title: helpText }">
                                                                    <i class="bi bi-question-circle"></i>
                                                                </button>
                                                                <!-- /ko -->
                                                                <div class="mt-1">
                                                                    <!-- ko if: scoringType === 'Scored' -->
                                                                    <span class="badge bg-primary">@Html.T("Evaluation.Scored", "Puanlı")</span>
                                                                    <!-- /ko -->
                                                                    <!-- ko if: scoringType === 'Unscored' -->
                                                                    <span class="badge bg-secondary">@Html.T("Evaluation.Unscored", "Puansız")</span>
                                                                    <!-- /ko -->
                                                                    <!-- ko if: scoringType === 'Penalty' -->
                                                                    <span class="badge bg-danger">@Html.T("Evaluation.Penalty", "Cezalı")</span>
                                                                    <!-- /ko -->
                                                                    <!-- ko if: penaltyType === 'YellowCard' -->
                                                                    <span class="badge bg-warning text-dark">@Html.T("Evaluation.YellowCard", "Sarı Kart") (<span data-bind="text: weightPoints"></span> @Html.T("Evaluation.Points", "puan"))</span>
                                                                    <!-- /ko -->
                                                                    <!-- ko if: penaltyType === 'RedCard' -->
                                                                    <span class="badge bg-danger">@Html.T("Evaluation.RedCard", "Kırmızı Kart") (<span data-bind="text: weightPoints"></span> @Html.T("Evaluation.Points", "puan"))</span>
                                                                    <!-- /ko -->
                                                                    <!-- ko if: isRequired -->
                                                                    <span class="badge bg-info">@Html.T("Common.Required", "Zorunlu")</span>
                                                                    <!-- /ko -->
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Answer Input -->
                                                        <div class="mt-2" data-bind="with: $root.getAnswer(id)">
                                                            <!-- Puanlı ve Cezalı sorular için Likert butonları (scoringType = Scored veya Penalty) -->
                                                            <!-- ko if: ($parent.scoringType === 'Scored' || $parent.scoringType === 'Penalty') && $parent.maxPoints !== 1 -->
                                                            <div class="btn-group btn-group-sm" role="group">
                                                                <!-- ko foreach: $root.getScoreOptions($parent.maxPoints) -->
                                                                <button type="button" class="btn"
                                                                        data-bind="click: function() { $parent.answerNumeric($parent.answerNumeric() === $data ? null : $data); },
                                                                                   css: $parent.answerNumeric() === $data ? 'btn-primary' : 'btn-outline-primary',
                                                                                   text: $data">
                                                                </button>
                                                                <!-- /ko -->
                                                            </div>
                                                            <!-- /ko -->

                                                            <!-- Max puanı 1 olanlar için Evet/Hayır butonları -->
                                                            <!-- ko if: ($parent.scoringType === 'Scored' || $parent.scoringType === 'Penalty') && $parent.maxPoints === 1 -->
                                                            <div class="btn-group" role="group">
                                                                <button type="button" class="btn"
                                                                        data-bind="click: function() { answerNumeric(1); },
                                                                                   css: answerNumeric() === 1 ? 'btn-success' : 'btn-outline-success'">
                                                                    @Html.T("Common.Yes", "Evet")
                                                                </button>
                                                                <button type="button" class="btn"
                                                                        data-bind="click: function() { answerNumeric(0); },
                                                                                   css: answerNumeric() === 0 ? 'btn-danger' : 'btn-outline-danger'">
                                                                    @Html.T("Common.No", "Hayır")
                                                                </button>
                                                            </div>
                                                            <!-- /ko -->

                                                            <!-- ko if: $parent.type === 'YesNo' -->
                                                            <div class="btn-group" role="group">
                                                                <button type="button" class="btn"
                                                                        data-bind="click: function() { answerText('@Html.T("Common.Yes", "Evet")'); },
                                                                                   css: answerText() === '@Html.T("Common.Yes", "Evet")' ? 'btn-success' : 'btn-outline-success'">
                                                                    @Html.T("Common.Yes", "Evet")
                                                                </button>
                                                                <button type="button" class="btn"
                                                                        data-bind="click: function() { answerText('@Html.T("Common.No", "Hayır")'); },
                                                                                   css: answerText() === '@Html.T("Common.No", "Hayır")' ? 'btn-danger' : 'btn-outline-danger'">
                                                                    @Html.T("Common.No", "Hayır")
                                                                </button>
                                                            </div>
                                                            <!-- /ko -->

                                                            <!-- ko if: $parent.type === 'MultipleChoice' && $parent.optionsJson -->
                                                            <select class="form-select" data-bind="value: answerText">
                                                                <option value="">@Html.T("Common.Select", "Seçin...")</option>
                                                                <!-- ko foreach: JSON.parse($parent.optionsJson || '[]') -->
                                                                <option data-bind="text: $data, value: $data"></option>
                                                                <!-- /ko -->
                                                            </select>
                                                            <!-- /ko -->

                                                            <!-- ko if: $parent.type === 'Text' -->
                                                            <textarea class="form-control" rows="2" data-bind="value: answerText" placeholder="@Html.T("Evaluation.WriteYourAnswer", "Cevabınızı yazın...")"></textarea>
                                                            <!-- /ko -->

                                                            <!-- N/A checkbox -->
                                                            <!-- ko if: $parent.allowNA -->
                                                            <div class="form-check mt-2">
                                                                <input type="checkbox" class="form-check-input" data-bind="checked: isNA">
                                                                <label class="form-check-label">@Html.T("Evaluation.NA", "N/A (Uygulanamaz)")</label>
                                                            </div>
                                                            <!-- /ko -->
                                                        </div>
                                                    </div>

                                                    <div class="col-md-4">
                                                        <!-- Points & Penalty Section -->
                                                        <div data-bind="with: $root.getAnswer(id)">
                                                            <!-- ko if: $parent.scoringType === 'Scored' && ($root.formData() && ($root.formData().checklistType === 'PhysicalAudit' || $root.formData().checklistType === 'Survey')) -->
                                                            <div class="mb-2">
                                                                <label class="form-label small">@Html.T("Evaluation.GivenPoints", "Verilen Puan")</label>
                                                                <input type="number" class="form-control form-control-sm"
                                                                       data-bind="value: givenPoints, attr: { max: $parent.maxPoints }"
                                                                       step="0.5" min="0">
                                                                <small class="text-muted">@Html.T("Evaluation.Max", "Maks"): <span data-bind="text: $parent.maxPoints"></span></small>
                                                            </div>
                                                            <!-- /ko -->

                                                            <!-- Notes -->
                                                            <div class="mb-2">
                                                                <label class="form-label small">@Html.T("Common.Note", "Not")</label>
                                                                <textarea class="form-control form-control-sm" rows="1" data-bind="value: notes" placeholder="@Html.T("Evaluation.EvaluatorNote", "Değerlendirici notu...")"></textarea>
                                                            </div>

                                                            <!-- ko if: $parent.recommendedNote -->
                                                            <div class="alert alert-info py-1 px-2 small mb-0">
                                                                <i class="bi bi-lightbulb"></i> <span data-bind="text: $parent.recommendedNote"></span>
                                                            </div>
                                                            <!-- /ko -->
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- /ko -->

                            <!-- Evaluation Comment -->
                            <div class="card shadow-sm mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="bi bi-chat-quote"></i> @Html.T("Evaluation.EvaluationComment", "Denetim Yorumu")</h5>
                                </div>
                                <div class="card-body">
                                    <textarea class="form-control" rows="4" data-bind="value: evaluationComment" placeholder="@Html.T("Evaluation.EvaluationCommentPlaceholder", "Genel değerlendirme yorumunuzu yazın...")"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeEvaluateModal">
                        <i class="bi bi-x"></i> @Html.T("Common.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-outline-primary" data-bind="click: saveDraft, disable: isSavingForm">
                        <i class="bi bi-save"></i> @Html.T("Evaluation.SaveDraft", "Taslak Kaydet")
                    </button>
                    <button type="button" class="btn btn-success" data-bind="click: submitEvaluation, disable: isSavingForm">
                        <!-- ko if: isSavingForm() -->
                        <span class="spinner-border spinner-border-sm"></span>
                        <!-- /ko -->
                        <i class="bi bi-check-circle"></i> @Html.T("Evaluation.Complete", "Değerlendirmeyi Tamamla")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="visible: isEvaluateModalOpen, css: { show: isEvaluateModalOpen }"></div>
</div>

@section Scripts {
    <script src="~/js/Shared/enums.service.js"></script>
    <script src="~/js/Evaluations/Index.js"></script>
}
