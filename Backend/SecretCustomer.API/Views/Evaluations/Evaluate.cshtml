@{
    ViewData["Title"] = "Cagri Denetleme";
    var assignmentId = ViewBag.AssignmentId as Guid?;
    var evaluationId = ViewBag.EvaluationId as Guid?;
}

<div id="evaluation-app">
    <!-- Loading State -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Yukleniyor...</span>
        </div>
        <p class="mt-2">Form yukleniyor...</p>
    </div>

    <!-- Error State -->
    <div data-bind="visible: errorMessage" class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i>
        <span data-bind="text: errorMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { errorMessage(''); }"></button>
    </div>

    <!-- Success State -->
    <div data-bind="visible: successMessage" class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i>
        <span data-bind="text: successMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { successMessage(''); }"></button>
    </div>

    <!-- Main Form -->
    <div data-bind="visible: !isLoading() && formData()">
        <!-- Header -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-0">
                            <i class="bi bi-clipboard-check"></i>
                            <span data-bind="text: formData().checklistName"></span>
                        </h4>
                        <small data-bind="text: formData().projectName + ' - ' + formData().branchName"></small>
                    </div>
                    <div class="text-end">
                        <a href="/Evaluations" class="btn btn-light btn-sm">
                            <i class="bi bi-arrow-left"></i> Geri
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Cagri Bilgileri -->
                    <div class="col-md-6">
                        <h6 class="border-bottom pb-2 mb-3">
                            <i class="bi bi-telephone"></i> Cagri Bilgileri
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Cagri ID</label>
                                <input type="text" class="form-control" data-bind="value: callId" placeholder="Cagri numarasi">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Cagri Tarihi</label>
                                <input type="date" class="form-control" data-bind="value: callDate">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Sure (dk)</label>
                                <input type="number" class="form-control" data-bind="value: durationMinutes" placeholder="Dakika">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Kontrol Saati</label>
                                <input type="time" class="form-control" data-bind="value: controlTime">
                            </div>
                        </div>
                    </div>

                    <!-- Personel Bilgileri -->
                    <div class="col-md-6">
                        <h6 class="border-bottom pb-2 mb-3">
                            <i class="bi bi-person"></i> Degerlendirilen Personel
                        </h6>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Personel Sec</label>
                                <select class="form-select" data-bind="value: evaluatedPersonnelId, options: formData().availablePersonnel, optionsText: 'name', optionsValue: 'id', optionsCaption: '-- Personel Secin --'"></select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">veya Tanimsiz Personel</label>
                                <input type="text" class="form-control" data-bind="value: evaluatedUnknownPersonnel" placeholder="Tanimsiz personel adi">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Score Summary (Sticky) -->
        <div class="sticky-top bg-white py-2 mb-3" style="top: 56px; z-index: 1020;">
            <div class="card border-primary">
                <div class="card-body py-2">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <h5 class="mb-0">
                                Puan: <span class="text-primary" data-bind="text: totalScore().toFixed(1)"></span>
                                / <span data-bind="text: maxScore().toFixed(1)"></span>
                                (<span data-bind="text: scorePercentage().toFixed(1)"></span>%)
                            </h5>
                        </div>
                        <div class="col">
                            <div class="progress" style="height: 20px;">
                                <div class="progress-bar" role="progressbar"
                                     data-bind="style: { width: scorePercentage() + '%' },
                                                css: scorePercentage() >= 70 ? 'bg-success' : (scorePercentage() >= 50 ? 'bg-warning' : 'bg-danger')">
                                </div>
                            </div>
                        </div>
                        <div class="col-auto">
                            <!-- Kart Sayilari -->
                            <span class="badge bg-warning text-dark me-2" data-bind="visible: yellowCardCount() > 0">
                                <i class="bi bi-card-fill"></i> <span data-bind="text: yellowCardCount()"></span> Sari
                            </span>
                            <span class="badge bg-danger" data-bind="visible: redCardCount() > 0">
                                <i class="bi bi-card-fill"></i> <span data-bind="text: redCardCount()"></span> Kirmizi
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sections -->
        <div data-bind="foreach: formData().sections">
            <div class="card shadow-sm mb-4">
                <div class="card-header" data-bind="css: groupType === 'Penalty' ? 'bg-danger text-white' : (groupType === 'Unscored' ? 'bg-secondary text-white' : 'bg-light')">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <span data-bind="text: order"></span>.
                            <span data-bind="text: name"></span>
                            <!-- ko if: groupType === 'Penalty' -->
                            <span class="badge bg-white text-danger ms-2">Cezali Bolum</span>
                            <!-- /ko -->
                            <!-- ko if: groupType === 'Unscored' -->
                            <span class="badge bg-white text-secondary ms-2">Puansiz</span>
                            <!-- /ko -->
                        </h5>
                        <div>
                            <small>
                                Agirlik: <span data-bind="text: weightPoints"></span> |
                                Maks: <span data-bind="text: maxPoints"></span> puan
                            </small>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Questions -->
                    <div data-bind="foreach: questions">
                        <div class="border rounded p-3 mb-3" data-bind="css: { 'border-danger': penaltyType !== 'None', 'border-warning': $parent.groupType === 'Unscored' }">
                            <div class="row">
                                <div class="col-md-8">
                                    <!-- Question Header -->
                                    <div class="d-flex align-items-start mb-2">
                                        <span class="badge bg-secondary me-2" data-bind="text: $parent.order + '.' + order"></span>
                                        <div class="flex-grow-1">
                                            <strong data-bind="text: text"></strong>
                                            <!-- ko if: helpText -->
                                            <button type="button" class="btn btn-sm btn-link p-0 ms-1" data-bs-toggle="tooltip" data-bind="attr: { title: helpText }">
                                                <i class="bi bi-question-circle"></i>
                                            </button>
                                            <!-- /ko -->
                                            <!-- Scoring badges -->
                                            <div class="mt-1">
                                                <!-- ko if: scoringType === 'Scored' -->
                                                <span class="badge bg-primary">Puanli</span>
                                                <!-- /ko -->
                                                <!-- ko if: scoringType === 'Unscored' -->
                                                <span class="badge bg-secondary">Puansiz</span>
                                                <!-- /ko -->
                                                <!-- ko if: scoringType === 'Penalty' -->
                                                <span class="badge bg-danger">Cezali</span>
                                                <!-- /ko -->
                                                <!-- ko if: penaltyType === 'YellowCard' -->
                                                <span class="badge bg-warning text-dark">Sari Kart (<span data-bind="text: penaltyValue"></span> puan)</span>
                                                <!-- /ko -->
                                                <!-- ko if: penaltyType === 'RedCard' -->
                                                <span class="badge bg-danger">Kirmizi Kart (<span data-bind="text: penaltyValue"></span> puan)</span>
                                                <!-- /ko -->
                                                <!-- ko if: isRequired -->
                                                <span class="badge bg-info">Zorunlu</span>
                                                <!-- /ko -->
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Answer Input -->
                                    <div class="mt-2" data-bind="with: $root.getAnswer(id)">
                                        <!-- ko if: $parent.type === 'Likert' || $parent.type === 'Star' -->
                                        <div class="btn-group" role="group">
                                            <!-- ko foreach: [1, 2, 3, 4, 5] -->
                                            <button type="button" class="btn"
                                                    data-bind="click: function() { $parent.answerNumeric($data); },
                                                               css: $parent.answerNumeric() === $data ? 'btn-primary' : 'btn-outline-primary',
                                                               text: $data">
                                            </button>
                                            <!-- /ko -->
                                        </div>
                                        <!-- /ko -->

                                        <!-- ko if: $parent.type === 'YesNo' -->
                                        <div class="btn-group" role="group">
                                            <button type="button" class="btn"
                                                    data-bind="click: function() { answerText('Evet'); },
                                                               css: answerText() === 'Evet' ? 'btn-success' : 'btn-outline-success'">
                                                Evet
                                            </button>
                                            <button type="button" class="btn"
                                                    data-bind="click: function() { answerText('Hayir'); },
                                                               css: answerText() === 'Hayir' ? 'btn-danger' : 'btn-outline-danger'">
                                                Hayir
                                            </button>
                                        </div>
                                        <!-- /ko -->

                                        <!-- ko if: $parent.type === 'MultipleChoice' && $parent.optionsJson -->
                                        <select class="form-select" data-bind="value: answerText">
                                            <option value="">Secin...</option>
                                            <!-- ko foreach: JSON.parse($parent.optionsJson || '[]') -->
                                            <option data-bind="text: $data, value: $data"></option>
                                            <!-- /ko -->
                                        </select>
                                        <!-- /ko -->

                                        <!-- ko if: $parent.type === 'Text' -->
                                        <textarea class="form-control" rows="2" data-bind="value: answerText" placeholder="Cevabinizi yazin..."></textarea>
                                        <!-- /ko -->

                                        <!-- N/A checkbox -->
                                        <!-- ko if: $parent.allowNA -->
                                        <div class="form-check mt-2">
                                            <input type="checkbox" class="form-check-input" data-bind="checked: isNA">
                                            <label class="form-check-label">N/A (Uygulanamaz)</label>
                                        </div>
                                        <!-- /ko -->
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <!-- Points & Penalty Section -->
                                    <div data-bind="with: $root.getAnswer(id)">
                                        <!-- ko if: $parent.scoringType === 'Scored' -->
                                        <div class="mb-2">
                                            <label class="form-label small">Verilen Puan</label>
                                            <input type="number" class="form-control form-control-sm"
                                                   data-bind="value: givenPoints, attr: { max: $parent.maxPoints }"
                                                   step="0.5" min="0">
                                            <small class="text-muted">Maks: <span data-bind="text: $parent.maxPoints"></span></small>
                                        </div>
                                        <!-- /ko -->

                                        <!-- ko if: $parent.scoringType === 'Penalty' || $parent.penaltyType !== 'None' -->
                                        <div class="mb-2">
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" data-bind="checked: applyPenalty">
                                                <label class="form-check-label text-danger">
                                                    <i class="bi bi-card-fill"></i> Ceza Uygula
                                                </label>
                                            </div>
                                            <!-- ko if: applyPenalty() -->
                                            <select class="form-select form-select-sm mt-1" data-bind="value: selectedPenaltyType">
                                                <option value="">Ceza Tipi Secin</option>
                                                <option value="YellowCard">Sari Kart</option>
                                                <option value="RedCard">Kirmizi Kart</option>
                                            </select>
                                            <!-- /ko -->
                                        </div>
                                        <!-- /ko -->

                                        <!-- Notes -->
                                        <div class="mb-2">
                                            <label class="form-label small">Not</label>
                                            <textarea class="form-control form-control-sm" rows="1" data-bind="value: notes" placeholder="Degerlendirici notu..."></textarea>
                                        </div>

                                        <!-- ko if: $parent.recommendedNote -->
                                        <div class="alert alert-info py-1 px-2 small mb-0">
                                            <i class="bi bi-lightbulb"></i> <span data-bind="text: $parent.recommendedNote"></span>
                                        </div>
                                        <!-- /ko -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Evaluation Comment -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="bi bi-chat-quote"></i> Denetim Yorumu</h5>
            </div>
            <div class="card-body">
                <textarea class="form-control" rows="4" data-bind="value: evaluationComment" placeholder="Genel degerlendirme yorumunuzu yazin..."></textarea>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <a href="/Evaluations" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Iptal
                        </a>
                    </div>
                    <div>
                        <button type="button" class="btn btn-outline-primary me-2" data-bind="click: saveDraft, disable: isSaving">
                            <i class="bi bi-save"></i> Taslak Kaydet
                        </button>
                        <button type="button" class="btn btn-success" data-bind="click: submitEvaluation, disable: isSaving">
                            <!-- ko if: isSaving() -->
                            <span class="spinner-border spinner-border-sm"></span>
                            <!-- /ko -->
                            <i class="bi bi-check-circle"></i> Degerlendirmeyi Tamamla
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var initialAssignmentId = '@(assignmentId?.ToString() ?? "")';
        var initialEvaluationId = '@(evaluationId?.ToString() ?? "")';
    </script>
    <script src="~/js/Evaluations/Evaluate.js"></script>
}
