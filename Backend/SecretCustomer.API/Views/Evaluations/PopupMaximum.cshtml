@{
    Layout = "_LayoutPopup";
    var assignmentId = ViewBag.AssignmentId;
    var evaluationId = ViewBag.EvaluationId;
    var isNew = assignmentId != null;
    ViewData["Title"] = isNew ? Html.T("Evaluation.NewEvaluation", "Yeni Değerlendirme") :
                        Html.T("Evaluation.EditEvaluation", "Değerlendirme Düzenle");
}

<div id="evaluation-popup">
    <!-- Header -->
    <div class="popup-header">
        <h4>
            <i class="bi bi-clipboard-check me-2"></i>
            <span data-bind="text: formData() ? formData().checklistName : '@Html.T("Evaluation.Loading", "Yükleniyor...")'"></span>
            <span class="badge bg-primary ms-2">Maksimum</span>
            <!-- ko if: formData() && formData().customerName -->
            <span class="badge bg-light text-primary ms-2" data-bind="text: formData().customerName"></span>
            <!-- /ko -->
        </h4>
        <div class="d-flex gap-2">
            <button class="btn btn-success btn-sm" data-bind="click: submitEvaluation, disable: isSaving">
                <span data-bind="visible: !isSaving()"><i class="bi bi-check-circle"></i> @Html.T("Evaluation.Complete", "Tamamla")</span>
                <span data-bind="visible: isSaving"><span class="spinner-border spinner-border-sm"></span></span>
            </button>
            <button class="btn btn-outline-primary btn-sm" data-bind="click: saveDraft, disable: isSaving">
                <i class="bi bi-save"></i> @Html.T("Evaluation.SaveDraft", "Taslak Kaydet")
            </button>
            <button class="btn btn-secondary btn-sm" onclick="window.close()">
                <i class="bi bi-x-lg"></i> @Html.T("Common.Close", "Kapat")
            </button>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">@Html.T("Evaluation.FormLoading", "Form yükleniyor...")</p>
    </div>

    <!-- Form Content -->
    <div data-bind="visible: !isLoading() && formData()">
        <div class="container-fluid py-3">
            <!-- Cagri Bilgileri -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-primary text-white py-2">
                    <h6 class="mb-0"><i class="bi bi-telephone"></i> @Html.T("Evaluation.CallInfo", "Cagri Bilgileri")</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">@Html.T("Evaluation.CallId", "Cagri ID")</label>
                            <input type="text" class="form-control" data-bind="value: callId" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">@Html.T("Evaluation.CallDate", "Cagri Tarihi") <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" data-bind="value: callDate" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">@Html.T("Evaluation.CallTime", "Cagri Saati") <span class="text-danger">*</span></label>
                            <input type="time" class="form-control" data-bind="value: callTime" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">@Html.T("Evaluation.Duration", "Sure") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: duration" placeholder="00:00:00" />
                        </div>
                    </div>
                    <!-- Personel Secimi -->
                    <div class="row g-3 mt-2">
                        <div class="col-md-6">
                            <label class="form-label">@Html.T("Evaluation.Personnel", "Personel") <span class="text-danger">*</span></label>
                            <div class="position-relative">
                                <!-- ko if: availablePersonnel().length > 0 -->
                                <input type="text" class="form-control"
                                       data-bind="value: personnelSearchText, valueUpdate: 'afterkeydown', event: { focus: showPersonnelDropdown, blur: hidePersonnelDropdownDelayed }"
                                       placeholder="@Html.T("Evaluation.SearchPersonnel", "Personel ara...")" />
                                <div class="dropdown-menu w-100" data-bind="css: { show: isPersonnelDropdownVisible() && filteredPersonnel().length > 0 }">
                                    <!-- ko foreach: filteredPersonnel -->
                                    <a class="dropdown-item" href="#" data-bind="click: $parent.selectPersonnel, text: name + (sicilNo ? ' (' + sicilNo + ')' : '')"></a>
                                    <!-- /ko -->
                                </div>
                                <!-- /ko -->
                                <!-- ko if: availablePersonnel().length === 0 -->
                                <input type="text" class="form-control"
                                       data-bind="value: evaluatedUnknownPersonnel"
                                       placeholder="@Html.T("Evaluation.EnterPersonnelName", "Personel adi girin")" />
                                <!-- /ko -->
                            </div>
                            <!-- ko if: selectedPersonnelName() -->
                            <small class="text-success"><i class="bi bi-check-circle"></i> <span data-bind="text: selectedPersonnelName"></span></small>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Puan Ozeti -->
            <div class="card shadow-sm mb-3">
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted">@Html.T("Evaluation.CurrentScore", "Mevcut Puan"):</span>
                            <span class="fs-4 fw-bold text-primary ms-2" data-bind="text: currentScore().toFixed(2)"></span>
                            <span class="text-muted">/ <span data-bind="text: maxScore().toFixed(2)"></span></span>
                        </div>
                        <div>
                            <span class="badge bg-primary fs-6" data-bind="text: scorePercentage().toFixed(1) + '%'"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sorular (Maximum modu - Puan girisi) -->
            <div data-bind="foreach: questions">
                <div class="card shadow-sm mb-3" data-bind="css: { 'border-warning': scoringType === 'Penalty' && penaltyType === 'YellowCard', 'border-danger': scoringType === 'Penalty' && penaltyType === 'RedCard' }">
                    <div class="card-header py-2 d-flex justify-content-between align-items-center" data-bind="css: { 'bg-light': scoringType === 'Scored', 'bg-warning': scoringType === 'Penalty', 'bg-secondary text-white': scoringType === 'Unscored' }">
                        <div>
                            <span class="badge bg-secondary me-2" data-bind="text: $index() + 1"></span>
                            <strong data-bind="text: text"></strong>
                            <!-- ko if: !isRequired -->
                            <span class="badge bg-warning text-dark ms-2">@Html.T("Evaluation.Optional", "Opsiyonel")</span>
                            <!-- /ko -->
                            <!-- ko if: scoringType === 'Penalty' -->
                            <span class="badge ms-2" data-bind="css: { 'bg-warning text-dark': penaltyType === 'YellowCard', 'bg-danger': penaltyType === 'RedCard' }, text: penaltyType === 'YellowCard' ? 'Sari Kart' : 'Kirmizi Kart'"></span>
                            <!-- /ko -->
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <!-- ko if: scoringType !== 'Unscored' -->
                            <small class="text-muted">Agirlik: <span data-bind="text: weightPoints"></span></small>
                            <!-- /ko -->
                            <!-- ko if: helpText -->
                            <i class="bi bi-info-circle text-info" data-bs-toggle="tooltip" data-bind="attr: { title: helpText }"></i>
                            <!-- /ko -->
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- Puanli Soru - Slider ile puan girisi -->
                        <!-- ko if: scoringType === 'Scored' || scoringType === 'Penalty' -->
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <input type="range" class="form-range" min="0" data-bind="attr: { max: maxPoints }, value: $parent.getScore(id), event: { input: function(d,e) { $parent.setScore(id, e.target.value, weightPoints, maxPoints); } }" />
                                <div class="d-flex justify-content-between small text-muted">
                                    <span>0</span>
                                    <!-- ko foreach: Array.from({length: maxPoints}, (_, i) => i + 1) -->
                                    <span data-bind="text: $data"></span>
                                    <!-- /ko -->
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="input-group">
                                    <input type="number" class="form-control text-center fw-bold" min="0" data-bind="attr: { max: maxPoints }, value: $parent.getScore(id), event: { change: function(d,e) { $parent.setScore(id, e.target.value, weightPoints, maxPoints); } }" />
                                    <span class="input-group-text" data-bind="text: '/' + maxPoints"></span>
                                </div>
                            </div>
                            <div class="col-md-2 text-end">
                                <span class="badge bg-primary fs-6" data-bind="text: $parent.getEarnedPoints(id).toFixed(2) + ' puan'"></span>
                            </div>
                        </div>
                        <!-- /ko -->

                        <!-- Puansiz Soru - Sadece yorum -->
                        <!-- ko if: scoringType === 'Unscored' -->
                        <div class="text-muted">
                            <i class="bi bi-info-circle"></i> @Html.T("Evaluation.UnscoredQuestion", "Bu soru puanlamaya dahil degildir.")
                        </div>
                        <!-- /ko -->

                        <!-- SubCriteria (Bilgi/Oneri olarak) -->
                        <!-- ko if: subCriteria && subCriteria.length > 0 -->
                        <div class="mt-2">
                            <small class="text-muted">@Html.T("Evaluation.Suggestions", "Oneriler/Bilgiler"):</small>
                            <ul class="list-unstyled mb-0 ms-3">
                                <!-- ko foreach: subCriteria -->
                                <li><i class="bi bi-dot"></i> <span data-bind="text: description"></span></li>
                                <!-- /ko -->
                            </ul>
                        </div>
                        <!-- /ko -->

                        <!-- Yorum alani -->
                        <div class="mt-2">
                            <textarea class="form-control form-control-sm" rows="2"
                                      data-bind="value: $parent.getComment(id)"
                                      placeholder="@Html.T("Evaluation.AddComment", "Yorum ekle (opsiyonel)")"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Genel Yorum -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-secondary text-white py-2">
                    <h6 class="mb-0"><i class="bi bi-chat-text"></i> @Html.T("Evaluation.GeneralComment", "Genel Yorum")</h6>
                </div>
                <div class="card-body">
                    <textarea class="form-control" rows="3" data-bind="value: generalComment"
                              placeholder="@Html.T("Evaluation.GeneralCommentPlaceholder", "Degerlendirme hakkinda genel yorum...")"></textarea>
                </div>
            </div>
        </div>
    </div>

    <!-- Error Message -->
    <div data-bind="visible: errorMessage" class="alert alert-danger m-3">
        <i class="bi bi-exclamation-triangle"></i> <span data-bind="text: errorMessage"></span>
    </div>
</div>

<script>
    window.popupConfig = {
        assignmentId: @(assignmentId != null ? assignmentId.ToString() : "null"),
        evaluationId: @(evaluationId != null ? evaluationId.ToString() : "null"),
        isNew: @(isNew ? "true" : "false"),
        scoringMethod: 'Maximum'
    };
</script>

@section Styles {
    <style>
        .form-range::-webkit-slider-thumb {
            background-color: var(--bs-primary);
        }
        .form-range::-moz-range-thumb {
            background-color: var(--bs-primary);
        }
    </style>
}

@section Scripts {
    <script src="~/js/Shared/app.config.js"></script>
    <script src="~/js/Shared/api.service.js"></script>
    <script src="~/js/Evaluations/popup-maximum.js"></script>
}
