@{
    ViewData["Title"] = Html.T("Evaluation.Form.Title", "Değerlendirme Formu");
    var assignmentId = ViewBag.AssignmentId as int? ?? 0;
}

<div id="evaluation-form-app" data-assignment-id="@assignmentId">
    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yükleniyor...")</span>
        </div>
        <p class="mt-2 text-muted">@Html.T("Evaluation.Form.Loading", "Değerlendirme formu yükleniyor...")</p>
    </div>

    <!-- Error -->
    <div data-bind="visible: errorMessage" class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <span data-bind="text: errorMessage"></span>
        <a href="/Assignments/Index" class="btn btn-sm btn-outline-danger ms-3">
            <i class="bi bi-arrow-left me-1"></i>@Html.T("Button.Back", "Geri Dön")
        </a>
    </div>

    <!-- Form Content -->
    <div data-bind="visible: !isLoading() && !errorMessage() && formData()">
        <!-- Header -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h4 class="mb-1" data-bind="text: formData()?.checklistName || 'Değerlendirme Formu'"></h4>
                        <p class="text-muted mb-0">
                            <span data-bind="text: formData()?.projectName"></span>
                            <span class="mx-2">|</span>
                            <span data-bind="text: formData()?.customerName"></span>
                        </p>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <a href="/Assignments/Index" class="btn btn-outline-secondary me-2">
                            <i class="bi bi-arrow-left me-1"></i>@Html.T("Button.Back", "Geri")
                        </a>
                        <button class="btn btn-outline-primary me-2" data-bind="click: saveDraft, disable: isSaving">
                            <i class="bi bi-save me-1"></i>@Html.T("Button.SaveDraft", "Taslak Kaydet")
                        </button>
                        <button class="btn btn-success" data-bind="click: submitEvaluation, disable: isSaving">
                            <i class="bi bi-check-circle me-1"></i>@Html.T("Button.Submit", "Gönder")
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Evaluation Info -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>@Html.T("Evaluation.Form.Info", "Değerlendirme Bilgileri")</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">@Html.T("Evaluation.Form.Period", "Dönem")</label>
                        <select class="form-select" data-bind="value: selectedPeriodId, options: formData()?.availablePeriods || [], optionsValue: 'id', optionsText: 'name', optionsCaption: '@Html.T("Evaluation.SelectPeriod", "Dönem Seçin...")'"></select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Html.T("Evaluation.Form.Organization", "Şube/Birim") <span class="text-danger">*</span></label>
                        <select class="form-select" data-bind="value: selectedOrganizationId, options: formData()?.availableOrganizations || [], optionsValue: 'id', optionsText: 'name', optionsCaption: '@Html.T("Evaluation.SelectOrganization", "Şube Seçin...")'"></select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Html.T("Evaluation.Form.EvaluatedPersonnel", "Değerlendirilen Personel")</label>
                        <select class="form-select" data-bind="value: selectedPersonnelId, options: formData()?.availablePersonnel || [], optionsValue: 'id', optionsText: 'name', optionsCaption: '@Html.T("Evaluation.SelectPersonnel", "Personel Seçin...")', enable: selectedOrganizationId()"></select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Html.T("Evaluation.Form.Date", "Değerlendirme Tarihi")</label>
                        <input type="date" class="form-control" data-bind="value: evaluationDate">
                    </div>
                </div>
            </div>
        </div>

        <!-- Questions by Section -->
        <div data-bind="foreach: formData()?.sections || []">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0">
                        <span data-bind="text: name"></span>
                        <span class="badge bg-light text-primary ms-2" data-bind="text: questions.length + ' Soru'"></span>
                    </h6>
                </div>
                <div class="card-body">
                    <div data-bind="foreach: questions" class="questions-list">
                        <div class="question-item border-bottom py-3">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="d-flex">
                                        <span class="badge bg-secondary me-2" data-bind="text: order"></span>
                                        <div>
                                            <p class="mb-1 fw-medium" data-bind="text: text"></p>
                                            <small class="text-muted" data-bind="text: helpText, visible: helpText"></small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <!-- Score Selection -->
                                    <div class="btn-group w-100" role="group">
                                        <!-- ko foreach: $parent.$root.getScoreOptions(maxPoints) -->
                                        <input type="radio" class="btn-check"
                                               data-bind="attr: { id: 'q' + $parentContext.$data.id + '_' + $data.value, name: 'score_' + $parentContext.$data.id },
                                                          checked: $parentContext.$root.getAnswer($parentContext.$data.id).score,
                                                          checkedValue: $data.value">
                                        <label class="btn btn-outline-primary btn-sm"
                                               data-bind="attr: { for: 'q' + $parentContext.$data.id + '_' + $data.value }, text: $data.label"></label>
                                        <!-- /ko -->
                                        <!-- N/A Option -->
                                        <!-- ko if: allowNA -->
                                        <input type="radio" class="btn-check"
                                               data-bind="attr: { id: 'q' + id + '_na', name: 'score_' + id },
                                                          checked: $root.getAnswer(id).score,
                                                          checkedValue: -1">
                                        <label class="btn btn-outline-secondary btn-sm" data-bind="attr: { for: 'q' + id + '_na' }">N/A</label>
                                        <!-- /ko -->
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <input type="text" class="form-control form-control-sm"
                                           placeholder="Not..."
                                           data-bind="value: $root.getAnswer(id).note">
                                </div>
                            </div>
                            <!-- Sub Criteria (if any) -->
                            <!-- ko if: subCriteria && subCriteria.length > 0 -->
                            <div class="mt-2 ps-4">
                                <small class="text-muted">@Html.T("Evaluation.SubCriteria", "Alt Kriterler"):</small>
                                <div class="d-flex flex-wrap gap-2 mt-1">
                                    <!-- ko foreach: subCriteria -->
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input"
                                               data-bind="attr: { id: 'sub_' + $parentContext.$data.id + '_' + id },
                                                          checked: $root.isSubCriteriaSelected($parentContext.$data.id, id)">
                                        <label class="form-check-label small" data-bind="attr: { for: 'sub_' + $parentContext.$data.id + '_' + id }, text: description"></label>
                                    </div>
                                    <!-- /ko -->
                                </div>
                            </div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- General Notes -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h6 class="mb-0"><i class="bi bi-chat-text me-2"></i>@Html.T("Evaluation.Form.GeneralNotes", "Genel Notlar")</h6>
            </div>
            <div class="card-body">
                <textarea class="form-control" rows="4"
                          placeholder="@Html.T("Evaluation.Form.GeneralNotesPlaceholder", "Değerlendirme hakkında genel notlar...")"
                          data-bind="value: generalNotes"></textarea>
            </div>
        </div>

        <!-- Score Summary -->
        <div class="card shadow-sm mb-4 border-primary">
            <div class="card-body text-center">
                <h4 class="mb-0">
                    @Html.T("Evaluation.Form.TotalScore", "Toplam Puan"):
                    <span class="text-primary" data-bind="text: calculatedScore() + '%'"></span>
                </h4>
            </div>
        </div>

        <!-- Submit Buttons -->
        <div class="d-flex justify-content-between mb-5">
            <a href="/Assignments/Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>@Html.T("Button.Cancel", "İptal")
            </a>
            <div>
                <button class="btn btn-outline-primary me-2" data-bind="click: saveDraft, disable: isSaving">
                    <span data-bind="visible: !isSaving()">
                        <i class="bi bi-save me-1"></i>@Html.T("Button.SaveDraft", "Taslak Kaydet")
                    </span>
                    <span data-bind="visible: isSaving">
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    </span>
                </button>
                <button class="btn btn-success" data-bind="click: submitEvaluation, disable: isSaving">
                    <span data-bind="visible: !isSaving()">
                        <i class="bi bi-check-circle me-1"></i>@Html.T("Button.Submit", "Değerlendirmeyi Gönder")
                    </span>
                    <span data-bind="visible: isSaving">
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    </span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Evaluations/Form.js"></script>
}
