@{
    Layout = "_LayoutPopup";
    var assignmentId = ViewBag.AssignmentId;
    var evaluationId = ViewBag.EvaluationId;
    var isInternal = ViewBag.IsInternal ?? false;
    var isNew = assignmentId != null;
    ViewData["Title"] = isNew ? Html.T("Evaluation.NewEvaluation", "Yeni Değerlendirme") :
                        Html.T("Evaluation.EditEvaluation", "Değerlendirme Düzenle");
}

<div id="evaluation-popup" style="height: 100vh; display: flex; flex-direction: column;">
    <!-- Header -->
    <div class="bg-primary text-white p-3" style="flex-shrink: 0;">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-clipboard-check"></i>
                <!-- ko if: formData() -->
                <span data-bind="text: formData().checklistName"></span>
                <small data-bind="text: ' - ' + formData().projectName"></small>
                <!-- ko if: formData().customerName -->
                <span class="badge bg-light text-primary ms-2" data-bind="text: formData().customerName"></span>
                <!-- /ko -->
                <!-- /ko -->
            </h5>
            <button type="button" class="btn btn-outline-light btn-sm" onclick="window.close();">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>

    <!-- Body -->
    <div style="flex: 1; overflow-y: auto;">
        <!-- Loading -->
        <div data-bind="visible: isLoading" class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2">@Html.T("Evaluation.FormLoading", "Form yükleniyor...")</p>
        </div>

        <!-- Summary View -->
        <!-- ko if: isShowingSummary() && summaryData() -->
        <!-- ko with: summaryData -->
        <div class="container-fluid py-4">
            <div class="row justify-content-center">
                <div class="col-lg-10 col-xl-8">
                    <div class="card shadow-lg border-success">
                        <div class="card-header bg-primary text-white text-center py-3">
                            <i class="bi bi-clipboard-check display-5 mb-2"></i>
                            <h4 class="mb-0">@Html.T("Evaluation.Summary", "Değerlendirme Özeti")</h4>
                            <small class="opacity-75">@Html.T("Evaluation.ReviewBeforeSave", "Kaydetmeden önce kontrol edin")</small>
                        </div>
                        <div class="card-body p-4">
                            <!-- Puan Özeti -->
                            <div class="text-center mb-4">
                                <div class="display-4 fw-bold text-primary" data-bind="text: scorePercentage.toFixed(2)"></div>
                                <div class="progress mt-3" style="height: 25px;">
                                    <div class="progress-bar" role="progressbar"
                                         data-bind="style: { width: scorePercentage.toFixed(2) + '%' },
                                                    css: { 'bg-success': scorePercentage >= 70, 'bg-warning': scorePercentage >= 50 && scorePercentage < 70, 'bg-danger': scorePercentage < 50 }">
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <span class="text-muted">@Html.T("Evaluation.EarnedPoints", "Kazanılan"):</span>
                                    <strong data-bind="text: currentScore.toFixed(2)"></strong>
                                    <span class="text-muted">/ <span data-bind="text: maxScore.toFixed(2)"></span></span>
                                </div>
                            </div>

                            <!-- Detay Bilgileri -->
                            <hr>
                            <div class="row g-3 mb-4">
                                <div class="col-6">
                                    <small class="text-muted d-block">@Html.T("Evaluation.Personnel", "Personel")</small>
                                    <span class="fw-bold" data-bind="text: evaluatedPersonnelName"></span>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">@Html.T("Evaluation.CallId", "Çağrı ID")</small>
                                    <!-- ko if: callId -->
                                    <div class="d-flex align-items-center gap-1">
                                        <code class="fw-bold" data-bind="text: callId.length > 20 ? callId.substring(0, 8) + '...' + callId.substring(callId.length - 8) : callId, attr: { title: callId }" style="cursor: help;"></code>
                                        <button type="button" class="btn btn-link btn-sm p-0 text-secondary" data-bind="click: function() { var t = callId; (navigator.clipboard && window.isSecureContext) ? navigator.clipboard.writeText(t).then(function() { toastr.success('Panoya kopyalandı'); }).catch(function() { var a = document.createElement('textarea'); a.value = t; document.body.appendChild(a); a.select(); document.execCommand('copy'); document.body.removeChild(a); toastr.success('Panoya kopyalandı'); }) : (function() { var a = document.createElement('textarea'); a.value = t; document.body.appendChild(a); a.select(); document.execCommand('copy'); document.body.removeChild(a); toastr.success('Panoya kopyalandı'); })(); }" title="@Html.T("Common.Copy", "Kopyala")">
                                            <i class="bi bi-clipboard" style="font-size: 0.75rem;"></i>
                                        </button>
                                    </div>
                                    <!-- /ko -->
                                    <!-- ko ifnot: callId --><span class="fw-bold">-</span><!-- /ko -->
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">@Html.T("Evaluation.CallDate", "Çağrı Tarihi")</small>
                                    <span class="fw-bold" data-bind="text: callDate"></span>
                                </div>
                                <div class="col-3">
                                    <small class="text-muted d-block">@Html.T("Evaluation.CallTime", "Çağrı Saati")</small>
                                    <span class="fw-bold" data-bind="text: callTime"></span>
                                </div>
                                <div class="col-3">
                                    <small class="text-muted d-block">@Html.T("Evaluation.Duration", "Süre")</small>
                                    <span class="fw-bold" data-bind="text: duration"></span>
                                </div>
                            </div>

                            <!-- Açıklamalar -->
                            <!-- ko if: descriptions && descriptions.length > 0 -->
                            <div class="mb-4">
                                <small class="text-muted d-block mb-1">@Html.T("Evaluation.Descriptions", "Açıklamalar")</small>
                                <ul class="mb-0">
                                    <!-- ko foreach: descriptions -->
                                    <li data-bind="text: $data"></li>
                                    <!-- /ko -->
                                </ul>
                            </div>
                            <!-- /ko -->

                            <!-- Denetim Yorumu -->
                            <!-- ko if: evaluationComment -->
                            <div class="mb-4">
                                <small class="text-muted d-block mb-1">@Html.T("Evaluation.EvaluationComment", "Denetim Yorumu")</small>
                                <p class="mb-0 bg-light p-2 rounded" data-bind="text: evaluationComment"></p>
                            </div>
                            <!-- /ko -->

                            <!-- Cevaplar Tablosu -->
                            <hr>
                            <h6 class="mb-3"><i class="bi bi-list-check"></i> @Html.T("Evaluation.Answers", "Verilen Cevaplar")</h6>
                            <div class="table-responsive table-responsive-scrollable" style="max-height: 300px; overflow-y: auto;">
                                <table class="table table-sm table-striped mb-0">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th style="width: 5%;">#</th>
                                            <th style="width: 50%;">@Html.T("Evaluation.Question", "Soru")</th>
                                            <th style="width: 30%;">@Html.T("Evaluation.Answer", "Cevap")</th>
                                            <th style="width: 15%;" class="text-end">@Html.T("Evaluation.Points", "Puan")</th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: answers">
                                        <tr data-bind="css: { 'table-secondary': !isAnswered && !isRequired }">
                                            <td data-bind="text: index"></td>
                                            <td>
                                                <span data-bind="text: questionText"></span>
                                                <!-- ko ifnot: isRequired -->
                                                <span class="badge bg-warning text-dark ms-1" style="font-size: 0.65em;">Opsiyonel</span>
                                                <!-- /ko -->
                                                <!-- ko if: comment -->
                                                <br><small class="text-muted"><i class="bi bi-chat-dots"></i> <span data-bind="text: comment"></span></small>
                                                <!-- /ko -->
                                            </td>
                                            <td>
                                                <!-- ko if: isAnswered -->
                                                <span data-bind="text: answerText"></span>
                                                <!-- /ko -->
                                                <!-- ko ifnot: isAnswered -->
                                                <span class="text-muted fst-italic" data-bind="text: isRequired ? 'Cevaplanmadı' : 'Gerekmedi'"></span>
                                                <!-- /ko -->
                                            </td>
                                            <td class="text-end">
                                                <!-- ko if: isAnswered -->
                                                <span class="badge" data-bind="text: (points >= 0 ? '+' : '') + points,
                                                    css: { 'bg-success': points > 0, 'bg-warning text-dark': points === 0, 'bg-danger': points < 0 }"></span>
                                                <!-- /ko -->
                                                <!-- ko ifnot: isAnswered -->
                                                <span class="text-muted">-</span>
                                                <!-- /ko -->
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="card-footer text-center py-3">
                            <button type="button" class="btn btn-outline-secondary me-2" data-bind="click: $parent.backToForm">
                                <i class="bi bi-arrow-left me-2"></i>@Html.T("Evaluation.BackToForm", "Geri Dön")
                            </button>
                            <button type="button" class="btn btn-lg btn-success" data-bind="click: $parent.confirmSubmit, disable: $parent.isSaving">
                                <!-- ko if: $parent.isSaving() -->
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <!-- /ko -->
                                <i class="bi bi-check-circle me-2"></i>@Html.T("Evaluation.ConfirmAndSave", "Onayla ve Kaydet")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- /ko -->
        <!-- /ko -->

        <!-- Form Content -->
        <div data-bind="visible: !isLoading() && formData() && !isShowingSummary()">
            <div class="container-fluid py-3">
                <!-- Period & Call Info -->
                <div class="row mb-4">
                    <!-- Dönem Seçimi -->
                    <div class="col-12 mb-3" data-bind="visible: availablePeriods().length > 0">
                        <div class="card border-info">
                            <div class="card-header bg-info text-white py-2">
                                <h6 class="mb-0"><i class="bi bi-calendar-range"></i> @Html.T("Evaluation.Period", "Dönem")</h6>
                            </div>
                            <div class="card-body py-2">
                                <div class="row align-items-center">
                                    <div class="col-md-6">
                                        <select class="form-select" data-bind="value: selectedPeriodId, options: availablePeriods, optionsText: function(p) { return p.name + ' (' + new Date(p.startDate).toLocaleDateString('tr-TR') + ' - ' + new Date(p.endDate).toLocaleDateString('tr-TR') + ')'; }, optionsValue: 'id', optionsCaption: '@Html.T("Evaluation.SelectPeriod", "-- Dönem Seçin --")'"></select>
                                    </div>
                                    <div class="col-md-6">
                                        <!-- ko if: selectedPeriodId() -->
                                        <!-- ko with: availablePeriods().find(function(p) { return p.id === selectedPeriodId(); }) -->
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="badge" data-bind="css: status === 'Open' ? 'bg-success' : 'bg-secondary', text: status === 'Open' ? '@Html.T("Evaluation.PeriodOpen", "Aktif")' : '@Html.T("Evaluation.PeriodClosed", "Kapalı")'"></span>
                                            <span class="text-muted">
                                                @Html.T("Evaluation.Completed", "Tamamlanan"): <strong data-bind="text: completedCount"></strong> / <span data-bind="text: targetCount"></span>
                                            </span>
                                            <div class="progress flex-grow-1" style="height: 8px; max-width: 150px;">
                                                <div class="progress-bar bg-success" data-bind="style: { width: (targetCount > 0 ? (completedCount / targetCount * 100) : 0) + '%' }"></div>
                                            </div>
                                        </div>
                                        <!-- /ko -->
                                        <!-- /ko -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Çağrı Bilgileri -->
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header bg-light py-2">
                                <h6 class="mb-0"><i class="bi bi-telephone"></i> @Html.T("Evaluation.CallInfo", "Çağrı Bilgileri")</h6>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label">@Html.T("Evaluation.CallId", "Çağrı ID")
                                            <span data-bind="visible: isCheckingCallId" class="spinner-border spinner-border-sm text-secondary ms-1" role="status"></span>
                                        </label>
                                        <input type="text" class="form-control" data-bind="value: callId, css: { 'is-invalid': callIdExists }" placeholder="@Html.T("Evaluation.CallIdPlaceholder", "Çağrı numarası")">
                                        <div class="invalid-feedback">
                                            @Html.T("Evaluation.CallIdExists", "Bu Çağrı ID daha önce kaydedilmiş!")
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">@Html.T("Evaluation.CallDate", "Çağrı Tarihi") <span class="text-danger">*</span></label>
                                        <input type="date" class="form-control" data-bind="value: callDate" required>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">@Html.T("Evaluation.CallTime", "Çağrı Saati") <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control time-mask" data-bind="value: callTime" placeholder="__:__" required>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">@Html.T("Evaluation.Duration", "Süre") <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control duration-mask" data-bind="value: duration" placeholder="00:__:__" required>
                                    </div>
                                    <!-- Açıklamalar -->
                                    <div class="col-md-8">
                                        <label class="form-label">@Html.T("Evaluation.Descriptions", "Açıklamalar")</label>
                                        <!-- ko foreach: descriptions -->
                                        <div class="input-group mb-1">
                                            <input type="text" class="form-control" data-bind="textInput: $data" placeholder="@Html.T("Evaluation.DescriptionPlaceholder", "Açıklama girin...")">
                                            <!-- ko if: $index() === $parent.descriptions().length - 1 -->
                                            <button type="button" class="btn btn-outline-success" data-bind="click: $parent.addDescription" title="@Html.T("Common.Add", "Ekle")">
                                                <i class="bi bi-plus"></i>
                                            </button>
                                            <!-- /ko -->
                                            <!-- ko if: $parent.descriptions().length > 1 -->
                                            <button type="button" class="btn btn-outline-danger" data-bind="click: function() { $parent.removeDescription($index()); }" title="@Html.T("Common.Remove", "Kaldır")">
                                                <i class="bi bi-x"></i>
                                            </button>
                                            <!-- /ko -->
                                        </div>
                                        <!-- /ko -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Değerlendirilen Personel -->
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header bg-light py-2">
                                <h6 class="mb-0"><i class="bi bi-person"></i> @Html.T("Evaluation.EvaluatedPersonnel", "Değerlendirilen Personel")</h6>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label">@Html.T("Evaluation.SelectPersonnel", "Personel Seç") <span class="text-danger">*</span></label>
                                        <!-- ko ifnot: isNewPersonnelMode -->
                                        <div class="position-relative">
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                                <input type="text" class="form-control"
                                                       placeholder="@Html.T("Evaluation.SearchPersonnel", "Personel ara...")"
                                                       autocomplete="off"
                                                       data-bind="value: personnelSearchText, valueUpdate: 'afterkeydown',
                                                                  event: { focus: showPersonnelDropdown, blur: hidePersonnelDropdownDelayed },
                                                                  attr: { disabled: isLoadingPersonnel() }">
                                                <!-- ko if: evaluatedPersonnelId() -->
                                                <button type="button" class="btn btn-outline-danger" data-bind="click: clearSelectedPersonnel" title="@Html.T("Common.Clear", "Temizle")">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                                <!-- /ko -->
                                                <!-- ko if: isLoadingPersonnel() -->
                                                <span class="input-group-text">
                                                    <span class="spinner-border spinner-border-sm"></span>
                                                </span>
                                                <!-- /ko -->
                                                <!-- ko ifnot: isLoadingPersonnel() -->
                                                <button type="button" class="btn btn-outline-secondary" data-bind="click: enableNewPersonnelMode" title="@Html.T("Evaluation.PersonnelNotInList", "Listede Yok")">
                                                    <i class="bi bi-person-plus"></i>
                                                </button>
                                                <!-- /ko -->
                                            </div>
                                            <!-- Autocomplete Dropdown -->
                                            <div class="dropdown-menu w-100 show shadow" style="max-height: 250px; overflow-y: auto; position: absolute; top: 100%; left: 0; z-index: 1050;"
                                                 data-bind="visible: isPersonnelDropdownVisible() && filteredPersonnel().length > 0">
                                                <!-- ko foreach: filteredPersonnel -->
                                                <div class="dropdown-item d-flex justify-content-between align-items-center"
                                                     style="cursor: pointer;"
                                                     data-bind="event: { mousedown: function() { $parent.selectPersonnel($data); } }">
                                                    <span data-bind="text: name"></span>
                                                    <!-- ko if: $data.sicilNo -->
                                                    <small class="text-muted" data-bind="text: $data.sicilNo"></small>
                                                    <!-- /ko -->
                                                </div>
                                                <!-- /ko -->
                                            </div>
                                            <!-- No Results -->
                                            <div class="dropdown-menu w-100 show shadow" style="position: absolute; top: 100%; left: 0; z-index: 1050;"
                                                 data-bind="visible: isPersonnelDropdownVisible() && filteredPersonnel().length === 0 && personnelSearchText().length >= 2">
                                                <span class="dropdown-item text-muted">
                                                    <i class="bi bi-info-circle me-1"></i> @Html.T("Evaluation.NoPersonnelFound", "Personel bulunamadı")
                                                </span>
                                            </div>
                                        </div>
                                        <!-- ko if: selectedPersonnelName() -->
                                        <small class="text-success mt-1 d-block"><i class="bi bi-check-circle"></i> <span data-bind="text: selectedPersonnelName"></span></small>
                                        <!-- /ko -->
                                        <!-- /ko -->
                                        <!-- Yeni Personel Modu -->
                                        <!-- ko if: isNewPersonnelMode -->
                                        <div class="card border-warning">
                                            <div class="card-header bg-warning text-dark py-2 d-flex justify-content-between align-items-center">
                                                <small><i class="bi bi-person-plus me-1"></i>@Html.T("Evaluation.NewPersonnel", "Yeni Personel")</small>
                                                <button type="button" class="btn btn-sm btn-outline-dark" data-bind="click: cancelNewPersonnelMode">
                                                    <i class="bi bi-x"></i>
                                                </button>
                                            </div>
                                            <div class="card-body py-2">
                                                <div class="row g-2">
                                                    <div class="col-6">
                                                        <input type="text" class="form-control form-control-sm" placeholder="@Html.T("Common.FirstName", "Ad") *" data-bind="value: newPersonnelFirstName">
                                                    </div>
                                                    <div class="col-6">
                                                        <input type="text" class="form-control form-control-sm" placeholder="@Html.T("Common.LastName", "Soyad") *" data-bind="value: newPersonnelLastName">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- /ko -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Puan Özeti (Sticky) -->
                <div class="sticky-top bg-white py-2 mb-3" style="top: 0; z-index: 1020;">
                    <div class="card border-primary">
                        <div class="card-body py-2">
                            <div class="row align-items-center">
                                <div class="col-auto">
                                    <span class="text-muted">@Html.T("Evaluation.CurrentScore", "Mevcut Puan"):</span>
                                </div>
                                <div class="col-auto">
                                    <h4 class="mb-0 fw-bold text-primary" data-bind="text: currentScore().toFixed(2)"></h4>
                                </div>
                                <div class="col-auto">
                                    <span class="text-muted">/ <span data-bind="text: maxScore().toFixed(2)"></span></span>
                                </div>
                                <div class="col">
                                    <div class="progress" style="height: 20px;">
                                        <div class="progress-bar" role="progressbar"
                                             data-bind="style: { width: scorePercentage() + '%' },
                                                        css: scorePercentage() >= 70 ? 'bg-success' : (scorePercentage() >= 50 ? 'bg-warning' : 'bg-danger')">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-auto">
                                    <span class="badge bg-primary fs-6" data-bind="text: scorePercentage().toFixed(1) + '%'"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sorular (CriteriaTotal modu - Seçenek bazlı) -->
                <div data-bind="foreach: questions">
                    <div class="card shadow-sm mb-3">
                        <div class="card-header py-2 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-secondary me-2" data-bind="text: $index() + 1"></span>
                                <strong data-bind="text: text"></strong>
                                <!-- ko if: !isRequired -->
                                <span class="badge bg-warning text-dark ms-2">@Html.T("Evaluation.Optional", "Opsiyonel")</span>
                                <!-- /ko -->
                            </div>
                            <div>
                                <!-- ko if: helpText -->
                                <i class="bi bi-info-circle text-info" data-bs-toggle="tooltip" data-bind="attr: { title: helpText }"></i>
                                <!-- /ko -->
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <!-- SubCriteria Seçenekleri (Survey gibi liste stili) -->
                            <div class="list-group list-group-flush" data-bind="foreach: subCriteria">
                                <label class="list-group-item list-group-item-action py-2 px-3 d-flex align-items-center"
                                       data-bind="css: { 'active': $parents[1].getSelectedOption($parent.id)() === id }, click: function() { $parents[1].selectOption($parent.id, id, weightPoints); }">
                                    <input type="radio" class="form-check-input me-3 flex-shrink-0"
                                           data-bind="attr: { name: 'q_' + $parent.id, value: id }, checked: $parents[1].getSelectedOption($parent.id), checkedValue: id" />
                                    <span class="flex-grow-1" data-bind="text: description"></span>
                                    <span class="badge ms-2" data-bind="text: (weightPoints >= 0 ? '+' : '') + weightPoints, css: { 'bg-success': weightPoints > 0, 'bg-warning text-dark': weightPoints === 0, 'bg-danger': weightPoints < 0 }"></span>
                                </label>
                            </div>

                            <!-- Yorum alanı -->
                            <!-- ko if: allowComment -->
                            <div class="p-3 border-top">
                                <textarea class="form-control form-control-sm" rows="2"
                                          data-bind="value: $parent.getComment(id)"
                                          placeholder="@Html.T("Evaluation.AddComment", "Yorum ekle (opsiyonel)")"></textarea>
                            </div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>

                <!-- Genel Yorum -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-light py-2">
                        <h6 class="mb-0"><i class="bi bi-chat-quote"></i> @Html.T("Evaluation.EvaluationComment", "Denetim Yorumu")</h6>
                    </div>
                    <div class="card-body">
                        <textarea class="form-control" rows="3" data-bind="value: generalComment"
                                  placeholder="@Html.T("Evaluation.GeneralCommentPlaceholder", "Değerlendirme hakkında genel yorum...")"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Error Message -->
        <div data-bind="visible: errorMessage" class="alert alert-danger m-3">
            <i class="bi bi-exclamation-triangle"></i> <span data-bind="text: errorMessage"></span>
        </div>
    </div>

    <!-- Footer -->
    <div class="bg-light p-3 border-top" style="flex-shrink: 0;" data-bind="visible: !isShowingSummary()">
        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary" onclick="window.close();">
                <i class="bi bi-x"></i> @Html.T("Common.Cancel", "İptal")
            </button>
            <button type="button" class="btn btn-outline-primary" data-bind="click: saveDraft, disable: isSaving">
                <i class="bi bi-save"></i> @Html.T("Evaluation.SaveDraft", "Taslak Kaydet")
            </button>
            <button type="button" class="btn btn-success" data-bind="click: showSummary">
                <i class="bi bi-eye"></i> @Html.T("Evaluation.ShowSummary", "Özet ve Kaydet")
            </button>
        </div>
    </div>
</div>

<script>
    window.popupConfig = {
        assignmentId: @(assignmentId != null ? assignmentId.ToString() : "null"),
        evaluationId: @(evaluationId != null ? evaluationId.ToString() : "null"),
        isNew: @(isNew ? "true" : "false"),
        isInternal: @(isInternal ? "true" : "false"),
        scoringMethod: 'CriteriaTotal'
    };
</script>

@section Styles {
    <style>
        .list-group-item.active {
            background-color: #e7f1ff;
            border-color: #b6d4fe;
            color: #0c63e4;
        }
        .list-group-item:hover:not(.active) {
            background-color: #f8f9fa;
        }
        .list-group-item .form-check-input {
            margin-top: 0;
        }
    </style>
}

@section Scripts {
    <script src="~/js/Shared/app.config.js"></script>
    <script src="~/js/Shared/api.service.js"></script>
    <script src="~/js/Evaluations/popup-criteria-total.js"></script>
}
