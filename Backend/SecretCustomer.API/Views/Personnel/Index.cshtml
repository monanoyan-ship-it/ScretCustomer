@{
    ViewData["Title"] = Html.T("Personnel.Title", "Personel Yönetimi");
}

<div id="personnel-app">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-people-fill me-2"></i>@Html.T("Personnel.Title", "Personel Yönetimi")
        </h2>
        <button class="btn btn-primary" data-bind="click: createNew">
            <i class="bi bi-plus-circle me-1"></i>@Html.T("Personnel.NewPersonnel", "Yeni Personel")
        </button>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">@Html.T("Common.Search", "Arama")</label>
                    <input type="text" class="form-control" placeholder="@Html.T("Personnel.SearchPlaceholder", "Ad, Soyad, Kullanıcı Adı, E-posta...")"
                           data-bind="value: filter.searchTerm, valueUpdate: 'afterkeydown'">
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Html.T("Personnel.Role", "Rol")</label>
                    <select class="form-select" data-bind="value: filter.role">
                        <option value="">@Html.T("Common.All", "Tümü")</option>
                        <option value="0">Admin</option>
                        <option value="1">Manager</option>
                        <option value="2">QualitySpecialist</option>
                        <option value="3">FieldWorker</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Html.T("Common.Status", "Durum")</label>
                    <select class="form-select" data-bind="value: filter.isActive">
                        <option value="">@Html.T("Common.All", "Tümü")</option>
                        <option value="true">@Html.T("Common.Active", "Aktif")</option>
                        <option value="false">@Html.T("Common.Inactive", "Pasif")</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button class="btn btn-primary" data-bind="click: applyFilters">
                        <i class="bi bi-search me-1"></i>@Html.T("Common.Filter", "Filtrele")
                    </button>
                    <button class="btn btn-outline-secondary" data-bind="click: clearFilters">
                        <i class="bi bi-x-lg me-1"></i>@Html.T("Common.Clear", "Temizle")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yükleniyor...")</span>
        </div>
        <p class="mt-2 text-muted">@Html.T("Personnel.Loading", "Personel listesi yükleniyor...")</p>
    </div>

    <!-- Personnel Table -->
    <div data-bind="visible: !isLoading()">
        <div class="card shadow-sm">
            <div class="card-body">
                <!-- Summary -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted">
                        @Html.T("Common.Total", "Toplam") <strong data-bind="text: filteredPersonnel().length"></strong> @Html.T("Personnel.Personnel", "personel")
                    </span>
                </div>

                <!-- Empty State -->
                <div data-bind="visible: filteredPersonnel().length === 0" class="text-center py-5">
                    <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
                    <p class="mt-3 text-muted">@Html.T("Personnel.NoPersonnel", "Henüz personel kaydı bulunmamaktadır.")</p>
                </div>

                <!-- Table -->
                <div data-bind="visible: filteredPersonnel().length > 0" class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.T("Personnel.FullName", "Ad Soyad")</th>
                                <th>@Html.T("Personnel.Username", "Kullanıcı Adı")</th>
                                <th>@Html.T("Personnel.Role", "Rol")</th>
                                <th>@Html.T("Personnel.Phone", "Telefon")</th>
                                <th>@Html.T("Personnel.Stats", "İstatistik")</th>
                                <th>@Html.T("Personnel.LastLogin", "Son Giriş")</th>
                                <th>@Html.T("Common.Status", "Durum")</th>
                                <th style="width: 150px;">@Html.T("Common.Actions", "İşlemler")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: filteredPersonnel">
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 40px; height: 40px;">
                                            <i class="bi bi-person text-primary"></i>
                                        </div>
                                        <div>
                                            <div class="fw-medium" data-bind="text: fullName"></div>
                                            <small class="text-muted" data-bind="text: email"></small>
                                        </div>
                                    </div>
                                </td>
                                <td><code data-bind="text: username"></code></td>
                                <td>
                                    <span class="badge" data-bind="css: $parent.getRoleBadgeClass(role), text: $parent.getRoleName(role)"></span>
                                </td>
                                <td data-bind="text: phoneNumber || '-'"></td>
                                <td>
                                    <span class="badge bg-info me-1" title="Görev Sayısı">
                                        <i class="bi bi-list-task me-1"></i><span data-bind="text: assignmentCount"></span>
                                    </span>
                                    <span class="badge bg-success" title="Değerlendirme Sayısı">
                                        <i class="bi bi-clipboard-check me-1"></i><span data-bind="text: evaluationCount"></span>
                                    </span>
                                </td>
                                <td>
                                    <small data-bind="text: lastLoginAt ? new Date(lastLoginAt).toLocaleDateString('tr-TR') : '-'"></small>
                                </td>
                                <td>
                                    <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? '@Html.T("Common.Active", "Aktif")' : '@Html.T("Common.Inactive", "Pasif")'"></span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" title="@Html.T("Common.Edit", "Düzenle")" data-bind="click: $parent.editPersonnel">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-warning" title="@Html.T("Personnel.ChangePassword", "Şifre Değiştir")" data-bind="click: $parent.changePassword">
                                            <i class="bi bi-key"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" title="@Html.T("Common.Delete", "Sil")" data-bind="click: $parent.deletePersonnel">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Create/Edit Modal -->
    <div class="modal fade" id="personnelModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" data-bind="with: editingPersonnel">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <!-- ko ifnot: id -->
                        <i class="bi bi-plus-circle me-2"></i>@Html.T("Personnel.NewPersonnel", "Yeni Personel")
                        <!-- /ko -->
                        <!-- ko if: id -->
                        <i class="bi bi-pencil me-2"></i>@Html.T("Personnel.EditPersonnel", "Personel Düzenle")
                        <!-- /ko -->
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Modal Hata Mesajı -->
                    <div data-bind="visible: $root.modalErrorMessage()" class="alert alert-danger alert-dismissible mb-3">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <span data-bind="text: $root.modalErrorMessage()"></span>
                        <button type="button" class="btn-close" data-bind="click: function() { $root.modalErrorMessage(''); }"></button>
                    </div>
                    <div class="row g-3">
                        <!-- Kullanıcı Adı (sadece yeni oluşturmada) -->
                        <!-- ko ifnot: id -->
                        <div class="col-12">
                            <label class="form-label">@Html.T("Personnel.Username", "Kullanıcı Adı") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: username" required placeholder="ornek.kullanici">
                            <small class="text-muted">Sadece İngilizce harf, rakam, nokta ve alt çizgi</small>
                        </div>
                        <!-- /ko -->

                        <div class="col-md-6">
                            <label class="form-label">@Html.T("Personnel.FirstName", "Ad") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: firstName" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Html.T("Personnel.LastName", "Soyad") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: lastName" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label">@Html.T("Personnel.Email", "E-posta") <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" data-bind="value: email" required placeholder="ornek@email.com">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Html.T("Personnel.Phone", "Telefon")</label>
                            <input type="tel" class="form-control" data-bind="value: phoneNumber" placeholder="0532 123 4567">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Html.T("Personnel.Role", "Rol") <span class="text-danger">*</span></label>
                            <select class="form-select" data-bind="value: role" required>
                                <option value="0">Admin</option>
                                <option value="1">Manager</option>
                                <option value="2">QualitySpecialist</option>
                                <option value="3">FieldWorker</option>
                            </select>
                        </div>

                        <!-- Şifre (sadece yeni oluşturmada) -->
                        <!-- ko ifnot: id -->
                        <div class="col-12">
                            <label class="form-label">@Html.T("Personnel.Password", "Şifre") <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" data-bind="value: password" required placeholder="En az 6 karakter">
                        </div>
                        <!-- /ko -->

                        <div class="col-12">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="isActive" data-bind="checked: isActive">
                                <label class="form-check-label" for="isActive">@Html.T("Common.Active", "Aktif")</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-primary" data-bind="click: $parent.savePersonnel, disable: $parent.isSaving">
                        <span data-bind="visible: !$parent.isSaving()">
                            <i class="bi bi-check-circle me-2"></i>@Html.T("Common.Save", "Kaydet")
                        </span>
                        <span data-bind="visible: $parent.isSaving">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            @Html.T("Common.Saving", "Kaydediliyor...")
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Change Password Modal -->
    <div class="modal fade" id="passwordModal" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-key me-2"></i>@Html.T("Personnel.ChangePassword", "Şifre Değiştir")
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div data-bind="visible: passwordError()" class="alert alert-danger alert-dismissible mb-3">
                        <span data-bind="text: passwordError()"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Personnel.NewPassword", "Yeni Şifre") <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" data-bind="value: newPassword" placeholder="En az 6 karakter">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Personnel.ConfirmPassword", "Şifre Tekrar") <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" data-bind="value: confirmPassword">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Cancel", "İptal")</button>
                    <button type="button" class="btn btn-warning" data-bind="click: savePassword, disable: isSavingPassword">
                        <span data-bind="visible: !isSavingPassword()">
                            <i class="bi bi-check-circle me-2"></i>@Html.T("Common.Save", "Kaydet")
                        </span>
                        <span data-bind="visible: isSavingPassword">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Shared/api.service.js"></script>
    <script src="~/js/Shared/delete-confirmation.js"></script>
    <script src="~/js/Personnel/Index.js"></script>
}
