@{
    ViewData["Title"] = "Personel Yönetimi";
}

<div id="personnel-app">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-people-fill me-2"></i>Personel Yönetimi
        </h2>
        <button class="btn btn-primary" data-bind="click: createNew">
            <i class="bi bi-plus-circle me-1"></i>Yeni Personel
        </button>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Arama</label>
                    <input type="text" class="form-control" placeholder="Ad, Soyad, TC, Sicil No..."
                           data-bind="value: filter.searchTerm, valueUpdate: 'afterkeydown'">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Şube</label>
                    <select class="form-select" data-bind="value: filter.branchId, options: branches, optionsValue: 'id', optionsText: 'name', optionsCaption: 'Tümü'"></select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Müşteri</label>
                    <select class="form-select" data-bind="value: filter.customerId, options: customers, optionsValue: 'id', optionsText: 'companyName', optionsCaption: 'Tümü'"></select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Durum</label>
                    <select class="form-select" data-bind="value: filter.isActive">
                        <option value="">Tümü</option>
                        <option value="true">Aktif</option>
                        <option value="false">Pasif</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button class="btn btn-primary" data-bind="click: applyFilters">
                        <i class="bi bi-search me-1"></i>Filtrele
                    </button>
                    <button class="btn btn-outline-secondary" data-bind="click: clearFilters">
                        <i class="bi bi-x-lg me-1"></i>Temizle
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Yükleniyor...</span>
        </div>
        <p class="mt-2 text-muted">Personel listesi yükleniyor...</p>
    </div>

    <!-- Error Message -->
    <div data-bind="visible: errorMessage" class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <span data-bind="text: errorMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { errorMessage(''); }"></button>
    </div>

    <!-- Success Message -->
    <div data-bind="visible: successMessage" class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>
        <span data-bind="text: successMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { successMessage(''); }"></button>
    </div>

    <!-- Personnel Table -->
    <div data-bind="visible: !isLoading()">
        <div class="card shadow-sm">
            <div class="card-body">
                <!-- Summary -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted">
                        Toplam <strong data-bind="text: paginationInfo().totalCount"></strong> personel
                    </span>
                </div>

                <!-- Empty State -->
                <div data-bind="visible: personnel().length === 0" class="text-center py-5">
                    <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
                    <p class="mt-3 text-muted">Henüz personel kaydı bulunmamaktadır.</p>
                </div>

                <!-- Table -->
                <div data-bind="visible: personnel().length > 0" class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Ad Soyad</th>
                                <th>Sicil No</th>
                                <th>TC Kimlik</th>
                                <th>Unvan</th>
                                <th>Şube</th>
                                <th>Telefon</th>
                                <th>Değerlendirme</th>
                                <th>Durum</th>
                                <th style="width: 120px;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: personnel">
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 40px; height: 40px;">
                                            <i class="bi bi-person text-primary"></i>
                                        </div>
                                        <div>
                                            <div class="fw-medium" data-bind="text: fullName"></div>
                                            <small class="text-muted" data-bind="text: email || '-'"></small>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-secondary" data-bind="text: sicilNo || '-'"></span></td>
                                <td><small data-bind="text: tcKimlikNo ? tcKimlikNo.substring(0, 3) + '****' + tcKimlikNo.substring(7) : '-'"></small></td>
                                <td data-bind="text: title || '-'"></td>
                                <td data-bind="text: branchName || '-'"></td>
                                <td data-bind="text: phoneNumber || '-'"></td>
                                <td>
                                    <span class="badge bg-info" data-bind="text: evaluationCount + ' adet'"></span>
                                    <span data-bind="visible: averageScore" class="badge bg-success ms-1">
                                        <span data-bind="text: averageScore ? averageScore.toFixed(1) + '%' : ''"></span>
                                    </span>
                                </td>
                                <td>
                                    <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? 'Aktif' : 'Pasif'"></span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" title="Düzenle" data-bind="click: $parent.editPersonnel">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" title="Sil" data-bind="click: $parent.deletePersonnel">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div data-bind="visible: paginationInfo().totalPages > 1" class="d-flex justify-content-between align-items-center mt-3">
                    <div class="text-muted">
                        Sayfa <span data-bind="text: filter.page"></span> / <span data-bind="text: paginationInfo().totalPages"></span>
                    </div>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item" data-bind="css: { disabled: !paginationInfo().hasPreviousPage }">
                                <a class="page-link" href="#" data-bind="click: previousPage">Önceki</a>
                            </li>
                            <!-- ko foreach: pageNumbers -->
                            <li class="page-item" data-bind="css: { active: $data === $parent.filter.page() }">
                                <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                            </li>
                            <!-- /ko -->
                            <li class="page-item" data-bind="css: { disabled: !paginationInfo().hasNextPage }">
                                <a class="page-link" href="#" data-bind="click: nextPage">Sonraki</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>

    <!-- Create/Edit Modal -->
    <div class="modal fade" id="personnelModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" data-bind="with: editingPersonnel">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-person-plus me-2"></i>
                        <span data-bind="visible: !id">Yeni Personel</span>
                        <span data-bind="visible: id">Personel Düzenle</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <!-- Kişisel Bilgiler -->
                        <div class="col-12">
                            <h6 class="text-primary"><i class="bi bi-person me-1"></i>Kişisel Bilgiler</h6>
                            <hr class="mt-1">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Ad <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: firstName" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Soyad <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: lastName" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">TC Kimlik No</label>
                            <input type="text" class="form-control" maxlength="11" data-bind="value: tcKimlikNo" placeholder="11 haneli">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Cinsiyet</label>
                            <select class="form-select" data-bind="value: gender">
                                <option value="0">Belirtilmemiş</option>
                                <option value="1">Erkek</option>
                                <option value="2">Kadın</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Doğum Tarihi</label>
                            <input type="date" class="form-control" data-bind="value: birthDate">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">İşe Başlama Tarihi</label>
                            <input type="date" class="form-control" data-bind="value: hireDate">
                        </div>

                        <!-- İş Bilgileri -->
                        <div class="col-12 mt-4">
                            <h6 class="text-primary"><i class="bi bi-briefcase me-1"></i>İş Bilgileri</h6>
                            <hr class="mt-1">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Sicil No</label>
                            <input type="text" class="form-control" data-bind="value: sicilNo">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">ERP No</label>
                            <input type="text" class="form-control" data-bind="value: erpNo">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Unvan</label>
                            <input type="text" class="form-control" data-bind="value: title" placeholder="Müşteri Temsilcisi">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Departman</label>
                            <input type="text" class="form-control" data-bind="value: department" placeholder="Müşteri Hizmetleri">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Şube</label>
                            <select class="form-select" data-bind="value: branchId, options: $parent.branches, optionsValue: 'id', optionsText: 'name', optionsCaption: 'Seçiniz...'"></select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Müşteri</label>
                            <select class="form-select" data-bind="value: customerId, options: $parent.customers, optionsValue: 'id', optionsText: 'companyName', optionsCaption: 'Seçiniz...'"></select>
                        </div>

                        <!-- İletişim Bilgileri -->
                        <div class="col-12 mt-4">
                            <h6 class="text-primary"><i class="bi bi-telephone me-1"></i>İletişim Bilgileri</h6>
                            <hr class="mt-1">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">E-posta</label>
                            <input type="email" class="form-control" data-bind="value: email" placeholder="ornek@email.com">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Telefon</label>
                            <input type="tel" class="form-control" data-bind="value: phoneNumber" placeholder="0532 123 4567">
                        </div>

                        <!-- Diğer -->
                        <div class="col-12 mt-4">
                            <h6 class="text-primary"><i class="bi bi-info-circle me-1"></i>Diğer</h6>
                            <hr class="mt-1">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notlar</label>
                            <textarea class="form-control" rows="2" data-bind="value: notes" placeholder="Personel hakkında notlar..."></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="isActive" data-bind="checked: isActive">
                                <label class="form-check-label" for="isActive">Aktif</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-primary" data-bind="click: $parent.savePersonnel, disable: $parent.isSaving">
                        <span data-bind="visible: !$parent.isSaving()">
                            <i class="bi bi-check-lg me-1"></i>Kaydet
                        </span>
                        <span data-bind="visible: $parent.isSaving">
                            <span class="spinner-border spinner-border-sm me-1"></span>Kaydediliyor...
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Personnel/Index.js"></script>
}
