@{
    ViewData["Title"] = Html.T("GolgeMusteri.Sorular", "Sorular");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="sorular-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0">
                <i class="bi bi-question-circle me-2"></i>@Html.T("GolgeMusteri.Sorular", "Sorular")
            </h4>
        </div>
        <div class="btn-group">
            <button class="btn btn-primary" data-bind="click: showCreateModal">
                <i class="bi bi-plus me-1"></i> Yeni Soru
            </button>
            <button class="btn btn-success" data-bind="click: showImportModal">
                <i class="bi bi-file-earmark-excel me-1"></i> Excel Import
            </button>
        </div>
    </div>

    <!-- Filtre -->
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-3">
                    <select class="form-select form-select-sm" data-bind="options: donemler, optionsText: 'ad', optionsValue: 'id', value: selectedDonemId, optionsCaption: '-- Dönem --'"></select>
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" data-bind="options: customers, optionsText: 'companyName', optionsValue: 'id', value: selectedCustomerId, optionsCaption: '-- Müşteri --'"></select>
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" data-bind="options: hedefFirmalar, optionsText: 'firmaAdi', optionsValue: 'id', value: selectedHedefFirmaId, optionsCaption: '-- Hedef Firma --', enable: selectedCustomerId()"></select>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>

    <!-- Tablo -->
    <div class="card" data-bind="visible: !isLoading()">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;">Sıra</th>
                            <th>Dönem</th>
                            <th>Soru</th>
                            <th>Hedef Firma</th>
                            <th>Beklenen Cevap</th>
                            <th>Aranma</th>
                            <th>Kuponlu</th>
                            <th style="width: 120px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: sorular">
                        <tr>
                            <td data-bind="text: siraNo"></td>
                            <td><small class="text-muted" data-bind="text: donemAdi || '-'"></small></td>
                            <td>
                                <span data-bind="text: soruMetni.length > 80 ? soruMetni.substring(0, 80) + '...' : soruMetni"></span>
                            </td>
                            <td data-bind="text: hedefFirmaAdi || '-'"></td>
                            <td>
                                <small class="text-muted" data-bind="text: beklenenCevap ? (beklenenCevap.length > 50 ? beklenenCevap.substring(0, 50) + '...' : beklenenCevap) : '-'"></small>
                            </td>
                            <td><span class="badge bg-info" data-bind="text: aranmaSayisi"></span></td>
                            <td>
                                <span class="badge bg-warning text-dark" data-bind="visible: isKuponlu">Kuponlu</span>
                                <span data-bind="visible: !isKuponlu">-</span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary" data-bind="click: $parent.showEditModal" title="Düzenle">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" data-bind="click: $parent.deleteSoru" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div data-bind="visible: !isLoading() && sorular().length === 0" class="text-center text-muted py-4">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                Henüz soru eklenmemiş.
            </div>
        </div>
    </div>

    <!-- Import Modal -->
    <div class="modal fade" id="importDonemModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-file-earmark-excel me-2"></i>Excel Import</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Dönem <span class="text-danger">*</span></label>
                        <select class="form-select" data-bind="options: donemler, optionsText: 'ad', optionsValue: 'id', value: importForm.donemId, optionsCaption: '-- Seçin --'"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Müşteri <span class="text-danger">*</span></label>
                        <select class="form-select" data-bind="options: customers, optionsText: 'companyName', optionsValue: 'id', value: importForm.customerId, optionsCaption: '-- Seçin --'"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Hedef Firma <span class="text-danger">*</span></label>
                        <select class="form-select" data-bind="options: importHedefFirmalar, optionsText: 'firmaAdi', optionsValue: 'id', value: importForm.hedefFirmaId, optionsCaption: '-- Seçin --', enable: importForm.customerId()"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Excel Dosyası <span class="text-danger">*</span></label>
                        <input type="file" class="form-control" id="importFile" accept=".xlsx,.xls">
                    </div>
                    <div class="alert alert-info small mb-0">
                        <i class="bi bi-info-circle me-1"></i> Excel formatı: <strong>Soru</strong> (A), <strong>Beklenen Cevap</strong> (B), <strong>Aranma Sayısı</strong> (C). İlk satır başlık olarak atlanır.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-success" data-bind="click: submitImport, disable: isImporting">
                        <span data-bind="visible: isImporting" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-upload me-1"></i> Import Et
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="soruModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" data-bind="text: isEditing() ? 'Soru Düzenle' : 'Yeni Soru'"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row" data-bind="visible: !isEditing()">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Dönem <span class="text-danger">*</span></label>
                            <select class="form-select" data-bind="options: donemler, optionsText: 'ad', optionsValue: 'id', value: form.donemId, optionsCaption: '-- Seçin --'"></select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Müşteri <span class="text-danger">*</span></label>
                            <select class="form-select" data-bind="options: customers, optionsText: 'companyName', optionsValue: 'id', value: form.customerId, optionsCaption: '-- Seçin --'"></select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Hedef Firma <span class="text-danger">*</span></label>
                            <select class="form-select" data-bind="options: modalHedefFirmalar, optionsText: 'firmaAdi', optionsValue: 'id', value: form.gmHedefFirmaId, optionsCaption: '-- Seçin --', enable: form.customerId()"></select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Soru Metni <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="3" data-bind="value: form.soruMetni" maxlength="2000"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Beklenen Cevap</label>
                        <textarea class="form-control" rows="3" data-bind="value: form.beklenenCevap" maxlength="2000"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Aranma Sayısı</label>
                            <input type="number" class="form-control" data-bind="value: form.aranmaSayisi" min="1" max="100">
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Sıra No</label>
                            <input type="number" class="form-control" data-bind="value: form.siraNo" min="0">
                        </div>
                        <div class="col-md-3 mb-3 d-flex align-items-end">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="soruIsKuponlu" data-bind="checked: form.isKuponlu">
                                <label class="form-check-label" for="soruIsKuponlu">Kuponlu</label>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3" data-bind="visible: form.isKuponlu()">
                            <label class="form-label">Kupon Kodu</label>
                            <input type="text" class="form-control" data-bind="value: form.kuponKodu" maxlength="100">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-primary" data-bind="click: saveSoru, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/GolgeMusteri/sorular.js" asp-append-version="true"></script>
}
