@{
    ViewData["Title"] = Html.T("GolgeMusteri.Donemler", "Dönemler");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="donemler-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0">
                <i class="bi bi-calendar3 me-2"></i>@Html.T("GolgeMusteri.Donemler", "Dönemler")
            </h4>
        </div>
        <button class="btn btn-primary" data-bind="click: showCreateModal">
            <i class="bi bi-plus me-1"></i> Yeni Dönem
        </button>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>

    <!-- Dönem Listesi -->
    <div data-bind="visible: !isLoading() && !selectedDonem()">
        <div class="row g-3" data-bind="foreach: donemler">
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="card-title mb-0" data-bind="text: ad"></h6>
                            <span class="badge" data-bind="text: durumText, attr: { class: 'badge ' + durumCss }"></span>
                        </div>
                        <div class="small">
                            <div><i class="bi bi-calendar me-1"></i> <span data-bind="text: new Date(baslangicTarihi).toLocaleDateString('tr-TR')"></span> - <span data-bind="text: new Date(bitisTarihi).toLocaleDateString('tr-TR')"></span></div>
                            <div class="mt-1">
                                <span class="badge bg-light text-dark me-1"><i class="bi bi-people me-1"></i><span data-bind="text: personelSayisi"></span> Personel</span>
                                <span class="badge bg-light text-dark"><i class="bi bi-question-circle me-1"></i><span data-bind="text: soruSayisi"></span> Soru</span>
                            </div>
                            <!-- ko if: toplamAtama > 0 -->
                            <div class="mt-2">
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-success" data-bind="style: { width: Math.round(tamamlananAtama / toplamAtama * 100) + '%' }"></div>
                                </div>
                                <small class="text-muted"><span data-bind="text: tamamlananAtama"></span>/<span data-bind="text: toplamAtama"></span> tamamlandı</small>
                            </div>
                            <!-- /ko -->
                        </div>
                    </div>
                    <div class="card-footer bg-transparent">
                        <div class="btn-group btn-group-sm w-100">
                            <button class="btn btn-outline-primary" data-bind="click: $parent.openDonem" title="Detay">
                                <i class="bi bi-eye me-1"></i> Detay
                            </button>
                            <button class="btn btn-outline-info" data-bind="click: $parent.showCopyDonem" title="Kopyala">
                                <i class="bi bi-copy"></i>
                            </button>
                            <!-- ko if: durumId === 1 -->
                            <button class="btn btn-outline-secondary" data-bind="click: $parent.showEditModal" title="Düzenle">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-outline-danger" data-bind="click: $parent.deleteDonem" title="Sil">
                                <i class="bi bi-trash"></i>
                            </button>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div data-bind="visible: !isLoading() && donemler().length === 0" class="text-center text-muted py-4">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            Henüz dönem oluşturulmamış.
        </div>
    </div>

    <!-- Dönem Detay -->
    <div data-bind="visible: selectedDonem()">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <button class="btn btn-sm btn-outline-secondary me-2" data-bind="click: closeDonem">
                    <i class="bi bi-arrow-left me-1"></i> Geri
                </button>
                <strong data-bind="text: selectedDonem() ? selectedDonem().ad : ''"></strong>
                <span class="badge ms-2" data-bind="text: selectedDonem() ? selectedDonem().durumText : '', attr: { class: 'badge ms-2 ' + (selectedDonem() ? selectedDonem().durumCss : '') }"></span>
            </div>
            <div>
                <!-- ko if: selectedDonem() && selectedDonem().durumId === 1 -->
                <button class="btn btn-success btn-sm" data-bind="click: aktifEt">
                    <i class="bi bi-play-fill me-1"></i> Aktif Et
                </button>
                <!-- /ko -->
                <!-- ko if: selectedDonem() && selectedDonem().durumId === 2 -->
                <button class="btn btn-primary btn-sm" data-bind="click: tamamla">
                    <i class="bi bi-check-circle me-1"></i> Tamamla
                </button>
                <!-- /ko -->
            </div>
        </div>

        <!-- Tabs -->
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-personel">
                    <i class="bi bi-people me-1"></i> Personel <span class="badge bg-primary ms-1" data-bind="text: donemDetail() ? donemDetail().personeller.length : 0"></span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-soru">
                    <i class="bi bi-question-circle me-1"></i> Sorular <span class="badge bg-primary ms-1" data-bind="text: donemDetail() ? donemDetail().sorular.length : 0"></span>
                </button>
            </li>
        </ul>

        <div class="tab-content">
            <!-- Personel Tab -->
            <div class="tab-pane fade show active" id="tab-personel">
                <div class="card border-top-0 rounded-top-0">
                    <div class="card-body">
                        <!-- ko if: selectedDonem() && selectedDonem().durumId === 1 -->
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <select class="form-select form-select-sm" data-bind="options: availableUsers, optionsText: function(u) { return u.firstName + ' ' + u.lastName; }, optionsValue: 'id', value: newPersonelUserId, optionsCaption: '-- Personel Seçin --'"></select>
                            </div>
                            <div class="col-auto">
                                <button class="btn btn-sm btn-primary" data-bind="click: addPersonel, disable: !newPersonelUserId()">
                                    <i class="bi bi-plus"></i> Ekle
                                </button>
                            </div>
                        </div>
                        <!-- /ko -->
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Personel</th>
                                    <!-- ko if: selectedDonem() && selectedDonem().durumId === 1 -->
                                    <th style="width: 60px;"></th>
                                    <!-- /ko -->
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: donemDetail() ? donemDetail().personeller : []">
                                <tr>
                                    <td data-bind="text: userName || '-'"></td>
                                    <!-- ko if: $parent.selectedDonem() && $parent.selectedDonem().durumId === 1 -->
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.removePersonel">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </td>
                                    <!-- /ko -->
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Soru Tab -->
            <div class="tab-pane fade" id="tab-soru">
                <div class="card border-top-0 rounded-top-0">
                    <div class="card-body">
                        <!-- ko if: selectedDonem() && selectedDonem().durumId === 1 -->
                        <div class="mb-3">
                            <button class="btn btn-sm btn-primary me-2" data-bind="click: showAddSoruModal">
                                <i class="bi bi-plus me-1"></i> Soru Ekle
                            </button>
                            <button class="btn btn-sm btn-outline-success me-2" data-bind="click: showImportModal">
                                <i class="bi bi-file-earmark-excel me-1"></i> Excel Import
                            </button>
                            <button class="btn btn-sm btn-outline-info" data-bind="click: showImportMatchModal">
                                <i class="bi bi-file-earmark-excel me-1"></i> Excel Import (Firma Eşleştirmeli)
                            </button>
                        </div>
                        <!-- /ko -->
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Müşteri</th>
                                    <th>Firma</th>
                                    <th>Soru</th>
                                    <th>Aranma</th>
                                    <th>Kupon Kodu</th>
                                    <!-- ko if: selectedDonem() && selectedDonem().durumId === 1 -->
                                    <th style="width: 100px;"></th>
                                    <!-- /ko -->
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: donemDetail() ? donemDetail().sorular : []">
                                <tr>
                                    <td><small data-bind="text: musteriAdi || '-'"></small></td>
                                    <td data-bind="text: hedefFirmaAdi || '-'"></td>
                                    <td><small data-bind="text: soruMetni ? (soruMetni.length > 60 ? soruMetni.substring(0,60)+'...' : soruMetni) : '-'"></small></td>
                                    <td><span class="badge bg-info" data-bind="text: aranmaSayisi"></span></td>
                                    <td>
                                        <!-- ko if: isKuponlu -->
                                        <code data-bind="text: kuponKodu || '-'"></code>
                                        <!-- /ko -->
                                        <!-- ko ifnot: isKuponlu -->
                                        <span class="text-muted">-</span>
                                        <!-- /ko -->
                                    </td>
                                    <!-- ko if: $parent.selectedDonem() && $parent.selectedDonem().durumId === 1 -->
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-sm btn-outline-primary" data-bind="click: $parent.showEditSoruModal" title="Düzenle">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.removeSoru" title="Sil">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <!-- /ko -->
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Soru Ekle/Düzenle Modal -->
    <div class="modal fade" id="soruEkleModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" data-bind="text: soruIsEditing() ? 'Soru Düzenle' : 'Soru Ekle'"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row" data-bind="visible: !soruIsEditing()">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Müşteri <span class="text-danger">*</span></label>
                            <select class="form-select" data-bind="options: customers, optionsText: 'companyName', optionsValue: 'id', value: soruForm.customerId, optionsCaption: '-- Seçin --'"></select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Hedef Firma <span class="text-danger">*</span></label>
                            <select class="form-select" data-bind="options: hedefFirmalar, optionsText: 'firmaAdi', optionsValue: 'id', value: soruForm.gmHedefFirmaId, optionsCaption: '-- Seçin --', enable: soruForm.customerId()"></select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Soru Metni <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="3" data-bind="value: soruForm.soruMetni" maxlength="2000"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Beklenen Cevap</label>
                        <textarea class="form-control" rows="2" data-bind="value: soruForm.beklenenCevap" maxlength="2000"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Aranma Sayısı</label>
                            <input type="number" class="form-control" data-bind="value: soruForm.aranmaSayisi" min="1" max="100">
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Sıra No</label>
                            <input type="number" class="form-control" data-bind="value: soruForm.siraNo" min="0">
                        </div>
                        <div class="col-md-3 mb-3 d-flex align-items-end">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="donemSoruIsKuponlu" data-bind="checked: soruForm.isKuponlu">
                                <label class="form-check-label" for="donemSoruIsKuponlu">Kuponlu</label>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3" data-bind="visible: soruForm.isKuponlu()">
                            <label class="form-label">Kupon Kodu</label>
                            <input type="text" class="form-control" data-bind="value: soruForm.kuponKodu" maxlength="100">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-primary" data-bind="click: saveSoruForm, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Excel Import Modal -->
    <div class="modal fade" id="importSoruModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-file-earmark-excel me-2"></i>Excel Import</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Müşteri <span class="text-danger">*</span></label>
                        <select class="form-select" data-bind="options: importCustomers, optionsText: 'companyName', optionsValue: 'id', value: importForm.customerId, optionsCaption: '-- Seçin --'"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Hedef Firma <span class="text-danger">*</span></label>
                        <select class="form-select" data-bind="options: importHedefFirmalar, optionsText: 'firmaAdi', optionsValue: 'id', value: importForm.hedefFirmaId, optionsCaption: '-- Seçin --', enable: importForm.customerId()"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Excel Dosyası <span class="text-danger">*</span></label>
                        <input type="file" class="form-control" id="importFile" accept=".xlsx,.xls">
                    </div>
                    <div class="alert alert-info small mb-0">
                        <i class="bi bi-info-circle me-1"></i> Excel formatı: <strong>Soru</strong> (A), <strong>Beklenen Cevap</strong> (B), <strong>Aranma Sayısı</strong> (C). İlk satır başlık olarak atlanır.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-success" data-bind="click: submitImport, disable: isImporting">
                        <span data-bind="visible: isImporting" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-upload me-1"></i> Import Et
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Excel Import (Firma Eşleştirmeli) Modal -->
    <div class="modal fade" id="importMatchModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-file-earmark-excel me-2"></i>Excel Import (Firma Eşleştirmeli)</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Excel Dosyası <span class="text-danger">*</span></label>
                        <input type="file" class="form-control" id="importMatchFile" accept=".xlsx,.xls">
                    </div>
                    <div class="alert alert-info small mb-0">
                        <i class="bi bi-info-circle me-1"></i> Excel formatı: <strong>Hedef Firma</strong> (A), <strong>Soru</strong> (B), <strong>Beklenen Cevap</strong> (C), <strong>Aranma Sayısı</strong> (D). İlk satır başlık olarak atlanır.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-success" data-bind="click: submitImportMatch, disable: isImportingMatch">
                        <span data-bind="visible: isImportingMatch" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-upload me-1"></i> Import Et
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Import Sonuç Modal -->
    <div class="modal fade" id="importResultModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-list-check me-2"></i>Import Sonuçları</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Bulunamayanlar -->
                    <!-- ko if: importResultUnmatched().length > 0 -->
                    <h6 class="text-danger mb-2">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Hedef Firma Eşleşmeyenler (<span data-bind="text: importResultUnmatched().length"></span>)
                    </h6>
                    <div class="table-responsive mb-4">
                        <table class="table table-sm table-bordered align-middle mb-0">
                            <thead class="table-warning">
                                <tr>
                                    <th style="width:50px;">Satır</th>
                                    <th>Excel'deki Firma Adı</th>
                                    <th>Soru</th>
                                    <th style="width:250px;">Hedef Firma Seçin</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: importResultUnmatched">
                                <tr>
                                    <td data-bind="text: rowIndex"></td>
                                    <td><span class="text-danger fw-bold" data-bind="text: excelHedefFirmaAdi"></span></td>
                                    <td>
                                        <span data-bind="text: soruMetni.length > 60 ? soruMetni.substring(0, 60) + '...' : soruMetni"></span>
                                        <!-- ko if: beklenenCevap -->
                                        <br><small class="text-muted" data-bind="text: 'Cevap: ' + beklenenCevap"></small>
                                        <!-- /ko -->
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm" data-bind="options: $parent.importResultHedefFirmalar, optionsText: 'displayName', optionsValue: 'id', value: selectedHedefFirmaId, optionsCaption: '-- Seçin --'"></select>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- /ko -->

                    <!-- Bulunanlar -->
                    <!-- ko if: importResultMatched().length > 0 -->
                    <h6 class="text-success mb-2">
                        <i class="bi bi-check-circle me-1"></i>
                        Başarıyla Eşleşenler (<span data-bind="text: importResultMatched().length"></span>)
                    </h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle mb-0">
                            <thead class="table-success">
                                <tr>
                                    <th>Hedef Firma</th>
                                    <th>Soru</th>
                                    <th>Beklenen Cevap</th>
                                    <th style="width:80px;">Aranma</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: importResultMatched">
                                <tr>
                                    <td data-bind="text: hedefFirmaAdi"></td>
                                    <td data-bind="text: soruMetni.length > 60 ? soruMetni.substring(0, 60) + '...' : soruMetni"></td>
                                    <td><small class="text-muted" data-bind="text: beklenenCevap || '-'"></small></td>
                                    <td><span class="badge bg-info" data-bind="text: aranmaSayisi"></span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- /ko -->

                    <!-- ko if: importResultUnmatched().length === 0 && importResultMatched().length === 0 -->
                    <div class="text-center text-muted py-3">
                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                        Import edilecek veri bulunamadı.
                    </div>
                    <!-- /ko -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                    <!-- ko if: importResultUnmatched().length > 0 -->
                    <button type="button" class="btn btn-primary" data-bind="click: saveUnmatchedSorular, disable: isSavingUnmatched">
                        <span data-bind="visible: isSavingUnmatched" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-save me-1"></i> Seçilenleri Kaydet
                    </button>
                    <!-- /ko -->
                </div>
            </div>
        </div>
    </div>

    <!-- Dönem Kopyala Modal -->
    <div class="modal fade" id="copyDonemModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-copy me-2"></i>Dönem Kopyala</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Dönem Adı <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" data-bind="value: copyForm.ad" maxlength="200">
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Başlangıç Tarihi <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" data-bind="value: copyForm.baslangicTarihi">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Bitiş Tarihi <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" data-bind="value: copyForm.bitisTarihi">
                        </div>
                    </div>
                    <div class="alert alert-info small mb-0">
                        <i class="bi bi-info-circle me-1"></i> Personeller ve sorular kopyalanacak, kuponlar kopyalanmayacaktır.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-info" data-bind="click: saveCopyDonem, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-copy me-1"></i> Kopyala
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Dönem Oluştur/Düzenle Modal -->
    <div class="modal fade" id="donemModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" data-bind="text: isEditing() ? 'Dönem Düzenle' : 'Yeni Dönem'"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Dönem Adı <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" data-bind="value: form.ad" maxlength="200" placeholder="Örn: Mart 2026">
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Başlangıç Tarihi <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" data-bind="value: form.baslangicTarihi">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Bitiş Tarihi <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" data-bind="value: form.bitisTarihi">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-primary" data-bind="click: saveDonem, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/GolgeMusteri/donemler.js" asp-append-version="true"></script>
}
