@{
    ViewData["Title"] = Html.T("GolgeMusteri.Aramalarim", "Aramalarım");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="aramalarim-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0">
                <i class="bi bi-telephone me-2"></i>@Html.T("GolgeMusteri.Aramalarim", "Aramalarım")
            </h4>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3" data-bind="visible: showTabs">
        <li class="nav-item">
            <a class="nav-link" href="#" data-bind="css: { active: activeTab() === 'aramalarim' }, click: function() { activeTab('aramalarim'); }">
                <i class="bi bi-telephone-outbound me-1"></i> @Html.T("GolgeMusteri.Aramalarim", "Aramalarım")
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="#" data-bind="css: { active: activeTab() === 'aramalar' }, click: function() { activeTab('aramalar'); }">
                <i class="bi bi-telephone-inbound me-1"></i> @Html.T("GolgeMusteri.TamamlananAramalar", "Aramalar")
                <!-- ko if: tamamlananAramalar().length > 0 -->
                <span class="badge bg-primary ms-1" data-bind="text: tamamlananAramalar().length"></span>
                <!-- /ko -->
            </a>
        </li>
    </ul>

    <!-- ==================== TAB 1: ARAMALARIM ==================== -->
    <div data-bind="visible: activeTab() === 'aramalarim'">
        <!-- Filtreler (chip-based pattern - internalEvaluations.js referans) -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body py-2">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <!-- Add Filter Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-outline-success btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                            <i class="bi bi-plus-circle me-1"></i>@Html.T("Common.AddFilter", "Filtre Ekle")
                        </button>
                        <div class="dropdown-menu p-3" style="min-width: 300px;">
                            <!-- Filter Type Selector -->
                            <div class="mb-2">
                                <select class="form-select form-select-sm" data-bind="value: selectedFilterType">
                                    <option value="">@Html.T("Common.SelectFilter", "Filtre Seçin...")</option>
                                    <option value="donem">@Html.T("GolgeMusteri.Donem", "Dönem")</option>
                                    <option value="durum">@Html.T("Common.Status", "Durum")</option>
                                    <option value="firma">@Html.T("GolgeMusteri.HedefFirma", "Firma")</option>
                                    <option value="dateRange">@Html.T("Common.DateRange", "Tarih Aralığı")</option>
                                </select>
                            </div>
                            <!-- Dönem -->
                            <div data-bind="visible: selectedFilterType() === 'donem'" class="mb-2">
                                <select class="form-select form-select-sm" data-bind="options: donemler, optionsText: 'ad', optionsValue: 'id', value: tempFilter.donemId, optionsCaption: '@Html.T("Common.Select", "Seçin...")'"></select>
                            </div>
                            <!-- Durum -->
                            <div data-bind="visible: selectedFilterType() === 'durum'" class="mb-2">
                                <select class="form-select form-select-sm" data-bind="value: tempFilter.durumId">
                                    <option value="">@Html.T("Common.Select", "Seçin...")</option>
                                    <option value="1">Beklemede</option>
                                    <option value="2">Tamamlandı</option>
                                </select>
                            </div>
                            <!-- Firma (text) -->
                            <div data-bind="visible: selectedFilterType() === 'firma'" class="mb-2">
                                <input type="text" class="form-control form-control-sm" autocomplete="off" data-bind="value: tempFilter.firma" placeholder="@Html.T("GolgeMusteri.HedefFirma", "Firma adı...")">
                            </div>
                            <!-- Date Range -->
                            <div data-bind="visible: selectedFilterType() === 'dateRange'" class="mb-2">
                                <div class="d-flex gap-1 mb-1">
                                    <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.startDate">
                                    <span class="align-self-center">-</span>
                                    <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.endDate">
                                </div>
                                <div class="d-flex flex-wrap gap-1">
                                    <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('today'); }, css: tempFilter.dateRangeType() === 'today' ? 'btn-success' : 'btn-outline-secondary'">@Html.T("Common.Today", "Bugün")</button>
                                    <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('yesterday'); }, css: tempFilter.dateRangeType() === 'yesterday' ? 'btn-success' : 'btn-outline-secondary'">@Html.T("Common.Yesterday", "Dün")</button>
                                    <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('thisWeek'); }, css: tempFilter.dateRangeType() === 'thisWeek' ? 'btn-success' : 'btn-outline-secondary'">@Html.T("Common.ThisWeek", "Bu Hafta")</button>
                                    <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('lastWeek'); }, css: tempFilter.dateRangeType() === 'lastWeek' ? 'btn-success' : 'btn-outline-secondary'">@Html.T("Common.LastWeek", "Geçen Hafta")</button>
                                </div>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('thisMonth'); }, css: tempFilter.dateRangeType() === 'thisMonth' ? 'btn-success' : 'btn-outline-secondary'">@Html.T("Common.ThisMonth", "Bu Ay")</button>
                                    <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('lastMonth'); }, css: tempFilter.dateRangeType() === 'lastMonth' ? 'btn-success' : 'btn-outline-secondary'">@Html.T("Common.LastMonth", "Geçen Ay")</button>
                                    <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('last3Months'); }, css: tempFilter.dateRangeType() === 'last3Months' ? 'btn-success' : 'btn-outline-secondary'">@Html.T("Common.Last3Months", "Son 3 Ay")</button>
                                    <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('last6Months'); }, css: tempFilter.dateRangeType() === 'last6Months' ? 'btn-success' : 'btn-outline-secondary'">@Html.T("Common.Last6Months", "Son 6 Ay")</button>
                                </div>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('thisYear'); }, css: tempFilter.dateRangeType() === 'thisYear' ? 'btn-success' : 'btn-outline-secondary'">@Html.T("Common.ThisYear", "Bu Yıl")</button>
                                    <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('lastYear'); }, css: tempFilter.dateRangeType() === 'lastYear' ? 'btn-success' : 'btn-outline-secondary'">@Html.T("Common.LastYear", "Geçen Yıl")</button>
                                </div>
                            </div>
                            <!-- Add Button -->
                            <button type="button" class="btn btn-success btn-sm w-100" data-bind="click: addFilter, enable: canAddFilter">
                                <i class="bi bi-plus"></i> @Html.T("Common.Add", "Ekle")
                            </button>
                        </div>
                    </div>

                    <!-- Active Filters (Chips) -->
                    <!-- ko foreach: activeFilters -->
                    <span class="badge bg-success d-flex align-items-center gap-1 py-2 px-2">
                        <span data-bind="text: label"></span>: <strong data-bind="text: displayValue"></strong>
                        <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.6rem;" data-bind="click: $parent.removeFilter"></button>
                    </span>
                    <!-- /ko -->

                    <!-- Clear All -->
                    <button class="btn btn-outline-danger btn-sm" data-bind="visible: activeFilters().length > 0, click: clearFilters">
                        <i class="bi bi-x-circle"></i> @Html.T("Common.ClearAll", "Temizle")
                    </button>
                </div>
            </div>
        </div>

        <!-- Özet -->
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <div class="card text-center border-primary">
                    <div class="card-body py-2">
                        <div class="fs-4 fw-bold text-primary" data-bind="text: atamalar().length"></div>
                        <small class="text-muted">Toplam</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center border-warning">
                    <div class="card-body py-2">
                        <div class="fs-4 fw-bold text-warning" data-bind="text: bekleyenler().length"></div>
                        <small class="text-muted">Bekleyen</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center border-success">
                    <div class="card-body py-2">
                        <div class="fs-4 fw-bold text-success" data-bind="text: tamamlananlar().length"></div>
                        <small class="text-muted">Tamamlanan</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Loading -->
        <div data-bind="visible: isLoading" class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>

        <!-- Bekleyen Aramalar -->
        <div data-bind="visible: !isLoading() && bekleyenler().length > 0">
            <h6 class="mb-3"><i class="bi bi-hourglass-split me-1 text-warning"></i> Bekleyen Aramalar</h6>
            <div class="row g-3" data-bind="foreach: bekleyenler">
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-warning">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="card-title mb-0" data-bind="text: hedefFirmaAdi"></h6>
                                <span class="badge bg-warning text-dark">Beklemede</span>
                            </div>
                            <p class="small mb-1"><i class="bi bi-telephone me-1"></i> <span data-bind="text: hedefFirmaTelefonNo || '-'"></span></p>
                            <p class="small mb-1"><strong>Soru:</strong> <span data-bind="text: soruMetni"></span></p>
                            <!-- ko if: beklenenCevap -->
                            <p class="small mb-1 text-info"><strong>Beklenen:</strong> <span data-bind="text: beklenenCevap"></span></p>
                            <!-- /ko -->
                            <!-- ko if: isKuponlu -->
                            <span class="badge bg-warning text-dark mb-1">Kuponlu</span>
                            <!-- /ko -->
                            <p class="small text-muted mb-0"><i class="bi bi-calendar me-1"></i> Plan: <span data-bind="text: planTarihi ? new Date(planTarihi).toLocaleDateString('tr-TR') : '-'"></span></p>
                        </div>
                        <div class="card-footer bg-transparent">
                            <button class="btn btn-sm btn-success w-100" data-bind="click: $parent.showCompleteModal">
                                <i class="bi bi-check-circle me-1"></i> Tamamla
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tamamlanan Aramalar -->
        <div data-bind="visible: !isLoading() && tamamlananlar().length > 0" class="mt-4">
            <h6 class="mb-3"><i class="bi bi-check-circle me-1 text-success"></i> Tamamlanan Aramalar</h6>
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Firma</th>
                                    <th>Soru</th>
                                    <th>Tarih</th>
                                    <th>Saat</th>
                                    <th>@Html.T("GolgeMusteri.GorusulenTemsilci", "Temsilci")</th>
                                    <th>Not</th>
                                    <th>Kupon</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: tamamlananlar">
                                <tr>
                                    <td data-bind="text: hedefFirmaAdi || '-'"></td>
                                    <td><small data-bind="text: soruMetni ? (soruMetni.length > 40 ? soruMetni.substring(0,40)+'...' : soruMetni) : '-'"></small></td>
                                    <td data-bind="text: gerceklesmeTarihi ? new Date(gerceklesmeTarihi).toLocaleDateString('tr-TR') : '-'"></td>
                                    <td data-bind="text: aramaSaati || '-'"></td>
                                    <td data-bind="text: gorusulenTemsilci || '-'"></td>
                                    <td><small class="text-muted" data-bind="text: not || '-'"></small></td>
                                    <td><code data-bind="text: kuponKodu || '-'"></code></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div data-bind="visible: !isLoading() && atamalar().length === 0" class="text-center text-muted py-5">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            Atanmış aramanız bulunmuyor.
        </div>
    </div>

    <!-- ==================== TAB 2: ARAMALAR (Tamamlanan) ==================== -->
    <div data-bind="visible: activeTab() === 'aramalar'">
        <!-- Loading -->
        <div data-bind="visible: isAramalarLoading" class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>

        <div data-bind="visible: !isAramalarLoading() && tamamlananAramalar().length > 0">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@Html.T("GolgeMusteri.Donem", "Dönem")</th>
                                    <th>@Html.T("GolgeMusteri.HedefFirma", "Firma")</th>
                                    <th>@Html.T("Common.Phone", "Telefon")</th>
                                    <th>@Html.T("Common.Question", "Soru")</th>
                                    <th>@Html.T("GolgeMusteri.Arayan", "Arayan")</th>
                                    <th>@Html.T("Common.Date", "Tarih")</th>
                                    <th>@Html.T("Common.Time", "Saat")</th>
                                    <th>@Html.T("GolgeMusteri.GorusulenTemsilci", "Temsilci")</th>
                                    <th>@Html.T("Common.Note", "Not")</th>
                                    <th>@Html.T("GolgeMusteri.KuponKodu", "Kupon")</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: tamamlananAramalar">
                                <tr style="cursor: pointer;" data-bind="click: $parent.showAtamaDetailModal">
                                    <td data-bind="text: donemAdi || '-'"></td>
                                    <td data-bind="text: hedefFirmaAdi || '-'"></td>
                                    <td data-bind="text: hedefFirmaTelefonNo || '-'"></td>
                                    <td><small data-bind="text: soruMetni ? (soruMetni.length > 30 ? soruMetni.substring(0,30)+'...' : soruMetni) : '-'"></small></td>
                                    <td data-bind="text: userName || '-'"></td>
                                    <td data-bind="text: gerceklesmeTarihi ? new Date(gerceklesmeTarihi).toLocaleDateString('tr-TR') : '-'"></td>
                                    <td data-bind="text: aramaSaati || '-'"></td>
                                    <td data-bind="text: gorusulenTemsilci || '-'"></td>
                                    <td><small class="text-muted" data-bind="text: not ? (not.length > 20 ? not.substring(0,20)+'...' : not) : '-'"></small></td>
                                    <td><code data-bind="text: kuponKodu || '-'"></code></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div data-bind="visible: !isAramalarLoading() && tamamlananAramalar().length === 0" class="text-center text-muted py-5">
            <i class="bi bi-telephone-x fs-1 d-block mb-2"></i>
            @Html.T("GolgeMusteri.NoTamamlananAramalar", "Tamamlanan arama bulunmuyor.")
        </div>
    </div>

    <!-- Atama Detay Modal -->
    <div class="modal fade" id="atamaDetailModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Html.T("GolgeMusteri.AramaDetay", "Arama Detayı")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" data-bind="with: selectedAtama">
                    <table class="table table-sm mb-0">
                        <tbody>
                            <tr>
                                <th class="text-muted" style="width: 35%;">@Html.T("GolgeMusteri.Donem", "Dönem")</th>
                                <td data-bind="text: donemAdi || '-'"></td>
                            </tr>
                            <tr>
                                <th class="text-muted">@Html.T("GolgeMusteri.HedefFirma", "Firma")</th>
                                <td data-bind="text: hedefFirmaAdi || '-'"></td>
                            </tr>
                            <tr>
                                <th class="text-muted">@Html.T("Common.Phone", "Telefon")</th>
                                <td data-bind="text: hedefFirmaTelefonNo || '-'"></td>
                            </tr>
                            <tr>
                                <th class="text-muted">@Html.T("Common.Question", "Soru")</th>
                                <td data-bind="text: soruMetni || '-'"></td>
                            </tr>
                            <!-- ko if: beklenenCevap -->
                            <tr>
                                <th class="text-muted">@Html.T("GolgeMusteri.BeklenenCevap", "Beklenen Cevap")</th>
                                <td data-bind="text: beklenenCevap"></td>
                            </tr>
                            <!-- /ko -->
                            <tr>
                                <th class="text-muted">@Html.T("GolgeMusteri.Arayan", "Arayan")</th>
                                <td data-bind="text: userName || '-'"></td>
                            </tr>
                            <tr>
                                <th class="text-muted">@Html.T("Common.Date", "Tarih")</th>
                                <td data-bind="text: gerceklesmeTarihi ? new Date(gerceklesmeTarihi).toLocaleDateString('tr-TR') : '-'"></td>
                            </tr>
                            <tr>
                                <th class="text-muted">@Html.T("Common.Time", "Saat")</th>
                                <td data-bind="text: aramaSaati || '-'"></td>
                            </tr>
                            <!-- ko if: gorusulenTemsilci -->
                            <tr>
                                <th class="text-muted">@Html.T("GolgeMusteri.GorusulenTemsilci", "Temsilci")</th>
                                <td data-bind="text: gorusulenTemsilci"></td>
                            </tr>
                            <!-- /ko -->
                            <tr>
                                <th class="text-muted">@Html.T("Common.Note", "Not")</th>
                                <td data-bind="text: not || '-'"></td>
                            </tr>
                            <!-- ko if: kuponKodu -->
                            <tr>
                                <th class="text-muted">@Html.T("GolgeMusteri.KuponKodu", "Kupon Kodu")</th>
                                <td><code data-bind="text: kuponKodu"></code></td>
                            </tr>
                            <!-- /ko -->
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Close", "Kapat")</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tamamlama Modal -->
    <div class="modal fade" id="completeModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Aramayı Tamamla</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info mb-3" data-bind="visible: completingAtama()">
                        <strong data-bind="text: completingAtama() ? completingAtama().hedefFirmaAdi : ''"></strong>
                        <span data-bind="text: completingAtama() ? ' - ' + completingAtama().hedefFirmaTelefonNo : ''"></span>
                        <div class="mt-1 small" data-bind="text: completingAtama() ? completingAtama().soruMetni : ''"></div>
                        <!-- ko if: completingAtama() && completingAtama().beklenenCevap -->
                        <div class="mt-1 small text-primary"><strong>Beklenen:</strong> <span data-bind="text: completingAtama().beklenenCevap"></span></div>
                        <!-- /ko -->
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Tarih <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" data-bind="value: completeForm.gerceklesmeTarihi">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Saat <span class="text-danger">*</span></label>
                            <input type="time" class="form-control" data-bind="value: completeForm.aramaSaati">
                        </div>
                    </div>
                    <!-- Görüşülen Temsilci -->
                    <div class="mb-3">
                        <label class="form-label">@Html.T("GolgeMusteri.GorusulenTemsilci", "Görüşülen Temsilci")</label>
                        <div class="position-relative">
                            <input type="text" class="form-control" autocomplete="off"
                                   placeholder="@Html.T("GolgeMusteri.GorusulenTemsilciAra", "Ad soyad yazarak arayın...")"
                                   data-bind="value: completeForm.gorusulenTemsilci, valueUpdate: 'afterkeydown', event: { focus: onTemsilciInputFocus, blur: onTemsilciInputBlur }">
                            <!-- Autocomplete dropdown -->
                            <div class="list-group position-absolute w-100 shadow-sm" style="z-index: 1050; max-height: 200px; overflow-y: auto;"
                                 data-bind="visible: isTemsilciDropdownVisible() && filteredPersonnel().length > 0">
                                <!-- ko foreach: filteredPersonnel -->
                                <button type="button" class="list-group-item list-group-item-action py-1 px-2"
                                        data-bind="click: $parent.selectTemsilci, event: { mousedown: function() { return true; } }">
                                    <small data-bind="text: name"></small>
                                    <!-- ko if: title -->
                                    <small class="text-muted" data-bind="text: ' - ' + title"></small>
                                    <!-- /ko -->
                                </button>
                                <!-- /ko -->
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Not</label>
                        <textarea class="form-control" rows="3" data-bind="value: completeForm.not" maxlength="2000"></textarea>
                    </div>
                    <!-- ko if: completingAtama() && completingAtama().isKuponlu -->
                    <div class="mb-3">
                        <label class="form-label">Kupon Kodu</label>
                        <div class="form-control bg-light" data-bind="text: completingAtama().kuponKodu || '-'"></div>
                    </div>
                    <!-- /ko -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-success" data-bind="click: completeAtama, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        Tamamla
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/GolgeMusteri/aramalarim.js" asp-append-version="true"></script>
}
