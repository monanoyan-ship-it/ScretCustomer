@{
    ViewData["Title"] = Html.T("GolgeMusteri.Takip", "Takip");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="takip-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-clipboard-data me-2"></i>@Html.T("GolgeMusteri.Takip", "Takip")
            </h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/">@Html.T("Menu.Dashboard", "Ana Sayfa")</a></li>
                    <li class="breadcrumb-item active">@Html.T("GolgeMusteri.Takip", "Takip")</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Filtre -->
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-3">
                    <select class="form-select form-select-sm" data-bind="options: donemler, optionsText: 'ad', optionsValue: 'id', value: selectedDonemId, optionsCaption: '-- Dönem Seçin --'"></select>
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" data-bind="options: users, optionsText: function(u) { return u.firstName + ' ' + u.lastName; }, optionsValue: 'id', value: selectedUserId, optionsCaption: '-- Personel --'"></select>
                </div>
                <div class="col-md-2">
                    <select class="form-select form-select-sm" data-bind="value: selectedDurumId">
                        <option value="">-- Durum --</option>
                        <option value="1">Beklemede</option>
                        <option value="2">Tamamlandı</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Özet -->
    <div class="row g-3 mb-3" data-bind="visible: selectedDonemId()">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body py-2">
                    <div class="fs-4 fw-bold text-primary" data-bind="text: atamalar().length"></div>
                    <small class="text-muted">Toplam Atama</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body py-2">
                    <div class="fs-4 fw-bold text-success" data-bind="text: tamamlananSayisi()"></div>
                    <small class="text-muted">Tamamlanan</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body py-2">
                    <div class="fs-4 fw-bold text-warning" data-bind="text: bekleyenSayisi()"></div>
                    <small class="text-muted">Bekleyen</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body py-2">
                    <div class="fs-4 fw-bold" data-bind="text: tamamlanmaOrani() + '%'"></div>
                    <small class="text-muted">Tamamlanma</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>

    <!-- Tablo -->
    <div class="card" data-bind="visible: !isLoading() && selectedDonemId()">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Personel</th>
                            <th>Firma</th>
                            <th>Soru</th>
                            <th>Plan Tarihi</th>
                            <th>Gerçekleşme</th>
                            <th>Saat</th>
                            <th>Durum</th>
                            <th>Not</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: atamalar">
                        <tr>
                            <td data-bind="text: userName || '-'"></td>
                            <td data-bind="text: hedefFirmaAdi || '-'"></td>
                            <td><small data-bind="text: soruMetni ? (soruMetni.length > 40 ? soruMetni.substring(0,40)+'...' : soruMetni) : '-'"></small></td>
                            <td data-bind="text: planTarihi ? new Date(planTarihi).toLocaleDateString('tr-TR') : '-'"></td>
                            <td data-bind="text: gerceklesmeTarihi ? new Date(gerceklesmeTarihi).toLocaleDateString('tr-TR') : '-'"></td>
                            <td data-bind="text: aramaSaati || '-'"></td>
                            <td>
                                <span class="badge" data-bind="text: durumText, attr: { class: 'badge ' + durumCss }"></span>
                            </td>
                            <td><small class="text-muted" data-bind="text: not ? (not.length > 30 ? not.substring(0,30)+'...' : not) : '-'"></small></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div data-bind="visible: !isLoading() && atamalar().length === 0" class="text-center text-muted py-4">
                Atama bulunamadı.
            </div>
        </div>
    </div>

    <div data-bind="visible: !selectedDonemId()" class="text-center text-muted py-5">
        <i class="bi bi-arrow-up fs-1 d-block mb-2"></i>
        Takip için bir dönem seçin.
    </div>
</div>

@section Scripts {
    <script src="~/js/GolgeMusteri/takip.js" asp-append-version="true"></script>
}
