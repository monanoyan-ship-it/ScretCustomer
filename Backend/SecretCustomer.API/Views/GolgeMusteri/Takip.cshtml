@{
    ViewData["Title"] = Html.T("GolgeMusteri.Takip", "Takip");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="takip-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0">
                <i class="bi bi-clipboard-data me-2"></i>@Html.T("GolgeMusteri.Takip", "Takip")
            </h4>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link" data-bind="css: { active: activeTab() === 'aramalar' }, click: function() { activeTab('aramalar'); }" href="#">
                <i class="bi bi-telephone-outbound me-1"></i> @Html.T("GolgeMusteri.Aramalar", "Aramalar")
                <span class="badge bg-primary ms-1" data-bind="text: atamalar().length, visible: selectedDonemId()"></span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bind="css: { active: activeTab() === 'dinlemeler' }, click: function() { activeTab('dinlemeler'); }" href="#">
                <i class="bi bi-headphones me-1"></i> @Html.T("GmDinleme.TakipBaslik", "Dinleme Atamaları")
                <span class="badge bg-info ms-1" data-bind="text: dinlemeler().length, visible: selectedDonemId()"></span>
            </a>
        </li>
    </ul>

    <!-- Filtre -->
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-3">
                    <select class="form-select form-select-sm" data-bind="options: donemler, optionsText: 'ad', optionsValue: 'id', value: selectedDonemId, optionsCaption: '-- Dönem Seçin --'"></select>
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" data-bind="options: users, optionsText: function(u) { return u.firstName + ' ' + u.lastName; }, optionsValue: 'id', value: selectedUserId, optionsCaption: '-- Personel --'"></select>
                </div>
                <!-- Arama durumları -->
                <div class="col-md-2" data-bind="visible: activeTab() === 'aramalar'">
                    <select class="form-select form-select-sm" data-bind="value: selectedAramaDurumId">
                        <option value="">-- Durum --</option>
                        <option value="1">Beklemede</option>
                        <option value="2">Tamamlandı</option>
                    </select>
                </div>
                <!-- Dinleme durumları -->
                <div class="col-md-2" data-bind="visible: activeTab() === 'dinlemeler'">
                    <select class="form-select form-select-sm" data-bind="value: selectedDinlemeDurumId">
                        <option value="">-- Durum --</option>
                        <option value="1">Beklemede</option>
                        <option value="2">Taslak</option>
                        <option value="3">Tamamlandı</option>
                    </select>
                </div>
                <!-- Excel Export -->
                <div class="col-auto" data-bind="visible: activeTab() === 'aramalar' && selectedDonemId()">
                    <button class="btn btn-sm btn-outline-success" data-bind="click: exportExcel">
                        <i class="bi bi-file-earmark-excel me-1"></i>Excel
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== ARAMALAR TAB ==================== -->
    <div data-bind="visible: activeTab() === 'aramalar'">

        <!-- Özet -->
        <div class="row g-3 mb-3" data-bind="visible: selectedDonemId()">
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body py-2">
                        <div class="fs-4 fw-bold text-primary" data-bind="text: atamalar().length"></div>
                        <small class="text-muted">Toplam Atama</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body py-2">
                        <div class="fs-4 fw-bold text-success" data-bind="text: tamamlananSayisi()"></div>
                        <small class="text-muted">Tamamlanan</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body py-2">
                        <div class="fs-4 fw-bold text-warning" data-bind="text: bekleyenSayisi()"></div>
                        <small class="text-muted">Bekleyen</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body py-2">
                        <div class="fs-4 fw-bold" data-bind="text: tamamlanmaOrani() + '%'"></div>
                        <small class="text-muted">Tamamlanma</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Loading -->
        <div data-bind="visible: isAramalarLoading" class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>

        <!-- Tablo -->
        <div class="card" data-bind="visible: !isAramalarLoading() && selectedDonemId()">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Personel</th>
                                <th>Firma</th>
                                <th>Soru</th>
                                <th>Plan Tarihi</th>
                                <th>Gerçekleşme</th>
                                <th>Saat</th>
                                <th>Temsilci</th>
                                <th>Durum</th>
                                <th style="width: 70px;"></th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: atamalar">
                            <tr>
                                <td data-bind="text: userName || '-'"></td>
                                <td data-bind="text: hedefFirmaAdi || '-'"></td>
                                <td><small data-bind="text: soruMetni ? (soruMetni.length > 40 ? soruMetni.substring(0,40)+'...' : soruMetni) : '-'"></small></td>
                                <td data-bind="text: planTarihi ? new Date(planTarihi).toLocaleDateString('tr-TR') : '-'"></td>
                                <td data-bind="text: gerceklesmeTarihi ? new Date(gerceklesmeTarihi).toLocaleDateString('tr-TR') : '-'"></td>
                                <td data-bind="text: aramaSaati || '-'"></td>
                                <td data-bind="text: gorusulenTemsilci || '-'"></td>
                                <td>
                                    <span class="badge" data-bind="text: durumText, attr: { class: 'badge ' + durumCss }"></span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" data-bind="click: $parent.showAtamaDetail" title="Detay">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-outline-warning" data-bind="click: $parent.showEditModal" title="Düzenle">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div data-bind="visible: !isAramalarLoading() && atamalar().length === 0" class="text-center text-muted py-4">
                    Atama bulunamadı.
                </div>
            </div>
        </div>

        <div data-bind="visible: !selectedDonemId()" class="text-center text-muted py-5">
            <i class="bi bi-arrow-up fs-1 d-block mb-2"></i>
            Takip için bir dönem seçin.
        </div>
    </div>

    <!-- ==================== DİNLEMELER TAB ==================== -->
    <div data-bind="visible: activeTab() === 'dinlemeler'">

        <!-- Özet -->
        <div class="row g-3 mb-3" data-bind="visible: selectedDonemId()">
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body py-2">
                        <div class="fs-4 fw-bold text-primary" data-bind="text: dinlemeler().length"></div>
                        <small class="text-muted">Toplam Dinleme</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body py-2">
                        <div class="fs-4 fw-bold text-success" data-bind="text: dinlemeTamamlananSayisi()"></div>
                        <small class="text-muted">Tamamlanan</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body py-2">
                        <div class="fs-4 fw-bold text-warning" data-bind="text: dinlemeBekleyenSayisi()"></div>
                        <small class="text-muted">Bekleyen</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body py-2">
                        <div class="fs-4 fw-bold" data-bind="text: dinlemeTamamlanmaOrani() + '%'"></div>
                        <small class="text-muted">Tamamlanma</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Loading -->
        <div data-bind="visible: isDinlemelerLoading" class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>

        <!-- Tablo -->
        <div class="card" data-bind="visible: !isDinlemelerLoading() && selectedDonemId()">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.T("GmDinleme.Dinleyen", "Dinleyen")</th>
                                <th>@Html.T("GolgeMusteri.HedefFirma", "Firma")</th>
                                <th>@Html.T("Common.Question", "Soru")</th>
                                <th>@Html.T("GolgeMusteri.Arayan", "Arayan")</th>
                                <th>@Html.T("Common.Date", "Arama Tarihi")</th>
                                <th>@Html.T("Common.Status", "Durum")</th>
                                <th>@Html.T("Common.Score", "Puan %")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: dinlemeler">
                            <tr>
                                <td data-bind="text: dinleyenAdi || '-'"></td>
                                <td data-bind="text: hedefFirmaAdi || '-'"></td>
                                <td><small data-bind="text: soruMetni ? (soruMetni.length > 30 ? soruMetni.substring(0,30)+'...' : soruMetni) : '-'"></small></td>
                                <td data-bind="text: arayanAdi || '-'"></td>
                                <td data-bind="text: aramaTarihi ? new Date(aramaTarihi).toLocaleDateString('tr-TR') : '-'"></td>
                                <td><span class="badge" data-bind="text: durumText, attr: { class: 'badge ' + durumCss }"></span></td>
                                <td>
                                    <!-- ko if: durumId === 3 -->
                                    <span data-bind="text: '% ' + percentage.toFixed(2)"></span>
                                    <!-- /ko -->
                                    <!-- ko if: durumId !== 3 -->
                                    <span class="text-muted">-</span>
                                    <!-- /ko -->
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div data-bind="visible: !isDinlemelerLoading() && dinlemeler().length === 0" class="text-center text-muted py-4">
                    Dinleme ataması bulunamadı.
                </div>
            </div>
        </div>

        <div data-bind="visible: !selectedDonemId()" class="text-center text-muted py-5">
            <i class="bi bi-arrow-up fs-1 d-block mb-2"></i>
            Takip için bir dönem seçin.
        </div>
    </div>

    <!-- Atama Detay Modal -->
    <div class="modal fade" id="atamaDetailModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-eye me-2"></i>Atama Detay</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" data-bind="with: selectedAtama">
                    <table class="table table-sm mb-0">
                        <tbody>
                            <tr><th style="width:140px;">Personel</th><td data-bind="text: userName || '-'"></td></tr>
                            <tr><th>Firma</th><td data-bind="text: hedefFirmaAdi || '-'"></td></tr>
                            <tr><th>Soru</th><td data-bind="text: soruMetni || '-'"></td></tr>
                            <tr><th>Beklenen Cevap</th><td data-bind="text: beklenenCevap || '-'"></td></tr>
                            <tr><th>Telefon No</th><td data-bind="text: hedefFirmaTelefonNo || '-'"></td></tr>
                            <tr><th>Plan Tarihi</th><td data-bind="text: planTarihi ? new Date(planTarihi).toLocaleDateString('tr-TR') : '-'"></td></tr>
                            <tr><th>Gerçekleşme</th><td data-bind="text: gerceklesmeTarihi ? new Date(gerceklesmeTarihi).toLocaleDateString('tr-TR') : '-'"></td></tr>
                            <tr><th>Saat</th><td data-bind="text: aramaSaati || '-'"></td></tr>
                            <tr><th>Temsilci</th><td data-bind="text: gorusulenTemsilci || '-'"></td></tr>
                            <tr><th>Durum</th><td><span class="badge" data-bind="text: durumText, attr: { class: 'badge ' + durumCss }"></span></td></tr>
                            <!-- ko if: isKuponlu -->
                            <tr><th>Kupon Bilgisi</th><td data-bind="text: kuponBilgisi || '-'"></td></tr>
                            <tr><th>Kupon Kodu</th><td><code data-bind="text: kuponKodu || '-'"></code></td></tr>
                            <!-- /ko -->
                            <tr><th>Not</th><td><span data-bind="text: not || '-'" style="white-space: pre-wrap;"></span></td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                </div>
            </div>
        </div>
    </div>
    <!-- Atama Düzenleme Modal -->
    <div class="modal fade" id="editAtamaModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-pencil me-2"></i>Atama Düzenle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info mb-3" data-bind="visible: editingAtama()">
                        <strong data-bind="text: editingAtama() ? editingAtama().hedefFirmaAdi : ''"></strong>
                        <span class="text-muted ms-1" data-bind="text: editingAtama() ? '- ' + (editingAtama().soruMetni || '') : ''"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Personel</label>
                        <select class="form-select" data-bind="options: users, optionsText: function(u) { return u.firstName + ' ' + u.lastName; }, optionsValue: 'id', value: editForm.userId, optionsCaption: '-- Personel Seçin --'"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Plan Tarihi</label>
                        <input type="date" class="form-control" data-bind="value: editForm.planTarihi">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-primary" data-bind="click: saveAtamaEdit, disable: isEditSaving">
                        <span data-bind="visible: isEditSaving" class="spinner-border spinner-border-sm me-1"></span>
                        Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/GolgeMusteri/takip.js" asp-append-version="true"></script>
}
