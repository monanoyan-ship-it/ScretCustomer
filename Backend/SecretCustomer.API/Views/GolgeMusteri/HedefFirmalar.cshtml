@{
    ViewData["Title"] = Html.T("GolgeMusteri.HedefFirmalar", "Hedef Firmalar");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="hedef-firmalar-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-building me-2"></i>@Html.T("GolgeMusteri.HedefFirmalar", "Hedef Firmalar")
            </h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/">@Html.T("Menu.Dashboard", "Ana Sayfa")</a></li>
                    <li class="breadcrumb-item active">@Html.T("GolgeMusteri.HedefFirmalar", "Hedef Firmalar")</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary" data-bind="click: showCreateModal">
            <i class="bi bi-plus me-1"></i> Yeni Firma
        </button>
    </div>

    <!-- Filtre -->
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <select class="form-select form-select-sm" data-bind="options: customers, optionsText: 'companyName', optionsValue: 'id', value: selectedCustomerId, optionsCaption: '-- Müşteri Seçin --'"></select>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Yükleniyor...</span>
        </div>
    </div>

    <!-- Tablo -->
    <div class="card" data-bind="visible: !isLoading()">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Firma Adı</th>
                            <th>Telefon</th>
                            <th>Müşteri</th>
                            <th>Soru Sayısı</th>
                            <th>Durum</th>
                            <th style="width: 120px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: firmalar">
                        <tr>
                            <td>
                                <strong data-bind="text: firmaAdi"></strong>
                                <small class="d-block text-muted" data-bind="text: aciklama, visible: aciklama"></small>
                            </td>
                            <td data-bind="text: telefonNo || '-'"></td>
                            <td data-bind="text: customerName || '-'"></td>
                            <td><span class="badge bg-primary" data-bind="text: soruSayisi"></span></td>
                            <td>
                                <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? 'Aktif' : 'Pasif'"></span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary" data-bind="click: $parent.showEditModal" title="Düzenle">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" data-bind="click: $parent.deleteFirma" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div data-bind="visible: !isLoading() && firmalar().length === 0" class="text-center text-muted py-4">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                Henüz hedef firma eklenmemiş.
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="firmaModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" data-bind="text: isEditing() ? 'Firma Düzenle' : 'Yeni Firma'"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3" data-bind="visible: !isEditing()">
                        <label class="form-label">Müşteri <span class="text-danger">*</span></label>
                        <select class="form-select" data-bind="options: customers, optionsText: 'companyName', optionsValue: 'id', value: form.customerId, optionsCaption: '-- Seçin --'"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Firma Adı <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" data-bind="value: form.firmaAdi" maxlength="300">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Telefon No</label>
                        <input type="text" class="form-control" data-bind="value: form.telefonNo" maxlength="50">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Açıklama</label>
                        <textarea class="form-control" rows="3" data-bind="value: form.aciklama" maxlength="1000"></textarea>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="firmaIsActive" data-bind="checked: form.isActive">
                        <label class="form-check-label" for="firmaIsActive">Aktif</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-primary" data-bind="click: saveFirma, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/GolgeMusteri/hedefFirmalar.js" asp-append-version="true"></script>
}
