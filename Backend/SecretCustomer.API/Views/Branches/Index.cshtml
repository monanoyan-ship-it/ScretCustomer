@{
    ViewData["Title"] = Html.T("Branch.Title", "Şubeler");
}

<div id="branches-app" class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@Html.T("Branch.Title", "Şubeler")</h2>
        <button class="btn btn-primary" data-bind="click: createNew">
            <i class="bi bi-plus-circle"></i> @Html.T("Branch.NewBranch", "Yeni Şube")
        </button>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>

    <!-- Error Message -->
    <div data-bind="visible: errorMessage" class="alert alert-danger alert-dismissible fade show">
        <span data-bind="text: errorMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { errorMessage(''); }"></button>
    </div>

    <!-- Success Message -->
    <div data-bind="visible: successMessage" class="alert alert-success alert-dismissible fade show">
        <span data-bind="text: successMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { successMessage(''); }"></button>
    </div>

    <!-- Branches Table -->
    <div data-bind="visible: !isLoading()">
        <!-- Empty State -->
        <div data-bind="visible: branches().length === 0">
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> @Html.T("Branch.NoBranches", "Henüz şube bulunmamaktadır.")
            </div>
        </div>

        <!-- Table -->
        <div data-bind="visible: branches().length > 0" class="card shadow">
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>@Html.T("Branch.BranchName", "Şube Adı")</th>
                            <th>@Html.T("Branch.BranchCode", "Şube Kodu")</th>
                            <th>@Html.T("Branch.City", "Şehir")</th>
                            <th>@Html.T("Branch.Region", "Bölge")</th>
                            <th>@Html.T("Branch.UserCount", "Kullanıcı Sayısı")</th>
                            <th>@Html.T("Common.Status", "Durum")</th>
                            <th>@Html.T("Common.Actions", "İşlemler")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: branches">
                        <tr>
                            <td data-bind="text: name"></td>
                            <td><span class="badge bg-secondary" data-bind="text: code"></span></td>
                            <td data-bind="text: city || '-'"></td>
                            <td data-bind="text: region || '-'"></td>
                            <td><span class="badge bg-info" data-bind="text: userCount"></span></td>
                            <td>
                                <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? '@Html.T("Common.Active", "Aktif")' : '@Html.T("Common.Inactive", "Pasif")'"></span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" data-bind="click: $parent.editBranch" title="@Html.T("Common.Edit", "Düzenle")">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deleteBranch" title="@Html.T("Common.Delete", "Sil")">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Create/Edit Modal -->
    <div class="modal fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" data-bind="with: editingBranch">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <!-- ko ifnot: id -->
                        <i class="bi bi-plus-circle me-2"></i>@Html.T("Branch.NewBranch", "Yeni Şube")
                        <!-- /ko -->
                        <!-- ko if: id -->
                        <i class="bi bi-pencil me-2"></i>@Html.T("Branch.EditBranch", "Şube Düzenle")
                        <!-- /ko -->
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: $parent.closeModal"></button>
                </div>
                <div class="modal-body">
                    <!-- Modal Hata Mesajı -->
                    <div data-bind="visible: $root.modalErrorMessage()" class="alert alert-danger alert-dismissible mb-3">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <span data-bind="text: $root.modalErrorMessage()"></span>
                        <button type="button" class="btn-close" data-bind="click: function() { $root.modalErrorMessage(''); }"></button>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Branch.BranchName", "Şube Adı") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: name" placeholder="@Html.T("Branch.NamePlaceholder", "Merkez Şube")" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Branch.BranchCode", "Şube Kodu") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: code" placeholder="@Html.T("Branch.CodePlaceholder", "MRK001")" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Branch.City", "Şehir")</label>
                            <input type="text" class="form-control" data-bind="value: city" placeholder="@Html.T("Branch.CityPlaceholder", "İstanbul")" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Branch.Region", "Bölge")</label>
                            <input type="text" class="form-control" data-bind="value: region" placeholder="@Html.T("Branch.RegionPlaceholder", "Marmara")" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.T("Common.Address", "Adres")</label>
                        <textarea class="form-control" data-bind="value: address" rows="3" placeholder="@Html.T("Branch.AddressPlaceholder", "Şube adresi...")"></textarea>
                    </div>

                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" data-bind="checked: isActive" id="isActive" />
                        <label class="form-check-label" for="isActive">@Html.T("Common.Active", "Aktif")</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closeModal">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-primary" data-bind="click: $parent.saveBranch, disable: $parent.isSaving">
                        <span data-bind="visible: !$parent.isSaving()">
                            <i class="bi bi-check-circle me-2"></i>@Html.T("Common.Save", "Kaydet")
                        </span>
                        <span data-bind="visible: $parent.isSaving">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            @Html.T("Common.Saving", "Kaydediliyor...")
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }"></div>

    <partial name="_DeleteConfirmationModal" />

</div> <!-- End of branches-app -->

@section Scripts {
    <script src="~/js/Shared/delete-confirmation.js"></script>
    <script src="~/js/Branches/Index.js"></script>
}
