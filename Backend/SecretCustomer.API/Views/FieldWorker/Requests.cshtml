@{
    ViewData["Title"] = Html.T("FieldWorker.Requests", "Taleplerim");
}

<div id="fieldworker-requests-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="/FieldWorker" class="btn btn-outline-secondary btn-sm me-3">
                <i class="bi bi-arrow-left me-1"></i>@Html.T("Common.Back", "Geri")
            </a>
            <span class="h2 mb-0">
                <i class="bi bi-list-check me-2"></i>@Html.T("FieldWorker.Requests", "Taleplerim")
            </span>
        </div>
        <button class="btn btn-primary" data-bind="click: showNewRequestModal">
            <i class="bi bi-plus-circle me-1"></i>@Html.T("FieldWorker.NewDealerRequest", "Yeni Bayi Talebi")
        </button>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-warning text-dark">
                <div class="card-body text-center">
                    <h3 class="mb-0" data-bind="text: pendingCount">0</h3>
                    <small>@Html.T("Status.Pending", "Bekleyen")</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <h3 class="mb-0" data-bind="text: approvedCount">0</h3>
                    <small>@Html.T("Status.Approved", "Onaylanan")</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-danger text-white">
                <div class="card-body text-center">
                    <h3 class="mb-0" data-bind="text: rejectedCount">0</h3>
                    <small>@Html.T("Status.Rejected", "Reddedilen")</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yukleniyor...")</span>
        </div>
    </div>

    <!-- Requests List -->
    <div data-bind="visible: !isLoading()">
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-shop me-2"></i>@Html.T("FieldWorker.MyDealerRequests", "Bayi Taleplerim")</h5>
            </div>
            <div class="card-body p-0">
                <!-- Empty State -->
                <div data-bind="visible: requests().length === 0" class="text-center py-5">
                    <i class="bi bi-inbox text-muted empty-state-icon"></i>
                    <p class="mt-3 text-muted">@Html.T("FieldWorker.NoRequests", "Henuz talep bulunmamaktadir.")</p>
                    <button class="btn btn-primary" data-bind="click: showNewRequestModal">
                        <i class="bi bi-plus-circle me-1"></i>@Html.T("FieldWorker.NewDealerRequest", "Yeni Bayi Talebi")
                    </button>
                </div>

                <!-- Table -->
                <div data-bind="visible: requests().length > 0" class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.T("DealerRequest.Type", "Talep Tipi")</th>
                                <th>@Html.T("Common.Customer", "Firma")</th>
                                <th>@Html.T("Dealer.Name", "Bayi Bilgisi")</th>
                                <th>@Html.T("Common.Status", "Durum")</th>
                                <th>@Html.T("Common.Date", "Tarih")</th>
                                <th>@Html.T("DealerRequest.AdminResponse", "Admin Yaniti")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: requests">
                            <tr>
                                <td>
                                    <span class="badge" data-bind="text: $parent.getRequestTypeName(requestTypeId), css: $parent.getRequestTypeBadge(requestTypeId)"></span>
                                </td>
                                <td data-bind="text: customerName"></td>
                                <td>
                                    <!-- ko if: customerDealerName -->
                                    <span data-bind="text: customerDealerName"></span>
                                    <!-- /ko -->
                                    <!-- ko ifnot: customerDealerName -->
                                    <span class="text-muted" data-bind="text: $parent.getDealerNameFromJson(requestDataJson)"></span>
                                    <!-- /ko -->
                                </td>
                                <td>
                                    <span class="badge" data-bind="text: $parent.getStatusText(statusId), css: $parent.getStatusBadgeClass(statusId)"></span>
                                </td>
                                <td>
                                    <small data-bind="text: $parent.formatDate(createdAt)"></small>
                                </td>
                                <td>
                                    <!-- ko if: adminResponse -->
                                    <small class="text-muted" data-bind="text: adminResponse"></small>
                                    <!-- /ko -->
                                    <!-- ko ifnot: adminResponse -->
                                    <span class="text-muted">-</span>
                                    <!-- /ko -->
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== NEW DEALER REQUEST MODAL ==================== -->
    <div class="modal fade" data-bind="css: { show: isNewRequestModalOpen }, style: { display: isNewRequestModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-shop me-2"></i>@Html.T("FieldWorker.NewDealerRequest", "Yeni Bayi Talebi")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bind="click: closeNewRequestModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">@Html.T("Common.Customer", "Firma") <span class="text-danger">*</span></label>
                            <select class="form-select" data-bind="value: newRequest.customerId, options: customers, optionsText: 'customerName', optionsValue: 'customerId', optionsCaption: '@Html.T("Common.Select", "Seciniz")'"></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Html.T("Dealer.Type", "Bayi Tipi") <span class="text-danger">*</span></label>
                            <select class="form-select" data-bind="value: newRequest.dealerTypeId">
                                <option value="1">@Html.T("DealerType.Retail", "Perakende")</option>
                                <option value="2">@Html.T("DealerType.Wholesale", "Toptan")</option>
                                <option value="3">@Html.T("DealerType.Franchise", "Franchise")</option>
                                <option value="4">@Html.T("DealerType.Authorized", "Yetkili Bayi")</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label">@Html.T("Dealer.Name", "Bayi Adi") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: newRequest.name" placeholder="ABC Bayi" autocomplete="off">
                        </div>

                        <div class="col-12">
                            <label class="form-label">@Html.T("Dealer.Address", "Adres")</label>
                            <input type="text" class="form-control" data-bind="value: newRequest.address" placeholder="Cadde, Sokak, No" autocomplete="off">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">@Html.T("Dealer.City", "Sehir")</label>
                            <input type="text" class="form-control" data-bind="value: newRequest.city" placeholder="Istanbul" autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Html.T("Dealer.District", "Ilce")</label>
                            <input type="text" class="form-control" data-bind="value: newRequest.district" placeholder="Kadikoy" autocomplete="off">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">@Html.T("Dealer.Phone", "Telefon")</label>
                            <input type="tel" class="form-control" data-bind="value: newRequest.phone" placeholder="0216 123 4567" autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Html.T("Dealer.ContactPerson", "Yetkili Kisi")</label>
                            <input type="text" class="form-control" data-bind="value: newRequest.contactPerson" placeholder="Ahmet Yilmaz" autocomplete="off">
                        </div>

                        <div class="col-12">
                            <label class="form-label">@Html.T("Dealer.Notes", "Notlar")</label>
                            <textarea class="form-control" rows="2" data-bind="value: newRequest.notes" placeholder="Ek bilgiler..." autocomplete="off"></textarea>
                        </div>
                    </div>

                    <div class="alert alert-info mt-3">
                        <i class="bi bi-info-circle me-2"></i>
                        @Html.T("FieldWorker.RequestNote", "Talebiniz admin onayindan sonra sisteme eklenecektir.")
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeNewRequestModal">
                        @Html.T("Common.Cancel", "Iptal")
                    </button>
                    <button type="button" class="btn btn-primary" data-bind="click: submitRequest, disable: isSaving">
                        <span data-bind="visible: !isSaving()">
                            <i class="bi bi-send me-1"></i>@Html.T("Common.Submit", "Gonder")
                        </span>
                        <span data-bind="visible: isSaving">
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            @Html.T("Common.Sending", "Gonderiliyor...")
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Backdrop -->
    <div class="modal-backdrop fade" data-bind="css: { show: isNewRequestModalOpen }, style: { display: isNewRequestModalOpen() ? 'block' : 'none' }"></div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/fieldworker-requests.css" />
}

@section Scripts {
    <script src="~/js/Shared/localization.js"></script>
    <script src="~/js/Shared/api.service.js"></script>
    <script src="~/js/FieldWorker/requests.js"></script>
}
