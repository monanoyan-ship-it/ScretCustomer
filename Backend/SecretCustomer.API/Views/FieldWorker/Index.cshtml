@{
    ViewData["Title"] = Html.T("FieldWorker.Dashboard", "Saha Calisani Paneli");
}

<div id="fieldworker-dashboard-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">
                <i class="bi bi-speedometer2 me-2"></i>@Html.T("FieldWorker.Dashboard", "Saha Calisani Paneli")
            </h2>
            <p class="text-muted mb-0" data-bind="text: 'Hos geldiniz, ' + userName()"></p>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yukleniyor...")</span>
        </div>
    </div>

    <div data-bind="visible: !isLoading()">
        <!-- Ziyaret Bekleyen Subeler (EN USTE) -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-shop me-2"></i>@Html.T("FieldWorker.PendingDealers", "Ziyaret Bekleyen Subeler")
                </h5>
                <span class="badge bg-light text-primary" data-bind="text: pendingDealers().length"></span>
            </div>
            <div class="card-body">
                <!-- Bayi yoksa -->
                <div data-bind="visible: pendingDealers().length === 0" class="text-center py-4">
                    <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
                    <p class="text-muted mt-2 mb-0">@Html.T("FieldWorker.AllDealersVisited", "Tum subeler ziyaret edildi!")</p>
                </div>

                <!-- Bayi listesi - Card Grid -->
                <div class="row" data-bind="visible: pendingDealers().length > 0, foreach: pendingDealers">
                    <div class="col-12 col-md-6 col-lg-3 mb-3">
                        <div class="card h-100 border-primary dealer-card">
                            <div class="card-header bg-primary bg-opacity-10 py-2">
                                <div class="fw-bold text-dark" data-bind="text: dealerName"></div>
                                <small class="text-muted" data-bind="text: dealerCode"></small>
                            </div>
                            <div class="card-body py-2">
                                <!-- Adres -->
                                <div class="mb-2">
                                    <small class="text-muted d-block">
                                        <i class="bi bi-geo me-1"></i>
                                        <span data-bind="text: (city || '') + (district ? ', ' + district : '') || '-'"></span>
                                    </small>
                                    <small class="text-muted" data-bind="text: address || '', visible: address"></small>
                                </div>
                                <!-- Proje -->
                                <div class="mb-2">
                                    <span class="badge bg-info" data-bind="text: projectName"></span>
                                    <small class="text-muted d-block" data-bind="text: customerName"></small>
                                </div>
                                <!-- Iletisim -->
                                <!-- ko if: phone || contactPerson -->
                                <div class="small">
                                    <!-- ko if: phone -->
                                    <div><i class="bi bi-telephone me-1"></i><span data-bind="text: phone"></span></div>
                                    <!-- /ko -->
                                    <!-- ko if: contactPerson -->
                                    <div class="text-muted" data-bind="text: contactPerson"></div>
                                    <!-- /ko -->
                                </div>
                                <!-- /ko -->
                            </div>
                            <div class="card-footer bg-transparent py-2">
                                <div class="d-grid gap-1">
                                    <button type="button" class="btn btn-primary btn-sm" data-bind="click: function() { $parent.startVisit($data); }, clickBubble: false">
                                        <i class="bi bi-clipboard-check me-1"></i>@Html.T("FieldWorker.StartVisit", "Ziyaret Baslat")
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bind="click: function() { $parent.openInMaps($data); }, clickBubble: false">
                                        <i class="bi bi-geo-alt me-1"></i>@Html.T("FieldWorker.GetAddress", "Adresi Ogren")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Son Ziyaretler ve Atanmis Projeler -->
        <div class="row">
            <!-- Recent Visits -->
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>@Html.T("FieldWorker.RecentVisits", "Son Ziyaretler")</h5>
                        <a href="/FieldWorker/Visits" class="btn btn-sm btn-outline-primary">@Html.T("Common.ViewAll", "Tumunu Gor")</a>
                    </div>
                    <div class="card-body p-0">
                        <div data-bind="visible: recentVisits().length === 0" class="text-center py-4">
                            <i class="bi bi-clipboard text-muted empty-state-icon"></i>
                            <p class="text-muted mt-2">@Html.T("FieldWorker.NoVisits", "Henuz ziyaret bulunmamaktadir.")</p>
                        </div>
                        <div class="list-group list-group-flush" data-bind="foreach: recentVisits">
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="d-flex align-items-center">
                                            <span class="badge bg-primary me-2" data-bind="text: visitId"></span>
                                            <span class="badge" data-bind="css: $parent.getStatusBadgeClass(statusId), text: statusName"></span>
                                        </div>
                                        <h6 class="mb-1 mt-1" data-bind="text: customerDealerName || 'Bayi Belirtilmemis'"></h6>
                                        <small class="text-muted">
                                            <span data-bind="text: projectName"></span> - <span data-bind="text: customerName"></span>
                                        </small>
                                    </div>
                                    <div class="text-end">
                                        <!-- ko if: scorePercentage -->
                                        <span class="badge bg-success" data-bind="text: scorePercentage.toFixed(2) + '%'"></span>
                                        <!-- /ko -->
                                        <br>
                                        <small class="text-muted" data-bind="text: $parent.formatDate(createdAt)"></small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Assigned Projects -->
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-folder me-2"></i>@Html.T("FieldWorker.AssignedProjects", "Atanmis Projeler")</h5>
                        <span class="badge bg-primary" data-bind="text: assignedProjects().length"></span>
                    </div>
                    <div class="card-body p-0">
                        <div data-bind="visible: assignedProjects().length === 0" class="text-center py-4">
                            <i class="bi bi-folder-x text-muted empty-state-icon"></i>
                            <p class="text-muted mt-2">@Html.T("Report.NoProjects", "Atanmis proje bulunmamaktadir.")</p>
                        </div>
                        <div class="list-group list-group-flush" data-bind="foreach: assignedProjects">
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="mb-1" data-bind="text: projectName"></h6>
                                        <small class="text-muted" data-bind="text: customerName"></small>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-info" data-bind="text: customerDealerCount + ' Bayi'"></span>
                                        <br>
                                        <small class="text-success" data-bind="text: completedVisits + ' Ziyaret'"></small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats Cards (EN ALTA) -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h3 class="mb-0" data-bind="text: totalVisits">0</h3>
                                <small>@Html.T("FieldWorker.TotalVisits", "Toplam Ziyaret")</small>
                            </div>
                            <i class="bi bi-clipboard-check stat-icon"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h3 class="mb-0" data-bind="text: todayVisits">0</h3>
                                <small>@Html.T("FieldWorker.TodayVisits", "Bugunki Ziyaret")</small>
                            </div>
                            <i class="bi bi-calendar-check stat-icon"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h3 class="mb-0" data-bind="text: thisWeekVisits">0</h3>
                                <small>@Html.T("FieldWorker.WeekVisits", "Bu Hafta")</small>
                            </div>
                            <i class="bi bi-calendar-week stat-icon"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-lightning me-2"></i>@Html.T("FieldWorker.QuickActions", "Hizli Islemler")</h5>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-md-6">
                                <a href="/FieldWorker/Visits" class="btn btn-outline-primary btn-lg w-100 mb-2">
                                    <i class="bi bi-list-check d-block mb-2 quick-action-icon"></i>
                                    @Html.T("FieldWorker.AllVisits", "Tum Ziyaretler")
                                </a>
                            </div>
                            <div class="col-md-6">
                                <a href="/FieldWorker/Visits?status=1" class="btn btn-outline-warning btn-lg w-100 mb-2">
                                    <i class="bi bi-pencil-square d-block mb-2 quick-action-icon"></i>
                                    @Html.T("FieldWorker.DraftVisits", "Taslak Ziyaretler")
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/fieldworker-dashboard.css" />
}

@section Scripts {
    <script src="~/js/Shared/localization.js"></script>
    <script src="~/js/Shared/api.service.js"></script>
    <script src="~/js/FieldWorker/dashboard.js"></script>
}
