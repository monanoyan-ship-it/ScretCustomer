@{
    ViewData["Title"] = @Html.T("CustomerPortal.Report.Title", "Raporlar");
    Layout = "_CustomerLayout";
}

<div id="customer-reports-app">
    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yükleniyor...")</span>
        </div>
    </div>

    <!-- Content -->
    <div data-bind="visible: !isLoading()">
        <!-- Filters -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="row align-items-end g-3">
                    <div class="col-md-3">
                        <label class="form-label small text-muted">@Html.T("Common.StartDate", "Başlangıç Tarihi")</label>
                        <input type="date" class="form-control" data-bind="value: startDate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-muted">@Html.T("Common.EndDate", "Bitiş Tarihi")</label>
                        <input type="date" class="form-control" data-bind="value: endDate" />
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-success" data-bind="click: loadReports">
                            <i class="bi bi-search me-1"></i> @Html.T("Common.Filter", "Filtrele")
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100 bg-success text-white">
                    <div class="card-body text-center">
                        <h3 class="mb-0" data-bind="text: summary().totalEvaluations || 0"></h3>
                        <small>@Html.T("CustomerPortal.Report.TotalEvaluations", "Toplam Değerlendirme")</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <h3 class="mb-0 text-primary" data-bind="text: (summary().averageScore || 0).toFixed(1)"></h3>
                        <small class="text-muted">@Html.T("CustomerPortal.Report.AverageScore", "Ortalama Puan")</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <h3 class="mb-0 text-info" data-bind="text: summary().projectCount || 0"></h3>
                        <small class="text-muted">@Html.T("CustomerPortal.Report.ProjectCount", "Proje Sayısı")</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <div class="d-flex justify-content-around">
                            <div>
                                <span class="badge bg-danger" data-bind="text: (summary().minScore || 0).toFixed(1)"></span>
                                <div class="small text-muted">@Html.T("Common.Min", "Min")</div>
                            </div>
                            <div>
                                <span class="badge bg-success" data-bind="text: (summary().maxScore || 0).toFixed(1)"></span>
                                <div class="small text-muted">@Html.T("Common.Max", "Max")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Score Distribution -->
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0">
                        <h6 class="mb-0"><i class="bi bi-pie-chart me-2"></i>@Html.T("CustomerPortal.Report.ScoreDistribution", "Puan Dağılımı")</h6>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-3">
                                <a href="#" class="text-decoration-none" data-bind="click: function() { showScoreRangeDetail(90, 101, 'Mükemmel (90+)', 'success'); }">
                                    <div class="display-6 text-success" data-bind="text: summary().excellentCount || 0"></div>
                                    <small class="text-muted">90+</small>
                                </a>
                            </div>
                            <div class="col-3">
                                <a href="#" class="text-decoration-none" data-bind="click: function() { showScoreRangeDetail(80, 90, 'İyi (80-89)', 'primary'); }">
                                    <div class="display-6 text-primary" data-bind="text: summary().goodCount || 0"></div>
                                    <small class="text-muted">80-89</small>
                                </a>
                            </div>
                            <div class="col-3">
                                <a href="#" class="text-decoration-none" data-bind="click: function() { showScoreRangeDetail(60, 80, 'Orta (60-79)', 'warning'); }">
                                    <div class="display-6 text-warning" data-bind="text: summary().averageCount || 0"></div>
                                    <small class="text-muted">60-79</small>
                                </a>
                            </div>
                            <div class="col-3">
                                <a href="#" class="text-decoration-none" data-bind="click: function() { showScoreRangeDetail(0, 60, 'Düşük (<60)', 'danger'); }">
                                    <div class="display-6 text-danger" data-bind="text: summary().poorCount || 0"></div>
                                    <small class="text-muted">&lt;60</small>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0">
                        <h6 class="mb-0"><i class="bi bi-graph-up me-2"></i>@Html.T("CustomerPortal.Report.MonthlyTrend", "Aylık Trend")</h6>
                    </div>
                    <div class="card-body">
                        <canvas id="trendChart" height="150"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Project Performance Table -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0">
                <h6 class="mb-0"><i class="bi bi-folder me-2"></i>@Html.T("CustomerPortal.Report.ProjectPerformance", "Proje Performansı")</h6>
            </div>
            <div class="card-body p-0">
                <div data-bind="visible: projectPerformance().length === 0" class="text-center py-4 text-muted">
                    <i class="bi bi-inbox fs-1"></i>
                    <p class="mt-2">@Html.T("CustomerPortal.Report.NoPeriodData", "Seçilen dönemde değerlendirme bulunmuyor.")</p>
                </div>
                <div data-bind="visible: projectPerformance().length > 0" class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>@Html.T("Common.Project", "Proje")</th>
                                <th class="text-center">@Html.T("Common.Evaluation", "Değerlendirme")</th>
                                <th class="text-center">@Html.T("Common.Average", "Ortalama")</th>
                                <th class="text-center">@Html.T("Common.Min", "Min")</th>
                                <th class="text-center">@Html.T("Common.Max", "Max")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: projectPerformance">
                            <tr>
                                <td data-bind="text: $index() + 1"></td>
                                <td><strong data-bind="text: projectName"></strong></td>
                                <td class="text-center" data-bind="text: evaluationCount"></td>
                                <td class="text-center">
                                    <span class="badge fs-6" data-bind="text: averageScore.toFixed(1), css: $parent.getScoreBadgeClass(averageScore)"></span>
                                </td>
                                <td class="text-center">
                                    <span class="text-danger" data-bind="text: minScore.toFixed(1)"></span>
                                </td>
                                <td class="text-center">
                                    <span class="text-success" data-bind="text: maxScore.toFixed(1)"></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Score Range Detail Modal -->
    <div class="modal fade" data-bind="css: { show: isScoreRangeModalOpen }, style: { display: isScoreRangeModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header" data-bind="css: 'bg-' + scoreRangeModalColor() + ' text-white'">
                    <h5 class="modal-title">
                        <i class="bi bi-bar-chart me-2"></i>
                        <span data-bind="text: scoreRangeModalTitle"></span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bind="click: closeScoreRangeModal"></button>
                </div>
                <div class="modal-body">
                    <!-- Loading -->
                    <div data-bind="visible: isScoreRangeLoading" class="text-center py-4">
                        <div class="spinner-border text-primary"></div>
                    </div>

                    <!-- Content -->
                    <div data-bind="visible: !isScoreRangeLoading()">
                        <div data-bind="visible: scoreRangeEvaluations().length === 0" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-1"></i>
                            <p class="mt-2">Bu aralıkta değerlendirme bulunamadı.</p>
                        </div>
                        <div data-bind="visible: scoreRangeEvaluations().length > 0" class="table-responsive">
                            <table class="table table-hover table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>@Html.T("Common.Date", "Tarih")</th>
                                        <th>@Html.T("Common.Project", "Proje")</th>
                                        <th>@Html.T("Common.Personnel", "Personel")</th>
                                        <th class="text-center">@Html.T("Common.Score", "Puan")</th>
                                        <th class="text-center">@Html.T("Common.Cards", "Kartlar")</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody data-bind="foreach: scoreRangeEvaluations">
                                    <tr>
                                        <td data-bind="text: evaluationDate ? new Date(evaluationDate).toLocaleDateString('tr-TR') : '-'"></td>
                                        <td data-bind="text: projectName"></td>
                                        <td data-bind="text: personnelName"></td>
                                        <td class="text-center">
                                            <span class="badge" data-bind="text: (scorePercentage || 0).toFixed(1) + '%', css: $parent.getScoreBadgeClass(scorePercentage || 0)"></span>
                                        </td>
                                        <td class="text-center">
                                            <span data-bind="visible: yellowCards > 0" class="badge bg-warning text-dark me-1" data-bind="text: yellowCards"></span>
                                            <span data-bind="visible: redCards > 0" class="badge bg-danger" data-bind="text: redCards"></span>
                                            <span data-bind="visible: yellowCards === 0 && redCards === 0">-</span>
                                        </td>
                                        <td>
                                            <a class="btn btn-sm btn-outline-primary" data-bind="attr: { href: '/CustomerPortal/ExternalEvaluations?evaluationId=' + evaluationId }" target="_blank">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div data-bind="visible: scoreRangeEvaluations().length >= 100" class="text-muted small text-center mt-2">
                            <i class="bi bi-info-circle"></i> İlk 100 kayıt gösteriliyor
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeScoreRangeModal">
                        <i class="bi bi-x-lg me-1"></i>@Html.T("Common.Close", "Kapat")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isScoreRangeModalOpen }, style: { display: isScoreRangeModalOpen() ? 'block' : 'none' }"></div>
</div>

@section Scripts {
    <script src="~/js/CustomerPortal/reports.js"></script>
}
