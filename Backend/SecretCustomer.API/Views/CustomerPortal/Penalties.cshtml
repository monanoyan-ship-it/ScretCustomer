@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = @Html.T("Report.PenaltyReport", "Cezali KL Raporu");
}

<div id="penalties-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-card-checklist text-danger"></i> @Html.T("Report.PenaltyReport", "Cezali KL Raporu")</h2>
        <div class="btn-group">
            <button class="btn btn-success" data-bind="click: exportToExcel, disable: isExporting">
                <span data-bind="visible: !isExporting()">
                    <i class="bi bi-file-earmark-excel"></i> @Html.T("Report.ExportExcel", "Excel Indir")
                </span>
                <span data-bind="visible: isExporting">
                    <span class="spinner-border spinner-border-sm"></span> @Html.T("Report.Downloading", "Indiriliyor...")
                </span>
            </button>
        </div>
    </div>

    <!-- Chip-based Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-funnel"></i> @Html.T("Common.Filters", "Filtreler")</h5>
            <button class="btn btn-sm btn-outline-light" data-bind="click: clearFilters, visible: activeFilters().length > 0">
                <i class="bi bi-x-circle"></i> @Html.T("Common.ClearAll", "Tümünü Temizle")
            </button>
        </div>
        <div class="card-body">
            <!-- Active Filters (Chips) -->
            <div class="mb-3" data-bind="visible: activeFilters().length > 0">
                <div class="d-flex flex-wrap gap-2">
                    <!-- ko foreach: activeFilters -->
                    <span class="badge bg-danger text-white d-flex align-items-center gap-1 py-2 px-3" style="font-size: 0.9rem;">
                        <span data-bind="text: label + ': ' + displayValue"></span>
                        <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.6rem;" data-bind="click: $parent.removeFilter"></button>
                    </span>
                    <!-- /ko -->
                </div>
            </div>

            <!-- Filter Builder -->
            <div class="row g-2 align-items-end">
                <!-- Filter Type Selector -->
                <div class="col-md-2">
                    <label class="form-label mb-1">@Html.T("Common.FilterType", "Filtre Tipi")</label>
                    <select class="form-select form-select-sm" data-bind="value: selectedFilterType">
                        <option value="">@Html.T("Common.SelectFilter", "Filtre Seç...")</option>
                        <option value="project">@Html.T("Report.Project", "Proje")</option>
                        <option value="organization">@Html.T("Report.Organization", "Organizasyon")</option>
                        <option value="penaltyType">@Html.T("Report.PenaltyType", "Ceza Tipi")</option>
                        <option value="dateRange">@Html.T("Report.DateRange", "Tarih Aralığı")</option>
                    </select>
                </div>

                <!-- Dynamic Filter Value Input -->
                <!-- Project -->
                <div class="col-md-3" data-bind="visible: selectedFilterType() === 'project'">
                    <label class="form-label mb-1">@Html.T("Report.Project", "Proje")</label>
                    <select class="form-select form-select-sm" data-bind="value: tempFilter.projectId, options: projects, optionsValue: 'id', optionsText: 'name', optionsCaption: '@Html.T("Common.Select", "Seçiniz...")'"></select>
                </div>

                <!-- Organization -->
                <div class="col-md-3" data-bind="visible: selectedFilterType() === 'organization'">
                    <label class="form-label mb-1">@Html.T("Report.Organization", "Organizasyon")</label>
                    <select class="form-select form-select-sm" data-bind="value: tempFilter.organizationId, options: organizations, optionsValue: 'id', optionsText: 'name', optionsCaption: '@Html.T("Common.Select", "Seçiniz...")'"></select>
                </div>

                <!-- Penalty Type -->
                <div class="col-md-2" data-bind="visible: selectedFilterType() === 'penaltyType'">
                    <label class="form-label mb-1">@Html.T("Report.PenaltyType", "Ceza Tipi")</label>
                    <select class="form-select form-select-sm" data-bind="value: tempFilter.penaltyType">
                        <option value="">@Html.T("Common.Select", "Seçiniz...")</option>
                        <option value="YellowCard">@Html.T("Report.YellowCard", "Sari Kart")</option>
                        <option value="RedCard">@Html.T("Report.RedCard", "Kirmizi Kart")</option>
                    </select>
                </div>

                <!-- Date Range -->
                <div class="col-md-5" data-bind="visible: selectedFilterType() === 'dateRange'">
                    <div class="row g-2">
                        <div class="col-md-5">
                            <label class="form-label mb-1">@Html.T("Report.StartDate", "Başlangıç")</label>
                            <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.startDate">
                        </div>
                        <div class="col-md-5">
                            <label class="form-label mb-1">@Html.T("Report.EndDate", "Bitiş")</label>
                            <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.endDate">
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-calendar3"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><h6 class="dropdown-header">@Html.T("Common.Day", "Gün")</h6></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('today'); }">@Html.T("Common.Today", "Bugün")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('yesterday'); }">@Html.T("Common.Yesterday", "Dün")</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">@Html.T("Common.Week", "Hafta")</h6></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('thisWeek'); }">@Html.T("Common.ThisWeek", "Bu Hafta")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('lastWeek'); }">@Html.T("Common.LastWeek", "Geçen Hafta")</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">@Html.T("Common.Month", "Ay")</h6></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('thisMonth'); }">@Html.T("Common.ThisMonth", "Bu Ay")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('lastMonth'); }">@Html.T("Common.LastMonth", "Geçen Ay")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('last3Months'); }">@Html.T("Common.Last3Months", "Son 3 Ay")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('last6Months'); }">@Html.T("Common.Last6Months", "Son 6 Ay")</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">@Html.T("Common.Year", "Yıl")</h6></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('thisYear'); }">@Html.T("Common.ThisYear", "Bu Yıl")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('lastYear'); }">@Html.T("Common.LastYear", "Geçen Yıl")</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Add Filter Button -->
                <div class="col-md-2" data-bind="visible: selectedFilterType()">
                    <button class="btn btn-sm btn-danger w-100" data-bind="click: addFilter, enable: canAddFilter">
                        <i class="bi bi-plus-circle"></i> @Html.T("Common.AddFilter", "Filtre Ekle")
                    </button>
                </div>
            </div>

        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-danger text-white h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-1">@Html.T("Report.TotalPenalties", "Toplam Cezali")</h6>
                            <h2 class="mb-0" data-bind="text: summary().totalPenalties"></h2>
                        </div>
                        <i class="bi bi-card-fill fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-dark-50 mb-1">@Html.T("Report.YellowCard", "Sari Kart")</h6>
                            <h2 class="mb-0" data-bind="text: summary().totalYellowCards"></h2>
                        </div>
                        <i class="bi bi-exclamation-triangle fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark text-white h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-1">@Html.T("Report.RedCard", "Kirmizi Kart")</h6>
                            <h2 class="mb-0" data-bind="text: summary().totalRedCards"></h2>
                        </div>
                        <i class="bi bi-x-circle fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-secondary text-white h-100">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-1">@Html.T("Report.AffectedEvaluations", "Etkilenen Degerlendirme")</h6>
                            <h2 class="mb-0" data-bind="text: summary().affectedEvaluations"></h2>
                        </div>
                        <i class="bi bi-clipboard-x fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Veriler yukleniyor...")</p>
    </div>

    <div data-bind="visible: !isLoading()" class="row">
        <!-- Top Penalty Questions -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-question-circle"></i> @Html.T("Report.TopPenaltyQuestions", "En Cok Ceza Alan Sorular")</h5>
                </div>
                <div class="card-body p-0">
                    <div data-bind="visible: topPenaltyQuestions().length === 0" class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">@Html.T("Report.NoDataYet", "Henuz veri bulunmamaktadir.")</p>
                    </div>
                    <ul class="list-group list-group-flush" data-bind="foreach: topPenaltyQuestions">
                        <li class="list-group-item d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <div class="fw-bold" data-bind="text: questionText"></div>
                                <small class="text-muted" data-bind="text: checklistName + ' - ' + groupName"></small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-warning text-dark me-1" data-bind="visible: yellowCardCount > 0">
                                    <i class="bi bi-card-fill"></i> <span data-bind="text: yellowCardCount"></span>
                                </span>
                                <span class="badge bg-danger" data-bind="visible: redCardCount > 0">
                                    <i class="bi bi-card-fill"></i> <span data-bind="text: redCardCount"></span>
                                </span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Top Penalty Organizations -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="bi bi-building"></i> @Html.T("Report.TopPenaltyOrganizations", "En Cok Ceza Alan Organizasyonlar")</h5>
                </div>
                <div class="card-body p-0">
                    <div data-bind="visible: topPenaltyOrganizations().length === 0" class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">@Html.T("Report.NoDataYet", "Henuz veri bulunmamaktadir.")</p>
                    </div>
                    <ul class="list-group list-group-flush" data-bind="foreach: topPenaltyOrganizations">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold" data-bind="text: organizationName"></span>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-warning text-dark me-1" data-bind="visible: yellowCardCount > 0">
                                    <i class="bi bi-card-fill"></i> <span data-bind="text: yellowCardCount"></span>
                                </span>
                                <span class="badge bg-danger" data-bind="visible: redCardCount > 0">
                                    <i class="bi bi-card-fill"></i> <span data-bind="text: redCardCount"></span>
                                </span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Top Penalty Personnel -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-person-x"></i> @Html.T("Report.TopPenaltyPersonnel", "En Cok Ceza Alan Personeller")</h5>
                </div>
                <div class="card-body p-0">
                    <div data-bind="visible: topPenaltyPersonnel().length === 0" class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">@Html.T("Report.NoDataYet", "Henuz veri bulunmamaktadir.")</p>
                    </div>
                    <ul class="list-group list-group-flush" data-bind="foreach: topPenaltyPersonnel">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold" data-bind="text: personnelName"></span>
                                <small class="text-muted d-block" data-bind="text: organizationName"></small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-secondary me-1" data-bind="text: evaluationCount + ' deg.'"></span>
                                <span class="badge bg-warning text-dark me-1" data-bind="visible: yellowCardCount > 0">
                                    <i class="bi bi-card-fill"></i> <span data-bind="text: yellowCardCount"></span>
                                </span>
                                <span class="badge bg-danger" data-bind="visible: redCardCount > 0">
                                    <i class="bi bi-card-fill"></i> <span data-bind="text: redCardCount"></span>
                                </span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Monthly Trend Chart -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-graph-up"></i> @Html.T("Report.MonthlyPenaltyTrend", "Aylik Ceza Trendi")</h5>
                </div>
                <div class="card-body">
                    <canvas id="penaltyTrendChart" style="max-height: 250px;"></canvas>
                </div>
            </div>
        </div>

        <!-- Detailed Penalty List -->
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-list-ul"></i> @Html.T("Report.PenaltyEvaluations", "Cezali Degerlendirmeler")</h5>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-danger" data-bind="text: totalCount() + ' @Html.T("Report.Records", "kayit")'"></span>
                        <!-- Pagination -->
                        <div class="btn-group btn-group-sm" data-bind="visible: totalPages() > 1">
                            <button class="btn btn-outline-secondary" data-bind="click: previousPage, disable: page() <= 1">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <span class="btn btn-outline-secondary disabled" data-bind="text: page() + ' / ' + totalPages()"></span>
                            <button class="btn btn-outline-secondary" data-bind="click: nextPage, disable: page() >= totalPages()">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div data-bind="visible: penalties().length === 0" class="text-center text-muted py-5">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">@Html.T("Report.NoPenaltyEvaluations", "Cezali degerlendirme bulunamadi.")</p>
                    </div>
                    <div data-bind="visible: penalties().length > 0" class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>@Html.T("Report.Date", "Tarih")</th>
                                    <th>@Html.T("Report.Period", "Periyot")</th>
                                    <th>@Html.T("Report.ProjectOrg", "Proje / Organizasyon")</th>
                                    <th>@Html.T("Report.Question", "Soru")</th>
                                    <th>@Html.T("Report.PenaltyType", "Ceza Tipi")</th>
                                    <th>@Html.T("Report.EvaluatedPerson", "Denetlenen")</th>
                                    <th class="text-center" style="width: 50px;">@Html.T("Common.Actions", "Islem")</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: penalties">
                                <tr data-bind="css: { 'table-warning': penaltyType === 'YellowCard', 'table-danger': penaltyType === 'RedCard' }">
                                    <td>
                                        <span data-bind="text: evaluationDate ? new Date(evaluationDate).toLocaleDateString('tr-TR') : '-'"></span>
                                    </td>
                                    <td>
                                        <span data-bind="text: periodName || '-'"></span>
                                    </td>
                                    <td>
                                        <span data-bind="text: projectName"></span>
                                        <small class="text-muted d-block" data-bind="text: organizationName || checklistName || '-'"></small>
                                    </td>
                                    <td>
                                        <span data-bind="text: questionText"></span>
                                        <small class="text-muted d-block" data-bind="text: groupName"></small>
                                        <!-- Alt Kriterler -->
                                        <!-- ko if: selectedSubCriteria && selectedSubCriteria.length > 0 -->
                                        <div class="mt-1">
                                            <!-- ko foreach: selectedSubCriteria -->
                                            <small class="text-info d-block"><i class="bi bi-arrow-return-right"></i> <span data-bind="text: $data"></span></small>
                                            <!-- /ko -->
                                        </div>
                                        <!-- /ko -->
                                    </td>
                                    <td>
                                        <span data-bind="visible: penaltyType === 'YellowCard'" class="badge bg-warning text-dark">
                                            <i class="bi bi-card-fill"></i> @Html.T("Report.YellowCard", "Sari Kart")
                                        </span>
                                        <span data-bind="visible: penaltyType === 'RedCard'" class="badge bg-danger">
                                            <i class="bi bi-card-fill"></i> @Html.T("Report.RedCard", "Kirmizi Kart")
                                        </span>
                                    </td>
                                    <td data-bind="text: evaluatedPersonnelName || dealerName || '-'"></td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary" data-bind="click: $parent.showDetails" title="@Html.T("Report.ViewEvaluation", "Degerlendirmeyi Gor")">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- Bottom Pagination -->
                <div class="card-footer bg-white d-flex align-items-center gap-3" data-bind="visible: totalPages() > 1">
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-primary" data-bind="click: previousPage, disable: page() <= 1">
                            <i class="bi bi-chevron-left"></i> @Html.T("Common.Previous", "Onceki")
                        </button>
                        <button class="btn btn-outline-primary" data-bind="click: nextPage, disable: page() >= totalPages()">
                            @Html.T("Common.Next", "Sonraki") <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Details Modal -->
    <div class="modal fade" data-bind="css: { show: isDetailsModalOpen }, style: { display: isDetailsModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-clipboard-check me-2"></i>@Html.T("Evaluation.Details", "Dinleme Detayi")</h5>
                    <div class="ms-auto d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-outline-light btn-sm" data-bind="click: exportDetailToExcel, disable: isExportingDetail">
                            <span data-bind="visible: !isExportingDetail()"><i class="bi bi-file-earmark-excel me-1"></i>Excel</span>
                            <span data-bind="visible: isExportingDetail"><span class="spinner-border spinner-border-sm"></span></span>
                        </button>
                        <button type="button" class="btn-close btn-close-white" data-bind="click: closeDetailsModal"></button>
                    </div>
                </div>
                <div class="modal-body">
                    <!-- Loading -->
                    <div data-bind="visible: isDetailsLoading" class="text-center py-5">
                        <div class="spinner-border text-primary"></div>
                    </div>
                    <!-- Content -->
                    <div data-bind="visible: !isDetailsLoading() && detailsData()">
                        <!-- ko with: detailsData -->
                        <!-- Score Summary -->
                        <div class="card mb-4">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-md-2 text-center border-end">
                                        <h2 class="mb-0" data-bind="text: (scorePercentage || 0).toFixed(1) + '%', css: $parent.getScoreClass(scorePercentage || 0)"></h2>
                                        <small class="text-muted">@Html.T("Evaluation.TotalScore", "Toplam Puan")</small>
                                    </div>
                                    <div class="col-md-10">
                                        <div class="row g-3">
                                            <div class="col-md-3">
                                                <small class="text-muted d-block">@Html.T("Evaluation.Project", "Proje")</small>
                                                <strong data-bind="text: projectName || '-'"></strong>
                                            </div>
                                            <div class="col-md-3">
                                                <small class="text-muted d-block">@Html.T("Evaluation.Personnel", "Personel")</small>
                                                <strong data-bind="text: evaluatedPersonnelName || evaluatedUnknownPersonnel || dealerName || '-'"></strong>
                                            </div>
                                            <div class="col-md-3">
                                                <small class="text-muted d-block">@Html.T("Evaluation.Organization", "Organizasyon")</small>
                                                <strong data-bind="text: organizationName || '-'"></strong>
                                            </div>
                                            <div class="col-md-3">
                                                <small class="text-muted d-block">@Html.T("Evaluation.Date", "Tarih")</small>
                                                <strong data-bind="text: completedAt ? new Date(completedAt).toLocaleDateString('tr-TR') : '-'"></strong>
                                            </div>
                                        </div>
                                        <!-- Penalty Cards -->
                                        <div class="mt-3" data-bind="visible: yellowCardCount > 0 || redCardCount > 0">
                                            <span class="badge bg-warning text-dark me-2" data-bind="visible: yellowCardCount > 0">
                                                <i class="bi bi-card-fill"></i> <span data-bind="text: yellowCardCount"></span> @Html.T("Report.YellowCard", "Sari Kart")
                                            </span>
                                            <span class="badge bg-danger" data-bind="visible: redCardCount > 0">
                                                <i class="bi bi-card-fill"></i> <span data-bind="text: redCardCount"></span> @Html.T("Report.RedCard", "Kirmizi Kart")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Questions -->
                        <div class="card">
                            <div class="card-header">
                                <h6 class="mb-0"><i class="bi bi-list-check me-2"></i>@Html.T("Evaluation.Questions", "Sorular")</h6>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 50%;">@Html.T("Evaluation.Question", "Soru")</th>
                                                <th class="text-center">@Html.T("Evaluation.Answer", "Cevap")</th>
                                                <th class="text-center">@Html.T("Evaluation.Score", "Puan")</th>
                                                <th>@Html.T("Evaluation.Note", "Not")</th>
                                            </tr>
                                        </thead>
                                        <tbody data-bind="foreach: answers || []">
                                            <tr data-bind="css: { 'table-warning': penaltyType === 'YellowCard', 'table-danger': penaltyType === 'RedCard' }">
                                                <td>
                                                    <span data-bind="text: questionText"></span>
                                                    <!-- ko if: groupName -->
                                                    <br><small class="text-muted" data-bind="text: groupName"></small>
                                                    <!-- /ko -->
                                                </td>
                                                <td class="text-center">
                                                    <!-- ko if: answerNumeric !== null && answerNumeric !== undefined -->
                                                    <span class="badge bg-primary" data-bind="text: answerNumeric + '/' + (questionMaxPoints || 5)"></span>
                                                    <!-- /ko -->
                                                    <!-- ko if: (answerNumeric === null || answerNumeric === undefined) && answerText -->
                                                    <span data-bind="text: answerText"></span>
                                                    <!-- /ko -->
                                                    <!-- ko if: (answerNumeric === null || answerNumeric === undefined) && !answerText -->
                                                    <span class="text-muted">-</span>
                                                    <!-- /ko -->
                                                </td>
                                                <td class="text-center">
                                                    <span data-bind="text: earnedPoints != null ? earnedPoints.toFixed(1) : '-'"></span>
                                                    <!-- ko if: penaltyType === 'YellowCard' -->
                                                    <span class="badge bg-warning text-dark ms-1"><i class="bi bi-card-fill"></i></span>
                                                    <!-- /ko -->
                                                    <!-- ko if: penaltyType === 'RedCard' -->
                                                    <span class="badge bg-danger ms-1"><i class="bi bi-card-fill"></i></span>
                                                    <!-- /ko -->
                                                </td>
                                                <td>
                                                    <small data-bind="text: notes || '-'"></small>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- General Notes -->
                        <div class="card mt-3" data-bind="visible: notes">
                            <div class="card-header">
                                <h6 class="mb-0"><i class="bi bi-chat-left-text me-2"></i>@Html.T("Evaluation.GeneralNotes", "Genel Notlar")</h6>
                            </div>
                            <div class="card-body">
                                <p class="mb-0" data-bind="text: notes"></p>
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isDetailsModalOpen }, style: { display: isDetailsModalOpen() ? 'block' : 'none' }"></div>
</div>

@section Scripts {
    <script src="~/js/CustomerPortal/penalties.js"></script>
}
