@{
    ViewData["Title"] = Html.T("CustomerPortal.LoginTitle", "Müşteri Portalı - Giriş").ToString();
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="~/lib/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css">
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/knockout/knockout-latest.min.js"></script>
</head>
<body class="bg-light">

<div id="customer-login-app" class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-4">
                    <i class="bi bi-building fs-1 text-success"></i>
                    <div class="mt-2">@Html.T("CustomerPortal.Title", "Müşteri Portalı")</div>
                    <small class="text-muted fs-6">@Html.T("Common.AppName", "Gizli Müşteri Sistemi")</small>
                </h3>

                <!-- Error Message -->
                <div data-bind="visible: errorMessage" class="alert alert-danger alert-dismissible fade show">
                    <span data-bind="text: errorMessage"></span>
                    <button type="button" class="btn-close" data-bind="click: function() { errorMessage(''); }"></button>
                </div>

                <form data-bind="submit: login">
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Account.Username", "Kullanıcı Adı")</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input type="text" class="form-control" data-bind="value: username" placeholder="@Html.T("Account.UsernamePlaceholder", "Kullanıcı adınızı girin")" autofocus />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.T("Account.Password", "Şifre")</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input type="password" class="form-control" data-bind="value: password" placeholder="@Html.T("Account.PasswordPlaceholder", "Şifrenizi girin")" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success w-100 mb-3" data-bind="disable: isLoading">
                        <span data-bind="visible: !isLoading()">
                            <i class="bi bi-box-arrow-in-right me-1"></i>@Html.T("Account.Login", "Giriş Yap")
                        </span>
                        <span data-bind="visible: isLoading">
                            <span class="spinner-border spinner-border-sm me-1"></span>@Html.T("CustomerPortal.LoggingIn", "Giriş yapılıyor...")
                        </span>
                    </button>
                </form>

                <hr />

                <div class="text-center">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        @Html.T("CustomerPortal.CompanyLogin", "Firma yetkilisi girişi")
                    </small>
                </div>

                <div class="text-center mt-3">
                    <a href="/Account/Login" class="text-decoration-none text-primary">
                        <i class="bi bi-arrow-left me-1"></i>@Html.T("CustomerPortal.AdminLogin", "Admin Girişi")
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
<script src="~/js/CustomerPortal/login.js"></script>
</body>
</html>
