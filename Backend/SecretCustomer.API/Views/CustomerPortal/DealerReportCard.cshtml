@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = @Html.T("Report.DealerReportCard", "Şube Karnesi");
}

<div id="dealer-report-card-app">
    <div class="row g-3">
        <!-- Sol Panel: Şube Listesi -->
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white py-2">
                    <h6 class="mb-0"><i class="bi bi-shop"></i> @Html.T("Report.Dealers", "Şubeler")</h6>
                </div>
                <div class="card-body p-2">
                    <!-- Arama Kutusu -->
                    <div class="mb-2">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" placeholder="@Html.T("Common.Search", "Ara...")"
                                   data-bind="value: searchText, valueUpdate: 'input'" autocomplete="off">
                            <button class="btn btn-outline-secondary" type="button" data-bind="visible: searchText(), click: clearSearch">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Şube Listesi -->
                    <div class="dealer-list-container" style="max-height: calc(100vh - 250px); overflow-y: auto;">
                        <!-- Loading -->
                        <div data-bind="visible: isLoadingDealers" class="text-center py-3">
                            <div class="spinner-border spinner-border-sm text-primary"></div>
                        </div>

                        <!-- Empty State -->
                        <div data-bind="visible: !isLoadingDealers() && filteredDealerList().length === 0" class="text-center py-3 text-muted">
                            <i class="bi bi-shop-window"></i>
                            <small class="d-block">@Html.T("Report.NoDealerFound", "Şube bulunamadı")</small>
                        </div>

                        <!-- Dealer List -->
                        <div class="list-group list-group-flush" data-bind="foreach: filteredDealerList">
                            <a href="#" class="list-group-item list-group-item-action py-2 px-2"
                               data-bind="click: $parent.selectDealer, css: { active: $parent.selectedDealerId() == id }">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="bi bi-shop me-1"></i>
                                        <span data-bind="text: name"></span>
                                    </div>
                                    <!-- ko if: city -->
                                    <small class="text-muted" data-bind="text: city" style="font-size: 0.7rem;"></small>
                                    <!-- /ko -->
                                </div>
                            </a>
                        </div>
                    </div>

                    <!-- Şube Sayısı -->
                    <div class="border-top pt-2 mt-2">
                        <small class="text-muted">
                            <span data-bind="text: filteredDealerList().length"></span> / <span data-bind="text: dealerList().length"></span> @Html.T("Report.Dealer", "şube")
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sağ Panel: Karne -->
        <div class="col-md-9">
            <!-- Şube Seçilmedi -->
            <div data-bind="visible: !selectedDealerId()" class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-shop text-muted" style="font-size: 4rem;"></i>
                    <h5 class="mt-3 text-muted">@Html.T("Report.SelectDealerToViewReport", "Karne görmek için bir şube seçin")</h5>
                    <p class="text-muted">@Html.T("Report.SelectDealerFromLeftPanel", "Sol panelden bir şube seçerek karnesini görüntüleyebilirsiniz.")</p>
                </div>
            </div>

            <!-- Şube Seçildi -->
            <div data-bind="visible: selectedDealerId()">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0">
                        <i class="bi bi-shop"></i>
                        <span data-bind="text: selectedDealerName"></span>
                    </h4>
                    <div class="btn-group" data-bind="visible: report()">
                        <button class="btn btn-success btn-sm" data-bind="click: exportToExcel, disable: isExporting">
                            <span data-bind="visible: !isExporting()"><i class="bi bi-file-earmark-excel"></i> Excel</span>
                            <span data-bind="visible: isExporting"><span class="spinner-border spinner-border-sm"></span></span>
                        </button>
                        <button class="btn btn-primary btn-sm" data-bind="click: exportToWord, disable: isExporting">
                            <span data-bind="visible: !isExporting()"><i class="bi bi-file-earmark-word"></i> Word</span>
                            <span data-bind="visible: isExporting"><span class="spinner-border spinner-border-sm"></span></span>
                        </button>
                        <button class="btn btn-danger btn-sm" data-bind="click: exportToPdf, disable: isExporting">
                            <span data-bind="visible: !isExporting()"><i class="bi bi-file-pdf"></i> PDF</span>
                            <span data-bind="visible: isExporting"><span class="spinner-border spinner-border-sm"></span></span>
                        </button>
                    </div>
                </div>

                <!-- Filtreler -->
                <div class="card shadow-sm mb-3">
                    <div class="card-body py-2">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <div class="dropdown">
                                <button class="btn btn-outline-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                                    <i class="bi bi-funnel"></i> @Html.T("Common.AddFilter", "Filtre Ekle")
                                </button>
                                <div class="dropdown-menu p-3" style="min-width: 300px;">
                                    <div class="mb-2">
                                        <select class="form-select form-select-sm" data-bind="value: selectedFilterType">
                                            <option value="">@Html.T("Common.SelectFilter", "Filtre Seçin...")</option>
                                            <option value="project">@Html.T("Common.Project", "Proje")</option>
                                            <option value="dateRange">@Html.T("Common.DateRange", "Tarih Aralığı")</option>
                                        </select>
                                    </div>

                                    <div data-bind="visible: selectedFilterType() === 'project'" class="mb-2">
                                        <select class="form-select form-select-sm" data-bind="value: tempFilter.projectId, options: projects, optionsValue: 'id', optionsText: function(item) { return item.code ? item.code + ' - ' + item.name : item.name; }, optionsCaption: '@Html.T("Common.Select", "Seçin...")'"></select>
                                    </div>

                                    <div data-bind="visible: selectedFilterType() === 'dateRange'" class="mb-2">
                                        <div class="d-flex gap-1 mb-2">
                                            <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.startDate">
                                            <span class="align-self-center">-</span>
                                            <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.endDate">
                                        </div>
                                        <div class="d-flex flex-wrap gap-1">
                                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bind="click: function() { setTempDateRange('thisMonth'); }, css: { 'btn-primary': tempFilter.dateRangeType() === 'thisMonth' }">@Html.T("DateRange.ThisMonth", "Bu Ay")</button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bind="click: function() { setTempDateRange('lastMonth'); }, css: { 'btn-primary': tempFilter.dateRangeType() === 'lastMonth' }">@Html.T("DateRange.LastMonth", "Geçen Ay")</button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bind="click: function() { setTempDateRange('last3Months'); }, css: { 'btn-primary': tempFilter.dateRangeType() === 'last3Months' }">@Html.T("DateRange.Last3Months", "Son 3 Ay")</button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bind="click: function() { setTempDateRange('thisYear'); }, css: { 'btn-primary': tempFilter.dateRangeType() === 'thisYear' }">@Html.T("DateRange.ThisYear", "Bu Yıl")</button>
                                        </div>
                                    </div>

                                    <button type="button" class="btn btn-primary btn-sm w-100" data-bind="click: addFilter, enable: canAddFilter">
                                        <i class="bi bi-plus"></i> @Html.T("Common.Add", "Ekle")
                                    </button>
                                </div>
                            </div>

                            <!-- ko foreach: activeFilters -->
                            <span class="badge bg-primary d-flex align-items-center gap-1 py-2">
                                <span data-bind="text: label + ': ' + displayValue"></span>
                                <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.5rem;" data-bind="click: $parent.removeFilter"></button>
                            </span>
                            <!-- /ko -->

                            <button class="btn btn-outline-danger btn-sm" data-bind="visible: activeFilters().length > 0, click: clearAllFilters">
                                <i class="bi bi-x-circle"></i> @Html.T("Common.ClearAll", "Temizle")
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Loading -->
                <div data-bind="visible: isLoading" class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2 text-muted">@Html.T("Report.LoadingReportCard", "Karne yükleniyor...")</p>
                </div>

                <!-- No Data -->
                <div data-bind="visible: !isLoading() && !report()" class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                        <h5 class="mt-3 text-muted">@Html.T("Report.NoEvaluationsForDealer", "Bu şube için değerlendirme bulunamadı")</h5>
                    </div>
                </div>

                <!-- Report Content -->
                <div id="printable-report" data-bind="visible: !isLoading() && report()">
                    <!-- Summary Cards -->
                    <div class="row mb-3" data-bind="with: report">
                        <div class="col">
                            <div class="card text-center h-100">
                                <div class="card-body py-2">
                                    <h3 class="mb-0" data-bind="text: averageScore.toFixed(1) + '%', css: averageScore >= successThreshold ? 'text-success' : (averageScore >= warningThreshold ? 'text-warning' : 'text-danger')"></h3>
                                    <small class="text-muted">@Html.T("Report.Average", "Ortalama")</small>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card text-center h-100 bg-success text-white">
                                <div class="card-body py-2">
                                    <h3 class="mb-0" data-bind="text: bestScore.toFixed(1) + '%'"></h3>
                                    <small>@Html.T("Report.Highest", "En Yüksek")</small>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card text-center h-100 bg-danger text-white">
                                <div class="card-body py-2">
                                    <h3 class="mb-0" data-bind="text: worstScore.toFixed(1) + '%'"></h3>
                                    <small>@Html.T("Report.Lowest", "En Düşük")</small>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card text-center h-100">
                                <div class="card-body py-2">
                                    <h3 class="mb-0 text-primary" data-bind="text: totalEvaluations"></h3>
                                    <small class="text-muted">@Html.T("Common.Total", "Toplam")</small>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card text-center h-100 bg-warning">
                                <div class="card-body py-2">
                                    <h3 class="mb-0" data-bind="text: totalYellowCards"></h3>
                                    <small>@Html.T("Report.YellowCard", "Sarı Kart")</small>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card text-center h-100 bg-danger text-white">
                                <div class="card-body py-2">
                                    <h3 class="mb-0" data-bind="text: totalRedCards"></h3>
                                    <small>@Html.T("Report.RedCard", "Kırmızı Kart")</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Monthly Trend -->
                    <div class="card shadow-sm mb-3" data-bind="visible: report() && report().monthlyTrend && report().monthlyTrend.length > 0">
                        <div class="card-header bg-info text-white py-2">
                            <h6 class="mb-0"><i class="bi bi-graph-up"></i> @Html.T("Report.MonthlyPerformance", "Aylık Performans")</h6>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>@Html.T("Report.Period", "Dönem")</th>
                                            <th class="text-center">@Html.T("Report.Evaluation", "Değerlendirme")</th>
                                            <th class="text-center">@Html.T("Report.AvgScore", "Ort. Puan")</th>
                                            <th class="text-center">@Html.T("Report.YCard", "S.Kart")</th>
                                            <th class="text-center">@Html.T("Report.RCard", "K.Kart")</th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: report() ? report().monthlyTrend : []">
                                        <tr>
                                            <td data-bind="text: monthName"></td>
                                            <td class="text-center" data-bind="text: evaluationCount"></td>
                                            <td class="text-center">
                                                <span class="badge" data-bind="text: averageScore.toFixed(1) + '%', css: averageScore >= $root.report().successThreshold ? 'bg-success' : (averageScore >= $root.report().warningThreshold ? 'bg-warning text-dark' : 'bg-danger')"></span>
                                            </td>
                                            <td class="text-center" data-bind="text: yellowCards"></td>
                                            <td class="text-center" data-bind="text: redCards"></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Group Performance & Strengths/Weaknesses -->
                    <div class="row mb-3">
                        <div class="col-md-6" data-bind="visible: report() && report().groupPerformances && report().groupPerformances.length > 0">
                            <div class="card shadow-sm h-100">
                                <div class="card-header bg-secondary text-white py-2">
                                    <h6 class="mb-0"><i class="bi bi-list-task"></i> @Html.T("Report.GroupPerformance", "Grup Performansı")</h6>
                                </div>
                                <div class="card-body p-0">
                                    <table class="table table-sm mb-0">
                                        <tbody data-bind="foreach: report() ? report().groupPerformances : []">
                                            <tr>
                                                <td data-bind="text: groupName"></td>
                                                <td style="width: 50%;">
                                                    <div class="progress" style="height: 18px;">
                                                        <div class="progress-bar" data-bind="style: { width: percentageScore + '%' }, css: percentageScore >= $root.report().successThreshold ? 'bg-success' : (percentageScore >= $root.report().warningThreshold ? 'bg-warning' : 'bg-danger'), text: percentageScore.toFixed(1) + '%'"></div>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card shadow-sm h-100">
                                <div class="card-header bg-secondary text-white py-2">
                                    <h6 class="mb-0"><i class="bi bi-bar-chart"></i> @Html.T("Report.StrengthsWeaknesses", "Güçlü/Zayıf Yönler")</h6>
                                </div>
                                <div class="card-body p-0">
                                    <div class="p-2 bg-success bg-opacity-10" data-bind="visible: report() && report().strengths && report().strengths.length > 0">
                                        <small class="text-success fw-bold"><i class="bi bi-arrow-up-circle"></i> @Html.T("Report.Strengths", "Güçlü")</small>
                                    </div>
                                    <ul class="list-group list-group-flush" data-bind="foreach: report() ? report().strengths : []">
                                        <li class="list-group-item py-1 small">
                                            <span class="badge bg-success me-1" data-bind="text: percentageScore.toFixed(0) + '%'"></span>
                                            <span data-bind="text: questionText"></span>
                                        </li>
                                    </ul>
                                    <div class="p-2 bg-danger bg-opacity-10" data-bind="visible: report() && report().weaknesses && report().weaknesses.length > 0">
                                        <small class="text-danger fw-bold"><i class="bi bi-arrow-down-circle"></i> @Html.T("Report.NeedsImprovement", "Geliştirilmeli")</small>
                                    </div>
                                    <ul class="list-group list-group-flush" data-bind="foreach: report() ? report().weaknesses : []">
                                        <li class="list-group-item py-1 small">
                                            <span class="badge bg-danger me-1" data-bind="text: percentageScore.toFixed(0) + '%'"></span>
                                            <span data-bind="text: questionText"></span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Evaluations -->
                    <div class="card shadow-sm" data-bind="visible: report() && report().recentEvaluations && report().recentEvaluations.length > 0">
                        <div class="card-header bg-primary text-white py-2">
                            <h6 class="mb-0"><i class="bi bi-clock-history"></i> @Html.T("Report.RecentEvaluations", "Son Değerlendirmeler")</h6>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>@Html.T("Common.Date", "Tarih")</th>
                                            <th>@Html.T("Report.Inspected", "Denetlenen")</th>
                                            <th>@Html.T("Report.ControlDate", "Kontrol Tarihi")</th>
                                            <th>@Html.T("Common.Project", "Proje")</th>
                                            <th>@Html.T("Report.Checklist", "Kontrol Listesi")</th>
                                            <th class="text-center">@Html.T("EvalReport.Score", "Puan")</th>
                                            <th class="text-center">@Html.T("Report.Cards", "Kartlar")</th>
                                            <th class="text-center">@Html.T("Common.Actions", "İşlem")</th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: report() ? report().recentEvaluations : []">
                                        <tr>
                                            <td data-bind="text: evaluationDate ? new Date(evaluationDate).toLocaleDateString('tr-TR') : '-'"></td>
                                            <td data-bind="text: personnelName || '-'"></td>
                                            <td data-bind="text: (controlDate || '-') + (controlTime ? ' ' + controlTime : '')"></td>
                                            <td data-bind="text: projectName"></td>
                                            <td data-bind="text: checklistName"></td>
                                            <td class="text-center">
                                                <span class="badge" data-bind="text: scorePercentage.toFixed(1) + '%', css: scorePercentage >= $root.report().successThreshold ? 'bg-success' : (scorePercentage >= $root.report().warningThreshold ? 'bg-warning text-dark' : 'bg-danger')"></span>
                                            </td>
                                            <td class="text-center">
                                                <span data-bind="visible: yellowCards > 0" class="badge bg-warning text-dark me-1" data-bind="text: yellowCards"></span>
                                                <span data-bind="visible: redCards > 0" class="badge bg-danger" data-bind="text: redCards"></span>
                                                <span data-bind="visible: yellowCards === 0 && redCards === 0">-</span>
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-outline-primary" data-bind="click: function() { $root.showDetails(evaluationId); }">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Details Modal -->
    <div class="modal fade" data-bind="css: { show: isDetailsModalOpen }, style: { display: isDetailsModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-clipboard-check me-2"></i>@Html.T("EvalReport.EvaluationDetail", "Değerlendirme Detayı")</h5>
                    <div class="ms-auto d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-outline-light btn-sm" data-bind="click: exportDetailToExcel, disable: isExportingDetail">
                            <span data-bind="visible: !isExportingDetail()"><i class="bi bi-file-earmark-excel me-1"></i>Excel</span>
                            <span data-bind="visible: isExportingDetail"><span class="spinner-border spinner-border-sm"></span></span>
                        </button>
                        <button type="button" class="btn-close btn-close-white" data-bind="click: closeDetailsModal"></button>
                    </div>
                </div>
                <div class="modal-body">
                    <div data-bind="visible: isDetailsLoading" class="text-center py-5">
                        <div class="spinner-border text-primary"></div>
                    </div>
                    <div data-bind="visible: !isDetailsLoading() && detailsData()">
                        <!-- ko with: detailsData -->
                        <div class="card mb-4">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-md-2 text-center border-end">
                                        <h2 class="mb-0" data-bind="text: (scorePercentage || 0).toFixed(2) + '%', css: $parent.getScoreClass(scorePercentage || 0)"></h2>
                                        <small class="text-muted">@Html.T("EvalReport.TotalScore", "Toplam Puan")</small>
                                    </div>
                                    <div class="col-md-10">
                                        <div class="progress" style="height: 25px;">
                                            <div class="progress-bar" data-bind="style: { width: (scorePercentage || 0) + '%' }, css: $parent.getProgressBarClass(scorePercentage || 0), text: (scorePercentage || 0).toFixed(2) + '%'"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="card h-100">
                                    <div class="card-header bg-light"><h6 class="mb-0"><i class="bi bi-building"></i> @Html.T("EvalReport.Evaluated", "Değerlendirilen")</h6></div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr><th style="width:40%;">@Html.T("Common.Company", "Firma")</th><td data-bind="text: customerName || '-'"></td></tr>
                                            <tr><th>@Html.T("Common.Organization", "Organizasyon")</th><td data-bind="text: organizationName || '-'"></td></tr>
                                            <tr><th>@Html.T("Common.Dealer", "Bayi")</th><td data-bind="text: dealerName || '-'"></td></tr>
                                            <tr><th>@Html.T("Common.Representative", "Temsilci")</th><td data-bind="text: evaluatedPersonnelName || '-'"></td></tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card h-100">
                                    <div class="card-header bg-light"><h6 class="mb-0"><i class="bi bi-geo-alt"></i> @Html.T("Report.VisitInfo", "Ziyaret Bilgileri")</h6></div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr><th style="width:40%;">@Html.T("Report.ControlDate", "Kontrol Tarihi")</th><td data-bind="text: controlDate ? new Date(controlDate).toLocaleDateString('tr-TR') : '-'"></td></tr>
                                            <tr><th>@Html.T("Report.ControlTime", "Kontrol Saati")</th><td data-bind="text: controlTime || '-'"></td></tr>
                                            <tr><th>@Html.T("Common.Date", "Tarih")</th><td data-bind="text: evaluationDate ? new Date(evaluationDate).toLocaleDateString('tr-TR') : '-'"></td></tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card mb-4" data-bind="visible: descriptions && descriptions.length > 0">
                            <div class="card-header bg-secondary text-white"><h6 class="mb-0"><i class="bi bi-list-ul"></i> @Html.T("Evaluation.Descriptions", "Aciklamalar")</h6></div>
                            <div class="card-body">
                                <ul class="mb-0" data-bind="foreach: descriptions">
                                    <li data-bind="text: $data"></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card mb-4" data-bind="visible: evaluationComment">
                            <div class="card-header bg-info text-white"><h6 class="mb-0"><i class="bi bi-chat-quote"></i> @Html.T("EvalReport.AuditComment", "Denetim Yorumu")</h6></div>
                            <div class="card-body"><p class="mb-0" data-bind="text: evaluationComment"></p></div>
                        </div>
                        <div class="card">
                            <div class="card-header bg-light"><h6 class="mb-0"><i class="bi bi-list-check"></i> @Html.T("EvalReport.Answers", "Cevaplar")</h6></div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-sm table-striped mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width:12%;">@Html.T("EvalReport.Group", "Grup")</th>
                                                <th style="width:30%;">@Html.T("EvalReport.Question", "Soru")</th>
                                                <th class="text-center" style="width:10%;">@Html.T("EvalReport.Answer", "Cevap")</th>
                                                <th class="text-center" style="width:10%;">@Html.T("EvalReport.Weight", "Ağırlık")</th>
                                                <th class="text-center" style="width:10%;">@Html.T("EvalReport.Earned", "Kazanılan")</th>
                                                <th style="width:28%;">@Html.T("EvalReport.Notes", "Notlar")</th>
                                            </tr>
                                        </thead>
                                        <tbody data-bind="foreach: answers || []">
                                            <tr data-bind="css: { 'table-warning': appliedPenaltyType === 'YellowCard', 'table-danger': appliedPenaltyType === 'RedCard' }">
                                                <td data-bind="text: groupName || '-'"></td>
                                                <td>
                                                    <span data-bind="text: questionText"></span>
                                                    <!-- ko if: selectedSubCriteria && selectedSubCriteria.length > 0 -->
                                                    <br><small class="text-warning"><i class="bi bi-exclamation-triangle"></i> <span data-bind="text: selectedSubCriteria.join(', ')"></span></small>
                                                    <!-- /ko -->
                                                </td>
                                                <td class="text-center">
                                                    <!-- ko if: scoringType !== 'Unscored' && givenPoints !== null && maxPoints > 0 -->
                                                    <span class="badge bg-primary" data-bind="text: givenPoints + '/' + maxPoints"></span>
                                                    <!-- /ko -->
                                                    <!-- ko if: scoringType === 'Unscored' || !(givenPoints !== null && maxPoints > 0) -->
                                                    <span class="text-muted">-</span>
                                                    <!-- /ko -->
                                                </td>
                                                <td class="text-center">
                                                    <!-- ko if: scoringType !== 'Unscored' && maxPoints > 0 -->
                                                    <span data-bind="text: maxPoints"></span>
                                                    <!-- /ko -->
                                                    <!-- ko if: scoringType === 'Unscored' || !(maxPoints > 0) -->
                                                    <span class="text-muted">-</span>
                                                    <!-- /ko -->
                                                </td>
                                                <td class="text-center">
                                                    <!-- ko if: scoringType !== 'Unscored' && maxPoints > 0 -->
                                                    <span class="text-success" data-bind="text: (givenPoints || 0).toFixed(1)"></span>
                                                    <!-- /ko -->
                                                    <!-- ko if: scoringType === 'Unscored' || !(maxPoints > 0) -->
                                                    <span class="text-muted">-</span>
                                                    <!-- /ko -->
                                                </td>
                                                <td data-bind="text: notes || '-'"></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeDetailsModal">@Html.T("Common.Close", "Kapat")</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isDetailsModalOpen }, style: { display: isDetailsModalOpen() ? 'block' : 'none' }"></div>
</div>

@section Scripts {
    <script src="~/js/CustomerPortal/dealerReportCard.js" asp-append-version="true"></script>
}
