@{
    ViewData["Title"] = @Html.T("Menu.Projects", "Projeler");
    Layout = "_CustomerLayout";
}

<div id="customer-projects-app">
    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yükleniyor...")</span>
        </div>
    </div>

    <!-- Content -->
    <div data-bind="visible: !isLoading()">
        <!-- Empty State -->
        <div data-bind="visible: projects().length === 0" class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-folder fs-1 text-muted"></i>
                <h5 class="mt-3">@Html.T("CustomerPortal.Projects.NotFound", "Proje Bulunamadı")</h5>
                <p class="text-muted">@Html.T("CustomerPortal.Projects.NoRecords", "Firmanıza tanımlı proje bulunmuyor.")</p>
            </div>
        </div>

        <!-- Projects Table -->
        <div data-bind="visible: projects().length > 0" class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="bi bi-folder me-2"></i>
                    @Html.T("CustomerPortal.Projects.List", "Proje Listesi")
                    <span class="badge bg-success ms-2" data-bind="text: projects().length"></span>
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.T("Common.Name", "Ad")</th>
                                <th>@Html.T("Common.Code", "Kod")</th>
                                <th>@Html.T("Common.City", "Şehir")</th>
                                <th class="text-center">@Html.T("Common.Status", "Durum")</th>
                                <th class="text-center">@Html.T("CustomerPortal.Project.EvaluationCount", "Değerlendirme")</th>
                                <th class="text-center">@Html.T("Dealer.AverageScore", "Ort. Puan")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: projects">
                            <tr>
                                <td>
                                    <strong data-bind="text: name"></strong>
                                    <!-- ko if: address -->
                                    <br><small class="text-muted" data-bind="text: address"></small>
                                    <!-- /ko -->
                                </td>
                                <td><span class="text-muted" data-bind="text: code || '-'"></span></td>
                                <td data-bind="text: city || '-'"></td>
                                <td class="text-center">
                                    <!-- ko if: isActive -->
                                    <span class="badge bg-success">@Html.T("Common.Active", "Aktif")</span>
                                    <!-- /ko -->
                                    <!-- ko ifnot: isActive -->
                                    <span class="badge bg-secondary">@Html.T("Common.Inactive", "Pasif")</span>
                                    <!-- /ko -->
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info" data-bind="text: evaluationCount"></span>
                                </td>
                                <td class="text-center">
                                    <span class="fw-bold" data-bind="text: averageScore.toFixed(2), css: $parent.getScoreClass(averageScore)"></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/CustomerPortal/projects.js" asp-append-version="true"></script>
}
