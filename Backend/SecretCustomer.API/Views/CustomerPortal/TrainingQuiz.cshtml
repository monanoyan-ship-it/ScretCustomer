@{
    ViewData["Title"] = Html.T("TrainingQuiz.PageTitle", "Egitim Anketi");
    Layout = "_CustomerLayout";
    var participantId = ViewBag.ParticipantId;
}

<div id="quiz-app">
    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;"></div>
        <p class="mt-3 text-muted">@Html.T("TrainingQuiz.Loading", "Anket yukleniyor...")</p>
    </div>

    <!-- Error -->
    <div data-bind="visible: hasError" class="text-center py-5">
        <i class="bi bi-exclamation-triangle text-danger" style="font-size: 4rem;"></i>
        <h4 class="mt-3">@Html.T("Common.Error", "Hata")</h4>
        <p class="text-muted" data-bind="text: errorMessage"></p>
        <a href="/CustomerPortal/MyTrainings" class="btn btn-secondary mt-3">
            <i class="bi bi-arrow-left"></i> @Html.T("TrainingQuiz.BackToTrainings", "Egitimlerime Don")
        </a>
    </div>

    <!-- No Quiz -->
    <div data-bind="visible: !isLoading() && !hasError() && !quizData()" class="text-center py-5">
        <i class="bi bi-clipboard-x text-warning" style="font-size: 4rem;"></i>
        <h4 class="mt-3">@Html.T("TrainingQuiz.NotFound", "Anket Bulunamadi")</h4>
        <p class="text-muted">@Html.T("TrainingQuiz.NotFoundDescription", "Bu egitim icin anket tanimlanmamis veya daha once tamamladiniz.")</p>
        <a href="/CustomerPortal/MyTrainings" class="btn btn-secondary mt-3">
            <i class="bi bi-arrow-left"></i> @Html.T("TrainingQuiz.BackToTrainings", "Egitimlerime Don")
        </a>
    </div>

    <!-- Quiz Already Passed -->
    <!-- ko if: !isLoading() && !hasError() && quizData() && quizData().lastAttemptResult && quizData().lastAttemptResult.isPassed -->
    <div class="text-center py-5">
        <div class="card shadow-sm mx-auto" style="max-width: 500px;">
            <div class="card-body p-5">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                <h3 class="mt-3 text-success">@Html.T("TrainingQuiz.AlreadyCompleted", "Anketi Zaten Tamamladiniz!")</h3>
                <p class="text-muted">@Html.T("TrainingQuiz.AlreadyCompletedDescription", "Bu anketi daha once tamamladiniz.")</p>
                <a href="/CustomerPortal/MyTrainings" class="btn btn-primary mt-3">
                    <i class="bi bi-arrow-left"></i> @Html.T("TrainingQuiz.BackToTrainings", "Egitimlerime Don")
                </a>
            </div>
        </div>
    </div>
    <!-- /ko -->

    <!-- Quiz Content -->
    <!-- ko if: quizData() -->
    <div data-bind="visible: !isLoading() && !hasError() && !(quizData().lastAttemptResult && quizData().lastAttemptResult.isPassed) && !showResult()">
        <div class="card shadow-sm mx-auto" style="max-width: 800px;">
            <!-- Header -->
            <div class="card-header bg-light">
                <h5 class="mb-1" data-bind="text: quizData() ? quizData().title : ''"></h5>
                <small class="text-muted" data-bind="text: quizData() ? quizData().description : ''"></small>
            </div>

            <!-- Quiz Body -->
            <div class="card-body" data-bind="visible: questions().length > 0">
                <!-- Progress Bar -->
                <div class="progress mb-4" style="height: 8px;">
                    <div class="progress-bar" role="progressbar"
                         data-bind="style: { width: ((currentIndex() + 1) / questions().length * 100) + '%' }"></div>
                </div>

                <!-- Question -->
                <div data-bind="with: currentQuestion">
                    <div class="mb-4">
                        <span class="badge bg-secondary mb-2">@Html.T("TrainingQuiz.QuestionLabel", "Soru") <span data-bind="text: $parent.currentIndex() + 1"></span> / <span data-bind="text: $parent.questions().length"></span></span>
                        <h5 data-bind="text: text"></h5>
                        <!-- ko if: helpText -->
                        <small class="text-muted" data-bind="text: helpText"></small>
                        <!-- /ko -->
                    </div>

                    <!-- Options -->
                    <div class="list-group" data-bind="foreach: options">
                        <button type="button" class="list-group-item list-group-item-action d-flex align-items-center"
                                data-bind="click: $parents[1].selectOption,
                                           css: { 'active': $parents[1].isOptionSelected($data) }">
                            <!-- ko if: $parent.questionTypeId === 1 -->
                            <i class="bi me-3 fs-5" data-bind="css: { 'bi-circle': !$parents[1].isOptionSelected($data), 'bi-check-circle-fill': $parents[1].isOptionSelected($data) }"></i>
                            <!-- /ko -->
                            <!-- ko if: $parent.questionTypeId === 2 -->
                            <i class="bi me-3 fs-5" data-bind="css: { 'bi-square': !$parents[1].isOptionSelected($data), 'bi-check-square-fill': $parents[1].isOptionSelected($data) }"></i>
                            <!-- /ko -->
                            <span data-bind="text: text"></span>
                        </button>
                    </div>
                </div>

                <!-- Navigation -->
                <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-outline-secondary"
                            data-bind="click: prevQuestion, visible: currentIndex() > 0">
                        <i class="bi bi-chevron-left"></i> @Html.T("Common.Previous", "Onceki")
                    </button>
                    <div></div>
                    <button type="button" class="btn btn-primary"
                            data-bind="click: nextQuestion, visible: currentIndex() < questions().length - 1">
                        @Html.T("Common.Next", "Sonraki") <i class="bi bi-chevron-right"></i>
                    </button>
                    <button type="button" class="btn btn-success"
                            data-bind="click: submitQuiz, visible: currentIndex() >= questions().length - 1, disable: isSubmitting">
                        <span data-bind="visible: isSubmitting" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg" data-bind="visible: !isSubmitting()"></i> @Html.T("Common.Submit", "Gonder")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- /ko -->

    <!-- Result -->
    <!-- ko if: showResult() && quizResult() -->
    <div class="text-center py-5">
        <div class="card shadow-sm mx-auto" style="max-width: 500px;">
            <div class="card-body p-5">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                <h3 class="mt-3 text-success">@Html.T("TrainingQuiz.Saved", "Anketiniz Kaydedildi!")</h3>
                <p class="text-muted">@Html.T("TrainingQuiz.ThankYou", "Katiliminiz icin tesekkur ederiz.")</p>

                <!-- Actions -->
                <div class="mt-4">
                    <a href="/CustomerPortal/MyTrainings" class="btn btn-primary">
                        <i class="bi bi-arrow-left"></i> @Html.T("TrainingQuiz.BackToTrainings", "Egitimlerime Don")
                    </a>
                </div>
            </div>
        </div>
    </div>
    <!-- /ko -->
</div>

@section Scripts {
    <script>
        var PARTICIPANT_ID = @participantId;
        var IS_EXTERNAL = false;
    </script>
    <script src="~/js/Training/Quiz.js" asp-append-version="true"></script>
}
