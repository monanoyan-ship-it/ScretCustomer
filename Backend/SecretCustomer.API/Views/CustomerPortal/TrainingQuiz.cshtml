@{
    ViewData["Title"] = "Egitim Anketi";
    Layout = "~/Views/Shared/_CustomerPortalLayout.cshtml";
    var participantId = ViewBag.ParticipantId;
}

<div id="quiz-app">
    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;"></div>
        <p class="mt-3 text-muted">Anket yukleniyor...</p>
    </div>

    <!-- Error -->
    <div data-bind="visible: hasError" class="text-center py-5">
        <i class="bi bi-exclamation-triangle text-danger" style="font-size: 4rem;"></i>
        <h4 class="mt-3">@Html.T("Common.Error", "Hata")</h4>
        <p class="text-muted" data-bind="text: errorMessage"></p>
        <a href="/CustomerPortal/MyTrainings" class="btn btn-secondary mt-3">
            <i class="bi bi-arrow-left"></i> Egitimlerime Don
        </a>
    </div>

    <!-- No Quiz -->
    <div data-bind="visible: !isLoading() && !hasError() && !quizData()" class="text-center py-5">
        <i class="bi bi-clipboard-x text-warning" style="font-size: 4rem;"></i>
        <h4 class="mt-3">Anket Bulunamadi</h4>
        <p class="text-muted">Bu egitim icin anket tanimlanmamis veya daha once tamamladiniz.</p>
        <a href="/CustomerPortal/MyTrainings" class="btn btn-secondary mt-3">
            <i class="bi bi-arrow-left"></i> Egitimlerime Don
        </a>
    </div>

    <!-- Quiz Already Passed -->
    <div data-bind="visible: !isLoading() && !hasError() && quizData() && quizData().lastAttemptResult && quizData().lastAttemptResult.isPassed" class="text-center py-5">
        <div class="card shadow-sm mx-auto" style="max-width: 500px;">
            <div class="card-body p-5">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                <h3 class="mt-3 text-success">Anketi Zaten Tamamladiniz!</h3>
                <p class="text-muted">Bu anketi daha once basariyla tamamladiniz.</p>
                <div class="my-4">
                    <div style="font-size: 3rem; font-weight: bold;" class="text-success" data-bind="text: quizData().lastAttemptResult.scorePercentage + '%'"></div>
                    <small class="text-muted">Basari Orani</small>
                </div>
                <a href="/CustomerPortal/MyTrainings" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Egitimlerime Don
                </a>
            </div>
        </div>
    </div>

    <!-- Quiz Content -->
    <div data-bind="visible: !isLoading() && !hasError() && quizData() && !(quizData().lastAttemptResult && quizData().lastAttemptResult.isPassed) && !showResult()">
        <div class="card shadow-sm mx-auto" style="max-width: 800px;">
            <!-- Header -->
            <div class="card-header bg-light">
                <h5 class="mb-1" data-bind="text: quizData() ? quizData().title : ''"></h5>
                <small class="text-muted" data-bind="text: quizData() ? quizData().description : ''"></small>
                <!-- ko if: quizData() && quizData().passingScore -->
                <div class="mt-2">
                    <span class="badge bg-info">Gecme Notu: %<span data-bind="text: quizData().passingScore"></span></span>
                </div>
                <!-- /ko -->
            </div>

            <!-- Quiz Body -->
            <div class="card-body" data-bind="visible: questions().length > 0">
                <!-- Progress Bar -->
                <div class="progress mb-4" style="height: 8px;">
                    <div class="progress-bar" role="progressbar"
                         data-bind="style: { width: ((currentIndex() + 1) / questions().length * 100) + '%' }"></div>
                </div>

                <!-- Question -->
                <div data-bind="with: currentQuestion">
                    <div class="mb-4">
                        <span class="badge bg-secondary mb-2">Soru <span data-bind="text: $parent.currentIndex() + 1"></span> / <span data-bind="text: $parent.questions().length"></span></span>
                        <h5 data-bind="text: text"></h5>
                        <!-- ko if: helpText -->
                        <small class="text-muted" data-bind="text: helpText"></small>
                        <!-- /ko -->
                    </div>

                    <!-- Options -->
                    <div class="list-group" data-bind="foreach: options">
                        <button type="button" class="list-group-item list-group-item-action d-flex align-items-center"
                                data-bind="click: $parents[1].selectOption,
                                           css: { 'active': $parents[1].isOptionSelected($data) }">
                            <!-- ko if: $parent.questionTypeId === 1 -->
                            <i class="bi me-3 fs-5" data-bind="css: { 'bi-circle': !$parents[1].isOptionSelected($data), 'bi-check-circle-fill': $parents[1].isOptionSelected($data) }"></i>
                            <!-- /ko -->
                            <!-- ko if: $parent.questionTypeId === 2 -->
                            <i class="bi me-3 fs-5" data-bind="css: { 'bi-square': !$parents[1].isOptionSelected($data), 'bi-check-square-fill': $parents[1].isOptionSelected($data) }"></i>
                            <!-- /ko -->
                            <span data-bind="text: text"></span>
                        </button>
                    </div>
                </div>

                <!-- Navigation -->
                <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-outline-secondary"
                            data-bind="click: prevQuestion, visible: currentIndex() > 0">
                        <i class="bi bi-chevron-left"></i> Onceki
                    </button>
                    <div></div>
                    <button type="button" class="btn btn-primary"
                            data-bind="click: nextQuestion, visible: currentIndex() < questions().length - 1">
                        Sonraki <i class="bi bi-chevron-right"></i>
                    </button>
                    <button type="button" class="btn btn-success"
                            data-bind="click: submitQuiz, visible: currentIndex() >= questions().length - 1, disable: isSubmitting">
                        <span data-bind="visible: isSubmitting" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg" data-bind="visible: !isSubmitting()"></i> Gonder
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Result -->
    <div data-bind="visible: showResult() && quizResult()" class="text-center py-5">
        <div class="card shadow-sm mx-auto" style="max-width: 500px;">
            <div class="card-body p-5">
                <!-- Passed -->
                <div data-bind="visible: quizResult() && quizResult().isPassed">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                    <h3 class="mt-3 text-success">Tebrikler!</h3>
                    <p class="text-muted">Anketi basariyla tamamladiniz.</p>
                </div>
                <!-- Failed -->
                <div data-bind="visible: quizResult() && !quizResult().isPassed">
                    <i class="bi bi-x-circle-fill text-danger" style="font-size: 5rem;"></i>
                    <h3 class="mt-3 text-danger">Basarisiz</h3>
                    <p class="text-muted">Gecme notuna ulasamadiniz. Tekrar deneyebilirsiniz.</p>
                </div>

                <!-- Score -->
                <div class="my-4">
                    <div style="font-size: 3rem; font-weight: bold;" data-bind="text: quizResult() ? quizResult().scorePercentage + '%' : '', css: { 'text-success': quizResult() && quizResult().isPassed, 'text-danger': quizResult() && !quizResult().isPassed }"></div>
                    <div class="progress mx-auto mt-2" style="height: 10px; max-width: 300px;">
                        <div class="progress-bar" role="progressbar"
                             data-bind="style: { width: (quizResult() ? quizResult().scorePercentage : 0) + '%' },
                                        css: { 'bg-success': quizResult() && quizResult().isPassed, 'bg-danger': quizResult() && !quizResult().isPassed }"></div>
                    </div>
                    <div class="mt-2">
                        <span class="text-muted">
                            <span data-bind="text: quizResult() ? quizResult().totalScore : 0"></span> /
                            <span data-bind="text: quizResult() ? quizResult().maxPossibleScore : 0"></span> puan
                        </span>
                    </div>
                    <!-- ko if: quizResult() && quizResult().passingScore -->
                    <small class="text-muted d-block mt-1">Gecme notu: %<span data-bind="text: quizResult().passingScore"></span></small>
                    <!-- /ko -->
                </div>

                <!-- Actions -->
                <div class="mt-4">
                    <a href="/CustomerPortal/MyTrainings" class="btn btn-secondary me-2">
                        <i class="bi bi-arrow-left"></i> Egitimlerime Don
                    </a>
                    <button type="button" class="btn btn-primary" data-bind="click: retryQuiz, visible: quizResult() && !quizResult().isPassed">
                        <i class="bi bi-arrow-repeat"></i> Tekrar Dene
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var PARTICIPANT_ID = @participantId;
        var IS_EXTERNAL = false;
    </script>
    <script src="~/js/Training/Quiz.js" asp-append-version="true"></script>
}
