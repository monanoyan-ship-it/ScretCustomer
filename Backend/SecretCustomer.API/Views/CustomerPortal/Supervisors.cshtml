@{
    ViewData["Title"] = @Html.T("CustomerPortal.Supervisors.Title", "Supervizorler");
    Layout = "_CustomerLayout";
}

<div id="customer-supervisors-app">
    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yükleniyor...")</span>
        </div>
    </div>

    <!-- Content -->
    <div data-bind="visible: !isLoading()">
        <!-- Empty State -->
        <div data-bind="visible: groups().length === 0" class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-people fs-1 text-muted"></i>
                <h5 class="mt-3">@Html.T("CustomerPortal.Supervisors.NotFound", "Supervizor Bulunamadi")</h5>
                <p class="text-muted">@Html.T("CustomerPortal.Supervisors.NoRecords", "Firmaniza tanimli supervizor bulunmuyor.")</p>
            </div>
        </div>

        <!-- Supervisors Grouped -->
        <div data-bind="visible: groups().length > 0">
            <!-- ko foreach: groups -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-building me-2"></i>
                        <span data-bind="text: groupName"></span>
                        <span class="badge bg-light text-primary ms-2" data-bind="text: supervisors.length"></span>
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@Html.T("Common.FullName", "Ad Soyad")</th>
                                    <th>@Html.T("Common.Title", "Unvan")</th>
                                    <th class="text-center">@Html.T("CustomerPortal.Supervisors.PersonnelCount", "Personel")</th>
                                    <th class="text-center">@Html.T("CustomerPortal.Supervisors.EvaluationCount", "Dinleme")</th>
                                    <th class="text-center">@Html.T("CustomerPortal.Supervisors.AverageScore", "Ort. Puan")</th>
                                    <th class="text-center" style="width: 80px;">@Html.T("Common.Actions", "İşlem")</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: supervisors">
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 36px; height: 36px;">
                                                <i class="bi bi-person"></i>
                                            </div>
                                            <div>
                                                <strong data-bind="text: fullName"></strong>
                                                <!-- ko if: email -->
                                                <br><small class="text-muted" data-bind="text: email"></small>
                                                <!-- /ko -->
                                            </div>
                                        </div>
                                    </td>
                                    <td><span data-bind="text: title || '-'"></span></td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary" data-bind="text: personnelCount"></span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-info" data-bind="text: evaluationCount"></span>
                                    </td>
                                    <td class="text-center">
                                        <span class="fw-bold" data-bind="text: averageScore.toFixed(1), css: $root.getScoreClass(averageScore)"></span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary"
                                                data-bind="click: $root.showMonthlyTrend"
                                                title="@Html.T("CustomerPortal.Supervisors.MonthlyTrend", "Aylık Gelişim")">
                                            <i class="bi bi-graph-up"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <!-- /ko -->
        </div>
    </div>

    <!-- Monthly Trend Modal -->
    <div class="modal fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-graph-up me-2"></i>
                        @Html.T("CustomerPortal.Supervisors.MonthlyTrend", "Aylık Gelişim") -
                        <span data-bind="text: selectedSupervisorName"></span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bind="click: closeModal"></button>
                </div>
                <div class="modal-body">
                    <!-- Loading -->
                    <div data-bind="visible: isChartLoading" class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">@Html.T("Common.Loading", "Yükleniyor...")</span>
                        </div>
                    </div>

                    <!-- Chart Content -->
                    <div data-bind="visible: !isChartLoading()">
                        <!-- Summary Cards -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <div class="card bg-primary bg-opacity-10 border-0">
                                    <div class="card-body text-center py-3">
                                        <h6 class="text-muted mb-1">@Html.T("CustomerPortal.Supervisors.TeamSize", "Ekip Büyüklüğü")</h6>
                                        <h3 class="mb-0 text-primary" data-bind="text: chartData().teamMemberCount || 0"></h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-success bg-opacity-10 border-0">
                                    <div class="card-body text-center py-3">
                                        <h6 class="text-muted mb-1">@Html.T("CustomerPortal.Supervisors.TotalEvaluations", "Toplam Dinleme")</h6>
                                        <h3 class="mb-0 text-success" data-bind="text: totalEvaluationCount"></h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-info bg-opacity-10 border-0">
                                    <div class="card-body text-center py-3">
                                        <h6 class="text-muted mb-1">@Html.T("CustomerPortal.Supervisors.OverallAverage", "Genel Ortalama")</h6>
                                        <h3 class="mb-0 text-info" data-bind="text: overallAverageScore"></h3>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Chart -->
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <canvas id="supervisorMonthlyChart" height="300"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeModal">
                        <i class="bi bi-x-lg me-1"></i>@Html.T("Common.Close", "Kapat")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }"></div>
</div>

@section Scripts {
    <script src="~/js/CustomerPortal/supervisors.js"></script>
}
