@{
    ViewData["Title"] = Html.T("Profile.Title", "Profil");
    Layout = "_CustomerLayout";
}

<div id="profile-app">
    <!-- Loading State -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yükleniyor...")</span>
        </div>
    </div>

    <div data-bind="visible: !isLoading()" class="row">
        <!-- Profil Bilgileri -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-person-circle me-2"></i>@Html.T("Profile.Info", "Profil Bilgileri")</h5>
                </div>
                <div class="card-body">
                    <form data-bind="submit: updateProfile">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">@Html.T("Profile.FirstName", "Ad") <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" data-bind="value: firstName" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">@Html.T("Common.LastName", "Soyad") <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" data-bind="value: lastName" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Html.T("Common.Email", "E-posta")</label>
                            <input type="email" class="form-control" data-bind="value: email" placeholder="ornek@email.com">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Html.T("Profile.Phone", "Telefon")</label>
                            <input type="tel" class="form-control" data-bind="value: phoneNumber" placeholder="05XX XXX XX XX">
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted small">@Html.T("Profile.Username", "Kullanıcı Adı")</label>
                            <div class="form-control-plaintext text-muted" data-bind="text: username"></div>
                        </div>

                        <button type="submit" class="btn btn-success w-100" data-bind="disable: isUpdating() || !canUpdateProfile()">
                            <!-- ko if: isUpdating() -->
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <!-- /ko -->
                            <i class="bi bi-check-circle me-1"></i>@Html.T("Profile.SaveChanges", "Değişiklikleri Kaydet")
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Şifre Değiştirme -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-key me-2"></i>@Html.T("Profile.ChangePassword", "Şifre Değiştir")</h5>
                </div>
                <div class="card-body">
                    <form data-bind="submit: changePassword">
                        <div class="mb-3">
                            <label class="form-label">@Html.T("Profile.CurrentPassword", "Mevcut Şifre") <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="password" class="form-control" data-bind="value: currentPassword, attr: { type: showCurrentPassword() ? 'text' : 'password' }" required>
                                <button class="btn btn-outline-secondary" type="button" data-bind="click: toggleCurrentPassword">
                                    <i class="bi" data-bind="css: showCurrentPassword() ? 'bi-eye-slash' : 'bi-eye'"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Html.T("Profile.NewPassword", "Yeni Şifre") <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="password" class="form-control" data-bind="value: newPassword, attr: { type: showNewPassword() ? 'text' : 'password' }" required minlength="6">
                                <button class="btn btn-outline-secondary" type="button" data-bind="click: toggleNewPassword">
                                    <i class="bi" data-bind="css: showNewPassword() ? 'bi-eye-slash' : 'bi-eye'"></i>
                                </button>
                            </div>
                            <small class="text-muted">@Html.T("Profile.PasswordMinLength", "En az 6 karakter olmalıdır")</small>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">@Html.T("Profile.ConfirmPassword", "Yeni Şifre (Tekrar)") <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="password" class="form-control" data-bind="value: confirmPassword, attr: { type: showConfirmPassword() ? 'text' : 'password' }" required>
                                <button class="btn btn-outline-secondary" type="button" data-bind="click: toggleConfirmPassword">
                                    <i class="bi" data-bind="css: showConfirmPassword() ? 'bi-eye-slash' : 'bi-eye'"></i>
                                </button>
                            </div>
                            <!-- ko if: confirmPassword() && newPassword() !== confirmPassword() -->
                            <small class="text-danger">@Html.T("Profile.PasswordMismatch", "Şifreler eşleşmiyor")</small>
                            <!-- /ko -->
                        </div>

                        <button type="submit" class="btn btn-warning w-100" data-bind="disable: isChangingPassword() || !canSubmitPassword()">
                            <!-- ko if: isChangingPassword() -->
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <!-- /ko -->
                            <i class="bi bi-check-circle me-1"></i>@Html.T("Profile.UpdatePassword", "Şifreyi Güncelle")
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Firma Ayarları (Sadece Manager ve Admin) -->
        <div class="col-lg-12 mb-4" data-bind="visible: canManageCompanySettings">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-building me-2"></i>@Html.T("Profile.CompanySettings", "Firma Ayarları")</h5>
                </div>
                <div class="card-body">
                    <form data-bind="submit: updateCompanySettings">
                        <div class="mb-3">
                            <label class="form-label">
                                <i class="bi bi-link-45deg me-1"></i>
                                @Html.T("Profile.CallSystemUrl", "Çağrı Sistemi URL")
                            </label>
                            <input type="text" class="form-control" data-bind="value: callSystemUrl"
                                   placeholder="https://firmasistemi.com/calls/{CallId}">
                            <div class="form-text">
                                <i class="bi bi-info-circle me-1"></i>
                                @Html.T("Profile.CallSystemUrlHelp", "Çağrı ID'sine tıklandığında yönlendirilecek URL. {CallId} yazdığınız yere gerçek çağrı ID'si yazılır.")
                                <br>
                                <strong>@Html.T("Profile.Example", "Örnek"):</strong> <code>https://callcenter.example.com/recording/{CallId}</code>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-info w-100" data-bind="disable: isUpdatingCompanySettings()">
                            <!-- ko if: isUpdatingCompanySettings() -->
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <!-- /ko -->
                            <i class="bi bi-check-circle me-1"></i>@Html.T("Profile.SaveCompanySettings", "Firma Ayarlarını Kaydet")
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/CustomerPortal/profile.js" asp-append-version="true"></script>
}
