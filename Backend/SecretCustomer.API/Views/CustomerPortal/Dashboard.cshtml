@{
    ViewData["Title"] = @Html.T("CustomerPortal.Menu.Dashboard", "Dashboard");
    Layout = "_CustomerLayout";
}

<div id="customer-dashboard-app">
    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yükleniyor...")</span>
        </div>
    </div>

    <!-- Dashboard Content -->
    <div data-bind="visible: !isLoading()">
        <!-- Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">@Html.T("Dashboard.TotalEvaluations", "Toplam Değerlendirme")</small>
                                <h3 class="mb-0 mt-1" data-bind="text: stats().totalEvaluations || 0"></h3>
                            </div>
                            <div class="bg-success bg-opacity-10 rounded-circle p-2">
                                <i class="bi bi-clipboard-check text-success fs-5"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">@Html.T("Dealer.AverageScore", "Ortalama Puan")</small>
                                <h3 class="mb-0 mt-1" data-bind="text: (stats().averageScore || 0).toFixed(1)"></h3>
                            </div>
                            <div class="bg-primary bg-opacity-10 rounded-circle p-2">
                                <i class="bi bi-star-fill text-primary fs-5"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">@Html.T("CustomerPortal.Dashboard.OrganizationCount", "Organizasyon")</small>
                                <h3 class="mb-0 mt-1" data-bind="text: stats().organizationCount || 0"></h3>
                            </div>
                            <div class="bg-info bg-opacity-10 rounded-circle p-2">
                                <i class="bi bi-building text-info fs-5"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">@Html.T("Common.ThisMonth", "Bu Ay")</small>
                                <h3 class="mb-0 mt-1" data-bind="text: stats().thisMonthEvaluations || 0"></h3>
                            </div>
                            <div class="bg-warning bg-opacity-10 rounded-circle p-2">
                                <i class="bi bi-calendar-check text-warning fs-5"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Monthly Trend by Project Type -->
        <!-- Loading -->
        <div data-bind="visible: isMonthlyTrendLoading" class="text-center py-4 mb-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@Html.T("Common.Loading", "Yükleniyor...")</span>
            </div>
        </div>
        <!-- No Data -->
        <div data-bind="visible: !isMonthlyTrendLoading() && monthlyTrendByType().length === 0" class="text-center text-muted py-4 mb-4">
            <i class="bi bi-graph-up fs-1"></i>
            <p class="mt-2">@Html.T("CustomerPortal.Dashboard.NoTrendData", "Aylık trend verisi bulunamadı.")</p>
        </div>
        <!-- Charts by Project Type -->
        <div data-bind="visible: !isMonthlyTrendLoading() && monthlyTrendByType().length > 0">
            <!-- ko foreach: monthlyTrendByType -->
            <div class="row g-3 mb-4">
                <div class="col-12">
                    <div class="card border-0 shadow-sm h-100" data-bind="attr: { id: 'monthlyChartCard_' + projectTypeId }">
                        <div class="card-header bg-white border-0 py-2">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <h6 class="mb-0">
                                    <i data-bind="attr: { 'class': projectTypeIcon + ' me-2' }"></i>
                                    <span data-bind="text: projectTypeName"></span>
                                    <!-- ko if: panelType === 'survey' -->
                                    <small class="text-muted ms-1">@Html.T("CustomerPortal.Dashboard.SurveyTrend", "Anket Yanıt Trendi")</small>
                                    <!-- /ko -->
                                    <!-- ko if: panelType === 'enneagram' -->
                                    <small class="text-muted ms-1">@Html.T("CustomerPortal.Dashboard.EnneagramTrend", "Kişilik Analizi")</small>
                                    <!-- /ko -->
                                    <!-- ko if: panelType !== 'survey' && panelType !== 'enneagram' -->
                                    <small class="text-muted ms-1">@Html.T("Dashboard.MonthlyTrend", "Aylık Değerlendirme Trendi")</small>
                                    <!-- /ko -->
                                </h6>
                                <div class="d-flex gap-1 align-items-center flex-wrap">
                                    <!-- ko if: panelType !== 'survey' && panelType !== 'enneagram' -->
                                    <select class="form-select form-select-sm" style="width: auto; min-width: 140px;"
                                            data-bind="value: selectedProjectId, options: projects, optionsText: 'name', optionsValue: 'id', optionsCaption: 'Tüm Projeler'"></select>
                                    <select class="form-select form-select-sm" style="width: auto; min-width: 120px;" data-bind="value: dateRange">
                                        <option value="">Tarih Seçin</option>
                                        <option value="thisWeek">Bu Hafta</option>
                                        <option value="lastWeek">Geçen Hafta</option>
                                        <option value="thisMonth">Bu Ay</option>
                                        <option value="lastMonth">Geçen Ay</option>
                                        <option value="last3Months">Son 3 Ay</option>
                                        <option value="last6Months">Son 6 Ay</option>
                                        <option value="thisYear">Bu Yıl</option>
                                        <option value="lastYear">Geçen Yıl</option>
                                    </select>
                                    <input type="date" class="form-control form-control-sm" style="width: auto;" data-bind="value: startDate">
                                    <input type="date" class="form-control form-control-sm" style="width: auto;" data-bind="value: endDate">
                                    <button class="btn btn-sm btn-primary" data-bind="click: function() { $parent.reloadMonthlyTrendPanel(projectTypeId); }" title="Filtrele">
                                        <i class="bi bi-filter"></i>
                                    </button>
                                    <!-- /ko -->
                                    <button class="btn btn-sm btn-outline-danger" data-bind="click: function() { $parent.exportChartToPdf('monthlyChartCard_' + projectTypeId, projectTypeName + '_Aylik_Trend'); }" title="PDF İndir">
                                        <i class="bi bi-file-earmark-pdf"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-success" data-bind="click: function() { $parent.exportMonthlyTrendPanelToExcel(projectTypeId); }" title="Excel İndir">
                                        <i class="bi bi-file-earmark-excel"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <!-- Survey summary cards -->
                            <!-- ko if: panelType === 'survey' && summary -->
                            <div class="row g-2 mb-3">
                                <div class="col-6 col-md-3">
                                    <div class="border rounded p-2 text-center">
                                        <small class="text-muted d-block">@Html.T("CustomerPortal.Dashboard.ProjectCount", "Proje")</small>
                                        <strong data-bind="text: summary.projectCount"></strong>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="border rounded p-2 text-center">
                                        <small class="text-muted d-block">@Html.T("CustomerPortal.Dashboard.TotalInvitations", "Davetiye")</small>
                                        <strong data-bind="text: summary.totalInvitations"></strong>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="border rounded p-2 text-center">
                                        <small class="text-muted d-block">@Html.T("CustomerPortal.Dashboard.ResponseRate", "Yanıt Oranı")</small>
                                        <strong data-bind="text: summary.responseRate + '%'"></strong>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="border rounded p-2 text-center">
                                        <small class="text-muted d-block">@Html.T("Dealer.AverageScore", "Ortalama Puan")</small>
                                        <strong data-bind="text: summary.averageScore"></strong>
                                    </div>
                                </div>
                            </div>
                            <!-- /ko -->

                            <!-- Enneagram summary cards -->
                            <!-- ko if: panelType === 'enneagram' && summary -->
                            <div class="row g-2 mb-3">
                                <div class="col-6 col-md-4">
                                    <div class="border rounded p-2 text-center">
                                        <small class="text-muted d-block">@Html.T("CustomerPortal.Dashboard.ProjectCount", "Proje")</small>
                                        <strong data-bind="text: summary.projectCount"></strong>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="border rounded p-2 text-center">
                                        <small class="text-muted d-block">@Html.T("CustomerPortal.Dashboard.TotalResponses", "Toplam Yanıt")</small>
                                        <strong data-bind="text: summary.totalResponses"></strong>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="border rounded p-2 text-center">
                                        <small class="text-muted d-block">@Html.T("CustomerPortal.Dashboard.DominantType", "Baskın Tip")</small>
                                        <strong data-bind="text: summary.dominantType"></strong>
                                    </div>
                                </div>
                            </div>
                            <!-- /ko -->

                            <!-- Enneagram: two charts side by side -->
                            <!-- ko if: panelType === 'enneagram' -->
                            <div class="row g-3">
                                <div class="col-12 col-md-7">
                                    <div style="position: relative; height: 280px;">
                                        <canvas data-bind="attr: { id: 'monthlyChart_' + projectTypeId }"></canvas>
                                    </div>
                                </div>
                                <div class="col-12 col-md-5">
                                    <div style="position: relative; height: 280px;">
                                        <canvas data-bind="attr: { id: 'enneagramDistChart_' + projectTypeId }"></canvas>
                                    </div>
                                </div>
                            </div>
                            <!-- /ko -->

                            <!-- Default / Survey: single chart -->
                            <!-- ko if: panelType !== 'enneagram' -->
                            <div style="position: relative; height: 280px;">
                                <canvas data-bind="attr: { id: 'monthlyChart_' + projectTypeId }"></canvas>
                            </div>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
            </div>
            <!-- /ko -->
        </div>

        <!-- Score Distribution by Project Type -->
        <div class="row g-3 mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm" id="scoreDistributionCard">
                    <div class="card-header bg-white border-0 py-2">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <h6 class="mb-0"><i class="bi bi-pie-chart me-2"></i>@Html.T("Dashboard.ScoreDistribution", "Puan Dağılımı")</h6>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-outline-secondary py-0 px-1" type="button" data-bs-toggle="collapse" data-bs-target="#scoreDistributionFilter">
                                    <i class="bi bi-funnel"></i>
                                </button>
                            </div>
                        </div>
                        <div class="collapse mt-2" id="scoreDistributionFilter">
                            <div class="row g-2">
                                <div class="col-12 col-md-4">
                                    <select class="form-select form-select-sm" data-bind="value: scoreDistProjectId, optionsCaption: 'Tüm Projeler'">
                                        <!-- ko foreach: scoreDistProjects -->
                                        <option data-bind="value: id, text: name"></option>
                                        <!-- /ko -->
                                    </select>
                                </div>
                                <div class="col-6 col-md-2">
                                    <select class="form-select form-select-sm" data-bind="value: scoreDistDateRange">
                                        <option value="">Tarih Seçin</option>
                                        <option value="thisWeek">Bu Hafta</option>
                                        <option value="lastWeek">Geçen Hafta</option>
                                        <option value="thisMonth">Bu Ay</option>
                                        <option value="lastMonth">Geçen Ay</option>
                                        <option value="last3Months">Son 3 Ay</option>
                                        <option value="last6Months">Son 6 Ay</option>
                                        <option value="thisYear">Bu Yıl</option>
                                        <option value="lastYear">Geçen Yıl</option>
                                    </select>
                                </div>
                                <div class="col-6 col-md-2">
                                    <input type="date" class="form-control form-control-sm" data-bind="value: scoreDistStartDate" placeholder="Başlangıç">
                                </div>
                                <div class="col-6 col-md-2">
                                    <input type="date" class="form-control form-control-sm" data-bind="value: scoreDistEndDate" placeholder="Bitiş">
                                </div>
                                <div class="col-6 col-md-2">
                                    <button class="btn btn-sm btn-primary w-100" data-bind="click: loadScoreDistribution">
                                        <i class="bi bi-filter me-1"></i>@Html.T("Common.Filter", "Filtrele")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- Loading -->
                        <div data-bind="visible: isScoreDistLoading" class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">@Html.T("Common.Loading", "Yükleniyor...")</span>
                            </div>
                        </div>
                        <!-- No Data -->
                        <div data-bind="visible: !isScoreDistLoading() && scoreDistributionByType().length === 0" class="text-center text-muted py-4">
                            <i class="bi bi-pie-chart fs-1"></i>
                            <p class="mt-2">@Html.T("CustomerPortal.Dashboard.NoScoreData", "Puan dağılımı verisi bulunamadı.")</p>
                        </div>
                        <!-- Charts by Project Type -->
                        <div data-bind="visible: !isScoreDistLoading() && scoreDistributionByType().length > 0">
                            <div class="row g-3" data-bind="foreach: scoreDistributionByType">
                                <div class="col-12 col-md-6 col-xl-4">
                                    <div class="card border h-100">
                                        <div class="card-header py-2 d-flex justify-content-between align-items-center">
                                            <h6 class="mb-0">
                                                <i data-bind="attr: { 'class': projectTypeIcon + ' me-2' }"></i>
                                                <span data-bind="text: projectTypeName"></span>
                                                <small class="text-muted ms-1" data-bind="text: '(' + total + ')'"></small>
                                            </h6>
                                            <div class="d-flex gap-1">
                                                <button class="btn btn-sm btn-outline-danger py-0 px-1"
                                                        data-bind="click: function() { $parent.exportChartToPdf('scoreDistCard_' + projectTypeId, projectTypeName + '_Puan_Dagilimi'); }"
                                                        title="PDF İndir">
                                                    <i class="bi bi-file-earmark-pdf"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="card-body" data-bind="attr: { id: 'scoreDistCard_' + projectTypeId }">
                                            <div style="position: relative; height: 220px;">
                                                <canvas data-bind="attr: { id: 'scoreDistChart_' + projectTypeId }"></canvas>
                                            </div>
                                            <div class="text-center mt-2">
                                                <small class="text-muted" data-bind="text: 'Başarı: ≥' + successThreshold + '% | Uyarı: ≥' + warningThreshold + '%'"></small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Question Trends Section -->
        <div class="row g-3 mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm" id="questionTrendCard">
                    <div class="card-header bg-white border-0 py-2">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <h6 class="mb-0"><i class="bi bi-bar-chart-line me-2"></i>@Html.T("CustomerPortal.Dashboard.QuestionTrend", "Soru Bazlı Başarı Trendi")</h6>
                            <div class="d-flex gap-1 align-items-center flex-wrap">
                                <select class="form-select form-select-sm" style="width: auto; min-width: 140px;" data-bind="value: questionTrendProjectId, options: questionTrendProjects, optionsText: 'name', optionsValue: 'id', optionsCaption: 'Tüm Projeler'"></select>
                                <select class="form-select form-select-sm" style="width: auto; min-width: 120px;" data-bind="value: questionTrendDateRange">
                                    <option value="">Tarih Seçin</option>
                                    <option value="thisWeek">Bu Hafta</option>
                                    <option value="lastWeek">Geçen Hafta</option>
                                    <option value="thisMonth">Bu Ay</option>
                                    <option value="lastMonth">Geçen Ay</option>
                                    <option value="last3Months">Son 3 Ay</option>
                                    <option value="last6Months">Son 6 Ay</option>
                                    <option value="thisYear">Bu Yıl</option>
                                    <option value="lastYear">Geçen Yıl</option>
                                </select>
                                <input type="date" class="form-control form-control-sm" style="width: auto;" data-bind="value: questionTrendStartDate">
                                <input type="date" class="form-control form-control-sm" style="width: auto;" data-bind="value: questionTrendEndDate">
                                <button class="btn btn-sm btn-primary" data-bind="click: function() { questionTrendTab() === 'groups' ? loadQuestionGroupTrend() : loadQuestionTrend(); }" title="Filtrele">
                                    <i class="bi bi-filter"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" data-bind="click: function() { exportChartToPdf('questionTrendCard', 'Soru_Trendi'); }" title="PDF İndir">
                                    <i class="bi bi-file-earmark-pdf"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-success" data-bind="click: function() { exportChartToExcel('question-trend', 'questionTrendCard', 'Soru_Trendi'); }" title="Excel İndir">
                                    <i class="bi bi-file-earmark-excel"></i>
                                </button>
                                <ul class="nav nav-pills nav-pills-sm mb-0">
                                    <li class="nav-item">
                                        <a class="nav-link py-1 px-2" href="#" data-bind="css: { active: questionTrendTab() === 'groups' }, click: function() { questionTrendTab('groups'); loadQuestionGroupTrend(); }">
                                            @Html.T("CustomerPortal.Dashboard.QuestionGroups", "Soru Grupları")
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link py-1 px-2" href="#" data-bind="css: { active: questionTrendTab() === 'questions' }, click: function() { questionTrendTab('questions'); loadQuestionTrend(); }">
                                            @Html.T("CustomerPortal.Dashboard.Questions", "Sorular")
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- Loading -->
                        <div data-bind="visible: isQuestionTrendLoading" class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">@Html.T("Common.Loading", "Yükleniyor...")</span>
                            </div>
                        </div>
                        <!-- No Data -->
                        <div data-bind="visible: !isQuestionTrendLoading() && questionTrendData().length === 0" class="text-center text-muted py-4">
                            <i class="bi bi-bar-chart fs-1"></i>
                            <p class="mt-2">@Html.T("Report.NoQuestionData", "Soru bazlı veri bulunamadı.")</p>
                        </div>
                        <!-- Chart -->
                        <div data-bind="visible: !isQuestionTrendLoading() && questionTrendData().length > 0">
                            <div style="position: relative; height: 320px;">
                                <canvas id="questionTrendChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Evaluations -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-2 d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><i class="bi bi-clock-history me-2"></i>@Html.T("Report.RecentEvaluations", "Son Değerlendirmeler")</h6>
                <a href="/CustomerPortal/ExternalEvaluations" class="btn btn-sm btn-outline-success py-1">
                    @Html.T("Common.ViewAll", "Tümünü Gör") <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="card-body">
                <div data-bind="visible: recentEvaluations().length === 0" class="text-center text-muted py-4">
                    <i class="bi bi-inbox fs-1"></i>
                    <p class="mt-2">@Html.T("CustomerPortal.Dashboard.NoEvaluations", "Henüz değerlendirme bulunmuyor.")</p>
                </div>
                <div class="table-responsive" data-bind="visible: recentEvaluations().length > 0">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>@Html.T("Common.Date", "Tarih")</th>
                                <th>@Html.T("Common.Project", "Proje")</th>
                                <th>@Html.T("Common.Personnel", "Personel")</th>
                                <th>@Html.T("Common.Checklist", "Checklist")</th>
                                <th>@Html.T("Common.Score", "Puan")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: recentEvaluations">
                            <tr>
                                <td data-bind="text: new Date(evaluationDate).toLocaleDateString('tr-TR')"></td>
                                <td data-bind="text: projectName"></td>
                                <td data-bind="text: personnelName"></td>
                                <td data-bind="text: checklistName"></td>
                                <td>
                                    <span class="badge" data-bind="text: score.toFixed(1), css: $parent.getScoreBadgeClass(score)"></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Score Distribution Evaluations Modal -->
    <div class="modal fade" data-bind="css: { show: isScoreModalOpen }, style: { display: isScoreModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header" data-bind="css: selectedCategoryHeaderClass">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-list-ul me-2"></i>
                        <span data-bind="text: selectedProjectTypeName"></span> -
                        <span data-bind="text: selectedCategoryLabel"></span>
                        <span class="badge bg-light text-dark ms-2" data-bind="text: scoreModalTotal"></span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bind="click: closeScoreModal"></button>
                </div>
                <div class="modal-body">
                    <!-- Loading -->
                    <div data-bind="visible: isScoreModalLoading" class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">@Html.T("Common.Loading", "Yükleniyor...")</span>
                        </div>
                    </div>

                    <!-- Evaluations Table -->
                    <div data-bind="visible: !isScoreModalLoading()">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>@Html.T("Common.Date", "Tarih")</th>
                                        <th>@Html.T("Common.Project", "Proje")</th>
                                        <th>@Html.T("Common.Personnel", "Personel")</th>
                                        <th>@Html.T("Common.Organization", "Organizasyon")</th>
                                        <th class="text-center">@Html.T("Common.Score", "Puan")</th>
                                        <th class="text-center">@Html.T("Common.Cards", "Kartlar")</th>
                                    </tr>
                                </thead>
                                <tbody data-bind="foreach: scoreModalEvaluations">
                                    <tr>
                                        <td data-bind="text: new Date(evaluationDate).toLocaleDateString('tr-TR')"></td>
                                        <td data-bind="text: projectName"></td>
                                        <td data-bind="text: personnelName"></td>
                                        <td data-bind="text: organizationName"></td>
                                        <td class="text-center">
                                            <span class="badge" data-bind="text: score.toFixed(1), css: $root.getScoreBadgeClass(score)"></span>
                                        </td>
                                        <td class="text-center">
                                            <!-- ko if: yellowCardCount > 0 -->
                                            <span class="badge bg-warning text-dark me-1" data-bind="text: yellowCardCount"></span>
                                            <!-- /ko -->
                                            <!-- ko if: redCardCount > 0 -->
                                            <span class="badge bg-danger" data-bind="text: redCardCount"></span>
                                            <!-- /ko -->
                                            <!-- ko if: !yellowCardCount && !redCardCount -->
                                            <span class="text-muted">-</span>
                                            <!-- /ko -->
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <div data-bind="visible: scoreModalTotalPages() > 1" class="d-flex justify-content-between align-items-center mt-3">
                            <div class="text-muted">
                                @Html.T("Common.ShowingXofY", "Gösterilen"): <span data-bind="text: scoreModalEvaluations().length"></span> / <span data-bind="text: scoreModalTotal"></span>
                            </div>
                            <nav>
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item" data-bind="css: { disabled: scoreModalPage() <= 1 }">
                                        <a class="page-link" href="#" data-bind="click: function() { loadScoreModalEvaluations(scoreModalPage() - 1); }">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>
                                    <li class="page-item disabled">
                                        <span class="page-link" data-bind="text: scoreModalPage() + ' / ' + scoreModalTotalPages()"></span>
                                    </li>
                                    <li class="page-item" data-bind="css: { disabled: scoreModalPage() >= scoreModalTotalPages() }">
                                        <a class="page-link" href="#" data-bind="click: function() { loadScoreModalEvaluations(scoreModalPage() + 1); }">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" data-bind="click: exportScoreDistribution">
                        <i class="bi bi-file-earmark-excel me-1"></i>@Html.T("Common.ExportExcel", "Excel'e Aktar")
                    </button>
                    <button type="button" class="btn btn-secondary" data-bind="click: closeScoreModal">
                        <i class="bi bi-x-lg me-1"></i>@Html.T("Common.Close", "Kapat")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isScoreModalOpen }, style: { display: isScoreModalOpen() ? 'block' : 'none' }"></div>
</div>

@section Scripts {
    <script src="~/js/CustomerPortal/dashboard.js"></script>
}
