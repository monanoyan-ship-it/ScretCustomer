@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = @Html.T("Menu.PersonnelReportCard", "Temsilci Karnesi");
}

<div id="personnel-report-card-app">
    <div class="row g-3">
        <!-- Sol Panel: Personel Listesi -->
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white py-2">
                    <h6 class="mb-0"><i class="bi bi-people"></i> @Html.T("Report.Personnel", "Temsilciler")</h6>
                </div>
                <div class="card-body p-2">
                    <!-- Arama Kutusu -->
                    <div class="mb-2">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" placeholder="@Html.T("Common.Search", "Ara...")"
                                   data-bind="value: searchText, valueUpdate: 'input'" autocomplete="off">
                            <button class="btn btn-outline-secondary" type="button" data-bind="visible: searchText(), click: clearSearch">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Organizasyon Filtresi -->
                    <div class="mb-2">
                        <select class="form-select form-select-sm" data-bind="value: selectedOrganizationId, options: organizations, optionsValue: 'id', optionsText: 'name', optionsCaption: '@Html.T("Report.AllBranches", "Tüm Şubeler")'"></select>
                    </div>

                    <!-- Personel Listesi -->
                    <div class="personnel-list-container" style="max-height: calc(100vh - 280px); overflow-y: auto;">
                        <!-- Loading -->
                        <div data-bind="visible: isLoadingPersonnel" class="text-center py-3">
                            <div class="spinner-border spinner-border-sm text-primary"></div>
                        </div>

                        <!-- Empty State -->
                        <div data-bind="visible: !isLoadingPersonnel() && filteredPersonnelList().length === 0" class="text-center py-3 text-muted">
                            <i class="bi bi-person-x"></i>
                            <small class="d-block">@Html.T("Report.NoPersonnelFound", "Temsilci bulunamadı")</small>
                        </div>

                        <!-- Personnel List -->
                        <div class="list-group list-group-flush" data-bind="foreach: filteredPersonnelList">
                            <a href="#" class="list-group-item list-group-item-action py-2 px-2"
                               data-bind="click: $parent.selectPersonnel, css: { active: $parent.selectedPersonnelId() == id }">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="bi bi-person-circle me-1"></i>
                                        <span data-bind="text: name"></span>
                                    </div>
                                    <!-- ko if: organizationName -->
                                    <small class="text-muted" data-bind="text: organizationName" style="font-size: 0.7rem;"></small>
                                    <!-- /ko -->
                                </div>
                            </a>
                        </div>
                    </div>

                    <!-- Personel Sayısı -->
                    <div class="border-top pt-2 mt-2">
                        <small class="text-muted">
                            <span data-bind="text: filteredPersonnelList().length"></span> / <span data-bind="text: personnelList().length"></span> @Html.T("Report.Personnel", "temsilci")
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sağ Panel: Karne -->
        <div class="col-md-9">
            <!-- Personel Seçilmedi -->
            <div data-bind="visible: !selectedPersonnelId()" class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-person-badge text-muted" style="font-size: 4rem;"></i>
                    <h5 class="mt-3 text-muted">@Html.T("Report.SelectPersonnelToViewReport", "Karne görmek için bir temsilci seçin")</h5>
                    <p class="text-muted">@Html.T("Report.SelectFromLeftPanel", "Sol panelden bir temsilci seçerek karnesini görüntüleyebilirsiniz.")</p>
                </div>
            </div>

            <!-- Personel Seçildi -->
            <div data-bind="visible: selectedPersonnelId()">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0">
                        <i class="bi bi-person-badge"></i>
                        <span data-bind="text: selectedPersonnelName"></span>
                    </h4>
                    <div class="btn-group" data-bind="visible: report()">
                        <button class="btn btn-success btn-sm" data-bind="click: exportToExcel, disable: isExporting">
                            <span data-bind="visible: !isExporting()"><i class="bi bi-file-earmark-excel"></i> Excel</span>
                            <span data-bind="visible: isExporting"><span class="spinner-border spinner-border-sm"></span></span>
                        </button>
                        <button class="btn btn-primary btn-sm" data-bind="click: exportToWord, disable: isExporting">
                            <span data-bind="visible: !isExporting()"><i class="bi bi-file-earmark-word"></i> Word</span>
                            <span data-bind="visible: isExporting"><span class="spinner-border spinner-border-sm"></span></span>
                        </button>
                        <button class="btn btn-danger btn-sm" data-bind="click: exportToPdf, disable: isExporting">
                            <span data-bind="visible: !isExporting()"><i class="bi bi-file-pdf"></i> PDF</span>
                            <span data-bind="visible: isExporting"><span class="spinner-border spinner-border-sm"></span></span>
                        </button>
                    </div>
                </div>

                <!-- Filtreler -->
                <div class="card shadow-sm mb-3">
                    <div class="card-body py-2">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <!-- Filtre Ekle Dropdown -->
                            <div class="dropdown">
                                <button class="btn btn-outline-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                                    <i class="bi bi-funnel"></i> @Html.T("Common.AddFilter", "Filtre Ekle")
                                </button>
                                <div class="dropdown-menu p-3" style="min-width: 300px;">
                                    <!-- Filter Type -->
                                    <div class="mb-2">
                                        <select class="form-select form-select-sm" data-bind="value: selectedFilterType">
                                            <option value="">@Html.T("Common.SelectFilter", "Filtre Seçin...")</option>
                                            <option value="project">@Html.T("Common.Project", "Proje")</option>
                                            <option value="dateRange">@Html.T("Common.DateRange", "Tarih Aralığı")</option>
                                            <option value="evaluationType">Değerlendirme Tipi</option>
                                        </select>
                                    </div>

                                    <!-- Project Filter -->
                                    <div data-bind="visible: selectedFilterType() === 'project'" class="mb-2">
                                        <select class="form-select form-select-sm" data-bind="value: tempFilter.projectId, options: projects, optionsValue: 'id', optionsText: 'name', optionsCaption: '@Html.T("Common.Select", "Seçin...")'"></select>
                                    </div>

                                    <!-- Date Range Filter -->
                                    <div data-bind="visible: selectedFilterType() === 'dateRange'" class="mb-2">
                                        <div class="d-flex gap-1 mb-2">
                                            <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.startDate">
                                            <span class="align-self-center">-</span>
                                            <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.endDate">
                                        </div>
                                        <div class="d-flex flex-wrap gap-1">
                                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bind="click: function() { setTempDateRange('thisMonth'); }, css: { 'btn-primary': tempFilter.dateRangeType() === 'thisMonth' }">Bu Ay</button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bind="click: function() { setTempDateRange('lastMonth'); }, css: { 'btn-primary': tempFilter.dateRangeType() === 'lastMonth' }">Geçen Ay</button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bind="click: function() { setTempDateRange('last3Months'); }, css: { 'btn-primary': tempFilter.dateRangeType() === 'last3Months' }">Son 3 Ay</button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bind="click: function() { setTempDateRange('thisYear'); }, css: { 'btn-primary': tempFilter.dateRangeType() === 'thisYear' }">Bu Yıl</button>
                                        </div>
                                    </div>

                                    <!-- Evaluation Type Filter -->
                                    <div data-bind="visible: selectedFilterType() === 'evaluationType'" class="mb-2">
                                        <select class="form-select form-select-sm" data-bind="value: tempFilter.evaluationType">
                                            <option value="">Seçin...</option>
                                            <option value="internal">İç Değerlendirme</option>
                                            <option value="external">Dış Değerlendirme</option>
                                        </select>
                                    </div>

                                    <!-- Add Button -->
                                    <button type="button" class="btn btn-primary btn-sm w-100" data-bind="click: addFilter, enable: canAddFilter">
                                        <i class="bi bi-plus"></i> @Html.T("Common.Add", "Ekle")
                                    </button>
                                </div>
                            </div>

                            <!-- Active Filters -->
                            <!-- ko foreach: activeFilters -->
                            <span class="badge bg-primary d-flex align-items-center gap-1 py-2">
                                <span data-bind="text: label + ': ' + displayValue"></span>
                                <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.5rem;" data-bind="click: $parent.removeFilter"></button>
                            </span>
                            <!-- /ko -->

                            <!-- Clear All -->
                            <button class="btn btn-outline-danger btn-sm" data-bind="visible: activeFilters().length > 0, click: clearAllFilters">
                                <i class="bi bi-x-circle"></i> @Html.T("Common.ClearAll", "Temizle")
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Loading -->
                <div data-bind="visible: isLoading" class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2 text-muted">@Html.T("Report.LoadingReportCard", "Karne yükleniyor...")</p>
                </div>

                <!-- No Data -->
                <div data-bind="visible: !isLoading() && !report()" class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                        <h5 class="mt-3 text-muted">@Html.T("Report.NoEvaluationsForPersonnel", "Bu temsilci için değerlendirme bulunamadı")</h5>
                    </div>
                </div>

                <!-- Report Content -->
                <div id="printable-report" data-bind="visible: !isLoading() && report()">
                    <!-- Summary Cards -->
                    <div class="row mb-3" data-bind="with: report">
                        <div class="col">
                            <div class="card text-center h-100">
                                <div class="card-body py-2">
                                    <h3 class="mb-0" data-bind="text: averageScore.toFixed(1) + '%', css: averageScore >= successThreshold ? 'text-success' : (averageScore >= warningThreshold ? 'text-warning' : 'text-danger')"></h3>
                                    <small class="text-muted">Ortalama</small>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card text-center h-100 bg-success text-white">
                                <div class="card-body py-2">
                                    <h3 class="mb-0" data-bind="text: bestScore.toFixed(1) + '%'"></h3>
                                    <small>En Yüksek</small>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card text-center h-100 bg-danger text-white">
                                <div class="card-body py-2">
                                    <h3 class="mb-0" data-bind="text: worstScore.toFixed(1) + '%'"></h3>
                                    <small>En Düşük</small>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card text-center h-100">
                                <div class="card-body py-2">
                                    <h3 class="mb-0 text-primary" data-bind="text: totalEvaluations"></h3>
                                    <small class="text-muted">Toplam</small>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card text-center h-100 bg-warning">
                                <div class="card-body py-2">
                                    <h3 class="mb-0" data-bind="text: totalYellowCards"></h3>
                                    <small>Sarı Kart</small>
                                </div>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card text-center h-100 bg-danger text-white">
                                <div class="card-body py-2">
                                    <h3 class="mb-0" data-bind="text: totalRedCards"></h3>
                                    <small>Kırmızı Kart</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Monthly Trend -->
                    <div class="card shadow-sm mb-3" data-bind="visible: report() && report().monthlyTrend && report().monthlyTrend.length > 0">
                        <div class="card-header bg-info text-white py-2">
                            <h6 class="mb-0"><i class="bi bi-graph-up"></i> Aylık Performans</h6>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Dönem</th>
                                            <th class="text-center">Değerlendirme</th>
                                            <th class="text-center">Ort. Puan</th>
                                            <th class="text-center">S.Kart</th>
                                            <th class="text-center">K.Kart</th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: report() ? report().monthlyTrend : []">
                                        <tr>
                                            <td data-bind="text: monthName"></td>
                                            <td class="text-center" data-bind="text: evaluationCount"></td>
                                            <td class="text-center">
                                                <span class="badge" data-bind="text: averageScore.toFixed(1) + '%', css: averageScore >= $root.report().successThreshold ? 'bg-success' : (averageScore >= $root.report().warningThreshold ? 'bg-warning text-dark' : 'bg-danger')"></span>
                                            </td>
                                            <td class="text-center" data-bind="text: yellowCards"></td>
                                            <td class="text-center" data-bind="text: redCards"></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Group Performance & Strengths/Weaknesses -->
                    <div class="row mb-3">
                        <div class="col-md-6" data-bind="visible: report() && report().groupPerformances && report().groupPerformances.length > 0">
                            <div class="card shadow-sm h-100">
                                <div class="card-header bg-secondary text-white py-2">
                                    <h6 class="mb-0"><i class="bi bi-list-task"></i> Grup Performansı</h6>
                                </div>
                                <div class="card-body p-0">
                                    <table class="table table-sm mb-0">
                                        <tbody data-bind="foreach: report() ? report().groupPerformances : []">
                                            <tr>
                                                <td data-bind="text: groupName"></td>
                                                <td style="width: 50%;">
                                                    <div class="progress" style="height: 18px;">
                                                        <div class="progress-bar" data-bind="style: { width: percentageScore + '%' }, css: percentageScore >= $root.report().successThreshold ? 'bg-success' : (percentageScore >= $root.report().warningThreshold ? 'bg-warning' : 'bg-danger'), text: percentageScore.toFixed(1) + '%'"></div>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card shadow-sm h-100">
                                <div class="card-header bg-secondary text-white py-2">
                                    <h6 class="mb-0"><i class="bi bi-bar-chart"></i> Güçlü/Zayıf Yönler</h6>
                                </div>
                                <div class="card-body p-0">
                                    <div class="p-2 bg-success bg-opacity-10" data-bind="visible: report() && report().strengths && report().strengths.length > 0">
                                        <small class="text-success fw-bold"><i class="bi bi-arrow-up-circle"></i> Güçlü</small>
                                    </div>
                                    <ul class="list-group list-group-flush" data-bind="foreach: report() ? report().strengths : []">
                                        <li class="list-group-item py-1 small">
                                            <span class="badge bg-success me-1" data-bind="text: percentageScore.toFixed(0) + '%'"></span>
                                            <span data-bind="text: questionText"></span>
                                        </li>
                                    </ul>
                                    <div class="p-2 bg-danger bg-opacity-10" data-bind="visible: report() && report().weaknesses && report().weaknesses.length > 0">
                                        <small class="text-danger fw-bold"><i class="bi bi-arrow-down-circle"></i> Geliştirilmeli <span class="fw-normal">(Yorum sayısına göredir)</span></small>
                                    </div>
                                    <ul class="list-group list-group-flush" data-bind="foreach: report() ? report().weaknesses : []">
                                        <li class="list-group-item py-1 small">
                                            <span class="badge bg-danger me-1" data-bind="text: percentageScore.toFixed(0) + '%'"></span>
                                            <span data-bind="text: questionText"></span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Evaluations -->
                    <div class="card shadow-sm" data-bind="visible: report() && report().recentEvaluations && report().recentEvaluations.length > 0">
                        <div class="card-header bg-primary text-white py-2">
                            <h6 class="mb-0"><i class="bi bi-clock-history"></i> Son Değerlendirmeler</h6>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Tarih</th>
                                            <th>Proje</th>
                                            <th>Kontrol Listesi</th>
                                            <th class="text-center">Puan</th>
                                            <th class="text-center">Kartlar</th>
                                            <th class="text-center">İşlem</th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: report() ? report().recentEvaluations : []">
                                        <tr>
                                            <td data-bind="text: evaluationDate ? new Date(evaluationDate).toLocaleDateString('tr-TR') : '-'"></td>
                                            <td data-bind="text: projectName"></td>
                                            <td data-bind="text: checklistName"></td>
                                            <td class="text-center">
                                                <span class="badge" data-bind="text: scorePercentage.toFixed(1) + '%', css: scorePercentage >= $root.report().successThreshold ? 'bg-success' : (scorePercentage >= $root.report().warningThreshold ? 'bg-warning text-dark' : 'bg-danger')"></span>
                                            </td>
                                            <td class="text-center">
                                                <span data-bind="visible: yellowCards > 0" class="badge bg-warning text-dark me-1" data-bind="text: yellowCards"></span>
                                                <span data-bind="visible: redCards > 0" class="badge bg-danger" data-bind="text: redCards"></span>
                                                <span data-bind="visible: yellowCards === 0 && redCards === 0">-</span>
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-outline-primary" data-bind="click: function() { $root.showDetails(evaluationId); }">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Details Modal -->
    <div class="modal fade" data-bind="css: { show: isDetailsModalOpen }, style: { display: isDetailsModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-clipboard-check me-2"></i>Dinleme Detayı</h5>
                    <div class="ms-auto d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-outline-light btn-sm" data-bind="click: exportDetailToExcel, disable: isExportingDetail">
                            <span data-bind="visible: !isExportingDetail()"><i class="bi bi-file-earmark-excel me-1"></i>Excel</span>
                            <span data-bind="visible: isExportingDetail"><span class="spinner-border spinner-border-sm"></span></span>
                        </button>
                        <button type="button" class="btn-close btn-close-white" data-bind="click: closeDetailsModal"></button>
                    </div>
                </div>
                <div class="modal-body">
                    <div data-bind="visible: isDetailsLoading" class="text-center py-5">
                        <div class="spinner-border text-primary"></div>
                    </div>
                    <div data-bind="visible: !isDetailsLoading() && detailsData()">
                        <!-- ko with: detailsData -->
                        <div class="card mb-4">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-md-2 text-center border-end">
                                        <h2 class="mb-0" data-bind="text: (scorePercentage || 0).toFixed(2) + '%', css: $parent.getScoreClass(scorePercentage || 0)"></h2>
                                        <small class="text-muted">Toplam Puan</small>
                                    </div>
                                    <div class="col-md-10">
                                        <div class="progress" style="height: 25px;">
                                            <div class="progress-bar" data-bind="style: { width: (scorePercentage || 0) + '%' }, css: $parent.getProgressBarClass(scorePercentage || 0), text: (scorePercentage || 0).toFixed(2) + '%'"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="card h-100">
                                    <div class="card-header bg-light"><h6 class="mb-0"><i class="bi bi-building"></i> Değerlendirilen</h6></div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr><th style="width:40%;">Firma</th><td data-bind="text: customerName || '-'"></td></tr>
                                            <tr><th>Organizasyon</th><td data-bind="text: organizationName || '-'"></td></tr>
                                            <tr><th>Temsilci</th><td data-bind="text: evaluatedPersonnelName || dealerName || '-'"></td></tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card h-100">
                                    <div class="card-header bg-light"><h6 class="mb-0"><i class="bi bi-telephone"></i> Çağrı Bilgileri</h6></div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr>
                                                <th style="width:40%;">Çağrı ID</th>
                                                <td><call-id params="value: callId"></call-id></td>
                                            </tr>
                                            <tr><th>Tarih</th><td data-bind="text: callDate ? new Date(callDate).toLocaleDateString('tr-TR') : '-'"></td></tr>
                                            <!-- ko if: callTime -->
                                            <tr><th>Çağrı Saati</th><td data-bind="text: callTime"></td></tr>
                                            <!-- /ko -->
                                            <tr><th>Süre</th><td data-bind="text: duration || '-'"></td></tr>
                                            <!-- ko if: controlTime -->
                                            <tr><th>Kontrol Saati</th><td data-bind="text: controlTime"></td></tr>
                                            <!-- /ko -->
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card mb-4" data-bind="visible: evaluationComment">
                            <div class="card-header bg-info text-white"><h6 class="mb-0"><i class="bi bi-chat-quote"></i> Denetim Yorumu</h6></div>
                            <div class="card-body"><p class="mb-0" data-bind="text: evaluationComment"></p></div>
                        </div>
                        <div class="card">
                            <div class="card-header bg-light"><h6 class="mb-0"><i class="bi bi-list-check"></i> Cevaplar</h6></div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-sm table-striped mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width:12%;">Grup</th>
                                                <th style="width:30%;">Soru</th>
                                                <th class="text-center" style="width:10%;">Cevap</th>
                                                <th class="text-center" style="width:10%;">Ağırlık</th>
                                                <th class="text-center" style="width:10%;">Kazanılan</th>
                                                <th style="width:28%;">Notlar</th>
                                            </tr>
                                        </thead>
                                        <tbody data-bind="foreach: answers || []">
                                            <tr data-bind="css: { 'table-warning': appliedPenaltyType === 'YellowCard', 'table-danger': appliedPenaltyType === 'RedCard' }">
                                                <td data-bind="text: groupName || '-'"></td>
                                                <td data-bind="text: questionText"></td>
                                                <td class="text-center">
                                                    <!-- ko if: givenPoints !== null && maxPoints > 0 -->
                                                    <span class="badge bg-primary" data-bind="text: givenPoints + '/' + maxPoints"></span>
                                                    <!-- /ko -->
                                                    <!-- ko ifnot: givenPoints !== null && maxPoints > 0 -->
                                                    <span class="text-muted">-</span>
                                                    <!-- /ko -->
                                                </td>
                                                <td class="text-center" data-bind="text: maxPoints > 0 ? maxPoints : '-'"></td>
                                                <td class="text-center" data-bind="text: maxPoints > 0 ? (givenPoints || 0).toFixed(1) : '-'"></td>
                                                <td data-bind="text: notes || '-'"></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeDetailsModal">Kapat</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isDetailsModalOpen }, style: { display: isDetailsModalOpen() ? 'block' : 'none' }"></div>
</div>

@section Scripts {
    <script src="~/js/CustomerPortal/personnelReportCard.js"></script>
}
