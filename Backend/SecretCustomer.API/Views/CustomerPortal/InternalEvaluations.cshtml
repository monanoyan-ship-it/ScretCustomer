@{
    ViewData["Title"] = @Html.T("CustomerPortal.InternalEvaluations.Title", "Ic Dinlemeler");
    Layout = "_CustomerLayout";
}

<div id="customer-internal-evaluations-app">
    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yükleniyor...")</span>
        </div>
    </div>

    <!-- Content -->
    <div data-bind="visible: !isLoading()">
        <!-- Filters -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body py-2">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <!-- Add Filter Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-outline-success btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                            <i class="bi bi-plus-circle me-1"></i>@Html.T("Common.AddFilter", "Filtre Ekle")
                        </button>
                        <div class="dropdown-menu p-3 filter-dropdown">
                            <!-- Filter Type Selector -->
                            <div class="mb-2">
                                <select class="form-select form-select-sm" data-bind="value: selectedFilterType">
                                    <option value="">@Html.T("Common.SelectFilter", "Filtre Seçin...")</option>
                                    <option value="project">@Html.T("Common.Project", "Proje")</option>
                                    <option value="evaluator">@Html.T("CustomerPortal.Evaluations.Evaluator", "Dinleyen")</option>
                                    <option value="personnel">@Html.T("CustomerPortal.Evaluations.EvaluatedPersonnel", "Dinlenen")</option>
                                    <option value="organization">@Html.T("CustomerPortal.Evaluations.Organization", "Organizasyon")</option>
                                    <option value="callId">@Html.T("Common.Id", "Çağrı ID")</option>
                                    <option value="dateRange">@Html.T("Common.DateRange", "Tarih Aralığı")</option>
                                </select>
                            </div>
                            <!-- Dynamic Filter Input -->
                            <!-- Project -->
                            <div data-bind="visible: selectedFilterType() === 'project'" class="mb-2">
                                <select class="form-select form-select-sm" data-bind="options: projects, optionsText: 'name', optionsValue: 'id', value: tempFilter.projectId, optionsCaption: '@Html.T("Common.Select", "Seçin...")'"></select>
                            </div>
                            <!-- Evaluator (text) -->
                            <div data-bind="visible: selectedFilterType() === 'evaluator'" class="mb-2">
                                <input type="text" class="form-control form-control-sm" autocomplete="off" data-bind="value: tempFilter.evaluatorName" placeholder="@Html.T("CustomerPortal.Evaluations.Evaluator", "Dinleyen adı...")">
                            </div>
                            <!-- Personnel (text) -->
                            <div data-bind="visible: selectedFilterType() === 'personnel'" class="mb-2">
                                <input type="text" class="form-control form-control-sm" autocomplete="off" data-bind="value: tempFilter.personnelName" placeholder="@Html.T("CustomerPortal.Evaluations.EvaluatedPersonnel", "Dinlenen adı...")">
                            </div>
                            <!-- Organization -->
                            <div data-bind="visible: selectedFilterType() === 'organization'" class="mb-2">
                                <select class="form-select form-select-sm" data-bind="options: organizations, optionsText: 'name', optionsValue: 'id', value: tempFilter.organizationId, optionsCaption: '@Html.T("Common.Select", "Seçin...")'"></select>
                            </div>
                            <!-- CallId (text) -->
                            <div data-bind="visible: selectedFilterType() === 'callId'" class="mb-2">
                                <input type="text" class="form-control form-control-sm" autocomplete="off" data-bind="value: tempFilter.callId" placeholder="@Html.T("Common.Id", "Çağrı ID...")">
                            </div>
                            <!-- Date Range -->
                            <div data-bind="visible: selectedFilterType() === 'dateRange'" class="mb-2">
                                <div class="d-flex gap-1 mb-1">
                                    <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.startDate">
                                    <span class="align-self-center">-</span>
                                    <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.endDate">
                                </div>
                                <div class="d-flex flex-wrap gap-1">
                                    <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('today'); }, css: tempFilter.dateRangeType() === 'today' ? 'btn-success' : 'btn-outline-secondary'">@Html.T("Common.Today", "Bugün")</button>
                                    <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('yesterday'); }, css: tempFilter.dateRangeType() === 'yesterday' ? 'btn-success' : 'btn-outline-secondary'">@Html.T("Common.Yesterday", "Dün")</button>
                                    <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('thisWeek'); }, css: tempFilter.dateRangeType() === 'thisWeek' ? 'btn-success' : 'btn-outline-secondary'">@Html.T("Common.ThisWeek", "Bu Hafta")</button>
                                    <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('lastWeek'); }, css: tempFilter.dateRangeType() === 'lastWeek' ? 'btn-success' : 'btn-outline-secondary'">@Html.T("Common.LastWeek", "Geçen Hafta")</button>
                                </div>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('thisMonth'); }, css: tempFilter.dateRangeType() === 'thisMonth' ? 'btn-success' : 'btn-outline-secondary'">@Html.T("Common.ThisMonth", "Bu Ay")</button>
                                    <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('lastMonth'); }, css: tempFilter.dateRangeType() === 'lastMonth' ? 'btn-success' : 'btn-outline-secondary'">@Html.T("Common.LastMonth", "Geçen Ay")</button>
                                    <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('last3Months'); }, css: tempFilter.dateRangeType() === 'last3Months' ? 'btn-success' : 'btn-outline-secondary'">@Html.T("Common.Last3Months", "Son 3 Ay")</button>
                                    <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('last6Months'); }, css: tempFilter.dateRangeType() === 'last6Months' ? 'btn-success' : 'btn-outline-secondary'">@Html.T("Common.Last6Months", "Son 6 Ay")</button>
                                </div>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('thisYear'); }, css: tempFilter.dateRangeType() === 'thisYear' ? 'btn-success' : 'btn-outline-secondary'">@Html.T("Common.ThisYear", "Bu Yıl")</button>
                                    <button type="button" class="btn btn-sm" data-bind="click: function() { setDateRange('lastYear'); }, css: tempFilter.dateRangeType() === 'lastYear' ? 'btn-success' : 'btn-outline-secondary'">@Html.T("Common.LastYear", "Geçen Yıl")</button>
                                </div>
                            </div>
                            <!-- Add Button -->
                            <button type="button" class="btn btn-success btn-sm w-100" data-bind="click: addFilter, enable: canAddFilter">
                                <i class="bi bi-plus"></i> @Html.T("Common.Add", "Ekle")
                            </button>
                        </div>
                    </div>

                    <!-- Active Filters (Chips) -->
                    <!-- ko foreach: activeFilters -->
                    <span class="badge bg-success d-flex align-items-center gap-1 py-2 px-2">
                        <span data-bind="text: label"></span>: <strong data-bind="text: displayValue"></strong>
                        <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.6rem;" data-bind="click: $parent.removeFilter"></button>
                    </span>
                    <!-- /ko -->

                    <!-- Clear All -->
                    <button class="btn btn-outline-danger btn-sm" data-bind="visible: activeFilters().length > 0, click: clearFilters">
                        <i class="bi bi-x-circle"></i> @Html.T("Common.ClearAll", "Temizle")
                    </button>

                    <!-- Save Filter -->
                    <button class="btn btn-outline-secondary btn-sm" data-bind="visible: activeFilters().length > 0, click: openSaveFilterModal">
                        <i class="bi bi-bookmark-plus"></i> @Html.T("Common.Save", "Kaydet")
                    </button>

                    <!-- Load Filter -->
                    <button class="btn btn-outline-info btn-sm" data-bind="click: openLoadFilterModal">
                        <i class="bi bi-bookmark"></i> @Html.T("CustomerPortal.SavedFilters", "Kayıtlı")
                    </button>

                    <!-- Spacer -->
                    <div class="flex-grow-1"></div>

                    <!-- Search Button -->
                    <button class="btn btn-success btn-sm" data-bind="click: search">
                        <i class="bi bi-search me-1"></i>@Html.T("Common.Search", "Ara")
                    </button>

                    <!-- Reports Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-outline-success btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bind="disable: isExporting">
                            <span data-bind="visible: !isExporting()">
                                <i class="bi bi-file-earmark-excel me-1"></i>@Html.T("Common.Reports", "Raporlar")
                            </span>
                            <span data-bind="visible: isExporting">
                                <span class="spinner-border spinner-border-sm"></span>
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#" data-bind="click: exportQuestionGroupAverageReport">
                                <i class="bi bi-bar-chart me-2"></i>@Html.T("Report.QuestionGroupAverage", "Soru Grubu Ortalama")
                            </a></li>
                            <li><a class="dropdown-item" href="#" data-bind="click: exportCustomerEvaluationReport">
                                <i class="bi bi-people me-2"></i>@Html.T("Report.CustomerEvaluation", "Müşteri Değerlendirme")
                            </a></li>
                            <li><a class="dropdown-item" href="#" data-bind="click: exportProjectPerformanceReport">
                                <i class="bi bi-graph-up me-2"></i>@Html.T("Report.ProjectPerformance", "Proje Performans")
                            </a></li>
                        </ul>
                    </div>
                </div>
                <!-- Quick Access Row -->
                <div class="border-top pt-2 mt-2">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <!-- Quick CallId Search -->
                        <div class="input-group input-group-sm" style="max-width: 200px;">
                            <input type="text" class="form-control" data-bind="value: quickCallId, valueUpdate: 'afterkeydown', event: { keypress: function(d, e) { if (e.keyCode === 13) { searchByCallId(); return false; } return true; } }" placeholder="@Html.T("Common.CallId", "Çağrı ID...")">
                            <button class="btn btn-outline-success" type="button" data-bind="click: searchByCallId">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Summary -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-info text-white">
                    <div class="card-body text-center">
                        <h3 data-bind="text: total"></h3>
                        <small>@Html.T("CustomerPortal.InternalEvaluations.TotalCount", "Toplam Dinleme")</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center">
                        <h3 class="text-primary" data-bind="text: averageScore().toFixed(1)"></h3>
                        <small class="text-muted">@Html.T("CustomerPortal.InternalEvaluations.AverageScore", "Ortalama Puan")</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: evaluations().length === 0" class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-clipboard-check fs-1 text-muted"></i>
                <h5 class="mt-3">@Html.T("CustomerPortal.InternalEvaluations.NotFound", "Dinleme Bulunamadi")</h5>
                <p class="text-muted">@Html.T("CustomerPortal.InternalEvaluations.NoRecords", "Ic dinleme kaydi bulunmuyor.")</p>
            </div>
        </div>

        <!-- Evaluations Table -->
        <div data-bind="visible: evaluations().length > 0" class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-clipboard-check me-2"></i>
                    @Html.T("CustomerPortal.InternalEvaluations.List", "Ic Dinleme Listesi")
                </h5>
                <div class="d-flex align-items-center gap-2">
                    <label class="form-label mb-0 small text-muted">@Html.T("Common.PageSize", "Sayfa"):</label>
                    <select class="form-select form-select-sm" style="width: auto;" data-bind="value: pageSize, event: { change: function() { loadEvaluations(1); } }">
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.T("Common.Id", "ID")</th>
                                <th>@Html.T("CustomerPortal.Evaluations.CallDate", "Çağrı Tarihi")</th>
                                <th>@Html.T("CustomerPortal.Evaluations.CallTime", "Saat")</th>
                                <th>@Html.T("CustomerPortal.Evaluations.Duration", "Süre")</th>
                                <th>@Html.T("Common.Project", "Proje")</th>
                                <th>@Html.T("CustomerPortal.Evaluations.Evaluator", "Dinleyen")</th>
                                <th>@Html.T("CustomerPortal.Evaluations.EvaluatedPersonnel", "Dinlenen")</th>
                                <th>@Html.T("CustomerPortal.Evaluations.Organization", "Organizasyon")</th>
                                <th class="text-center">@Html.T("Common.Score", "Puan")</th>
                                <th class="text-center">@Html.T("Common.Cards", "Kartlar")</th>
                                <th class="text-center">@Html.T("Common.Actions", "İşlemler")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: evaluations">
                            <tr>
                                <td>
                                    <code class="text-muted" data-bind="text: (callId || id) ? ((callId || id).length > 12 ? (callId || id).substring(0, 12) + '...' : (callId || id)) : '-', attr: { title: callId || id }" style="cursor: help; font-size: 0.85em;"></code>
                                </td>
                                <td>
                                    <span data-bind="text: callDate ? new Date(callDate).toLocaleDateString('tr-TR') : new Date(evaluationDate).toLocaleDateString('tr-TR')"></span>
                                </td>
                                <td>
                                    <span data-bind="text: callTime || '-'"></span>
                                </td>
                                <td>
                                    <span data-bind="text: duration || '-'"></span>
                                </td>
                                <td data-bind="text: projectName"></td>
                                <td data-bind="text: evaluatorName || '-'"></td>
                                <td data-bind="text: evaluatedPersonnelName || '-'"></td>
                                <td data-bind="text: organizationName || '-'"></td>
                                <td class="text-center">
                                    <span class="fw-bold" data-bind="text: (scorePercentage || 0).toFixed(2), css: $parent.getScoreClass(scorePercentage || 0)"></span>
                                </td>
                                <td class="text-center">
                                    <!-- ko if: yellowCardCount > 0 -->
                                    <span class="badge bg-warning text-dark me-1" data-bind="text: yellowCardCount + ' S'"></span>
                                    <!-- /ko -->
                                    <!-- ko if: redCardCount > 0 -->
                                    <span class="badge bg-danger" data-bind="text: redCardCount + ' K'"></span>
                                    <!-- /ko -->
                                    <!-- ko if: yellowCardCount === 0 && redCardCount === 0 -->
                                    <span class="text-muted">-</span>
                                    <!-- /ko -->
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" data-bind="click: $parent.showDetails" title="@Html.T("Common.Details", "Detay")">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary" data-bind="click: $parent.showAttachments" title="@Html.T("Evaluation.Attachments", "Dosyalar")">
                                            <i class="bi bi-paperclip"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- Pagination -->
            <div class="card-footer bg-white" data-bind="visible: totalPages() > 1">
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                            <li class="page-item" data-bind="css: { disabled: page() <= 1 }">
                                <a class="page-link" href="#" data-bind="click: function() { if(page() > 1) loadEvaluations(page() - 1); }">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-link" data-bind="text: page() + ' / ' + totalPages()"></span>
                            </li>
                            <li class="page-item" data-bind="css: { disabled: page() >= totalPages() }">
                                <a class="page-link" href="#" data-bind="click: function() { if(page() < totalPages()) loadEvaluations(page() + 1); }">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>

    <!-- Save Filter Modal -->
    <div class="modal fade" data-bind="css: { show: showSaveFilterModal }, style: { display: showSaveFilterModal() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-bookmark-plus me-2"></i>@Html.T("CustomerPortal.SaveFilter", "Filtreyi Kaydet")</h5>
                    <button type="button" class="btn-close btn-close-white" data-bind="click: closeSaveFilterModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Common.Name", "Ad") <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" data-bind="value: saveFilterName" placeholder="@Html.T("CustomerPortal.FilterNamePlaceholder", "Örn: Bu Ay Raporları")" maxlength="100">
                    </div>
                    <div class="mb-0">
                        <label class="form-label">@Html.T("CustomerPortal.SelectedFilters", "Seçilen Filtreler"):</label>
                        <div class="d-flex flex-wrap gap-1">
                            <!-- ko foreach: activeFilters -->
                            <span class="badge bg-secondary" data-bind="text: label + ': ' + displayValue"></span>
                            <!-- /ko -->
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeSaveFilterModal">@Html.T("Common.Cancel", "İptal")</button>
                    <button type="button" class="btn btn-success" data-bind="click: saveFilter, disable: isSavingFilter() || !saveFilterName()">
                        <span data-bind="visible: !isSavingFilter()"><i class="bi bi-bookmark-check me-1"></i>@Html.T("Common.Save", "Kaydet")</span>
                        <span data-bind="visible: isSavingFilter"><span class="spinner-border spinner-border-sm"></span></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showSaveFilterModal }, style: { display: showSaveFilterModal() ? 'block' : 'none' }"></div>

    <!-- Load Filter Modal -->
    <div class="modal fade" data-bind="css: { show: showLoadFilterModal }, style: { display: showLoadFilterModal() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title"><i class="bi bi-bookmark me-2"></i>@Html.T("CustomerPortal.SavedFilters", "Kayıtlı Filtreler")</h5>
                    <button type="button" class="btn-close btn-close-white" data-bind="click: closeLoadFilterModal"></button>
                </div>
                <div class="modal-body">
                    <!-- Loading -->
                    <div data-bind="visible: isLoadingFilters" class="text-center py-4">
                        <div class="spinner-border text-info"></div>
                    </div>
                    <!-- Empty -->
                    <div data-bind="visible: !isLoadingFilters() && savedFilters().length === 0" class="text-center py-4">
                        <i class="bi bi-bookmark text-muted fs-1"></i>
                        <p class="text-muted mt-2">@Html.T("CustomerPortal.NoSavedFilters", "Kayıtlı filtre yok.")</p>
                    </div>
                    <!-- List -->
                    <div data-bind="visible: !isLoadingFilters() && savedFilters().length > 0" class="list-group">
                        <!-- ko foreach: savedFilters -->
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <strong data-bind="text: name"></strong>
                                <br><small class="text-muted" data-bind="text: new Date(createdAt).toLocaleDateString('tr-TR')"></small>
                            </div>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-success" data-bind="click: $parent.applySavedFilter" title="@Html.T("Common.Apply", "Uygula")">
                                    <i class="bi bi-play-fill"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deleteSavedFilter" title="@Html.T("Common.Delete", "Sil")">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeLoadFilterModal">@Html.T("Common.Close", "Kapat")</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showLoadFilterModal }, style: { display: showLoadFilterModal() ? 'block' : 'none' }"></div>

    <!-- Details Modal -->
    <div class="modal fade" data-bind="css: { show: isDetailsModalOpen }, style: { display: isDetailsModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title"><i class="bi bi-clipboard-check me-2"></i>@Html.T("Evaluation.Details", "Dinleme Detayı")</h5>
                    <div class="ms-auto d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-outline-light btn-sm" data-bind="click: exportToExcel, disable: isExportingDetail">
                            <span data-bind="visible: !isExportingDetail()"><i class="bi bi-file-earmark-excel me-1"></i>Excel</span>
                            <span data-bind="visible: isExportingDetail"><span class="spinner-border spinner-border-sm"></span></span>
                        </button>
                        <button type="button" class="btn-close btn-close-white" data-bind="click: closeDetailsModal"></button>
                    </div>
                </div>
                <div class="modal-body">
                    <!-- Loading -->
                    <div data-bind="visible: isDetailsLoading" class="text-center py-5">
                        <div class="spinner-border text-info"></div>
                    </div>
                    <!-- Content -->
                    <div data-bind="visible: !isDetailsLoading() && detailsData()">
                        <!-- ko with: detailsData -->
                        <!-- Score Summary -->
                        <div class="card mb-4">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-md-2 text-center border-end">
                                        <h2 class="mb-0" data-bind="text: (scorePercentage || 0).toFixed(2) + '%', css: $parent.getScoreClass(scorePercentage || 0)"></h2>
                                        <small class="text-muted">@Html.T("Evaluation.TotalScore", "Toplam Puan")</small>
                                    </div>
                                    <div class="col-md-10">
                                        <div class="progress" style="height: 25px;">
                                            <div class="progress-bar" role="progressbar"
                                                 data-bind="style: { width: (scorePercentage || 0) + '%' },
                                                            css: $parent.getProgressBarClass(scorePercentage || 0),
                                                            text: (scorePercentage || 0).toFixed(2) + '%'">
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-between mt-1">
                                            <small class="text-muted">0%</small>
                                            <small class="text-muted">100%</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Info Cards - 2 columns only (no Değerlendirme Bilgileri) -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="card h-100">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0"><i class="bi bi-building"></i> @Html.T("Evaluation.EvaluatedInfo", "Değerlendirilen Bilgileri")</h6>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr>
                                                <th style="width: 40%;">@Html.T("Common.Customer", "Firma")</th>
                                                <td data-bind="text: customerName || '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Common.Organization", "Organizasyon")</th>
                                                <td data-bind="text: organizationName || '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Evaluation.Evaluated", "Değerlendirilen")</th>
                                                <td data-bind="text: evaluatedPersonnelName || '-'"></td>
                                            </tr>
                                            <!-- ko if: supervisorName -->
                                            <tr>
                                                <th>@Html.T("Evaluation.Supervisor", "Takım Lideri")</th>
                                                <td data-bind="text: supervisorName"></td>
                                            </tr>
                                            <!-- /ko -->
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card h-100">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0"><i class="bi bi-telephone"></i> @Html.T("Evaluation.CallInfo", "Çağrı Bilgileri")</h6>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr>
                                                <th style="width: 40%;">@Html.T("Evaluation.CallId", "Çağrı ID")</th>
                                                <td data-bind="text: callId || '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Evaluation.CallDate", "Çağrı Tarihi")</th>
                                                <td data-bind="text: callDate ? new Date(callDate).toLocaleDateString('tr-TR') : '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Evaluation.Duration", "Süre")</th>
                                                <td data-bind="text: duration || '-'"></td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Evaluation Comment -->
                        <div class="card mb-4" data-bind="visible: comment">
                            <div class="card-header bg-info text-white">
                                <h6 class="mb-0"><i class="bi bi-chat-quote"></i> @Html.T("Evaluation.EvaluationComment", "Denetim Yorumu")</h6>
                            </div>
                            <div class="card-body">
                                <p class="mb-0" data-bind="text: comment"></p>
                            </div>
                        </div>

                        <!-- Answers Table -->
                        <div class="card">
                            <div class="card-header bg-light">
                                <h6 class="mb-0"><i class="bi bi-list-check"></i> @Html.T("Evaluation.Answers", "Verilen Cevaplar")</h6>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-sm table-striped table-hover mb-0" style="table-layout: fixed;">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 12%;">@Html.T("Evaluation.Group", "Grup")</th>
                                                <th style="width: 28%;">@Html.T("Evaluation.Question", "Soru")</th>
                                                <th class="text-center" style="width: 10%;">@Html.T("Evaluation.Answer", "Cevap")</th>
                                                <th class="text-center" style="width: 10%;">@Html.T("Evaluation.Weight", "Ağırlık")</th>
                                                <th class="text-center" style="width: 10%;">@Html.T("Evaluation.Earned", "Kazanılan")</th>
                                                <th style="width: 30%;">@Html.T("Evaluation.Notes", "Notlar")</th>
                                            </tr>
                                        </thead>
                                        <tbody data-bind="foreach: answers || []">
                                            <tr data-bind="css: { 'table-warning': appliedPenaltyType === 'YellowCard', 'table-danger': appliedPenaltyType === 'RedCard' }">
                                                <td class="text-wrap" data-bind="text: groupName || '-'"></td>
                                                <td class="text-wrap">
                                                    <span data-bind="text: questionText"></span>
                                                </td>
                                                <td class="text-center">
                                                    <!-- ko if: givenPoints !== null && givenPoints !== undefined && maxPoints > 0 -->
                                                    <span class="badge bg-info" data-bind="text: givenPoints + '/' + maxPoints"></span>
                                                    <!-- /ko -->
                                                    <!-- ko if: maxPoints <= 0 || (givenPoints === null && givenPoints === undefined) -->
                                                    <span class="text-muted">-</span>
                                                    <!-- /ko -->
                                                </td>
                                                <td class="text-center">
                                                    <!-- ko if: maxPoints > 0 -->
                                                    <span data-bind="text: maxPoints"></span>
                                                    <!-- /ko -->
                                                    <!-- ko ifnot: maxPoints > 0 -->
                                                    <span class="text-muted">-</span>
                                                    <!-- /ko -->
                                                </td>
                                                <td class="text-center">
                                                    <!-- ko if: maxPoints > 0 -->
                                                    <span class="text-success" data-bind="text: (givenPoints || 0).toFixed(1)"></span>
                                                    <!-- /ko -->
                                                    <!-- ko ifnot: maxPoints > 0 -->
                                                    <span class="text-muted">-</span>
                                                    <!-- /ko -->
                                                </td>
                                                <td class="text-wrap">
                                                    <span data-bind="text: notes || '-'"></span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeDetailsModal">@Html.T("Common.Close", "Kapat")</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isDetailsModalOpen }, style: { display: isDetailsModalOpen() ? 'block' : 'none' }"></div>

    <!-- Attachments Modal -->
    <div class="modal fade" data-bind="css: { show: isAttachmentsModalOpen }, style: { display: isAttachmentsModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-secondary text-white">
                    <h5 class="modal-title"><i class="bi bi-paperclip me-2"></i>@Html.T("Evaluation.Attachments", "Ekli Dosyalar")</h5>
                    <button type="button" class="btn-close btn-close-white" data-bind="click: closeAttachmentsModal"></button>
                </div>
                <div class="modal-body">
                    <!-- Loading -->
                    <div data-bind="visible: isAttachmentsLoading" class="text-center py-4">
                        <div class="spinner-border text-secondary"></div>
                    </div>
                    <!-- Empty -->
                    <div data-bind="visible: !isAttachmentsLoading() && attachments().length === 0" class="text-center py-4">
                        <i class="bi bi-folder2-open text-muted fs-1"></i>
                        <p class="text-muted mt-2">@Html.T("Evaluation.NoAttachments", "Bu dinlemede ekli dosya bulunmuyor.")</p>
                    </div>
                    <!-- List -->
                    <div data-bind="visible: !isAttachmentsLoading() && attachments().length > 0" class="list-group">
                        <!-- ko foreach: attachments -->
                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" data-bind="click: $parent.downloadAttachment">
                            <div>
                                <i class="bi bi-file-earmark me-2"></i>
                                <span data-bind="text: fileName"></span>
                                <!-- ko if: questionText -->
                                <br><small class="text-muted" data-bind="text: questionText"></small>
                                <!-- /ko -->
                            </div>
                            <i class="bi bi-download"></i>
                        </a>
                        <!-- /ko -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeAttachmentsModal">@Html.T("Common.Close", "Kapat")</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isAttachmentsModalOpen }, style: { display: isAttachmentsModalOpen() ? 'block' : 'none' }"></div>
</div>

@section Scripts {
    <script src="~/js/CustomerPortal/internalEvaluations.js"></script>
}
