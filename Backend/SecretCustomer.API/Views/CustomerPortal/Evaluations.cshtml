@{
    ViewData["Title"] = Html.T("Evaluation.Title", "Değerlendirmeler");
    Layout = "_CustomerLayout";
}

<div id="evaluations-app">

    <!-- Loading State -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yükleniyor...")</span>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3" data-bind="visible: !isLoading()">
        <li class="nav-item">
            <a class="nav-link" data-bind="css: { active: activeTab() === 'assignments' }, click: function() { activeTab('assignments'); }" href="#">
                <i class="bi bi-clipboard-check"></i> @Html.T("Evaluation.Assignments", "Atamalar")
                <span class="badge bg-primary" data-bind="text: activeAssignments().length"></span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bind="css: { active: activeTab() === 'evaluations' }, click: function() { activeTab('evaluations'); }" href="#">
                <i class="bi bi-headphones"></i> @Html.T("Evaluation.ListeningsVisits", "Dinlemeler/Ziyaretler")
                <span class="badge bg-success" data-bind="text: allEvaluationsList().length"></span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bind="css: { active: activeTab() === 'expired' }, click: function() { activeTab('expired'); }" href="#">
                <i class="bi bi-calendar-x"></i> @Html.T("Evaluation.ExpiredAssignments", "Tarihi Geçmiş")
                <span class="badge bg-warning text-dark" data-bind="text: expiredAssignments().length"></span>
            </a>
        </li>
    </ul>

    <!-- Aktif Atamalar Tab -->
    <div data-bind="visible: activeTab() === 'assignments' && !isLoading()">
        <!-- Search -->
        <div class="mb-3">
            <div class="input-group" style="max-width: 400px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" data-bind="value: assignmentsSearch, valueUpdate: 'afterkeydown'" placeholder="@Html.T("Evaluation.SearchAssignments", "Proje veya kontrol listesi ara...")">
            </div>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: activeAssignments().length === 0" class="alert alert-info">
            <i class="bi bi-info-circle"></i> @Html.T("Evaluation.NoActiveAssignments", "Aktif atama bulunmamaktadır.")
        </div>

        <!-- Assignments Table -->
        <div class="card shadow-sm" data-bind="visible: activeAssignments().length > 0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="sortable" data-bind="click: function() { assignmentsSorting.toggleSort('projectName'); }, css: assignmentsSorting.getSortClass('projectName')">
                                @Html.T("Common.Project", "Proje")
                                <i class="bi sort-icon" data-bind="css: assignmentsSorting.getSortIcon('projectName')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { assignmentsSorting.toggleSort('checklistName'); }, css: assignmentsSorting.getSortClass('checklistName')">
                                @Html.T("Common.Checklist", "Kontrol Listesi")
                                <i class="bi sort-icon" data-bind="css: assignmentsSorting.getSortIcon('checklistName')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { assignmentsSorting.toggleSort('dueDate'); }, css: assignmentsSorting.getSortClass('dueDate')">
                                @Html.T("Common.DueDate", "Son Tarih")
                                <i class="bi sort-icon" data-bind="css: assignmentsSorting.getSortIcon('dueDate')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { assignmentsSorting.toggleSort('evaluationCount'); }, css: assignmentsSorting.getSortClass('evaluationCount')">
                                @Html.T("Evaluation.EvaluationCount", "Değerlendirme")
                                <i class="bi sort-icon" data-bind="css: assignmentsSorting.getSortIcon('evaluationCount')"></i>
                            </th>
                            <th style="width: 220px;">@Html.T("Common.Actions", "İşlemler")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: activeAssignments">
                        <tr>
                            <td><strong data-bind="text: projectName"></strong></td>
                            <td data-bind="text: checklistName"></td>
                            <td>
                                <span data-bind="text: dueDate ? new Date(dueDate).toLocaleDateString('tr-TR') : '-'"></span>
                                <!-- ko if: daysRemaining <= 3 && daysRemaining >= 0 -->
                                <span class="badge bg-warning text-dark ms-1" data-bind="text: daysRemaining + ' gün'"></span>
                                <!-- /ko -->
                            </td>
                            <td>
                                <span class="badge bg-secondary" data-bind="text: evaluationCount || 0"></span>
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-sm btn-success" data-bind="click: $parent.startEvaluation">
                                        <i class="bi bi-plus-circle me-1"></i>@Html.T("Evaluation.Add", "Ekle")
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" data-bind="click: $parent.showProjectFiles" title="@Html.T("Project.Files", "Proje Dosyaları")">
                                        <i class="bi bi-folder2-open"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Dinlemeler/Ziyaretler Tab -->
    <div data-bind="visible: activeTab() === 'evaluations' && !isLoading()">
        <!-- Filters -->
        <div class="card mb-3">
            <div class="card-body py-2">
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small mb-1">@Html.T("Evaluation.SearchText", "Arama")</label>
                        <input type="text" class="form-control form-control-sm" data-bind="value: evaluationsSearch, valueUpdate: 'afterkeydown'" placeholder="@Html.T("Evaluation.SearchPlaceholder", "Proje, personel, çağrı ID...")">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1">@Html.T("Common.Status", "Durum")</label>
                        <select class="form-select form-select-sm" data-bind="value: evaluationsStatusFilter">
                            <option value="">@Html.T("Common.All", "Tümü")</option>
                            <option value="Completed">@Html.T("Common.Status.Completed", "Tamamlandı")</option>
                            <option value="Draft">@Html.T("Common.Status.Draft", "Taslak")</option>
                            <option value="InProgress">@Html.T("Common.Status.InProgress", "Devam Ediyor")</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1">@Html.T("Evaluation.DateFrom", "Başlangıç")</label>
                        <input type="date" class="form-control form-control-sm" data-bind="value: evaluationsDateFrom">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1">@Html.T("Evaluation.DateTo", "Bitiş")</label>
                        <input type="date" class="form-control form-control-sm" data-bind="value: evaluationsDateTo">
                    </div>
                    <div class="col-md-3 d-flex align-items-end justify-content-end gap-1">
                        <button class="btn btn-sm btn-outline-secondary" data-bind="click: clearEvaluationsFilters" title="@Html.T("Common.ClearFilters", "Filtreleri Temizle")">
                            <i class="bi bi-x-circle"></i>
                        </button>
                        <span class="text-muted small" data-bind="text: allEvaluationsList().length + ' kayıt'"></span>
                    </div>
                </div>
                <!-- Date Range Shortcuts -->
                <div class="d-flex flex-wrap gap-1 mt-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bind="click: function() { setEvaluationsDateRange('today'); }">@Html.T("Common.Today", "Bugün")</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bind="click: function() { setEvaluationsDateRange('yesterday'); }">@Html.T("Common.Yesterday", "Dün")</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bind="click: function() { setEvaluationsDateRange('thisWeek'); }">@Html.T("Common.ThisWeek", "Bu Hafta")</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bind="click: function() { setEvaluationsDateRange('lastWeek'); }">@Html.T("Common.LastWeek", "Geçen Hafta")</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bind="click: function() { setEvaluationsDateRange('thisMonth'); }">@Html.T("Common.ThisMonth", "Bu Ay")</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bind="click: function() { setEvaluationsDateRange('lastMonth'); }">@Html.T("Common.LastMonth", "Geçen Ay")</button>
                </div>
            </div>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: allEvaluationsList().length === 0" class="alert alert-info">
            <i class="bi bi-info-circle"></i> @Html.T("Evaluation.NoEvaluations", "Henüz dinleme/ziyaret kaydı bulunmamaktadır.")
        </div>

        <!-- Evaluations Table -->
        <div class="card shadow-sm" data-bind="visible: allEvaluationsList().length > 0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="sortable" data-bind="click: function() { evaluationsSorting.toggleSort('callId'); }, css: evaluationsSorting.getSortClass('callId')">
                                @Html.T("Evaluation.CallId", "Çağrı ID")
                                <i class="bi sort-icon" data-bind="css: evaluationsSorting.getSortIcon('callId')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { evaluationsSorting.toggleSort('callDate'); }, css: evaluationsSorting.getSortClass('callDate')">
                                @Html.T("Evaluation.CallDate", "Çağrı Tarihi")
                                <i class="bi sort-icon" data-bind="css: evaluationsSorting.getSortIcon('callDate')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { evaluationsSorting.toggleSort('duration'); }, css: evaluationsSorting.getSortClass('duration')">
                                @Html.T("Evaluation.Duration", "Süre")
                                <i class="bi sort-icon" data-bind="css: evaluationsSorting.getSortIcon('duration')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { evaluationsSorting.toggleSort('evaluatedPersonnelName'); }, css: evaluationsSorting.getSortClass('evaluatedPersonnelName')">
                                @Html.T("Evaluation.EvaluatedPerson", "Personel")
                                <i class="bi sort-icon" data-bind="css: evaluationsSorting.getSortIcon('evaluatedPersonnelName')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { evaluationsSorting.toggleSort('projectName'); }, css: evaluationsSorting.getSortClass('projectName')">
                                @Html.T("Common.Project", "Proje")
                                <i class="bi sort-icon" data-bind="css: evaluationsSorting.getSortIcon('projectName')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { evaluationsSorting.toggleSort('scorePercentage'); }, css: evaluationsSorting.getSortClass('scorePercentage')">
                                @Html.T("Evaluation.Score", "Puan")
                                <i class="bi sort-icon" data-bind="css: evaluationsSorting.getSortIcon('scorePercentage')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { evaluationsSorting.toggleSort('yellowCardCount'); }, css: evaluationsSorting.getSortClass('yellowCardCount')">
                                @Html.T("Evaluation.Penalty", "Ceza")
                                <i class="bi sort-icon" data-bind="css: evaluationsSorting.getSortIcon('yellowCardCount')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { evaluationsSorting.toggleSort('status'); }, css: evaluationsSorting.getSortClass('status')">
                                @Html.T("Common.Status", "Durum")
                                <i class="bi sort-icon" data-bind="css: evaluationsSorting.getSortIcon('status')"></i>
                            </th>
                            <th style="width: 100px;">@Html.T("Common.Actions", "İşlem")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: allEvaluationsList">
                        <tr>
                            <td>
                                <!-- ko if: callId -->
                                <code data-bind="text: callId.length > 20 ? callId.substring(0, 8) + '...' + callId.substring(callId.length - 8) : callId, attr: { title: callId }" style="cursor: help;"></code>
                                <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-secondary" data-bind="click: function() { var t = callId; navigator.clipboard ? navigator.clipboard.writeText(t).then(function() { toastr.success('Panoya kopyalandı'); }) : (function() { var a = document.createElement('textarea'); a.value = t; document.body.appendChild(a); a.select(); document.execCommand('copy'); document.body.removeChild(a); toastr.success('Panoya kopyalandı'); })(); }" title="@Html.T("Common.Copy", "Kopyala")">
                                    <i class="bi bi-clipboard" style="font-size: 0.75rem;"></i>
                                </button>
                                <!-- /ko -->
                                <!-- ko ifnot: callId --><span>-</span><!-- /ko -->
                            </td>
                            <td>
                                <span data-bind="text: callDate ? new Date(callDate).toLocaleDateString('tr-TR') : '-'"></span>
                                <!-- ko if: callTime -->
                                <br><small class="text-muted" data-bind="text: callTime"></small>
                                <!-- /ko -->
                            </td>
                            <td data-bind="text: duration || '-'"></td>
                            <td>
                                <span data-bind="text: evaluatedPersonnelName || evaluatedUnknownPersonnel || '-'"></span>
                            </td>
                            <td>
                                <span data-bind="text: projectName"></span>
                                <br><small class="text-muted" data-bind="text: checklistName"></small>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="progress me-2" style="height: 6px; width: 50px;">
                                        <div class="progress-bar" data-bind="style: { width: (scorePercentage || 0) + '%' }, css: scorePercentage >= 70 ? 'bg-success' : (scorePercentage >= 50 ? 'bg-warning' : 'bg-danger')"></div>
                                    </div>
                                    <small data-bind="text: (scorePercentage || 0).toFixed(2) + '%'"></small>
                                </div>
                            </td>
                            <td>
                                <!-- ko if: yellowCardCount > 0 -->
                                <span class="badge bg-warning text-dark me-1" title="@Html.T("Penalty.YellowCard", "Sarı Kart")"><span data-bind="text: yellowCardCount"></span></span>
                                <!-- /ko -->
                                <!-- ko if: redCardCount > 0 -->
                                <span class="badge bg-danger" title="@Html.T("Penalty.RedCard", "Kırmızı Kart")"><span data-bind="text: redCardCount"></span></span>
                                <!-- /ko -->
                                <!-- ko if: !yellowCardCount && !redCardCount -->
                                <span class="text-muted">-</span>
                                <!-- /ko -->
                            </td>
                            <td>
                                <!-- ko if: status === 'Completed' -->
                                <span class="badge bg-success">@Html.T("Evaluation.Status.Completed", "Tamamlandı")</span>
                                <!-- /ko -->
                                <!-- ko if: status === 'Draft' -->
                                <span class="badge bg-secondary">@Html.T("Evaluation.Status.Draft", "Taslak")</span>
                                <!-- /ko -->
                                <!-- ko if: status === 'InProgress' -->
                                <span class="badge bg-info">@Html.T("Evaluation.Status.InProgress", "Devam")</span>
                                <!-- /ko -->
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary btn-sm" data-bind="click: $parent.showDetails" title="@Html.T("Common.Detail", "Detay")">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <!-- ko if: $parent.canEditEvaluation($data) -->
                                    <button class="btn btn-outline-warning btn-sm" data-bind="click: $parent.continueEvaluation" title="@Html.T("Common.Edit", "Düzenle")">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <!-- /ko -->
                                    <!-- ko if: status === 'Draft' -->
                                    <button class="btn btn-outline-danger btn-sm" data-bind="click: $parent.deleteDraft" title="@Html.T("Common.Delete", "Sil")">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                    <!-- /ko -->
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Tarihi Geçmiş Atamalar Tab -->
    <div data-bind="visible: activeTab() === 'expired' && !isLoading()">
        <!-- Search -->
        <div class="mb-3">
            <div class="input-group" style="max-width: 400px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" data-bind="value: expiredSearch, valueUpdate: 'afterkeydown'" placeholder="@Html.T("Evaluation.SearchExpired", "Proje veya kontrol listesi ara...")">
            </div>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: expiredAssignments().length === 0" class="alert alert-info">
            <i class="bi bi-info-circle"></i> @Html.T("Evaluation.NoExpiredAssignments", "Tarihi geçmiş atama bulunmamaktadır.")
        </div>

        <!-- Expired Assignments Table -->
        <div class="card shadow-sm" data-bind="visible: expiredAssignments().length > 0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-warning">
                        <tr>
                            <th class="sortable" data-bind="click: function() { expiredSorting.toggleSort('projectName'); }, css: expiredSorting.getSortClass('projectName')">
                                @Html.T("Common.Project", "Proje")
                                <i class="bi sort-icon" data-bind="css: expiredSorting.getSortIcon('projectName')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { expiredSorting.toggleSort('checklistName'); }, css: expiredSorting.getSortClass('checklistName')">
                                @Html.T("Common.Checklist", "Kontrol Listesi")
                                <i class="bi sort-icon" data-bind="css: expiredSorting.getSortIcon('checklistName')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { expiredSorting.toggleSort('dueDate'); }, css: expiredSorting.getSortClass('dueDate')">
                                @Html.T("Common.DueDate", "Son Tarih")
                                <i class="bi sort-icon" data-bind="css: expiredSorting.getSortIcon('dueDate')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { expiredSorting.toggleSort('daysRemaining'); }, css: expiredSorting.getSortClass('daysRemaining')">
                                @Html.T("Evaluation.Overdue", "Gecikme")
                                <i class="bi sort-icon" data-bind="css: expiredSorting.getSortIcon('daysRemaining')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { expiredSorting.toggleSort('evaluationCount'); }, css: expiredSorting.getSortClass('evaluationCount')">
                                @Html.T("Evaluation.EvaluationCount", "Değerlendirme")
                                <i class="bi sort-icon" data-bind="css: expiredSorting.getSortIcon('evaluationCount')"></i>
                            </th>
                            <th style="width: 220px;">@Html.T("Common.Actions", "İşlemler")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: expiredAssignments">
                        <tr class="table-warning">
                            <td><strong data-bind="text: projectName"></strong></td>
                            <td data-bind="text: checklistName"></td>
                            <td data-bind="text: dueDate ? new Date(dueDate).toLocaleDateString('tr-TR') : '-'"></td>
                            <td>
                                <span class="badge bg-danger" data-bind="text: Math.abs(daysRemaining) + ' gün'"></span>
                            </td>
                            <td>
                                <span class="badge bg-secondary" data-bind="text: evaluationCount || 0"></span>
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-sm btn-warning" data-bind="click: $parent.startEvaluation">
                                        <i class="bi bi-plus-circle me-1"></i>@Html.T("Evaluation.Add", "Ekle")
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" data-bind="click: $parent.showProjectFiles" title="@Html.T("Project.Files", "Proje Dosyaları")">
                                        <i class="bi bi-folder2-open"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Details Modal -->
    <div class="modal fade" data-bind="css: { show: isDetailsModalOpen }, style: { display: isDetailsModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-clipboard-check"></i>
                        <!-- ko if: detailsData() -->
                        <span data-bind="text: detailsData().checklistName || '@Html.T("Evaluation.Details", "Değerlendirme Detayı")'"></span>
                        <!-- /ko -->
                    </h5>
                    <div>
                        <!-- Taslağa Al Talebi Butonu - Sadece Completed değerlendirmeler için -->
                        <!-- ko if: detailsData() && detailsData().status === 'Completed' -->
                        <button type="button" class="btn btn-warning btn-sm me-2"
                                data-bind="click: openRevertRequestModal">
                            <i class="bi bi-arrow-counterclockwise"></i> @Html.T("Evaluation.RequestRevert", "Taslağa Al Talebi")
                        </button>
                        <!-- /ko -->
                        <button type="button" class="btn btn-light btn-sm me-2" onclick="window.print()">
                            <i class="bi bi-printer"></i> @Html.T("Common.Print", "Yazdır")
                        </button>
                        <button type="button" class="btn-close btn-close-white" data-bind="click: closeDetailsModal"></button>
                    </div>
                </div>
                <div class="modal-body">
                    <!-- Loading -->
                    <div data-bind="visible: isDetailsLoading" class="text-center py-4">
                        <div class="spinner-border text-primary"></div>
                    </div>

                    <!-- Content -->
                    <div data-bind="visible: !isDetailsLoading() && detailsData(), with: detailsData">
                        <!-- Summary Cards -->
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h2 class="mb-0" data-bind="text: (scorePercentage || 0).toFixed(2) + '%', css: scorePercentage >= 70 ? 'text-success' : (scorePercentage >= 50 ? 'text-warning' : 'text-danger')"></h2>
                                        <small class="text-muted">@Html.T("Evaluation.TotalScore", "Toplam Puan")</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <div class="card-body">
                                        <h2 class="mb-0 text-primary" data-bind="text: (totalScore || 0).toFixed(1) + ' / ' + (maxScore || 0).toFixed(1)"></h2>
                                        <small class="text-muted">@Html.T("Evaluation.RawScore", "Ham Puan")</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center bg-warning">
                                    <div class="card-body">
                                        <h2 class="mb-0" data-bind="text: yellowCardCount || 0"></h2>
                                        <small>@Html.T("Evaluation.YellowCard", "Sarı Kart")</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card text-center bg-danger text-white">
                                    <div class="card-body">
                                        <h2 class="mb-0" data-bind="text: redCardCount || 0"></h2>
                                        <small>@Html.T("Evaluation.RedCard", "Kırmızı Kart")</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Info Cards -->
                        <div class="row mb-4">
                            <div class="col-md-4">
                                <div class="card h-100">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0"><i class="bi bi-building"></i> @Html.T("Evaluation.EvaluatedInfo", "Değerlendirilen Bilgileri")</h6>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr>
                                                <th style="width: 40%;">@Html.T("Common.Customer", "Firma")</th>
                                                <td data-bind="text: customerName || '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Common.Organization", "Organizasyon")</th>
                                                <td data-bind="text: organizationName || '-'"></td>
                                            </tr>
                                            <tr>
                                                <th>@Html.T("Evaluation.Evaluated", "Değerlendirilen")</th>
