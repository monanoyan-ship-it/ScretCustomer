                                                <div class="col-md-4">
                                                    <label class="form-label">@Html.T("Evaluation.CallTime", "Çağrı Saati") <span class="text-danger">*</span></label>
                                                    <input type="text" class="form-control time-mask" data-bind="value: callTime" placeholder="__:__" required>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">@Html.T("Evaluation.Duration", "Süre") <span class="text-danger">*</span></label>
                                                    <input type="text" class="form-control duration-mask" data-bind="value: duration" placeholder="00:__:__" required>
                                                </div>
                                                <!-- Açıklamalar -->
                                                <div class="col-md-8">
                                                    <label class="form-label">@Html.T("Evaluation.Descriptions", "Açıklamalar")</label>
                                                    <!-- ko foreach: descriptions -->
                                                    <div class="input-group mb-1">
                                                        <input type="text" class="form-control" data-bind="textInput: $data" placeholder="@Html.T("Evaluation.DescriptionPlaceholder", "Açıklama girin...")">
                                                        <!-- ko if: $index() === $parent.descriptions().length - 1 -->
                                                        <button type="button" class="btn btn-outline-success" data-bind="click: $parent.addDescription" title="@Html.T("Common.Add", "Ekle")">
                                                            <i class="bi bi-plus"></i>
                                                        </button>
                                                        <!-- /ko -->
                                                        <!-- ko if: $parent.descriptions().length > 1 -->
                                                        <button type="button" class="btn btn-outline-danger" data-bind="click: function() { $parent.removeDescription($index()); }" title="@Html.T("Common.Remove", "Kaldır")">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                        <!-- /ko -->
                                                    </div>
                                                    <!-- /ko -->
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card">
                                        <div class="card-header bg-light">
                                            <h6 class="mb-0"><i class="bi bi-person"></i> @Html.T("Evaluation.EvaluatedPersonnel", "Değerlendirilen Personel")</h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="row g-3">
                                                <!-- Personel Seçimi -->
                                                <div class="col-12">
                                                    <label class="form-label">@Html.T("Evaluation.SelectPersonnel", "Personel Seç") <span class="text-danger">*</span></label>
                                                    <!-- ko ifnot: isNewPersonnelMode -->
                                                    <div class="position-relative">
                                                        <div class="input-group">
                                                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                                                            <input type="text" class="form-control"
                                                                   placeholder="@Html.T("Evaluation.SearchPersonnel", "Personel ara...")"
                                                                   autocomplete="off"
                                                                   data-bind="value: personnelSearchText, valueUpdate: 'afterkeydown',
                                                                              event: { focus: showPersonnelDropdown, blur: hidePersonnelDropdownDelayed },
                                                                              attr: { disabled: isLoadingPersonnel() }">
                                                            <!-- ko if: evaluatedPersonnelId() -->
                                                            <button type="button" class="btn btn-outline-danger" data-bind="click: clearSelectedPersonnel" title="@Html.T("Common.Clear", "Temizle")">
                                                                <i class="bi bi-x-lg"></i>
                                                            </button>
                                                            <!-- /ko -->
                                                            <!-- ko if: isLoadingPersonnel() -->
                                                            <span class="input-group-text">
                                                                <span class="spinner-border spinner-border-sm"></span>
                                                            </span>
                                                            <!-- /ko -->
                                                            <!-- ko ifnot: isLoadingPersonnel() -->
                                                            <button type="button" class="btn btn-outline-secondary" data-bind="click: enableNewPersonnelMode" title="@Html.T("Evaluation.PersonnelNotInList", "Listede Yok")">
                                                                <i class="bi bi-person-plus"></i>
                                                            </button>
                                                            <!-- /ko -->
                                                        </div>
                                                        <!-- Autocomplete Dropdown -->
                                                        <div class="dropdown-menu w-100 show shadow" style="max-height: 250px; overflow-y: auto; position: absolute; top: 100%; left: 0; z-index: 1050;"
                                                             data-bind="visible: isPersonnelDropdownVisible() && filteredPersonnel().length > 0">
                                                            <!-- ko foreach: filteredPersonnel -->
                                                            <div class="dropdown-item d-flex justify-content-between align-items-center"
                                                                 style="cursor: pointer;"
                                                                 data-bind="event: { mousedown: function() { $parent.selectPersonnel($data); } }">
                                                                <span data-bind="text: name"></span>
                                                                <!-- ko if: $data.sicilNo -->
                                                                <small class="text-muted" data-bind="text: $data.sicilNo"></small>
                                                                <!-- /ko -->
                                                            </div>
                                                            <!-- /ko -->
                                                        </div>
                                                        <!-- No Results -->
                                                        <div class="dropdown-menu w-100 show shadow" style="position: absolute; top: 100%; left: 0; z-index: 1050;"
                                                             data-bind="visible: isPersonnelDropdownVisible() && filteredPersonnel().length === 0 && personnelSearchText().length >= 2">
                                                            <span class="dropdown-item text-muted">
                                                                <i class="bi bi-info-circle me-1"></i> @Html.T("Evaluation.NoPersonnelFound", "Personel bulunamadı")
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <!-- /ko -->
                                                    <!-- ko if: isNewPersonnelMode -->
                                                    <div class="card border-warning">
                                                        <div class="card-header bg-warning text-dark py-2 d-flex justify-content-between align-items-center">
                                                            <small><i class="bi bi-person-plus me-1"></i>@Html.T("Evaluation.NewPersonnel", "Yeni Personel")</small>
                                                            <button type="button" class="btn btn-sm btn-outline-dark" data-bind="click: cancelNewPersonnelMode">
                                                                <i class="bi bi-x"></i>
                                                            </button>
                                                        </div>
                                                        <div class="card-body py-2">
                                                            <div class="row g-2">
                                                                <div class="col-6">
                                                                    <input type="text" class="form-control form-control-sm" placeholder="@Html.T("Common.FirstName", "Ad") *" data-bind="value: newPersonnelFirstName">
                                                                </div>
                                                                <div class="col-6">
                                                                    <input type="text" class="form-control form-control-sm" placeholder="@Html.T("Common.LastName", "Soyad") *" data-bind="value: newPersonnelLastName">
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <!-- /ko -->
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Score Summary (Sticky) -->
                            <div class="sticky-top bg-white py-2 mb-3" style="top: 0; z-index: 1020;">
                                <div class="card border-success">
                                    <div class="card-body py-2">
                                        <div class="row align-items-center">
                                            <div class="col-auto">
                                                <h4 class="mb-0 fw-bold text-success" data-bind="text: scorePercentageCalc().toFixed(2)"></h4>
                                            </div>
                                            <div class="col">
                                                <div class="progress" style="height: 20px;">
                                                    <div class="progress-bar" role="progressbar"
                                                         data-bind="style: { width: scorePercentageCalc() + '%' },
                                                                    css: scorePercentageCalc() >= 70 ? 'bg-success' : (scorePercentageCalc() >= 50 ? 'bg-warning' : 'bg-danger')">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-auto">
                                                <!-- Uygulanan Kartlar -->
                                                <span class="badge bg-warning text-dark me-1" data-bind="visible: yellowCardCountCalc() > 0">
                                                    <i class="bi bi-exclamation-triangle"></i> <span data-bind="text: yellowCardCountCalc()"></span> @Html.T("Evaluation.Yellow", "Sarı")
                                                </span>
                                                <span class="badge bg-danger" data-bind="visible: redCardCountCalc() > 0">
                                                    <i class="bi bi-x-circle"></i> <span data-bind="text: redCardCountCalc()"></span> @Html.T("Evaluation.Red", "Kırmızı")
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Soru Grupları: Sorular, Sarı Kartlar, Kırmızı Kartlar -->
                            <!-- ko if: formData() -->
                            <div data-bind="foreach: formData().penaltyGroups">
                                <div class="card shadow-sm mb-4">
                                    <div class="card-header" data-bind="css: name === 'Kırmızı Kartlar' ? 'bg-danger text-white' : (name === 'Sarı Kartlar' ? 'bg-warning text-dark' : 'bg-success text-white')">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h5 class="mb-0">
                                                <!-- ko if: name === 'Sarı Kartlar' -->
                                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                                <!-- /ko -->
                                                <!-- ko if: name === 'Kırmızı Kartlar' -->
                                                <i class="bi bi-x-circle-fill me-2"></i>
                                                <!-- /ko -->
                                                <!-- ko if: name === 'Sorular' -->
                                                <i class="bi bi-list-check me-2"></i>
                                                <!-- /ko -->
                                                <span data-bind="text: name"></span>
                                                <span class="badge bg-white text-dark ms-2" data-bind="text: questions.length + ' soru'"></span>
                                            </h5>
                                            <div>
                                                <span class="badge bg-white text-dark">
                                                    @Html.T("Evaluation.TotalWeight", "Toplam Ağırlık"): <span data-bind="text: weightPoints"></span>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <!-- Questions -->
                                        <div data-bind="foreach: questions">
                                            <div class="border rounded p-3 mb-3" data-bind="css: { 'border-danger': penaltyType === 'RedCard', 'border-warning': penaltyType === 'YellowCard' }">
                                                <div class="row">
                                                    <div class="col-md-8">
                                                        <!-- Question Header -->
                                                        <div class="d-flex align-items-start mb-2">
                                                            <span class="badge bg-secondary me-2" data-bind="text: order"></span>
                                                            <div class="flex-grow-1">
                                                                <strong data-bind="text: text"></strong>
                                                                <!-- ko if: helpText -->
                                                                <button type="button" class="btn btn-sm btn-link p-0 ms-1" data-bs-toggle="tooltip" data-bind="attr: { title: helpText }">
                                                                    <i class="bi bi-question-circle"></i>
                                                                </button>
                                                                <!-- /ko -->
                                                                <div class="mt-1">
                                                                    <!-- ko if: scoringType === 'Scored' && penaltyType === 'None' -->
                                                                    <span class="badge bg-success">
                                                                        @Html.T("Evaluation.Weight", "Ağırlık"): <span data-bind="text: weightPoints"></span> |
                                                                        @Html.T("Evaluation.Max", "Maks"): <span data-bind="text: maxPoints"></span>
                                                                    </span>
                                                                    <!-- /ko -->
                                                                    <!-- ko if: scoringType === 'Unscored' -->
                                                                    <span class="badge bg-secondary">@Html.T("Evaluation.Unscored", "Puansız")</span>
                                                                    <!-- /ko -->
                                                                    <!-- ko if: penaltyType === 'YellowCard' -->
                                                                    <span class="badge bg-warning text-dark">
                                                                        @Html.T("Evaluation.YellowCard", "Sarı Kart") |
                                                                        @Html.T("Evaluation.Weight", "Ağırlık"): <span data-bind="text: weightPoints"></span>
                                                                    </span>
                                                                    <!-- /ko -->
                                                                    <!-- ko if: penaltyType === 'RedCard' -->
                                                                    <span class="badge bg-danger">
                                                                        @Html.T("Evaluation.RedCard", "Kırmızı Kart") |
                                                                        @Html.T("Evaluation.Weight", "Ağırlık"): <span data-bind="text: weightPoints"></span>
                                                                    </span>
                                                                    <!-- /ko -->
                                                                    <!-- ko if: isRequired -->
                                                                    <span class="badge bg-info">@Html.T("Common.Required", "Zorunlu")</span>
                                                                    <!-- /ko -->
                                                                    <!-- Zorunlu olmayan puanlı sorular için dahil et toggle'ı -->
                                                                    <!-- ko if: !isRequired && scoringType === 'Scored' -->
                                                                    <span class="ms-2">
                                                                        <div class="form-check form-switch d-inline-block">
                                                                            <input class="form-check-input" type="checkbox" role="switch"
                                                                                   data-bind="checked: $root.getAnswer(id, isRequired).isIncluded,
                                                                                              attr: { id: 'include_' + id }">
                                                                            <label class="form-check-label small"
                                                                                   data-bind="attr: { for: 'include_' + id },
                                                                                              css: { 'text-success': $root.getAnswer(id, isRequired).isIncluded(), 'text-muted': !$root.getAnswer(id, isRequired).isIncluded() }">
                                                                                <!-- ko if: $root.getAnswer(id, isRequired).isIncluded() -->
                                                                                @Html.T("Evaluation.IncludedInScore", "Dahil")
                                                                                <!-- /ko -->
                                                                                <!-- ko ifnot: $root.getAnswer(id, isRequired).isIncluded() -->
                                                                                @Html.T("Evaluation.ExcludedFromScore", "Hariç")
                                                                                <!-- /ko -->
                                                                            </label>
                                                                        </div>
                                                                    </span>
                                                                    <!-- /ko -->
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Alt Kriterler (Sub Criteria) -->
                                                        <!-- ko if: subCriteria && subCriteria.length > 0 -->
                                                        <div class="mt-2 ps-3 border-start border-2 border-warning">
                                                            <small class="text-muted d-block mb-1">@Html.T("Evaluation.SubCriteria", "Alt Kriterler"):</small>
                                                            <div class="d-flex flex-wrap gap-1">
                                                                <!-- ko foreach: subCriteria -->
                                                                <button type="button" class="btn btn-sm"
                                                                        data-bind="click: function() { $root.toggleSubCriteria($parent.id, id); },
                                                                                   css: $root.isSubCriteriaSelected($parent.id, id) ? 'btn-warning' : 'btn-outline-secondary'">
                                                                    <i class="bi" data-bind="css: $root.isSubCriteriaSelected($parent.id, id) ? 'bi-check-circle-fill' : 'bi-circle'"></i>
                                                                    <span data-bind="text: description"></span>
                                                                </button>
                                                                <!-- /ko -->
                                                            </div>
                                                        </div>
                                                        <!-- /ko -->

                                                        <!-- Answer Input -->
                                                        <div class="mt-2" data-bind="with: $root.getAnswer(id, isRequired)">
                                                            <!-- Puanlı ve Cezalı sorular için Likert butonları (scoringType = Scored veya Penalty) -->
                                                            <!-- ko if: ($parent.scoringType === 'Scored' || $parent.scoringType === 'Penalty') && $parent.maxPoints !== 1 -->
                                                            <div class="btn-group btn-group-sm" role="group">
                                                                <!-- ko foreach: $root.getScoreOptions($parent.maxPoints) -->
                                                                <button type="button" class="btn"
                                                                        data-bind="click: function() { $parent.answerNumeric($parent.answerNumeric() === $data ? null : $data); },
                                                                                   css: $parent.answerNumeric() === $data ? 'btn-success' : 'btn-outline-success',
                                                                                   text: $data">
                                                                </button>
                                                                <!-- /ko -->
                                                            </div>
                                                            <!-- /ko -->

                                                            <!-- Max puanı 1 olanlar için Evet/Hayır butonları -->
                                                            <!-- ko if: ($parent.scoringType === 'Scored' || $parent.scoringType === 'Penalty') && $parent.maxPoints === 1 -->
                                                            <div class="btn-group" role="group">
                                                                <button type="button" class="btn"
                                                                        data-bind="click: function() { answerNumeric(1); },
                                                                                   css: answerNumeric() === 1 ? 'btn-success' : 'btn-outline-success'">
                                                                    @Html.T("Common.Yes", "Evet")
                                                                </button>
                                                                <button type="button" class="btn"
                                                                        data-bind="click: function() { answerNumeric(0); },
                                                                                   css: answerNumeric() === 0 ? 'btn-danger' : 'btn-outline-danger'">
                                                                    @Html.T("Common.No", "Hayır")
                                                                </button>
                                                            </div>
                                                            <!-- /ko -->

                                                            <!-- ko if: $parent.type === 'YesNo' -->
                                                            <div class="btn-group" role="group">
                                                                <button type="button" class="btn"
                                                                        data-bind="click: function() { answerText('@Html.T("Common.Yes", "Evet")'); },
                                                                                   css: answerText() === '@Html.T("Common.Yes", "Evet")' ? 'btn-success' : 'btn-outline-success'">
                                                                    @Html.T("Common.Yes", "Evet")
                                                                </button>
                                                                <button type="button" class="btn"
                                                                        data-bind="click: function() { answerText('@Html.T("Common.No", "Hayır")'); },
                                                                                   css: answerText() === '@Html.T("Common.No", "Hayır")' ? 'btn-danger' : 'btn-outline-danger'">
                                                                    @Html.T("Common.No", "Hayır")
                                                                </button>
                                                            </div>
                                                            <!-- /ko -->

                                                            <!-- ko if: $parent.type === 'MultipleChoice' && $parent.optionsJson -->
                                                            <select class="form-select" data-bind="value: answerText">
                                                                <option value="">@Html.T("Common.Select", "Seçin...")</option>
                                                                <!-- ko foreach: JSON.parse($parent.optionsJson || '[]') -->
                                                                <option data-bind="text: $data, value: $data"></option>
                                                                <!-- /ko -->
                                                            </select>
                                                            <!-- /ko -->

                                                            <!-- ko if: $parent.type === 'Text' -->
                                                            <textarea class="form-control" rows="2" data-bind="value: answerText" placeholder="@Html.T("Evaluation.WriteYourAnswer", "Cevabınızı yazın...")"></textarea>
                                                            <!-- /ko -->
                                                        </div>
                                                    </div>

                                                    <div class="col-md-4">
                                                        <!-- Points & Penalty Section -->
                                                        <div data-bind="with: $root.getAnswer(id, isRequired)">
                                                            <!-- ko if: $parent.scoringType === 'Scored' && ($root.formData() && ($root.formData().checklistType === 'PhysicalAudit' || $root.formData().checklistType === 'Survey')) -->
                                                            <div class="mb-2">
                                                                <label class="form-label small">@Html.T("Evaluation.GivenPoints", "Verilen Puan")</label>
                                                                <input type="number" class="form-control form-control-sm"
                                                                       data-bind="value: givenPoints, attr: { max: $parent.maxPoints }"
                                                                       step="0.5" min="0">
                                                                <small class="text-muted">@Html.T("Evaluation.Max", "Maks"): <span data-bind="text: $parent.maxPoints"></span></small>
                                                            </div>
                                                            <!-- /ko -->

                                                            <!-- Notes -->
                                                            <div class="mb-2">
                                                                <label class="form-label small">@Html.T("Common.Note", "Not")</label>
                                                                <textarea class="form-control form-control-sm" rows="2" data-bind="value: notes" placeholder="@Html.T("Evaluation.EvaluatorNote", "Değerlendirici notu...")" style="resize: vertical;"></textarea>
                                                            </div>

                                                            <!-- ko if: $parent.recommendedNote -->
                                                            <div class="alert alert-info py-1 px-2 small mb-0">
                                                                <i class="bi bi-lightbulb"></i> <span data-bind="text: $parent.recommendedNote"></span>
                                                            </div>
                                                            <!-- /ko -->
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- /ko -->

                            <!-- Evaluation Comment -->
                            <div class="card shadow-sm mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="bi bi-chat-quote"></i> @Html.T("Evaluation.EvaluationComment", "Denetim Yorumu")</h5>
                                </div>
                                <div class="card-body">
                                    <textarea class="form-control" rows="4" data-bind="value: evaluationComment" placeholder="@Html.T("Evaluation.EvaluationCommentPlaceholder", "Genel değerlendirme yorumunuzu yazın...")"></textarea>
                                </div>
                            </div>

                            <!-- Attachments / Ekler -->
                            <div class="card shadow-sm mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0"><i class="bi bi-paperclip"></i> @Html.T("Evaluation.Attachments", "Ekler")</h5>
                                </div>
                                <div class="card-body">
                                    <!-- Dosya seçme -->
                                    <div class="mb-3">
                                        <input type="file" id="cpEvaluationAttachmentInput" class="d-none" multiple data-bind="event: { change: selectAttachment }">
                                        <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('cpEvaluationAttachmentInput').click();">
                                            <i class="bi bi-plus-circle"></i> @Html.T("Evaluation.AddFiles", "Dosya Ekle")
                                        </button>
                                        <small class="text-muted ms-2">@Html.T("Evaluation.FilesNote", "PDF, Word, Excel, resim, ses ve video dosyaları (max 50 MB)")</small>
                                    </div>

                                    <!-- Bekleyen dosyalar (henüz yüklenmemiş) -->
                                    <!-- ko if: pendingAttachments().length > 0 -->
                                    <div class="mb-3">
                                        <small class="text-muted d-block mb-2"><i class="bi bi-clock-history"></i> @Html.T("Evaluation.PendingFiles", "Bekleyen Dosyalar") (@Html.T("Evaluation.WillUploadOnSave", "Kaydedilince yüklenecek")):</small>
                                        <ul class="list-group list-group-flush">
                                            <!-- ko foreach: pendingAttachments -->
                                            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                                <span class="text-warning">
                                                    <i class="bi bi-file-earmark"></i> <span data-bind="text: name"></span>
                                                    <small class="text-muted ms-2" data-bind="text: sizeDisplay"></small>
                                                </span>
                                                <button type="button" class="btn btn-sm btn-outline-danger" data-bind="click: $root.removePendingAttachment" title="@Html.T("Common.Remove", "Kaldır")">
                                                    <i class="bi bi-x"></i>
                                                </button>
                                            </li>
                                            <!-- /ko -->
                                        </ul>
                                    </div>
                                    <!-- /ko -->

                                    <!-- Yüklenmiş dosyalar -->
                                    <!-- ko if: uploadedAttachments().length > 0 -->
                                    <div>
                                        <small class="text-muted d-block mb-2"><i class="bi bi-check-circle text-success"></i> @Html.T("Evaluation.UploadedFiles", "Yüklenen Dosyalar"):</small>
                                        <ul class="list-group list-group-flush">
                                            <!-- ko foreach: uploadedAttachments -->
                                            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                                <a href="#" class="text-decoration-none" data-bind="click: $root.downloadAttachment">
                                                    <i class="bi bi-file-earmark"></i> <span data-bind="text: fileName"></span>
                                                    <small class="text-muted ms-2" data-bind="text: sizeDisplay"></small>
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-danger" data-bind="click: $root.deleteAttachment" title="@Html.T("Common.Delete", "Sil")">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </li>
                                            <!-- /ko -->
                                        </ul>
                                    </div>
                                    <!-- /ko -->

                                    <!-- Dosya yok mesajı -->
                                    <!-- ko if: uploadedAttachments().length === 0 && pendingAttachments().length === 0 -->
                                    <p class="text-muted mb-0 small"><i class="bi bi-info-circle"></i> @Html.T("Evaluation.NoAttachments", "Henüz dosya eklenmedi.")</p>
                                    <!-- /ko -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" data-bind="visible: !isShowingSummary()">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeEvaluateModal">
                        <i class="bi bi-x"></i> @Html.T("Common.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-outline-success" data-bind="click: saveDraft, disable: isSavingForm">
                        <i class="bi bi-save"></i> @Html.T("Evaluation.SaveDraft", "Taslak Kaydet")
                    </button>
                    <button type="button" class="btn btn-success" data-bind="click: showSummary">
                        <i class="bi bi-eye"></i> @Html.T("Evaluation.ShowSummary", "Özet ve Kaydet")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="visible: isEvaluateModalOpen, css: { show: isEvaluateModalOpen }"></div>

    <!-- Revert Request Modal -->
    <div class="modal fade" data-bind="css: { show: isRevertRequestModalOpen }, style: { display: isRevertRequestModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>@Html.T("Evaluation.RequestRevert", "Taslağa Al Talebi")
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: closeRevertRequestModal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted mb-3">
                        @Html.T("Evaluation.RevertRequestInfo", "Bu değerlendirmeyi taslağa almak için bir talep oluşturulacaktır. Admin onayı sonrası değerlendirme taslak durumuna alınacaktır.")
                    </p>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Evaluation.RevertReason", "Neden (Opsiyonel)")</label>
                        <textarea class="form-control" rows="3" data-bind="value: revertRequestReason"
                                  placeholder="@Html.T("Evaluation.RevertReasonPlaceholder", "Taslağa alma nedeninizi yazabilirsiniz...")"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeRevertRequestModal">
                        <i class="bi bi-x me-1"></i>@Html.T("Common.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-warning" data-bind="click: submitRevertRequest, disable: isSubmittingRevertRequest">
                        <!-- ko if: isSubmittingRevertRequest() -->
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <!-- /ko -->
                        <i class="bi bi-send me-1"></i>@Html.T("Evaluation.SendRequest", "Talep Gönder")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="visible: isRevertRequestModalOpen, css: { show: isRevertRequestModalOpen }"></div>

    <!-- Project Files Modal -->
    <div class="modal fade" data-bind="css: { show: isProjectFilesModalOpen }, style: { display: isProjectFilesModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-secondary text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-folder2-open me-2"></i>@Html.T("Project.Files", "Proje Dosyaları")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bind="click: closeProjectFilesModal"></button>
                </div>
                <div class="modal-body">
                    <!-- Loading -->
                    <div data-bind="visible: isLoadingProjectFiles" class="text-center py-4">
                        <div class="spinner-border text-primary"></div>
                    </div>

                    <!-- Empty State -->
                    <div data-bind="visible: !isLoadingProjectFiles() && projectFiles().length === 0" class="text-center py-4">
                        <i class="bi bi-folder2 display-4 text-muted"></i>
                        <p class="text-muted mt-2">@Html.T("Project.NoFiles", "Bu projeye ait dosya bulunmamaktadır.")</p>
                    </div>

                    <!-- Files List -->
                    <div data-bind="visible: !isLoadingProjectFiles() && projectFiles().length > 0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 40px;"></th>
                                        <th>@Html.T("Project.FileName", "Dosya Adı")</th>
                                        <th>@Html.T("Project.FileSize", "Boyut")</th>
                                        <th>@Html.T("Project.UploadDate", "Yükleme Tarihi")</th>
                                        <th style="width: 100px;">@Html.T("Common.Actions", "İşlem")</th>
                                    </tr>
                                </thead>
                                <tbody data-bind="foreach: projectFiles">
                                    <tr>
                                        <td class="text-center">
                                            <i class="bi" data-bind="css: $parent.getFileIcon(contentType)"></i>
                                        </td>
                                        <td>
                                            <span data-bind="text: originalFileName"></span>
                                            <!-- ko if: description -->
                                            <br><small class="text-muted" data-bind="text: description"></small>
                                            <!-- /ko -->
                                        </td>
                                        <td data-bind="text: $parent.formatFileSize(fileSize)"></td>
                                        <td data-bind="text: new Date(uploadedAt).toLocaleDateString('tr-TR')"></td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary" data-bind="click: $parent.downloadProjectFile" title="@Html.T("Common.Download", "İndir")">
                                                <i class="bi bi-download"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeProjectFilesModal">
                        @Html.T("Common.Close", "Kapat")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="visible: isProjectFilesModalOpen, css: { show: isProjectFilesModalOpen }"></div>
</div>

@section Scripts {
    <script src="~/js/Shared/enums.service.js"></script>
    <script src="~/js/Shared/table-sorting.js"></script>
    <script src="~/js/CustomerPortal/evaluations.js"></script>
}
