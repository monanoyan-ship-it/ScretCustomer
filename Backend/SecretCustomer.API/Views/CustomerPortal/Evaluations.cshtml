@{
    ViewData["Title"] = "Değerlendirmeler";
    Layout = "_CustomerLayout";
}

<div id="customer-evaluations-app">
    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">Yükleniyor...</span>
        </div>
    </div>

    <!-- Content -->
    <div data-bind="visible: !isLoading()">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-clipboard-check me-2"></i>Değerlendirmeler</h5>
                <span class="badge bg-success" data-bind="text: totalCount() + ' kayıt'"></span>
            </div>
            <div class="card-body p-0">
                <!-- Empty State -->
                <div data-bind="visible: evaluations().length === 0" class="text-center py-5">
                    <i class="bi bi-clipboard-x fs-1 text-muted"></i>
                    <h5 class="mt-3">Değerlendirme Bulunamadı</h5>
                    <p class="text-muted">Henüz değerlendirme kaydı bulunmuyor.</p>
                </div>

                <!-- Table -->
                <div data-bind="visible: evaluations().length > 0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Tarih</th>
                                    <th>Şube</th>
                                    <th>Kontrol Listesi</th>
                                    <th class="text-center">Puan</th>
                                    <th class="text-center">Durum</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: evaluations">
                                <tr>
                                    <td>
                                        <span data-bind="text: $parent.formatDate(evaluationDate)"></span>
                                    </td>
                                    <td>
                                        <strong data-bind="text: branchName"></strong>
                                    </td>
                                    <td data-bind="text: checklistName"></td>
                                    <td class="text-center">
                                        <span class="badge fs-6" data-bind="text: score.toFixed(1), css: $parent.getScoreBadgeClass(score)"></span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge" data-bind="text: statusText, css: $parent.getStatusBadgeClass(status)"></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div data-bind="visible: totalPages() > 1" class="card-footer bg-white border-0">
                        <nav>
                            <ul class="pagination pagination-sm justify-content-center mb-0">
                                <li class="page-item" data-bind="css: { disabled: currentPage() === 1 }">
                                    <a class="page-link" href="#" data-bind="click: function() { if(currentPage() > 1) goToPage(currentPage() - 1); }">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                                <!-- ko foreach: pageNumbers -->
                                <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }">
                                    <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                                </li>
                                <!-- /ko -->
                                <li class="page-item" data-bind="css: { disabled: currentPage() === totalPages() }">
                                    <a class="page-link" href="#" data-bind="click: function() { if(currentPage() < totalPages()) goToPage(currentPage() + 1); }">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/CustomerPortal/evaluations.js"></script>
}
