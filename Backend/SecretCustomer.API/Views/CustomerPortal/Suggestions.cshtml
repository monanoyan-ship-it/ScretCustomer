@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = @Html.T("Report.SuggestionsReport", "Oneriler Raporu");
}

<div id="suggestions-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-chat-quote text-info"></i> @Html.T("Report.SuggestionsReport", "Oneriler Raporu")</h2>
        <div class="btn-group">
            <button class="btn btn-success" data-bind="click: exportToExcel, disable: isExporting">
                <span data-bind="visible: !isExporting()">
                    <i class="bi bi-file-earmark-excel"></i> @Html.T("Report.ExportExcel", "Excel Indir")
                </span>
                <span data-bind="visible: isExporting">
                    <span class="spinner-border spinner-border-sm"></span> @Html.T("Report.Downloading", "Indiriliyor...")
                </span>
            </button>
        </div>
    </div>

    <!-- Chip-based Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-funnel"></i> @Html.T("Common.Filters", "Filtreler")</h5>
            <button class="btn btn-sm btn-outline-light" data-bind="click: clearFilters, visible: activeFilters().length > 0">
                <i class="bi bi-x-circle"></i> @Html.T("Common.ClearAll", "Tümünü Temizle")
            </button>
        </div>
        <div class="card-body">
            <!-- Active Filters (Chips) -->
            <div class="mb-3" data-bind="visible: activeFilters().length > 0">
                <div class="d-flex flex-wrap gap-2">
                    <!-- ko foreach: activeFilters -->
                    <span class="badge bg-info text-white d-flex align-items-center gap-1 py-2 px-3" style="font-size: 0.9rem;">
                        <span data-bind="text: label + ': ' + displayValue"></span>
                        <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.6rem;" data-bind="click: $parent.removeFilter"></button>
                    </span>
                    <!-- /ko -->
                </div>
            </div>

            <!-- Filter Builder -->
            <div class="row g-2 align-items-end">
                <!-- Filter Type Selector -->
                <div class="col-md-2">
                    <label class="form-label mb-1">@Html.T("Common.FilterType", "Filtre Tipi")</label>
                    <select class="form-select form-select-sm" data-bind="value: selectedFilterType">
                        <option value="">@Html.T("Common.SelectFilter", "Filtre Seç...")</option>
                        <option value="project">@Html.T("Report.Project", "Proje")</option>
                        <option value="searchText">@Html.T("Report.TextSearch", "Metin Arama")</option>
                        <option value="dateRange">@Html.T("Report.DateRange", "Tarih Aralığı")</option>
                    </select>
                </div>

                <!-- Dynamic Filter Value Input -->
                <!-- Project -->
                <div class="col-md-3" data-bind="visible: selectedFilterType() === 'project'">
                    <label class="form-label mb-1">@Html.T("Report.Project", "Proje")</label>
                    <select class="form-select form-select-sm" data-bind="value: tempFilter.projectId, options: projects, optionsValue: 'id', optionsText: 'name', optionsCaption: '@Html.T("Common.Select", "Seçiniz...")'"></select>
                </div>

                <!-- Search Text -->
                <div class="col-md-3" data-bind="visible: selectedFilterType() === 'searchText'">
                    <label class="form-label mb-1">@Html.T("Report.TextSearch", "Metin Arama")</label>
                    <input type="text" class="form-control form-control-sm" placeholder="@Html.T("Report.SearchInSuggestion", "Öneri metninde ara...")" data-bind="value: tempFilter.searchText">
                </div>

                <!-- Date Range -->
                <div class="col-md-5" data-bind="visible: selectedFilterType() === 'dateRange'">
                    <div class="row g-2">
                        <div class="col-md-5">
                            <label class="form-label mb-1">@Html.T("Report.StartDate", "Başlangıç")</label>
                            <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.startDate">
                        </div>
                        <div class="col-md-5">
                            <label class="form-label mb-1">@Html.T("Report.EndDate", "Bitiş")</label>
                            <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.endDate">
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-calendar3"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><h6 class="dropdown-header">@Html.T("Common.Day", "Gün")</h6></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('today'); }">@Html.T("Common.Today", "Bugün")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('yesterday'); }">@Html.T("Common.Yesterday", "Dün")</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">@Html.T("Common.Week", "Hafta")</h6></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('thisWeek'); }">@Html.T("Common.ThisWeek", "Bu Hafta")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('lastWeek'); }">@Html.T("Common.LastWeek", "Geçen Hafta")</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">@Html.T("Common.Month", "Ay")</h6></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('thisMonth'); }">@Html.T("Common.ThisMonth", "Bu Ay")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('lastMonth'); }">@Html.T("Common.LastMonth", "Geçen Ay")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('last3Months'); }">@Html.T("Common.Last3Months", "Son 3 Ay")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('last6Months'); }">@Html.T("Common.Last6Months", "Son 6 Ay")</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">@Html.T("Common.Year", "Yıl")</h6></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('thisYear'); }">@Html.T("Common.ThisYear", "Bu Yıl")</a></li>
                                    <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('lastYear'); }">@Html.T("Common.LastYear", "Geçen Yıl")</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Add Filter Button -->
                <div class="col-md-2" data-bind="visible: selectedFilterType()">
                    <button class="btn btn-sm btn-info w-100" data-bind="click: addFilter, enable: canAddFilter">
                        <i class="bi bi-plus-circle"></i> @Html.T("Common.AddFilter", "Filtre Ekle")
                    </button>
                </div>
            </div>

        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-2">
            <div class="card bg-danger text-white h-100">
                <div class="card-body py-3 text-center">
                    <i class="bi bi-x-circle fs-2"></i>
                    <h3 class="mb-0 mt-1" data-bind="text: summary().redCardCount"></h3>
                    <small class="text-white-50">Kırmızı Kart</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-warning text-dark h-100">
                <div class="card-body py-3 text-center">
                    <i class="bi bi-exclamation-triangle fs-2"></i>
                    <h3 class="mb-0 mt-1" data-bind="text: summary().yellowCardCount"></h3>
                    <small>Sarı Kart</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-secondary text-white h-100">
                <div class="card-body py-3 text-center">
                    <i class="bi bi-graph-down fs-2"></i>
                    <h3 class="mb-0 mt-1" data-bind="text: summary().lowScoreCount"></h3>
                    <small class="text-white-50">Düşük Puan</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-info text-white h-100">
                <div class="card-body py-3 text-center">
                    <i class="bi bi-chat-quote fs-2"></i>
                    <h3 class="mb-0 mt-1" data-bind="text: summary().totalSuggestions"></h3>
                    <small class="text-white-50">Toplam Kayıt</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-primary text-white h-100">
                <div class="card-body py-3 text-center">
                    <i class="bi bi-clipboard-check fs-2"></i>
                    <h3 class="mb-0 mt-1" data-bind="text: summary().totalEvaluationsWithSuggestions"></h3>
                    <small class="text-white-50">Değerlendirme</small>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card bg-dark text-white h-100">
                <div class="card-body py-3 text-center">
                    <i class="bi bi-people fs-2"></i>
                    <h3 class="mb-0 mt-1" data-bind="text: summary().uniquePersonnel"></h3>
                    <small class="text-white-50">Personel</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Veriler yukleniyor...")</p>
    </div>

    <div data-bind="visible: !isLoading()" class="row">
        <!-- Top Suggested Questions -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-question-circle"></i> @Html.T("Report.TopSuggestedQuestions", "En Cok Oneri Yazilan Sorular")</h5>
                    <button class="btn btn-sm btn-light" data-bind="click: exportTopQuestionsToExcel, disable: isExportingTopQuestions">
                        <span data-bind="visible: !isExportingTopQuestions()">
                            <i class="bi bi-file-earmark-excel text-success"></i>
                        </span>
                        <span data-bind="visible: isExportingTopQuestions">
                            <span class="spinner-border spinner-border-sm"></span>
                        </span>
                    </button>
                </div>
                <div class="card-body p-0">
                    <div data-bind="visible: topSuggestedQuestions().length === 0" class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">@Html.T("Report.NoDataYet", "Henuz veri bulunmamaktadir.")</p>
                    </div>
                    <ul class="list-group list-group-flush" data-bind="foreach: topSuggestedQuestions">
                        <li class="list-group-item d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <div class="fw-bold" data-bind="text: questionText"></div>
                                <small class="text-muted" data-bind="text: (checklistName || '') + ' - ' + (groupName || '')"></small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-info me-1" data-bind="text: suggestionCount + ' öneri'"></span>
                                <span class="badge bg-primary me-1" data-bind="text: evaluationCount + ' değerlendirme'"></span>
                                <span class="badge bg-secondary" data-bind="text: averageScore.toFixed(1) + '%'"></span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Top SubCriteria (Alt Kriterler) -->
        <div class="col-md-6 mb-4">
            <div class="card shadow h-100">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-list-check"></i> En Cok Secilen Alt Kriterler</h5>
                </div>
                <div class="card-body p-0">
                    <div data-bind="visible: topSubCriteria().length === 0" class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">@Html.T("Report.NoDataYet", "Henuz veri bulunmamaktadir.")</p>
                    </div>
                    <ul class="list-group list-group-flush" data-bind="foreach: topSubCriteria" style="max-height: 350px; overflow-y: auto;">
                        <li class="list-group-item d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <div class="fw-bold" data-bind="text: description"></div>
                                <small class="text-muted" data-bind="text: questionText"></small>
                                <small class="text-muted d-block" data-bind="text: (checklistName || '') + ' - ' + (groupName || '')"></small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-warning text-dark me-1" data-bind="text: selectionCount + ' seçim'"></span>
                                <span class="badge bg-secondary" data-bind="text: evaluationCount + '/' + totalQuestionEvaluations + ' değ.'" title="Seçilen / Toplam değerlendirme"></span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Detailed Suggestions List -->
        <div class="col-12 mb-4" id="suggestions-list-section">
            <div class="card shadow">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-list-ul"></i> Cevap Bazlı Kayıtlar
                        <!-- ko if: isSuggestionsLoading -->
                        <span class="spinner-border spinner-border-sm ms-2 text-info"></span>
                        <!-- /ko -->
                    </h5>
                    <span class="badge bg-info" data-bind="text: totalCount() + ' kayit'"></span>
                </div>
                <div class="card-body p-0" style="position: relative;">
                    <!-- Loading overlay for list -->
                    <div data-bind="visible: isSuggestionsLoading" class="position-absolute w-100 h-100 d-flex align-items-center justify-content-center" style="background: rgba(255,255,255,0.7); z-index: 10; top: 0; left: 0;">
                        <div class="spinner-border text-info"></div>
                    </div>
                    <div data-bind="visible: suggestions().length === 0 && !isSuggestionsLoading()" class="text-center text-muted py-5">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">@Html.T("Report.NoSuggestions", "Oneri bulunamadi.")</p>
                    </div>
                    <div data-bind="visible: suggestions().length > 0" class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 80px;">Sebep</th>
                                    <th>@Html.T("Report.Date", "Tarih")</th>
                                    <th>@Html.T("Report.ProjectOrg", "Proje")</th>
                                    <th>@Html.T("Report.Question", "Soru")</th>
                                    <th>@Html.T("Report.NoteSuggestion", "Not / Oneri")</th>
                                    <th>@Html.T("Report.Score", "Puan")</th>
                                    <th>@Html.T("Report.Personnel", "Personel")</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: suggestions">
                                <tr data-bind="css: { 'table-danger': reasonType === 'RedCard', 'table-warning': reasonType === 'YellowCard' }">
                                    <td>
                                        <span class="badge" data-bind="text: $root.getReasonBadge(reasonType).text, css: $root.getReasonBadge(reasonType).class"></span>
                                    </td>
                                    <td>
                                        <span data-bind="text: evaluationDate ? new Date(evaluationDate).toLocaleDateString('tr-TR') : '-'"></span>
                                    </td>
                                    <td>
                                        <span data-bind="text: projectName"></span>
                                        <small class="text-muted d-block" data-bind="text: checklistName"></small>
                                    </td>
                                    <td style="max-width: 200px;">
                                        <div class="text-truncate" data-bind="text: questionText, attr: { title: questionText }"></div>
                                        <small class="text-muted" data-bind="text: groupName"></small>
                                    </td>
                                    <td style="min-width: 280px; max-width: 350px;">
                                        <!-- Alt Kriterler -->
                                        <!-- ko if: selectedSubCriteria && selectedSubCriteria.length > 0 -->
                                        <div class="p-2 mb-1 rounded" style="background-color: #fff3cd; border-left: 3px solid #ffc107;">
                                            <div class="small text-warning fw-bold mb-1"><i class="bi bi-list-check"></i> Alt Kriterler</div>
                                            <!-- ko foreach: selectedSubCriteria -->
                                            <div class="small"><i class="bi bi-arrow-return-right text-muted"></i> <span data-bind="text: $data"></span></div>
                                            <!-- /ko -->
                                        </div>
                                        <!-- /ko -->
                                        <!-- ko if: notes -->
                                        <div class="p-2 mb-1 rounded" style="background-color: #f8f9fa; border-left: 3px solid #6c757d;">
                                            <div class="small text-muted fw-bold mb-1 d-flex justify-content-between align-items-center">
                                                <span>@Html.T("Report.Note", "Not")</span>
                                                <!-- ko if: notes.length > 100 -->
                                                <button type="button" class="btn btn-link btn-sm p-0 text-secondary"
                                                        data-bs-toggle="popover"
                                                        data-bs-trigger="click"
                                                        data-bs-placement="left"
                                                        data-bs-html="true"
                                                        data-bind="attr: { 'data-bs-content': '<div style=\'max-width:400px; max-height:300px; overflow-y:auto; white-space:pre-wrap; word-break:break-word;\'>' + notes.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</div>' }"
                                                        title="@Html.T("Common.FullText", "Tam Metin")">
                                                    <i class="bi bi-arrows-angle-expand" style="font-size: 0.7rem;"></i>
                                                </button>
                                                <!-- /ko -->
                                            </div>
                                            <div class="small" style="white-space: pre-wrap; word-break: break-word;" data-bind="text: notes.length > 100 ? notes.substring(0, 100) + '...' : notes"></div>
                                        </div>
                                        <!-- /ko -->
                                        <!-- ko if: recommendationNotes -->
                                        <div class="p-2 rounded" style="background-color: #e7f3ff; border-left: 3px solid #0dcaf0;">
                                            <div class="small text-info fw-bold mb-1 d-flex justify-content-between align-items-center">
                                                <span>@Html.T("Report.Suggestion", "Öneri")</span>
                                                <!-- ko if: recommendationNotes.length > 100 -->
                                                <button type="button" class="btn btn-link btn-sm p-0 text-info"
                                                        data-bs-toggle="popover"
                                                        data-bs-trigger="click"
                                                        data-bs-placement="left"
                                                        data-bs-html="true"
                                                        data-bind="attr: { 'data-bs-content': '<div style=\'max-width:400px; max-height:300px; overflow-y:auto; white-space:pre-wrap; word-break:break-word;\'>' + recommendationNotes.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</div>' }"
                                                        title="@Html.T("Common.FullText", "Tam Metin")">
                                                    <i class="bi bi-arrows-angle-expand" style="font-size: 0.7rem;"></i>
                                                </button>
                                                <!-- /ko -->
                                            </div>
                                            <div class="small" style="white-space: pre-wrap; word-break: break-word;" data-bind="text: recommendationNotes.length > 100 ? recommendationNotes.substring(0, 100) + '...' : recommendationNotes"></div>
                                        </div>
                                        <!-- /ko -->
                                    </td>
                                    <td>
                                        <span data-bind="text: givenPoints != null ? givenPoints.toFixed(1) : '-'"></span>
                                        <span class="text-muted" data-bind="text: ' / ' + (maxPoints || 0)"></span>
                                        <!-- ko if: percentageScore != null -->
                                        <small class="d-block" data-bind="text: '(' + percentageScore.toFixed(1) + '%)', css: { 'text-success': percentageScore >= 70, 'text-warning': percentageScore >= 40 && percentageScore < 70, 'text-danger': percentageScore < 40 }"></small>
                                        <!-- /ko -->
                                    </td>
                                    <td data-bind="text: evaluatedPersonnelName || '-'"></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" data-bind="click: $root.showEvaluationDetails" title="@Html.T("Report.GoToEvaluation", "Değerlendirme Detayı")">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div data-bind="visible: totalPages() > 1" class="py-3 border-top">
                        <nav>
                            <ul class="pagination mb-0">
                                <li class="page-item" data-bind="css: { disabled: currentPage() <= 1 }">
                                    <a class="page-link" href="#" data-bind="click: previousPage">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                                <!-- ko foreach: visiblePages -->
                                <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }">
                                    <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                                </li>
                                <!-- /ko -->
                                <li class="page-item" data-bind="css: { disabled: currentPage() >= totalPages() }">
                                    <a class="page-link" href="#" data-bind="click: nextPage">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>

        <!-- Evaluation General Notes List -->
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-chat-left-text"></i> Değerlendirme Genel Notları</h5>
                    <span class="badge bg-secondary" data-bind="text: evaluationNotesCount() + ' kayit'"></span>
                </div>
                <div class="card-body p-0">
                    <div data-bind="visible: evaluationNotes().length === 0" class="text-center text-muted py-5">
                        <i class="bi bi-chat-left fs-1"></i>
                        <p class="mt-2">Genel not bulunamadı.</p>
                    </div>
                    <div data-bind="visible: evaluationNotes().length > 0" class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Tarih</th>
                                    <th>Proje</th>
                                    <th>Personel</th>
                                    <th>Puan</th>
                                    <th>Genel Not</th>
                                    <th>Denetim Yorumu</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: evaluationNotes">
                                <tr>
                                    <td>
                                        <span data-bind="text: evaluationDate ? new Date(evaluationDate).toLocaleDateString('tr-TR') : '-'"></span>
                                        <!-- ko if: callId -->
                                        <div class="d-flex align-items-center gap-1">
                                            <code class="text-muted small" data-bind="text: $root.truncateCallId(callId), attr: { title: callId }" style="cursor: help;"></code>
                                            <button type="button" class="btn btn-link btn-sm p-0 text-secondary" data-bind="click: function() { $root.copyToClipboard(callId); }" title="@Html.T("Common.Copy", "Kopyala")">
                                                <i class="bi bi-clipboard" style="font-size: 0.75rem;"></i>
                                            </button>
                                        </div>
                                        <!-- /ko -->
                                        <!-- ko ifnot: callId -->
                                        <small class="text-muted">-</small>
                                        <!-- /ko -->
                                    </td>
                                    <td data-bind="text: projectName || '-'"></td>
                                    <td data-bind="text: evaluatedPersonnelName || '-'"></td>
                                    <td>
                                        <!-- ko if: scorePercentage != null -->
                                        <span data-bind="text: scorePercentage.toFixed(1) + '%', css: { 'text-success': scorePercentage >= 70, 'text-warning': scorePercentage >= 40 && scorePercentage < 70, 'text-danger': scorePercentage < 40 }"></span>
                                        <!-- /ko -->
                                        <!-- ko if: scorePercentage == null -->
                                        <span class="text-muted">-</span>
                                        <!-- /ko -->
                                    </td>
                                    <td style="max-width: 250px;">
                                        <!-- ko if: notes -->
                                        <div class="small p-2 rounded" style="background-color: #f8f9fa;">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div style="white-space: pre-wrap; word-break: break-word;" data-bind="text: notes.length > 100 ? notes.substring(0, 100) + '...' : notes"></div>
                                                <!-- ko if: notes.length > 100 -->
                                                <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-secondary flex-shrink-0"
                                                        data-bs-toggle="popover"
                                                        data-bs-trigger="click"
                                                        data-bs-placement="left"
                                                        data-bs-html="true"
                                                        data-bind="attr: { 'data-bs-content': '<div style=\'max-width:400px; max-height:300px; overflow-y:auto; white-space:pre-wrap; word-break:break-word;\'>' + notes.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</div>' }"
                                                        title="@Html.T("Common.FullText", "Tam Metin")">
                                                    <i class="bi bi-arrows-angle-expand" style="font-size: 0.7rem;"></i>
                                                </button>
                                                <!-- /ko -->
                                            </div>
                                        </div>
                                        <!-- /ko -->
                                        <!-- ko ifnot: notes -->
                                        <span class="text-muted">-</span>
                                        <!-- /ko -->
                                    </td>
                                    <td style="max-width: 250px;">
                                        <!-- ko if: evaluationComment -->
                                        <div class="small p-2 rounded" style="background-color: #e7f3ff;">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div style="white-space: pre-wrap; word-break: break-word;" data-bind="text: evaluationComment.length > 100 ? evaluationComment.substring(0, 100) + '...' : evaluationComment"></div>
                                                <!-- ko if: evaluationComment.length > 100 -->
                                                <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-info flex-shrink-0"
                                                        data-bs-toggle="popover"
                                                        data-bs-trigger="click"
                                                        data-bs-placement="left"
                                                        data-bs-html="true"
                                                        data-bind="attr: { 'data-bs-content': '<div style=\'max-width:400px; max-height:300px; overflow-y:auto; white-space:pre-wrap; word-break:break-word;\'>' + evaluationComment.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</div>' }"
                                                        title="@Html.T("Common.FullText", "Tam Metin")">
                                                    <i class="bi bi-arrows-angle-expand" style="font-size: 0.7rem;"></i>
                                                </button>
                                                <!-- /ko -->
                                            </div>
                                        </div>
                                        <!-- /ko -->
                                        <!-- ko ifnot: evaluationComment -->
                                        <span class="text-muted">-</span>
                                        <!-- /ko -->
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Evaluation Details Modal -->
    <div class="modal fade" data-bind="css: { show: isDetailsModalOpen }, style: { display: isDetailsModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-clipboard-check me-2"></i>@Html.T("Report.EvaluationDetails", "Değerlendirme Detayı")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bind="click: closeDetailsModal"></button>
                </div>
                <div class="modal-body">
                    <!-- Loading -->
                    <div data-bind="visible: isDetailsLoading" class="text-center py-4">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Yükleniyor...")</p>
                    </div>

                    <!-- Details Content -->
                    <div data-bind="visible: !isDetailsLoading() && detailsData()">
                        <!-- Summary -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-3">
                                <div class="card bg-light">
                                    <div class="card-body py-2">
                                        <small class="text-muted">@Html.T("Common.Project", "Proje")</small>
                                        <div class="fw-bold" data-bind="text: detailsData() ? detailsData().projectName : '-'"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-light">
                                    <div class="card-body py-2">
                                        <small class="text-muted">@Html.T("Common.Personnel", "Personel")</small>
                                        <div class="fw-bold" data-bind="text: detailsData() ? detailsData().evaluatedPersonnelName : '-'"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-light">
                                    <div class="card-body py-2">
                                        <small class="text-muted">@Html.T("Common.Date", "Tarih")</small>
                                        <div class="fw-bold" data-bind="text: detailsData() && detailsData().evaluationDate ? new Date(detailsData().evaluationDate).toLocaleDateString('tr-TR') : '-'"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-primary text-white">
                                    <div class="card-body py-2">
                                        <small class="text-white-50">@Html.T("Common.Score", "Puan")</small>
                                        <div class="fw-bold fs-5" data-bind="text: detailsData() && detailsData().scorePercentage != null ? detailsData().scorePercentage.toFixed(1) + '%' : '-'"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Answers -->
                        <div data-bind="visible: detailsData() && detailsData().answers && detailsData().answers.length > 0">
                            <h6 class="mb-3"><i class="bi bi-list-check me-2"></i>@Html.T("Report.Answers", "Cevaplar")</h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>@Html.T("Report.Question", "Soru")</th>
                                            <th class="text-center" style="width: 80px;">@Html.T("Common.Score", "Puan")</th>
                                            <th>@Html.T("Report.Note", "Not")</th>
                                            <th>@Html.T("Report.Suggestion", "Öneri")</th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: detailsData() ? detailsData().answers : []">
                                        <tr data-bind="css: { 'table-warning': isPenaltyApplied }">
                                            <td>
                                                <span data-bind="text: questionText"></span>
                                                <!-- ko if: groupName -->
                                                <small class="text-muted d-block" data-bind="text: groupName"></small>
                                                <!-- /ko -->
                                            </td>
                                            <td class="text-center">
                                                <span data-bind="text: (givenPoints != null ? givenPoints : '-') + ' / ' + (maxPoints || 0)"></span>
                                            </td>
                                            <td>
                                                <span data-bind="text: notes || '-'"></span>
                                            </td>
                                            <td>
                                                <span data-bind="text: recommendationNotes || '-'"></span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeDetailsModal">
                        <i class="bi bi-x-lg me-1"></i>@Html.T("Common.Close", "Kapat")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" style="display: none;" data-bind="css: { show: isDetailsModalOpen }, style: { display: isDetailsModalOpen() ? 'block' : 'none' }"></div>
</div>

@section Scripts {
    <script src="~/js/CustomerPortal/suggestions.js"></script>
}
