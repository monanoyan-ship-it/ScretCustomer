@{
    ViewData["Title"] = Html.T("CustomerPortal.Menu.StaffTrainings", "Personel Egitimleri");
    Layout = "_CustomerLayout";
}

<div id="staff-trainings-app">
    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">@Html.T("StaffTrainings.Personnel", "Personel")</label>
                    <select class="form-select" data-bind="value: filterPersonnelId, options: personnelList, optionsValue: 'id', optionsText: 'fullName', optionsCaption: 'Tum Personel'"></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Html.T("Meeting.TypeTraining", "Egitim")</label>
                    <select class="form-select" data-bind="value: filterAssignmentId, options: assignmentList, optionsValue: 'id', optionsText: 'title', optionsCaption: 'Tum Egitimler'"></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Html.T("Common.Status", "Durum")</label>
                    <select class="form-select" data-bind="value: filterStatusId">
                        <option value="">Tumu</option>
                        <option value="1">Bekliyor</option>
                        <option value="2">Izliyor</option>
                        <option value="3">Tamamladi</option>
                        <option value="overdue">Geciken</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-outline-secondary w-100" data-bind="click: clearFilters">
                        <i class="bi bi-x-circle"></i> @Html.T("Common.ClearFilters", "Filtreleri Temizle")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4" data-bind="visible: !isLoading()">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0">@Html.T("Project.TotalPersonnel", "Toplam Personel")</h6>
                            <h3 class="mb-0" data-bind="text: stats().totalPersonnel"></h3>
                        </div>
                        <i class="bi bi-people fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0">@Html.T("Common.Status.Pending", "Bekleyen")</h6>
                            <h3 class="mb-0" data-bind="text: stats().pending"></h3>
                        </div>
                        <i class="bi bi-hourglass-split fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0">@Html.T("StaffTrainings.CompletedTrainings", "Tamamlanan")</h6>
                            <h3 class="mb-0" data-bind="text: stats().completed"></h3>
                        </div>
                        <i class="bi bi-check-circle fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0">@Html.T("MyTrainings.Overdue", "Geciken")</h6>
                            <h3 class="mb-0" data-bind="text: stats().overdue"></h3>
                        </div>
                        <i class="bi bi-exclamation-triangle fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Yukleniyor...")</p>
    </div>

    <!-- Trainings Table -->
    <div class="card" data-bind="visible: !isLoading()">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-table me-2"></i>@Html.T("StaffTrainings.TrainingsList", "Egitim Listesi")</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Html.T("StaffTrainings.Personnel", "Personel")</th>
                            <th>@Html.T("Meeting.TypeTraining", "Egitim")</th>
                            <th class="text-center">@Html.T("Common.Status", "Durum")</th>
                            <th class="text-center">@Html.T("Project.Progress", "Ilerleme")</th>
                            <th class="text-center">@Html.T("Common.DueDate", "Son Tarih")</th>
                            <th class="text-center">@Html.T("StaffTrainings.CompletedAt", "Tamamlama")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredTrainings">
                        <tr data-bind="css: { 'table-danger': isOverdue && !isCompleted, 'table-success': isCompleted }">
                            <td>
                                <strong data-bind="text: personnelName"></strong>
                                <br><small class="text-muted" data-bind="text: personnelEmail"></small>
                            </td>
                            <td>
                                <span data-bind="text: videoTitle"></span>
                                <br><small class="text-muted" data-bind="text: assignmentTitle"></small>
                            </td>
                            <td class="text-center">
                                <span data-bind="visible: statusId === 1" class="badge bg-warning">@Html.T("MyTrainings.StatusPending", "Bekliyor")</span>
                                <span data-bind="visible: statusId === 2" class="badge bg-info">@Html.T("MyTrainings.StatusInProgress", "Izliyor")</span>
                                <span data-bind="visible: statusId === 3" class="badge bg-success">@Html.T("Status.Completed", "Tamamladi")</span>
                                <!-- ko if: isOverdue && !isCompleted -->
                                <br><span class="badge bg-danger mt-1">@Html.T("MyTrainings.Overdue", "Geciken")</span>
                                <!-- /ko -->
                            </td>
                            <td class="text-center">
                                <div class="progress" style="height: 8px; width: 100px; margin: 0 auto;">
                                    <div class="progress-bar" role="progressbar"
                                         data-bind="style: { width: $parent.getProgressPercentage($data) + '%' }, css: { 'bg-success': isCompleted }"></div>
                                </div>
                                <small data-bind="text: $parent.getProgressPercentage($data) + '%'"></small>
                            </td>
                            <td class="text-center">
                                <span data-bind="text: $parent.formatDate(dueDate)"></span>
                                <!-- ko if: daysRemaining > 0 && !isCompleted -->
                                <br><small class="text-warning" data-bind="text: daysRemaining + ' gun kaldi'"></small>
                                <!-- /ko -->
                            </td>
                            <td class="text-center">
                                <span data-bind="text: completedAt ? $parent.formatDateTime(completedAt) : '-'"></span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Empty State -->
            <div data-bind="visible: filteredTrainings().length === 0" class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mt-2">@Html.T("StaffTrainings.NoTrainings", "Goruntulenecek egitim bulunmuyor.")</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/CustomerPortal/staffTrainings.js"></script>
}
