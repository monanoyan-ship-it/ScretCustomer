@{
    ViewData["Title"] = @Html.T("InternalAssignments.Title", "İç Değerlendirme Atamaları");
    Layout = "_CustomerLayout";
}

<div id="internal-assignments-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <p class="text-muted mb-0">@Html.T("InternalAssignments.Description", "Firma personeline checklist atama ve takip")</p>
        </div>
        <button class="btn btn-success" data-bind="click: openCreateModal">
            <i class="bi bi-plus-lg me-1"></i> @Html.T("InternalAssignments.NewAssignment", "Yeni Atama")
        </button>
    </div>

    <!-- Özet Kartları -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h6 class="card-title">@Html.T("InternalAssignments.TotalAssignments", "Toplam Atama")</h6>
                    <h2 class="mb-0" data-bind="text: summary().totalAssignments || 0">0</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark">
                <div class="card-body">
                    <h6 class="card-title">@Html.T("InternalAssignments.Pending", "Bekleyen")</h6>
                    <h2 class="mb-0" data-bind="text: summary().pendingAssignments || 0">0</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success">
                <div class="card-body">
                    <h6 class="card-title text-success">@Html.T("InternalAssignments.Completed", "Tamamlanan")</h6>
                    <h2 class="mb-0 text-success" data-bind="text: summary().completedAssignments || 0">0</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <h6 class="card-title">@Html.T("InternalAssignments.Overdue", "Süresi Geçen")</h6>
                    <h2 class="mb-0" data-bind="text: summary().overdueAssignments || 0">0</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtreler -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">@Html.T("InternalAssignments.Project", "Proje")</label>
                    <select class="form-select" data-bind="options: projects, optionsText: 'name', optionsValue: 'id', value: filter.projectId, optionsCaption: '@Html.T("Common.All", "Tümü")'"></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Html.T("InternalAssignments.Status", "Durum")</label>
                    <select class="form-select" data-bind="value: filter.isCompleted">
                        <option value="">@Html.T("Common.All", "Tümü")</option>
                        <option value="false">@Html.T("InternalAssignments.Pending", "Bekleyen")</option>
                        <option value="true">@Html.T("InternalAssignments.Completed", "Tamamlanan")</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Html.T("InternalAssignments.DueDate", "Teslim Tarihi")</label>
                    <input type="date" class="form-control" data-bind="value: filter.dueDateTo" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-outline-success w-100" data-bind="click: applyFilter">
                        <i class="bi bi-search me-1"></i> @Html.T("Common.Filter", "Filtrele")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tablo -->
    <div class="card">
        <div class="card-body">
            <!-- Loading -->
            <div data-bind="visible: isLoading" class="text-center py-5">
                <div class="spinner-border text-success" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>

            <!-- Empty State -->
            <div data-bind="visible: !isLoading() && assignments().length === 0" class="text-center py-5">
                <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted mt-3">@Html.T("InternalAssignments.NoAssignments", "Henüz atama bulunmuyor")</p>
            </div>

            <!-- Table -->
            <div data-bind="visible: !isLoading() && assignments().length > 0">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>@Html.T("InternalAssignments.Personnel", "Personel")</th>
                                <th>@Html.T("InternalAssignments.Project", "Proje")</th>
                                <th>@Html.T("InternalAssignments.DueDate", "Teslim Tarihi")</th>
                                <th>@Html.T("InternalAssignments.Status", "Durum")</th>
                                <th>@Html.T("InternalAssignments.Score", "Puan")</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: assignments">
                            <tr data-bind="css: $parent.getRowClass($data)">
                                <td>
                                    <div class="fw-medium" data-bind="text: assignedCustomerPersonnelName || '-'"></div>
                                </td>
                                <td data-bind="text: projectName"></td>
                                <td>
                                    <span data-bind="text: $parent.formatDate(dueDate)"></span>
                                    <small class="text-muted ms-1" data-bind="text: $parent.getDaysRemainingText(daysRemaining), css: { 'text-danger': daysRemaining < 0, 'text-warning': daysRemaining === 0 }"></small>
                                </td>
                                <td>
                                    <span class="badge" data-bind="css: $parent.getStatusBadgeClass(status), text: $parent.getStatusText(status)"></span>
                                </td>
                                <td>
                                    <span data-bind="visible: evaluationScore">
                                        <span data-bind="text: evaluationScore"></span>%
                                    </span>
                                    <span data-bind="visible: !evaluationScore" class="text-muted">-</span>
                                </td>
                                <td>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a class="dropdown-item" href="#" data-bind="click: $parent.showDetail"><i class="bi bi-eye me-2"></i>@Html.T("Common.Detail", "Detay")</a></li>
                                            <li><a class="dropdown-item" href="#" data-bind="click: $parent.copyLink"><i class="bi bi-link-45deg me-2"></i>@Html.T("InternalAssignments.CopyLink", "Link Kopyala")</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item text-danger" href="#" data-bind="click: $parent.deleteAssignment"><i class="bi bi-trash me-2"></i>@Html.T("Common.Delete", "Sil")</a></li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Yeni Atama Modal -->
    <div class="modal fade" id="createModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">@Html.T("InternalAssignments.NewAssignment", "Yeni İç Değerlendirme Ataması")</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <!-- Sol Kolon: Proje ve Tarih -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">@Html.T("InternalAssignments.SelectProject", "Proje Seçin") <span class="text-danger">*</span></label>
                                <select class="form-select" data-bind="options: availableProjects, optionsText: 'name', optionsValue: 'id', value: newAssignment.projectId, optionsCaption: '@Html.T("Common.Select", "Seçiniz...")'"></select>
                            </div>
                            <!-- Kontrol Listesi (readonly) -->
                            <div class="mb-3" data-bind="visible: selectedProjectChecklist()">
                                <label class="form-label">@Html.T("InternalAssignments.Checklist", "Kontrol Listesi")</label>
                                <input type="text" class="form-control" readonly data-bind="value: selectedProjectChecklist()" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">@Html.T("InternalAssignments.DueDate", "Teslim Tarihi") <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" data-bind="value: newAssignment.dueDate" />
                            </div>
                        </div>

                        <!-- Sağ Kolon: Personel Seçimi -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">@Html.T("InternalAssignments.SelectionType", "Seçim Tipi")</label>
                                <div class="btn-group w-100" role="group">
                                    <input type="radio" class="btn-check" name="selectionType" id="selByRole" value="role" data-bind="checked: selectionType">
                                    <label class="btn btn-outline-success" for="selByRole">@Html.T("InternalAssignments.ByRole", "Role Göre")</label>

                                    <input type="radio" class="btn-check" name="selectionType" id="selByPerson" value="individual" data-bind="checked: selectionType">
                                    <label class="btn btn-outline-success" for="selByPerson">@Html.T("InternalAssignments.Individual", "Tek Tek")</label>
                                </div>
                            </div>

                            <!-- Rol Seçimi -->
                            <div data-bind="visible: selectionType() === 'role'" class="mb-3">
                                <label class="form-label">@Html.T("InternalAssignments.SelectRole", "Rol Seçin")</label>
                                <select class="form-select" data-bind="value: newAssignment.roleFilter">
                                    <option value="">@Html.T("InternalAssignments.AllRoles", "Tüm Roller")</option>
                                    <option value="1">@Html.T("CustomerPersonnelRole.Manager", "Müşteri Yöneticisi")</option>
                                    <option value="2">@Html.T("CustomerPersonnelRole.Supervisor", "Müşteri Süpervizörü")</option>
                                </select>
                                <div class="form-text" data-bind="visible: selectedPersonnelCount() > 0">
                                    <i class="bi bi-people me-1"></i>
                                    <span data-bind="text: selectedPersonnelCount"></span> @Html.T("InternalAssignments.PersonnelWillBeAssigned", "personele atama yapılacak")
                                </div>
                            </div>

                            <!-- Tek Tek Seçim -->
                            <div data-bind="visible: selectionType() === 'individual'" class="mb-3">
                                <label class="form-label">@Html.T("InternalAssignments.SelectPersonnel", "Personel Seçin")</label>
                                <div class="border rounded p-2" style="max-height: 250px; overflow-y: auto;">
                                    <!-- Loading -->
                                    <div data-bind="visible: isLoadingPersonnel" class="text-center py-3">
                                        <div class="spinner-border spinner-border-sm text-success" role="status"></div>
                                    </div>
                                    <!-- Personel Listesi -->
                                    <div data-bind="visible: !isLoadingPersonnel() && availablePersonnel().length > 0, foreach: availablePersonnel">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" data-bind="value: id, checked: $parent.newAssignment.personnelIds">
                                            <label class="form-check-label">
                                                <span data-bind="text: fullName"></span>
                                                <small class="text-muted" data-bind="text: '(' + roleName + ')'"></small>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-text" data-bind="visible: newAssignment.personnelIds().length > 0">
                                    <i class="bi bi-check-circle me-1"></i>
                                    <span data-bind="text: newAssignment.personnelIds().length"></span> @Html.T("InternalAssignments.PersonnelSelected", "personel seçildi")
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Hata Mesajı -->
                    <div class="alert alert-danger" data-bind="visible: createError, text: createError"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Cancel", "İptal")</button>
                    <button type="button" class="btn btn-success" data-bind="click: createAssignments, enable: canCreate, disable: isCreating">
                        <span data-bind="visible: !isCreating()"><i class="bi bi-check-lg me-1"></i> @Html.T("InternalAssignments.CreateAssignments", "Atamaları Oluştur")</span>
                        <span data-bind="visible: isCreating"><span class="spinner-border spinner-border-sm me-1"></span> @Html.T("Common.Creating", "Oluşturuluyor...")</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Sonuç Modal -->
    <div class="modal fade" id="resultModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Html.T("InternalAssignments.Result", "Atama Sonucu")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center mb-3">
                        <i class="bi bi-check-circle text-success" style="font-size: 3rem;" data-bind="visible: createResult().successCount > 0"></i>
                    </div>
                    <div class="row text-center mb-3">
                        <div class="col-4">
                            <div class="h4 text-success" data-bind="text: createResult().successCount || 0">0</div>
                            <small class="text-muted">@Html.T("InternalAssignments.Created", "Oluşturuldu")</small>
                        </div>
                        <div class="col-4">
                            <div class="h4 text-warning" data-bind="text: createResult().skippedCount || 0">0</div>
                            <small class="text-muted">@Html.T("InternalAssignments.Skipped", "Atlandı")</small>
                        </div>
                        <div class="col-4">
                            <div class="h4 text-danger" data-bind="text: createResult().failedCount || 0">0</div>
                            <small class="text-muted">@Html.T("InternalAssignments.Failed", "Hatalı")</small>
                        </div>
                    </div>
                    <!-- Detaylar -->
                    <div data-bind="visible: createResult().errors && createResult().errors.length > 0">
                        <hr>
                        <h6>@Html.T("InternalAssignments.Errors", "Hatalar"):</h6>
                        <ul class="list-unstyled text-danger small" data-bind="foreach: createResult().errors">
                            <li><i class="bi bi-exclamation-triangle me-1"></i><span data-bind="text: $data"></span></li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" data-bs-dismiss="modal">@Html.T("Common.Close", "Kapat")</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Detay Modal -->
    <div class="modal fade" id="detailModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" data-bind="with: selectedDetail">
                <div class="modal-header">
                    <h5 class="modal-title">@Html.T("Assignments.AssignmentDetail", "Atama Detayı")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>@Html.T("InternalAssignments.Personnel", "Personel"):</strong>
                            <span data-bind="text: assignedCustomerPersonnelName || '-'"></span>
                        </div>
                        <div class="col-md-6">
                            <strong>@Html.T("InternalAssignments.Project", "Proje"):</strong>
                            <span data-bind="text: projectName"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>@Html.T("InternalAssignments.DueDate", "Teslim Tarihi"):</strong>
                            <span data-bind="text: $parent.formatDate(dueDate)"></span>
                        </div>
                        <div class="col-md-6">
                            <strong>@Html.T("InternalAssignments.Status", "Durum"):</strong>
                            <span class="badge" data-bind="css: $parent.getStatusBadgeClass(status), text: $parent.getStatusText(status)"></span>
                        </div>
                    </div>
                    <div class="row mb-3" data-bind="visible: evaluationScore">
                        <div class="col-md-6">
                            <strong>@Html.T("InternalAssignments.Score", "Puan"):</strong>
                            <span data-bind="text: evaluationScore"></span>%
                        </div>
                        <div class="col-md-6" data-bind="visible: completedAt">
                            <strong>@Html.T("Assignments.CompletedAt", "Tamamlanma Tarihi"):</strong>
                            <span data-bind="text: $parent.formatDate(completedAt)"></span>
                        </div>
                    </div>
                    <div data-bind="visible: uniqueLink" class="mb-3">
                        <strong>@Html.T("Assignments.EvaluationLink", "Değerlendirme Linki"):</strong>
                        <div class="input-group">
                            <input type="text" class="form-control" readonly data-bind="value: window.location.origin + '/e/' + uniqueLink" />
                            <button class="btn btn-outline-secondary" type="button" data-bind="click: function() { $parent.copyLink($data); }">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Close", "Kapat")</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <partial name="_DeleteConfirmationModal" />
</div>

@section Scripts {
    <script src="~/js/Shared/enums.service.js"></script>
    <script src="~/js/Shared/delete-confirmation.js"></script>
    <script src="~/js/CustomerPortal/InternalAssignments.js"></script>
}
