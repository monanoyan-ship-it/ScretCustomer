@{
    ViewData["Title"] = Html.T("CustomerPortal.Menu.MyPerformance", "Performansım");
    Layout = "_CustomerLayout";
}

<div id="my-performance-app">
    <!-- Loading Spinner -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yükleniyor...")</span>
        </div>
    </div>

    <!-- Main Content -->
    <div data-bind="visible: !isLoading()">
        <!-- Summary Cards -->
        <div class="row g-3 mb-4">
            <!-- Toplam Dinleme -->
            <div class="col-md-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                                    <i class="bi bi-headset fs-4 text-primary"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="text-muted mb-1">@Html.T("Dashboard.TotalEvaluations", "Toplam Dinleme")</h6>
                                <h3 class="mb-0" data-bind="text: totalEvaluations">0</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Ortalama Puan -->
            <div class="col-md-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <div class="bg-success bg-opacity-10 rounded-circle p-3">
                                    <i class="bi bi-graph-up fs-4 text-success"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="text-muted mb-1">@Html.T("Dealer.AverageScore", "Ortalama Puan")</h6>
                                <h3 class="mb-0">
                                    <span data-bind="text: averageScore().toFixed(1)">0</span>
                                    <small class="text-muted fs-6">%</small>
                                </h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bu Ay Puan -->
            <div class="col-md-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <div class="bg-info bg-opacity-10 rounded-circle p-3">
                                    <i class="bi bi-calendar-month fs-4 text-info"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="text-muted mb-1">@Html.T("CustomerPortal.MyPerformance.ThisMonthScore", "Bu Ay Puan")</h6>
                                <h3 class="mb-0">
                                    <span data-bind="text: thisMonthScore().toFixed(1)">0</span>
                                    <small class="text-muted fs-6">%</small>
                                </h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Kart Bilgileri -->
            <div class="col-md-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0">
                                <div class="bg-warning bg-opacity-10 rounded-circle p-3">
                                    <i class="bi bi-card-heading fs-4 text-warning"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="text-muted mb-1">@Html.T("CustomerPortal.MyPerformance.Cards", "Kartlar")</h6>
                                <div class="d-flex gap-3">
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-square-fill me-1"></i>
                                        <span data-bind="text: totalYellowCards">0</span>
                                    </span>
                                    <span class="badge bg-danger">
                                        <i class="bi bi-square-fill me-1"></i>
                                        <span data-bind="text: totalRedCards">0</span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Export Buttons -->
        <div class="d-flex justify-content-end mb-3" data-bind="visible: reportCard()">
            <div class="btn-group">
                <button class="btn btn-success btn-sm" data-bind="click: exportToExcel, disable: isExporting">
                    <span data-bind="visible: !isExporting()"><i class="bi bi-file-earmark-excel me-1"></i>Excel</span>
                    <span data-bind="visible: isExporting"><span class="spinner-border spinner-border-sm"></span></span>
                </button>
                <button class="btn btn-primary btn-sm" data-bind="click: exportToWord, disable: isExporting">
                    <span data-bind="visible: !isExporting()"><i class="bi bi-file-earmark-word me-1"></i>Word</span>
                    <span data-bind="visible: isExporting"><span class="spinner-border spinner-border-sm"></span></span>
                </button>
                <button class="btn btn-danger btn-sm" data-bind="click: exportToPdf, disable: isExporting">
                    <span data-bind="visible: !isExporting()"><i class="bi bi-file-pdf me-1"></i>PDF</span>
                    <span data-bind="visible: isExporting"><span class="spinner-border spinner-border-sm"></span></span>
                </button>
            </div>
        </div>

        <!-- Report Card Section -->
        <div data-bind="visible: reportCard()">
            <!-- Report Summary Cards -->
            <div class="row mb-3" data-bind="with: reportCard">
                <div class="col">
                    <div class="card text-center h-100 border-0 shadow-sm">
                        <div class="card-body py-2">
                            <h3 class="mb-0" data-bind="text: averageScore.toFixed(1) + '%', css: averageScore >= successThreshold ? 'text-success' : (averageScore >= warningThreshold ? 'text-warning' : 'text-danger')"></h3>
                            <small class="text-muted">Ortalama</small>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="card text-center h-100 bg-success text-white border-0 shadow-sm">
                        <div class="card-body py-2">
                            <h3 class="mb-0" data-bind="text: bestScore.toFixed(1) + '%'"></h3>
                            <small>En Yuksek</small>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="card text-center h-100 bg-danger text-white border-0 shadow-sm">
                        <div class="card-body py-2">
                            <h3 class="mb-0" data-bind="text: worstScore.toFixed(1) + '%'"></h3>
                            <small>En Dusuk</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Monthly Trend -->
            <div class="card shadow-sm mb-3" data-bind="visible: reportCard() && reportCard().monthlyTrend && reportCard().monthlyTrend.length > 0">
                <div class="card-header bg-info text-white py-2">
                    <h6 class="mb-0"><i class="bi bi-graph-up me-2"></i>@Html.T("CustomerPortal.MyPerformance.MonthlyPerformance", "Aylik Performans")</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@Html.T("CustomerPortal.MyPerformance.Period", "Donem")</th>
                                    <th class="text-center">@Html.T("CustomerPortal.MyPerformance.EvaluationCount", "Dinleme")</th>
                                    <th class="text-center">@Html.T("Dealer.AverageScore", "Ort. Puan")</th>
                                    <th class="text-center">@Html.T("CustomerPortal.MyPerformance.YellowCard", "S.Kart")</th>
                                    <th class="text-center">@Html.T("CustomerPortal.MyPerformance.RedCard", "K.Kart")</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: reportCard() ? reportCard().monthlyTrend : []">
                                <tr>
                                    <td data-bind="text: monthName"></td>
                                    <td class="text-center" data-bind="text: evaluationCount"></td>
                                    <td class="text-center">
                                        <span class="badge" data-bind="text: averageScore.toFixed(1) + '%', css: averageScore >= $root.reportCard().successThreshold ? 'bg-success' : (averageScore >= $root.reportCard().warningThreshold ? 'bg-warning text-dark' : 'bg-danger')"></span>
                                    </td>
                                    <td class="text-center" data-bind="text: yellowCards"></td>
                                    <td class="text-center" data-bind="text: redCards"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Group Performance & Strengths/Weaknesses -->
            <div class="row mb-3">
                <div class="col-md-6" data-bind="visible: reportCard() && reportCard().groupPerformances && reportCard().groupPerformances.length > 0">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-secondary text-white py-2">
                            <h6 class="mb-0"><i class="bi bi-list-task me-2"></i>@Html.T("Report.GroupPerformance", "Grup Performansi")</h6>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <tbody data-bind="foreach: reportCard() ? reportCard().groupPerformances : []">
                                    <tr>
                                        <td data-bind="text: groupName"></td>
                                        <td style="width: 50%;">
                                            <div class="progress" style="height: 18px;">
                                                <div class="progress-bar" data-bind="style: { width: percentageScore + '%' }, css: percentageScore >= $root.reportCard().successThreshold ? 'bg-success' : (percentageScore >= $root.reportCard().warningThreshold ? 'bg-warning' : 'bg-danger'), text: percentageScore.toFixed(1) + '%'"></div>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-secondary text-white py-2">
                            <h6 class="mb-0"><i class="bi bi-bar-chart me-2"></i>@Html.T("Report.StrengthsWeaknesses", "Guclu/Zayif Yonler")</h6>
                        </div>
                        <div class="card-body p-0">
                            <div class="p-2 bg-success bg-opacity-10" data-bind="visible: reportCard() && reportCard().strengths && reportCard().strengths.length > 0">
                                <small class="text-success fw-bold"><i class="bi bi-arrow-up-circle me-1"></i>@Html.T("Report.Strengths", "Guclu")</small>
                            </div>
                            <ul class="list-group list-group-flush" data-bind="foreach: reportCard() ? reportCard().strengths : []">
                                <li class="list-group-item py-1 small">
                                    <span class="badge bg-success me-1" data-bind="text: percentageScore.toFixed(0) + '%'"></span>
                                    <span data-bind="text: questionText"></span>
                                </li>
                            </ul>
                            <div class="p-2 bg-danger bg-opacity-10" data-bind="visible: reportCard() && reportCard().weaknesses && reportCard().weaknesses.length > 0">
                                <small class="text-danger fw-bold"><i class="bi bi-arrow-down-circle me-1"></i>@Html.T("CustomerPortal.MyPerformance.Weaknesses", "Gelistirilmeli") <span class="fw-normal">(Yorum sayısına göredir)</span></small>
                            </div>
                            <ul class="list-group list-group-flush" data-bind="foreach: reportCard() ? reportCard().weaknesses : []">
                                <li class="list-group-item py-1 small">
                                    <span class="badge bg-danger me-1" data-bind="text: percentageScore.toFixed(0) + '%'"></span>
                                    <span data-bind="text: questionText"></span>
                                </li>
                            </ul>
                            <!-- Empty state -->
                            <div data-bind="visible: reportCard() && (!reportCard().strengths || reportCard().strengths.length === 0) && (!reportCard().weaknesses || reportCard().weaknesses.length === 0)" class="text-center text-muted py-3">
                                <small>Henuz yeterli veri yok</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Evaluations List -->
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0">
                    <i class="bi bi-list-ul me-2"></i>
                    @Html.T("CustomerPortal.MyPerformance.MyEvaluations", "Dinlenen Cagrilarim")
                </h5>
                <div class="d-flex gap-2">
                    <!-- Search -->
                    <div class="input-group input-group-sm" style="max-width: 250px;">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" autocomplete="off"
                               data-bind="value: searchText, valueUpdate: 'input', event: { input: loadEvaluations }"
                               placeholder="@Html.T("Common.Search", "Ara...")">
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <!-- Empty State -->
                <div data-bind="visible: evaluations().length === 0" class="text-center py-5">
                    <i class="bi bi-inbox fs-1 text-muted"></i>
                    <p class="text-muted mt-2">@Html.T("CustomerPortal.MyPerformance.NoEvaluations", "Henuz degerlendirilmis cagriniz bulunmamaktadir.")</p>
                </div>

                <!-- Table -->
                <div data-bind="visible: evaluations().length > 0" class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Html.T("Common.CallId", "Cagri ID")</th>
                                <th>@Html.T("Report.CallDate", "Cagri Tarihi")</th>
                                <th>@Html.T("Common.Project", "Proje")</th>
                                <th class="text-center">@Html.T("CustomerPortal.MyPerformance.Score", "Puan")</th>
                                <th class="text-center">@Html.T("CustomerPortal.MyPerformance.Cards", "Kartlar")</th>
                                <th class="text-center">@Html.T("Common.Actions", "Islemler")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: filteredEvaluations">
                            <tr>
                                <td><call-id params="value: callId"></call-id></td>
                                <td>
                                    <span data-bind="text: callDate ? new Date(callDate).toLocaleDateString('tr-TR') : '-'"></span>
                                    <small class="text-muted d-block" data-bind="text: callTime || ''"></small>
                                </td>
                                <td>
                                    <span data-bind="text: projectName || '-'"></span>
                                    <small class="text-muted d-block" data-bind="text: checklistName || ''"></small>
                                </td>
                                <td class="text-center">
                                    <span class="badge fs-6" data-bind="text: (scorePercentage || 0).toFixed(1) + '%', css: $parent.getScoreBadgeClass(scorePercentage)"></span>
                                </td>
                                <td class="text-center">
                                    <!-- ko if: yellowCardCount > 0 || redCardCount > 0 -->
                                    <span data-bind="visible: yellowCardCount > 0" class="badge bg-warning text-dark me-1">
                                        <i class="bi bi-square-fill"></i> <span data-bind="text: yellowCardCount"></span>
                                    </span>
                                    <span data-bind="visible: redCardCount > 0" class="badge bg-danger">
                                        <i class="bi bi-square-fill"></i> <span data-bind="text: redCardCount"></span>
                                    </span>
                                    <!-- /ko -->
                                    <!-- ko if: yellowCardCount === 0 && redCardCount === 0 -->
                                    <span class="text-muted">-</span>
                                    <!-- /ko -->
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary" data-bind="click: $parent.showDetail" title="@Html.T("Common.Detail", "Detay")">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- Pagination -->
            <div data-bind="visible: evaluations().length > pageSize()" class="card-footer bg-white">
                <nav>
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        <li class="page-item" data-bind="css: { disabled: currentPage() === 1 }">
                            <a class="page-link" href="#" data-bind="click: function() { currentPage(currentPage() - 1); }">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        <!-- ko foreach: visiblePages -->
                        <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }">
                            <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.currentPage($data); }"></a>
                        </li>
                        <!-- /ko -->
                        <li class="page-item" data-bind="css: { disabled: currentPage() === totalPages() }">
                            <a class="page-link" href="#" data-bind="click: function() { currentPage(currentPage() + 1); }">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>

    <!-- Details Modal -->
    <div class="modal fade" data-bind="css: { show: isDetailsModalOpen }, style: { display: isDetailsModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-clipboard-check me-2"></i>@Html.T("CustomerPortal.MyPerformance.EvaluationDetail", "Dinleme Detayi")</h5>
                    <div class="ms-auto d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-outline-light btn-sm" data-bind="click: exportDetailToExcel, disable: isExportingDetail">
                            <span data-bind="visible: !isExportingDetail()"><i class="bi bi-file-earmark-excel me-1"></i>Excel</span>
                            <span data-bind="visible: isExportingDetail"><span class="spinner-border spinner-border-sm"></span></span>
                        </button>
                        <button type="button" class="btn-close btn-close-white" data-bind="click: closeDetailsModal"></button>
                    </div>
                </div>
                <div class="modal-body">
                    <div data-bind="visible: isDetailsLoading" class="text-center py-5">
                        <div class="spinner-border text-primary"></div>
                    </div>
                    <div data-bind="visible: !isDetailsLoading() && detailsData()">
                        <!-- ko with: detailsData -->
                        <div class="card mb-4">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-md-2 text-center border-end">
                                        <h2 class="mb-0" data-bind="text: (scorePercentage || 0).toFixed(2) + '%', css: $parent.getScoreClass(scorePercentage || 0)"></h2>
                                        <small class="text-muted">@Html.T("CustomerPortal.MyPerformance.TotalScore", "Toplam Puan")</small>
                                    </div>
                                    <div class="col-md-10">
                                        <div class="progress" style="height: 25px;">
                                            <div class="progress-bar" data-bind="style: { width: (scorePercentage || 0) + '%' }, css: $parent.getProgressBarClass(scorePercentage || 0), text: (scorePercentage || 0).toFixed(2) + '%'"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="card h-100">
                                    <div class="card-header bg-light"><h6 class="mb-0"><i class="bi bi-building"></i> @Html.T("CustomerPortal.MyPerformance.Evaluated", "Degerlendirilen")</h6></div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr><th style="width:40%;">@Html.T("CustomerPortal.MyPerformance.Company", "Firma")</th><td data-bind="text: customerName || '-'"></td></tr>
                                            <tr><th>@Html.T("CustomerPortal.MyPerformance.Organization", "Organizasyon")</th><td data-bind="text: organizationName || '-'"></td></tr>
                                            <tr><th>@Html.T("CustomerPortal.MyPerformance.Personnel", "Temsilci")</th><td data-bind="text: evaluatedPersonnelName || dealerName || '-'"></td></tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card h-100">
                                    <div class="card-header bg-light"><h6 class="mb-0"><i class="bi bi-telephone"></i> @Html.T("CustomerPortal.MyPerformance.CallInfo", "Cagri Bilgileri")</h6></div>
                                    <div class="card-body">
                                        <table class="table table-sm mb-0">
                                            <tr>
                                                <th style="width:40%;">@Html.T("Common.CallId", "Cagri ID")</th>
                                                <td><call-id params="value: callId"></call-id></td>
                                            </tr>
                                            <tr><th>@Html.T("Report.CallDate", "Tarih")</th><td data-bind="text: callDate ? new Date(callDate).toLocaleDateString('tr-TR') : '-'"></td></tr>
                                            <!-- ko if: callTime -->
                                            <tr><th>@Html.T("Report.CallTime", "Cagri Saati")</th><td data-bind="text: callTime"></td></tr>
                                            <!-- /ko -->
                                            <tr><th>@Html.T("CustomerPortal.MyPerformance.Duration", "Sure")</th><td data-bind="text: duration || '-'"></td></tr>
                                            <!-- ko if: controlTime -->
                                            <tr><th>@Html.T("Evaluation.ControlTime", "Kontrol Saati")</th><td data-bind="text: controlTime"></td></tr>
                                            <!-- /ko -->
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card mb-4" data-bind="visible: descriptions && descriptions.length > 0">
                            <div class="card-header bg-secondary text-white"><h6 class="mb-0"><i class="bi bi-list-ul"></i> @Html.T("Evaluation.Descriptions", "Aciklamalar")</h6></div>
                            <div class="card-body">
                                <ul class="mb-0" data-bind="foreach: descriptions">
                                    <li data-bind="text: $data"></li>
                                </ul>
                            </div>
                        </div>
                        <div class="card mb-4" data-bind="visible: evaluationComment">
                            <div class="card-header bg-info text-white"><h6 class="mb-0"><i class="bi bi-chat-quote"></i> @Html.T("Report.Comment", "Denetim Yorumu")</h6></div>
                            <div class="card-body"><p class="mb-0" data-bind="text: evaluationComment"></p></div>
                        </div>
                        <div class="card">
                            <div class="card-header bg-light"><h6 class="mb-0"><i class="bi bi-list-check"></i> @Html.T("CustomerPortal.MyPerformance.Answers", "Cevaplar")</h6></div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-sm table-striped mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width:12%;">@Html.T("CustomerPortal.MyPerformance.Group", "Grup")</th>
                                                <th style="width:30%;">@Html.T("CustomerPortal.MyPerformance.Question", "Soru")</th>
                                                <th class="text-center" style="width:10%;">@Html.T("CustomerPortal.MyPerformance.Answer", "Cevap")</th>
                                                <th class="text-center" style="width:10%;">@Html.T("CustomerPortal.MyPerformance.Weight", "Agirlik")</th>
                                                <th class="text-center" style="width:10%;">@Html.T("CustomerPortal.MyPerformance.Earned", "Kazanilan")</th>
                                                <th style="width:28%;">@Html.T("CustomerPortal.MyPerformance.Notes", "Notlar")</th>
                                            </tr>
                                        </thead>
                                        <tbody data-bind="foreach: answers || []">
                                            <tr data-bind="css: { 'table-warning': $data.appliedPenaltyType === 'YellowCard', 'table-danger': $data.appliedPenaltyType === 'RedCard' }">
                                                <td data-bind="text: $data.groupName || '-'"></td>
                                                <td>
                                                    <span data-bind="text: $data.questionText"></span>
                                                    <!-- ko if: $data.selectedSubCriteria && $data.selectedSubCriteria.length > 0 -->
                                                    <br><small class="text-warning"><i class="bi bi-exclamation-triangle"></i> <span data-bind="text: $data.selectedSubCriteria.join(', ')"></span></small>
                                                    <!-- /ko -->
                                                </td>
                                                <td class="text-center">
                                                    <!-- ko if: $data.scoringType !== 'Unscored' && $data.givenPoints !== null && $data.maxPoints > 0 -->
                                                    <span class="badge bg-primary" data-bind="text: $data.givenPoints + '/' + $data.maxPoints"></span>
                                                    <!-- /ko -->
                                                    <!-- ko if: $data.scoringType === 'Unscored' || !($data.givenPoints !== null && $data.maxPoints > 0) -->
                                                    <span class="text-muted">-</span>
                                                    <!-- /ko -->
                                                </td>
                                                <td class="text-center">
                                                    <!-- ko if: $data.scoringType !== 'Unscored' && $data.maxPoints > 0 -->
                                                    <span data-bind="text: $data.maxPoints"></span>
                                                    <!-- /ko -->
                                                    <!-- ko if: $data.scoringType === 'Unscored' || !($data.maxPoints > 0) -->
                                                    <span class="text-muted">-</span>
                                                    <!-- /ko -->
                                                </td>
                                                <td class="text-center">
                                                    <!-- ko if: $data.scoringType !== 'Unscored' && $data.maxPoints > 0 -->
                                                    <span class="text-success" data-bind="text: ($data.givenPoints || 0).toFixed(1)"></span>
                                                    <!-- /ko -->
                                                    <!-- ko if: $data.scoringType === 'Unscored' || !($data.maxPoints > 0) -->
                                                    <span class="text-muted">-</span>
                                                    <!-- /ko -->
                                                </td>
                                                <td data-bind="text: $data.notes || '-'"></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeDetailsModal">
                        <i class="bi bi-x-lg me-1"></i> @Html.T("Common.Close", "Kapat")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isDetailsModalOpen }, style: { display: isDetailsModalOpen() ? 'block' : 'none' }"></div>
</div>

@section Scripts {
    <script src="~/js/CustomerPortal/my-performance.js" asp-append-version="true"></script>
}
