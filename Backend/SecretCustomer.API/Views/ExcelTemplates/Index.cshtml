@model IEnumerable<SecretCustomer.Core.Entities.ExcelTemplate>

@{
    ViewData["Title"] = "Excel Şablonları";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-file-earmark-spreadsheet me-2"></i>
            Excel Şablonları
        </h2>
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Yeni Şablon Oluştur
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            Henüz hiç Excel şablonu oluşturulmamış. Yeni bir şablon oluşturmak için yukarıdaki butona tıklayın.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Şablon Adı</th>
                                <th>Açıklama</th>
                                <th>Varlık Tipi</th>
                                <th>Kolon Sayısı</th>
                                <th>Durum</th>
                                <th>Oluşturma Tarihi</th>
                                <th style="width: 250px;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var template in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@template.Name</strong>
                                    </td>
                                    <td>@template.Description</td>
                                    <td>
                                        <span class="badge bg-secondary">@template.EntityType</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@template.Columns.Count kolon</span>
                                    </td>
                                    <td>
                                        @if (template.IsActive)
                                        {
                                            <span class="badge bg-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Pasif</span>
                                        }
                                    </td>
                                    <td>@template.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("Export", new { id = template.Id })"
                                               class="btn btn-sm btn-success"
                                               title="Örnek Excel İndir">
                                                <i class="bi bi-download"></i>
                                            </a>
                                            <a href="@Url.Action("Import", new { id = template.Id })"
                                               class="btn btn-sm btn-info"
                                               title="Excel Yükle">
                                                <i class="bi bi-upload"></i>
                                            </a>
                                            <a href="@Url.Action("Edit", new { id = template.Id })"
                                               class="btn btn-sm btn-primary"
                                               title="Düzenle">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="confirmDelete('@template.Id', '@template.Name')"
                                                    title="Sil">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Şablonu Sil</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p><strong id="templateName"></strong> şablonunu silmek istediğinizden emin misiniz?</p>
                <p class="text-muted">Bu işlem geri alınamaz.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <form id="deleteForm" method="post" style="display: inline;">
                    <button type="submit" class="btn btn-danger">Sil</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('templateName').textContent = name;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + id;

            var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }
    </script>
}
