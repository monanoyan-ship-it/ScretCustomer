@{
    ViewData["Title"] = "Yeni Excel Şablonu";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-plus-circle me-2"></i>
            Yeni Excel Şablonu Oluştur
        </h2>
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Geri Dön
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <form id="templateForm">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Şablon Adı <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="name" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Varlık Tipi <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="entityType" required
                               placeholder="Örn: User, Branch, Product">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Açıklama</label>
                    <textarea class="form-control" id="description" rows="2"></textarea>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Sheet Adı</label>
                        <input type="text" class="form-control" id="sheetName" value="Sheet1">
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="hasHeader" checked>
                            <label class="form-check-label" for="hasHeader">
                                Başlık satırı var
                            </label>
                        </div>
                    </div>
                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5>Kolonlar</h5>
                    <button type="button" class="btn btn-sm btn-primary" onclick="addColumn()">
                        <i class="bi bi-plus-circle me-1"></i>
                        Kolon Ekle
                    </button>
                </div>

                <div id="columnsContainer" class="mb-3">
                    <!-- Columns will be added here dynamically -->
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="@Url.Action("Index")" class="btn btn-secondary">İptal</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>
                        Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let columnIndex = 0;

        const columnTypes = [
            { value: 'Text', label: 'Metin' },
            { value: 'Number', label: 'Sayı' },
            { value: 'Date', label: 'Tarih' },
            { value: 'Boolean', label: 'Evet/Hayır' },
            { value: 'Email', label: 'E-posta' },
            { value: 'Phone', label: 'Telefon' },
            { value: 'Dropdown', label: 'Seçim Listesi' }
        ];

        function addColumn() {
            const container = document.getElementById('columnsContainer');
            const index = columnIndex++;

            const columnHtml = `
                <div class="card mb-3 column-card" id="column-${index}">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0">Kolon #${index + 1}</h6>
                            <button type="button" class="btn btn-sm btn-danger" onclick="removeColumn(${index})">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-2">
                                <label class="form-label">Excel Kolon Adı *</label>
                                <input type="text" class="form-control" name="columns[${index}].columnName" required>
                            </div>
                            <div class="col-md-4 mb-2">
                                <label class="form-label">Property Adı *</label>
                                <input type="text" class="form-control" name="columns[${index}].propertyName" required>
                            </div>
                            <div class="col-md-4 mb-2">
                                <label class="form-label">Tip *</label>
                                <select class="form-select" name="columns[${index}].columnType" onchange="toggleDropdownOptions(${index})" required>
                                    ${columnTypes.map(t => `<option value="${t.value}">${t.label}</option>`).join('')}
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-2">
                                <label class="form-label">Sıra *</label>
                                <input type="number" class="form-control" name="columns[${index}].order" value="${index + 1}" required>
                            </div>
                            <div class="col-md-4 mb-2">
                                <label class="form-label">Örnek Değer</label>
                                <input type="text" class="form-control" name="columns[${index}].sampleValue">
                            </div>
                            <div class="col-md-4 mb-2 d-flex align-items-end">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="columns[${index}].isRequired">
                                    <label class="form-check-label">Zorunlu</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label">Açıklama</label>
                            <input type="text" class="form-control" name="columns[${index}].description">
                        </div>

                        <div class="mb-2 dropdown-options-container" id="dropdown-${index}" style="display: none;">
                            <label class="form-label">Seçim Listesi Değerleri (virgülle ayırın)</label>
                            <input type="text" class="form-control" name="columns[${index}].dropdownOptions"
                                   placeholder="Seçenek1, Seçenek2, Seçenek3">
                        </div>
                    </div>
                </div>
            `;

            container.insertAdjacentHTML('beforeend', columnHtml);
        }

        function removeColumn(index) {
            document.getElementById(`column-${index}`).remove();
        }

        function toggleDropdownOptions(index) {
            const select = document.querySelector(`select[name="columns[${index}].columnType"]`);
            const dropdownContainer = document.getElementById(`dropdown-${index}`);

            if (select.value === 'Dropdown') {
                dropdownContainer.style.display = 'block';
            } else {
                dropdownContainer.style.display = 'none';
            }
        }

        document.getElementById('templateForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const formData = new FormData(this);
            const columns = [];

            // Collect columns
            for (let i = 0; i < columnIndex; i++) {
                const columnCard = document.getElementById(`column-${i}`);
                if (!columnCard) continue;

                const columnName = formData.get(`columns[${i}].columnName`);
                const propertyName = formData.get(`columns[${i}].propertyName`);
                const columnType = formData.get(`columns[${i}].columnType`);
                const order = parseInt(formData.get(`columns[${i}].order`));
                const isRequired = formData.get(`columns[${i}].isRequired`) === 'on';
                const sampleValue = formData.get(`columns[${i}].sampleValue`);
                const description = formData.get(`columns[${i}].description`);
                const dropdownOptionsStr = formData.get(`columns[${i}].dropdownOptions`);

                const column = {
                    columnName,
                    propertyName,
                    columnType,
                    order,
                    isRequired,
                    sampleValue: sampleValue || null,
                    description: description || null,
                    dropdownOptions: dropdownOptionsStr ? dropdownOptionsStr.split(',').map(s => s.trim()) : null
                };

                columns.push(column);
            }

            const template = {
                name: document.getElementById('name').value,
                description: document.getElementById('description').value,
                entityType: document.getElementById('entityType').value,
                sheetName: document.getElementById('sheetName').value,
                hasHeader: document.getElementById('hasHeader').checked,
                columns: columns
            };

            try {
                const response = await fetch('/api/excel-templates', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(template)
                });

                if (response.ok) {
                    window.location.href = '@Url.Action("Index")';
                } else {
                    const error = await response.json();
                    alert('Hata: ' + (error.message || 'Bilinmeyen hata'));
                }
            } catch (error) {
                alert('Hata: ' + error.message);
            }
        });

        // Add initial column
        addColumn();
    </script>
}
