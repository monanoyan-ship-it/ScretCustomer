@model ProjectCreateEditViewModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Proje Düzenle" : "Yeni Proje Oluştur";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<div class="card shadow">
    <div class="card-body">
        <form asp-action="Save" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <input type="hidden" asp-for="Id" />

            <div class="row">
                <div class="col-md-12 mb-3">
                    <label asp-for="Name" class="form-label">Proje Adı *</label>
                    <input asp-for="Name" class="form-control" placeholder="Örn: 2026 Q1 Gizli Müşteri Projesi" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Açıklama</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Proje hakkında açıklama..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ChecklistId" class="form-label">Kontrol Listesi *</label>
                <select asp-for="ChecklistId" class="form-select">
                    <option value="">Seçiniz...</option>
                    @foreach (var checklist in Model.AvailableChecklists)
                    {
                        <option value="@checklist.Id">@checklist.Name</option>
                    }
                </select>
                <small class="text-muted">Bu projede kullanılacak değerlendirme formu</small>
                <span asp-validation-for="ChecklistId" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="StartDate" class="form-label">Başlangıç Tarihi *</label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="EndDate" class="form-label">Bitiş Tarihi *</label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> @(Model.Id.HasValue ? "Güncelle" : "Oluştur")
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> İptal
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
