@{
    ViewData["Title"] = Html.T("Project.Title", "Proje Yönetimi");
}

<div id="projects-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-kanban"></i> @Html.T("Project.Title", "Proje Yönetimi")</h2>
        <button class="btn btn-primary" data-bind="click: openCreateModal">
            <i class="bi bi-plus-circle"></i> @Html.T("Project.NewProject", "Yeni Proje")
        </button>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4" data-bind="visible: !isLoading()">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0">@Html.T("Project.TotalProjects", "Toplam Proje")</h6>
                            <h3 class="mb-0" data-bind="text: stats().total"></h3>
                        </div>
                        <i class="bi bi-folder2 fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0">@Html.T("Common.Active", "Aktif")</h6>
                            <h3 class="mb-0" data-bind="text: stats().active"></h3>
                        </div>
                        <i class="bi bi-play-circle fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0">@Html.T("Project.UpcomingEnd", "Yaklaşan Bitiş")</h6>
                            <h3 class="mb-0" data-bind="text: stats().upcoming"></h3>
                        </div>
                        <i class="bi bi-clock-history fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0">@Html.T("Status.Completed", "Tamamlanan")</h6>
                            <h3 class="mb-0" data-bind="text: stats().completed"></h3>
                        </div>
                        <i class="bi bi-check-circle fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <!-- Filter Add Row -->
            <div class="row g-2 align-items-end">
                <!-- Filter Type Select -->
                <div class="col-md-2">
                    <label class="form-label small text-muted">@Html.T("Common.FilterType", "Filtre Tipi")</label>
                    <select class="form-select form-select-sm" data-bind="value: selectedFilterType">
                        <option value="">@Html.T("Common.SelectFilter", "Filtre Seçin...")</option>
                        <option value="customer">@Html.T("Common.Customer", "Müşteri")</option>
                        <!-- ko ifnot: pageProjectType -->
                        <option value="projectType">@Html.T("Project.Type", "Proje Tipi")</option>
                        <!-- /ko -->
                        <option value="status">@Html.T("Common.Status", "Durum")</option>
                        <option value="projectManager">@Html.T("Project.ProjectManager", "Proje Yöneticisi")</option>
                        <option value="search">@Html.T("Common.Search", "Arama")</option>
                        <option value="endingDate">@Html.T("Project.EndDate", "Bitiş Tarihi")</option>
                    </select>
                </div>

                <!-- Dynamic Filter Input -->
                <div class="col-md-8">
                    <!-- Customer Filter -->
                    <div data-bind="visible: selectedFilterType() === 'customer'">
                        <label class="form-label small text-muted">@Html.T("Common.Customer", "Müşteri")</label>
                        <select class="form-select form-select-sm" data-bind="value: tempFilter.customerId, options: customers, optionsText: function(c) { return c.companyName + (c.code ? ' (' + c.code + ')' : ''); }, optionsValue: 'id', optionsCaption: '@Html.T("Common.Select", "Seçiniz...")'"></select>
                    </div>

                    <!-- Project Type Filter -->
                    <div data-bind="visible: selectedFilterType() === 'projectType'">
                        <label class="form-label small text-muted">@Html.T("Project.Type", "Proje Tipi")</label>
                        <select class="form-select form-select-sm" data-bind="value: tempFilter.projectType">
                            <option value="">@Html.T("Common.Select", "Seçiniz...")</option>
                            <option value="MysteryShopping">@Html.T("Project.Type.MysteryShopping", "Gizli Müşteri")</option>
                            <option value="CallAuditing">@Html.T("Project.Type.CallAuditing", "Çağrı Denetimi")</option>
                            <option value="PhysicalAudit">@Html.T("ProjectType.PhysicalAudit", "Fiziksel Denetim")</option>
                            <option value="OnlineSurvey">@Html.T("ProjectType.OnlineSurvey", "Online Anket")</option>
                            <option value="CustomerSatisfaction">@Html.T("ProjectType.CustomerSatisfaction", "Müşteri Memnuniyeti")</option>
                            <option value="TrainingEvaluation">@Html.T("Project.Type.TrainingEvaluation", "Eğitim Değerlendirme")</option>
                            <option value="QualityControl">@Html.T("ProjectType.QualityControl", "Kalite Kontrol")</option>
                        </select>
                    </div>

                    <!-- Status Filter -->
                    <div data-bind="visible: selectedFilterType() === 'status'">
                        <label class="form-label small text-muted">@Html.T("Common.Status", "Durum")</label>
                        <select class="form-select form-select-sm" data-bind="value: tempFilter.status">
                            <option value="">@Html.T("Common.Select", "Seçiniz...")</option>
                            <option value="Draft">@Html.T("Common.Status.Draft", "Taslak")</option>
                            <option value="Planned">@Html.T("Project.Status.Planned", "Planlandı")</option>
                            <option value="Active">@Html.T("Project.Status.Active", "Aktif")</option>
                            <option value="Paused">@Html.T("ProjectStatus.Paused", "Duraklatıldı")</option>
                            <option value="Completed">@Html.T("Status.Completed", "Tamamlandı")</option>
                            <option value="Cancelled">@Html.T("Status.Cancelled", "İptal Edildi")</option>
                        </select>
                    </div>

                    <!-- Project Manager Filter -->
                    <div data-bind="visible: selectedFilterType() === 'projectManager'">
                        <label class="form-label small text-muted">@Html.T("Project.ProjectManager", "Proje Yöneticisi")</label>
                        <select class="form-select form-select-sm" data-bind="value: tempFilter.projectManagerId, options: users, optionsText: 'fullName', optionsValue: 'id', optionsCaption: '@Html.T("Common.Select", "Seçiniz...")'"></select>
                    </div>

                    <!-- Search Filter -->
                    <div data-bind="visible: selectedFilterType() === 'search'">
                        <label class="form-label small text-muted">@Html.T("Common.SearchTerm", "Arama Terimi")</label>
                        <input type="text" class="form-control form-control-sm" placeholder="@Html.T("Project.SearchPlaceholder", "Proje ara...")" data-bind="value: tempFilter.searchTerm, valueUpdate: 'input'">
                    </div>

                    <!-- Ending Date Filter (Proje bitiş tarihine göre) -->
                    <div data-bind="visible: selectedFilterType() === 'endingDate'">
                        <label class="form-label small text-muted">@Html.T("Project.EndDateFilter", "Bitiş Tarihi Filtresi")</label>
                        <select class="form-select form-select-sm" data-bind="value: tempFilter.selectedDateRangeType">
                            <option value="">@Html.T("Common.Select", "Seçiniz...")</option>
                            <!-- ko foreach: endingDateOptions -->
                            <option data-bind="value: systemName, text: name"></option>
                            <!-- /ko -->
                        </select>
                    </div>

                    <!-- No filter selected message -->
                    <div data-bind="visible: !selectedFilterType()" class="text-muted small pt-4">
                        <i class="bi bi-info-circle"></i> @Html.T("Common.SelectFilterToAdd", "Eklemek için bir filtre tipi seçin")
                    </div>
                </div>

                <!-- Add Filter Button -->
                <div class="col-md-2">
                    <button type="button" class="btn btn-sm btn-primary w-100" data-bind="click: addFilter, enable: canAddFilter">
                        <i class="bi bi-plus-circle"></i> @Html.T("Common.AddFilter", "Filtre Ekle")
                    </button>
                </div>
            </div>

            <!-- Active Filters (Chips) - ALTTA -->
            <div class="mt-3" data-bind="visible: activeFilters().length > 0">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="text-muted small">@Html.T("Common.ActiveFilters", "Aktif Filtreler"):</span>
                    <!-- ko foreach: activeFilters -->
                    <span class="badge d-flex align-items-center gap-1" style="font-size: 0.9em;" data-bind="css: isFixed ? 'bg-secondary' : 'bg-primary'">
                        <span data-bind="text: displayLabel"></span>: <span data-bind="text: displayValue"></span>
                        <!-- ko ifnot: isFixed -->
                        <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.6em;" data-bind="click: $parent.removeFilter"></button>
                        <!-- /ko -->
                    </span>
                    <!-- /ko -->
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bind="click: clearFilters">
                        <i class="bi bi-x-circle"></i> @Html.T("Common.ClearAll", "Tümünü Temizle")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2">@Html.T("Project.Loading", "Projeler yükleniyor...")</p>
    </div>

    <!-- Projects Table -->
    <div class="card" data-bind="visible: !isLoading()">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>
                <i class="bi bi-list"></i> @Html.T("Menu.Projects", "Projeler")
                <span class="badge bg-secondary ms-2" data-bind="text: filteredProjects().length"></span>
            </span>
            <div class="btn-group btn-group-sm">
                <button type="button" class="btn" data-bind="css: viewMode() === 'table' ? 'btn-primary' : 'btn-outline-primary', click: function() { viewMode('table'); }">
                    <i class="bi bi-table"></i>
                </button>
                <button type="button" class="btn" data-bind="css: viewMode() === 'cards' ? 'btn-primary' : 'btn-outline-primary', click: function() { viewMode('cards'); }">
                    <i class="bi bi-grid-3x3-gap"></i>
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <!-- Empty State -->
            <div data-bind="visible: filteredProjects().length === 0" class="text-center py-5">
                <i class="bi bi-folder-x fs-1 text-muted"></i>
                <p class="text-muted mt-2">@Html.T("Report.NoProjects", "Proje bulunamadı")</p>
            </div>

            <!-- Table View -->
            <div data-bind="visible: viewMode() === 'table' && filteredProjects().length > 0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="sortable" data-bind="click: function() { sorting.toggleSort('code'); }, css: sorting.getSortClass('code')">
                                @Html.T("Common.Code", "Kod")
                                <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('code')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { sorting.toggleSort('name'); }, css: sorting.getSortClass('name')">
                                @Html.T("Project.ProjectName", "Proje Adı")
                                <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('name')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { sorting.toggleSort('projectType'); }, css: sorting.getSortClass('projectType')">
                                @Html.T("Project.Type", "Tip")
                                <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('projectType')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { sorting.toggleSort('checklistName'); }, css: sorting.getSortClass('checklistName')">
                                @Html.T("Project.Checklist", "K. Listesi")
                                <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('checklistName')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { sorting.toggleSort('status'); }, css: sorting.getSortClass('status')">
                                @Html.T("Common.Status", "Durum")
                                <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('status')"></i>
                            </th>
                            <th>@Html.T("Project.Progress", "İlerleme")</th>
                            <th class="sortable" data-bind="click: function() { sorting.toggleSort('startDate'); }, css: sorting.getSortClass('startDate')">
                                @Html.T("Common.Dates", "Tarihler")
                                <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('startDate')"></i>
                            </th>
                            <th class="text-end">@Html.T("Common.Actions", "İşlemler")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredProjects">
                        <tr>
                            <td><code data-bind="text: code || '-'"></code></td>
                            <td>
                                <a href="#" data-bind="text: name, click: function() { $parent.openDetailModal($data); }, clickBubble: false" class="fw-bold text-decoration-none"></a>
                                <br><small class="text-muted">
                                    <!-- ko if: customerName -->
                                    <span data-bind="text: customerName"></span>
                                    <!-- ko if: customerCode -->
                                    (<code data-bind="text: customerCode"></code>)
                                    <!-- /ko -->
                                    <!-- /ko -->
                                    <!-- ko ifnot: customerName -->
                                    @Html.T("Project.NoCustomer", "Müşteri belirtilmedi")
                                    <!-- /ko -->
                                </small>
                            </td>
                            <td><span class="badge" data-bind="text: $parent.getProjectTypeText(projectType), css: $parent.getProjectTypeBadge(projectType)"></span></td>
                            <td>
                                <small data-bind="text: checklistName || '-'"></small>
                                <!-- ko if: isChecklistDeleted -->
                                <span class="badge bg-danger ms-1">@Html.T("Project.ChecklistDeleted", "Silinmiş")</span>
                                <!-- /ko -->
                            </td>
                            <td><span class="badge" data-bind="text: $parent.getStatusText(status), css: $parent.getStatusBadge(status)"></span></td>
                            <td style="min-width: 150px;">
                                <!-- ko if: completionPercentage >= 0 -->
                                <div class="d-flex align-items-center">
                                    <div class="progress flex-grow-1 me-2" style="height: 6px;">
                                        <div class="progress-bar" data-bind="style: { width: completionPercentage + '%' }, css: completionPercentage >= 100 ? 'bg-success' : ''"></div>
                                    </div>
                                    <small data-bind="text: completionPercentage.toFixed(2) + '%'"></small>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: completionPercentage < 0 -->
                                <span class="text-muted">-</span>
                                <!-- /ko -->
                            </td>
                            <td>
                                <small>
                                    <i class="bi bi-calendar-event"></i> <span data-bind="text: new Date(startDate).toLocaleDateString('tr-TR')"></span><br>
                                    <i class="bi bi-calendar-check"></i> <span data-bind="text: new Date(endDate).toLocaleDateString('tr-TR')"></span>
                                </small>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-info" data-bind="click: function() { $parent.openDetailModal($data); }, clickBubble: false" title="@Html.T("Common.Detail", "Detay")">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-primary" data-bind="click: function() { $parent.openEditModal($data); }, clickBubble: false, visible: status !== 'Completed' && status !== 'Cancelled' && !isChecklistDeleted" title="@Html.T("Common.Edit", "Düzenle")">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-success" data-bind="click: function() { $parent.startProject($data); }, clickBubble: false, visible: (status === 'Draft' || status === 'Planned' || status === 'Paused') && !isChecklistDeleted" title="@Html.T("Common.Start", "Başlat")">
                                        <i class="bi bi-play"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-warning" data-bind="click: function() { $parent.pauseProject($data); }, clickBubble: false, visible: status === 'Active' && !isChecklistDeleted" title="@Html.T("Project.Pause", "Duraklat")">
                                        <i class="bi bi-pause"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary" data-bind="click: function() { $parent.completeProject($data); }, clickBubble: false, visible: status === 'Active' && !isChecklistDeleted" title="@Html.T("Common.Complete", "Tamamla")">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-info" data-bind="click: function() { $parent.reactivateProject($data); }, clickBubble: false, visible: status === 'Completed'" title="@Html.T("Project.Reactivate", "Yeniden Aktif Et")">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-danger" data-bind="click: function() { $parent.deleteProject($data); }, clickBubble: false, visible: status === 'Draft' || status === 'Completed' || isChecklistDeleted" title="@Html.T("Common.Delete", "Sil")">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="card-footer d-flex align-items-center gap-3" data-bind="visible: totalPages() > 1">
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item" data-bind="css: { disabled: currentPage() === 1 }">
                            <a class="page-link" href="#" data-bind="click: firstPage"><i class="bi bi-chevron-double-left"></i></a>
                        </li>
                        <li class="page-item" data-bind="css: { disabled: currentPage() === 1 }">
                            <a class="page-link" href="#" data-bind="click: prevPage"><i class="bi bi-chevron-left"></i></a>
                        </li>
                        <!-- ko foreach: pageNumbers -->
                        <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }">
                            <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                        </li>
                        <!-- /ko -->
                        <li class="page-item" data-bind="css: { disabled: currentPage() === totalPages() }">
                            <a class="page-link" href="#" data-bind="click: nextPage"><i class="bi bi-chevron-right"></i></a>
                        </li>
                        <li class="page-item" data-bind="css: { disabled: currentPage() === totalPages() }">
                            <a class="page-link" href="#" data-bind="click: lastPage"><i class="bi bi-chevron-double-right"></i></a>
                        </li>
                    </ul>
                </nav>
                <div>
                    <select class="form-select form-select-sm" style="width: auto;" data-bind="value: pageSize">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            </div>

            <!-- Cards View -->
            <div class="row g-3 p-3" data-bind="visible: viewMode() === 'cards' && filteredProjects().length > 0, foreach: filteredProjects">
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="badge" data-bind="text: $parent.getStatusText(status), css: $parent.getStatusBadge(status)"></span>
                            <code data-bind="text: code || '-'" class="small"></code>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">
                                <a href="#" data-bind="text: name, click: function() { $parent.openDetailModal($data); }, clickBubble: false" class="text-decoration-none"></a>
                            </h5>
                            <p class="card-text text-muted small" data-bind="text: description || '@Html.T("Project.NoDescription", "Açıklama yok")'"></p>
                            <div class="mb-3">
                                <!-- ko if: completionPercentage >= 0 -->
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <small class="text-muted">@Html.T("Project.Progress", "İlerleme")</small>
                                    <small class="fw-bold" data-bind="text: completionPercentage.toFixed(2) + '%'"></small>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar" data-bind="style: { width: completionPercentage + '%' }, css: completionPercentage >= 100 ? 'bg-success' : ''"></div>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: completionPercentage < 0 -->
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <small class="text-muted">@Html.T("Project.Progress", "İlerleme")</small>
                                    <small class="text-muted">-</small>
                                </div>
                                <!-- /ko -->
                                <div class="d-flex justify-content-between">
                                    <small class="text-muted" data-bind="visible: averageScore > 0"><i class="bi bi-star-fill text-warning"></i> <span data-bind="text: averageScore.toFixed(2)"></span></small>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-light">
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    <i class="bi bi-calendar-range"></i>
                                    <span data-bind="text: new Date(startDate).toLocaleDateString('tr-TR')"></span> -
                                    <span data-bind="text: new Date(endDate).toLocaleDateString('tr-TR')"></span>
                                </small>
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-info" data-bind="click: function() { $parent.openDetailModal($data); }, clickBubble: false" title="@Html.T("Common.Detail", "Detay")"><i class="bi bi-eye"></i></button>
                                    <button type="button" class="btn btn-outline-primary" data-bind="click: function() { $parent.openEditModal($data); }, clickBubble: false, visible: status !== 'Completed' && status !== 'Cancelled' && !isChecklistDeleted" title="@Html.T("Common.Edit", "Düzenle")"><i class="bi bi-pencil"></i></button>
                                    <button type="button" class="btn btn-outline-info btn-sm" data-bind="click: function() { $parent.reactivateProject($data); }, clickBubble: false, visible: status === 'Completed'" title="@Html.T("Project.Reactivate", "Yeniden Aktif Et")"><i class="bi bi-arrow-counterclockwise"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== CREATE/EDIT MODAL ==================== -->
    <div class="modal fade" data-bind="css: { show: isEditModalOpen }, style: { display: isEditModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <!-- ko ifnot: editingProject() && editingProject().id -->
                        <i class="bi bi-plus-circle me-2"></i>@Html.T("Project.CreateProject", "Yeni Proje Oluştur")
                        <!-- /ko -->
                        <!-- ko if: editingProject() && editingProject().id -->
                        <i class="bi bi-pencil me-2"></i>@Html.T("Project.EditProject", "Proje Düzenle")
                        <!-- /ko -->
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: closeEditModal"></button>
                </div>
                <div class="modal-body" data-bind="with: editingProject" style="max-height: 70vh; overflow-y: auto;">
                    <div class="row">
                        <!-- Left Column -->
                        <div class="col-lg-8">
                            <!-- Basic Info -->
                            <div class="card mb-3">
                                <div class="card-header py-2"><i class="bi bi-info-circle"></i> @Html.T("Project.BasicInfo", "Temel Bilgiler")</div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label">@Html.T("Common.Code", "Proje Kodu")</label>
                                            <div class="input-group">
                                                <input type="text" class="form-control" data-bind="value: code" placeholder="@Html.T("Project.Auto", "Otomatik")">
                                                <button type="button" class="btn btn-outline-secondary" data-bind="click: $parent.generateCode" title="@Html.T("Project.AutoCode", "Otomatik Kod")"><i class="bi bi-magic"></i></button>
                                            </div>
                                        </div>
                                        <div class="col-md-8 mb-3">
                                            <label class="form-label">@Html.T("Project.ProjectName", "Proje Adı") <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" data-bind="value: name" placeholder="@Html.T("Project.NamePlaceholder", "Örn: 2025 Q1 Gizli Müşteri Projesi")">
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">@Html.T("Project.Description", "Açıklama")</label>
                                        <textarea class="form-control" data-bind="value: description" rows="2" placeholder="@Html.T("Project.DescriptionPlaceholder", "Proje açıklaması...")"></textarea>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">
                                                @Html.T("Project.Type", "Proje Tipi") <span class="text-danger">*</span>
                                            </label>
                                            <!-- Sabit proje tipi varsa sadece görüntüle -->
                                            <!-- ko if: $root.pageProjectType -->
                                            <input type="text" class="form-control" readonly data-bind="value: $root.getProjectTypeText(projectType())">
                                            <!-- /ko -->
                                            <!-- Sabit proje tipi yoksa seçim yap -->
                                            <!-- ko ifnot: $root.pageProjectType -->
                                            <select class="form-select" data-bind="value: projectType">
                                                @foreach (var pt in SecretCustomer.Core.Enums.ProjectTypes.All.OrderBy(t => t.DisplayOrder))
                                                {
                                                    <option value="@pt.SystemName">@Html.T(pt.NameResourceKey, pt.Description)</option>
                                                }
                                            </select>
                                            <!-- /ko -->
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">@Html.T("Project.AssignmentType", "Atama Tipi") <span class="text-danger">*</span></label>
                                            <select class="form-select" data-bind="value: assignmentType">
                                                <option value="InternalBranch">@Html.T("Project.Assignment.InternalBranch", "Dahili Şube")</option>
                                                <option value="ExternalLocation">@Html.T("Project.Assignment.ExternalLocation", "Harici Lokasyon")</option>
                                                <option value="Phone">@Html.T("Project.Assignment.Phone", "Telefon")</option>
                                                <option value="Online">@Html.T("Meeting.Online", "Online")</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">@Html.T("Project.Checklist", "Kontrol Listesi") <span class="text-danger">*</span></label>
                                            <select class="form-select" data-bind="value: checklistId, options: $parent.filteredChecklists, optionsText: 'name', optionsValue: 'id', optionsCaption: '@Html.T("Common.Select", "Seçiniz...")'"></select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">@Html.T("Project.Customer", "Müşteri")</label>
                                            <select class="form-select" data-bind="value: customerId, options: $parent.customers, optionsText: 'companyName', optionsValue: 'id', optionsCaption: '@Html.T("Common.SelectOptional", "Seçiniz (Opsiyonel)...")'"></select>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">@Html.T("Project.Organization", "Organizasyon/Şube")</label>
                                            <select class="form-select" data-bind="value: organizationId, options: $parent.availableOrganizations, optionsText: 'name', optionsValue: 'id', optionsCaption: '@Html.T("Project.AllCompany", "Tüm Firma")', enable: customerId()"></select>
                                            <small class="text-muted">@Html.T("Project.OrganizationHint", "Seçilmezse proje tüm firmayı kapsar")</small>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">@Html.T("Project.ProjectManager", "Proje Yöneticisi")</label>
                                            <select class="form-select" data-bind="value: projectManagerId, options: $parent.users, optionsText: function(u) { return u.fullName + ' (' + u.email + ')'; }, optionsValue: 'id', optionsCaption: '@Html.T("Common.SelectOptional", "Seçiniz (Opsiyonel)...")'"></select>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">@Html.T("Project.StartDate", "Başlangıç Tarihi") <span class="text-danger">*</span></label>
                                            <input type="date" class="form-control" data-bind="value: startDate">
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">@Html.T("Project.EndDate", "Bitiş Tarihi") <span class="text-danger">*</span></label>
                                            <input type="date" class="form-control" data-bind="value: endDate">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Survey Settings (OnlineSurvey için) -->
                            <div class="card mb-3" data-bind="visible: projectType() === 'OnlineSurvey'">
                                <div class="card-header py-2 bg-success text-white"><i class="bi bi-clipboard-data"></i> @Html.T("Project.SurveySettings", "Anket Ayarları")</div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">@Html.T("Project.SurveyIdentityType", "Kimlik Tipi") <span class="text-danger">*</span></label>
                                            <select class="form-select" data-bind="value: surveyIdentityType">
                                                <option value="Anonymous">@Html.T("Project.SurveyIdentity.Anonymous", "Anonim (Kimlik Kapalı)")</option>
                                                <option value="Identified">@Html.T("Project.SurveyIdentity.Identified", "Kimlik Açık")</option>
                                            </select>
                                            <small class="text-muted">@Html.T("Project.SurveyIdentityHint", "Anonim: Katılımcı kimliği gizli, Açık: Katılımcı bilgileri görünür")</small>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">@Html.T("Project.EmailTemplate", "Davetiye Şablonu")</label>
                                            <select class="form-select" data-bind="value: emailTemplateId, options: $parent.emailTemplates, optionsText: 'name', optionsValue: 'id', optionsCaption: '@Html.T("Project.SelectTemplate", "Şablon Seçin...")'"></select>
                                            <small class="text-muted">@Html.T("Project.EmailTemplateHint", "Anket davetiyeleri için kullanılacak şablon")</small>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-4 mb-3">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="sendReminder" data-bind="checked: sendReminderEmails">
                                                <label class="form-check-label" for="sendReminder">@Html.T("Project.SendReminderEmails", "Hatırlatma Maili Gönder")</label>
                                            </div>
                                        </div>
                                        <div class="col-md-4 mb-3" data-bind="visible: sendReminderEmails()">
                                            <label class="form-label">@Html.T("Project.ReminderEmailTemplate", "Hatırlatma Şablonu")</label>
                                            <select class="form-select" data-bind="value: reminderEmailTemplateId, options: $parent.emailTemplates, optionsText: 'name', optionsValue: 'id', optionsCaption: '@Html.T("Project.SelectTemplate", "Şablon Seçin...")'"></select>
                                        </div>
                                        <div class="col-md-4 mb-3" data-bind="visible: sendReminderEmails()">
                                            <label class="form-label">@Html.T("Project.ReminderDays", "Hatırlatma (Gün Önce)")</label>
                                            <input type="number" class="form-control" data-bind="value: reminderDaysBeforeEnd" min="1" max="30" placeholder="3">
                                            <small class="text-muted">@Html.T("Project.ReminderDaysHint", "Bitiş tarihinden kaç gün önce")</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Other -->
                            <div class="card mb-3">
                                <div class="card-header py-2"><i class="bi bi-gear"></i> @Html.T("Project.OtherSettings", "Diğer Ayarlar")</div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label">@Html.T("Project.ReportingFrequency", "Raporlama Sıklığı (Gün)")</label>
                                            <input type="number" class="form-control" data-bind="value: reportingFrequencyDays" min="1">
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label">@Html.T("Project.MinScoreThreshold", "Min. Puan Eşiği (%)")</label>
                                            <input type="number" class="form-control" data-bind="value: minimumScoreThreshold" min="0" max="100">
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <label class="form-label">@Html.T("Call.Priority", "Öncelik")</label>
                                            <select class="form-select" data-bind="value: priority">
                                                <option value="">@Html.T("Priority.Normal", "Normal")</option>
                                                <option value="Low">@Html.T("Priority.Low", "Düşük")</option>
                                                <option value="Medium">@Html.T("Project.Priority.Medium", "Orta")</option>
                                                <option value="High">@Html.T("Priority.High", "Yüksek")</option>
                                                <option value="Critical">@Html.T("Project.Priority.Critical", "Kritik")</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label">@Html.T("Project.Tags", "Etiketler")</label>
                                            <input type="text" class="form-control" data-bind="value: tags" placeholder="@Html.T("Project.TagsPlaceholder", "Virgülle ayırın")">
                                        </div>
                                        <div class="col-md-6 mb-3 d-flex align-items-end">
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" data-bind="checked: autoGenerateReports" id="autoReports">
                                                <label class="form-check-label" for="autoReports">@Html.T("Project.AutoGenerateReports", "Otomatik Rapor Oluştur")</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">@Html.T("Project.Notes", "Notlar")</label>
                                        <textarea class="form-control" data-bind="value: notes" rows="2"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Right Column -->
                        <div class="col-lg-4">
                            <!-- Team Members -->
                            <div class="card mb-3">
                                <div class="card-header py-2 d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-people"></i> @Html.T("Project.TeamMembers", "Takım Üyeleri")</span>
                                    <button type="button" class="btn btn-sm btn-outline-primary" data-bind="click: $parent.addTeamMember"><i class="bi bi-plus"></i></button>
                                </div>
                                <div class="card-body p-0" style="max-height: 200px; overflow-y: auto;">
                                    <div data-bind="visible: teamMembers().length === 0" class="text-center py-3 text-muted">
                                        <i class="bi bi-person-plus"></i> @Html.T("Project.AddTeamMember", "Takım üyesi ekleyin")
                                    </div>
                                    <ul class="list-group list-group-flush" data-bind="foreach: teamMembers">
                                        <li class="list-group-item d-flex align-items-center gap-2 py-2">
                                            <select class="form-select form-select-sm flex-grow-1" data-bind="value: userId, options: $parents[1].users, optionsText: 'fullName', optionsValue: 'id', optionsCaption: '@Html.T("Project.User", "Kullanıcı...")'"></select>
                                            <select class="form-select form-select-sm" style="width: 110px;" data-bind="value: role">
                                                <option value="Evaluator">@Html.T("User.Evaluator", "Değerlendirici")</option>
                                                <option value="Manager">@Html.T("Project.Role.Manager", "Yönetici")</option>
                                                <option value="Observer">@Html.T("Project.Role.Observer", "Gözlemci")</option>
                                            </select>
                                            <button type="button" class="btn btn-sm btn-outline-danger" data-bind="click: $parents[1].removeTeamMember"><i class="bi bi-x"></i></button>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeEditModal">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-primary" data-bind="click: saveProject, disable: isSaving">
                        <span data-bind="visible: !isSaving()"><i class="bi bi-check-circle me-2"></i>@Html.T("Common.Save", "Kaydet")</span>
                        <span data-bind="visible: isSaving"><span class="spinner-border spinner-border-sm me-2"></span>@Html.T("Common.Saving", "Kaydediliyor...")</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isEditModalOpen }, style: { display: isEditModalOpen() ? 'block' : 'none' }"></div>

    <!-- ==================== DETAIL MODAL ==================== -->
    <div class="modal fade" data-bind="css: { show: isDetailModalOpen }, style: { display: isDetailModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content" data-bind="with: viewingProject">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-kanban me-2"></i>
                        <span data-bind="text: name"></span>
                        <span class="badge ms-2" data-bind="text: $parent.getStatusText(status), css: $parent.getStatusBadge(status)"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: $parent.closeDetailModal"></button>
                </div>
                <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                    <!-- Checklist Silinmiş Uyarısı -->
                    <!-- ko if: isChecklistDeleted -->
                    <div class="alert alert-danger mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Html.T("Project.ChecklistDeletedWarning", "Bu projenin kontrol listesi silinmiş. Yalnızca silme işlemi yapılabilir.")
                    </div>
                    <!-- /ko -->
                    <!-- Summary Cards -->
                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="card bg-primary text-white">
                                <div class="card-body py-2 text-center">
                                    <!-- ko if: completionPercentage >= 0 -->
                                    <h4 class="mb-0" data-bind="text: completionPercentage.toFixed(2) + '%'"></h4>
                                    <small>@Html.T("Project.Progress", "İlerleme")</small>
                                    <div class="progress mt-1" style="height: 4px;"><div class="progress-bar bg-light" data-bind="style: { width: completionPercentage + '%' }"></div></div>
                                    <!-- /ko -->
                                    <!-- ko if: completionPercentage < 0 -->
                                    <h4 class="mb-0">-</h4>
                                    <small>@Html.T("Project.Progress", "İlerleme")</small>
                                    <!-- /ko -->
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3" data-bind="visible: completionPercentage >= 0">
                            <div class="card bg-success text-white">
                                <div class="card-body py-2 text-center">
                                    <h4 class="mb-0"><span data-bind="text: completedAssignments"></span>/<span data-bind="text: totalAssignments"></span></h4>
                                    <small>@Html.T("Status.Completed", "Tamamlanan")</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-info text-white">
                                <div class="card-body py-2 text-center">
                                    <h4 class="mb-0" data-bind="text: averageScore.toFixed(2)"></h4>
                                    <small>@Html.T("Dealer.AverageScore", "Ortalama Puan")</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card" data-bind="css: totalRedCards > 0 ? 'bg-danger text-white' : totalYellowCards > 0 ? 'bg-warning' : 'bg-light'">
                                <div class="card-body py-2 text-center">
                                    <h4 class="mb-0"><span data-bind="text: totalYellowCards"></span> <i class="bi bi-card-fill text-warning"></i> <span data-bind="text: totalRedCards"></span> <i class="bi bi-card-fill text-danger"></i></h4>
                                    <small>@Html.T("Project.PenaltyCards", "Ceza Kartları")</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <!-- Left Column -->
                        <div class="col-lg-8">
                            <!-- Project Info -->
                            <div class="card mb-3">
                                <div class="card-header py-2"><i class="bi bi-info-circle"></i> @Html.T("Project.ProjectInfo", "Proje Bilgileri")</div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <table class="table table-sm table-borderless mb-0">
                                                <tr><td class="text-muted" style="width:40%;">@Html.T("Project.ProjectCode", "Proje Kodu"):</td><td><code data-bind="text: code || '-'"></code></td></tr>
                                                <tr><td class="text-muted">@Html.T("Project.ProjectType", "Proje Tipi"):</td><td><span class="badge" data-bind="text: $parent.getProjectTypeText(projectType), css: $parent.getProjectTypeBadge(projectType)"></span></td></tr>
                                                <tr><td class="text-muted">Kontrol Listesi:</td><td><span data-bind="text: checklistName"></span><!-- ko if: isChecklistDeleted --> <span class="badge bg-danger">@Html.T("Project.ChecklistDeleted", "Silinmiş")</span><!-- /ko --></td></tr>
                                                <tr><td class="text-muted">@Html.T("Common.Customer", "Müşteri"):</td><td><!-- ko if: customerName --><span data-bind="text: customerName"></span><!-- ko if: customerCode --> (<code data-bind="text: customerCode"></code>)<!-- /ko --><!-- /ko --><!-- ko ifnot: customerName -->-<!-- /ko --></td></tr>
                                                <tr><td class="text-muted">@Html.T("Project.ProjectManager", "Proje Yöneticisi"):</td><td data-bind="text: projectManagerName || '-'"></td></tr>
                                            </table>
                                        </div>
                                        <div class="col-md-6">
                                            <table class="table table-sm table-borderless mb-0">
                                                <tr><td class="text-muted" style="width:40%;">@Html.T("Project.StartDate", "Başlangıç"):</td><td data-bind="text: $parent.formatDate(startDate)"></td></tr>
                                                <tr><td class="text-muted">@Html.T("Project.EndDate", "Bitiş"):</td><td data-bind="text: $parent.formatDate(endDate)"></td></tr>
                                                <tr><td class="text-muted">@Html.T("Call.Priority", "Öncelik"):</td><td data-bind="text: priority || 'Normal'"></td></tr>
                                                <tr><td class="text-muted">@Html.T("Common.CreatedAt", "Oluşturulma"):</td><td data-bind="text: $parent.formatDate(createdAt)"></td></tr>
                                            </table>
                                        </div>
                                    </div>
                                    <!-- ko if: description -->
                                    <hr class="my-2">
                                    <p class="text-muted mb-0 small" data-bind="text: description"></p>
                                    <!-- /ko -->
                                </div>
                            </div>
                            <!-- Project Files -->
                            <div class="card mb-3">
                                <div class="card-header py-2 d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-paperclip"></i> @Html.T("Project.Files", "Proje Dosyaları") <span class="badge bg-secondary" data-bind="text: $parent.projectFiles().length"></span></span>
                                    <label class="btn btn-sm btn-outline-primary mb-0" data-bind="visible: $parent.canManageFiles()">
                                        <i class="bi bi-upload"></i> @Html.T("Meeting.UploadFile", "Dosya Yükle")
                                        <input type="file" class="d-none" data-bind="event: { change: function(d, e) { $parent.uploadFile(e); } }" multiple>
                                    </label>
                                </div>
                                <div class="card-body p-0" style="max-height: 250px; overflow-y: auto;">
                                    <div data-bind="visible: $parent.isUploadingFile()" class="text-center py-3">
                                        <div class="spinner-border spinner-border-sm text-primary"></div>
                                        <span class="ms-2">@Html.T("Project.Uploading", "Yükleniyor...")</span>
                                    </div>
                                    <div data-bind="visible: $parent.projectFiles().length === 0 && !$parent.isUploadingFile()" class="text-center py-3 text-muted">
                                        <i class="bi bi-folder2-open"></i> @Html.T("Project.NoFiles", "Henüz dosya eklenmemiş")
                                    </div>
                                    <ul class="list-group list-group-flush" data-bind="foreach: $parent.projectFiles">
                                        <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                            <div class="flex-grow-1">
                                                <div class="d-flex align-items-center">
                                                    <i class="bi me-2" data-bind="css: $parents[1].getFileIcon(contentType)"></i>
                                                    <div>
                                                        <a href="#" data-bind="text: originalFileName, click: function() { $parents[1].downloadFile($data); }" class="text-decoration-none fw-medium"></a>
                                                        <br>
                                                        <small class="text-muted">
                                                            <span data-bind="text: fileSizeDisplay"></span> |
                                                            <span data-bind="text: $parents[1].formatDate(uploadedAt)"></span>
                                                            <!-- ko if: uploadedByName --> | <span data-bind="text: uploadedByName"></span><!-- /ko -->
                                                        </small>
                                                        <!-- ko if: description -->
                                                        <br><small class="text-muted fst-italic" data-bind="text: description"></small>
                                                        <!-- /ko -->
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="btn-group btn-group-sm" data-bind="visible: $parents[1].canManageFiles()">
                                                <button type="button" class="btn btn-outline-primary" data-bind="click: function() { $parents[1].downloadFile($data); }" title="@Html.T("Common.Download", "İndir")">
                                                    <i class="bi bi-download"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-danger" data-bind="click: function() { $parents[1].deleteFile($data); }" title="@Html.T("Common.Delete", "Sil")">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <!-- Right Column -->
                        <div class="col-lg-4">
                            <!-- Survey Actions (OnlineSurvey için) -->
                            <div class="card mb-3 border-success" data-bind="visible: projectType === 'OnlineSurvey'">
                                <div class="card-header py-2 bg-success text-white"><i class="bi bi-envelope-paper"></i> @Html.T("Project.SurveyActions", "Anket İşlemleri")</div>
                                <div class="card-body">
                                    <div class="d-grid gap-2">
                                        <button type="button" class="btn btn-success btn-sm" data-bind="click: function() { $parent.openSurveyModal($data); }">
                                            <i class="bi bi-send"></i> @Html.T("Project.SendInvitations", "Davetiye Gönder")
                                        </button>
                                        <button type="button" class="btn btn-outline-primary btn-sm" data-bind="click: function() { $parent.exportSurveyLinks($data); }">
                                            <i class="bi bi-file-earmark-excel"></i> @Html.T("Project.ExportSurveyLinks", "Linkleri İndir (Excel)")
                                        </button>
                                    </div>
                                    <!-- ko if: surveyIdentityType -->
                                    <div class="mt-2 small text-muted">
                                        <i class="bi bi-info-circle"></i>
                                        @Html.T("Project.Identity", "Kimlik"): <span data-bind="text: surveyIdentityType === 'Anonymous' ? '@Html.T("Project.SurveyIdentity.Anonymous", "Anonim")' : '@Html.T("Project.SurveyIdentity.Open", "Açık")'"></span>
                                        <!-- ko if: emailTemplateName -->
                                        | @Html.T("Project.Template", "Şablon"): <span data-bind="text: emailTemplateName"></span>
                                        <!-- /ko -->
                                    </div>
                                    <!-- /ko -->
                                </div>
                            </div>
                            <!-- Status Actions -->
                            <div class="card mb-3" data-bind="visible: status !== 'Cancelled' && !isChecklistDeleted">
                                <div class="card-header py-2"><i class="bi bi-toggles"></i> @Html.T("Project.StatusActions", "Durum İşlemleri")</div>
                                <div class="card-body">
                                    <div class="d-grid gap-2">
                                        <button type="button" class="btn btn-success btn-sm" data-bind="click: function() { $parent.startProject($data); }, visible: status === 'Draft' || status === 'Planned' || status === 'Paused'"><i class="bi bi-play-fill"></i> @Html.T("Common.Start", "Başlat")</button>
                                        <button type="button" class="btn btn-warning btn-sm" data-bind="click: function() { $parent.pauseProject($data); }, visible: status === 'Active'"><i class="bi bi-pause-fill"></i> @Html.T("Project.Pause", "Duraklat")</button>
                                        <button type="button" class="btn btn-primary btn-sm" data-bind="click: function() { $parent.completeProject($data); }, visible: status === 'Active'"><i class="bi bi-check-lg"></i> @Html.T("Common.Complete", "Tamamla")</button>
                                        <button type="button" class="btn btn-success btn-sm" data-bind="click: function() { $parent.reactivateProject($data); }, visible: status === 'Completed'"><i class="bi bi-arrow-counterclockwise"></i> @Html.T("Project.Reactivate", "Yeniden Aktif Et")</button>
                                        <button type="button" class="btn btn-outline-danger btn-sm" data-bind="click: function() { $parent.cancelProject($data); }, visible: status !== 'Completed'"><i class="bi bi-x-lg"></i> @Html.T("Project.Cancel", "İptal Et")</button>
                                        <button type="button" class="btn btn-danger btn-sm" data-bind="click: function() { $parent.deleteProject($data); }, visible: status === 'Completed'"><i class="bi bi-trash"></i> @Html.T("Common.Delete", "Sil")</button>
                                    </div>
                                </div>
                            </div>
                            <!-- Team -->
                            <div class="card mb-3">
                                <div class="card-header py-2"><i class="bi bi-people"></i> @Html.T("Project.Team", "Takım") <span class="badge bg-secondary" data-bind="text: teamMembers ? teamMembers.length : 0"></span></div>
                                <div class="card-body p-0" style="max-height: 200px; overflow-y: auto;">
                                    <ul class="list-group list-group-flush" data-bind="foreach: teamMembers, visible: teamMembers && teamMembers.length > 0">
                                        <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                            <div><i class="bi bi-person-circle me-1"></i><span data-bind="text: userName"></span><br><small class="text-muted" data-bind="text: email"></small></div>
                                            <div class="text-end"><span class="badge bg-secondary" data-bind="text: $parents[1].getRoleText(role)"></span><br><small class="text-muted" data-bind="text: completedEvaluations + ' @Html.T("Project.Eval", "değ.")'"></small></div>
                                        </li>
                                    </ul>
                                    <div data-bind="visible: !teamMembers || teamMembers.length === 0" class="text-center py-3 text-muted">@Html.T("Project.NoTeamMember", "Takım üyesi yok")</div>
                                </div>
                            </div>
                            <!-- Quick Info -->
                            <div class="card mb-3">
                                <div class="card-header py-2"><i class="bi bi-info-square"></i> @Html.T("Project.QuickInfo", "Hızlı Bilgi")</div>
                                <ul class="list-group list-group-flush small">
                                    <li class="list-group-item d-flex justify-content-between py-1"><span>@Html.T("Project.MinScoreThreshold", "Min. Puan Eşiği")</span><span data-bind="text: minimumScoreThreshold ? minimumScoreThreshold + '%' : '-'"></span></li>
                                    <li class="list-group-item d-flex justify-content-between py-1"><span>@Html.T("Project.Reporting", "Raporlama")</span><span data-bind="text: reportingFrequencyDays ? reportingFrequencyDays + ' @Html.T("Common.DaySuffix", "gün")' : '-'"></span></li>
                                    <li class="list-group-item d-flex justify-content-between py-1"><span>@Html.T("Project.AutoReport", "Otomatik Rapor")</span><span data-bind="text: autoGenerateReports ? '@Html.T("Common.Yes", "Evet")' : '@Html.T("Common.No", "Hayır")'"></span></li>
                                    <!-- ko if: tags --><li class="list-group-item py-1"><span class="text-muted">Etiketler:</span> <span data-bind="text: tags"></span></li><!-- /ko -->
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-primary" data-bind="click: function() { $parent.openEditModal($data); }, visible: status !== 'Completed' && status !== 'Cancelled' && !isChecklistDeleted">
                        <i class="bi bi-pencil"></i> @Html.T("Common.Edit", "Düzenle")
                    </button>
                    <button type="button" class="btn btn-outline-success" data-bind="click: function() { $parent.reactivateProject($data); }, visible: status === 'Completed'">
                        <i class="bi bi-arrow-counterclockwise"></i> @Html.T("Project.Reactivate", "Yeniden Aktif Et")
                    </button>
                    <button type="button" class="btn btn-outline-danger" data-bind="click: function() { $parent.deleteProject($data); }, visible: status === 'Completed'">
                        <i class="bi bi-trash"></i> @Html.T("Common.Delete", "Sil")
                    </button>
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closeDetailModal">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Close", "Kapat")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isDetailModalOpen }, style: { display: isDetailModalOpen() ? 'block' : 'none' }"></div>

    <partial name="_DeleteConfirmationModal" />

    <!-- ==================== SURVEY INVITATION MODAL ==================== -->
    <div class="modal fade" data-bind="css: { show: isSurveyModalOpen }, style: { display: isSurveyModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-envelope-paper me-2"></i>@Html.T("Project.SendSurveyInvitations", "Anket Davetiyesi Gönder")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bind="click: closeSurveyModal"></button>
                </div>
                <div class="modal-body">
                    <!-- Project Info -->
                    <div class="alert alert-info mb-3" data-bind="with: surveyProject">
                        <strong><i class="bi bi-clipboard-data"></i> <span data-bind="text: name"></span></strong><br>
                        <small>
                            <span data-bind="text: customerName || '@Html.T("Project.NoCustomer", "Müşteri belirtilmedi")'"></span>
                            <!-- ko if: organizationName --> | <span data-bind="text: organizationName"></span><!-- /ko -->
                        </small>
                    </div>

                    <!-- Tab Navigation -->
                    <ul class="nav nav-tabs mb-3">
                        <li class="nav-item">
                            <a class="nav-link" href="#" data-bind="css: { active: surveyTabMode() === 'personnel' }, click: function() { surveyTabMode('personnel'); }">
                                <i class="bi bi-people me-1"></i> @Html.T("Project.PersonnelInvitations", "Personel Davetiyeleri")
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#" data-bind="css: { active: surveyTabMode() === 'external' }, click: function() { surveyTabMode('external'); }">
                                <i class="bi bi-envelope-at me-1"></i> @Html.T("Project.ExternalInvitations", "Dış Katılımcılar")
                            </a>
                        </li>
                    </ul>

                    <!-- ========== PERSONNEL TAB ========== -->
                    <div data-bind="visible: surveyTabMode() === 'personnel'">
                        <!-- Personnel Preview Loading -->
                        <div data-bind="visible: isSurveyLoading()" class="text-center py-3">
                            <div class="spinner-border spinner-border-sm text-primary"></div>
                            <span class="ms-2">@Html.T("Project.LoadingPersonnel", "Personel listesi yükleniyor...")</span>
                        </div>

                        <!-- Personnel Stats -->
                        <div data-bind="visible: !isSurveyLoading() && surveyPersonnelStats()" class="row mb-3">
                            <div class="col-md-4">
                                <div class="card bg-primary text-white text-center py-2">
                                    <h4 class="mb-0" data-bind="text: surveyPersonnelStats() ? surveyPersonnelStats().totalCount : 0"></h4>
                                    <small>@Html.T("Project.TotalPersonnel", "Toplam Personel")</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-success text-white text-center py-2">
                                    <h4 class="mb-0" data-bind="text: surveyPersonnelStats() ? surveyPersonnelStats().withEmail : 0"></h4>
                                    <small>@Html.T("Project.WithEmail", "Email Var")</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-warning text-center py-2">
                                    <h4 class="mb-0" data-bind="text: surveyPersonnelStats() ? surveyPersonnelStats().withoutEmail : 0"></h4>
                                    <small>@Html.T("Project.WithoutEmail", "Email Yok")</small>
                                </div>
                            </div>
                        </div>

                        <!-- Survey Settings Info -->
                        <div class="mb-3" data-bind="with: surveyProject">
                            <div class="card bg-light">
                                <div class="card-body py-2">
                                    <div class="row small">
                                        <div class="col-md-6">
                                            <i class="bi bi-envelope me-1"></i> <strong>@Html.T("Project.EmailTemplate", "Email Şablonu"):</strong>
                                            <span data-bind="text: emailTemplateName || '@Html.T("Common.NotSpecified", "Belirtilmemiş")'" class="ms-1"></span>
                                            <!-- ko ifnot: emailTemplateName -->
                                            <span class="text-danger">@Html.T("Project.SelectFromSettings", "(Proje ayarlarından seçin)")</span>
                                            <!-- /ko -->
                                        </div>
                                        <div class="col-md-6">
                                            <i class="bi bi-person-badge me-1"></i> <strong>@Html.T("Project.Identity", "Kimlik"):</strong>
                                            <span data-bind="text: surveyIdentityType === 'Anonymous' ? '@Html.T("Project.SurveyIdentity.Anonymous", "Anonim")' : '@Html.T("Project.SurveyIdentity.Open", "Açık")'" class="ms-1"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Invitation Stats (if any invitations sent before) -->
                        <div data-bind="visible: invitationStats() && invitationStats().total > 0" class="mb-3">
                            <h6 class="text-muted"><i class="bi bi-bar-chart"></i> @Html.T("Project.InvitationStats", "Davetiye İstatistikleri")</h6>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="card text-center py-2 bg-success text-white">
                                        <h5 class="mb-0" data-bind="text: invitationStats() ? invitationStats().sent : 0"></h5>
                                        <small>@Html.T("Project.Sent", "Gönderildi")</small>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="card text-center py-2 bg-danger text-white">
                                        <h5 class="mb-0" data-bind="text: invitationStats() ? invitationStats().failed : 0"></h5>
                                        <small>@Html.T("Project.Failed", "Gönderilemedi")</small>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="card text-center py-2 bg-info text-white">
                                        <h5 class="mb-0" data-bind="text: invitationStats() ? invitationStats().opened : 0"></h5>
                                        <small>@Html.T("Project.Opened", "Açıldı")</small>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="card text-center py-2 bg-primary text-white">
                                        <h5 class="mb-0" data-bind="text: invitationStats() ? invitationStats().completed : 0"></h5>
                                        <small>@Html.T("Status.Completed", "Tamamlandı")</small>
                                    </div>
                                </div>
                            </div>
                            <!-- Retry Failed Button -->
                            <div class="mt-2 text-end" data-bind="visible: invitationStats() && invitationStats().failed > 0">
                                <button type="button" class="btn btn-warning btn-sm" data-bind="click: retryFailedInvitations, disable: isRetrying">
                                    <span data-bind="visible: !isRetrying()"><i class="bi bi-arrow-repeat"></i> @Html.T("Project.RetryFailed", "Başarısızları Tekrar Gönder")</span>
                                    <span data-bind="visible: isRetrying"><span class="spinner-border spinner-border-sm me-1"></span>@Html.T("Project.Retrying", "Gönderiliyor...")</span>
                                </button>
                            </div>
                        </div>

                        <!-- Send Result -->
                        <div data-bind="visible: surveyResult()" class="mt-3">
                            <div class="alert" data-bind="css: surveyResult() && surveyResult().success ? 'alert-success' : 'alert-danger'">
                                <strong data-bind="text: surveyResult() ? surveyResult().message : ''"></strong>
                                <!-- ko if: surveyResult() && surveyResult().errors && surveyResult().errors.length > 0 -->
                                <hr>
                                <small>
                                    <strong>@Html.T("Import.Errors", "Hatalar"):</strong>
                                    <ul class="mb-0" data-bind="foreach: surveyResult().errors">
                                        <li data-bind="text: $data"></li>
                                    </ul>
                                </small>
                                <!-- /ko -->
                            </div>
                        </div>

                        <!-- Personnel Send Button -->
                        <div class="text-end mt-3">
                            <button type="button" class="btn btn-success" data-bind="click: sendSurveyInvitations, disable: isSurveySending() || (surveyPersonnelStats() && surveyPersonnelStats().withEmail === 0)">
                                <span data-bind="visible: !isSurveySending()"><i class="bi bi-send me-2"></i>@Html.T("Project.SendInvitations", "Davetiye Gönder")</span>
                                <span data-bind="visible: isSurveySending"><span class="spinner-border spinner-border-sm me-2"></span>@Html.T("Project.Sending", "Gönderiliyor...")</span>
                            </button>
                        </div>
                    </div>

                    <!-- ========== EXTERNAL TAB ========== -->
                    <div data-bind="visible: surveyTabMode() === 'external'">
                        <!-- External Email Input -->
                        <div class="mb-3">
                            <label class="form-label">
                                <i class="bi bi-envelope-at me-1"></i> @Html.T("Project.ExternalEmailList", "Email Listesi")
                            </label>
                            <textarea class="form-control" rows="6"
                                placeholder="@Html.T("Project.ExternalEmailPlaceholder", "Her satıra bir email adresi yazın. Opsiyonel ad-soyad için noktalı virgül kullanın:\nemail@example.com\nemail2@example.com; Ahmet Yılmaz\nemail3@example.com, email4@example.com")"
                                data-bind="value: externalEmails"></textarea>
                            <small class="text-muted">
                                @Html.T("Project.ExternalEmailHelp", "Virgül, boşluk veya satır sonu ile ayırın. Ad-soyad eklemek için: email@x.com; Ad Soyad")
                            </small>
                        </div>

                        <!-- Email Template (from project settings - read only) -->
                        <div class="mb-3">
                            <label class="form-label">@Html.T("Project.EmailTemplate", "Email Şablonu")</label>
                            <div class="form-control bg-light" data-bind="text: surveyProject() && surveyProject().emailTemplateName ? surveyProject().emailTemplateName : '@Html.T("Project.NoTemplateSelected", "Şablon seçilmemiş")'"></div>
                            <small class="text-muted">@Html.T("Project.TemplateFromSettings", "Proje ayarlarından gelen şablon kullanılır")</small>
                        </div>

                        <!-- External Invitation Stats -->
                        <div data-bind="visible: externalInvitationStats() && externalInvitationStats().total > 0" class="mb-3">
                            <h6 class="text-muted"><i class="bi bi-bar-chart"></i> @Html.T("Project.ExternalStats", "Dış Davetiye İstatistikleri")</h6>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="card text-center py-2 bg-success text-white">
                                        <h5 class="mb-0" data-bind="text: externalInvitationStats() ? externalInvitationStats().sent : 0"></h5>
                                        <small>@Html.T("Project.Sent", "Gönderildi")</small>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="card text-center py-2 bg-danger text-white">
                                        <h5 class="mb-0" data-bind="text: externalInvitationStats() ? externalInvitationStats().failed : 0"></h5>
                                        <small>@Html.T("Project.Failed", "Gönderilemedi")</small>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="card text-center py-2 bg-info text-white">
                                        <h5 class="mb-0" data-bind="text: externalInvitationStats() ? externalInvitationStats().opened : 0"></h5>
                                        <small>@Html.T("Project.Opened", "Açıldı")</small>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="card text-center py-2 bg-primary text-white">
                                        <h5 class="mb-0" data-bind="text: externalInvitationStats() ? externalInvitationStats().completed : 0"></h5>
                                        <small>@Html.T("Status.Completed", "Tamamlandı")</small>
                                    </div>
                                </div>
                            </div>
                            <!-- Retry Failed Button -->
                            <div class="mt-2 text-end" data-bind="visible: externalInvitationStats() && externalInvitationStats().failed > 0">
                                <button type="button" class="btn btn-warning btn-sm" data-bind="click: retryExternalFailed, disable: isExternalRetrying">
                                    <span data-bind="visible: !isExternalRetrying()"><i class="bi bi-arrow-repeat"></i> @Html.T("Project.RetryFailed", "Başarısızları Tekrar Gönder")</span>
                                    <span data-bind="visible: isExternalRetrying"><span class="spinner-border spinner-border-sm me-1"></span>@Html.T("Project.Retrying", "Gönderiliyor...")</span>
                                </button>
                            </div>
                            <!-- Send Reminder Section -->
                            <div class="mt-3 p-3 border rounded bg-light" data-bind="visible: externalInvitationStats() && externalInvitationStats().sent > 0">
                                <h6 class="text-muted mb-2"><i class="bi bi-bell"></i> @Html.T("Project.SendReminder", "Hatırlatma Gönder")</h6>
                                <div class="row align-items-end">
                                    <div class="col-md-6">
                                        <label class="form-label small">@Html.T("Project.ReminderFilter", "Filtre")</label>
                                        <select class="form-select form-select-sm" data-bind="value: externalReminderFilter">
                                            <option value="notCompleted">@Html.T("Project.NotCompleted", "Tamamlanmayanlar")</option>
                                            <option value="completed">@Html.T("Status.Completed", "Tamamlananlar")</option>
                                            <option value="all">@Html.T("Common.All", "Tümü")</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6 text-end">
                                        <button type="button" class="btn btn-info btn-sm" data-bind="click: sendExternalReminders, disable: isExternalSendingReminder">
                                            <span data-bind="visible: !isExternalSendingReminder()"><i class="bi bi-bell me-1"></i> @Html.T("Project.SendReminder", "Hatırlatma Gönder")</span>
                                            <span data-bind="visible: isExternalSendingReminder"><span class="spinner-border spinner-border-sm me-1"></span>@Html.T("Project.SendingReminder", "Gönderiliyor...")</span>
                                        </button>
                                    </div>
                                </div>
                                <small class="text-muted mt-2 d-block" data-bind="visible: externalReminderFilter() === 'notCompleted'">
                                    <i class="bi bi-info-circle"></i> @Html.T("Project.ReminderNotCompletedInfo", "Henüz anketi tamamlamamış kişilere hatırlatma gönderilecek.")
                                </small>
                                <small class="text-muted mt-2 d-block" data-bind="visible: externalReminderFilter() === 'completed'">
                                    <i class="bi bi-info-circle"></i> @Html.T("Project.ReminderCompletedInfo", "Anketi tamamlamış kişilere hatırlatma gönderilecek.")
                                </small>
                                <small class="text-muted mt-2 d-block" data-bind="visible: externalReminderFilter() === 'all'">
                                    <i class="bi bi-info-circle"></i> @Html.T("Project.ReminderAllInfo", "Tüm davetiye gönderilmiş kişilere hatırlatma gönderilecek.")
                                </small>
                            </div>
                        </div>

                        <!-- External Invitations List -->
                        <div data-bind="visible: externalInvitations().length > 0" class="mb-3">
                            <h6 class="text-muted">
                                <i class="bi bi-list-check"></i> @Html.T("Project.SentInvitations", "Gönderilen Davetiyeler")
                                <span class="badge bg-secondary ms-1" data-bind="text: externalInvitations().length"></span>
                            </h6>
                            <div style="max-height: 200px; overflow-y: auto; overflow-x: auto;">
                                <table class="table table-sm table-hover mb-0">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th>Email</th>
                                            <th>@Html.T("Common.Name", "Ad")</th>
                                            <th class="text-center">@Html.T("Common.Status", "Durum")</th>
                                            <th class="text-center">@Html.T("Project.Opened", "Açıldı")</th>
                                            <th class="text-center">@Html.T("Status.Completed", "Tamamlandı")</th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: externalInvitations">
                                        <tr>
                                            <td><small data-bind="text: email"></small></td>
                                            <td><small data-bind="text: fullName || '-'"></small></td>
                                            <td class="text-center">
                                                <span class="badge" data-bind="text: $parent.getExternalStatusText(status), css: $parent.getExternalStatusBadge(status)"></span>
                                            </td>
                                            <td class="text-center">
                                                <!-- ko if: isOpened -->
                                                <i class="bi bi-check-circle text-success"></i>
                                                <!-- /ko -->
                                                <!-- ko ifnot: isOpened -->
                                                <i class="bi bi-dash text-muted"></i>
                                                <!-- /ko -->
                                            </td>
                                            <td class="text-center">
                                                <!-- ko if: isCompleted -->
                                                <i class="bi bi-check-circle-fill text-success"></i>
                                                <!-- /ko -->
                                                <!-- ko ifnot: isCompleted -->
                                                <i class="bi bi-dash text-muted"></i>
                                                <!-- /ko -->
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- External Send Result -->
                        <div data-bind="visible: externalSendResult()" class="mt-3">
                            <div class="alert" data-bind="css: externalSendResult() && externalSendResult().success ? 'alert-success' : 'alert-danger'">
                                <strong data-bind="text: externalSendResult() ? externalSendResult().message : ''"></strong>
                                <!-- ko if: externalSendResult() && externalSendResult().errors && externalSendResult().errors.length > 0 -->
                                <hr>
                                <small>
                                    <strong>@Html.T("Import.Errors", "Hatalar"):</strong>
                                    <ul class="mb-0" data-bind="foreach: externalSendResult().errors">
                                        <li data-bind="text: $data"></li>
                                    </ul>
                                </small>
                                <!-- /ko -->
                            </div>
                        </div>

                        <!-- File Upload Section -->
                        <hr class="my-3">
                        <div class="mb-3">
                            <label class="form-label">
                                <i class="bi bi-file-earmark-spreadsheet me-1"></i> @Html.T("Project.UploadEmailList", "Dosyadan Email Listesi Yükle")
                            </label>
                            <div class="input-group">
                                <input type="file" class="form-control" id="externalEmailFile" accept=".csv,.xlsx,.xls">
                                <button type="button" class="btn btn-primary" data-bind="click: uploadExternalEmails, disable: isExternalUploading">
                                    <span data-bind="visible: !isExternalUploading()"><i class="bi bi-upload"></i> @Html.T("Project.Upload", "Yükle")</span>
                                    <span data-bind="visible: isExternalUploading"><span class="spinner-border spinner-border-sm"></span></span>
                                </button>
                            </div>
                            <small class="text-muted">
                                @Html.T("Project.UploadEmailHelp", "CSV veya Excel dosyası yükleyin. Kolonlar: Email (zorunlu), Ad, Soyad")
                                <br>
                                <a href="#" data-bind="click: function() { downloadExternalEmailTemplate('csv'); }">
                                    <i class="bi bi-download"></i> @Html.T("Project.DownloadCsvTemplate", "CSV Şablon")
                                </a>
                                &nbsp;|&nbsp;
                                <a href="#" data-bind="click: function() { downloadExternalEmailTemplate('xlsx'); }">
                                    <i class="bi bi-download"></i> @Html.T("Project.DownloadExcelTemplate", "Excel Şablon")
                                </a>
                            </small>
                        </div>

                        <!-- Upload Result -->
                        <div data-bind="visible: externalUploadResult()" class="mb-3">
                            <div class="alert" data-bind="css: externalUploadResult() && externalUploadResult().success ? 'alert-success' : 'alert-danger'">
                                <strong data-bind="text: externalUploadResult() ? externalUploadResult().message : ''"></strong>
                                <!-- ko if: externalUploadResult() && externalUploadResult().success -->
                                <div class="mt-2">
                                    <small>
                                        <i class="bi bi-info-circle"></i>
                                        @Html.T("Project.UploadSummary", "Toplam"): <span data-bind="text: externalUploadResult().totalEmails"></span>,
                                        @Html.T("Project.Added", "Eklenen"): <span data-bind="text: externalUploadResult().addedCount"></span>,
                                        @Html.T("Project.Sent", "Gönderilen"): <span data-bind="text: externalUploadResult().successCount"></span>,
                                        @Html.T("Project.Duplicate", "Mükerrer"): <span data-bind="text: externalUploadResult().duplicateCount"></span>
                                    </small>
                                </div>
                                <!-- /ko -->
                                <!-- ko if: externalUploadResult() && externalUploadResult().errors && externalUploadResult().errors.length > 0 -->
                                <hr>
                                <small>
                                    <strong>@Html.T("Import.Errors", "Hatalar"):</strong>
                                    <ul class="mb-0" data-bind="foreach: externalUploadResult().errors">
                                        <li data-bind="text: $data"></li>
                                    </ul>
                                </small>
                                <!-- /ko -->
                            </div>
                        </div>

                        <!-- External Send Button -->
                        <div class="text-end mt-3">
                            <button type="button" class="btn btn-success" data-bind="click: sendExternalInvitations, disable: isExternalSending() || !externalEmails()">
                                <span data-bind="visible: !isExternalSending()"><i class="bi bi-send me-2"></i>@Html.T("Project.SendExternal", "Dış Davetiye Gönder")</span>
                                <span data-bind="visible: isExternalSending"><span class="spinner-border spinner-border-sm me-2"></span>@Html.T("Project.Sending", "Gönderiliyor...")</span>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeSurveyModal">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Close", "Kapat")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isSurveyModalOpen }, style: { display: isSurveyModalOpen() ? 'block' : 'none' }"></div>

</div>

@section Scripts {
    <script>
        window.pageConfig = {
            projectTypeId: @(ViewBag.ProjectTypeId != null ? ViewBag.ProjectTypeId.ToString() : "null")
        };
    </script>
    <script src="~/js/Shared/enums.service.js" asp-append-version="true"></script>
    <script src="~/js/Shared/delete-confirmation.js" asp-append-version="true"></script>
    <script src="~/js/Projects/Index.js" asp-append-version="true"></script>
}
