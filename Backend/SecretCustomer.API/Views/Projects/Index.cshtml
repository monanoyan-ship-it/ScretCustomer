@{
    ViewData["Title"] = "Projeler";
}

<div id="projects-app">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Projeler</h2>
        <div>
            <div class="form-check form-switch d-inline-block me-3">
                <input class="form-check-input" type="checkbox" data-bind="checked: includeInactive, click: loadProjects" id="includeInactive">
                <label class="form-check-label" for="includeInactive">
                    Kapalı Projeleri Göster
                </label>
            </div>
            <button class="btn btn-primary" data-bind="click: createNew">
                <i class="bi bi-plus-circle"></i> Yeni Proje
            </button>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>

    <!-- Messages -->
    <div data-bind="visible: successMessage" class="alert alert-success alert-dismissible fade show">
        <span data-bind="text: successMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { successMessage(''); }"></button>
    </div>

    <div data-bind="visible: errorMessage" class="alert alert-danger alert-dismissible fade show">
        <span data-bind="text: errorMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { errorMessage(''); }"></button>
    </div>

    <!-- Projects Grid -->
    <div class="row" data-bind="visible: !isLoading()">
        <!-- Empty State -->
        <div class="col-12" data-bind="visible: projects().length === 0">
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Henüz proje bulunmamaktadır.
            </div>
        </div>

        <!-- Project Cards -->
        <div class="col-md-6 col-lg-4 mb-4" data-bind="foreach: projects">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="card-title" data-bind="text: name"></h5>
                        <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? 'Aktif' : 'Kapalı'"></span>
                    </div>

                    <p class="card-text text-muted small" data-bind="text: description || 'Açıklama yok'"></p>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted">İlerleme</small>
                            <small class="text-muted">
                                <span data-bind="text: completedAssignments || 0"></span> / <span data-bind="text: totalAssignments || 0"></span>
                            </small>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar" role="progressbar" data-bind="style: { width: completionPercentage() + '%' }"></div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted">
                            <i class="bi bi-list-check"></i> <span data-bind="text: checklistName || 'N/A'"></span><br>
                            <i class="bi bi-calendar-range"></i>
                            <span data-bind="text: new Date(startDate).toLocaleDateString('tr-TR')"></span> -
                            <span data-bind="text: new Date(endDate).toLocaleDateString('tr-TR')"></span>
                        </small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bind="click: $parent.editProject, visible: isActive">
                            <i class="bi bi-pencil"></i> Düzenle
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deleteProject">
                            <i class="bi bi-trash"></i> Sil
                        </button>
                    </div>
                </div>
                <div class="card-footer bg-light">
                    <small class="text-muted">
                        <i class="bi bi-clock"></i> Oluşturulma: <span data-bind="text: new Date(createdAt).toLocaleDateString('tr-TR')"></span>
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- Create/Edit Modal -->
    <div class="modal fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" data-bind="with: editingProject">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <span data-bind="visible: !id">Yeni Proje</span>
                        <span data-bind="visible: id">Proje Düzenle</span>
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: $parent.closeModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Proje Adı *</label>
                        <input type="text" class="form-control" data-bind="value: name" placeholder="Örn: 2025 Q1 Gizli Müşteri Projesi" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Açıklama</label>
                        <textarea class="form-control" data-bind="value: description" rows="3" placeholder="Proje hakkında açıklama..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Kontrol Listesi *</label>
                        <select class="form-select" data-bind="value: checklistId, options: $parent.availableChecklists, optionsValue: 'id', optionsText: 'name', optionsCaption: 'Seçiniz...'"></select>
                        <small class="text-muted">Bu projede kullanılacak değerlendirme formu</small>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Başlangıç Tarihi *</label>
                            <input type="date" class="form-control" data-bind="value: startDate" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Bitiş Tarihi *</label>
                            <input type="date" class="form-control" data-bind="value: endDate" />
                        </div>
                    </div>

                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" data-bind="checked: isActive" id="projectIsActive" />
                        <label class="form-check-label" for="projectIsActive">Aktif</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closeModal">İptal</button>
                    <button type="button" class="btn btn-primary" data-bind="click: $parent.saveProject, disable: $parent.isSaving">
                        <span data-bind="visible: !$parent.isSaving()">
                            <i class="bi bi-save"></i> Kaydet
                        </span>
                        <span data-bind="visible: $parent.isSaving">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            Kaydediliyor...
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }"></div>

</div> <!-- End of projects-app -->

@section Scripts {
    <script src="~/js/Projects/Index.js"></script>
}
