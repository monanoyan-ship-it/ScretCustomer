@model AssignmentCreateViewModel
@{
    ViewData["Title"] = "Yeni Atama Oluştur";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<div class="card shadow">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="ProjectId" class="form-label">Proje *</label>
                <select asp-for="ProjectId" class="form-select">
                    <option value="">Seçiniz...</option>
                    @foreach (var project in Model.AvailableProjects)
                    {
                        <option value="@project.Id">@project.Name</option>
                    }
                </select>
                <span asp-validation-for="ProjectId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BranchId" class="form-label">Şube *</label>
                <select asp-for="BranchId" class="form-select">
                    <option value="">Seçiniz...</option>
                    @foreach (var branch in Model.AvailableBranches)
                    {
                        <option value="@branch.Id">@branch.Name</option>
                    }
                </select>
                <span asp-validation-for="BranchId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ChecklistId" class="form-label">Kontrol Listesi *</label>
                <select asp-for="ChecklistId" class="form-select">
                    <option value="">Seçiniz...</option>
                    @foreach (var checklist in Model.AvailableChecklists)
                    {
                        <option value="@checklist.Id">@checklist.Name</option>
                    }
                </select>
                <span asp-validation-for="ChecklistId" class="text-danger"></span>
            </div>


            <div class="mb-3">
                <label asp-for="AssignedUserId" class="form-label">Değerlendirici</label>
                <select asp-for="AssignedUserId" class="form-select">
                    <option value="">Seçiniz...</option>
                    @foreach (var evaluator in Model.AvailableEvaluators)
                    {
                        <option value="@evaluator.Id">@evaluator.FullName</option>
                    }
                </select>
                <span asp-validation-for="AssignedUserId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DueDate" class="form-label">Deadline *</label>
                <input asp-for="DueDate" type="date" class="form-control" />
                <span asp-validation-for="DueDate" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Oluştur
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> İptal
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
