@{
    ViewData["Title"] = "Atamalar";
}

<div id="assignments-app">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Atamalar</h2>
        <button class="btn btn-primary" data-bind="click: createNew">
            <i class="bi bi-plus-circle"></i> Yeni Atama
        </button>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>

    <!-- Messages -->
    <div data-bind="visible: successMessage" class="alert alert-success alert-dismissible fade show">
        <span data-bind="text: successMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { successMessage(''); }"></button>
    </div>

    <div data-bind="visible: errorMessage" class="alert alert-danger alert-dismissible fade show">
        <span data-bind="text: errorMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { errorMessage(''); }"></button>
    </div>

    <!-- Assignments -->
    <div data-bind="visible: !isLoading()">
        <!-- Empty State -->
        <div data-bind="visible: assignments().length === 0" class="alert alert-info">
            <i class="bi bi-info-circle"></i> Henüz atama bulunmamaktadır.
        </div>

        <!-- Assignments Table -->
        <div data-bind="visible: assignments().length > 0" class="card shadow">
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Proje</th>
                            <th>Kontrol Listesi</th>
                            <th>Şube</th>
                            <th>Atanan</th>
                            <th>Son Tarih</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: assignments">
                        <tr>
                            <td data-bind="text: projectName"></td>
                            <td data-bind="text: checklistName"></td>
                            <td data-bind="text: branchName || 'N/A'"></td>
                            <td>
                                <span data-bind="visible: assignedUserName, text: assignedUserName"></span>
                                <span data-bind="visible: externalEmail">
                                    <i class="bi bi-envelope"></i> <span data-bind="text: externalEmail"></span>
                                </span>
                            </td>
                            <td data-bind="text: dueDate ? new Date(dueDate).toLocaleDateString('tr-TR') : 'Yok'"></td>
                            <td>
                                <span class="badge" data-bind="css: isCompleted ? 'bg-success' : 'bg-warning', text: isCompleted ? 'Tamamlandı' : 'Bekliyor'"></span>
                            </td>
                            <td>
                                <button type="button" class="btn btn-sm btn-primary" data-bind="click: $parent.openEvaluation, visible: !isCompleted">
                                    <i class="bi bi-pencil-square"></i> Değerlendir
                                </button>
                                <button type="button" class="btn btn-sm btn-danger" data-bind="click: $parent.deleteAssignment">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Create Modal -->
    <div class="modal fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" data-bind="with: editingAssignment">
                <div class="modal-header">
                    <h5 class="modal-title">Yeni Atama Oluştur</h5>
                    <button type="button" class="btn-close" data-bind="click: $parent.closeModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Proje *</label>
                        <select class="form-select" data-bind="value: projectId, options: $parent.availableProjects, optionsValue: 'id', optionsText: 'name', optionsCaption: 'Seçiniz...'"></select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Şube *</label>
                        <select class="form-select" data-bind="value: branchId, options: $parent.availableBranches, optionsValue: 'id', optionsText: 'name', optionsCaption: 'Seçiniz...'"></select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Kontrol Listesi *</label>
                        <select class="form-select" data-bind="value: checklistId, options: $parent.availableChecklists, optionsValue: 'id', optionsText: 'name', optionsCaption: 'Seçiniz...'"></select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Değerlendirici</label>
                        <select class="form-select" data-bind="value: assignedUserId, options: $parent.availableEvaluators, optionsValue: 'id', optionsText: 'fullName', optionsCaption: 'Seçiniz (İsteğe bağlı)...'"></select>
                        <small class="text-muted">Boş bırakılırsa harici değerlendirici için link oluşturulur</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Son Tarih *</label>
                        <input type="date" class="form-control" data-bind="value: dueDate" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closeModal">İptal</button>
                    <button type="button" class="btn btn-primary" data-bind="click: $parent.saveAssignment, disable: $parent.isSaving">
                        <span data-bind="visible: !$parent.isSaving()">
                            <i class="bi bi-save"></i> Oluştur
                        </span>
                        <span data-bind="visible: $parent.isSaving">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            Oluşturuluyor...
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }"></div>

    <!-- Evaluation Modal -->
    <div class="modal fade" id="evaluationModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Değerlendirme Formu</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div data-bind="with: $root.selectedEvaluation">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Proje:</strong> <span data-bind="text: projectName"></span>
                            </div>
                            <div class="col-md-6">
                                <strong>Şube:</strong> <span data-bind="text: branchName || 'Belirtilmemiş'"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Kontrol Listesi:</strong> <span data-bind="text: checklistName"></span>
                            </div>
                            <div class="col-md-6">
                                <strong>Durum:</strong> 
                                <span class="badge" data-bind="css: isCompleted ? 'bg-success' : 'bg-warning', text: isCompleted ? 'Tamamlandı' : 'Bekliyor'"></span>
                            </div>
                        </div>
                        <hr>
                        <p class="text-muted">Değerlendirme formu detayları burada gösterilecek.</p>
                    </div>
                    <div data-bind="ifnot: $root.selectedEvaluation" class="text-center py-4">
                        <div class="spinner-border text-primary"></div>
                        <p class="mt-2">Yükleniyor...</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                    <button type="button" class="btn btn-primary" data-bind="visible: $root.selectedEvaluation && $root.selectedEvaluation() && !$root.selectedEvaluation().isCompleted">
                        <i class="bi bi-check-circle"></i> Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>

    <partial name="_DeleteConfirmationModal" />

</div> <!-- End of assignments-app -->

@section Scripts {
    <script src="~/js/Shared/delete-confirmation.js"></script>
    <script src="~/js/Assignments/Index.js"></script>
}
