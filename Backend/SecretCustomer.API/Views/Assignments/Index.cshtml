@{
    ViewData["Title"] = Html.T("Assignment.Title", "Atamalar").ToString();
}

<style>
    /* Dropdown menünün container tarafından kesilmesini önle */
    #assignments-app .card,
    #assignments-app .card-body,
    #assignments-app .table-responsive {
        overflow: visible !important;
    }
    /* Dropdown menüyü sabit pozisyonla (viewport'a göre) */
    #assignments-app .dropdown-menu {
        position: absolute;
        z-index: 1050;
    }
    /* Son satırlardaki dropdown'ların yukarı açılması */
    #assignments-app tbody tr:nth-last-child(-n+3) .dropdown-menu {
        top: auto !important;
        bottom: 100% !important;
        transform: none !important;
    }
</style>

<div id="assignments-app">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-clipboard-check"></i> @Html.T("Assignment.Title", "Atamalar")</h2>
        <button class="btn btn-primary" data-bind="click: createNew">
            <i class="bi bi-plus-circle"></i> @Html.T("Assignment.New", "Yeni Atama")
        </button>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4" data-bind="with: summary">
        <div class="col-md-2 col-sm-4 col-6 mb-2">
            <div class="card bg-primary text-white h-100">
                <div class="card-body py-2 px-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0 small">@Html.T("Common.Total", "Toplam")</h6>
                            <h4 class="mb-0" data-bind="text: totalAssignments"></h4>
                        </div>
                        <i class="bi bi-clipboard-data fs-3 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6 mb-2">
            <div class="card bg-warning text-dark h-100">
                <div class="card-body py-2 px-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0 small">@Html.T("Status.Pending", "Bekleyen")</h6>
                            <h4 class="mb-0" data-bind="text: pendingCount"></h4>
                        </div>
                        <i class="bi bi-hourglass-split fs-3 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6 mb-2">
            <div class="card bg-info text-white h-100">
                <div class="card-body py-2 px-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0 small">@Html.T("Status.InProgress", "Devam Eden")</h6>
                            <h4 class="mb-0" data-bind="text: inProgressCount"></h4>
                        </div>
                        <i class="bi bi-play-circle fs-3 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6 mb-2">
            <div class="card bg-success text-white h-100">
                <div class="card-body py-2 px-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0 small">@Html.T("Status.Completed", "Tamamlanan")</h6>
                            <h4 class="mb-0" data-bind="text: completedCount"></h4>
                        </div>
                        <i class="bi bi-check-circle fs-3 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6 mb-2">
            <div class="card bg-danger text-white h-100">
                <div class="card-body py-2 px-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0 small">@Html.T("Status.Expired", "Süresi Dolan")</h6>
                            <h4 class="mb-0" data-bind="text: expiredCount"></h4>
                        </div>
                        <i class="bi bi-exclamation-triangle fs-3 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6 mb-2">
            <div class="card bg-secondary text-white h-100">
                <div class="card-body py-2 px-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0 small">@Html.T("Common.AverageScore", "Ort. Puan")</h6>
                            <h4 class="mb-0" data-bind="text: averageScore ? averageScore.toFixed(1) + '%' : '-'"></h4>
                        </div>
                        <i class="bi bi-bar-chart fs-3 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body py-2">
            <!-- Filter Add Row -->
            <div class="row g-2 align-items-end">
                <!-- Filter Type Select -->
                <div class="col-md-2">
                    <label class="form-label small text-muted">@Html.T("Common.FilterType", "Filtre Tipi")</label>
                    <select class="form-select form-select-sm" data-bind="value: selectedFilterType">
                        <option value="">@Html.T("Common.SelectFilter", "Filtre Seçin...")</option>
                        <option value="project">@Html.T("Project.Title", "Proje")</option>
                        <option value="status">@Html.T("Common.Status", "Durum")</option>
                        <option value="assignedUser">@Html.T("Assignment.AssignedPerson", "Atanan Kişi")</option>
                        <option value="dateRange">@Html.T("Common.DateRange", "Tarih Aralığı")</option>
                        <option value="search">@Html.T("Common.Search", "Arama")</option>
                    </select>
                </div>

                <!-- Dynamic Filter Input -->
                <div class="col-md-8">
                    <!-- Project Filter -->
                    <div data-bind="visible: selectedFilterType() === 'project'">
                        <label class="form-label small text-muted">@Html.T("Project.Title", "Proje")</label>
                        <select class="form-select form-select-sm" data-bind="value: tempFilter.projectId, options: availableProjects, optionsValue: 'id', optionsText: 'name', optionsCaption: '@Html.T("Common.Select", "Seçiniz...")'"></select>
                    </div>

                    <!-- Status Filter -->
                    <div data-bind="visible: selectedFilterType() === 'status'">
                        <label class="form-label small text-muted">@Html.T("Common.Status", "Durum")</label>
                        <select class="form-select form-select-sm" data-bind="value: tempFilter.status">
                            <option value="">@Html.T("Common.Select", "Seçiniz...")</option>
                            <option value="Pending">@Html.T("Status.Pending", "Bekleyen")</option>
                            <option value="InProgress">@Html.T("Status.InProgress", "Devam Eden")</option>
                            <option value="Completed">@Html.T("Status.Completed", "Tamamlanan")</option>
                            <option value="Expired">@Html.T("Status.Expired", "Süresi Dolan")</option>
                            <option value="Cancelled">@Html.T("Status.Cancelled", "İptal Edilen")</option>
                        </select>
                    </div>

                    <!-- Assigned User Filter -->
                    <div data-bind="visible: selectedFilterType() === 'assignedUser'">
                        <label class="form-label small text-muted">@Html.T("Assignment.AssignedPerson", "Atanan Kişi")</label>
                        <select class="form-select form-select-sm" data-bind="value: tempFilter.assignedUserId, options: allAssignableUsers, optionsValue: 'id', optionsText: 'displayName', optionsCaption: '@Html.T("Common.Select", "Seçiniz...")'"></select>
                    </div>

                    <!-- Date Range Filter -->
                    <div data-bind="visible: selectedFilterType() === 'dateRange'">
                        <label class="form-label small text-muted">@Html.T("Common.DateRange", "Tarih Aralığı")</label>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.startDate" placeholder="Başlangıç">
                            </div>
                            <div class="col-md-4">
                                <input type="date" class="form-control form-control-sm" data-bind="value: tempFilter.endDate" placeholder="Bitiş">
                            </div>
                            <div class="col-md-4">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle w-100" type="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-calendar-range"></i> @Html.T("Common.QuickSelect", "Hızlı Seçim")
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('today'); }">@Html.T("Common.Today", "Bugün")</a></li>
                                        <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('yesterday'); }">@Html.T("Common.Yesterday", "Dün")</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('thisWeek'); }">@Html.T("Common.ThisWeek", "Bu Hafta")</a></li>
                                        <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('lastWeek'); }">@Html.T("Common.LastWeek", "Geçen Hafta")</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('thisMonth'); }">@Html.T("Common.ThisMonth", "Bu Ay")</a></li>
                                        <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('lastMonth'); }">@Html.T("Common.LastMonth", "Geçen Ay")</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('last7Days'); }">@Html.T("Common.Last7Days", "Son 7 Gün")</a></li>
                                        <li><a class="dropdown-item" href="#" data-bind="click: function() { setTempDateRange('last30Days'); }">@Html.T("Common.Last30Days", "Son 30 Gün")</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Search Filter -->
                    <div data-bind="visible: selectedFilterType() === 'search'">
                        <label class="form-label small text-muted">@Html.T("Common.SearchTerm", "Arama Terimi")</label>
                        <input type="text" class="form-control form-control-sm" placeholder="@Html.T("Assignment.SearchPlaceholder", "Proje, kişi, not...")" data-bind="value: tempFilter.searchTerm, valueUpdate: 'input'">
                    </div>

                    <!-- No filter selected message -->
                    <div data-bind="visible: !selectedFilterType()" class="text-muted small pt-4">
                        <i class="bi bi-info-circle"></i> @Html.T("Common.SelectFilterToAdd", "Eklemek için bir filtre tipi seçin")
                    </div>
                </div>

                <!-- Add Filter Button -->
                <div class="col-md-2">
                    <button type="button" class="btn btn-sm btn-primary w-100" data-bind="click: addFilter, enable: canAddFilter">
                        <i class="bi bi-plus-circle"></i> @Html.T("Common.AddFilter", "Filtre Ekle")
                    </button>
                </div>
            </div>

            <!-- Active Filters (Chips) - ALTTA -->
            <div class="mt-3" data-bind="visible: activeFilters().length > 0">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="text-muted small">@Html.T("Common.ActiveFilters", "Aktif Filtreler"):</span>
                    <!-- ko foreach: activeFilters -->
                    <span class="badge bg-primary d-flex align-items-center gap-1" style="font-size: 0.9em;">
                        <span data-bind="text: label"></span>: <span data-bind="text: displayValue"></span>
                        <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.6em;" data-bind="click: $parent.removeFilter"></button>
                    </span>
                    <!-- /ko -->
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bind="click: clearFilters">
                        <i class="bi bi-x-circle"></i> @Html.T("Common.ClearAll", "Temizle")
                    </button>
                    <div class="flex-grow-1"></div>
                    <span class="text-muted small" data-bind="text: totalCount() + ' kayıt'"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Yükleniyor...")</p>
    </div>

    <!-- Assignments -->
    <div data-bind="visible: !isLoading()">
        <!-- Empty State -->
        <div data-bind="visible: allAssignments().length === 0" class="alert alert-info">
            <i class="bi bi-info-circle"></i> @Html.T("Assignment.NoRecords", "Henüz atama bulunmamaktadır veya filtrelere uygun sonuç yoktur.")
        </div>

        <!-- Assignments Table -->
        <div data-bind="visible: allAssignments().length > 0" class="card shadow">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="sortable" data-bind="click: function() { sorting.toggleSort('projectName'); }, css: sorting.getSortClass('projectName')">
                                    @Html.T("Project.Title", "Proje")
                                    <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('projectName')"></i>
                                </th>
                                <th class="sortable" data-bind="click: function() { sorting.toggleSort('checklistName'); }, css: sorting.getSortClass('checklistName')">
                                    @Html.T("Checklist.Title", "Kontrol Listesi")
                                    <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('checklistName')"></i>
                                </th>
                                <th class="sortable" data-bind="click: function() { sorting.toggleSort('assigneeName'); }, css: sorting.getSortClass('assigneeName')">
                                    @Html.T("Assignment.Assignee", "Atanan")
                                    <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('assigneeName')"></i>
                                </th>
                                <th class="sortable" data-bind="click: function() { sorting.toggleSort('dueDate'); }, css: sorting.getSortClass('dueDate')">
                                    @Html.T("Common.DueDate", "Son Tarih")
                                    <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('dueDate')"></i>
                                </th>
                                <th class="sortable" data-bind="click: function() { sorting.toggleSort('status'); }, css: sorting.getSortClass('status')">
                                    @Html.T("Common.Status", "Durum")
                                    <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('status')"></i>
                                </th>
                                <th class="sortable" data-bind="click: function() { sorting.toggleSort('score'); }, css: sorting.getSortClass('score')">
                                    @Html.T("Common.Score", "Puan")
                                    <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('score')"></i>
                                </th>
                                <th class="text-center">@Html.T("Common.Actions", "İşlemler")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: assignments">
                            <tr data-bind="css: { 'table-danger': status === 'Expired', 'table-warning': status === 'Cancelled' }">
                                <td>
                                    <span data-bind="text: projectName"></span>
                                    <small class="text-muted d-block" data-bind="text: projectCode"></small>
                                </td>
                                <td data-bind="text: checklistName"></td>
                                <td>
                                    <span data-bind="text: assigneeName"></span>
                                    <small class="text-muted d-block" data-bind="text: $parent.getAssigneeTypeText(assigneeType)"></small>
                                </td>
                                <td>
                                    <span data-bind="text: dueDate ? new Date(dueDate).toLocaleDateString('tr-TR') : '-'"></span>
                                    <small class="d-block" data-bind="visible: daysRemaining !== undefined, text: $parent.getDaysRemainingText(daysRemaining), css: { 'text-danger': daysRemaining < 0, 'text-warning': daysRemaining >= 0 && daysRemaining <= 3, 'text-muted': daysRemaining > 3 }"></small>
                                </td>
                                <td>
                                    <span class="badge" data-bind="css: $parent.getStatusBadgeClass(status), text: $parent.getStatusText(status)"></span>
                                </td>
                                <td>
                                    <span data-bind="visible: evaluationScore !== null && evaluationScore !== undefined">
                                        <span data-bind="text: evaluationScore ? evaluationScore.toFixed(1) + '%' : '-'"></span>
                                        <span data-bind="visible: yellowCardCount > 0 || redCardCount > 0" class="ms-1">
                                            <span data-bind="visible: yellowCardCount > 0" class="badge bg-warning text-dark" title="@Html.T("Card.Yellow", "Sarı Kart")">
                                                <i class="bi bi-card-text"></i> <span data-bind="text: yellowCardCount"></span>
                                            </span>
                                            <span data-bind="visible: redCardCount > 0" class="badge bg-danger" title="@Html.T("Card.Red", "Kırmızı Kart")">
                                                <i class="bi bi-card-text"></i> <span data-bind="text: redCardCount"></span>
                                            </span>
                                        </span>
                                    </span>
                                    <span data-bind="visible: evaluationScore === null || evaluationScore === undefined" class="text-muted">-</span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <!-- Detail Button -->
                                        <button type="button" class="btn btn-outline-info"
                                                data-bind="click: $parent.showDetail"
                                                title="@Html.T("Button.Detail", "Detay")">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <!-- QR Code Button -->
                                        <button type="button" class="btn btn-outline-secondary"
                                                data-bind="click: $parent.showQRCode"
                                                title="@Html.T("Button.QRCode", "QR Kod")">
                                            <i class="bi bi-qr-code"></i>
                                        </button>
                                        <!-- More Actions Dropdown -->
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" title="@Html.T("Button.More", "Daha Fazla")">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li data-bind="visible: status !== 'Completed' && status !== 'Cancelled'">
                                                    <a class="dropdown-item" href="#" data-bind="click: $parent.openReassignModal">
                                                        <i class="bi bi-person-fill-gear"></i> @Html.T("Assignment.Reassign", "Yeniden Ata")
                                                    </a>
                                                </li>
                                                <li data-bind="visible: status !== 'Completed' && status !== 'Cancelled'">
                                                    <a class="dropdown-item" href="#" data-bind="click: $parent.openUpdateDueDateModal">
                                                        <i class="bi bi-calendar-event"></i> @Html.T("Assignment.UpdateDueDate", "Tarihi Güncelle")
                                                    </a>
                                                </li>
                                                <li data-bind="visible: status !== 'Completed' && status !== 'Cancelled'">
                                                    <a class="dropdown-item text-warning" href="#" data-bind="click: $parent.cancelAssignment">
                                                        <i class="bi bi-x-circle"></i> @Html.T("Button.Cancel", "İptal Et")
                                                    </a>
                                                </li>
                                                <li data-bind="visible: status === 'Completed'">
                                                    <a class="dropdown-item text-info" href="#" data-bind="click: $parent.reopenAssignment">
                                                        <i class="bi bi-arrow-counterclockwise"></i> @Html.T("Button.Reopen", "Yeniden Aç")
                                                    </a>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item" href="#" data-bind="click: $parent.copyLink">
                                                        <i class="bi bi-link-45deg"></i> @Html.T("Button.CopyLink", "Link Kopyala")
                                                    </a>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item text-danger" href="#" data-bind="click: $parent.deleteAssignment">
                                                        <i class="bi bi-trash"></i> @Html.T("Button.Delete", "Sil")
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- Pagination -->
            <div class="card-footer d-flex justify-content-between align-items-center" data-bind="visible: totalPages() > 1">
                <div class="text-muted small">
                    <span data-bind="text: ((currentPage() - 1) * parseInt(pageSize(), 10) + 1) + '-' + Math.min(currentPage() * parseInt(pageSize(), 10), totalCount()) + ' / ' + totalCount()"></span>
                    @Html.T("Common.Records", "kayıt")
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item" data-bind="css: { disabled: currentPage() === 1 }">
                            <a class="page-link" href="#" data-bind="click: previousPage"><i class="bi bi-chevron-left"></i></a>
                        </li>
                        <!-- ko foreach: ko.utils.range(1, totalPages()) -->
                        <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }, visible: $data === 1 || $data === $parent.totalPages() || Math.abs($data - $parent.currentPage()) <= 2">
                            <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                        </li>
                        <!-- /ko -->
                        <li class="page-item" data-bind="css: { disabled: currentPage() === totalPages() }">
                            <a class="page-link" href="#" data-bind="click: nextPage"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                </nav>
                <select class="form-select form-select-sm" style="width: auto;" data-bind="value: pageSize">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Create/Edit Modal -->
    <div class="modal fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" data-bind="with: editingAssignment">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-clipboard-plus"></i>
                        <span data-bind="text: $parent.getModalTitle()"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: $parent.closeModal"></button>
                </div>
                <div class="modal-body">
                    <!-- Project Picker -->
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Project.Title", "Proje") <span class="text-danger">*</span></label>

                        <!-- Selected Project Display -->
                        <div data-bind="visible: $parent.selectedProjectForDisplay()" class="card bg-light mb-2">
                            <div class="card-body py-2 px-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong data-bind="text: $parent.selectedProjectForDisplay()?.name"></strong>
                                        <span class="text-muted ms-2" data-bind="text: $parent.selectedProjectForDisplay()?.code"></span>
                                        <div class="small text-muted">
                                            <span data-bind="text: $parent.selectedProjectForDisplay()?.customerName"></span>
                                            <span data-bind="visible: $parent.selectedProjectForDisplay()?.organizationName">
                                                / <span data-bind="text: $parent.selectedProjectForDisplay()?.organizationName"></span>
                                            </span>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bind="click: $parent.clearSelectedProject">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Project Picker Button -->
                        <div data-bind="visible: !$parent.selectedProjectForDisplay()">
                            <button type="button" class="btn btn-outline-secondary w-100 text-start" data-bind="click: $parent.toggleProjectPicker">
                                <i class="bi bi-folder2-open me-2"></i>@Html.T("Assignment.ChooseProject", "Proje Seçiniz...")
                            </button>
                        </div>

                        <!-- Project Picker Dropdown -->
                        <div data-bind="visible: $parent.isProjectPickerOpen()" class="card mt-2 shadow">
                            <div class="card-header py-2">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                                    <input type="text" class="form-control" placeholder="@Html.T("Assignment.SearchProject", "Proje, müşteri veya organizasyon ara...")"
                                           data-bind="value: $parent.projectPickerSearch, valueUpdate: 'afterkeydown'">
                                </div>
                            </div>
                            <div class="card-body p-0" style="max-height: 350px; overflow-y: auto;">
                                <table class="table table-hover table-sm mb-0">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th>@Html.T("Project.Title", "Proje")</th>
                                            <th>@Html.T("Customer.Title", "Müşteri")</th>
                                            <th>@Html.T("Organization.Title", "Organizasyon")</th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: $parent.filteredProjectsForPicker">
                                        <tr style="cursor: pointer;" data-bind="click: $root.selectProject">
                                            <td>
                                                <strong data-bind="text: name"></strong>
                                                <small class="text-muted d-block" data-bind="text: code"></small>
                                            </td>
                                            <td data-bind="text: customerName || '-'"></td>
                                            <td data-bind="text: organizationName || '-'"></td>
                                        </tr>
                                    </tbody>
                                </table>
                                <div class="text-center text-muted py-3" data-bind="visible: $parent.filteredProjectsForPicker().length === 0">
                                    <i class="bi bi-inbox"></i> @Html.T("Common.NoResults", "Sonuç bulunamadı")
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3" data-bind="visible: $parent.selectedProjectChecklistName()">
                        <label class="form-label">@Html.T("Checklist.Title", "Kontrol Listesi")</label>
                        <input type="text" class="form-control" readonly data-bind="value: $parent.selectedProjectChecklistName()">
                        <small class="text-muted">@Html.T("Assignment.ChecklistAutoFilled", "Kontrol listesi proje tanımından otomatik alınır")</small>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header">
                            <i class="bi bi-person"></i> @Html.T("Assignment.AssigneePerson", "Atanacak Kişi")
                        </div>
                        <div class="card-body">
                            <!-- Assignment Type Selection -->
                            <div class="mb-3">
                                <!-- Fiziksel Denetim için sadece FieldWorker -->
                                <div data-bind="visible: $parent.isPhysicalAuditProject()">
                                    <div class="alert alert-info py-2 mb-2">
                                        <i class="bi bi-info-circle me-1"></i>
                                        @Html.T("Assignment.PhysicalAuditInfo", "Fiziksel Denetim projeleri sadece Saha Çalışanlarına atanabilir.")
                                    </div>
                                    <div class="btn-group w-100" role="group">
                                        <input type="radio" class="btn-check" name="assignmentType" id="assignTypeFieldWorkerOnly" value="fieldworker" data-bind="checked: assignmentType">
                                        <label class="btn btn-outline-success" for="assignTypeFieldWorkerOnly">
                                            <i class="bi bi-person-walking me-1"></i>@Html.T("Role.FieldWorker", "Saha Çalışanı")
                                        </label>
                                    </div>
                                </div>

                                <!-- Diğer projeler için User ve External -->
                                <div data-bind="visible: !$parent.isPhysicalAuditProject()">
                                    <div class="btn-group w-100" role="group">
                                        <input type="radio" class="btn-check" name="assignmentType" id="assignTypeUser" value="user" data-bind="checked: assignmentType">
                                        <label class="btn btn-outline-primary" for="assignTypeUser">@Html.T("User.Title", "Kullanıcı")</label>

                                        <input type="radio" class="btn-check" name="assignmentType" id="assignTypeExternal" value="external" data-bind="checked: assignmentType">
                                        <label class="btn btn-outline-primary" for="assignTypeExternal">@Html.T("Assignment.External", "Harici")</label>
                                    </div>
                                </div>
                            </div>

                            <!-- User Selection -->
                            <div data-bind="visible: assignmentType() === 'user'">
                                <label class="form-label">@Html.T("User.Title", "Kullanıcı")</label>
                                <select class="form-select" data-bind="value: assignedUserId, options: $parent.filteredEvaluators, optionsValue: 'id', optionsText: 'fullName', optionsCaption: '@Html.T("Common.Select", "Seçiniz...")', enable: $parent.selectedProjectForDisplay()"></select>
                                <!-- ko ifnot: $parent.selectedProjectForDisplay() -->
                                <small class="text-muted">@Html.T("Assignment.SelectProjectFirst", "Önce proje seçiniz")</small>
                                <!-- /ko -->
                            </div>

                            <!-- Field Worker Selection -->
                            <div data-bind="visible: assignmentType() === 'fieldworker'">
                                <label class="form-label">@Html.T("Role.FieldWorker", "Saha Çalışanı")</label>
                                <select class="form-select" data-bind="value: assignedFieldWorkerId, options: $parent.filteredFieldWorkers, optionsValue: 'id', optionsText: 'fullName', optionsCaption: '@Html.T("Common.Select", "Seçiniz...")', enable: $parent.selectedProjectForDisplay()"></select>
                                <!-- ko ifnot: $parent.selectedProjectForDisplay() -->
                                <small class="text-muted">@Html.T("Assignment.SelectProjectFirst", "Önce proje seçiniz")</small>
                                <!-- /ko -->
                            </div>

                            <!-- External Email -->
                            <div data-bind="visible: assignmentType() === 'external'">
                                <div class="row">
                                    <div class="col-md-6">
                                        <label class="form-label">@Html.T("Common.Email", "E-posta")</label>
                                        <input type="email" class="form-control" placeholder="ornek@email.com" data-bind="value: externalEmail">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">@Html.T("Common.FullName", "Ad Soyad")</label>
                                        <input type="text" class="form-control" placeholder="@Html.T("Common.FullNamePlaceholder", "Adı Soyadı")" data-bind="value: externalName">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">@Html.T("Common.DueDate", "Son Tarih") <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" data-bind="value: dueDate">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">@Html.T("Common.Notes", "Notlar")</label>
                                <textarea class="form-control" rows="2" placeholder="@Html.T("Common.OptionalNotes", "İsteğe bağlı notlar...")" data-bind="value: notes"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closeModal">
                        <i class="bi bi-x"></i> @Html.T("Button.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-primary" data-bind="click: $parent.saveAssignment, disable: $parent.isSaving">
                        <span data-bind="visible: !$parent.isSaving()">
                            <i class="bi bi-save"></i> <span data-bind="text: $parent.getSaveButtonText()"></span>
                        </span>
                        <span data-bind="visible: $parent.isSaving">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            @Html.T("Common.Saving", "Kaydediliyor...")
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }"></div>

    <!-- Reassign Modal -->
    <div class="modal fade" id="reassignModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-fill-gear"></i> @Html.T("Assignment.Reassign", "Yeniden Ata")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" data-bind="with: reassignData">
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Assignment.NewAssigneeType", "Yeni Atanan Kişi Türü")</label>
                        <select class="form-select" data-bind="value: newAssigneeType">
                            <option value="user">@Html.T("User.Title", "Kullanıcı")</option>
                            <option value="fieldworker">@Html.T("Role.FieldWorker", "Saha Çalışanı")</option>
                            <option value="external">@Html.T("Assignment.External", "Harici")</option>
                        </select>
                    </div>
                    <div data-bind="visible: newAssigneeType() === 'user'" class="mb-3">
                        <label class="form-label">@Html.T("User.Title", "Kullanıcı")</label>
                        <select class="form-select" data-bind="value: newAssignedUserId, options: $parent.availableEvaluators, optionsValue: 'id', optionsText: 'fullName', optionsCaption: '@Html.T("Common.Select", "Seçiniz...")'"></select>
                    </div>
                    <div data-bind="visible: newAssigneeType() === 'fieldworker'" class="mb-3">
                        <label class="form-label">@Html.T("Role.FieldWorker", "Saha Çalışanı")</label>
                        <select class="form-select" data-bind="value: newAssignedFieldWorkerId, options: $parent.availableFieldWorkers, optionsValue: 'id', optionsText: 'fullName', optionsCaption: '@Html.T("Common.Select", "Seçiniz...")'"></select>
                    </div>
                    <div data-bind="visible: newAssigneeType() === 'external'">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">@Html.T("Common.Email", "E-posta")</label>
                                <input type="email" class="form-control" data-bind="value: newExternalEmail">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">@Html.T("Common.FullName", "Ad Soyad")</label>
                                <input type="text" class="form-control" data-bind="value: newExternalName">
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Assignment.NewDueDateOptional", "Yeni Son Tarih (İsteğe bağlı)")</label>
                        <input type="date" class="form-control" data-bind="value: newDueDate">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Common.Reason", "Sebep")</label>
                        <textarea class="form-control" rows="2" placeholder="@Html.T("Assignment.ReassignReasonPlaceholder", "Yeniden atama sebebi...")" data-bind="value: reason"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Button.Cancel", "İptal")</button>
                    <button type="button" class="btn btn-primary" data-bind="click: saveReassign, disable: isSaving">
                        <span data-bind="visible: !isSaving()"><i class="bi bi-check"></i> @Html.T("Button.Save", "Kaydet")</span>
                        <span data-bind="visible: isSaving"><span class="spinner-border spinner-border-sm"></span></span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Update Due Date Modal -->
    <div class="modal fade" id="updateDueDateModal" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-calendar-event"></i> @Html.T("Assignment.UpdateDueDate", "Tarihi Güncelle")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" data-bind="with: updateDueDateData">
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Common.NewDueDate", "Yeni Son Tarih") <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" data-bind="value: newDueDate">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Button.Cancel", "İptal")</button>
                    <button type="button" class="btn btn-primary" data-bind="click: saveUpdateDueDate, disable: isSavingDueDate">
                        <span data-bind="visible: !isSavingDueDate()"><i class="bi bi-check"></i> @Html.T("Button.Save", "Kaydet")</span>
                        <span data-bind="visible: isSavingDueDate"><span class="spinner-border spinner-border-sm"></span></span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Detail Modal -->
    <div class="modal fade" id="detailModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-info-circle"></i> @Html.T("Assignment.Detail", "Atama Detayı")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" data-bind="with: selectedDetail">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>@Html.T("Project.Title", "Proje"):</strong> <span data-bind="text: projectName"></span>
                        </div>
                        <div class="col-md-6">
                            <strong>@Html.T("Common.Customer", "Firma"):</strong>
                            <span data-bind="text: customerName || '-'"></span>
                            <!-- ko if: organizationName -->
                            <small class="text-muted">(<span data-bind="text: organizationName"></span>)</small>
                            <!-- /ko -->
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>@Html.T("Checklist.Title", "Kontrol Listesi"):</strong> <span data-bind="text: checklistName"></span>
                        </div>
                        <div class="col-md-6">
                            <strong>@Html.T("Assignment.Assignee", "Atanan"):</strong> <span data-bind="text: assigneeName"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>@Html.T("Common.DueDate", "Son Tarih"):</strong> <span data-bind="text: dueDate ? new Date(dueDate).toLocaleDateString('tr-TR') : '-'"></span>
                        </div>
                        <div class="col-md-6">
                            <strong>@Html.T("Common.Status", "Durum"):</strong> <span class="badge" data-bind="css: $parent.getStatusBadgeClass(status), text: $parent.getStatusText(status)"></span>
                        </div>
                    </div>
                    <hr>
                    <div class="row mb-3" data-bind="visible: evaluationScore !== null && evaluationScore !== undefined">
                        <div class="col-md-4">
                            <strong>@Html.T("Common.Score", "Puan"):</strong> <span data-bind="text: evaluationScore ? evaluationScore.toFixed(1) + '%' : '-'"></span>
                        </div>
                        <div class="col-md-4">
                            <strong>@Html.T("Card.Yellow", "Sarı Kart"):</strong> <span data-bind="text: yellowCardCount || 0"></span>
                        </div>
                        <div class="col-md-4">
                            <strong>@Html.T("Card.Red", "Kırmızı Kart"):</strong> <span data-bind="text: redCardCount || 0"></span>
                        </div>
                    </div>
                    <div data-bind="visible: $data.evaluatorName" class="mb-3">
                        <strong>@Html.T("Evaluation.Evaluator", "Değerlendiren"):</strong> <span data-bind="text: $data.evaluatorName"></span>
                        <span data-bind="visible: $data.evaluationDate">
                            - <span data-bind="text: $data.evaluationDate ? new Date($data.evaluationDate).toLocaleString('tr-TR') : ''"></span>
                        </span>
                    </div>
                    <!-- Dönemler -->
                    <div data-bind="visible: $data.periods && $data.periods.length > 0">
                        <hr>
                        <h6><i class="bi bi-calendar-range"></i> @Html.T("Assignment.Periods", "Dönemler")</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>@Html.T("Period.Name", "Dönem")</th>
                                        <th>@Html.T("Period.DateRange", "Tarih Aralığı")</th>
                                        <th class="text-center">@Html.T("Period.DailyTarget", "Günlük Hedef")</th>
                                        <th>@Html.T("Common.Status", "Durum")</th>
                                    </tr>
                                </thead>
                                <tbody data-bind="foreach: periods">
                                    <tr>
                                        <td data-bind="text: name"></td>
                                        <td>
                                            <small>
                                                <span data-bind="text: new Date(startDate).toLocaleDateString('tr-TR')"></span>
                                                -
                                                <span data-bind="text: new Date(endDate).toLocaleDateString('tr-TR')"></span>
                                            </small>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-info" data-bind="text: targetCount"></span>
                                        </td>
                                        <td>
                                            <span class="badge" data-bind="css: status === 'Open' ? 'bg-success' : 'bg-secondary', text: status === 'Open' ? 'Açık' : 'Kapalı'"></span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Henüz dönem yok mesajı -->
                    <div data-bind="visible: !$data.periods || $data.periods.length === 0" class="text-center text-muted py-3">
                        <i class="bi bi-calendar-x fs-3"></i>
                        <p class="mb-0 mt-2">@Html.T("Assignment.NoPeriods", "Henüz dönem açılmamış")</p>
                        <small>@Html.T("Assignment.AddPeriodHint", "Dönem eklemek için 'Dönem Ekle' butonunu kullanın")</small>
                    </div>

                    <!-- Proje Dosyaları -->
                    <div data-bind="visible: $data.projectFiles && $data.projectFiles.length > 0">
                        <hr>
                        <h6><i class="bi bi-folder2-open"></i> @Html.T("Project.Files", "Proje Dosyaları")</h6>
                        <div class="list-group list-group-flush">
                            <!-- ko foreach: projectFiles -->
                            <a href="#" class="list-group-item list-group-item-action d-flex align-items-center"
                               data-bind="click: $parent.downloadProjectFile">
                                <i class="me-2" data-bind="class: fileIcon"></i>
                                <div class="flex-grow-1">
                                    <div data-bind="text: originalFileName"></div>
                                    <small class="text-muted" data-bind="text: fileSizeDisplay"></small>
                                    <!-- ko if: description -->
                                    <small class="text-muted d-block" data-bind="text: description"></small>
                                    <!-- /ko -->
                                </div>
                                <i class="bi bi-download text-primary"></i>
                            </a>
                            <!-- /ko -->
                        </div>
                    </div>

                    <div data-bind="visible: $data.history && $data.history.length > 0">
                        <hr>
                        <h6><i class="bi bi-clock-history"></i> @Html.T("Common.History", "Geçmiş")</h6>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>@Html.T("Common.Date", "Tarih")</th>
                                    <th>@Html.T("Common.Action", "İşlem")</th>
                                    <th>@Html.T("Common.PerformedBy", "Yapan")</th>
                                    <th>@Html.T("Common.Note", "Not")</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: history">
                                <tr>
                                    <td data-bind="text: new Date(timestamp).toLocaleString('tr-TR')"></td>
                                    <td data-bind="text: action"></td>
                                    <td data-bind="text: performedBy || '-'"></td>
                                    <td data-bind="text: notes || '-'"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Button.Close", "Kapat")</button>
                    <!-- ko with: selectedDetail -->
                    <button type="button" class="btn btn-outline-primary" data-bind="click: $parent.openAddPeriodModal">
                        <i class="bi bi-calendar-plus me-1"></i>@Html.T("Period.Add", "Dönem Ekle")
                    </button>
                    <!-- /ko -->
                </div>
            </div>
        </div>
    </div>

    <!-- QR Code Modal -->
    <div class="modal fade" id="qrCodeModal" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-qr-code"></i> @Html.T("Button.QRCode", "QR Kod")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <img data-bind="attr: { src: qrCodeImage }" class="img-fluid mb-3" style="max-width: 200px;">
                    <p class="small text-muted" data-bind="text: qrCodeLink"></p>
                    <button class="btn btn-sm btn-outline-primary" data-bind="click: copyQRLink">
                        <i class="bi bi-clipboard"></i> @Html.T("Button.CopyLink", "Linki Kopyala")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Evaluation Modal -->
    <div class="modal fade" id="evaluationModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-clipboard-check"></i> @Html.T("Evaluation.Form", "Değerlendirme Formu")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div data-bind="with: $root.selectedEvaluation">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>@Html.T("Project.Title", "Proje"):</strong> <span data-bind="text: projectName"></span>
                            </div>
                            <div class="col-md-6">
                                <strong>@Html.T("Checklist.Title", "Kontrol Listesi"):</strong> <span data-bind="text: checklistName"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>@Html.T("Assignment.Assignee", "Atanan"):</strong> <span data-bind="text: assigneeName || '-'"></span>
                            </div>
                            <div class="col-md-6">
                                <strong>@Html.T("Common.DueDate", "Son Tarih"):</strong> <span data-bind="text: dueDate ? new Date(dueDate).toLocaleDateString('tr-TR') : '-'"></span>
                            </div>
                        </div>
                        <hr>
                        <div class="text-center py-3">
                            <a class="btn btn-primary btn-lg" data-bind="attr: { href: '/form/' + uniqueLink }" target="_blank">
                                <i class="bi bi-clipboard-check me-2"></i>@Html.T("Evaluation.GoToForm", "Değerlendirme Formuna Git")
                            </a>
                            <p class="text-muted mt-2 mb-0">
                                <small>@Html.T("Evaluation.UniqueLink", "Form Linki"): <code data-bind="text: uniqueLink"></code></small>
                            </p>
                        </div>
                    </div>
                    <div data-bind="ifnot: $root.selectedEvaluation" class="text-center py-4">
                        <div class="spinner-border text-primary"></div>
                        <p class="mt-2">@Html.T("Common.Loading", "Yükleniyor...")</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Button.Close", "Kapat")</button>
                    <a class="btn btn-primary" data-bind="attr: { href: selectedEvaluation() ? '/form/' + selectedEvaluation().uniqueLink : '#' }" target="_blank">
                        <i class="bi bi-box-arrow-up-right"></i> @Html.T("Button.OpenForm", "Formu Aç")
                    </a>
                </div>
            </div>
        </div>
    </div>

    <partial name="_DeleteConfirmationModal" />

    <!-- Add Period Modal -->
    <div class="modal fade" id="addPeriodModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-calendar-plus"></i> @Html.T("Period.Add", "Dönem Ekle")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" data-bind="with: periodForm">
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Period.Name", "Dönem Adı") <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" placeholder="@Html.T("Period.NamePlaceholder", "Örn: Aralık 2025")" data-bind="value: name">
                        <small class="text-muted">@Html.T("Period.NameHint", "Aylık dönem ismi girin (Örn: Ocak 2025)")</small>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">@Html.T("Period.StartDate", "Başlangıç Tarihi") <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" data-bind="value: startDate">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Html.T("Period.EndDate", "Bitiş Tarihi") <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" data-bind="value: endDate">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Period.DailyTarget", "Günlük Hedef") <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" min="1" max="100" data-bind="value: targetCount">
                        <small class="text-muted">@Html.T("Period.DailyTargetHint", "Günlük yapılması gereken değerlendirme sayısı")</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Common.Notes", "Notlar")</label>
                        <textarea class="form-control" rows="2" placeholder="@Html.T("Common.OptionalNotes", "İsteğe bağlı notlar...")" data-bind="value: notes"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Button.Cancel", "İptal")</button>
                    <button type="button" class="btn btn-primary" data-bind="click: $root.savePeriod, disable: $root.isSavingPeriod">
                        <span data-bind="visible: !$root.isSavingPeriod()">
                            <i class="bi bi-check-circle"></i> @Html.T("Button.Save", "Kaydet")
                        </span>
                        <span data-bind="visible: $root.isSavingPeriod">
                            <span class="spinner-border spinner-border-sm"></span> @Html.T("Common.Saving", "Kaydediliyor...")
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>

</div> <!-- End of assignments-app -->

@section Scripts {
    <script src="~/js/Shared/enums.service.js"></script>
    <script src="~/js/Shared/delete-confirmation.js"></script>
    <script src="~/js/Assignments/Index.js"></script>
}
