@{
    ViewData["Title"] = @Html.T("Menu.EvaluationImport", "Değerlendirme Import");
}

<div id="evaluation-import-app" class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-cloud-upload me-2"></i> @Html.T("Menu.EvaluationImport", "Değerlendirme Import")</h2>
    </div>

    <!-- Upload Card -->
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title"><i class="bi bi-file-earmark-excel me-2"></i> @Html.T("EvaluationImport.UploadFile", "Excel Dosyası Yükle")</h5>
            <div class="row align-items-end">
                <div class="col-md-6">
                    <input type="file" class="form-control" accept=".xlsx,.xls"
                           data-bind="event: { change: handleFileSelect }" autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <button class="btn btn-primary w-100" data-bind="click: function() { uploadFile(); }, disable: isUploading() || !selectedFile()">
                        <span data-bind="visible: !isUploading()">
                            <i class="bi bi-cloud-upload me-1"></i> @Html.T("EvaluationImport.Upload", "Yükle ve İşle")
                        </span>
                        <span data-bind="visible: isUploading">
                            <span class="spinner-border spinner-border-sm me-1"></span> @Html.T("Common.Processing", "İşleniyor...")
                        </span>
                    </button>
                </div>
            </div>

            <!-- Customer Selection (shown when Excel firm not found) -->
            <div data-bind="visible: showCustomerSelect" class="mt-3">
                <div class="alert alert-warning mb-2">
                    <i class="bi bi-exclamation-triangle me-1"></i> Excel'deki firma adı sistemde bulunamadı. Lütfen bu dosyanın ait olduğu müşteriyi seçin.
                </div>
                <div class="row align-items-end">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Müşteri</label>
                        <select class="form-select" data-bind="options: customerList, optionsText: 'companyName', optionsValue: 'id', optionsCaption: '-- Müşteri Seçin --', value: selectedCustomerId"></select>
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-success w-100" data-bind="click: uploadWithCustomer, disable: isUploading() || !selectedCustomerId()">
                            <i class="bi bi-check-circle me-1"></i> Seçili Müşteri ile Yükle
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sessions Table -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i> @Html.T("EvaluationImport.Sessions", "Import Oturumları")</h5>
            <button class="btn btn-outline-secondary btn-sm" data-bind="click: loadSessions">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
        <div class="card-body">
            <!-- Loading -->
            <div data-bind="visible: isLoading" class="text-center py-3">
                <div class="spinner-border spinner-border-sm text-primary"></div>
            </div>

            <!-- Empty -->
            <div data-bind="visible: !isLoading() && sessions().length === 0">
                <div class="alert alert-info mb-0">
                    <i class="bi bi-info-circle me-1"></i> @Html.T("EvaluationImport.NoSessions", "Henüz import oturumu bulunmuyor.")
                </div>
            </div>

            <!-- Table -->
            <div data-bind="visible: !isLoading() && sessions().length > 0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>@Html.T("EvaluationImport.FileName", "Dosya")</th>
                                <th>@Html.T("Common.Status", "Durum")</th>
                                <th>@Html.T("EvaluationImport.TotalRows", "Toplam")</th>
                                <th>@Html.T("EvaluationImport.Imported", "İçe Aktarılan")</th>
                                <th>@Html.T("EvaluationImport.Pending", "Bekleyen")</th>
                                <th>@Html.T("EvaluationImport.Skipped", "Atlanan")</th>
                                <th>@Html.T("Common.Date", "Tarih")</th>
                                <th>@Html.T("Common.Actions", "İşlemler")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: sessions">
                            <tr>
                                <td data-bind="text: id"></td>
                                <td>
                                    <i class="bi bi-file-earmark-excel text-success me-1"></i>
                                    <span data-bind="text: fileName"></span>
                                </td>
                                <td>
                                    <span class="badge" data-bind="text: statusName, css: statusBadgeClass"></span>
                                </td>
                                <td data-bind="text: totalRows"></td>
                                <td><span class="text-success" data-bind="text: importedRows"></span></td>
                                <td><span class="text-warning" data-bind="text: pendingRows"></span></td>
                                <td><span class="text-secondary" data-bind="text: skippedRows"></span></td>
                                <td data-bind="text: createdAtFormatted"></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" data-bind="click: $parent.openSessionDetail">
                                        <i class="bi bi-eye me-1"></i> @Html.T("Common.Detail", "Detay")
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Session Detail Modal -->
    <div class="modal fade" id="sessionDetailModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content" data-bind="with: selectedSession">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-file-earmark-excel me-2"></i>
                        <span data-bind="text: fileName"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Overview -->
                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="card bg-light">
                                <div class="card-body text-center py-2">
                                    <div class="fs-4 fw-bold" data-bind="text: totalRows"></div>
                                    <small class="text-muted">@Html.T("EvaluationImport.TotalRows", "Toplam Satır")</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-success bg-opacity-10">
                                <div class="card-body text-center py-2">
                                    <div class="fs-4 fw-bold text-success" data-bind="text: importedRows"></div>
                                    <small class="text-muted">@Html.T("EvaluationImport.Imported", "İçe Aktarılan")</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-warning bg-opacity-10">
                                <div class="card-body text-center py-2">
                                    <div class="fs-4 fw-bold text-warning" data-bind="text: pendingRows"></div>
                                    <small class="text-muted">@Html.T("EvaluationImport.Pending", "Bekleyen")</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-secondary bg-opacity-10">
                                <div class="card-body text-center py-2">
                                    <div class="fs-4 fw-bold text-secondary" data-bind="text: skippedRows"></div>
                                    <small class="text-muted">@Html.T("EvaluationImport.Skipped", "Atlanan")</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Progress Bar -->
                    <div class="progress mb-4" style="height: 24px;">
                        <div class="progress-bar bg-success" data-bind="style: { width: importedPercent() + '%' }, text: importedPercent() + '%'"></div>
                        <div class="progress-bar bg-warning" data-bind="style: { width: pendingPercent() + '%' }"></div>
                        <div class="progress-bar bg-secondary" data-bind="style: { width: skippedPercent() + '%' }"></div>
                    </div>

                    <!-- Tabs -->
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabUnmatched" type="button">
                                <i class="bi bi-exclamation-triangle me-1"></i> @Html.T("EvaluationImport.UnmatchedItems", "Eşleşmeyen Öğeler")
                                <span class="badge bg-warning ms-1" data-bind="text: unmatchedTotal(), visible: unmatchedTotal() > 0"></span>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabPendingRows" type="button">
                                <i class="bi bi-list-ul me-1"></i> @Html.T("EvaluationImport.PendingRows", "Bekleyen Satırlar")
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content pt-3">
                        <!-- Unmatched Items Tab -->
                        <div class="tab-pane fade show active" id="tabUnmatched">
                            <!-- Type Filter -->
                            <div class="btn-group mb-3">
                                <button class="btn btn-sm" data-bind="click: function() { $parent.loadUnmatchedItems(null); }, css: $parent.unmatchedTypeFilter() === null ? 'btn-primary' : 'btn-outline-primary'">
                                    @Html.T("Common.All", "Tümü")
                                </button>
                                <button class="btn btn-sm" data-bind="click: function() { $parent.loadUnmatchedItems(1); }, css: $parent.unmatchedTypeFilter() === 1 ? 'btn-primary' : 'btn-outline-primary'">
                                    <i class="bi bi-person me-1"></i> @Html.T("EvaluationImport.Person", "Kişi")
                                    <span class="badge bg-danger ms-1" data-bind="text: unmatchedPersonCount, visible: unmatchedPersonCount > 0"></span>
                                </button>
                                <button class="btn btn-sm" data-bind="click: function() { $parent.loadUnmatchedItems(2); }, css: $parent.unmatchedTypeFilter() === 2 ? 'btn-primary' : 'btn-outline-primary'">
                                    <i class="bi bi-person-check me-1"></i> @Html.T("EvaluationImport.Evaluator", "Değerlendiren")
                                    <span class="badge bg-danger ms-1" data-bind="text: unmatchedEvaluatorCount, visible: unmatchedEvaluatorCount > 0"></span>
                                </button>
                                <button class="btn btn-sm" data-bind="click: function() { $parent.loadUnmatchedItems(3); }, css: $parent.unmatchedTypeFilter() === 3 ? 'btn-primary' : 'btn-outline-primary'">
                                    <i class="bi bi-folder me-1"></i> @Html.T("EvaluationImport.Project", "Proje")
                                    <span class="badge bg-danger ms-1" data-bind="text: unmatchedProjectCount, visible: unmatchedProjectCount > 0"></span>
                                </button>
                            </div>

                            <!-- Unmatched Items Table -->
                            <div data-bind="visible: $parent.isLoadingUnmatched" class="text-center py-3">
                                <div class="spinner-border spinner-border-sm text-primary"></div>
                            </div>
                            <div data-bind="visible: !$parent.isLoadingUnmatched()">
                                <div data-bind="visible: $parent.unmatchedItems().length === 0" class="alert alert-success mb-0">
                                    <i class="bi bi-check-circle me-1"></i> @Html.T("EvaluationImport.AllMatched", "Tüm öğeler eşleştirildi.")
                                </div>
                                <div data-bind="visible: $parent.unmatchedItems().length > 0">
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover mb-0">
                                            <thead>
                                                <tr>
                                                    <th>@Html.T("EvaluationImport.ItemType", "Tür")</th>
                                                    <th>@Html.T("EvaluationImport.OriginalValue", "Orijinal Değer")</th>
                                                    <th>@Html.T("EvaluationImport.AffectedRows", "Etkilenen Satır")</th>
                                                    <th>@Html.T("Common.Status", "Durum")</th>
                                                    <th>@Html.T("Common.Actions", "İşlemler")</th>
                                                </tr>
                                            </thead>
                                            <tbody data-bind="foreach: $parent.unmatchedItems">
                                                <tr>
                                                    <td>
                                                        <span class="badge bg-secondary" data-bind="text: itemTypeName"></span>
                                                    </td>
                                                    <td>
                                                        <strong data-bind="text: originalValue"></strong>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-info" data-bind="text: affectedRowCount"></span>
                                                    </td>
                                                    <td>
                                                        <!-- ko if: isResolved -->
                                                        <span class="badge bg-success">
                                                            <i class="bi bi-check me-1"></i>
                                                            <span data-bind="text: resolutionActionName"></span>
                                                        </span>
                                                        <!-- /ko -->
                                                        <!-- ko ifnot: isResolved -->
                                                        <span class="badge bg-warning text-dark">@Html.T("EvaluationImport.Unresolved", "Çözümlenmemiş")</span>
                                                        <!-- /ko -->
                                                    </td>
                                                    <td>
                                                        <!-- ko ifnot: isResolved -->
                                                        <button class="btn btn-sm btn-outline-success" data-bind="click: $parents[1].openResolveModal">
                                                            <i class="bi bi-link me-1"></i> @Html.T("EvaluationImport.Resolve", "Çözümle")
                                                        </button>
                                                        <!-- /ko -->
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <!-- Unmatched Pagination -->
                                    <div data-bind="visible: $parent.unmatchedTotalPages() > 1" class="d-flex align-items-center gap-3 mt-3">
                                        <nav>
                                            <ul class="pagination pagination-sm mb-0">
                                                <li class="page-item" data-bind="css: { disabled: $parent.unmatchedPage() <= 1 }">
                                                    <a class="page-link" href="#" data-bind="click: $parent.unmatchedPrevPage"><i class="bi bi-chevron-left"></i></a>
                                                </li>
                                                <!-- ko foreach: $parent.unmatchedVisiblePages -->
                                                <li class="page-item" data-bind="css: { active: $data === $parents[1].unmatchedPage() }">
                                                    <a class="page-link" href="#" data-bind="text: $data, click: function() { $parents[1].unmatchedGoToPage($data); }"></a>
                                                </li>
                                                <!-- /ko -->
                                                <li class="page-item" data-bind="css: { disabled: $parent.unmatchedPage() >= $parent.unmatchedTotalPages() }">
                                                    <a class="page-link" href="#" data-bind="click: $parent.unmatchedNextPage"><i class="bi bi-chevron-right"></i></a>
                                                </li>
                                            </ul>
                                        </nav>
                                        <small class="text-muted" data-bind="text: $parent.unmatchedTotalCount() + ' kayıt'"></small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Pending Rows Tab -->
                        <div class="tab-pane fade" id="tabPendingRows">
                            <div data-bind="visible: $parent.isLoadingRows" class="text-center py-3">
                                <div class="spinner-border spinner-border-sm text-primary"></div>
                            </div>
                            <div data-bind="visible: !$parent.isLoadingRows()">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="btn-group">
                                        <button class="btn btn-sm" data-bind="click: function() { $parent.loadPendingRows(null); }, css: $parent.rowStatusFilter() === null ? 'btn-primary' : 'btn-outline-primary'">
                                            @Html.T("Common.All", "Tümü")
                                        </button>
                                        <button class="btn btn-sm" data-bind="click: function() { $parent.loadPendingRows(1); }, css: $parent.rowStatusFilter() === 1 ? 'btn-primary' : 'btn-outline-primary'">
                                            @Html.T("EvaluationImport.Pending", "Bekleyen")
                                        </button>
                                        <button class="btn btn-sm" data-bind="click: function() { $parent.loadPendingRows(2); }, css: $parent.rowStatusFilter() === 2 ? 'btn-primary' : 'btn-outline-primary'">
                                            @Html.T("EvaluationImport.Imported", "İçe Aktarılan")
                                        </button>
                                    </div>
                                    <!-- ko if: readyToImportRowCount > 0 -->
                                    <button class="btn btn-success" data-bind="click: $parent.importResolved, disable: $parent.isImporting">
                                        <span data-bind="visible: !$parent.isImporting()">
                                            <i class="bi bi-check-all me-1"></i> @Html.T("EvaluationImport.ImportResolved", "Çözülmüş Satırları İçe Aktar")
                                            (<span data-bind="text: readyToImportRowCount"></span>)
                                        </span>
                                        <span data-bind="visible: $parent.isImporting">
                                            <span class="spinner-border spinner-border-sm me-1"></span> @Html.T("Common.Processing", "İşleniyor...")
                                        </span>
                                    </button>
                                    <!-- /ko -->
                                </div>

                                <div data-bind="visible: $parent.pendingRows().length === 0" class="alert alert-info mb-0">
                                    <i class="bi bi-info-circle me-1"></i> @Html.T("EvaluationImport.NoRows", "Bu filtreye uygun satır bulunamadı.")
                                </div>
                                <div data-bind="visible: $parent.pendingRows().length > 0">
                                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                                        <table class="table table-sm table-hover mb-0">
                                            <thead class="table-light sticky-top">
                                                <tr>
                                                    <th>@Html.T("EvaluationImport.Row", "Satır")</th>
                                                    <th>@Html.T("EvaluationImport.Project", "Proje")</th>
                                                    <th>@Html.T("EvaluationImport.Evaluator", "Değerlendiren")</th>
                                                    <th>@Html.T("EvaluationImport.Person", "Kişi")</th>
                                                    <th>@Html.T("EvaluationImport.Score", "Puan")</th>
                                                    <th>@Html.T("EvaluationImport.CallDate", "Tarih")</th>
                                                    <th>@Html.T("Common.Status", "Durum")</th>
                                                </tr>
                                            </thead>
                                            <tbody data-bind="foreach: $parent.pendingRows">
                                                <tr>
                                                    <td data-bind="text: rowNumber"></td>
                                                    <td>
                                                        <!-- ko if: matchedProjectName -->
                                                        <span class="text-success" data-bind="text: matchedProjectName"></span>
                                                        <!-- /ko -->
                                                        <!-- ko if: unmatchedProjectValue -->
                                                        <span class="text-danger"><i class="bi bi-x-circle me-1"></i><span data-bind="text: unmatchedProjectValue"></span></span>
                                                        <!-- /ko -->
                                                    </td>
                                                    <td>
                                                        <!-- ko if: matchedEvaluatorName -->
                                                        <span class="text-success" data-bind="text: matchedEvaluatorName"></span>
                                                        <!-- /ko -->
                                                        <!-- ko if: unmatchedEvaluatorValue -->
                                                        <span class="text-danger"><i class="bi bi-x-circle me-1"></i><span data-bind="text: unmatchedEvaluatorValue"></span></span>
                                                        <!-- /ko -->
                                                    </td>
                                                    <td>
                                                        <!-- ko if: matchedCustomerPersonnelName -->
                                                        <span class="text-success" data-bind="text: matchedCustomerPersonnelName"></span>
                                                        <!-- /ko -->
                                                        <!-- ko if: unmatchedPersonValue -->
                                                        <span class="text-danger"><i class="bi bi-x-circle me-1"></i><span data-bind="text: unmatchedPersonValue"></span></span>
                                                        <!-- /ko -->
                                                    </td>
                                                    <td data-bind="text: parsedScore"></td>
                                                    <td data-bind="text: parsedCallDateFormatted"></td>
                                                    <td>
                                                        <span class="badge" data-bind="text: statusName, css: statusId === 2 ? 'bg-success' : statusId === 3 ? 'bg-secondary' : 'bg-warning text-dark'"></span>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <!-- Pending Rows Pagination -->
                                    <div data-bind="visible: $parent.rowsTotalPages() > 1" class="d-flex align-items-center gap-3 mt-3">
                                        <nav>
                                            <ul class="pagination pagination-sm mb-0">
                                                <li class="page-item" data-bind="css: { disabled: $parent.rowsPage() <= 1 }">
                                                    <a class="page-link" href="#" data-bind="click: $parent.rowsPrevPage"><i class="bi bi-chevron-left"></i></a>
                                                </li>
                                                <!-- ko foreach: $parent.rowsVisiblePages -->
                                                <li class="page-item" data-bind="css: { active: $data === $parents[1].rowsPage() }">
                                                    <a class="page-link" href="#" data-bind="text: $data, click: function() { $parents[1].rowsGoToPage($data); }"></a>
                                                </li>
                                                <!-- /ko -->
                                                <li class="page-item" data-bind="css: { disabled: $parent.rowsPage() >= $parent.rowsTotalPages() }">
                                                    <a class="page-link" href="#" data-bind="click: $parent.rowsNextPage"><i class="bi bi-chevron-right"></i></a>
                                                </li>
                                            </ul>
                                        </nav>
                                        <small class="text-muted" data-bind="text: $parent.rowsTotalCount() + ' kayıt'"></small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i> @Html.T("Common.Close", "Kapat")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Resolve Modal -->
    <div class="modal fade" id="resolveModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-link me-2"></i> @Html.T("EvaluationImport.ResolveItem", "Öğeyi Çözümle")
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" data-bind="with: resolveItem">
                    <div class="alert alert-info">
                        <strong>@Html.T("EvaluationImport.OriginalValue", "Orijinal Değer"):</strong>
                        <span data-bind="text: originalValue"></span>
                        <br />
                        <small>@Html.T("EvaluationImport.ItemType", "Tür"): <span data-bind="text: itemTypeName"></span></small>
                        <br />
                        <small>@Html.T("EvaluationImport.AffectedRows", "Etkilenen Satır"): <span data-bind="text: affectedRowCount"></span></small>
                    </div>

                    <!-- Search / Select Existing -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mevcut Kayıtlar</label>
                        <input type="text" class="form-control mb-2" autocomplete="off"
                               data-bind="textInput: $parent.resolveSearchQuery, attr: { placeholder: itemTypeId === 3 ? 'Proje adı yazarak filtreleyin...' : 'Ad soyad yazarak filtreleyin...' }" />
                    </div>

                    <!-- Results List -->
                    <div data-bind="visible: $parent.resolveSearchResults().length > 0" class="mb-3">
                        <small class="text-muted mb-1 d-block" data-bind="text: $parent.resolveSearchResults().length + ' kayıt listeleniyor'"></small>
                        <div class="list-group" style="max-height: 250px; overflow-y: auto;">
                            <!-- ko foreach: $parent.resolveSearchResults -->
                            <button type="button" class="list-group-item list-group-item-action py-2"
                                    data-bind="click: $parents[1].selectResolveEntity, css: { 'active': id === $parents[1].resolveSelectedEntityId() }">
                                <span data-bind="text: $data.fullName || $data.name || $data.companyName"></span>
                            </button>
                            <!-- /ko -->
                        </div>
                    </div>
                    <div data-bind="visible: $parent.resolveSearchResults().length === 0" class="mb-3">
                        <div class="text-muted small">Kayıt bulunamadı.</div>
                    </div>

                    <hr />

                    <!-- Create New Person -->
                    <!-- ko if: itemTypeId === 1 -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">@Html.T("EvaluationImport.CreateNewPerson", "Yeni Kişi Oluştur")</label>
                        <div class="row">
                            <div class="col-6">
                                <input type="text" class="form-control" autocomplete="off"
                                       placeholder="@Html.T("Common.FirstName", "Ad")"
                                       data-bind="textInput: $parent.resolveNewFirstName" />
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" autocomplete="off"
                                       placeholder="@Html.T("Common.LastName", "Soyad")"
                                       data-bind="textInput: $parent.resolveNewLastName" />
                            </div>
                        </div>
                        <button class="btn btn-outline-primary btn-sm mt-2"
                                data-bind="click: $parent.resolveCreateNew, disable: !$parent.resolveNewFirstName()">
                            <i class="bi bi-plus-circle me-1"></i> @Html.T("EvaluationImport.CreateAndLink", "Oluştur ve Eşleştir")
                        </button>
                    </div>
                    <hr />
                    <!-- /ko -->

                    <!-- Create New Project -->
                    <!-- ko if: itemTypeId === 3 -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Yeni Proje Oluştur</label>
                        <div class="mb-2">
                            <input type="text" class="form-control" autocomplete="off"
                                   placeholder="Proje Adı"
                                   data-bind="textInput: $parent.resolveNewProjectName" />
                        </div>
                        <div class="mb-2">
                            <select class="form-select"
                                    data-bind="options: $parent.resolveChecklistList, optionsText: 'name', optionsValue: 'id', optionsCaption: '-- Kontrol Listesi Seçin --', value: $parent.resolveSelectedChecklistId"></select>
                        </div>
                        <button class="btn btn-outline-primary btn-sm"
                                data-bind="click: $parent.resolveCreateNew, disable: !$parent.resolveNewProjectName() || !$parent.resolveSelectedChecklistId()">
                            <i class="bi bi-plus-circle me-1"></i> Proje Oluştur ve Eşleştir
                        </button>
                    </div>
                    <hr />
                    <!-- /ko -->

                    <!-- Create New User (Evaluator) -->
                    <!-- ko if: itemTypeId === 2 -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Yeni Kullanıcı Oluştur</label>
                        <div class="row">
                            <div class="col-6">
                                <input type="text" class="form-control" autocomplete="off"
                                       placeholder="Ad"
                                       data-bind="textInput: $parent.resolveNewFirstName" />
                            </div>
                            <div class="col-6">
                                <input type="text" class="form-control" autocomplete="off"
                                       placeholder="Soyad"
                                       data-bind="textInput: $parent.resolveNewLastName" />
                            </div>
                        </div>
                        <button class="btn btn-outline-primary btn-sm mt-2"
                                data-bind="click: $parent.resolveCreateNew, disable: !$parent.resolveNewFirstName()">
                            <i class="bi bi-plus-circle me-1"></i> Kullanıcı Oluştur ve Eşleştir
                        </button>
                    </div>
                    <hr />
                    <!-- /ko -->

                    <!-- Skip -->
                    <button class="btn btn-outline-secondary" data-bind="click: $parent.resolveSkip">
                        <i class="bi bi-skip-forward me-1"></i> @Html.T("EvaluationImport.SkipItem", "Bu Öğeyi Atla")
                    </button>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        @Html.T("Common.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-success"
                            data-bind="click: resolveLink, disable: !resolveSelectedEntityId()">
                        <i class="bi bi-link me-1"></i> @Html.T("EvaluationImport.LinkSelected", "Seçileni Eşleştir")
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/evaluation-import.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/EvaluationImport/index.js" asp-append-version="true"></script>
}
