@{
    ViewData["Title"] = @Html.T("Menu.PerformanceSettings", "Performans Ayarları");
}

<div id="performance-settings-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0">
            <i class="bi bi-speedometer2 text-primary me-2"></i>
            @Html.T("Menu.PerformanceSettings", "Performans Ayarları")
        </h4>
        <button class="btn btn-primary" data-bind="click: saveAll, disable: isSaving">
            <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
            <span data-bind="visible: !isSaving()">
                <i class="bi bi-check-lg me-1"></i> @Html.T("Common.SaveAll", "Tümünü Kaydet")
            </span>
        </button>
    </div>

    <!-- Info Alert -->
    <div class="alert alert-info mb-4">
        <i class="bi bi-info-circle me-2"></i>
        @Html.T("Setting.PerformanceSettingsInfo", "Her proje tipi için günlük, haftalık, aylık ve yıllık değerlendirme hedefleri belirleyebilirsiniz. Bu hedefler Performans Takibi raporunda kullanılacaktır.")
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Yükleniyor...")</p>
    </div>

    <!-- Settings Cards -->
    <div data-bind="visible: !isLoading()" class="row">
        <!-- ko foreach: settings -->
        <div class="col-lg-6 col-xl-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-header d-flex align-items-center" data-bind="css: projectTypeColor">
                    <i class="me-2" data-bind="class: projectTypeIcon"></i>
                    <h6 class="mb-0 text-white" data-bind="text: projectTypeName"></h6>
                    <div class="form-check form-switch ms-auto">
                        <input class="form-check-input" type="checkbox" data-bind="checked: isActive" />
                    </div>
                </div>
                <div class="card-body">
                    <!-- Targets -->
                    <h6 class="text-muted mb-3">
                        <i class="bi bi-bullseye me-1"></i> @Html.T("Setting.Targets", "Hedefler")
                    </h6>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small">@Html.T("Report.DailyQuota", "Günlük")</label>
                            <input type="number" class="form-control form-control-sm" min="0"
                                   data-bind="value: dailyTarget, enable: isActive" placeholder="-" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">@Html.T("Setting.WeeklyTarget", "Haftalık")</label>
                            <input type="number" class="form-control form-control-sm" min="0"
                                   data-bind="value: weeklyTarget, enable: isActive" placeholder="-" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">@Html.T("Report.MonthlyQuota", "Aylık")</label>
                            <input type="number" class="form-control form-control-sm" min="0"
                                   data-bind="value: monthlyTarget, enable: isActive" placeholder="-" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">@Html.T("Setting.YearlyTarget", "Yıllık")</label>
                            <input type="number" class="form-control form-control-sm" min="0"
                                   data-bind="value: yearlyTarget, enable: isActive" placeholder="-" />
                        </div>
                    </div>

                    <!-- Thresholds -->
                    <h6 class="text-muted mb-3">
                        <i class="bi bi-percent me-1"></i> @Html.T("Setting.ScoreThresholds", "Puan Eşikleri")
                    </h6>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small text-success">
                                <i class="bi bi-check-circle me-1"></i> @Html.T("Setting.SuccessThreshold", "Başarılı (%)")
                            </label>
                            <input type="number" class="form-control form-control-sm" min="0" max="100" step="0.1"
                                   data-bind="value: successThreshold, enable: isActive" placeholder="80" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-warning">
                                <i class="bi bi-exclamation-triangle me-1"></i> @Html.T("Setting.WarningThreshold", "Orta (%)")
                            </label>
                            <input type="number" class="form-control form-control-sm" min="0" max="100" step="0.1"
                                   data-bind="value: warningThreshold, enable: isActive" placeholder="60" />
                        </div>
                    </div>

                    <!-- Threshold Preview -->
                    <div class="mt-3 small text-muted">
                        <div class="d-flex justify-content-between">
                            <span><i class="bi bi-circle-fill text-success me-1"></i> <span data-bind="text: successThreshold() || 80"></span>%+</span>
                            <span><i class="bi bi-circle-fill text-warning me-1"></i> <span data-bind="text: warningThreshold() || 60"></span>-<span data-bind="text: (successThreshold() || 80) - 0.1"></span>%</span>
                            <span><i class="bi bi-circle-fill text-danger me-1"></i> &lt;<span data-bind="text: warningThreshold() || 60"></span>%</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- /ko -->
    </div>

    <!-- Empty State -->
    <div data-bind="visible: !isLoading() && settings().length === 0" class="text-center py-5 text-muted">
        <i class="bi bi-gear fs-1"></i>
        <p class="mt-2">@Html.T("Setting.NoProjectTypes", "Proje tipi bulunamadı.")</p>
    </div>
</div>

@section Scripts {
    <script src="~/js/Settings/performanceSettings.js" asp-append-version="true"></script>
}
