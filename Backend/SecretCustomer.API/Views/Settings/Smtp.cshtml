@{
    ViewData["Title"] = Html.T("Smtp.Title", "SMTP Profilleri");
}

<div id="smtp-profiles-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0"><i class="bi bi-envelope-at me-2"></i>@Html.T("Smtp.Title", "SMTP Profilleri")</h4>
        <button class="btn btn-primary" data-bind="click: openCreateModal">
            <i class="bi bi-plus-lg me-1"></i> @Html.T("Smtp.NewProfile", "Yeni Profil")
        </button>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>

    <!-- Profiles Table -->
    <div data-bind="visible: !isLoading()" class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div data-bind="visible: profiles().length === 0" class="text-center py-5 text-muted">
                <i class="bi bi-envelope-x fs-1"></i>
                <p class="mt-2">@Html.T("Smtp.NoProfiles", "Henüz SMTP profili bulunmuyor.")</p>
                <button class="btn btn-primary btn-sm" data-bind="click: openCreateModal">
                    <i class="bi bi-plus-lg me-1"></i> @Html.T("Smtp.CreateFirst", "İlk Profili Oluştur")
                </button>
            </div>
            <div data-bind="visible: profiles().length > 0" class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Html.T("Smtp.ProfileName", "Profil Adı")</th>
                            <th>@Html.T("Smtp.Server", "Sunucu")</th>
                            <th>@Html.T("Smtp.Sender", "Gönderen")</th>
                            <th>@Html.T("Smtp.Authentication", "Kimlik Doğrulama")</th>
                            <th>@Html.T("Common.Status", "Durum")</th>
                            <th width="180"></th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: profiles">
                        <tr>
                            <td>
                                <strong data-bind="text: name"></strong>
                                <!-- ko if: isDefault -->
                                <span class="badge bg-primary ms-1">@Html.T("Common.Default", "Varsayılan")</span>
                                <!-- /ko -->
                            </td>
                            <td>
                                <code data-bind="text: host + ':' + port"></code>
                                <!-- ko if: useSsl -->
                                <span class="badge bg-success ms-1">SSL</span>
                                <!-- /ko -->
                            </td>
                            <td>
                                <span data-bind="text: fromEmail"></span>
                                <!-- ko if: fromName -->
                                <small class="text-muted d-block" data-bind="text: fromName"></small>
                                <!-- /ko -->
                            </td>
                            <td>
                                <!-- ko if: useOAuth && useGraphApi -->
                                <span class="badge bg-primary">Graph API</span>
                                <!-- /ko -->
                                <!-- ko if: useOAuth && !useGraphApi -->
                                <span class="badge bg-info">OAuth 2.0</span>
                                <!-- /ko -->
                                <!-- ko ifnot: useOAuth -->
                                <span class="badge bg-secondary">Basic Auth</span>
                                <!-- /ko -->
                            </td>
                            <td>
                                <!-- ko if: enabled -->
                                <span class="badge bg-success">@Html.T("Common.Active", "Aktif")</span>
                                <!-- /ko -->
                                <!-- ko ifnot: enabled -->
                                <span class="badge bg-secondary">@Html.T("Common.Disabled", "Devre Dışı")</span>
                                <!-- /ko -->
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-info" data-bind="click: $parent.testConnection, disable: $parent.isTesting" title="@Html.T("Smtp.ConnectionTest", "Bağlantı Testi")">
                                        <i class="bi bi-plug"></i>
                                    </button>
                                    <button class="btn btn-outline-primary" data-bind="click: $parent.openEditModal" title="@Html.T("Common.Edit", "Düzenle")">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <!-- ko ifnot: isDefault -->
                                    <button class="btn btn-outline-warning" data-bind="click: $parent.setDefault" title="@Html.T("Smtp.SetDefault", "Varsayılan Yap")">
                                        <i class="bi bi-star"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" data-bind="click: $parent.deleteProfile" title="@Html.T("Common.Delete", "Sil")">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                    <!-- /ko -->
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Test Email Section -->
    <div data-bind="visible: !isLoading() && profiles().length > 0" class="card border-0 shadow-sm mt-4">
        <div class="card-header bg-info text-white">
            <h6 class="mb-0"><i class="bi bi-send me-2"></i>@Html.T("Smtp.SendTestEmail", "Test Email Gönder")</h6>
        </div>
        <div class="card-body">
            <div class="row align-items-end">
                <div class="col-md-4">
                    <label class="form-label">@Html.T("Smtp.Profile", "Profil")</label>
                    <select class="form-select" data-bind="options: profiles, optionsText: 'name', optionsValue: 'id', value: selectedTestProfileId"></select>
                </div>
                <div class="col-md-5">
                    <label class="form-label">@Html.T("Smtp.RecipientEmail", "Alıcı Email Adresi")</label>
                    <input type="email" class="form-control" placeholder="test@example.com" autocomplete="off" data-bind="value: testEmail">
                </div>
                <div class="col-md-3">
                    <button class="btn btn-info w-100" data-bind="click: sendTestEmail, disable: isSendingTest">
                        <span data-bind="visible: !isSendingTest()">
                            <i class="bi bi-envelope-arrow-up me-1"></i> @Html.T("Common.Send", "Gönder")
                        </span>
                        <span data-bind="visible: isSendingTest">
                            <span class="spinner-border spinner-border-sm"></span> @Html.T("Common.Sending", "Gönderiliyor...")
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Help Section -->
    <div class="card border-0 shadow-sm mt-4" data-bind="visible: !isLoading()">
        <div class="card-header">
            <h6 class="mb-0"><i class="bi bi-question-circle me-2"></i>@Html.T("Common.Help", "Yardım")</h6>
        </div>
        <div class="card-body">
            <!-- Profil Yönetimi Bilgisi -->
            <div class="alert alert-info mb-4">
                <h6><i class="bi bi-info-circle me-1"></i> @Html.T("Smtp.ProfileManagement", "SMTP Profil Yönetimi")</h6>
                <ul class="mb-0 small">
                    <li><strong>Varsayılan Profil:</strong> Sistem email gönderirken (anket davetiyeleri, değerlendirme bildirimleri vb.) varsayılan profili kullanır.</li>
                    <li><strong>Birden Fazla Profil:</strong> Farklı email sağlayıcıları için birden fazla profil oluşturabilirsiniz (örn: Office 365, Gmail).</li>
                    <li><strong>Bağlantı Testi:</strong> Kaydetmeden önce "Bağlantı Testi" yaparak ayarların doğruluğunu kontrol edin.</li>
                    <li><strong>Test Email:</strong> Profil seçip test maili göndererek email gönderiminin çalıştığını doğrulayın.</li>
                </ul>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <h6><i class="bi bi-google text-danger me-1"></i> Gmail</h6>
                    <ul class="small">
                        <li>Host: <code>smtp.gmail.com</code></li>
                        <li>Port: <code>587</code></li>
                        <li>SSL: @Html.T("Common.Yes", "Evet")</li>
                        <li><a href="https://myaccount.google.com/apppasswords" target="_blank">@Html.T("Smtp.AppPassword", "Uygulama Sifresi")</a> @Html.T("Smtp.CreateIt", "olusturun")</li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6><i class="bi bi-microsoft text-primary me-1"></i> Microsoft 365 (OAuth 2.0)</h6>
                    <ul class="small">
                        <li>Host: <code>smtp.office365.com</code></li>
                        <li>Port: <code>587</code></li>
                        <li>SSL: Evet</li>
                        <li>OAuth 2.0: <strong>Önerilen</strong></li>
                        <li><a href="https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade" target="_blank">Azure App Registration</a></li>
                        <li>API izni: <code>SMTP.Send</code></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6><i class="bi bi-envelope text-warning me-1"></i> Yandex</h6>
                    <ul class="small">
                        <li>Host: <code>smtp.yandex.com</code></li>
                        <li>Port: <code>465</code> veya <code>587</code></li>
                        <li>SSL: Evet</li>
                        <li>@Html.T("Smtp.NormalPasswordOk", "Normal sifre kullanabilirsiniz")</li>
                    </ul>
                </div>
            </div>

            <!-- Microsoft Graph API Kurulum Adımları (Önerilen) -->
            <div class="mt-4">
                <h6><i class="bi bi-diagram-3 text-primary me-1"></i> Microsoft Graph API Kurulumu (Önerilen)</h6>
                <p class="small text-muted mb-2">SMTP yerine Graph API kullanmak daha güvenilir ve kolaydır.</p>
                <ol class="small">
                    <li><a href="https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade" target="_blank">Azure Portal</a>'da yeni bir <strong>App Registration</strong> oluşturun</li>
                    <li><strong>API permissions</strong> bölümünde:
                        <ul>
                            <li><code>Microsoft Graph > Mail.Send</code> (Application permission) ekleyin</li>
                            <li><strong>Grant admin consent</strong> butonuna tıklayın</li>
                        </ul>
                    </li>
                    <li><strong>Certificates & secrets</strong> bölümünde yeni bir <strong>Client Secret</strong> oluşturun ve değeri kopyalayın</li>
                    <li><strong>Overview</strong> sayfasından:
                        <ul>
                            <li><strong>Application (client) ID</strong> → Client ID alanına</li>
                            <li><strong>Directory (tenant) ID</strong> → Tenant ID alanına</li>
                        </ul>
                    </li>
                    <li>Profil formunda:
                        <ul>
                            <li><strong>OAuth 2.0</strong> seçeneğini aktif edin</li>
                            <li><strong>Microsoft Graph API Kullan</strong> seçeneğini aktif edin</li>
                            <li>Azure'dan aldığınız değerleri girin</li>
                            <li><strong>Gönderen Email</strong> alanına mailbox sahibinin email adresini girin</li>
                        </ul>
                    </li>
                </ol>
            </div>

            <!-- SMTP OAuth 2.0 Kurulum Adımları -->
            <div class="mt-4">
                <h6><i class="bi bi-gear me-1"></i> SMTP OAuth 2.0 Kurulumu (Alternatif)</h6>
                <p class="small text-muted mb-2">Graph API yerine SMTP protokolü ile OAuth kullanmak istiyorsanız:</p>
                <ol class="small">
                    <li>Yukarıdaki adımları izleyin, ancak <code>Mail.Send</code> yerine farklı izinler gerekebilir</li>
                    <li>Exchange Online'da <strong>SMTP AUTH</strong> özelliğinin aktif olduğundan emin olun</li>
                    <li>PowerShell ile service principal yapılandırması gerekebilir</li>
                    <li>Profil formunda <strong>Microsoft Graph API Kullan</strong> seçeneğini <strong>kapalı</strong> bırakın</li>
                </ol>
                <div class="alert alert-warning py-2 small">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    SMTP OAuth yapılandırması karmaşıktır. Mümkünse <strong>Graph API</strong> kullanmanızı öneririz.
                </div>
            </div>
        </div>
    </div>

    <!-- Create/Edit Modal -->
    <div class="modal fade" id="profileModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <span data-bind="visible: !isEditing()">@Html.T("Smtp.NewProfileTitle", "Yeni SMTP Profili")</span>
                        <span data-bind="visible: isEditing">@Html.T("Smtp.EditProfileTitle", "SMTP Profili Düzenle")</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <!-- Sol: Sunucu Ayarları -->
                        <div class="col-md-6">
                            <h6 class="text-muted mb-3"><i class="bi bi-server me-1"></i> @Html.T("Smtp.ServerSettings", "Sunucu Ayarları")</h6>

                            <div class="mb-3">
                                <label class="form-label">@Html.T("Smtp.ProfileName", "Profil Adı") <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" placeholder="Office 365, Gmail..." autocomplete="off" data-bind="value: form.name">
                            </div>

                            <div class="mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="formEnabled" data-bind="checked: form.enabled">
                                    <label class="form-check-label" for="formEnabled"><strong>@Html.T("Smtp.ProfileActive", "Profil Aktif")</strong></label>
                                </div>
                            </div>

                            <hr>

                            <div class="mb-3">
                                <label class="form-label">@Html.T("Smtp.SmtpServer", "SMTP Sunucu") <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" placeholder="smtp.office365.com" autocomplete="off" data-bind="value: form.host">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">@Html.T("Smtp.Port", "Port") <span class="text-danger">*</span></label>
                                <select class="form-select" data-bind="value: form.port">
                                    <option value="25">25 (SMTP)</option>
                                    <option value="465">465 (SMTPS / SSL)</option>
                                    <option value="587">587 (Submission / TLS) - @Html.T("Common.Recommended", "Önerilen")</option>
                                    <option value="2525">2525 (@Html.T("Common.Alternative", "Alternatif"))</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="formUseSsl" data-bind="checked: form.useSsl">
                                    <label class="form-check-label" for="formUseSsl">@Html.T("Smtp.UseSsl", "SSL/TLS Kullan (StartTLS)")</label>
                                </div>
                            </div>

                            <hr>

                            <div class="mb-3">
                                <label class="form-label">@Html.T("Smtp.SenderEmail", "Gönderen Email") <span class="text-danger">*</span></label>
                                <input type="email" class="form-control" placeholder="noreply@domain.com" autocomplete="off" data-bind="value: form.fromEmail">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">@Html.T("Smtp.SenderName", "Gönderen Adı")</label>
                                <input type="text" class="form-control" placeholder="Secret Customer" autocomplete="off" data-bind="value: form.fromName">
                            </div>
                        </div>

                        <!-- Sağ: Kimlik Doğrulama -->
                        <div class="col-md-6">
                            <h6 class="text-muted mb-3"><i class="bi bi-key me-1"></i> @Html.T("Smtp.Authentication", "Kimlik Doğrulama")</h6>

                            <div class="mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="formUseOAuth" data-bind="checked: form.useOAuth">
                                    <label class="form-check-label" for="formUseOAuth"><strong>OAuth 2.0 (Microsoft 365)</strong></label>
                                </div>
                                <small class="text-muted">@Html.T("Smtp.ModernAuth", "Modern kimlik doğrulama yöntemi")</small>
                            </div>

                            <hr>

                            <div class="mb-3">
                                <label class="form-label">@Html.T("Smtp.Username", "Kullanıcı Adı / Email")</label>
                                <input type="text" class="form-control" placeholder="user@domain.com" autocomplete="username" data-bind="value: form.username">
                            </div>

                            <!-- Basic Auth: Password -->
                            <div class="mb-3" data-bind="visible: !form.useOAuth()">
                                <label class="form-label">@Html.T("Smtp.Password", "Şifre / Uygulama Şifresi")</label>
                                <div class="input-group">
                                    <input class="form-control" placeholder="••••••••" autocomplete="new-password" data-bind="value: form.password, attr: { type: showPassword() ? 'text' : 'password' }">
                                    <button class="btn btn-outline-secondary" type="button" data-bind="click: togglePassword">
                                        <i data-bind="css: showPassword() ? 'bi bi-eye-slash' : 'bi bi-eye'"></i>
                                    </button>
                                </div>
                                <small class="text-muted">@Html.T("Smtp.GmailAppPasswordHint", "Gmail için \"Uygulama Şifresi\" kullanın.")</small>
                            </div>

                            <!-- OAuth 2.0 Settings -->
                            <div data-bind="visible: form.useOAuth">
                                <!-- Graph API Toggle -->
                                <div class="mb-3">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="formUseGraphApi" data-bind="checked: form.useGraphApi">
                                        <label class="form-check-label" for="formUseGraphApi"><strong>@Html.T("Smtp.UseGraphApi", "Microsoft Graph API Kullan")</strong></label>
                                    </div>
                                    <small class="text-muted">@Html.T("Smtp.GraphApiHint", "SMTP yerine Graph API ile email gönderir (önerilen)")</small>
                                </div>

                                <div class="alert py-2 mb-3" data-bind="css: form.useGraphApi() ? 'alert-success' : 'alert-info'">
                                    <small>
                                        <i class="bi bi-info-circle me-1"></i>
                                        <!-- ko if: form.useGraphApi -->
                                        Graph API için <code>Mail.Send</code> izni gereklidir.
                                        <!-- /ko -->
                                        <!-- ko ifnot: form.useGraphApi -->
                                        SMTP OAuth için ek Exchange Online yapılandırması gerekebilir.
                                        <!-- /ko -->
                                    </small>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Tenant ID <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" autocomplete="off" data-bind="value: form.tenantId">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Client ID <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" autocomplete="off" data-bind="value: form.clientId">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Client Secret <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <input class="form-control" placeholder="••••••••" autocomplete="new-password" data-bind="value: form.clientSecret, attr: { type: showClientSecret() ? 'text' : 'password' }">
                                        <button class="btn btn-outline-secondary" type="button" data-bind="click: toggleClientSecret">
                                            <i data-bind="css: showClientSecret() ? 'bi bi-eye-slash' : 'bi bi-eye'"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Cancel", "İptal")</button>
                    <button type="button" class="btn btn-primary" data-bind="click: saveProfile, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        @Html.T("Common.Save", "Kaydet")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation -->
    <partial name="_DeleteConfirmationModal" />
</div>

@section Scripts {
    <script src="~/js/Shared/delete-confirmation.js"></script>
    <script src="~/js/Settings/smtp.js"></script>
}
