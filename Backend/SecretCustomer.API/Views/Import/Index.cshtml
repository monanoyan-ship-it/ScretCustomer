@{
    ViewData["Title"] = "Veri İçe Aktarma";
}

<div id="import-app">
    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-upload me-2"></i>Personel İçe Aktarma
                        </h5>
                    </div>
                    <div class="card-body">
                        <!-- Info Box -->
                        <div class="alert alert-info mb-4">
                            <h6><i class="bi bi-info-circle me-2"></i>Rol Bilgileri</h6>
                            <ul class="mb-0">
                                <li><strong>CustomerManager</strong> (RoleId: 1) = Firma Yetkilisi (Tüm raporlara erişim)</li>
                                <li><strong>CustomerSupervisor</strong> (RoleId: 2) = Takım Lideri (Kendi takımının raporlarını görür)</li>
                                <li><strong>CustomerOperator</strong> (RoleId: 3) = Müşteri Temsilcisi (Değerlendirilecek personel)</li>
                            </ul>
                            <hr>
                            <small>
                                <strong>Organization:</strong> Belirtilmezse "Merkez" olarak atanır.
                            </small>
                        </div>

                        <!-- Upload Form -->
                        <form id="uploadForm">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">CSV Dosyası Seçin</label>
                                        <input type="file" class="form-control" id="csvFile" accept=".csv" data-bind="event: { change: onFileSelected }">
                                        <div class="form-text">Sadece .csv dosyaları kabul edilir (max 10MB)</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Seçenekler</label>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="updateExisting" data-bind="checked: updateExisting">
                                            <label class="form-check-label" for="updateExisting">
                                                Mevcut kayıtları güncelle
                                            </label>
                                        </div>
                                        <div class="form-text">İşaretlenmezse, mevcut kullanıcı adları atlanır</div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-primary" data-bind="click: importPersonnel, disable: isLoading() || !selectedFile()">
                                    <span data-bind="visible: !isLoading()">
                                        <i class="bi bi-upload me-2"></i>İçe Aktar
                                    </span>
                                    <span data-bind="visible: isLoading">
                                        <span class="spinner-border spinner-border-sm me-2"></span>İşleniyor...
                                    </span>
                                </button>
                                <a href="/api/import/personnel/template" class="btn btn-outline-secondary" download>
                                    <i class="bi bi-download me-2"></i>Örnek Şablon İndir
                                </a>
                            </div>
                        </form>

                        <!-- Selected File Info -->
                        <div data-bind="visible: selectedFile" class="mt-3">
                            <div class="alert alert-secondary">
                                <i class="bi bi-file-earmark-text me-2"></i>
                                <strong>Seçili Dosya:</strong> <span data-bind="text: selectedFileName"></span>
                                (<span data-bind="text: selectedFileSize"></span>)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Result Section -->
        <div class="row mt-4" data-bind="visible: importResult">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header" data-bind="css: { 'bg-success text-white': importResult() && importResult().success, 'bg-danger text-white': importResult() && !importResult().success }">
                        <h5 class="mb-0">
                            <i class="bi me-2" data-bind="css: { 'bi-check-circle': importResult() && importResult().success, 'bi-x-circle': importResult() && !importResult().success }"></i>
                            İçe Aktarma Sonucu
                        </h5>
                    </div>
                    <div class="card-body">
                        <!-- Summary Stats -->
                        <div class="row mb-4">
                            <div class="col-md-2">
                                <div class="text-center p-3 bg-light rounded">
                                    <h3 class="mb-0" data-bind="text: importResult() ? importResult().totalRows : 0"></h3>
                                    <small class="text-muted">Toplam Satır</small>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="text-center p-3 bg-light rounded">
                                    <h3 class="mb-0 text-info" data-bind="text: importResult() ? importResult().customersCreated : 0"></h3>
                                    <small class="text-muted">Firma Oluşturuldu</small>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="text-center p-3 bg-light rounded">
                                    <h3 class="mb-0 text-success" data-bind="text: importResult() ? importResult().personnelCreated : 0"></h3>
                                    <small class="text-muted">Personel Oluşturuldu</small>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="text-center p-3 bg-light rounded">
                                    <h3 class="mb-0 text-primary" data-bind="text: importResult() ? importResult().personnelUpdated : 0"></h3>
                                    <small class="text-muted">Personel Güncellendi</small>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="text-center p-3 bg-light rounded">
                                    <h3 class="mb-0 text-warning" data-bind="text: importResult() ? importResult().personnelSkipped : 0"></h3>
                                    <small class="text-muted">Atlandı</small>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="text-center p-3 bg-light rounded">
                                    <h3 class="mb-0 text-danger" data-bind="text: importResult() && importResult().errors ? importResult().errors.length : 0"></h3>
                                    <small class="text-muted">Hata</small>
                                </div>
                            </div>
                        </div>

                        <!-- Errors -->
                        <div data-bind="visible: importResult() && importResult().errors && importResult().errors.length > 0" class="mb-3">
                            <h6 class="text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Hatalar</h6>
                            <ul class="list-group">
                                <!-- ko foreach: importResult() ? importResult().errors : [] -->
                                <li class="list-group-item list-group-item-danger" data-bind="text: $data"></li>
                                <!-- /ko -->
                            </ul>
                        </div>

                        <!-- Warnings -->
                        <div data-bind="visible: importResult() && importResult().warnings && importResult().warnings.length > 0" class="mb-3">
                            <h6 class="text-warning"><i class="bi bi-exclamation-circle me-2"></i>Uyarılar</h6>
                            <ul class="list-group">
                                <!-- ko foreach: importResult() ? importResult().warnings.slice(0, 20) : [] -->
                                <li class="list-group-item list-group-item-warning" data-bind="text: $data"></li>
                                <!-- /ko -->
                                <li class="list-group-item list-group-item-light" data-bind="visible: importResult() && importResult().warnings && importResult().warnings.length > 20">
                                    ... ve <span data-bind="text: importResult() && importResult().warnings ? importResult().warnings.length - 20 : 0"></span> uyarı daha
                                </li>
                            </ul>
                        </div>

                        <!-- Imported Personnel Table -->
                        <div data-bind="visible: importResult() && importResult().importedPersonnel && importResult().importedPersonnel.length > 0">
                            <h6><i class="bi bi-table me-2"></i>İşlenen Personeller (İlk 50)</h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-striped">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Ad Soyad</th>
                                            <th>Kullanıcı Adı</th>
                                            <th>Firma</th>
                                            <th>Rol</th>
                                            <th>Durum</th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: importResult() ? importResult().importedPersonnel.slice(0, 50) : []">
                                        <tr>
                                            <td data-bind="text: id"></td>
                                            <td data-bind="text: fullName"></td>
                                            <td data-bind="text: username"></td>
                                            <td data-bind="text: company"></td>
                                            <td data-bind="text: role"></td>
                                            <td>
                                                <span class="badge" data-bind="
                                                    text: status,
                                                    css: {
                                                        'bg-success': status === 'Created',
                                                        'bg-primary': status === 'Updated',
                                                        'bg-secondary': status === 'Skipped'
                                                    }"></span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function ImportViewModel() {
        var self = this;

        self.isLoading = ko.observable(false);
        self.updateExisting = ko.observable(false);
        self.selectedFile = ko.observable(null);
        self.selectedFileName = ko.observable('');
        self.selectedFileSize = ko.observable('');
        self.importResult = ko.observable(null);

        self.onFileSelected = function(vm, event) {
            var file = event.target.files[0];
            if (file) {
                self.selectedFile(file);
                self.selectedFileName(file.name);
                self.selectedFileSize(formatFileSize(file.size));
                self.importResult(null);
            } else {
                self.selectedFile(null);
            }
        };

        self.importPersonnel = function() {
            if (!self.selectedFile()) {
                toastr.warning('Lütfen bir CSV dosyası seçin.');
                return;
            }

            self.isLoading(true);
            self.importResult(null);

            var formData = new FormData();
            formData.append('file', self.selectedFile());

            var url = '/api/import/personnel?updateExisting=' + self.updateExisting();

            fetch(url, {
                method: 'POST',
                body: formData,
                credentials: 'include'
            })
            .then(function(response) {
                return response.json().then(function(data) {
                    return { ok: response.ok, data: data };
                });
            })
            .then(function(result) {
                self.importResult(result.data);

                if (result.ok && result.data.success) {
                    toastr.success('İçe aktarma başarıyla tamamlandı!');
                } else if (result.ok && !result.data.success) {
                    toastr.warning('İçe aktarma tamamlandı ancak hatalar var.');
                } else {
                    toastr.error('İçe aktarma başarısız.');
                }
            })
            .catch(function(error) {
                console.error('Import error:', error);
                toastr.error('İçe aktarma sırasında bir hata oluştu.');
            })
            .finally(function() {
                self.isLoading(false);
            });
        };

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            var k = 1024;
            var sizes = ['Bytes', 'KB', 'MB', 'GB'];
            var i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }
    }

    $(document).ready(function() {
        ko.applyBindings(new ImportViewModel(), document.getElementById('import-app'));
    });
</script>
}
