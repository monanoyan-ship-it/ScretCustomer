@{
    Layout = null;
    var token = ViewBag.Token as string;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Egitim Anketi</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg">

    <!-- Bootstrap CSS -->
    <link href="~/lib/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css">

    <!-- Toastr CSS -->
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css">

    <style>
        body {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .quiz-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.3);
            max-width: 800px;
            width: 100%;
            overflow: hidden;
        }
        .quiz-header {
            background: #f8f9fa;
            padding: 1.5rem;
            border-bottom: 1px solid #dee2e6;
        }
        .quiz-body {
            padding: 2rem;
        }
        .option-btn {
            text-align: left;
            padding: 1rem;
            margin-bottom: 0.5rem;
            border: 2px solid #dee2e6;
            border-radius: 8px;
            transition: all 0.2s;
        }
        .option-btn:hover {
            border-color: #0d6efd;
            background: #f8f9fa;
        }
        .option-btn.selected {
            border-color: #0d6efd;
            background: #e7f1ff;
        }
        .option-btn.selected-multi {
            border-color: #198754;
            background: #d1e7dd;
        }
        .progress-indicator {
            display: flex;
            gap: 4px;
            margin-bottom: 1rem;
        }
        .progress-dot {
            height: 4px;
            flex: 1;
            background: #dee2e6;
            border-radius: 2px;
        }
        .progress-dot.active {
            background: #0d6efd;
        }
        .progress-dot.answered {
            background: #198754;
        }
        .result-card {
            text-align: center;
            padding: 3rem 2rem;
        }
        .result-icon {
            font-size: 5rem;
            margin-bottom: 1rem;
        }
        .score-display {
            font-size: 3rem;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="quiz-container" id="quiz-app">
        <!-- Loading -->
        <div data-bind="visible: isLoading" class="text-center p-5">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;"></div>
            <p class="mt-3 text-muted">Anket yukleniyor...</p>
        </div>

        <!-- Error -->
        <div data-bind="visible: hasError" class="text-center p-5">
            <i class="bi bi-exclamation-triangle text-danger" style="font-size: 4rem;"></i>
            <h4 class="mt-3">@Html.T("Common.Error", "Hata")</h4>
            <p class="text-muted" data-bind="text: errorMessage"></p>
            <a href="javascript:history.back()" class="btn btn-secondary mt-3">
                <i class="bi bi-arrow-left"></i> @Html.T("Common.GoBack", "Geri Don")
            </a>
        </div>

        <!-- No Quiz -->
        <div data-bind="visible: !isLoading() && !hasError() && !quizData()" class="text-center p-5">
            <i class="bi bi-clipboard-x text-warning" style="font-size: 4rem;"></i>
            <h4 class="mt-3">Anket Bulunamadi</h4>
            <p class="text-muted">Bu video icin anket tanimlanmamis veya daha once tamamladiniz.</p>
            <a href="javascript:history.back()" class="btn btn-secondary mt-3">
                <i class="bi bi-arrow-left"></i> @Html.T("Common.GoBack", "Geri Don")
            </a>
        </div>

        <!-- Quiz Already Passed -->
        <div data-bind="visible: !isLoading() && !hasError() && quizData() && quizData().lastAttemptResult && quizData().lastAttemptResult.isPassed" class="result-card">
            <i class="bi bi-check-circle-fill text-success result-icon"></i>
            <h3 class="text-success">Anketi Zaten Tamamladiniz!</h3>
            <p class="text-muted">Bu anketi daha once basariyla tamamladiniz.</p>
            <div class="my-4">
                <div class="score-display text-success" data-bind="text: quizData().lastAttemptResult.scorePercentage + '%'"></div>
                <small class="text-muted">Basari Orani</small>
            </div>
            <a href="javascript:history.back()" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> @Html.T("Common.GoBack", "Geri Don")
            </a>
        </div>

        <!-- Quiz Content -->
        <div data-bind="visible: !isLoading() && !hasError() && quizData() && !(quizData().lastAttemptResult && quizData().lastAttemptResult.isPassed) && !showResult()">
            <!-- Header -->
            <div class="quiz-header">
                <h5 class="mb-1" data-bind="text: quizData() ? quizData().title : ''"></h5>
                <small class="text-muted" data-bind="text: quizData() ? quizData().description : ''"></small>
                <!-- ko if: quizData() && quizData().passingScore -->
                <div class="mt-2">
                    <span class="badge bg-info">Gecme Notu: %<span data-bind="text: quizData().passingScore"></span></span>
                </div>
                <!-- /ko -->
            </div>

            <!-- Quiz Body -->
            <div class="quiz-body" data-bind="visible: questions().length > 0">
                <!-- Progress Dots -->
                <div class="progress-indicator" data-bind="foreach: questions">
                    <div class="progress-dot" data-bind="css: { 'active': $index() === $parent.currentIndex(), 'answered': $parent.isQuestionAnswered($index()) }"></div>
                </div>

                <!-- Question -->
                <div data-bind="with: currentQuestion">
                    <div class="mb-4">
                        <span class="badge bg-secondary mb-2">Soru <span data-bind="text: $parent.currentIndex() + 1"></span> / <span data-bind="text: $parent.questions().length"></span></span>
                        <h5 data-bind="text: text"></h5>
                        <!-- ko if: helpText -->
                        <small class="text-muted" data-bind="text: helpText"></small>
                        <!-- /ko -->
                    </div>

                    <!-- Options -->
                    <div data-bind="foreach: options">
                        <button type="button" class="btn option-btn w-100"
                                data-bind="click: $parents[1].selectOption,
                                           css: {
                                               'selected': $parent.questionTypeId === 1 && $parents[1].isOptionSelected($data),
                                               'selected-multi': $parent.questionTypeId === 2 && $parents[1].isOptionSelected($data)
                                           }">
                            <div class="d-flex align-items-center">
                                <!-- ko if: $parent.questionTypeId === 1 -->
                                <i class="bi me-3 fs-5" data-bind="css: { 'bi-circle': !$parents[1].isOptionSelected($data), 'bi-check-circle-fill text-primary': $parents[1].isOptionSelected($data) }"></i>
                                <!-- /ko -->
                                <!-- ko if: $parent.questionTypeId === 2 -->
                                <i class="bi me-3 fs-5" data-bind="css: { 'bi-square': !$parents[1].isOptionSelected($data), 'bi-check-square-fill text-success': $parents[1].isOptionSelected($data) }"></i>
                                <!-- /ko -->
                                <span data-bind="text: text"></span>
                            </div>
                        </button>
                    </div>
                </div>

                <!-- Navigation -->
                <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-outline-secondary"
                            data-bind="click: prevQuestion, visible: currentIndex() > 0">
                        <i class="bi bi-chevron-left"></i> Onceki
                    </button>
                    <div></div>
                    <button type="button" class="btn btn-primary"
                            data-bind="click: nextQuestion, visible: currentIndex() < questions().length - 1">
                        Sonraki <i class="bi bi-chevron-right"></i>
                    </button>
                    <button type="button" class="btn btn-success"
                            data-bind="click: submitQuiz, visible: currentIndex() >= questions().length - 1, disable: isSubmitting">
                        <span data-bind="visible: isSubmitting" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-check-lg" data-bind="visible: !isSubmitting()"></i> Gonder
                    </button>
                </div>
            </div>
        </div>

        <!-- Result -->
        <div data-bind="visible: showResult() && quizResult()" class="result-card">
            <!-- Passed -->
            <div data-bind="visible: quizResult() && quizResult().isPassed">
                <i class="bi bi-check-circle-fill text-success result-icon"></i>
                <h3 class="text-success">Tebrikler!</h3>
                <p class="text-muted">Anketi basariyla tamamladiniz.</p>
            </div>
            <!-- Failed -->
            <div data-bind="visible: quizResult() && !quizResult().isPassed">
                <i class="bi bi-x-circle-fill text-danger result-icon"></i>
                <h3 class="text-danger">Basarisiz</h3>
                <p class="text-muted">Gecme notuna ulasamadiniz. Tekrar deneyebilirsiniz.</p>
            </div>

            <!-- Score -->
            <div class="my-4">
                <div class="score-display" data-bind="text: quizResult() ? quizResult().scorePercentage + '%' : '', css: { 'text-success': quizResult() && quizResult().isPassed, 'text-danger': quizResult() && !quizResult().isPassed }"></div>
                <div class="progress mx-auto mt-2" style="height: 10px; max-width: 300px;">
                    <div class="progress-bar" role="progressbar"
                         data-bind="style: { width: (quizResult() ? quizResult().scorePercentage : 0) + '%' },
                                    css: { 'bg-success': quizResult() && quizResult().isPassed, 'bg-danger': quizResult() && !quizResult().isPassed }"></div>
                </div>
                <div class="mt-2">
                    <span class="text-muted">
                        <span data-bind="text: quizResult() ? quizResult().totalScore : 0"></span> /
                        <span data-bind="text: quizResult() ? quizResult().maxPossibleScore : 0"></span> puan
                    </span>
                </div>
                <!-- ko if: quizResult() && quizResult().passingScore -->
                <small class="text-muted d-block mt-1">Gecme notu: %<span data-bind="text: quizResult().passingScore"></span></small>
                <!-- /ko -->
            </div>

            <!-- Actions -->
            <div class="mt-4">
                <a href="javascript:history.back()" class="btn btn-secondary me-2">
                    <i class="bi bi-arrow-left"></i> @Html.T("Common.GoBack", "Geri Don")
                </a>
                <button type="button" class="btn btn-primary" data-bind="click: retryQuiz, visible: quizResult() && !quizResult().isPassed">
                    <i class="bi bi-arrow-repeat"></i> Tekrar Dene
                </button>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/knockout/knockout-latest.min.js"></script>
    <script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script>
        toastr.options = {
            closeButton: true,
            progressBar: true,
            positionClass: "toast-top-right",
            timeOut: "3000"
        };
    </script>
    <script>
        var PARTICIPANT_TOKEN = '@Html.Raw(token)';
        var IS_EXTERNAL = true;
    </script>
    <script src="~/js/Training/Quiz.js" asp-append-version="true"></script>
</body>
</html>
