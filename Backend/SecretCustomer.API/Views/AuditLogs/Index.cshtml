@{
    ViewData["Title"] = Html.T("AuditLog.Title", "Sistem Logları");
}

<div id="auditlogs-app">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-journal-text me-2"></i>@ViewData["Title"]</h2>
        <button class="btn btn-outline-danger" data-bind="click: cleanupLogs">
            <i class="bi bi-trash me-1"></i> @Html.T("AuditLog.CleanupOldLogs", "Eski Logları Temizle")
        </button>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">@Html.T("AuditLog.LogType", "Log Türü")</label>
                    <select class="form-select" data-bind="value: filter.logType">
                        <option value="">@Html.T("Common.All", "Tümü")</option>
                        <!-- ko foreach: logTypes -->
                        <option data-bind="value: value, text: name"></option>
                        <!-- /ko -->
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Html.T("Setting.Category", "Kategori")</label>
                    <input type="text" class="form-control" placeholder="@Html.T("Setting.Category", "Kategori")"
                           data-bind="value: filter.category, valueUpdate: 'afterkeydown'" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Html.T("AuditLog.UserId", "Kullanıcı ID")</label>
                    <input type="number" class="form-control" placeholder="@Html.T("AuditLog.UserId", "Kullanıcı ID")"
                           data-bind="value: filter.userId" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Html.T("Common.StartDate", "Başlangıç Tarihi")</label>
                    <input type="date" class="form-control" data-bind="value: filter.fromDate" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Html.T("Common.EndDate", "Bitiş Tarihi")</label>
                    <input type="date" class="form-control" data-bind="value: filter.toDate" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" data-bind="click: loadLogs">
                        <i class="bi bi-search me-1"></i> @Html.T("Common.Filter", "Filtrele")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body text-center">
                    <h5 class="card-title">@Html.T("AuditLog.TotalLogs", "Toplam Log")</h5>
                    <h2 data-bind="text: totalCount"></h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body text-center">
                    <h5 class="card-title">@Html.T("Import.Errors", "Hatalar")</h5>
                    <h2 data-bind="text: errorCount"></h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark">
                <div class="card-body text-center">
                    <h5 class="card-title">@Html.T("Import.Warnings", "Uyarılar")</h5>
                    <h2 data-bind="text: warningCount"></h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <h5 class="card-title">@Html.T("AuditLog.SuccessfulLogins", "Başarılı Girişler")</h5>
                    <h2 data-bind="text: loginCount"></h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Logs Table -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 50px;">ID</th>
                            <th style="width: 120px;">@Html.T("AuditLog.Type", "Tür")</th>
                            <th style="width: 100px;">@Html.T("Setting.Category", "Kategori")</th>
                            <th>@Html.T("AuditLog.Message", "Mesaj")</th>
                            <th style="width: 120px;">@Html.T("AuditLog.User", "Kullanıcı")</th>
                            <th style="width: 120px;">@Html.T("AuditLog.IpAddress", "IP Adresi")</th>
                            <th style="width: 160px;">@Html.T("Common.Date", "Tarih")</th>
                            <th style="width: 80px;">@Html.T("Common.Action", "İşlem")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: logs">
                        <tr data-bind="css: { 'table-danger': logTypeId === 2, 'table-warning': logTypeId === 1, 'table-info': logTypeId === 20 }">
                            <td data-bind="text: id"></td>
                            <td>
                                <span class="badge" data-bind="text: logTypeName, css: $parent.getLogTypeBadgeClass(logTypeId)"></span>
                            </td>
                            <td data-bind="text: category || '-'"></td>
                            <td>
                                <span data-bind="text: message.length > 80 ? message.substring(0, 80) + '...' : message"></span>
                            </td>
                            <td data-bind="text: userName || '-'"></td>
                            <td data-bind="text: ipAddress || '-'"></td>
                            <td data-bind="text: $parent.formatDate(createdAt)"></td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" data-bind="click: $parent.showDetail">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Loading -->
            <div class="text-center py-4" data-bind="visible: isLoading">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">@Html.T("Common.Loading", "Yükleniyor...")</span>
                </div>
            </div>

            <!-- No Data -->
            <div class="text-center py-4 text-muted" data-bind="visible: !isLoading() && logs().length === 0">
                <i class="bi bi-inbox fs-1"></i>
                <p>@Html.T("Common.NoRecords", "Kayıt bulunamadı")</p>
            </div>

            <!-- Pagination -->
            <nav data-bind="visible: totalPages() > 1">
                <ul class="pagination">
                    <li class="page-item" data-bind="css: { disabled: currentPage() <= 1 }">
                        <a class="page-link" href="#" data-bind="click: prevPage">@Html.T("Common.Previous", "Önceki")</a>
                    </li>
                    <!-- ko foreach: visiblePages -->
                    <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }">
                        <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                    </li>
                    <!-- /ko -->
                    <li class="page-item" data-bind="css: { disabled: currentPage() >= totalPages() }">
                        <a class="page-link" href="#" data-bind="click: nextPage">@Html.T("Common.Next", "Sonraki")</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

    <!-- Detail Modal -->
    <div class="modal fade" id="detailModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Html.T("AuditLog.LogDetail", "Log Detayı")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" data-bind="with: selectedLog">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>ID:</strong> <span data-bind="text: id"></span>
                        </div>
                        <div class="col-md-6">
                            <strong>@Html.T("AuditLog.Type", "Tür"):</strong>
                            <span class="badge" data-bind="text: logTypeName, css: $parent.getLogTypeBadgeClass(logTypeId)"></span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>@Html.T("Setting.Category", "Kategori"):</strong> <span data-bind="text: category || '-'"></span>
                        </div>
                        <div class="col-md-6">
                            <strong>@Html.T("Common.Date", "Tarih"):</strong> <span data-bind="text: $parent.formatDate(createdAt)"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <strong>@Html.T("AuditLog.Message", "Mesaj"):</strong>
                        <p class="bg-light p-2 rounded" data-bind="text: message"></p>
                    </div>
                    <div class="mb-3" data-bind="visible: details">
                        <strong>@Html.T("Common.Details", "Detaylar"):</strong>
                        <pre class="bg-light p-2 rounded" style="max-height: 200px; overflow-y: auto;" data-bind="text: details"></pre>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>@Html.T("AuditLog.User", "Kullanıcı"):</strong> <span data-bind="text: (userName || '-') + (userId ? ' (ID: ' + userId + ')' : '')"></span>
                        </div>
                        <div class="col-md-6">
                            <strong>@Html.T("AuditLog.IpAddress", "IP Adresi"):</strong> <span data-bind="text: ipAddress || '-'"></span>
                        </div>
                    </div>
                    <div class="mb-3" data-bind="visible: requestUrl">
                        <strong>URL:</strong> <code data-bind="text: httpMethod + ' ' + requestUrl"></code>
                    </div>
                    <div class="mb-3" data-bind="visible: tableName">
                        <strong>@Html.T("AuditLog.Table", "Tablo"):</strong> <span data-bind="text: tableName"></span>
                        <span data-bind="visible: recordId"> (@Html.T("AuditLog.RecordId", "Kayıt ID"): <span data-bind="text: recordId"></span>)</span>
                    </div>
                    <div class="row" data-bind="visible: oldValues || newValues">
                        <div class="col-md-6" data-bind="visible: oldValues">
                            <strong>@Html.T("AuditLog.OldValues", "Eski Değerler"):</strong>
                            <pre class="bg-light p-2 rounded" style="max-height: 150px; overflow-y: auto;" data-bind="text: oldValues"></pre>
                        </div>
                        <div class="col-md-6" data-bind="visible: newValues">
                            <strong>@Html.T("AuditLog.NewValues", "Yeni Değerler"):</strong>
                            <pre class="bg-light p-2 rounded" style="max-height: 150px; overflow-y: auto;" data-bind="text: newValues"></pre>
                        </div>
                    </div>
                    <div class="mb-3" data-bind="visible: exceptionType">
                        <strong>@Html.T("AuditLog.ExceptionType", "Exception Türü"):</strong> <code data-bind="text: exceptionType"></code>
                    </div>
                    <div data-bind="visible: stackTrace">
                        <strong>@Html.T("AuditLog.StackTrace", "Stack Trace"):</strong>
                        <pre class="bg-danger text-white p-2 rounded" style="max-height: 200px; overflow-y: auto; font-size: 0.75rem;" data-bind="text: stackTrace"></pre>
                    </div>
                    <div class="mb-3" data-bind="visible: userAgent">
                        <strong>@Html.T("AuditLog.UserAgent", "User Agent"):</strong>
                        <small class="text-muted" data-bind="text: userAgent"></small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Close", "Kapat")</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/AuditLogs/index.js" asp-append-version="true"></script>
}
