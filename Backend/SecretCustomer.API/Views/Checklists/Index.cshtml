@{
    ViewData["Title"] = Html.T("Checklist.Title", "Kontrol Listeleri");
}

<div id="checklists-app" class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@Html.T("Checklist.Title", "Kontrol Listeleri")</h2>
        <button class="btn btn-primary" data-bind="click: createNew">
            <i class="bi bi-plus-circle"></i> @Html.T("Checklist.NewChecklist", "Yeni Kontrol Listesi")
        </button>
    </div>

    <!-- Arama ve Filtreleme -->
    <div class="card mb-4">
        <div class="card-body py-3">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label mb-1">@Html.T("Common.Search", "Ara")</label>
                    <input type="text" class="form-control" data-bind="value: searchText, valueUpdate: 'afterkeydown', event: { keypress: function(data, event) { if (event.keyCode === 13) { search(); return false; } return true; } }" placeholder="@Html.T("Checklist.SearchPlaceholder", "İsim, açıklama veya kod...")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label mb-1">@Html.T("Common.Customer", "Firma")</label>
                    <select class="form-select" data-bind="value: filterCustomerId, options: customers, optionsText: 'companyName', optionsValue: 'id', optionsCaption: '@Html.T("Common.All", "Tümü")'"></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label mb-1">@Html.T("Common.Organization", "Organizasyon")</label>
                    <select class="form-select" data-bind="value: filterOrganizationId, options: filterOrganizations, optionsText: 'name', optionsValue: 'id', optionsCaption: '@Html.T("Common.All", "Tümü")', enable: filterCustomerId()"></select>
                </div>
                <div class="col-md-2">
                    <div class="btn-group w-100">
                        <button type="button" class="btn btn-primary" data-bind="click: search">
                            <i class="bi bi-search"></i> @Html.T("Common.Search", "Ara")
                        </button>
                        <button type="button" class="btn btn-outline-secondary" data-bind="click: clearFilters" title="@Html.T("Common.ClearFilters", "Filtreleri Temizle")">
                            <i class="bi bi-x-circle"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>

    <!-- Error Message -->
    <div data-bind="visible: errorMessage" class="alert alert-danger alert-dismissible fade show">
        <span data-bind="text: errorMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { errorMessage(''); }"></button>
    </div>

    <!-- Success Message -->
    <div data-bind="visible: successMessage" class="alert alert-success alert-dismissible fade show">
        <span data-bind="text: successMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { successMessage(''); }"></button>
    </div>

    <!-- Checklists List -->
    <div data-bind="visible: !isLoading()">
        <!-- Empty State -->
        <div data-bind="visible: checklists().length === 0">
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> @Html.T("Checklist.NoChecklists", "Henüz kontrol listesi bulunmamaktadır.")
            </div>
        </div>

        <!-- Checklist Table -->
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>@Html.T("Checklist.Name", "Adı")</th>
                                <th>@Html.T("Common.Customer", "Firma")</th>
                                <th class="text-center">@Html.T("Checklist.Questions", "Soru")</th>
                                <th class="text-center">@Html.T("Common.Version", "Versiyon")</th>
                                <th class="text-center">@Html.T("Common.Status", "Durum")</th>
                                <th class="text-center" style="width: 150px;">@Html.T("Common.Actions", "İşlemler")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: checklists">
                            <tr>
                                <td>
                                    <strong data-bind="text: name"></strong>
                                    <br /><small class="text-muted" data-bind="text: description || ''"></small>
                                </td>
                                <td>
                                    <!-- ko if: customerName -->
                                    <span data-bind="text: customerName"></span>
                                    <!-- ko if: customerOrganizationName -->
                                    <br /><small class="text-muted" data-bind="text: customerOrganizationName"></small>
                                    <!-- /ko -->
                                    <!-- /ko -->
                                    <!-- ko ifnot: customerName -->
                                    <span class="badge bg-light text-dark">@Html.T("Checklist.General", "Genel")</span>
                                    <!-- /ko -->
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info" data-bind="text: questionCount || (questions && questions.length) || 0"></span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary">v<span data-bind="text: version || 1"></span></span>
                                </td>
                                <td class="text-center">
                                    <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? '@Html.T("Common.Active", "Aktif")' : '@Html.T("Common.Inactive", "Pasif")'"></span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" data-bind="click: $parent.viewChecklist" title="@Html.T("Common.View", "Görüntüle")">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary" data-bind="click: $parent.editChecklist" title="@Html.T("Common.Edit", "Düzenle")">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-info" data-bind="click: $parent.cloneChecklist" title="@Html.T("Checklist.Clone", "Klonla")">
                                            <i class="bi bi-files"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" data-bind="click: $parent.deleteChecklist" title="@Html.T("Common.Delete", "Sil")">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Create/Edit Modal - 4 Adımlı Wizard -->
<div class="modal fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content" data-bind="with: editingChecklist">
            <div class="modal-header">
                <h5 class="modal-title">
                    <!-- ko ifnot: id -->
                    <i class="bi bi-plus-circle me-2"></i>@Html.T("Checklist.NewChecklist", "Yeni Kontrol Listesi")
                    <!-- /ko -->
                    <!-- ko if: id -->
                    <i class="bi bi-pencil me-2"></i>@Html.T("Checklist.EditChecklist", "Kontrol Listesi Düzenle")
                    <!-- /ko -->
                </h5>
                <button type="button" class="btn-close" data-bind="click: $parent.closeModal"></button>
            </div>
            <div class="modal-body">
                <!-- Modal Hata Mesajı -->
                <div data-bind="visible: $root.modalErrorMessage()" class="alert alert-danger alert-dismissible mb-3">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <span data-bind="text: $root.modalErrorMessage()"></span>
                    <button type="button" class="btn-close" data-bind="click: function() { $root.modalErrorMessage(''); }"></button>
                </div>

                <!-- Wizard Steps -->
                <ul class="nav nav-pills nav-justified mb-4" data-bind="with: $parent">
                    <li class="nav-item">
                        <a class="nav-link" data-bind="css: { active: wizardStep() === 1 }, click: function() { wizardStep(1); }">
                            <span class="badge rounded-pill me-2" data-bind="css: { 'bg-primary': wizardStep() === 1, 'bg-secondary': wizardStep() !== 1 }">1</span>
                            @Html.T("Checklist.Step1.GeneralInfo", "Genel Bilgiler")
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bind="css: { active: wizardStep() === 2 }, click: function() { wizardStep(2); }">
                            <span class="badge rounded-pill me-2" data-bind="css: { 'bg-primary': wizardStep() === 2, 'bg-secondary': wizardStep() !== 2 }">2</span>
                            @Html.T("Checklist.Step2.Questions", "Sorular")
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bind="css: { active: wizardStep() === 3 }, click: function() { wizardStep(3); }">
                            <span class="badge rounded-pill me-2" data-bind="css: { 'bg-primary': wizardStep() === 3, 'bg-secondary': wizardStep() !== 3 }">3</span>
                            @Html.T("Checklist.Step3.AuditSettings", "Denetim Ayarları")
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bind="css: { active: wizardStep() === 4 }, click: function() { wizardStep(4); }">
                            <span class="badge rounded-pill me-2" data-bind="css: { 'bg-primary': wizardStep() === 4, 'bg-secondary': wizardStep() !== 4 }">4</span>
                            @Html.T("Checklist.Step4.Summary", "Özet")
                        </a>
                    </li>
                </ul>

                <!-- Step 1: Genel Bilgiler -->
                <div data-bind="visible: $parent.wizardStep() === 1">
                    <h6 class="border-bottom pb-2 mb-3"><i class="bi bi-info-circle"></i> @Html.T("Checklist.Step1.GeneralInfo", "Genel Bilgiler")</h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Checklist.ChecklistName", "Kontrol Listesi Adı") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: name" placeholder="@Html.T("Checklist.NamePlaceholder", "Örn: Çağrı Performans Değerlendirmesi")" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">@Html.T("Checklist.Code", "K.L. Kodu")</label>
                            <input type="text" class="form-control" data-bind="value: code" placeholder="KL-001" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">@Html.T("Checklist.Version", "Versiyon")</label>
                            <input type="number" class="form-control" data-bind="value: version" min="1" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Checklist.TemplateName", "Şablon Adı")</label>
                            <input type="text" class="form-control" data-bind="value: templateName" placeholder="@Html.T("Checklist.TemplateNamePlaceholder", "Çağrı Performans")" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">@Html.T("Checklist.Type", "K.L. Tipi")</label>
                            <select class="form-select" data-bind="value: checklistType">
                                <option value="CallPerformance">@Html.T("Checklist.Type.CallPerformance", "Çağrı Performans")</option>
                                <option value="PhysicalAudit">@Html.T("Checklist.Type.PhysicalAudit", "Fiziksel Denetim")</option>
                                <option value="MysteryShopping">@Html.T("Checklist.Type.MysteryShopping", "Gizli Müşteri")</option>
                                <option value="OnlineEvaluation">@Html.T("Checklist.Type.OnlineEvaluation", "Online Değerlendirme")</option>
                                <option value="Survey">@Html.T("Checklist.Type.Survey", "Anket")</option>
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">@Html.T("Checklist.ScoringMethod", "Puanlama Yöntemi")</label>
                            <select class="form-select" data-bind="value: scoringMethod">
                                <option value="Maximum">@Html.T("Checklist.ScoringMethod.Maximum", "Maksimum")</option>
                                <option value="Average">@Html.T("Checklist.ScoringMethod.Average", "Ortalama")</option>
                                <option value="WeightedAverage">@Html.T("Checklist.ScoringMethod.WeightedAverage", "Ağırlıklı Ortalama")</option>
                                <option value="Sum">@Html.T("Checklist.ScoringMethod.Sum", "Toplam")</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.T("Common.Description", "Açıklama")</label>
                        <textarea class="form-control" data-bind="value: description" rows="2" placeholder="@Html.T("Checklist.DescriptionPlaceholder", "Kontrol listesi hakkında kısa açıklama...")"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">@Html.T("Checklist.MaxTotalPoints", "Maks. Toplam Puan")</label>
                            <input type="number" class="form-control" data-bind="value: maxTotalPoints" min="0" />
                            <small class="text-muted">@Html.T("Checklist.MaxTotalPointsHelp", "Varsayılan: 100")</small>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">@Html.T("Checklist.ValidFrom", "Geçerlilik Başlangıç")</label>
                            <input type="date" class="form-control" data-bind="value: validFrom" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">@Html.T("Checklist.ValidUntil", "Geçerlilik Bitiş")</label>
                            <input type="date" class="form-control" data-bind="value: validUntil" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-check mt-2">
                                <input type="checkbox" class="form-check-input" data-bind="checked: isScored" id="isScored" />
                                <label class="form-check-label" for="isScored">@Html.T("Checklist.IsScored", "Puanlı")</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check mt-2">
                                <input type="checkbox" class="form-check-input" data-bind="checked: isActive" id="isActive" />
                                <label class="form-check-label" for="isActive">@Html.T("Common.Active", "Aktif")</label>
                            </div>
                        </div>
                    </div>

                    <hr class="my-3" />
                    <h6 class="border-bottom pb-2 mb-3"><i class="bi bi-building"></i> @Html.T("Common.Customer", "Firma")</h6>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Common.Customer", "Firma")</label>
                            <select class="form-select" data-bind="value: $root.selectedCustomerId, options: $root.customers, optionsText: 'companyName', optionsValue: 'id', optionsCaption: '@Html.T("Common.SelectCustomer", "-- Firma Seçin (Genel) --")'"></select>
                            <small class="text-muted">@Html.T("Checklist.CustomerHelp", "Boş bırakılırsa tüm firmalar için geçerli olur")</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Common.Organization", "Organizasyon/Şube")</label>
                            <select class="form-select" data-bind="value: customerOrganizationId, options: $root.organizations, optionsText: 'name', optionsValue: 'id', optionsCaption: '@Html.T("Common.SelectOrganization", "-- Organizasyon Seçin (Tümü) --")', enable: $root.selectedCustomerId()"></select>
                            <small class="text-muted">@Html.T("Checklist.OrganizationHelp", "Boş bırakılırsa tüm organizasyonlar için geçerli olur")</small>
                        </div>
                    </div>
                </div>

                <!-- Step 2: Sorular (Direkt Checklist'e Bağlı) -->
                <div data-bind="visible: $parent.wizardStep() === 2">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="border-bottom pb-2 mb-0"><i class="bi bi-list-check"></i> @Html.T("Checklist.Questions", "Sorular")</h6>
                        <button type="button" class="btn btn-sm btn-success" data-bind="click: addQuestion">
                            <i class="bi bi-plus-circle"></i> @Html.T("Checklist.AddQuestion", "Soru Ekle")
                        </button>
                    </div>

                    <!-- Questions -->
                    <div data-bind="foreach: questions">
                        <div class="card mb-3" data-bind="css: { 'border-warning': penaltyType() === 'YellowCard', 'border-danger': penaltyType() === 'RedCard' }">
                            <div class="card-header d-flex justify-content-between align-items-center py-2" data-bind="css: { 'bg-light': scoringType() === 'Scored', 'bg-warning': scoringType() === 'Penalty', 'bg-secondary text-white': scoringType() === 'Unscored' }">
                                <span>
                                    <i class="bi bi-question-circle me-1"></i>
                                    <strong>@Html.T("Checklist.Question", "Soru") #<span data-bind="text: $index() + 1"></span></strong>
                                </span>
                                <button type="button" class="btn btn-sm btn-outline-danger" data-bind="click: $parent.removeQuestion">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-8 mb-2">
                                        <label class="form-label">@Html.T("Checklist.QuestionText", "Soru Metni") <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" data-bind="value: text" placeholder="@Html.T("Checklist.QuestionTextPlaceholder", "Soru metni")" />
                                    </div>
                                    <div class="col-md-2 mb-2">
                                        <label class="form-label">@Html.T("Checklist.Scoring", "Puanlama")</label>
                                        <select class="form-select" data-bind="value: scoringType">
                                            <option value="Scored">@Html.T("Checklist.ScoringType.Scored", "Puanlı")</option>
                                            <option value="Unscored">@Html.T("Checklist.ScoringType.Unscored", "Puansız")</option>
                                            <option value="Penalty">@Html.T("Checklist.ScoringType.Penalty", "Cezalı")</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2 mb-2">
                                        <label class="form-label">@Html.T("Checklist.Order", "Sıra")</label>
                                        <input type="number" class="form-control" data-bind="value: order" min="1" />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-2 mb-2">
                                        <label class="form-label">@Html.T("Checklist.WeightPoints", "Ağırlık Puanı")</label>
                                        <input type="number" class="form-control" data-bind="value: weightPoints" min="0" step="0.1" />
                                    </div>
                                    <div class="col-md-2 mb-2">
                                        <label class="form-label">@Html.T("Checklist.ScaleSteps", "Kırılım")</label>
                                        <input type="number" class="form-control" data-bind="value: scaleSteps" min="1" max="10" />
                                        <small class="text-muted">@Html.T("Checklist.ScaleStepsHelp", "1=Evet/Hayır, 4=Detaylı")</small>
                                    </div>
                                    <div class="col-md-2 mb-2" data-bind="visible: scoringType() === 'Penalty'">
                                        <label class="form-label">@Html.T("Checklist.PenaltyType", "Ceza Tipi")</label>
                                        <select class="form-select" data-bind="value: penaltyType">
                                            <option value="None">@Html.T("Checklist.PenaltyType.None", "Yok")</option>
                                            <option value="YellowCard">@Html.T("Checklist.PenaltyType.YellowCard", "Sarı Kart")</option>
                                            <option value="RedCard">@Html.T("Checklist.PenaltyType.RedCard", "Kırmızı Kart")</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2 mb-2" data-bind="visible: scoringType() === 'Penalty'">
                                        <label class="form-label">@Html.T("Checklist.PenaltyValue", "Ceza Değeri")</label>
                                        <input type="number" class="form-control" data-bind="value: penaltyValue" min="0" />
                                    </div>
                                    <div class="col-md-2 mb-2">
                                        <label class="form-label d-block">&nbsp;</label>
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input" data-bind="checked: allowNA" />
                                            <label class="form-check-label">@Html.T("Checklist.AllowNA", "N/A İzin Ver")</label>
                                        </div>
                                    </div>
                                    <div class="col-md-2 mb-2">
                                        <label class="form-label d-block">&nbsp;</label>
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input" data-bind="checked: isRequired" />
                                            <label class="form-check-label">@Html.T("Checklist.Required", "Zorunlu")</label>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <label class="form-label">@Html.T("Checklist.RecommendedNote", "Önerilen Açıklama")</label>
                                        <input type="text" class="form-control form-control-sm" data-bind="value: recommendedNote" placeholder="@Html.T("Checklist.RecommendedNotePlaceholder", "Değerlendirici için öneri")" />
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <label class="form-label">@Html.T("Checklist.HelpText", "Yardımcı Metin")</label>
                                        <input type="text" class="form-control form-control-sm" data-bind="value: helpText" placeholder="@Html.T("Checklist.HelpTextPlaceholder", "Soru hakkında ipucu")" />
                                    </div>
                                </div>

                                <!-- Dosya Ekleri -->
                                <div class="row mt-2" data-bind="visible: id">
                                    <div class="col-12">
                                        <label class="form-label"><i class="bi bi-paperclip"></i> @Html.T("Checklist.FileAttachments", "Dosya Ekleri")</label>

                                        <!-- Mevcut Dosyalar -->
                                        <div class="mb-2" data-bind="visible: _attachments && _attachments().length > 0">
                                            <div class="list-group list-group-flush" data-bind="foreach: _attachments">
                                                <div class="list-group-item d-flex justify-content-between align-items-center py-1 px-2">
                                                    <div>
                                                        <i class="bi bi-file-earmark me-1"></i>
                                                        <a data-bind="attr: { href: downloadUrl || ('/api/question-attachments/' + id + '/download') }, text: fileName" target="_blank" class="text-decoration-none"></a>
                                                        <small class="text-muted ms-2" data-bind="text: fileSizeFormatted || ''"></small>
                                                    </div>
                                                    <button type="button" class="btn btn-sm btn-outline-danger py-0" data-bind="click: function() { $root.removeQuestionAttachment($data, $parent); }">
                                                        <i class="bi bi-x"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Dosya Yükleme -->
                                        <div class="input-group input-group-sm">
                                            <input type="file" class="form-control form-control-sm" data-bind="attr: { id: 'file-' + (id() || 'new-' + $index()) }, event: { change: function(data, event) { $root.uploadQuestionAttachment($data, event.target); } }" accept=".jpg,.jpeg,.png,.gif,.pdf,.doc,.docx,.xls,.xlsx,.txt" />
                                            <span class="input-group-text" data-bind="visible: _isUploadingFile && _isUploadingFile()">
                                                <span class="spinner-border spinner-border-sm"></span>
                                            </span>
                                        </div>
                                        <small class="text-muted">@Html.T("Checklist.FileUploadInfo", "Maks 10MB. İzin verilen: jpg, png, gif, pdf, doc, docx, xls, xlsx, txt")</small>
                                    </div>
                                </div>
                                <div class="row mt-2" data-bind="visible: !id">
                                    <div class="col-12">
                                        <small class="text-muted"><i class="bi bi-info-circle"></i> @Html.T("Checklist.SaveBeforeAttaching", "Dosya eklemek için önce kontrol listesini kaydedin.")</small>
                                    </div>
                                </div>

                                <!-- Alt Kriterler / Öneriler -->
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <label class="form-label mb-0">
                                                <i class="bi bi-list-check"></i> @Html.T("Checklist.SubCriteria", "Alt Kriterler/Öneriler")
                                                <small class="text-muted ms-1" data-bind="visible: subCriteria && subCriteria().length > 0, text: '(' + (subCriteria ? subCriteria().length : 0) + ')'"></small>
                                            </label>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bind="click: function() { _showSubCriteria(!_showSubCriteria()); }">
                                                <i class="bi" data-bind="css: { 'bi-chevron-down': !_showSubCriteria(), 'bi-chevron-up': _showSubCriteria() }"></i>
                                            </button>
                                        </div>

                                        <div class="mt-2" data-bind="visible: _showSubCriteria">
                                            <!-- Mevcut Alt Kriterler -->
                                            <div data-bind="foreach: subCriteria">
                                                <div class="row mb-1 align-items-center">
                                                    <div class="col-md-6">
                                                        <input type="text" class="form-control form-control-sm" data-bind="value: description" placeholder="@Html.T("Checklist.SubCriteriaDescription", "Alt kriter açıklaması")" />
                                                    </div>
                                                    <div class="col-md-2">
                                                        <input type="number" class="form-control form-control-sm" data-bind="value: weightPoints" min="0" step="0.1" title="@Html.T("Checklist.WeightPoints", "Ağırlık Puanı")" />
                                                    </div>
                                                    <div class="col-md-2">
                                                        <input type="number" class="form-control form-control-sm" data-bind="value: order" min="1" title="@Html.T("Checklist.Order", "Sıra")" />
                                                    </div>
                                                    <div class="col-md-2">
                                                        <button type="button" class="btn btn-sm btn-outline-danger w-100" data-bind="click: function() { $parent.removeSubCriteria($data); }">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Yeni Alt Kriter Ekle Butonu -->
                                            <button type="button" class="btn btn-sm btn-outline-primary mt-1" data-bind="click: addSubCriteria">
                                                <i class="bi bi-plus"></i> @Html.T("Checklist.AddSubCriteria", "Alt Kriter Ekle")
                                            </button>
                                            <small class="text-muted d-block mt-1">@Html.T("Checklist.SubCriteriaHelp", "Alt kriterler değerlendirme sırasında puan düşürme nedeni olarak seçilebilir.")</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div data-bind="visible: questions().length === 0" class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i> @Html.T("Checklist.NoQuestionsWarning", "Henüz soru eklenmemiş. Lütfen en az bir soru ekleyin.")
                    </div>
                </div>

                <!-- Step 3: Denetim Ayarları -->
                <div data-bind="visible: $parent.wizardStep() === 3">
                    <h6 class="border-bottom pb-2 mb-3"><i class="bi bi-gear"></i> @Html.T("Checklist.Step3.AuditSettings", "Denetim Ayarları")</h6>
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> @Html.T("Checklist.AuditSettingsInfo", "Denetim ayarları, değerlendirme sırasında kullanılacak ek yapılandırmaları içerir.")
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header bg-warning">
                                    <i class="bi bi-exclamation-triangle"></i> @Html.T("Checklist.YellowCardCriteria", "Sarı Kart Kriterleri")
                                </div>
                                <div class="card-body">
                                    <p class="text-muted">@Html.T("Checklist.YellowCardInfo", "Sarı kart verilmesi gereken durumlar \"Cezalı\" tip ile tanımlanır.")</p>
                                    <ul class="list-unstyled" data-bind="foreach: questions">
                                        <!-- ko if: penaltyType() === 'YellowCard' -->
                                        <li><i class="bi bi-check text-warning"></i> <span data-bind="text: text"></span></li>
                                        <!-- /ko -->
                                    </ul>
                                    <p class="text-muted" data-bind="visible: questions().filter(function(q) { return q.penaltyType() === 'YellowCard'; }).length === 0">
                                        <i class="bi bi-dash"></i> @Html.T("Checklist.NoYellowCard", "Sarı kart sorusu tanımlanmamış.")
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header bg-danger text-white">
                                    <i class="bi bi-x-circle"></i> @Html.T("Checklist.RedCardCriteria", "Kırmızı Kart Kriterleri")
                                </div>
                                <div class="card-body">
                                    <p class="text-muted">@Html.T("Checklist.RedCardInfo", "Kırmızı kart verilmesi gereken durumlar \"Cezalı\" tip ile tanımlanır.")</p>
                                    <ul class="list-unstyled" data-bind="foreach: questions">
                                        <!-- ko if: penaltyType() === 'RedCard' -->
                                        <li><i class="bi bi-x text-danger"></i> <span data-bind="text: text"></span></li>
                                        <!-- /ko -->
                                    </ul>
                                    <p class="text-muted" data-bind="visible: questions().filter(function(q) { return q.penaltyType() === 'RedCard'; }).length === 0">
                                        <i class="bi bi-dash"></i> @Html.T("Checklist.NoRedCard", "Kırmızı kart sorusu tanımlanmamış.")
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 4: Özet -->
                <div data-bind="visible: $parent.wizardStep() === 4">
                    <h6 class="border-bottom pb-2 mb-3"><i class="bi bi-clipboard-check"></i> @Html.T("Checklist.SummaryInfo", "Özet Bilgiler")</h6>
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-sm">
                                <tr><th>@Html.T("Checklist.ChecklistName", "Kontrol Listesi Adı"):</th><td data-bind="text: name"></td></tr>
                                <tr><th>@Html.T("Checklist.Code", "Kod"):</th><td data-bind="text: code || '-'"></td></tr>
                                <tr><th>@Html.T("Checklist.TemplateName", "Şablon"):</th><td data-bind="text: templateName || '-'"></td></tr>
                                <tr><th>@Html.T("Checklist.Type", "Tip"):</th><td data-bind="text: checklistType"></td></tr>
                                <tr><th>@Html.T("Checklist.ScoringMethod", "Puanlama Yöntemi"):</th><td data-bind="text: scoringMethod"></td></tr>
                                <tr><th>@Html.T("Checklist.MaxTotalPoints", "Maks. Puan"):</th><td data-bind="text: maxTotalPoints"></td></tr>
                                <tr><th>@Html.T("Common.Customer", "Firma"):</th><td data-bind="text: $parent.getSelectedCustomerName() || '@Html.T("Checklist.General", "Genel")'"></td></tr>
                                <tr><th>@Html.T("Common.Organization", "Organizasyon"):</th><td data-bind="text: $parent.getSelectedOrganizationName() || '@Html.T("Checklist.AllOrganizations", "Tüm Organizasyonlar")'"></td></tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-sm">
                                <tr><th>@Html.T("Checklist.TotalQuestions", "Toplam Soru"):</th><td data-bind="text: questions().length"></td></tr>
                                <tr><th>@Html.T("Checklist.ScoredQuestions", "Puanlı Soru"):</th><td data-bind="text: questions().filter(function(q) { return q.scoringType() === 'Scored'; }).length"></td></tr>
                                <tr><th>@Html.T("Checklist.YellowCardQuestions", "Sarı Kart Sorusu"):</th><td data-bind="text: questions().filter(function(q) { return q.penaltyType() === 'YellowCard'; }).length"></td></tr>
                                <tr><th>@Html.T("Checklist.RedCardQuestions", "Kırmızı Kart Sorusu"):</th><td data-bind="text: questions().filter(function(q) { return q.penaltyType() === 'RedCard'; }).length"></td></tr>
                                <tr><th>@Html.T("Checklist.TotalWeightPoints", "Toplam Ağırlık Puanı"):</th><td data-bind="text: questions().reduce(function(sum, q) { return sum + (parseFloat(q.weightPoints()) || 0); }, 0).toFixed(1)"></td></tr>
                                <tr><th>@Html.T("Common.Status", "Durum"):</th><td><span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? '@Html.T("Common.Active", "Aktif")' : '@Html.T("Common.Inactive", "Pasif")'"></span></td></tr>
                            </table>
                        </div>
                    </div>

                    <h6 class="mt-4">@Html.T("Checklist.QuestionSummary", "Soru Özeti")</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>@Html.T("Checklist.QuestionText", "Soru")</th>
                                    <th>@Html.T("Checklist.ScoringType", "Puanlama")</th>
                                    <th>@Html.T("Checklist.WeightPoints", "Ağırlık")</th>
                                    <th>@Html.T("Checklist.ScaleSteps", "Kırılım")</th>
                                    <th>@Html.T("Checklist.SubCriteria", "Alt Kriter")</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: questions">
                                <tr>
                                    <td data-bind="text: $index() + 1"></td>
                                    <td data-bind="text: text"></td>
                                    <td>
                                        <span class="badge" data-bind="css: { 'bg-success': scoringType() === 'Scored', 'bg-warning': scoringType() === 'Penalty', 'bg-secondary': scoringType() === 'Unscored' }, text: scoringType"></span>
                                    </td>
                                    <td data-bind="text: weightPoints"></td>
                                    <td data-bind="text: scaleSteps"></td>
                                    <td data-bind="text: (subCriteria && subCriteria().length) || 0"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bind="click: $parent.closeModal">
                    <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Cancel", "İptal")
                </button>
                <button type="button" class="btn btn-outline-primary" data-bind="visible: $parent.wizardStep() > 1, click: $parent.prevStep">
                    <i class="bi bi-arrow-left"></i> @Html.T("Common.Back", "Geri")
                </button>
                <button type="button" class="btn btn-primary" data-bind="visible: $parent.wizardStep() < 4, click: $parent.nextStep">
                    @Html.T("Common.Next", "İleri") <i class="bi bi-arrow-right"></i>
                </button>
                <button type="button" class="btn btn-success" data-bind="visible: $parent.wizardStep() === 4, click: $parent.saveChecklist, disable: $parent.isSaving">
                    <span data-bind="visible: !$parent.isSaving()">
                        <i class="bi bi-save"></i> @Html.T("Common.Save", "Kaydet")
                    </span>
                    <span data-bind="visible: $parent.isSaving">
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        @Html.T("Common.Saving", "Kaydediliyor...")
                    </span>
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal-backdrop fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }"></div>

<!-- View Modal -->
<div class="modal fade" data-bind="css: { show: isViewModalOpen }, style: { display: isViewModalOpen() ? 'block' : 'none' }" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content" data-bind="with: viewingChecklist">
            <div class="modal-header">
                <h5 class="modal-title" data-bind="text: name"></h5>
                <button type="button" class="btn-close" data-bind="click: $parent.closeViewModal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted" data-bind="text: description || '@Html.T("Common.NoDescription", "Açıklama yok")'"></p>
                <div class="mb-3">
                    <span class="badge bg-secondary">@Html.T("Checklist.Version", "Versiyon"): <span data-bind="text: version"></span></span>
                    <span class="badge bg-info ms-2"><span data-bind="text: questionCount || (questions && questions.length) || 0"></span> @Html.T("Checklist.Questions", "Soru")</span>
                </div>

                <hr>

                <!-- Questions (Read-only) -->
                <table class="table table-sm table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>@Html.T("Checklist.QuestionText", "Soru")</th>
                            <th>@Html.T("Checklist.ScoringType", "Puanlama")</th>
                            <th>@Html.T("Checklist.WeightPoints", "Ağırlık")</th>
                            <th>@Html.T("Checklist.ScaleSteps", "Kırılım")</th>
                            <th>N/A</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: questions || []">
                        <tr>
                            <td data-bind="text: $index() + 1"></td>
                            <td>
                                <span data-bind="text: text"></span>
                                <!-- ko if: subCriteria && subCriteria.length > 0 -->
                                <br /><small class="text-muted"><i class="bi bi-list-check"></i> <span data-bind="text: subCriteria.length"></span> @Html.T("Checklist.SubCriteria", "alt kriter")</small>
                                <!-- /ko -->
                            </td>
                            <td>
                                <span class="badge" data-bind="css: { 'bg-success': scoringType === 'Scored', 'bg-warning': scoringType === 'Penalty', 'bg-secondary': scoringType === 'Unscored' }, text: scoringTypeName || scoringType"></span>
                            </td>
                            <td data-bind="text: weightPoints"></td>
                            <td data-bind="text: scaleSteps"></td>
                            <td>
                                <span data-bind="visible: allowNA" class="text-success">
                                    <i class="bi bi-check-circle-fill"></i>
                                </span>
                                <span data-bind="visible: !allowNA" class="text-muted">
                                    <i class="bi bi-dash-circle"></i>
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bind="click: $parent.closeViewModal">
                    <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Close", "Kapat")
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal-backdrop fade" data-bind="css: { show: isViewModalOpen }, style: { display: isViewModalOpen() ? 'block' : 'none' }"></div>

<partial name="_DeleteConfirmationModal" />

</div> <!-- End of checklists-app -->

@section Scripts {
    <script src="~/js/Shared/app.config.js"></script>
    <script src="~/js/Shared/api.service.js"></script>
    <script src="~/js/Shared/enums.service.js"></script>
    <script src="~/js/Shared/delete-confirmation.js"></script>
    <script src="~/js/Checklists/checklist.js"></script>
}
