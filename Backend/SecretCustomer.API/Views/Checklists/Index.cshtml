@{
    ViewData["Title"] = Html.T("Checklist.Title", "Kontrol Listeleri");
}

<div id="checklists-app" class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@Html.T("Checklist.Title", "Kontrol Listeleri")</h2>
        <button class="btn btn-primary" data-bind="click: createNew">
            <i class="bi bi-plus-circle"></i> @Html.T("Checklist.NewChecklist", "Yeni Kontrol Listesi")
        </button>
    </div>

    <!-- Arama ve Filtreleme -->
    <div class="card mb-4">
        <div class="card-body py-3">
            <div class="row g-2 align-items-end">
                <div class="col-md-11">
                    <label class="form-label mb-1">@Html.T("Common.Search", "Ara")</label>
                    <input type="text" class="form-control" data-bind="value: searchText, valueUpdate: 'input', event: { input: loadChecklists }" placeholder="@Html.T("Checklist.SearchPlaceholder", "İsim, açıklama veya kod...")" />
                </div>
                <div class="col-md-1">
                    <button type="button" class="btn btn-outline-secondary w-100" data-bind="click: clearFilters" title="@Html.T("Common.ClearFilters", "Filtreleri Temizle")">
                        <i class="bi bi-x-circle"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>

    <!-- Checklists List -->
    <div data-bind="visible: !isLoading()">
        <!-- Empty State -->
        <div data-bind="visible: checklists().length === 0">
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> @Html.T("Checklist.NoChecklists", "Henüz kontrol listesi bulunmamaktadır.")
            </div>
        </div>

        <!-- Checklist Table -->
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="sortable" data-bind="click: function() { sorting.toggleSort('name'); }, css: sorting.getSortClass('name')">
                                    @Html.T("Checklist.Name", "Adı")
                                    <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('name')"></i>
                                </th>
                                <th class="text-center sortable" data-bind="click: function() { sorting.toggleSort('questionCount'); }, css: sorting.getSortClass('questionCount')">
                                    @Html.T("Checklist.Questions", "Soru")
                                    <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('questionCount')"></i>
                                </th>
                                <th class="text-center sortable" data-bind="click: function() { sorting.toggleSort('version'); }, css: sorting.getSortClass('version')">
                                    @Html.T("Common.Version", "Versiyon")
                                    <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('version')"></i>
                                </th>
                                <th class="text-center sortable" data-bind="click: function() { sorting.toggleSort('isActive'); }, css: sorting.getSortClass('isActive')">
                                    @Html.T("Common.Status", "Durum")
                                    <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('isActive')"></i>
                                </th>
                                <th class="text-center" style="width: 150px;">@Html.T("Common.Actions", "İşlemler")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: checklists">
                            <tr>
                                <td>
                                    <strong data-bind="text: name"></strong>
                                    <br /><small class="text-muted" data-bind="text: description || ''"></small>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info" data-bind="text: questionCount || (questions && questions.length) || 0"></span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary">v<span data-bind="text: version || 1"></span></span>
                                </td>
                                <td class="text-center">
                                    <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? '@Html.T("Common.Active", "Aktif")' : '@Html.T("Common.Inactive", "Pasif")'"></span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" data-bind="click: $parent.viewChecklist" title="@Html.T("Common.View", "Görüntüle")">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary" data-bind="click: $parent.editChecklist" title="@Html.T("Common.Edit", "Düzenle")">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-info" data-bind="click: $parent.cloneChecklist" title="@Html.T("Checklist.Clone", "Klonla")">
                                            <i class="bi bi-files"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" data-bind="click: $parent.deleteChecklist" title="@Html.T("Common.Delete", "Sil")">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

<!-- View Modal -->
<div class="modal fade" data-bind="css: { show: isViewModalOpen }, style: { display: isViewModalOpen() ? 'block' : 'none' }" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <!-- Loading State -->
            <div data-bind="visible: isEditLoading" class="text-center py-5">
                <div class="spinner-border text-primary"></div>
                <p class="mt-2 text-muted">@Html.T("Common.Loading", "Yükleniyor...")</p>
            </div>
            <!-- Content (with viewingChecklist) -->
            <!-- ko with: viewingChecklist -->
            <div class="modal-header">
                <h5 class="modal-title" data-bind="text: name"></h5>
                <button type="button" class="btn-close" data-bind="click: $parent.closeViewModal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted" data-bind="text: description || '@Html.T("Common.NoDescription", "Açıklama yok")'"></p>
                <div class="mb-3">
                    <span class="badge bg-secondary">@Html.T("Checklist.Version", "Versiyon"): <span data-bind="text: version"></span></span>
                    <span class="badge bg-info ms-2"><span data-bind="text: questionCount || (questions && questions.length) || 0"></span> @Html.T("Checklist.Questions", "Soru")</span>
                </div>

                <hr>

                <!-- Questions (Read-only) -->
                <table class="table table-sm table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>@Html.T("Checklist.QuestionText", "Soru")</th>
                            <th>@Html.T("Checklist.ScoringType", "Puanlama")</th>
                            <th>@Html.T("Checklist.WeightPoints", "Ağırlık")</th>
                            <th>@Html.T("Checklist.MaxPoints", "Maks Puan")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: questions || []">
                        <tr>
                            <td data-bind="text: $index() + 1"></td>
                            <td>
                                <span data-bind="text: text"></span>
                                <!-- ko if: subCriteria && subCriteria.length > 0 -->
                                <br /><small class="text-muted"><i class="bi bi-list-check"></i> <span data-bind="text: subCriteria.length"></span> @Html.T("Checklist.SubCriteria", "alt kriter")</small>
                                <!-- /ko -->
                            </td>
                            <td>
                                <span class="badge" data-bind="css: { 'bg-success': scoringType === 'Scored', 'bg-warning': scoringType === 'Penalty', 'bg-secondary': scoringType === 'Unscored' }, text: scoringTypeName || scoringType"></span>
                            </td>
                            <td>
                                <!-- ko if: scoringType !== 'Unscored' -->
                                <span data-bind="text: weightPoints"></span>
                                <!-- /ko -->
                                <!-- ko if: scoringType === 'Unscored' -->
                                <span class="text-muted">-</span>
                                <!-- /ko -->
                            </td>
                            <td>
                                <!-- ko if: scoringType !== 'Unscored' -->
                                <span data-bind="text: maxPoints"></span>
                                <!-- /ko -->
                                <!-- ko if: scoringType === 'Unscored' -->
                                <span class="text-muted">-</span>
                                <!-- /ko -->
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-bind="click: function() { $parent.exportChecklistToExcel($data); }">
                    <i class="bi bi-file-earmark-excel me-2"></i>@Html.T("Common.ExportExcel", "Excel'e Aktar")
                </button>
                <button type="button" class="btn btn-secondary" data-bind="click: $parent.closeViewModal">
                    <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Close", "Kapat")
                </button>
            </div>
            <!-- /ko -->
        </div>
    </div>
</div>
<div class="modal-backdrop fade" data-bind="css: { show: isViewModalOpen }, style: { display: isViewModalOpen() ? 'block' : 'none' }"></div>

<!-- Scoring Method Selection Modal -->
<div class="modal fade" data-bind="css: { show: isScoringMethodModalOpen }, style: { display: isScoringMethodModalOpen() ? 'block' : 'none' }" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-calculator me-2"></i>@Html.T("Checklist.SelectScoringMethod", "Puanlama Yöntemi Seçin")
                </h5>
                <button type="button" class="btn-close" data-bind="click: closeScoringMethodModal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-4">@Html.T("Checklist.ScoringMethodDescription", "Kontrol listesi için kullanılacak puanlama yöntemini seçin.")</p>

                <div class="d-grid gap-3">
                    <!-- Maximum (Klasik) -->
                    <button class="btn btn-outline-primary text-start p-3" data-bind="click: function() { selectScoringMethod('Maximum'); }">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-arrow-up-circle fs-2 me-3"></i>
                            <div>
                                <strong>@Html.T("ScoringMethod.Maximum", "Maksimum")</strong>
                                <br />
                                <small class="text-muted">@Html.T("ScoringMethod.MaximumDescription", "Klasik puanlama - 0 ile maksimum puan arasında değerlendirme yapılır")</small>
                            </div>
                        </div>
                    </button>

                    <!-- CriteriaTotal (Kriter Toplam) -->
                    <button class="btn btn-outline-success text-start p-3" data-bind="click: function() { selectScoringMethod('CriteriaTotal'); }">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-plus-circle fs-2 me-3"></i>
                            <div>
                                <strong>@Html.T("ScoringMethod.CriteriaTotal", "Kriter Toplam")</strong>
                                <br />
                                <small class="text-muted">@Html.T("ScoringMethod.CriteriaTotalDescription", "Seçenek bazlı puanlama - Evet/Geliştirilmeli/Hayır seçenekleri ile değerlendirme")</small>
                            </div>
                        </div>
                    </button>

                    <!-- Survey (Anket) -->
                    <button class="btn btn-outline-info text-start p-3" data-bind="click: function() { selectScoringMethod('Survey'); }">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-clipboard-data fs-2 me-3"></i>
                            <div>
                                <strong>@Html.T("ScoringMethod.Survey", "Anket")</strong>
                                <br />
                                <small class="text-muted">@Html.T("ScoringMethod.SurveyDescription", "Online anket - Tek/Çoklu seçim sorularıyla veri toplama")</small>
                            </div>
                        </div>
                    </button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bind="click: closeScoringMethodModal">
                    <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Cancel", "İptal")
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal-backdrop fade" data-bind="css: { show: isScoringMethodModalOpen }, style: { display: isScoringMethodModalOpen() ? 'block' : 'none' }"></div>

<partial name="_DeleteConfirmationModal" />

</div> <!-- End of checklists-app -->

@section Scripts {
    <script src="~/js/Shared/app.config.js"></script>
    <script src="~/js/Shared/api.service.js"></script>
    <script src="~/js/Shared/enums.service.js"></script>
    <script src="~/js/Shared/delete-confirmation.js"></script>
    <script src="~/js/Checklists/checklist.js"></script>
}
