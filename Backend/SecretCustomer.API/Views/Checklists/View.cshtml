@model ChecklistDto
@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@Model.Name</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Geri
    </a>
</div>

<div class="card shadow">
    <div class="card-body">
        <div class="mb-3">
            <strong>Açıklama:</strong> @(Model.Description ?? "Yok")
        </div>
        <div class="mb-3">
            <span class="badge bg-secondary">Versiyon: @Model.Version</span>
            <span class="badge bg-info ms-2">@Model.Sections.Count Bölüm</span>
        </div>

        <hr>

        @foreach (var item in Model.Sections.OrderBy(s => s.Order))
        {
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0">@item.Name</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Soru</th>
                                    <th>Tip</th>
                                    <th>Puan</th>
                                    <th>N/A</th>
                                    <th>Seçenekler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var question in item.Questions.OrderBy(q => q.Order))
                                {
                                    <tr>
                                        <td>@question.Text</td>
                                        <td>
                                            <span class="badge bg-info">@question.Type</span>
                                        </td>
                                        <td>@question.Points</td>
                                        <td>
                                            @if (question.AllowNA)
                                            {
                                                <span class="text-success">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    <i class="bi bi-dash-circle"></i>
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (question.Options != null && question.Options.Any())
                                            {
                                                @string.Join(", ", question.Options.Select(o => o.Label))
                                            }
                                            else
                                            {
                                                <text>-</text>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
