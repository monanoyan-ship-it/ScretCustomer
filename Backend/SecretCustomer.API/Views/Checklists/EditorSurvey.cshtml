@{
    Layout = "_LayoutPopup";
    var checklistId = ViewBag.ChecklistId;
    var cloneId = ViewBag.CloneId;
    var isAssessment = ViewBag.IsAssessment == true;
    var scoringMethod = "Survey";
    var isNew = checklistId == null && cloneId == null;
    var isClone = cloneId != null;
    var isCriteriaTotal = false;
    var isSurvey = true;
    ViewData["Title"] = isNew ? Html.T("Checklist.NewChecklist", "Yeni Kontrol Listesi") :
                        isClone ? Html.T("Checklist.CloneChecklist", "Kontrol Listesi Klonla") :
                        Html.T("Checklist.EditChecklist", "Kontrol Listesi Düzenle");
}

<div id="checklist-editor">
    <!-- Header -->
    <div class="popup-header">
        <h4>
            @if (isNew)
            {
                <i class="bi bi-plus-circle me-2"></i>@Html.T("Checklist.NewChecklist", "Yeni Kontrol Listesi")
                <span class="badge bg-info ms-2 fs-6">@Html.T("Checklist.Survey", "Anket")</span>
            }
            else if (isClone)
            {
                <span data-bind="text: checklist() ? checklist().name() : ''"></span>
                <small class="text-muted ms-2"><i class="bi bi-files"></i> @Html.T("Checklist.CloneChecklist", "Klonla")</small>
                <span class="badge bg-info ms-2 fs-6">@Html.T("Checklist.Survey", "Anket")</span>
            }
            else
            {
                <span data-bind="text: checklist() ? checklist().name() : ''"></span>
                <small class="text-muted ms-2"><i class="bi bi-pencil"></i> @Html.T("Checklist.EditChecklist", "Düzenle")</small>
                <span class="badge bg-info ms-2 fs-6">@Html.T("Checklist.Survey", "Anket")</span>
            }
        </h4>
        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-sm" data-bind="click: saveChecklist, disable: isSaving">
                <span data-bind="visible: !isSaving()"><i class="bi bi-save"></i> @Html.T("Common.Save", "Kaydet")</span>
                <span data-bind="visible: isSaving"><span class="spinner-border spinner-border-sm"></span> @Html.T("Common.Saving", "Kaydediliyor...")</span>
            </button>
            <button class="btn btn-secondary btn-sm" onclick="window.close()">
                <i class="bi bi-x-lg"></i> @Html.T("Common.Close", "Kapat")
            </button>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Yükleniyor...")</p>
    </div>

    <!-- Form -->
    <div data-bind="visible: !isLoading(), with: checklist">
        <!-- Wizard Steps -->
        <ul class="nav nav-pills nav-justified mb-4">
            <li class="nav-item">
                <a class="nav-link" data-bind="css: { active: $parent.wizardStep() === 1 }, click: function() { $parent.wizardStep(1); }">
                    <span class="badge rounded-pill me-2" data-bind="css: { 'bg-primary': $parent.wizardStep() === 1, 'bg-secondary': $parent.wizardStep() !== 1 }">1</span>
                    @Html.T("Report.GeneralInfo", "Genel Bilgiler")
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bind="css: { active: $parent.wizardStep() === 2 }, click: function() { $parent.wizardStep(2); }">
                    <span class="badge rounded-pill me-2" data-bind="css: { 'bg-primary': $parent.wizardStep() === 2, 'bg-secondary': $parent.wizardStep() !== 2 }">2</span>
                    @Html.T("Checklist.Step2.Questions", "Sorular")
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bind="css: { active: $parent.wizardStep() === 3 }, click: function() { $parent.wizardStep(3); }">
                    <span class="badge rounded-pill me-2" data-bind="css: { 'bg-primary': $parent.wizardStep() === 3, 'bg-secondary': $parent.wizardStep() !== 3 }">3</span>
                    @Html.T("Checklist.Step3.AuditSettings", "Denetim Ayarları")
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bind="css: { active: $parent.wizardStep() === 4 }, click: function() { $parent.wizardStep(4); }">
                    <span class="badge rounded-pill me-2" data-bind="css: { 'bg-primary': $parent.wizardStep() === 4, 'bg-secondary': $parent.wizardStep() !== 4 }">4</span>
                    @Html.T("Report.Summary", "Özet")
                </a>
            </li>
        </ul>

        <!-- Step 1: Genel Bilgiler -->
        <div data-bind="visible: $parent.wizardStep() === 1">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-primary text-white py-2">
                    <h6 class="mb-0"><i class="bi bi-info-circle"></i> @Html.T("Report.GeneralInfo", "Genel Bilgiler")</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Import.ChecklistName", "Kontrol Listesi Adı") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: name" placeholder="@Html.T("Checklist.NamePlaceholder", "Örn: Çağrı Performans Değerlendirmesi")" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">@Html.T("Checklist.Code", "K.L. Kodu")</label>
                            <input type="text" class="form-control" data-bind="value: code" placeholder="KL-001" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">@Html.T("Checklist.Version", "Versiyon")</label>
                            <input type="number" class="form-control" data-bind="value: version" min="1" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Checklist.TemplateName", "Şablon Adı")</label>
                            <input type="text" class="form-control" data-bind="value: templateName" placeholder="@Html.T("Checklist.Type.CallPerformance", "Çağrı Performans")" />
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">@Html.T("Checklist.Type", "K.L. Tipi")</label>
                            <select class="form-select" data-bind="value: checklistType">
                                @if (isAssessment)
                                {
                                    <option value="PersonnelAssessment">@Html.T("ChecklistType.PersonnelAssessment", "Personel Değerlendirme")</option>
                                }
                                else
                                {
                                    <option value="Survey">@Html.T("ScoringMethod.Survey", "Anket")</option>
                                    <option value="Enneagram">@Html.T("Checklist.Type.Enneagram", "Enneagram")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">@Html.T("Checklist.ScoringMethod", "Puanlama Yöntemi")</label>
                            <input type="text" class="form-control bg-light" readonly value="Anket" />
                            <small class="text-muted">@Html.T("Checklist.ScoringMethodReadonly", "Puanlama yöntemi değiştirilemez")</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.T("Common.Description", "Açıklama")</label>
                        <textarea class="form-control" data-bind="value: description" rows="2" placeholder="@Html.T("Checklist.DescriptionPlaceholder", "Kontrol listesi hakkında kısa açıklama...")"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.T("Checklist.MaxTotalPoints", "Maks. Toplam Puan")</label>
                        <input type="number" class="form-control max-points-input" data-bind="value: maxTotalPoints" min="0" />
                        <small class="text-muted">@Html.T("Checklist.MaxTotalPointsHelp", "Varsayılan: 100")</small>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-check mt-2">
                                <input type="checkbox" class="form-check-input" data-bind="checked: isScored" id="isScored" />
                                <label class="form-check-label" for="isScored">@Html.T("Checklist.IsScored", "Puanlı")</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check mt-2">
                                <input type="checkbox" class="form-check-input" data-bind="checked: isActive" id="isActive" />
                                <label class="form-check-label" for="isActive">@Html.T("Common.Active", "Aktif")</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check mt-2">
                                <input type="checkbox" class="form-check-input" data-bind="checked: hideGroupNames" id="hideGroupNames" />
                                <label class="form-check-label" for="hideGroupNames">@Html.T("Checklist.HideGroupNames", "Grup İsimlerini Gizle")</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 2: Sorular -->
        <div data-bind="visible: $parent.wizardStep() === 2">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-secondary text-white py-2 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="bi bi-list-check"></i> @Html.T("Checklist.Questions", "Sorular")</h6>
                    <button type="button" class="btn btn-sm btn-light" data-bind="click: addQuestion">
                        <i class="bi bi-plus-circle"></i> @Html.T("Checklist.AddQuestion", "Soru Ekle")
                    </button>
                </div>
                <div class="card-body p-2 questions-container">
                    <!-- Questions -->
                    <div data-bind="foreach: questions">
                        <div class="card mb-2 question-card" data-bind="css: { 'border-warning': penaltyType() === 'YellowCard', 'border-danger': penaltyType() === 'RedCard' }">
                            <div class="card-header d-flex justify-content-between align-items-center py-1 px-2" data-bind="css: { 'bg-light': scoringType() === 'Scored', 'bg-warning': scoringType() === 'Penalty', 'bg-secondary text-white': scoringType() === 'Unscored' }">
                                <span>
                                    <i class="bi bi-question-circle me-1"></i>
                                    <strong>@Html.T("Report.Question", "Soru") #<span data-bind="text: $index() + 1"></span></strong>
                                </span>
                                <button type="button" class="btn btn-sm btn-outline-danger py-0" data-bind="click: $parent.removeQuestion">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                            <div class="card-body py-2 px-3">
                                <!-- Soru Grubu -->
                                <div class="row">
                                    <div class="col-12 mb-2 position-relative">
                                        <label class="form-label form-label-sm mb-1">@Html.T("Question.GroupName", "Soru Grubu")</label>
                                        <input type="text" class="form-control form-control-sm"
                                               data-bind="value: groupName, event: { focus: $root.showGroupSuggestions, input: $root.filterGroupSuggestions, blur: $root.hideGroupSuggestions }"
                                               placeholder="@Html.T("Question.GroupNamePlaceholder", "Grup adı...")"
                                               autocomplete="off" />
                                        <div class="dropdown-menu w-100 show group-suggestions-dropdown" data-bind="visible: $root.showGroupDropdown() && $root.filteredGroups().length > 0, foreach: $root.filteredGroups">
                                            <a class="dropdown-item" href="#" data-bind="text: $data, click: function() { $parent.groupName($data); $root.showGroupDropdown(false); }"></a>
                                        </div>
                                    </div>
                                </div>

                                <!-- Soru Metni -->
                                <div class="row">
                                    <div class="@(isAssessment ? "col-md-6" : "col-12") mb-2">
                                        <label class="form-label form-label-sm mb-1">@Html.T("Excel.QuestionText", "Soru Metni") <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control form-control-sm" data-bind="value: text" placeholder="@Html.T("Checklist.QuestionTextPlaceholder", "Soru metni")" />
                                    </div>
                                    @if (isAssessment)
                                    {
                                        <div class="col-md-6 mb-2">
                                            <label class="form-label form-label-sm mb-1"><i class="bi bi-person text-info"></i> @Html.T("Checklist.SelfText", "Öz Değerlendirme Metni")</label>
                                            <input type="text" class="form-control form-control-sm" data-bind="value: selfText" placeholder="@Html.T("Checklist.SelfTextPlaceholder", "Boş bırakılırsa soru metni kullanılır")" autocomplete="off" />
                                        </div>
                                    }
                                </div>

                                <!-- Puanlama - Ağırlık Puanı - Maks Puan - Ceza Tipi - Sıra - Zorunlu -->
                                <div class="row">
                                    <div class="col-md-2 mb-2">
                                        <label class="form-label form-label-sm mb-1">@Html.T("Checklist.Scoring", "Puanlama")</label>
                                        <select class="form-select form-select-sm" data-bind="value: scoringType">
                                            <option value="Scored">@Html.T("Checklist.ScoringType.Scored", "Puanlı")</option>
                                            <option value="Unscored">@Html.T("Checklist.ScoringType.Unscored", "Puansız")</option>
                                            <option value="Penalty">@Html.T("Checklist.ScoringType.Penalty", "Cezalı")</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2 mb-2" data-bind="visible: scoringType() !== 'Unscored'">
                                        <label class="form-label form-label-sm mb-1">@Html.T("Checklist.WeightPoints", "Ağırlık")</label>
                                        <input type="number" class="form-control form-control-sm" data-bind="value: weightPoints" min="0" step="0.1" />
                                    </div>
                                    <div class="col-md-2 mb-2" data-bind="visible: scoringType() !== 'Unscored'">
                                        <label class="form-label form-label-sm mb-1">@Html.T("Checklist.MaxPoints", "Maks Puan")</label>
                                        <input type="number" class="form-control form-control-sm" data-bind="value: maxPoints" min="1" max="10" />
                                    </div>
                                    <div class="col-md-2 mb-2" data-bind="visible: scoringType() === 'Penalty'">
                                        <label class="form-label form-label-sm mb-1">@Html.T("Report.PenaltyType", "Ceza Tipi")</label>
                                        <select class="form-select form-select-sm" data-bind="value: penaltyType">
                                            <option value="None">@Html.T("Checklist.PenaltyType.None", "Yok")</option>
                                            <option value="YellowCard">@Html.T("Checklist.PenaltyType.YellowCard", "Sarı Kart")</option>
                                            <option value="RedCard">@Html.T("Checklist.PenaltyType.RedCard", "Kırmızı Kart")</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2 mb-2">
                                        <label class="form-label form-label-sm mb-1">@Html.T("Language.Order", "Sıra")</label>
                                        <input type="number" class="form-control form-control-sm" data-bind="value: order" min="1" />
                                    </div>
                                    <div class="col-md-2 mb-2 d-flex align-items-end">
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input" data-bind="checked: isRequired" />
                                            <label class="form-check-label">@Html.T("Checklist.Required", "Zorunlu")</label>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <label class="form-label form-label-sm mb-1">@Html.T("Checklist.RecommendedNote", "Önerilen Açıklama")</label>
                                        <input type="text" class="form-control form-control-sm" data-bind="value: recommendedNote" placeholder="@Html.T("Checklist.RecommendedNotePlaceholder", "Değerlendirici için öneri")" />
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <label class="form-label form-label-sm mb-1">@Html.T("Checklist.HelpText", "Yardımcı Metin")</label>
                                        <input type="text" class="form-control form-control-sm" data-bind="value: helpText" placeholder="@Html.T("Checklist.HelpTextPlaceholder", "Soru hakkında ipucu")" />
                                    </div>
                                </div>

                                <!-- Dosya Ekleri -->
                                <div class="row mt-1" data-bind="visible: id">
                                    <div class="col-12">
                                        <label class="form-label form-label-sm mb-1"><i class="bi bi-paperclip"></i> @Html.T("Checklist.FileAttachments", "Dosya Ekleri")</label>
                                        <div class="mb-1" data-bind="visible: _attachments && _attachments().length > 0">
                                            <div class="list-group list-group-flush" data-bind="foreach: _attachments">
                                                <div class="list-group-item d-flex justify-content-between align-items-center py-1 px-2">
                                                    <div>
                                                        <i class="bi bi-file-earmark me-1"></i>
                                                        <a data-bind="attr: { href: downloadUrl || ('/api/question-attachments/' + id + '/download') }, text: fileName" target="_blank" class="text-decoration-none"></a>
                                                        <small class="text-muted ms-2" data-bind="text: fileSizeFormatted || ''"></small>
                                                    </div>
                                                    <button type="button" class="btn btn-sm btn-outline-danger py-0" data-bind="click: function() { $root.removeQuestionAttachment($data, $parent); }">
                                                        <i class="bi bi-x"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="input-group input-group-sm">
                                            <input type="file" class="form-control form-control-sm" data-bind="attr: { id: 'file-' + (id() || 'new-' + $index()) }, event: { change: function(data, event) { $root.uploadQuestionAttachment($data, event.target); } }" accept=".jpg,.jpeg,.png,.gif,.pdf,.doc,.docx,.xls,.xlsx,.txt" />
                                            <span class="input-group-text" data-bind="visible: _isUploadingFile && _isUploadingFile()">
                                                <span class="spinner-border spinner-border-sm"></span>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mt-1" data-bind="visible: !id">
                                    <div class="col-12">
                                        <small class="text-muted"><i class="bi bi-info-circle"></i> @Html.T("Checklist.SaveBeforeAttaching", "Dosya eklemek için önce kontrol listesini kaydedin.")</small>
                                    </div>
                                </div>

                                <!-- Soru Ayarları -->
                                <div class="row mt-2 mb-2 bg-light p-2 rounded">
                                    <div class="col-md-4">
                                        <label class="form-label form-label-sm mb-1">@Html.T("Question.SelectionType", "Seçim Tipi")</label>
                                        <select class="form-select form-select-sm" data-bind="value: selectionTypeId">
                                            <option value="1">@Html.T("SelectionType.Single", "Tek Seçim")</option>
                                            <option value="2">@Html.T("SelectionType.Multiple", "Çoklu Seçim")</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4 d-flex align-items-center">
                                        <div class="form-check mt-3">
                                            <input type="checkbox" class="form-check-input" data-bind="checked: showScoreInput" />
                                            <label class="form-check-label">@Html.T("Question.ShowScoreInput", "Puan girişini göster")</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4 d-flex align-items-center">
                                        <div class="form-check mt-3">
                                            <input type="checkbox" class="form-check-input" data-bind="checked: allowComment" />
                                            <label class="form-check-label">@Html.T("Question.AllowComment", "Yorum Yapılabilir")</label>
                                        </div>
                                    </div>
                                </div>

                                <!-- Alt Kriterler / Öneriler -->
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <label class="form-label form-label-sm mb-0">
                                                <i class="bi bi-list-check"></i> @Html.T("Checklist.SubCriteria", "Alt Kriterler/Öneriler")
                                                <small class="text-muted ms-1" data-bind="visible: subCriteria && subCriteria().length > 0, text: '(' + (subCriteria ? subCriteria().length : 0) + ')'"></small>
                                            </label>
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0" data-bind="click: function() { _showSubCriteria(!_showSubCriteria()); }">
                                                <i class="bi" data-bind="css: { 'bi-chevron-down': !_showSubCriteria(), 'bi-chevron-up': _showSubCriteria() }"></i>
                                            </button>
                                        </div>

                                        <div class="mt-2" data-bind="visible: _showSubCriteria">
                                            <!-- Alt Kriterler Başlık -->
                                            <div class="row mb-1 text-muted small fw-bold" data-bind="visible: subCriteria && subCriteria().length > 0">
                                                <div class="@(isAssessment ? "col-md-3" : "col-md-6")">@Html.T("Checklist.SubCriteriaDescription", "Açıklama")</div>
                                                @if (isAssessment)
                                                {
                                                    <div class="col-md-3"><i class="bi bi-person text-info"></i> @Html.T("Checklist.SelfDescription", "Öz Değ. Açıklaması")</div>
                                                }
                                                <div class="col-md-2">@Html.T("Checklist.WeightPointsSurvey", "Ağırlık (Anket)")</div>
                                                <div class="col-md-2">@Html.T("Language.Order", "Sıra")</div>
                                                <div class="col-md-2"></div>
                                            </div>
                                            <!-- Mevcut Alt Kriterler -->
                                            <div data-bind="foreach: subCriteria">
                                                <div class="row mb-1 align-items-center">
                                                    <div class="@(isAssessment ? "col-md-3" : "col-md-6")">
                                                        <input type="text" class="form-control form-control-sm" data-bind="value: description" placeholder="@Html.T("Checklist.SubCriteriaDescription", "Alt kriter açıklaması")" />
                                                    </div>
                                                    @if (isAssessment)
                                                    {
                                                        <div class="col-md-3">
                                                            <input type="text" class="form-control form-control-sm" data-bind="value: selfDescription" placeholder="@Html.T("Checklist.SelfDescriptionPlaceholder", "Boşsa açıklama kullanılır")" autocomplete="off" />
                                                        </div>
                                                    }
                                                    <div class="col-md-2">
                                                        <input type="number" class="form-control form-control-sm" data-bind="value: weightPoints" min="0" step="0.1" title="@Html.T("Checklist.WeightPointsSurvey", "Ağırlık (Anket)")" />
                                                    </div>
                                                    <div class="col-md-2">
                                                        <input type="number" class="form-control form-control-sm" data-bind="value: order" min="1" title="@Html.T("Language.Order", "Sıra")" />
                                                    </div>
                                                    <div class="col-md-2">
                                                        <button type="button" class="btn btn-sm btn-outline-danger w-100 py-0" data-bind="click: function() { $parent.removeSubCriteria($data); }">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>

                                            <button type="button" class="btn btn-sm btn-outline-primary mt-1" data-bind="click: addSubCriteria">
                                                <i class="bi bi-plus"></i> @Html.T("Checklist.AddSubCriteria", "Alt Kriter Ekle")
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div data-bind="visible: questions().length === 0" class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i> @Html.T("Checklist.NoQuestionsWarning", "Henüz soru eklenmemiş. Lütfen en az bir soru ekleyin.")
                    </div>

                    <!-- Alt Soru Ekle Butonu -->
                    <div class="text-center mt-3" data-bind="visible: questions().length > 0">
                        <button type="button" class="btn btn-outline-primary" data-bind="click: addQuestion">
                            <i class="bi bi-plus-circle"></i> @Html.T("Checklist.AddQuestion", "Soru Ekle")
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 3: Denetim Ayarları -->
        <div data-bind="visible: $parent.wizardStep() === 3">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-warning py-2">
                    <h6 class="mb-0"><i class="bi bi-gear"></i> @Html.T("Checklist.Step3.AuditSettings", "Denetim Ayarları")</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header bg-warning py-2">
                                    <i class="bi bi-exclamation-triangle"></i> @Html.T("Checklist.YellowCardCriteria", "Sarı Kart Kriterleri")
                                </div>
                                <div class="card-body">
                                    <p class="text-muted small">@Html.T("Checklist.YellowCardInfo", "Sarı kart verilmesi gereken durumlar \"Cezalı\" tip ile tanımlanır.")</p>
                                    <ul class="list-unstyled mb-0" data-bind="foreach: questions">
                                        <!-- ko if: penaltyType() === 'YellowCard' -->
                                        <li><i class="bi bi-check text-warning"></i> <span data-bind="text: text"></span></li>
                                        <!-- /ko -->
                                    </ul>
                                    <p class="text-muted mb-0" data-bind="visible: questions().filter(function(q) { return q.penaltyType() === 'YellowCard'; }).length === 0">
                                        <i class="bi bi-dash"></i> @Html.T("Checklist.NoYellowCard", "Sarı kart sorusu tanımlanmamış.")
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header bg-danger text-white py-2">
                                    <i class="bi bi-x-circle"></i> @Html.T("Checklist.RedCardCriteria", "Kırmızı Kart Kriterleri")
                                </div>
                                <div class="card-body">
                                    <p class="text-muted small">@Html.T("Checklist.RedCardInfo", "Kırmızı kart verilmesi gereken durumlar \"Cezalı\" tip ile tanımlanır.")</p>
                                    <ul class="list-unstyled mb-0" data-bind="foreach: questions">
                                        <!-- ko if: penaltyType() === 'RedCard' -->
                                        <li><i class="bi bi-x text-danger"></i> <span data-bind="text: text"></span></li>
                                        <!-- /ko -->
                                    </ul>
                                    <p class="text-muted mb-0" data-bind="visible: questions().filter(function(q) { return q.penaltyType() === 'RedCard'; }).length === 0">
                                        <i class="bi bi-dash"></i> @Html.T("Checklist.NoRedCard", "Kırmızı kart sorusu tanımlanmamış.")
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 4: Özet -->
        <div data-bind="visible: $parent.wizardStep() === 4">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-success text-white py-2">
                    <h6 class="mb-0"><i class="bi bi-clipboard-check"></i> @Html.T("Checklist.SummaryInfo", "Özet Bilgiler")</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-sm">
                                <tr><th>@Html.T("Import.ChecklistName", "Kontrol Listesi Adı"):</th><td data-bind="text: name"></td></tr>
                                <tr><th>@Html.T("Checklist.Code", "Kod"):</th><td data-bind="text: code || '-'"></td></tr>
                                <tr><th>@Html.T("Checklist.TemplateName", "Şablon"):</th><td data-bind="text: templateName || '-'"></td></tr>
                                <tr><th>@Html.T("Checklist.Type", "Tip"):</th><td data-bind="text: checklistType"></td></tr>
                                <tr><th>@Html.T("Checklist.ScoringMethod", "Puanlama Yöntemi"):</th><td data-bind="text: scoringMethod"></td></tr>
                                <tr><th>@Html.T("Checklist.MaxTotalPoints", "Maks. Puan"):</th><td data-bind="text: maxTotalPoints"></td></tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-sm">
                                <tr><th>@Html.T("Checklist.TotalQuestions", "Toplam Soru"):</th><td data-bind="text: questions().length"></td></tr>
                                <tr><th>@Html.T("Checklist.ScoredQuestions", "Puanlı Soru"):</th><td data-bind="text: questions().filter(function(q) { return q.scoringType() === 'Scored' && q.penaltyType() === 'None'; }).length"></td></tr>
                                <tr><th>@Html.T("Checklist.YellowCardQuestions", "Sarı Kart Sorusu"):</th><td data-bind="text: questions().filter(function(q) { return q.penaltyType() === 'YellowCard'; }).length"></td></tr>
                                <tr><th>@Html.T("Checklist.RedCardQuestions", "Kırmızı Kart Sorusu"):</th><td data-bind="text: questions().filter(function(q) { return q.penaltyType() === 'RedCard'; }).length"></td></tr>
                                <tr>
                                    <th>@Html.T("Checklist.ScoredWeightPoints", "Puanlı Soru Ağırlığı"):</th>
                                    <td><span class="text-primary fw-bold" data-bind="text: questions().filter(function(q) { return q.scoringType() === 'Scored' && q.penaltyType() === 'None'; }).reduce(function(sum, q) { return sum + (parseFloat(q.weightPoints()) || 0); }, 0).toFixed(2)"></span></td>
                                </tr>
                                <tr><th>@Html.T("Common.Status", "Durum"):</th><td><span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? '@Html.T("Common.Active", "Aktif")' : '@Html.T("Common.Inactive", "Pasif")'"></span></td></tr>
                            </table>
                        </div>
                    </div>

                    <h6 class="mt-3">@Html.T("Checklist.QuestionSummary", "Soru Özeti")</h6>
                    <div class="table-responsive summary-table-container">
                        <table class="table table-sm table-bordered">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>#</th>
                                    <th>@Html.T("Excel.QuestionText", "Soru")</th>
                                    <th>@Html.T("Checklist.ScoringType", "Puanlama")</th>
                                    <th>@Html.T("Checklist.WeightPoints", "Ağırlık")</th>
                                    <th>@Html.T("Checklist.MaxPoints", "Maks Puan")</th>
                                    <th>@Html.T("Checklist.SubCriteria", "Alt Kriter")</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: questions">
                                <tr>
                                    <td data-bind="text: $index() + 1"></td>
                                    <td data-bind="text: text"></td>
                                    <td>
                                        <span class="badge" data-bind="css: { 'bg-success': scoringType() === 'Scored', 'bg-warning': scoringType() === 'Penalty', 'bg-secondary': scoringType() === 'Unscored' }, text: scoringType"></span>
                                    </td>
                                    <td>
                                        <!-- ko if: scoringType() !== 'Unscored' -->
                                        <span data-bind="text: weightPoints"></span>
                                        <!-- /ko -->
                                        <!-- ko if: scoringType() === 'Unscored' -->
                                        <span class="text-muted">-</span>
                                        <!-- /ko -->
                                    </td>
                                    <td>
                                        <!-- ko if: scoringType() !== 'Unscored' -->
                                        <span data-bind="text: maxPoints"></span>
                                        <!-- /ko -->
                                        <!-- ko if: scoringType() === 'Unscored' -->
                                        <span class="text-muted">-</span>
                                        <!-- /ko -->
                                    </td>
                                    <td data-bind="text: (subCriteria && subCriteria().length) || 0"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Sol Orta - Geri Butonu -->
    <button type="button" class="btn btn-outline-primary rounded-circle position-fixed top-50 start-0 translate-middle-y ms-2 shadow wizard-nav-btn"
            data-bind="visible: !isLoading() && checklist() && wizardStep() > 1, click: prevStep">
        <i class="bi bi-arrow-left fs-5"></i>
    </button>

    <!-- Sağ Orta - İleri/Kaydet Butonu -->
    <button type="button" class="btn btn-primary rounded-circle position-fixed top-50 end-0 translate-middle-y me-2 shadow wizard-nav-btn"
            data-bind="visible: !isLoading() && checklist() && wizardStep() < 4, click: nextStep">
        <i class="bi bi-arrow-right fs-5"></i>
    </button>
    <button type="button" class="btn btn-success rounded-circle position-fixed top-50 end-0 translate-middle-y me-2 shadow wizard-nav-btn"
            data-bind="visible: !isLoading() && checklist() && wizardStep() === 4, click: saveChecklist, disable: isSaving">
        <span data-bind="visible: !isSaving()"><i class="bi bi-save fs-5"></i></span>
        <span data-bind="visible: isSaving"><span class="spinner-border spinner-border-sm"></span></span>
    </button>
</div>

<script>
    window.editorConfig = {
        checklistId: @(checklistId != null ? checklistId.ToString() : "null"),
        cloneId: @(cloneId != null ? cloneId.ToString() : "null"),
        isNew: @(isNew ? "true" : "false"),
        isClone: @(isClone ? "true" : "false"),
        scoringMethod: 'Survey',
        isCriteriaTotal: false,
        isSurvey: true,
        isAssessment: @(isAssessment ? "true" : "false")
    };
</script>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/checklist-editor.css" />
}

@section Scripts {
    <script src="~/js/Shared/app.config.js" asp-append-version="true"></script>
    <script src="~/js/Shared/api.service.js" asp-append-version="true"></script>
    <script src="~/js/Checklists/editor.js" asp-append-version="true"></script>
}
