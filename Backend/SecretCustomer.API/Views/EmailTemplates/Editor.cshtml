@{
    Layout = "_LayoutPopup";
    var templateId = ViewBag.TemplateId;
    var isNew = templateId == null;
    ViewData["Title"] = isNew ? "Yeni Email Şablonu" : "Email Şablonu Düzenle";
}

<div id="email-template-editor">
    <!-- Header -->
    <div class="popup-header">
        <h4>
            @if (isNew)
            {
                <i class="bi bi-plus-circle me-2"></i>@:Yeni Email Şablonu
            }
            else
            {
                <i class="bi bi-pencil me-2"></i>@:Email Şablonu Düzenle
            }
        </h4>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-info btn-sm" data-bind="click: showPreview">
                <i class="bi bi-eye"></i> Önizleme
            </button>
            <button class="btn btn-primary btn-sm" data-bind="click: saveTemplate, disable: isSaving">
                <span data-bind="visible: !isSaving()"><i class="bi bi-save"></i> Kaydet</span>
                <span data-bind="visible: isSaving"><span class="spinner-border spinner-border-sm"></span></span>
            </button>
            <button class="btn btn-secondary btn-sm" onclick="window.close()">
                <i class="bi bi-x-lg"></i> Kapat
            </button>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">Şablon yükleniyor...</p>
    </div>

    <!-- Form -->
    <div data-bind="visible: !isLoading()" class="row">
        <!-- Sol Panel: Form -->
        <div class="col-lg-8">
            <!-- Temel Bilgiler -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-primary text-white py-2">
                    <h6 class="mb-0"><i class="bi bi-info-circle"></i> Temel Bilgiler</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Şablon Adı <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: template.name" placeholder="Anket Davetiyesi - Standart" autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Şablon Tipi <span class="text-danger">*</span></label>
                            <select class="form-select" data-bind="value: template.templateTypeId, options: templateTypes, optionsValue: 'id', optionsText: 'displayName'"></select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Açıklama</label>
                            <input type="text" class="form-control" data-bind="value: template.description" placeholder="Bu şablon hakkında kısa açıklama" autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" data-bind="checked: template.isActive">
                                <label class="form-check-label" for="isActive">Aktif</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isDefault" data-bind="checked: template.isDefault">
                                <label class="form-check-label" for="isDefault">Varsayılan Şablon</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Email İçeriği -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-secondary text-white py-2">
                    <h6 class="mb-0"><i class="bi bi-envelope"></i> Email İçeriği</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Konu (Subject) <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="subjectInput" data-bind="value: template.subject" placeholder="{CompanyName} - Anket Davetiyesi" autocomplete="off">
                        <small class="text-muted">Placeholder kullanabilirsiniz: {ProjectName}, {CompanyName}, vb.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">İçerik (Body) <span class="text-danger">*</span></label>
                        <textarea id="bodyEditor" data-bind="value: template.body"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sağ Panel: Placeholder Seçici -->
        <div class="col-lg-4">
            <div class="card shadow-sm sticky-top" style="top: 20px;">
                <div class="card-header bg-info text-white py-2">
                    <h6 class="mb-0"><i class="bi bi-braces"></i> Değişken Ekle</h6>
                </div>
                <div class="card-body p-0" style="max-height: 450px; overflow-y: auto;">
                    <div class="accordion accordion-flush" id="placeholderAccordion" data-bind="foreach: placeholderCategories">
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse"
                                        data-bind="attr: { 'data-bs-target': '#pcat-' + $index() }">
                                    <i data-bind="class: icon + ' me-2'"></i>
                                    <span data-bind="text: name"></span>
                                </button>
                            </h2>
                            <div class="accordion-collapse collapse" data-bind="attr: { id: 'pcat-' + $index() }">
                                <div class="accordion-body p-0">
                                    <div class="list-group list-group-flush" data-bind="foreach: placeholders">
                                        <button type="button" class="list-group-item list-group-item-action py-2"
                                                data-bind="click: $root.insertPlaceholder">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong class="text-primary" data-bind="text: code"></strong>
                                                    <small class="d-block text-muted" data-bind="text: label"></small>
                                                </div>
                                                <i class="bi bi-plus-circle text-success"></i>
                                            </div>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light small">
                    <i class="bi bi-lightbulb"></i> Değişkene tıklayarak ekleyin
                </div>
            </div>
        </div>
    </div>

    <!-- Preview Modal -->
    <div class="modal fade" id="previewModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-eye"></i> Email Önizleme</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <strong>Konu:</strong> <span data-bind="text: previewSubject"></span>
                    </div>
                    <hr>
                    <div data-bind="html: previewBody"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    window.editorConfig = {
        templateId: @(templateId != null ? templateId.ToString() : "null"),
        isNew: @(isNew ? "true" : "false")
    };
</script>

@section Styles {
    <link href="~/lib/summernote/summernote-lite.min.css" rel="stylesheet">
    <style>
        .note-editor { border-radius: 0.375rem; }
        .note-toolbar { border-radius: 0.375rem 0.375rem 0 0; }
        /* Fullscreen fix */
        .note-editor.note-fullscreen {
            z-index: 9999 !important;
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            height: 100% !important;
            background: #fff;
        }
    </style>
}

@section Scripts {
    <script src="~/lib/summernote/summernote-lite.min.js"></script>
    <script src="~/lib/summernote/summernote-tr-TR.min.js"></script>
    <script src="~/js/EmailTemplates/editor.js"></script>
}
