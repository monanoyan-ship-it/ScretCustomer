@{
    ViewData["Title"] = "Email Şablonları";
}

<div id="email-templates-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-envelope-paper"></i> Email Şablonları</h2>
        <button class="btn btn-primary" data-bind="click: createTemplate">
            <i class="bi bi-plus-lg"></i> Yeni Şablon
        </button>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Şablon Tipi</label>
                    <select class="form-select" data-bind="value: filterTypeId, options: templateTypes, optionsValue: 'id', optionsText: 'displayName', optionsCaption: 'Tümü'"></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Durum</label>
                    <select class="form-select" data-bind="value: filterStatus">
                        <option value="">Tümü</option>
                        <option value="active">Aktif</option>
                        <option value="inactive">Pasif</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button class="btn btn-outline-secondary w-100" data-bind="click: clearFilters">
                        <i class="bi bi-x-circle"></i> Temizle
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">Şablonlar yükleniyor...</p>
    </div>

    <!-- Templates List -->
    <div data-bind="visible: !isLoading()">
        <div class="card shadow-sm" data-bind="visible: filteredTemplates().length > 0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Şablon Adı</th>
                            <th>Tip</th>
                            <th>Konu</th>
                            <th class="text-center" style="width: 100px;">Durum</th>
                            <th class="text-end" style="width: 180px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredTemplates">
                        <tr data-bind="css: { 'table-warning': isDefault, 'opacity-50': !isActive }">
                            <td>
                                <strong data-bind="text: name"></strong>
                                <!-- ko if: description -->
                                <br><small class="text-muted" data-bind="text: description"></small>
                                <!-- /ko -->
                            </td>
                            <td>
                                <span class="badge bg-secondary">
                                    <i data-bind="class: $parent.getTypeIcon(templateTypeId)"></i>
                                    <span data-bind="text: templateTypeName"></span>
                                </span>
                            </td>
                            <td><small data-bind="text: subject"></small></td>
                            <td class="text-center">
                                <span data-bind="visible: isDefault" class="badge bg-primary">Varsayılan</span>
                                <span data-bind="visible: isActive && !isDefault" class="badge bg-success">Aktif</span>
                                <span data-bind="visible: !isActive" class="badge bg-danger">Pasif</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" data-bind="click: $parent.showPreview" title="Önizleme">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="btn btn-outline-primary" data-bind="click: $parent.editTemplate" title="Düzenle">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-info" data-bind="click: $parent.showTestModal" title="Test Email">
                                        <i class="bi bi-send"></i>
                                    </button>
                                    <button class="btn btn-outline-secondary" data-bind="click: $parent.duplicateTemplate" title="Kopyala">
                                        <i class="bi bi-copy"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" data-bind="click: $parent.deleteTemplate" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: filteredTemplates().length === 0" class="text-center py-5 text-muted">
            <i class="bi bi-inbox fs-1"></i>
            <p class="mt-2">Henüz email şablonu bulunmuyor.</p>
            <button class="btn btn-primary" data-bind="click: createTemplate">
                <i class="bi bi-plus-lg"></i> İlk Şablonu Oluştur
            </button>
        </div>
    </div>

    <!-- Preview Modal -->
    <div class="modal fade" id="previewModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-eye me-2"></i>Email Önizleme</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3 p-2 bg-light rounded">
                        <strong>Konu:</strong> <span data-bind="text: previewSubject"></span>
                    </div>
                    <div class="border rounded p-3" data-bind="html: previewBody"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Test Email Modal -->
    <div class="modal fade" id="testEmailModal" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-send me-2"></i>Test Email Gönder</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-2">Şablon: <strong data-bind="text: testTemplateName"></strong></p>
                    <div class="mb-3">
                        <label class="form-label">Email Adresi <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" placeholder="test@example.com"
                               data-bind="value: testEmail" autocomplete="off">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-info btn-sm" data-bind="click: sendTestEmail, disable: isSendingTest">
                        <span data-bind="visible: !isSendingTest()"><i class="bi bi-send"></i> Gönder</span>
                        <span data-bind="visible: isSendingTest"><span class="spinner-border spinner-border-sm"></span></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/EmailTemplates/index.js"></script>
}
