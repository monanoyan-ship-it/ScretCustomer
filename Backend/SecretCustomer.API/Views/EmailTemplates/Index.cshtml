@{
    ViewData["Title"] = Html.T("EmailTemplate.Title", "Email Şablonları");
}

<div id="email-templates-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-envelope-paper"></i> @Html.T("EmailTemplate.Title", "Email Şablonları")</h2>
        <button class="btn btn-primary" data-bind="click: createTemplate">
            <i class="bi bi-plus-lg"></i> @Html.T("EmailTemplate.NewTemplate", "Yeni Şablon")
        </button>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">@Html.T("EmailTemplate.TemplateType", "Şablon Tipi")</label>
                    <select class="form-select" data-bind="value: filterTypeId, options: templateTypes, optionsValue: 'id', optionsText: 'displayName', optionsCaption: '@Html.T("Common.All", "Tümü")'"></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">@Html.T("Common.Status", "Durum")</label>
                    <select class="form-select" data-bind="value: filterStatus">
                        <option value="">@Html.T("Common.All", "Tümü")</option>
                        <option value="active">@Html.T("Common.Active", "Aktif")</option>
                        <option value="inactive">@Html.T("Common.Inactive", "Pasif")</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button class="btn btn-outline-secondary w-100" data-bind="click: clearFilters">
                        <i class="bi bi-x-circle"></i> @Html.T("Common.Clear", "Temizle")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">@Html.T("EmailTemplate.Loading", "Şablonlar yükleniyor...")</p>
    </div>

    <!-- Templates List -->
    <div data-bind="visible: !isLoading()">
        <div class="card shadow-sm" data-bind="visible: filteredTemplates().length > 0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Html.T("EmailTemplate.TemplateName", "Şablon Adı")</th>
                            <th>@Html.T("Common.Type", "Tip")</th>
                            <th>@Html.T("EmailTemplate.Subject", "Konu")</th>
                            <th class="text-center" style="width: 100px;">@Html.T("Common.Status", "Durum")</th>
                            <th class="text-end" style="width: 180px;">@Html.T("Common.Actions", "İşlemler")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredTemplates">
                        <tr data-bind="css: { 'table-warning': isDefault, 'opacity-50': !isActive }">
                            <td>
                                <strong data-bind="text: name"></strong>
                                <!-- ko if: description -->
                                <br><small class="text-muted" data-bind="text: description"></small>
                                <!-- /ko -->
                            </td>
                            <td>
                                <span class="badge bg-secondary">
                                    <i data-bind="class: $parent.getTypeIcon(templateTypeId)"></i>
                                    <span data-bind="text: templateTypeName"></span>
                                </span>
                            </td>
                            <td><small data-bind="text: subject"></small></td>
                            <td class="text-center">
                                <span data-bind="visible: isDefault" class="badge bg-primary">@Html.T("Common.Default", "Varsayılan")</span>
                                <span data-bind="visible: isActive && !isDefault" class="badge bg-success">@Html.T("Common.Active", "Aktif")</span>
                                <span data-bind="visible: !isActive" class="badge bg-danger">@Html.T("Common.Inactive", "Pasif")</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" data-bind="click: $parent.showPreview" title="@Html.T("Common.Preview", "Önizleme")">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="btn btn-outline-primary" data-bind="click: $parent.editTemplate" title="@Html.T("Common.Edit", "Düzenle")">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-info" data-bind="click: $parent.showTestModal" title="@Html.T("EmailTemplate.TestEmail", "Test Email")">
                                        <i class="bi bi-send"></i>
                                    </button>
                                    <button class="btn btn-outline-secondary" data-bind="click: $parent.duplicateTemplate" title="@Html.T("Common.Copy", "Kopyala")">
                                        <i class="bi bi-copy"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" data-bind="click: $parent.deleteTemplate" title="@Html.T("Common.Delete", "Sil")">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: filteredTemplates().length === 0" class="text-center py-5 text-muted">
            <i class="bi bi-inbox fs-1"></i>
            <p class="mt-2">@Html.T("EmailTemplate.NoTemplates", "Henüz email şablonu bulunmuyor.")</p>
            <button class="btn btn-primary" data-bind="click: createTemplate">
                <i class="bi bi-plus-lg"></i> @Html.T("EmailTemplate.CreateFirst", "İlk Şablonu Oluştur")
            </button>
        </div>
    </div>

    <!-- Preview Modal -->
    <div class="modal fade" id="previewModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-eye me-2"></i>@Html.T("EmailTemplate.Preview", "Email Önizleme")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3 p-2 bg-light rounded">
                        <strong>@Html.T("EmailTemplate.Subject", "Konu"):</strong> <span data-bind="text: previewSubject"></span>
                    </div>
                    <div class="border rounded p-3" data-bind="html: previewBody"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Close", "Kapat")</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Test Email Modal -->
    <div class="modal fade" id="testEmailModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-send me-2"></i>@Html.T("Smtp.SendTestEmail", "Test Email Gönder")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-3">@Html.T("EmailTemplate.Template", "Şablon"): <strong data-bind="text: testTemplateName"></strong></p>

                    <div class="mb-3">
                        <label class="form-label">@Html.T("EmailTemplate.RecipientAddress", "Gönderilecek Email Adresi") <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" placeholder="test@example.com"
                               data-bind="value: testEmail" autocomplete="off">
                        <small class="text-muted">@Html.T("EmailTemplate.TestEmailHint", "Test emaili bu adrese gönderilecek")</small>
                    </div>

                    <hr>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="useRealData" data-bind="checked: useRealData">
                        <label class="form-check-label" for="useRealData">
                            <strong>@Html.T("EmailTemplate.UseRealData", "Gerçek Proje/Personel Verisi Kullan")</strong>
                        </label>
                        <div class="small text-muted">@Html.T("EmailTemplate.UseRealDataHint", "Gerçek anket linki ve QR kod oluşturulur")</div>
                    </div>

                    <div data-bind="visible: useRealData">
                        <div class="mb-3">
                            <label class="form-label">@Html.T("Common.Project", "Proje") <span class="text-danger">*</span></label>
                            <select class="form-select" data-bind="value: selectedProjectId, options: testProjects, optionsText: function(p) { return (p.code ? p.code + ' - ' : '') + p.name + (p.customerName ? ' (' + p.customerName + ')' : ''); }, optionsValue: 'id', optionsCaption: '@Html.T("EmailTemplate.SelectProject", "Proje seçin...")'"></select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Html.T("Common.Personnel", "Personel") <span class="text-danger">*</span></label>
                            <select class="form-select" data-bind="value: selectedPersonnelId, options: testPersonnel, optionsText: function(p) { return p.fullName + ' (' + p.email + ')' + (p.organizationName ? ' - ' + p.organizationName : ''); }, optionsValue: 'id', optionsCaption: '@Html.T("EmailTemplate.SelectPersonnel", "Personel seçin...")', enable: selectedProjectId()"></select>
                            <small class="text-muted" data-bind="visible: !selectedProjectId()">@Html.T("EmailTemplate.SelectProjectFirst", "Önce proje seçin")</small>
                        </div>
                        <div class="alert alert-info small mb-0" data-bind="visible: selectedPersonnelId">
                            <i class="bi bi-info-circle"></i> @Html.T("EmailTemplate.RealDataInfo", "Seçilen personel için gerçek anket linki ve QR kod oluşturulacak. Email yukarıda girdiğiniz adrese gönderilecek.")
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">@Html.T("Common.Cancel", "İptal")</button>
                    <button type="button" class="btn btn-info btn-sm" data-bind="click: sendTestEmail, disable: isSendingTest">
                        <span data-bind="visible: !isSendingTest()"><i class="bi bi-send"></i> @Html.T("Common.Send", "Gönder")</span>
                        <span data-bind="visible: isSendingTest"><span class="spinner-border spinner-border-sm"></span></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/EmailTemplates/index.js" asp-append-version="true"></script>
}
