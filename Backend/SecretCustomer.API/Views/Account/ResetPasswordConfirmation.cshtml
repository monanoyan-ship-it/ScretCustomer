@{
    ViewData["Title"] = Html.T("Account.PasswordChanged", "Şifre Değiştirildi").ToString();
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-body p-4 text-center">
                <i class="bi bi-check-circle text-success" style="font-size: 4rem;"></i>

                <h3 class="mt-3">@Html.T("Account.PasswordChangedTitle", "Şifreniz Değiştirildi")</h3>

                <p class="text-muted">
                    @(TempData["SuccessMessage"] ?? Html.T("Account.ResetPasswordSuccess", "Şifreniz başarıyla değiştirildi. Yeni şifrenizle giriş yapabilirsiniz.").ToString())
                </p>

                <div class="mt-4">
                    <a asp-action="Login" class="btn btn-primary">
                        <i class="bi bi-box-arrow-in-right me-1"></i>@Html.T("Login.Title", "Giriş Yap")
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
