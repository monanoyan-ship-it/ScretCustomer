@model SecretCustomer.Core.DTOs.Auth.ForgotPasswordDto
@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-4">
                    <i class="bi bi-key fs-1 text-primary"></i>
                    <div>Şifremi Unuttum</div>
                </h3>

                <p class="text-muted text-center mb-4">
                    E-posta adresinizi girin, size şifre sıfırlama kodu göndereceğiz.
                </p>

                <form asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">E-posta Adresi</label>
                        <input asp-for="Email" class="form-control" placeholder="ornek@email.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-3">
                        <i class="bi bi-envelope me-1"></i> Sıfırlama Kodu Gönder
                    </button>

                    <div class="text-center">
                        <a asp-action="Login" class="text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i>Giriş sayfasına dön
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
