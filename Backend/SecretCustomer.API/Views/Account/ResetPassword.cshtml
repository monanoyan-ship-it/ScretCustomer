@model SecretCustomer.Core.DTOs.Auth.ResetPasswordDto
@{
    ViewData["Title"] = Html.T("Account.ResetPassword", "Şifre Sıfırla").ToString();
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-4">
                    <i class="bi bi-shield-lock fs-1 text-primary"></i>
                    <div>@Html.T("Account.SetNewPassword", "Yeni Şifre Belirle")</div>
                </h3>

                <form asp-action="ResetPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <input type="hidden" asp-for="Token" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">@Html.T("Common.Email", "E-posta Adresi")</label>
                        <input asp-for="Email" class="form-control" readonly />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">@Html.T("Account.NewPassword", "Yeni Şifre")</label>
                        <input asp-for="NewPassword" class="form-control" type="password" placeholder="@Html.T("Account.MinChars", "En az 6 karakter")" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">@Html.T("Account.ConfirmNewPassword", "Şifre Tekrarı")</label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="@Html.T("Account.ConfirmPasswordPlaceholder", "Şifrenizi tekrar girin")" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-3">
                        <i class="bi bi-check-lg me-1"></i> @Html.T("Account.ResetPasswordButton", "Şifreyi Değiştir")
                    </button>

                    <div class="text-center">
                        <a asp-action="Login" class="text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i>@Html.T("Account.BackToLogin", "Giriş sayfasına dön")
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
