@{
    ViewData["Title"] = Html.T("AccessDenied.Title", "Erişim Engellendi").ToString();
    Layout = "_Layout";
    var isCustomerPersonnel = User.HasClaim("UserType", "CustomerPersonnel");
    var redirectUrl = isCustomerPersonnel ? "/CustomerPortal/Dashboard" : "/Dashboard";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow text-center">
            <div class="card-body p-5">
                <i class="bi bi-shield-lock fs-1 text-danger"></i>
                <h3 class="mt-3">@Html.T("AccessDenied.Title", "Erişim Engellendi")</h3>
                <p class="text-muted mt-2">@Html.T("AccessDenied.Message", "Bu sayfaya erişim yetkiniz bulunmamaktadır.")</p>
                <div class="mt-3">
                    <span class="spinner-border spinner-border-sm text-secondary me-1"></span>
                    <small class="text-muted">@Html.T("AccessDenied.Redirecting", "Yönlendiriliyorsunuz...")</small>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    setTimeout(function () {
        window.location.href = '@redirectUrl';
    }, 2000);
</script>
