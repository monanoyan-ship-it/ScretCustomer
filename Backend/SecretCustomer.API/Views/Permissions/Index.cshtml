@{
    ViewData["Title"] = @Html.T("Permission.Title", "Yetki Yönetimi");
}

<div id="permissions-app">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-shield-lock me-2"></i>@Html.T("Permission.Title", "Yetki Yönetimi")
        </h2>
        <button class="btn btn-warning" data-bind="click: syncPermissions, disable: isSyncing">
            <i class="bi bi-arrow-repeat me-1" data-bind="css: { 'spin': isSyncing() }"></i>
            <span data-bind="visible: !isSyncing()">@Html.T("Permission.SyncPermissions", "Yetkileri Senkronize Et")</span>
            <span data-bind="visible: isSyncing">@Html.T("Common.Syncing", "Senkronize ediliyor...")</span>
        </button>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4" id="permissionTabs">
        <li class="nav-item">
            <a class="nav-link active" data-bs-toggle="tab" href="#allPermissions">
                <i class="bi bi-list-check me-1"></i>@Html.T("Permission.AllPermissions", "Tüm Yetkiler")
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#rolePermissions">
                <i class="bi bi-people me-1"></i>@Html.T("Permission.RolePermissions", "Rol Yetkileri")
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#userPermissions">
                <i class="bi bi-person me-1"></i>@Html.T("Permission.UserPermissions", "Kullanıcı Yetkileri")
            </a>
        </li>
    </ul>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@Html.T("Common.Loading", "Yükleniyor...")</span>
        </div>
        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Veriler yükleniyor...")</p>
    </div>

    <!-- Tab Content -->
    <div class="tab-content" data-bind="visible: !isLoading()">
        <!-- All Permissions Tab -->
        <div class="tab-pane fade show active" id="allPermissions">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@Html.T("Permission.SystemPermissions", "Sistem Yetkileri")</h5>
                    <div class="d-flex gap-2">
                        <select class="form-select form-select-sm" style="width: 200px;" data-bind="value: categoryFilter">
                            <option value="">@Html.T("Permission.AllCategories", "Tüm Kategoriler")</option>
                            <!-- ko foreach: categories -->
                            <option data-bind="value: value, text: name"></option>
                            <!-- /ko -->
                        </select>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@Html.T("Permission.Code", "Kod")</th>
                                    <th>@Html.T("Common.Name", "Ad")</th>
                                    <th>@Html.T("Permission.Category", "Kategori")</th>
                                    <th>@Html.T("Common.Description", "Açıklama")</th>
                                    <th>@Html.T("Common.Status", "Durum")</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: filteredPermissions">
                                <tr>
                                    <td>
                                        <code data-bind="text: code"></code>
                                    </td>
                                    <td>
                                        <strong data-bind="text: displayName"></strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary" data-bind="text: categoryName"></span>
                                    </td>
                                    <td>
                                        <small class="text-muted" data-bind="text: description || '-'"></small>
                                    </td>
                                    <td>
                                        <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-danger', text: isActive ? 'Aktif' : 'Pasif'"></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div data-bind="visible: filteredPermissions().length === 0" class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">@Html.T("Permission.NoPermissionsFound", "Yetki bulunamadı.")</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Role Permissions Tab -->
        <div class="tab-pane fade" id="rolePermissions">
            <div class="row">
                <!-- Role Selection -->
                <div class="col-md-3 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">@Html.T("Permission.Roles", "Roller")</h6>
                        </div>
                        <div class="list-group list-group-flush" data-bind="foreach: roles">
                            <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                               data-bind="click: $parent.selectRole, css: { active: $parent.selectedRole() && $parent.selectedRole().value === value }">
                                <span data-bind="text: name"></span>
                                <span class="badge bg-primary rounded-pill" data-bind="text: $parent.getRolePermissionCount(value)"></span>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Role Permissions -->
                <div class="col-md-9">
                    <div class="card shadow-sm">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <span data-bind="visible: selectedRole">
                                    <span data-bind="text: selectedRole() ? selectedRole().name : ''"></span> - @Html.T("Permission.Permissions", "Yetkileri")
                                </span>
                                <span data-bind="visible: !selectedRole()">@Html.T("Permission.SelectRole", "Rol Seçin")</span>
                            </h5>
                            <button class="btn btn-primary btn-sm" data-bind="visible: selectedRole, click: saveRolePermissions, disable: isSaving">
                                <i class="bi bi-check-lg me-1"></i>@Html.T("Common.Save", "Kaydet")
                            </button>
                        </div>
                        <div class="card-body" data-bind="visible: selectedRole">
                            <!-- Category groups -->
                            <!-- ko foreach: permissionsByCategory -->
                            <div class="mb-4">
                                <h6 class="border-bottom pb-2 mb-3">
                                    <i class="bi bi-folder me-1"></i>
                                    <span data-bind="text: categoryName"></span>
                                </h6>
                                <div class="row">
                                    <!-- ko foreach: permissions -->
                                    <div class="col-md-6 mb-2">
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input"
                                                   data-bind="checked: $parents[1].isPermissionGranted(id),
                                                              attr: { id: 'perm_' + id },
                                                              click: function() { $parents[1].toggleRolePermission(id); return true; }">
                                            <label class="form-check-label" data-bind="attr: { for: 'perm_' + id }">
                                                <span data-bind="text: displayName"></span>
                                                <small class="text-muted d-block" data-bind="text: description"></small>
                                            </label>
                                        </div>
                                    </div>
                                    <!-- /ko -->
                                </div>
                            </div>
                            <!-- /ko -->
                        </div>
                        <div class="card-body text-center text-muted py-5" data-bind="visible: !selectedRole()">
                            <i class="bi bi-arrow-left fs-1"></i>
                            <p class="mt-2">@Html.T("Permission.SelectRoleToView", "Yetkileri görüntülemek için soldaki listeden bir rol seçin.")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- User Permissions Tab -->
        <div class="tab-pane fade" id="userPermissions">
            <div class="row">
                <!-- User Search -->
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-header bg-white">
                            <h6 class="mb-0">@Html.T("Permission.SearchUser", "Kullanıcı Ara")</h6>
                        </div>
                        <div class="card-body">
                            <div class="input-group mb-3">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control" placeholder="@Html.T("Permission.SearchUserPlaceholder", "Ad, soyad veya email...")"
                                       data-bind="value: userSearchTerm, valueUpdate: 'afterkeydown'">
                            </div>
                            <div class="list-group" style="max-height: 400px; overflow-y: auto;">
                                <!-- ko foreach: filteredUsers -->
                                <a href="#" class="list-group-item list-group-item-action"
                                   data-bind="click: $parent.selectUser, css: { active: $parent.selectedUser() && $parent.selectedUser().id === id }">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1" data-bind="text: firstName + ' ' + lastName"></h6>
                                        <small class="badge bg-secondary" data-bind="text: roleName"></small>
                                    </div>
                                    <small class="text-muted" data-bind="text: email"></small>
                                </a>
                                <!-- /ko -->
                                <div data-bind="visible: filteredUsers().length === 0" class="text-center py-3 text-muted">
                                    <small>@Html.T("Permission.NoUserFound", "Kullanıcı bulunamadı")</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- User Permissions Detail -->
                <div class="col-md-8">
                    <div data-bind="visible: selectedUser">
                        <!-- User Info -->
                        <div class="card shadow-sm mb-4">
                            <div class="card-body">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 60px; height: 60px;">
                                        <i class="bi bi-person fs-2 text-primary"></i>
                                    </div>
                                    <div>
                                        <h5 class="mb-0" data-bind="text: userPermissionsSummary() ? userPermissionsSummary().userFullName : ''"></h5>
                                        <span class="badge bg-primary" data-bind="text: userPermissionsSummary() ? userPermissionsSummary().roleName : ''"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Effective Permissions -->
                        <div class="card shadow-sm mb-4">
                            <div class="card-header bg-success text-white">
                                <h6 class="mb-0"><i class="bi bi-check-circle me-1"></i>@Html.T("Permission.EffectivePermissions", "Etkin Yetkiler")</h6>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <!-- ko foreach: userPermissionsSummary() ? userPermissionsSummary().effectivePermissions : [] -->
                                    <div class="col-md-6 mb-2">
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-check text-success me-1"></i>
                                            <span data-bind="text: displayName"></span>
                                        </span>
                                    </div>
                                    <!-- /ko -->
                                </div>
                                <div data-bind="visible: !userPermissionsSummary() || userPermissionsSummary().effectivePermissions.length === 0" class="text-center text-muted py-3">
                                    <small>@Html.T("Permission.NoEffectivePermissions", "Bu kullanıcının etkin yetkisi bulunmamaktadır.")</small>
                                </div>
                            </div>
                        </div>

                        <!-- Custom Permissions -->
                        <div class="card shadow-sm">
                            <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                                <h6 class="mb-0"><i class="bi bi-person-gear me-1"></i>@Html.T("Permission.CustomPermissions", "Özel Yetkiler")</h6>
                                <button class="btn btn-sm btn-dark" data-bind="click: showAddUserPermissionModal">
                                    <i class="bi bi-plus-lg me-1"></i>@Html.T("Permission.AddCustomPermission", "Özel Yetki Ekle")
                                </button>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>@Html.T("Permission.Permission", "Yetki")</th>
                                                <th>@Html.T("Common.Status", "Durum")</th>
                                                <th>@Html.T("Permission.Scope", "Kapsam")</th>
                                                <th>@Html.T("Permission.Validity", "Geçerlilik")</th>
                                                <th>@Html.T("Common.Actions", "İşlem")</th>
                                            </tr>
                                        </thead>
                                        <tbody data-bind="foreach: userPermissionsSummary() ? userPermissionsSummary().customPermissions : []">
                                            <tr>
                                                <td data-bind="text: permissionDisplayName"></td>
                                                <td>
                                                    <span class="badge" data-bind="css: isGranted ? 'bg-success' : 'bg-danger', text: isGranted ? 'Verildi' : 'Kaldırıldı'"></span>
                                                </td>
                                                <td data-bind="text: scopeName"></td>
                                                <td>
                                                    <small class="text-muted">
                                                        <span data-bind="text: validFrom ? new Date(validFrom).toLocaleDateString('tr-TR') : 'Süresiz'"></span>
                                                        -
                                                        <span data-bind="text: validUntil ? new Date(validUntil).toLocaleDateString('tr-TR') : 'Süresiz'"></span>
                                                    </small>
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.removeUserPermission">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div data-bind="visible: !userPermissionsSummary() || userPermissionsSummary().customPermissions.length === 0" class="text-center text-muted py-4">
                                    <small>@Html.T("Permission.NoCustomPermissions", "Bu kullanıcının özel yetkisi bulunmamaktadır.")</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div data-bind="visible: !selectedUser()" class="card shadow-sm">
                        <div class="card-body text-center text-muted py-5">
                            <i class="bi bi-person-bounding-box fs-1"></i>
                            <p class="mt-2">@Html.T("Permission.SelectUserToView", "Yetkileri görüntülemek için soldaki listeden bir kullanıcı seçin.")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Add User Permission Modal -->
    <div class="modal fade" id="addUserPermissionModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>@Html.T("Permission.AddCustomPermission", "Özel Yetki Ekle")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Permission.Permission", "Yetki") <span class="text-danger">*</span></label>
                        <select class="form-select" data-bind="value: newUserPermission.permissionId, options: permissions, optionsValue: 'id', optionsText: 'displayName', optionsCaption: '@Html.T("Common.Select", "Seçiniz...")'"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Common.Status", "Durum")</label>
                        <select class="form-select" data-bind="value: newUserPermission.isGranted">
                            <option value="true">@Html.T("Permission.GrantPermission", "Yetkiyi Ver")</option>
                            <option value="false">@Html.T("Permission.RevokePermission", "Yetkiyi Kaldır (Override)")</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Permission.Scope", "Kapsam")</label>
                        <select class="form-select" data-bind="value: newUserPermission.scope, options: scopes, optionsValue: 'value', optionsText: 'name'"></select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Common.StartDate", "Başlangıç Tarihi")</label>
                            <input type="date" class="form-control" data-bind="value: newUserPermission.validFrom">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Common.EndDate", "Bitiş Tarihi")</label>
                            <input type="date" class="form-control" data-bind="value: newUserPermission.validUntil">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Permission.Note", "Not")</label>
                        <textarea class="form-control" rows="2" data-bind="value: newUserPermission.notes"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Cancel", "İptal")</button>
                    <button type="button" class="btn btn-primary" data-bind="click: addUserPermission, disable: isSaving">
                        <span data-bind="visible: !isSaving()">
                            <i class="bi bi-check-lg me-1"></i>@Html.T("Common.Add", "Ekle")
                        </span>
                        <span data-bind="visible: isSaving">
                            <span class="spinner-border spinner-border-sm me-1"></span>@Html.T("Common.Saving", "Kaydediliyor...")
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Permissions/Index.js"></script>
}
