@{
    Layout = null;
    var token = ViewBag.Token as string;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Online Anket</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }
        .survey-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }
        .survey-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            overflow: hidden;
        }
        .survey-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }
        .survey-header h1 {
            margin: 0;
            font-size: 1.8rem;
            font-weight: 600;
        }
        .survey-header p {
            margin: 10px 0 0;
            opacity: 0.9;
        }
        .survey-body {
            padding: 30px;
        }
        .question-card {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 20px;
            border-left: 4px solid #667eea;
        }
        .question-card.required {
            border-left-color: #dc3545;
        }
        .question-text {
            font-weight: 600;
            margin-bottom: 15px;
            font-size: 1.1rem;
        }
        .question-number {
            display: inline-block;
            background: #667eea;
            color: white;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            text-align: center;
            line-height: 28px;
            font-size: 0.85rem;
            margin-right: 10px;
        }
        .rating-group {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        .rating-btn {
            width: 50px;
            height: 50px;
            border: 2px solid #dee2e6;
            border-radius: 10px;
            background: white;
            font-weight: 600;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        .rating-btn:hover {
            border-color: #667eea;
            background: #f0f0ff;
        }
        .rating-btn.selected {
            background: #667eea;
            border-color: #667eea;
            color: white;
        }
        .rating-btn.na {
            width: auto;
            padding: 0 15px;
            font-size: 0.9rem;
        }
        .comment-input {
            width: 100%;
            border: 2px solid #dee2e6;
            border-radius: 10px;
            padding: 12px;
            resize: vertical;
            min-height: 80px;
        }
        .comment-input:focus {
            outline: none;
            border-color: #667eea;
        }
        .progress-bar-container {
            background: #e9ecef;
            height: 6px;
            border-radius: 3px;
            margin-bottom: 20px;
        }
        .progress-bar-fill {
            background: linear-gradient(90deg, #667eea, #764ba2);
            height: 100%;
            border-radius: 3px;
            transition: width 0.3s;
        }
        .submit-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 15px 40px;
            font-size: 1.1rem;
            border-radius: 10px;
            color: white;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(102, 126, 234, 0.4);
        }
        .submit-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }
        .welcome-text {
            text-align: center;
            padding: 20px;
            background: #f0f7ff;
            border-radius: 12px;
            margin-bottom: 20px;
        }
        .loading-spinner {
            text-align: center;
            padding: 60px;
        }
        .error-container {
            text-align: center;
            padding: 60px;
        }
        .error-icon {
            font-size: 4rem;
            color: #dc3545;
            margin-bottom: 20px;
        }
        .group-header {
            background: #667eea;
            color: white;
            padding: 12px 20px;
            border-radius: 10px;
            margin: 30px 0 20px;
            font-weight: 600;
        }
        .group-header:first-of-type {
            margin-top: 0;
        }
    </style>
</head>
<body>
    <div class="survey-container py-4">
        <div class="survey-card" id="survey-app">
            <!-- Loading State -->
            <div class="loading-spinner" data-bind="visible: isLoading()">
                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                    <span class="visually-hidden">Yükleniyor...</span>
                </div>
                <p class="mt-3 text-muted">Anket yükleniyor...</p>
            </div>

            <!-- Error State -->
            <div class="error-container" data-bind="visible: hasError() && !isLoading()">
                <div class="error-icon">
                    <i class="bi bi-exclamation-circle"></i>
                </div>
                <h3 data-bind="text: errorTitle"></h3>
                <p class="text-muted" data-bind="text: errorMessage"></p>
            </div>

            <!-- Survey Content -->
            <div data-bind="visible: !isLoading() && !hasError()">
                <!-- Header -->
                <div class="survey-header">
                    <h1 data-bind="text: surveyName"></h1>
                    <p data-bind="text: customerName"></p>
                    <!-- ko if: !isAnonymous() && personnelName() -->
                    <p class="mt-2">
                        <i class="bi bi-person-circle me-1"></i>
                        <span data-bind="text: personnelName"></span>
                    </p>
                    <!-- /ko -->
                </div>

                <!-- Body -->
                <div class="survey-body">
                    <!-- Progress -->
                    <div class="progress-bar-container">
                        <div class="progress-bar-fill" data-bind="style: { width: progressPercent() + '%' }"></div>
                    </div>
                    <p class="text-muted text-center mb-4">
                        <span data-bind="text: answeredCount"></span> / <span data-bind="text: totalQuestions"></span> soru cevaplandı
                    </p>

                    <!-- Welcome Message (for identified surveys) -->
                    <!-- ko if: !isAnonymous() && personnelName() -->
                    <div class="welcome-text">
                        <h5>Merhaba <span data-bind="text: personnelName"></span>!</h5>
                        <p class="mb-0 text-muted">Lütfen aşağıdaki soruları cevaplayın.</p>
                    </div>
                    <!-- /ko -->

                    <!-- Questions -->
                    <div data-bind="foreach: groupedQuestions">
                        <!-- Group Header -->
                        <!-- ko if: groupName -->
                        <div class="group-header">
                            <i class="bi bi-folder me-2"></i>
                            <span data-bind="text: groupName"></span>
                        </div>
                        <!-- /ko -->

                        <!-- Questions in Group -->
                        <!-- ko foreach: questions -->
                        <div class="question-card" data-bind="css: { required: isRequired }">
                            <div class="question-text">
                                <span class="question-number" data-bind="text: order"></span>
                                <span data-bind="text: text"></span>
                                <!-- ko if: isRequired -->
                                <span class="text-danger">*</span>
                                <!-- /ko -->
                            </div>

                            <!-- Help Text -->
                            <!-- ko if: helpText -->
                            <p class="text-muted small mb-3" data-bind="text: helpText"></p>
                            <!-- /ko -->

                            <!-- Rating Buttons -->
                            <!-- ko if: scoringType === 'Scored' -->
                            <div class="rating-group">
                                <!-- ko foreach: ratingOptions -->
                                <button type="button" class="rating-btn"
                                        data-bind="text: $data,
                                                   css: { selected: $parent.selectedScore() === $data },
                                                   click: function() { $parent.selectedScore($data); }">
                                </button>
                                <!-- /ko -->
                                <!-- ko if: allowNA -->
                                <button type="button" class="rating-btn na"
                                        data-bind="css: { selected: selectedScore() === -1 },
                                                   click: function() { selectedScore(-1); }">
                                    N/A
                                </button>
                                <!-- /ko -->
                            </div>
                            <!-- /ko -->

                            <!-- Unscored (Yes/No or just comment) -->
                            <!-- ko if: scoringType === 'Unscored' -->
                            <div class="rating-group">
                                <button type="button" class="rating-btn" style="width: auto; padding: 0 20px;"
                                        data-bind="css: { selected: selectedScore() === 1 },
                                                   click: function() { selectedScore(1); }">
                                    <i class="bi bi-check-lg me-1"></i> Evet
                                </button>
                                <button type="button" class="rating-btn" style="width: auto; padding: 0 20px;"
                                        data-bind="css: { selected: selectedScore() === 0 },
                                                   click: function() { selectedScore(0); }">
                                    <i class="bi bi-x-lg me-1"></i> Hayır
                                </button>
                                <!-- ko if: allowNA -->
                                <button type="button" class="rating-btn na"
                                        data-bind="css: { selected: selectedScore() === -1 },
                                                   click: function() { selectedScore(-1); }">
                                    N/A
                                </button>
                                <!-- /ko -->
                            </div>
                            <!-- /ko -->

                            <!-- Comment -->
                            <div class="mt-3">
                                <textarea class="comment-input" placeholder="Yorum ekleyin (opsiyonel)..."
                                          data-bind="value: comment, valueUpdate: 'input'"></textarea>
                            </div>
                        </div>
                        <!-- /ko -->
                    </div>

                    <!-- Submit Button -->
                    <div class="text-center mt-4">
                        <button type="button" class="submit-btn"
                                data-bind="click: submitSurvey,
                                           disable: isSubmitting() || !canSubmit(),
                                           text: isSubmitting() ? 'Gönderiliyor...' : 'Anketi Gönder'">
                        </button>
                        <!-- ko if: !canSubmit() -->
                        <p class="text-danger mt-2">
                            <i class="bi bi-exclamation-circle me-1"></i>
                            Lütfen zorunlu soruları cevaplayın.
                        </p>
                        <!-- /ko -->
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <p class="text-center text-white-50 mt-4 small">
            Secret Customer &copy; <span data-bind="text: new Date().getFullYear()"></span>
        </p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/knockout@3.5.1/build/output/knockout-latest.js"></script>
    <script>
        var SURVEY_TOKEN = '@Html.Raw(token)';
    </script>
    <script src="~/js/Anket/form.js"></script>
</body>
</html>
