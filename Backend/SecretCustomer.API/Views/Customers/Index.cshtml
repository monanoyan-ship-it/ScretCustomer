@{
    ViewData["Title"] = Html.T("Customer.Title", "Müşteriler");
}

<div id="customers-app" class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@Html.T("Customer.Title", "Müşteriler")</h2>
        <button class="btn btn-primary" data-bind="click: createNew">
            <i class="bi bi-plus-circle"></i> @Html.T("Customer.NewCustomer", "Yeni Müşteri")
        </button>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>

    <!-- Error Message -->
    <div data-bind="visible: errorMessage" class="alert alert-danger alert-dismissible fade show">
        <span data-bind="text: errorMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { errorMessage(''); }"></button>
    </div>

    <!-- Success Message -->
    <div data-bind="visible: successMessage" class="alert alert-success alert-dismissible fade show">
        <span data-bind="text: successMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { successMessage(''); }"></button>
    </div>

    <!-- Customers Table -->
    <div data-bind="visible: !isLoading()">
        <!-- Empty State -->
        <div data-bind="visible: customers().length === 0">
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> @Html.T("Customer.NoCustomers", "Henüz müşteri bulunmamaktadır.")
            </div>
        </div>

        <!-- Table -->
        <div data-bind="visible: customers().length > 0" class="card shadow">
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>@Html.T("Customer.CompanyName", "Şirket Adı")</th>
                            <th>@Html.T("Customer.TaxNumber", "Vergi Numarası")</th>
                            <th>@Html.T("Common.Phone", "Telefon")</th>
                            <th>@Html.T("User.Email", "E-posta")</th>
                            <th>@Html.T("Customer.City", "Şehir")</th>
                            <th>@Html.T("Customer.Personnel", "Personel")</th>
                            <th>@Html.T("Common.Branch", "Şube")</th>
                            <th>@Html.T("Customer.Project", "Proje")</th>
                            <th>@Html.T("Customer.Contract", "Sözleşme")</th>
                            <th>@Html.T("Common.Status", "Durum")</th>
                            <th>@Html.T("Common.Actions", "İşlemler")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: customers">
                        <tr>
                            <td data-bind="text: companyName"></td>
                            <td><span class="badge bg-secondary" data-bind="text: taxNumber || '-'"></span></td>
                            <td data-bind="text: phone || '-'"></td>
                            <td data-bind="text: email || '-'"></td>
                            <td data-bind="text: city || '-'"></td>
                            <td><span class="badge bg-info" data-bind="text: personnelCount"></span></td>
                            <td><span class="badge bg-info" data-bind="text: branchCount"></span></td>
                            <td><span class="badge bg-info" data-bind="text: projectCount"></span></td>
                            <td>
                                <small data-bind="visible: contractStartDate">
                                    <span data-bind="text: $parent.formatDate(contractStartDate)"></span> -
                                    <span data-bind="text: $parent.formatDate(contractEndDate)"></span>
                                </small>
                                <span data-bind="visible: !contractStartDate">-</span>
                            </td>
                            <td>
                                <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? '@Html.T("Common.Active", "Aktif")' : '@Html.T("Common.Inactive", "Pasif")'"></span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-info me-1" data-bind="click: $parent.showPersonnel" title="@Html.T("Customer.Personnel", "Personeller")">
                                    <i class="bi bi-people"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-primary me-1" data-bind="click: $parent.editCustomer" title="@Html.T("Common.Edit", "Düzenle")">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deleteCustomer" title="@Html.T("Common.Delete", "Sil")">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Create/Edit Modal -->
    <div class="modal fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content" data-bind="with: editingCustomer">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <!-- ko ifnot: id -->
                        <i class="bi bi-plus-circle me-2"></i>@Html.T("Customer.NewCustomer", "Yeni Müşteri")
                        <!-- /ko -->
                        <!-- ko if: id -->
                        <i class="bi bi-pencil me-2"></i>@Html.T("Customer.EditCustomer", "Müşteri Düzenle")
                        <!-- /ko -->
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: $parent.closeModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Customer.CompanyName", "Şirket Adı") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: companyName" placeholder="@Html.T("Customer.CompanyNamePlaceholder", "ABC Şirketi Ltd. Şti.")" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Customer.TaxNumber", "Vergi Numarası")</label>
                            <input type="text" class="form-control" data-bind="value: taxNumber" placeholder="1234567890" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Common.Phone", "Telefon")</label>
                            <input type="tel" class="form-control" data-bind="value: phone" placeholder="+90 555 123 45 67" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("User.Email", "E-posta")</label>
                            <input type="email" class="form-control" data-bind="value: email" placeholder="info@sirket.com" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Customer.City", "Şehir")</label>
                            <input type="text" class="form-control" data-bind="value: city" placeholder="@Html.T("Customer.CityPlaceholder", "İstanbul")" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Customer.Address", "Adres")</label>
                            <input type="text" class="form-control" data-bind="value: address" placeholder="@Html.T("Customer.AddressPlaceholder", "Merkez Mahallesi...")" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Customer.ContractStartDate", "Sözleşme Başlangıç Tarihi")</label>
                            <input type="date" class="form-control" data-bind="value: contractStartDate" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Customer.ContractEndDate", "Sözleşme Bitiş Tarihi")</label>
                            <input type="date" class="form-control" data-bind="value: contractEndDate" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.T("Customer.Notes", "Notlar")</label>
                        <textarea class="form-control" data-bind="value: notes" rows="4" placeholder="@Html.T("Customer.NotesPlaceholder", "Müşteri hakkında notlar...")"></textarea>
                    </div>

                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" data-bind="checked: isActive" id="isActive" />
                        <label class="form-check-label" for="isActive">@Html.T("Common.Active", "Aktif")</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closeModal">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-primary" data-bind="click: $parent.saveCustomer, disable: $parent.isSaving">
                        <span data-bind="visible: !$parent.isSaving()">
                            <i class="bi bi-check-circle me-2"></i>@Html.T("Common.Save", "Kaydet")
                        </span>
                        <span data-bind="visible: $parent.isSaving">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            @Html.T("Common.Saving", "Kaydediliyor...")
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }"></div>

    <!-- Personnel Management Modal -->
    <div class="modal fade" data-bind="css: { show: showPersonnelModal }, style: { display: showPersonnelModal() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-people"></i> @Html.T("Customer.CustomerPersonnel", "Müşteri Personelleri")
                        <span data-bind="if: selectedCustomerForPersonnel">
                            - <span data-bind="text: selectedCustomerForPersonnel().companyName"></span>
                        </span>
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: closePersonnelModal"></button>
                </div>
                <div class="modal-body">
                    <!-- Password Reset Form (Inline) -->
                    <div data-bind="visible: showChangePasswordModal" class="card border-primary mb-3">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <span>
                                <i class="bi bi-key me-2"></i>@Html.T("Customer.ResetPassword", "Şifre Sıfırla")
                                <span data-bind="if: selectedPersonnelForPassword">
                                    - <span data-bind="text: selectedPersonnelForPassword().fullName"></span>
                                </span>
                            </span>
                            <button type="button" class="btn-close btn-close-white" data-bind="click: cancelChangePassword"></button>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">@Html.T("User.NewPassword", "Yeni Şifre") <span class="text-danger">*</span></label>
                                    <input type="password" class="form-control" data-bind="value: newPassword" placeholder="@Html.T("User.PasswordPlaceholder", "En az 6 karakter")" />
                                    <small class="text-muted">@Html.T("Customer.PasswordMinLength", "En az 6 karakter olmalıdır")</small>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">@Html.T("User.ConfirmPassword", "Yeni Şifre (Tekrar)") <span class="text-danger">*</span></label>
                                    <input type="password" class="form-control" data-bind="value: confirmPassword" placeholder="@Html.T("User.ConfirmPasswordPlaceholder", "Yeni şifreyi tekrar girin")" />
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-primary" data-bind="click: resetPassword, disable: isResettingPassword">
                                    <span data-bind="visible: !isResettingPassword()">
                                        <i class="bi bi-check-circle me-1"></i>@Html.T("Customer.ResetPassword", "Şifre Sıfırla")
                                    </span>
                                    <span data-bind="visible: isResettingPassword">
                                        <span class="spinner-border spinner-border-sm me-1"></span>@Html.T("Customer.Resetting", "Sıfırlanıyor...")
                                    </span>
                                </button>
                                <button type="button" class="btn btn-secondary" data-bind="click: cancelChangePassword">@Html.T("Common.Cancel", "İptal")</button>
                            </div>
                        </div>
                    </div>

                    <!-- Personnel Actions -->
                    <div data-bind="visible: showPersonnelActions">
                        <div class="d-flex justify-content-between mb-3">
                            <div class="input-group w-50">
                                <input type="text" class="form-control" placeholder="@Html.T("Customer.SearchPersonnel", "Personel ara...")" data-bind="value: personnelSearchText, valueUpdate: 'input'" />
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                            </div>
                            <button class="btn btn-primary" data-bind="click: createNewPersonnel">
                                <i class="bi bi-plus-circle"></i> @Html.T("Customer.NewPersonnel", "Yeni Personel")
                            </button>
                        </div>
                    </div>

                    <!-- Personnel Loading -->
                    <div data-bind="visible: showPersonnelLoading" class="text-center py-3">
                        <div class="spinner-border text-primary"></div>
                    </div>

                    <!-- Personnel Table -->
                    <div data-bind="visible: showPersonnelTable">
                        <div data-bind="visible: filteredPersonnel().length === 0" class="alert alert-info">
                            <i class="bi bi-info-circle"></i> @Html.T("Customer.NoPersonnel", "Bu müşteriye ait personel bulunmamaktadır.")
                        </div>

                        <div data-bind="visible: filteredPersonnel().length > 0">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>@Html.T("User.FullName", "Ad Soyad")</th>
                                        <th>@Html.T("User.Username", "Kullanıcı Adı")</th>
                                        <th>@Html.T("User.Email", "E-posta")</th>
                                        <th>@Html.T("User.Role", "Rol")</th>
                                        <th>@Html.T("Common.Status", "Durum")</th>
                                        <th>@Html.T("Common.Actions", "İşlemler")</th>
                                    </tr>
                                </thead>
                                <tbody data-bind="foreach: filteredPersonnel">
                                    <tr>
                                        <td data-bind="text: fullName"></td>
                                        <td><span class="badge bg-secondary" data-bind="text: username"></span></td>
                                        <td data-bind="text: email"></td>
                                        <td><span class="badge bg-primary" data-bind="text: roleName"></span></td>
                                        <td>
                                            <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? '@Html.T("Common.Active", "Aktif")' : '@Html.T("Common.Inactive", "Pasif")'"></span>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary me-1" data-bind="click: $parent.editPersonnel" title="@Html.T("Common.Edit", "Düzenle")">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-info me-1" data-bind="click: $parent.showChangePasswordForPersonnel" title="@Html.T("User.ChangePassword", "Şifre Değiştir")">
                                                <i class="bi bi-key"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deletePersonnel" title="@Html.T("Common.Delete", "Sil")">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closePersonnelModal, visible: showPersonnelActions">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Close", "Kapat")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showPersonnelModal }, style: { display: showPersonnelModal() ? 'block' : 'none' }"></div>

    <!-- Personnel Create/Edit Modal -->
    <div class="modal fade" data-bind="css: { show: showPersonnelFormModal }, style: { display: showPersonnelFormModal() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" data-bind="with: editingPersonnel">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <!-- ko ifnot: id -->
                        <i class="bi bi-plus-circle me-2"></i>@Html.T("Customer.NewPersonnel", "Yeni Personel")
                        <!-- /ko -->
                        <!-- ko if: id -->
                        <i class="bi bi-pencil me-2"></i>@Html.T("Customer.EditPersonnel", "Personel Düzenle")
                        <!-- /ko -->
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: $parent.closePersonnelFormModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("User.Username", "Kullanıcı Adı") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: username" placeholder="ali.veli" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("User.Email", "E-posta") <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" data-bind="value: email" placeholder="ali.veli@example.com" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("User.FirstName", "Ad") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: firstName" placeholder="@Html.T("Customer.FirstNamePlaceholder", "Ali")" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("User.LastName", "Soyad") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: lastName" placeholder="@Html.T("Customer.LastNamePlaceholder", "Veli")" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                <!-- ko ifnot: id -->
                                @Html.T("User.Password", "Şifre") <span class="text-danger">*</span>
                                <!-- /ko -->
                                <!-- ko if: id -->
                                @Html.T("Customer.PasswordOptional", "Şifre (Değiştirmek için doldurun)")
                                <!-- /ko -->
                            </label>
                            <input type="password" class="form-control" data-bind="value: password" placeholder="••••••••" />
                            <small class="text-muted" data-bind="visible: id">@Html.T("Customer.PasswordUnchanged", "Boş bırakırsanız mevcut şifre değişmez")</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("User.Role", "Rol") <span class="text-danger">*</span></label>
                            <select class="form-select" data-bind="value: role">
                                <option value="1">@Html.T("Customer.Role.Manager", "Müşteri Yöneticisi")</option>
                                <option value="2">@Html.T("Customer.Role.Supervisor", "Müşteri Süpervizörü")</option>
                                <option value="3">@Html.T("Customer.Role.Operator", "Müşteri Operatörü")</option>
                                <option value="4">@Html.T("Customer.Role.Viewer", "Müşteri Görüntüleyici")</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Common.Phone", "Telefon")</label>
                            <input type="tel" class="form-control" data-bind="value: phoneNumber" placeholder="0555 123 4567" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Customer.Department", "Departman")</label>
                            <input type="text" class="form-control" data-bind="value: department" placeholder="@Html.T("Customer.DepartmentPlaceholder", "Kalite Kontrol")" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Customer.Title", "Ünvan")</label>
                        <input type="text" class="form-control" data-bind="value: title" placeholder="@Html.T("Customer.TitlePlaceholder", "Kalite Müdürü")" />
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" data-bind="checked: isActive" id="personnelIsActive" />
                        <label class="form-check-label" for="personnelIsActive">@Html.T("Common.Active", "Aktif")</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closePersonnelFormModal">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-primary" data-bind="click: $parent.savePersonnel, disable: $parent.isSavingPersonnel">
                        <span data-bind="visible: !$parent.isSavingPersonnel()">
                            <i class="bi bi-check-circle me-2"></i>@Html.T("Common.Save", "Kaydet")
                        </span>
                        <span data-bind="visible: $parent.isSavingPersonnel">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            @Html.T("Common.Saving", "Kaydediliyor...")
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showPersonnelFormModal }, style: { display: showPersonnelFormModal() ? 'block' : 'none' }"></div>

    <partial name="_DeleteConfirmationModal" />

</div> <!-- End of customers-app -->

@section Scripts {
    <script src="~/js/Shared/api.service.js"></script>
    <script src="~/js/Shared/delete-confirmation.js"></script>
    <script src="~/js/Shared/customer.api.service.js"></script>
    <script src="~/js/Customers/customers.js"></script>
}
