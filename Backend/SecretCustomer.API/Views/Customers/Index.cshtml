@{
    ViewData["Title"] = Html.T("Customer.Title", "Müşteriler");
}

<div id="customers-app" class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@Html.T("Customer.Title", "Müşteriler")</h2>
        <button class="btn btn-primary" data-bind="click: createNew">
            <i class="bi bi-plus-circle"></i> @Html.T("Customer.NewCustomer", "Yeni Müşteri")
        </button>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>

    <!-- Customers Table -->
    <div data-bind="visible: !isLoading()">
        <!-- Search Filter -->
        <div class="card shadow-sm mb-3">
            <div class="card-body py-2">
                <div class="row align-items-center">
                    <div class="col-md-4">
                        <input type="text" class="form-control form-control-sm" placeholder="@Html.T("Common.Search", "Ara...")" data-bind="value: searchText, valueUpdate: 'afterkeydown'" autocomplete="off">
                    </div>
                    <div class="col-md-4">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="showInactive" data-bind="checked: showInactive">
                            <label class="form-check-label" for="showInactive">@Html.T("Common.ShowInactive", "Pasif müşterileri göster")</label>
                        </div>
                    </div>
                    <div class="col-md-4 text-end">
                        <span class="text-muted small" data-bind="text: totalCount() + ' kayıt'"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: totalCount() === 0">
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> @Html.T("Customer.NoCustomers", "Henüz müşteri bulunmamaktadır.")
            </div>
        </div>

        <!-- Table -->
        <div data-bind="visible: totalCount() > 0" class="card shadow">
            <div class="card-body p-0">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th class="sortable" data-bind="click: function() { sorting.toggleSort('code'); }, css: sorting.getSortClass('code')">
                                @Html.T("Customer.Code", "Kod")
                                <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('code')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { sorting.toggleSort('companyName'); }, css: sorting.getSortClass('companyName')">
                                @Html.T("Customer.CompanyName", "Şirket Adı")
                                <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('companyName')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { sorting.toggleSort('taxNumber'); }, css: sorting.getSortClass('taxNumber')">
                                @Html.T("Customer.TaxNumber", "Vergi Numarası")
                                <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('taxNumber')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { sorting.toggleSort('phone'); }, css: sorting.getSortClass('phone')">
                                @Html.T("Common.Phone", "Telefon")
                                <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('phone')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { sorting.toggleSort('email'); }, css: sorting.getSortClass('email')">
                                @Html.T("User.Email", "E-posta")
                                <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('email')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { sorting.toggleSort('city'); }, css: sorting.getSortClass('city')">
                                @Html.T("Customer.City", "Şehir")
                                <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('city')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { sorting.toggleSort('personnelCount'); }, css: sorting.getSortClass('personnelCount')">
                                @Html.T("Customer.Personnel", "Personel")
                                <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('personnelCount')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { sorting.toggleSort('branchCount'); }, css: sorting.getSortClass('branchCount')">
                                @Html.T("Common.Branch", "Şube")
                                <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('branchCount')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { sorting.toggleSort('projectCount'); }, css: sorting.getSortClass('projectCount')">
                                @Html.T("Customer.Project", "Proje")
                                <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('projectCount')"></i>
                            </th>
                            <th>@Html.T("Customer.Contract", "Sözleşme")</th>
                            <th class="sortable" data-bind="click: function() { sorting.toggleSort('isActive'); }, css: sorting.getSortClass('isActive')">
                                @Html.T("Common.Status", "Durum")
                                <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('isActive')"></i>
                            </th>
                            <th>@Html.T("Common.Actions", "İşlemler")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: sortedCustomers">
                        <tr>
                            <td><span class="badge bg-primary" data-bind="text: code || '-'"></span></td>
                            <td data-bind="text: companyName"></td>
                            <td><span class="badge bg-secondary" data-bind="text: taxNumber || '-'"></span></td>
                            <td data-bind="text: phone || '-'"></td>
                            <td data-bind="text: email || '-'"></td>
                            <td data-bind="text: city || '-'"></td>
                            <td><span class="badge bg-info" data-bind="text: personnelCount"></span></td>
                            <td><span class="badge bg-info" data-bind="text: branchCount"></span></td>
                            <td><span class="badge bg-info" data-bind="text: projectCount"></span></td>
                            <td>
                                <small data-bind="visible: contractStartDate">
                                    <span data-bind="text: $parent.formatDate(contractStartDate)"></span> -
                                    <span data-bind="text: $parent.formatDate(contractEndDate)"></span>
                                </small>
                                <span data-bind="visible: !contractStartDate">-</span>
                            </td>
                            <td>
                                <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? '@Html.T("Common.Active", "Aktif")' : '@Html.T("Common.Inactive", "Pasif")'"></span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-success me-1" data-bind="click: $parent.showOrganizations" title="@Html.T("Customer.Organizations", "Organizasyonlar")">
                                    <i class="bi bi-diagram-3"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-info me-1" data-bind="click: $parent.showPersonnel" title="@Html.T("Customer.Personnel", "Personeller")">
                                    <i class="bi bi-people"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-warning me-1" data-bind="click: $parent.showDealers" title="@Html.T("Customer.Dealers", "Bayiler")">
                                    <i class="bi bi-shop"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-primary me-1" data-bind="click: $parent.editCustomer" title="@Html.T("Common.Edit", "Düzenle")">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deleteCustomer" title="@Html.T("Common.Delete", "Sil")">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- Pagination -->
            <div class="card-footer d-flex justify-content-between align-items-center" data-bind="visible: totalPages() > 1">
                <div class="text-muted small">
                    <span data-bind="text: ((currentPage() - 1) * parseInt(pageSize(), 10) + 1) + '-' + Math.min(currentPage() * parseInt(pageSize(), 10), totalCount()) + ' / ' + totalCount()"></span>
                    @Html.T("Common.Records", "kayıt")
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item" data-bind="css: { disabled: currentPage() === 1 }">
                            <a class="page-link" href="#" data-bind="click: previousPage"><i class="bi bi-chevron-left"></i></a>
                        </li>
                        <!-- ko foreach: ko.utils.range(1, totalPages()) -->
                        <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }, visible: $data === 1 || $data === $parent.totalPages() || Math.abs($data - $parent.currentPage()) <= 2">
                            <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                        </li>
                        <!-- /ko -->
                        <li class="page-item" data-bind="css: { disabled: currentPage() === totalPages() }">
                            <a class="page-link" href="#" data-bind="click: nextPage"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                </nav>
                <select class="form-select form-select-sm" style="width: auto;" data-bind="value: pageSize">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Create/Edit Modal -->
    <div class="modal fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content" data-bind="with: editingCustomer">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <!-- ko ifnot: id -->
                        <i class="bi bi-plus-circle me-2"></i>@Html.T("Customer.NewCustomer", "Yeni Müşteri")
                        <!-- /ko -->
                        <!-- ko if: id -->
                        <i class="bi bi-pencil me-2"></i>@Html.T("Customer.EditCustomer", "Müşteri Düzenle")
                        <!-- /ko -->
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: $parent.closeModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">@Html.T("Customer.Code", "Müşteri Kodu")</label>
                            <input type="text" class="form-control" data-bind="value: code" placeholder="@Html.T("Customer.CodePlaceholder", "MUS-001")" autocomplete="off" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">@Html.T("Customer.CompanyName", "Şirket Adı") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: companyName" placeholder="@Html.T("Customer.CompanyNamePlaceholder", "ABC Şirketi Ltd. Şti.")" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">@Html.T("Customer.TaxNumber", "Vergi Numarası")</label>
                            <input type="text" class="form-control" data-bind="value: taxNumber" placeholder="1234567890" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Common.Phone", "Telefon")</label>
                            <input type="tel" class="form-control" data-bind="value: phone" placeholder="+90 555 123 45 67" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("User.Email", "E-posta")</label>
                            <input type="email" class="form-control" data-bind="value: email" placeholder="info@sirket.com" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Customer.City", "Şehir")</label>
                            <input type="text" class="form-control" data-bind="value: city" placeholder="@Html.T("Customer.CityPlaceholder", "İstanbul")" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Customer.Address", "Adres")</label>
                            <input type="text" class="form-control" data-bind="value: address" placeholder="@Html.T("Customer.AddressPlaceholder", "Merkez Mahallesi...")" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Customer.ContractStartDate", "Sözleşme Başlangıç Tarihi")</label>
                            <input type="date" class="form-control" data-bind="value: contractStartDate" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Customer.ContractEndDate", "Sözleşme Bitiş Tarihi")</label>
                            <input type="date" class="form-control" data-bind="value: contractEndDate" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.T("Customer.Notes", "Notlar")</label>
                        <textarea class="form-control" data-bind="value: notes" rows="4" placeholder="@Html.T("Customer.NotesPlaceholder", "Müşteri hakkında notlar...")"></textarea>
                    </div>

                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" data-bind="checked: isActive" id="isActive" />
                        <label class="form-check-label" for="isActive">@Html.T("Common.Active", "Aktif")</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closeModal">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-primary" data-bind="click: $parent.saveCustomer, disable: $parent.isSaving">
                        <span data-bind="visible: !$parent.isSaving()">
                            <i class="bi bi-check-circle me-2"></i>@Html.T("Common.Save", "Kaydet")
                        </span>
                        <span data-bind="visible: $parent.isSaving">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            @Html.T("Common.Saving", "Kaydediliyor...")
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }"></div>

    <!-- Personnel Management Modal -->
    <div class="modal fade" data-bind="css: { show: showPersonnelModal }, style: { display: showPersonnelModal() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-people"></i> @Html.T("Customer.CustomerPersonnel", "Müşteri Personelleri")
                        <span data-bind="if: selectedCustomerForPersonnel">
                            - <span data-bind="text: selectedCustomerForPersonnel().companyName"></span>
                        </span>
                    </h5>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-success btn-sm" data-bind="click: exportPersonnelToExcel, visible: selectedCustomerForPersonnel() && !isLoadingPersonnel()" title="@Html.T("Customer.ExportToExcel", "Excel'e Aktar")">
                            <i class="bi bi-file-earmark-excel"></i> @Html.T("Common.Excel", "Excel")
                        </button>
                        <button type="button" class="btn-close" data-bind="click: closePersonnelModal"></button>
                    </div>
                </div>
                <div class="modal-body">

                    <!-- Password Reset Form (Inline) -->
                    <div data-bind="visible: showChangePasswordModal" class="card border-primary mb-3">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <span>
                                <i class="bi bi-key me-2"></i>@Html.T("Customer.ResetPassword", "Şifre Sıfırla")
                                <span data-bind="if: selectedPersonnelForPassword">
                                    - <span data-bind="text: selectedPersonnelForPassword().fullName"></span>
                                </span>
                            </span>
                            <button type="button" class="btn-close btn-close-white" data-bind="click: cancelChangePassword"></button>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">@Html.T("User.NewPassword", "Yeni Şifre") <span class="text-danger">*</span></label>
                                    <input type="password" class="form-control" data-bind="value: newPassword" placeholder="@Html.T("User.PasswordPlaceholder", "En az 6 karakter")" />
                                    <small class="text-muted">@Html.T("Customer.PasswordMinLength", "En az 6 karakter olmalıdır")</small>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">@Html.T("User.ConfirmPassword", "Yeni Şifre (Tekrar)") <span class="text-danger">*</span></label>
                                    <input type="password" class="form-control" data-bind="value: confirmPassword" placeholder="@Html.T("User.ConfirmPasswordPlaceholder", "Yeni şifreyi tekrar girin")" />
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-primary" data-bind="click: resetPassword, disable: isResettingPassword">
                                    <span data-bind="visible: !isResettingPassword()">
                                        <i class="bi bi-check-circle me-1"></i>@Html.T("Customer.ResetPassword", "Şifre Sıfırla")
                                    </span>
                                    <span data-bind="visible: isResettingPassword">
                                        <span class="spinner-border spinner-border-sm me-1"></span>@Html.T("Customer.Resetting", "Sıfırlanıyor...")
                                    </span>
                                </button>
                                <button type="button" class="btn btn-secondary" data-bind="click: cancelChangePassword">@Html.T("Common.Cancel", "İptal")</button>
                            </div>
                        </div>
                    </div>

                    <!-- Personnel Actions -->
                    <div data-bind="visible: showPersonnelActions">
                        <div class="mb-3">
                            <div class="input-group w-50">
                                <input type="text" class="form-control" placeholder="@Html.T("Customer.SearchPersonnel", "Personel ara...")" data-bind="value: personnelSearchText, valueUpdate: 'input'" />
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                            </div>
                        </div>
                    </div>

                    <!-- Personnel Loading -->
                    <div data-bind="visible: showPersonnelLoading" class="text-center py-3">
                        <div class="spinner-border text-primary"></div>
                    </div>

                    <!-- Personnel Table -->
                    <div data-bind="visible: showPersonnelTable">
                        <div data-bind="visible: filteredPersonnel().length === 0" class="alert alert-info">
                            <i class="bi bi-info-circle"></i> @Html.T("Customer.NoPersonnel", "Bu müşteriye ait personel bulunmamaktadır.")
                        </div>

                        <div data-bind="visible: filteredPersonnel().length > 0">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>@Html.T("User.FullName", "Ad Soyad")</th>
                                        <th>@Html.T("User.Username", "Kullanıcı Adı")</th>
                                        <th>@Html.T("User.Email", "E-posta")</th>
                                        <th>@Html.T("User.Role", "Rol")</th>
                                        <th>@Html.T("Common.Status", "Durum")</th>
                                        <th>@Html.T("Common.Actions", "İşlemler")</th>
                                    </tr>
                                </thead>
                                <tbody data-bind="foreach: filteredPersonnel">
                                    <tr>
                                        <td data-bind="text: fullName"></td>
                                        <td><span class="badge bg-secondary" data-bind="text: username"></span></td>
                                        <td data-bind="text: email"></td>
                                        <td><span class="badge" data-bind="text: roleName, css: { 'bg-danger': role == 1, 'bg-info': role == 2, 'bg-secondary': role == 3 }"></span></td>
                                        <td>
                                            <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? '@Html.T("Common.Active", "Aktif")' : '@Html.T("Common.Inactive", "Pasif")'"></span>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary me-1" data-bind="click: $parent.editPersonnel" title="@Html.T("Common.Edit", "Düzenle")">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-info me-1" data-bind="click: $parent.showChangePasswordForPersonnel" title="@Html.T("User.ChangePassword", "Şifre Değiştir")">
                                                <i class="bi bi-key"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deletePersonnel" title="@Html.T("Common.Delete", "Sil")">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closePersonnelModal, visible: showPersonnelActions">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Close", "Kapat")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showPersonnelModal }, style: { display: showPersonnelModal() ? 'block' : 'none' }"></div>

    <!-- Personnel Create/Edit Modal -->
    <div class="modal fade" data-bind="css: { show: showPersonnelFormModal }, style: { display: showPersonnelFormModal() ? 'block' : 'none' }" tabindex="-1" style="z-index: 1060;">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" data-bind="with: editingPersonnel">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <!-- ko ifnot: id -->
                        <i class="bi bi-plus-circle me-2"></i>@Html.T("Customer.NewPersonnel", "Yeni Personel")
                        <!-- /ko -->
                        <!-- ko if: id -->
                        <i class="bi bi-pencil me-2"></i>@Html.T("Customer.EditPersonnel", "Personel Düzenle")
                        <!-- /ko -->
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: $parent.closePersonnelFormModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("User.Username", "Kullanıcı Adı") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: username" placeholder="ali.veli" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("User.Email", "E-posta") <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" data-bind="value: email" placeholder="ali.veli@example.com" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("User.FirstName", "Ad") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: firstName" placeholder="@Html.T("Customer.FirstNamePlaceholder", "Ali")" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("User.LastName", "Soyad") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: lastName" placeholder="@Html.T("Customer.LastNamePlaceholder", "Veli")" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("User.Role", "Rol") <span class="text-danger">*</span></label>
                            <select class="form-select" data-bind="value: role">
                                <option value="1">@Html.T("Customer.Role.Manager", "Müşteri Yöneticisi")</option>
                                <option value="2">@Html.T("Customer.Role.Supervisor", "Müşteri Süpervizörü")</option>
                                <option value="3">@Html.T("Customer.Role.Operator", "Müşteri Operatörü")</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Common.Phone", "Telefon")</label>
                            <input type="tel" class="form-control" data-bind="value: phoneNumber" placeholder="0555 123 4567" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Customer.Department", "Departman")</label>
                            <input type="text" class="form-control" data-bind="value: department" placeholder="@Html.T("Customer.DepartmentPlaceholder", "Kalite Kontrol")" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("CustomerPersonnel.JobTitle", "Ünvan")</label>
                        <input type="text" class="form-control" data-bind="value: title" placeholder="@Html.T("CustomerPersonnel.JobTitlePlaceholder", "Kalite Müdürü")" />
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" data-bind="checked: isActive" id="personnelIsActive" />
                        <label class="form-check-label" for="personnelIsActive">@Html.T("Common.Active", "Aktif")</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closePersonnelFormModal">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-primary" data-bind="click: $parent.savePersonnel, disable: $parent.isSavingPersonnel">
                        <span data-bind="visible: !$parent.isSavingPersonnel()">
                            <i class="bi bi-check-circle me-2"></i>@Html.T("Common.Save", "Kaydet")
                        </span>
                        <span data-bind="visible: $parent.isSavingPersonnel">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            @Html.T("Common.Saving", "Kaydediliyor...")
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showPersonnelFormModal }, style: { display: showPersonnelFormModal() ? 'block' : 'none' }" style="z-index: 1055;"></div>

    <!-- Organization Management Modal (Large) -->
    <div class="modal fade" data-bind="css: { show: showOrganizationModal }, style: { display: showOrganizationModal() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header bg-light py-2">
                    <h5 class="modal-title">
                        <i class="bi bi-diagram-3 me-2"></i>@Html.T("Customer.OrganizationManagement", "Organizasyon Yönetimi")
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: closeOrganizationModal"></button>
                </div>

                <!-- Customer Info Card -->
                <div class="bg-gradient" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);" data-bind="if: selectedCustomerForOrg">
                    <div class="container-fluid py-3 px-4 text-white">
                        <div class="row align-items-center">
                            <!-- Logo/Icon & Company Name -->
                            <div class="col-md-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-white bg-opacity-25 rounded-circle p-3 me-3">
                                        <i class="bi bi-building fs-3"></i>
                                    </div>
                                    <div>
                                        <h4 class="mb-0 fw-bold" data-bind="text: selectedCustomerForOrg().companyName"></h4>
                                        <span class="badge mt-1" data-bind="css: selectedCustomerForOrg().isActive ? 'bg-success' : 'bg-danger', text: selectedCustomerForOrg().isActive ? 'Aktif Müşteri' : 'Pasif'"></span>
                                    </div>
                                </div>
                            </div>
                            <!-- Contact Info -->
                            <div class="col-md-3">
                                <div class="small opacity-75 mb-1">@Html.T("Customer.Contact", "İletişim")</div>
                                <div data-bind="if: selectedCustomerForOrg().phone" class="mb-1"><i class="bi bi-telephone-fill me-2"></i><span data-bind="text: selectedCustomerForOrg().phone"></span></div>
                                <div data-bind="if: selectedCustomerForOrg().email"><i class="bi bi-envelope-fill me-2"></i><span data-bind="text: selectedCustomerForOrg().email"></span></div>
                            </div>
                            <!-- Address -->
                            <div class="col-md-3">
                                <div class="small opacity-75 mb-1">@Html.T("Customer.Address", "Adres")</div>
                                <div data-bind="if: selectedCustomerForOrg().city"><i class="bi bi-geo-alt-fill me-2"></i><span data-bind="text: selectedCustomerForOrg().city"></span></div>
                                <div data-bind="if: selectedCustomerForOrg().address" class="small opacity-75 text-truncate" style="max-width: 200px;" data-bind="text: selectedCustomerForOrg().address, attr: { title: selectedCustomerForOrg().address }"></div>
                            </div>
                            <!-- Contract & Tax -->
                            <div class="col-md-3">
                                <div class="row">
                                    <div class="col-6">
                                        <div class="small opacity-75 mb-1">VKN</div>
                                        <div class="fw-bold" data-bind="text: selectedCustomerForOrg().taxNumber || '-'"></div>
                                    </div>
                                    <div class="col-6">
                                        <div class="small opacity-75 mb-1">@Html.T("Customer.ContractEnd", "Sözleşme Bitiş")</div>
                                        <div class="fw-bold" data-bind="text: selectedCustomerForOrg().contractEndDate ? new Date(selectedCustomerForOrg().contractEndDate).toLocaleDateString('tr-TR') : '-'"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-body p-0">
                    <div class="row g-0 h-100">
                        <!-- Left Panel: Managers & Organizations (narrower) -->
                        <div class="col-2 border-end bg-light" style="min-height: calc(100vh - 200px); overflow-y: auto; max-width: 280px;">
                            <div class="p-2">
                                <!-- Firma Yöneticileri -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h6 class="mb-0 text-danger small"><i class="bi bi-person-badge me-1"></i>@Html.T("Customer.Managers", "Firma Yöneticileri")</h6>
                                        <button class="btn btn-sm btn-outline-danger py-0 px-1" data-bind="click: toggleNewManagerForm" title="@Html.T("Customer.NewManager", "Yeni Yönetici")">
                                            <i class="bi bi-plus"></i>
                                        </button>
                                    </div>

                                    <!-- Inline New Manager Form -->
                                    <div data-bind="visible: showNewManagerForm" class="mb-2">
                                        <div class="border border-danger rounded p-2 bg-white">
                                            <div class="row g-1">
                                                <div class="col-6"><input type="text" class="form-control form-control-sm" placeholder="Ad" data-bind="value: newManager().firstName" /></div>
                                                <div class="col-6"><input type="text" class="form-control form-control-sm" placeholder="Soyad" data-bind="value: newManager().lastName" /></div>
                                                <div class="col-6"><input type="text" class="form-control form-control-sm" placeholder="Kullanıcı Adı (örn: ali.veli)" title="Sadece İngilizce harf, rakam, alt çizgi, nokta ve tire kullanılabilir" data-bind="value: newManager().username" /></div>
                                                <div class="col-6"><input type="email" class="form-control form-control-sm" placeholder="E-posta" data-bind="value: newManager().email" /></div>
                                                <div class="col-8"><input type="password" class="form-control form-control-sm" placeholder="Şifre" data-bind="value: newManager().password" /></div>
                                                <div class="col-4">
                                                    <button class="btn btn-danger btn-sm w-100" data-bind="click: saveNewManager, disable: isSavingNewManager">
                                                        <span data-bind="visible: !isSavingNewManager()"><i class="bi bi-check"></i></span>
                                                        <span data-bind="visible: isSavingNewManager"><span class="spinner-border spinner-border-sm"></span></span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Manager List -->
                                    <div data-bind="foreach: customerManagers" class="list-group list-group-flush">
                                        <div class="list-group-item list-group-item-action py-2 px-2 d-flex justify-content-between align-items-center bg-transparent border-0 border-bottom">
                                            <div>
                                                <i class="bi bi-person-badge text-danger me-1"></i>
                                                <span data-bind="text: fullName" class="small"></span>
                                            </div>
                                            <button class="btn btn-outline-danger btn-sm py-0 px-1" data-bind="click: $parent.removeManager" title="@Html.T("Common.Delete", "Sil")">
                                                <i class="bi bi-x" style="font-size: 0.7rem;"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div data-bind="visible: customerManagers().length === 0" class="text-muted small text-center py-2">
                                        <i class="bi bi-info-circle"></i> Henüz yönetici yok
                                    </div>
                                </div>

                                <hr class="my-2">

                                <!-- Organizasyonlar/Şubeler -->
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="mb-0 small"><i class="bi bi-diagram-3 me-1"></i>@Html.T("Customer.OrganizationsBranches", "Organizasyonlar/Şubeler")</h6>
                                    <button class="btn btn-sm btn-primary py-0 px-1" data-bind="click: createNewOrganization">
                                        <i class="bi bi-plus"></i>
                                    </button>
                                </div>

                                <!-- Search Box -->
                                <div class="mb-2">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                                        <input type="text" class="form-control form-control-sm" placeholder="@Html.T("Common.Search", "Ara...")" data-bind="value: orgSearchText, valueUpdate: 'afterkeydown'" />
                                        <button class="btn btn-outline-secondary" type="button" data-bind="visible: orgSearchText(), click: function() { orgSearchText(''); }">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- Loading -->
                                <div data-bind="visible: isLoadingOrganizations" class="text-center py-2">
                                    <div class="spinner-border spinner-border-sm text-primary"></div>
                                </div>

                                <!-- Organization List -->
                                <div data-bind="visible: !isLoadingOrganizations()" style="max-height: calc(100vh - 450px); overflow-y: auto;">
                                    <div data-bind="visible: filteredOrganizations().length === 0" class="text-muted small py-2 text-center">
                                        <i class="bi bi-info-circle"></i> @Html.T("Customer.NoOrganizations", "Henüz organizasyon yok")
                                    </div>

                                    <div class="list-group list-group-flush" data-bind="foreach: filteredOrganizations">
                                        <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                             data-bind="click: $parent.selectOrganization, css: { 'active': $parent.selectedOrganization() && $parent.selectedOrganization().id === id }">
                                            <div>
                                                <div class="fw-semibold" data-bind="text: name"></div>
                                                <small class="text-muted">
                                                    <span data-bind="text: personnelCount"></span> @Html.T("Customer.Personnel", "Personel")
                                                </small>
                                            </div>
                                            <div class="btn-group btn-group-sm" data-bind="css: { 'active-org-buttons': $parent.selectedOrganization() && $parent.selectedOrganization().id === id }">
                                                <button class="btn btn-sm" data-bind="click: function(data, event) { event.stopPropagation(); $parent.editOrganization(data); }, css: $parent.selectedOrganization() && $parent.selectedOrganization().id === id ? 'btn-light' : 'btn-outline-primary'" title="@Html.T("Common.Edit", "Düzenle")">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-sm" data-bind="click: function(data, event) { event.stopPropagation(); $parent.deleteOrganization(data); }, css: $parent.selectedOrganization() && $parent.selectedOrganization().id === id ? 'btn-light text-danger' : 'btn-outline-danger'" title="@Html.T("Common.Delete", "Sil")">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Panel: Personnel Structure (expanded) -->
                        <div class="col" style="min-height: calc(100vh - 160px); overflow-y: auto;">
                            <div class="p-3">
                                <!-- No organization selected -->
                                <div data-bind="visible: !selectedOrganization()" class="text-center text-muted py-5">
                                    <i class="bi bi-arrow-left-circle display-4 mb-3 d-block"></i>
                                    <p>@Html.T("Customer.SelectOrganization", "Personelleri görmek için sol taraftan bir organizasyon seçin")</p>
                                </div>

                                <!-- Organization selected -->
                                <div data-bind="visible: selectedOrganization">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h5 class="mb-0">
                                            <i class="bi bi-people me-2"></i>
                                            <span data-bind="text: selectedOrganization() ? selectedOrganization().name : ''"></span>
                                            <small class="text-muted">- @Html.T("Customer.PersonnelStructure", "Personel Yapısı")</small>
                                        </h5>
                                    </div>

                                    <!-- Add Supervisor/Manager Section -->
                                    <div class="card mb-3">
                                        <div class="card-header bg-success text-white py-2">
                                            <i class="bi bi-person-plus me-2"></i>@Html.T("Customer.AddSupervisorOrManager", "Yönetici/Süpervizör Ekle")
                                        </div>
                                        <div class="card-body py-2">
                                            <div class="row g-2 align-items-end">
                                                <!-- Sol: Havuzdan Seç -->
                                                <div class="col-md-6">
                                                    <div class="d-flex gap-2 align-items-end" data-bind="visible: !showNewSupervisorForm()">
                                                        <div class="flex-grow-1">
                                                            <label class="form-label small mb-1">@Html.T("Customer.SelectFromPool", "Havuzdan Seç")</label>
                                                            <select class="form-select form-select-sm" data-bind="options: personnelPoolForSupervisor, optionsText: function(item) { return item.fullName + ' (' + item.roleName + ')'; }, optionsValue: 'id', value: selectedPoolPersonnelId, optionsCaption: '@Html.T("Common.Select", "Seçiniz...")'"></select>
                                                        </div>
                                                        <button class="btn btn-success btn-sm" data-bind="click: assignPoolPersonnelToOrg, enable: selectedPoolPersonnelId()">
                                                            <i class="bi bi-plus-circle"></i>
                                                        </button>
                                                    </div>
                                                </div>

                                                <!-- Sağ: Yeni Oluştur (Inline Form) -->
                                                <div class="col-md-6">
                                                    <!-- Buton -->
                                                    <div data-bind="visible: !showNewSupervisorForm()">
                                                        <label class="form-label small mb-1">@Html.T("Customer.OrNewCreate", "veya Yeni Oluştur")</label>
                                                        <button class="btn btn-outline-primary btn-sm w-100" data-bind="click: toggleNewSupervisorForm">
                                                            <i class="bi bi-person-plus me-1"></i>@Html.T("Customer.NewSupervisor", "Yeni Yönetici/Süpervizör")
                                                        </button>
                                                    </div>

                                                    <!-- Inline Form -->
                                                    <div data-bind="visible: showNewSupervisorForm">
                                                        <div class="border border-primary rounded p-2 bg-light">
                                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                                <small class="text-primary fw-bold"><i class="bi bi-person-plus me-1"></i>@Html.T("Customer.NewSupervisor", "Yeni Süpervizör")</small>
                                                                <button type="button" class="btn-close btn-close-sm" style="font-size: 0.6rem;" data-bind="click: toggleNewSupervisorForm"></button>
                                                            </div>
                                                            <div class="row g-1">
                                                                <div class="col-6"><input type="text" class="form-control form-control-sm" placeholder="Ad" data-bind="value: newSupervisor().firstName" /></div>
                                                                <div class="col-6"><input type="text" class="form-control form-control-sm" placeholder="Soyad" data-bind="value: newSupervisor().lastName" /></div>
                                                                <div class="col-6"><input type="text" class="form-control form-control-sm" placeholder="Kullanıcı Adı (örn: ali.veli)" title="Sadece İngilizce harf, rakam, alt çizgi, nokta ve tire kullanılabilir" data-bind="value: newSupervisor().username" /></div>
                                                                <div class="col-6"><input type="email" class="form-control form-control-sm" placeholder="E-posta" data-bind="value: newSupervisor().email" /></div>
                                                                <div class="col-8"><input type="password" class="form-control form-control-sm" placeholder="Şifre" data-bind="value: newSupervisor().password" /></div>
                                                                <div class="col-4">
                                                                    <button class="btn btn-primary btn-sm w-100" data-bind="click: saveNewSupervisor, disable: isSavingNewSupervisor">
                                                                        <span data-bind="visible: !isSavingNewSupervisor()"><i class="bi bi-check"></i></span>
                                                                        <span data-bind="visible: isSavingNewSupervisor"><span class="spinner-border spinner-border-sm"></span></span>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Personnel Loading -->
                                    <div data-bind="visible: isLoadingOrgPersonnel" class="text-center py-3">
                                        <div class="spinner-border text-primary"></div>
                                    </div>

                                    <!-- Personnel Structure -->
                                    <div data-bind="visible: !isLoadingOrgPersonnel()">
                                        <!-- Supervisors List -->
                                        <div data-bind="foreach: orgPersonnelList().supervisors">
                                            <div class="card mb-3 border-primary">
                                                <div class="card-header bg-primary bg-opacity-10 d-flex justify-content-between align-items-center py-2">
                                                    <div>
                                                        <i class="bi bi-person-badge me-2"></i>
                                                        <strong data-bind="text: fullName"></strong>
                                                        <!-- ko if: teamMembers.length === 0 -->
                                                        <span class="text-warning ms-1" title="@Html.T("Customer.OrgManager", "Organizasyon Yöneticisi")">*</span>
                                                        <!-- /ko -->
                                                        <span class="badge bg-primary ms-2" data-bind="text: roleName"></span>
                                                    </div>
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-outline-primary btn-sm" data-bind="click: $parent.editOrgPersonnel" title="@Html.T("Common.Edit", "Düzenle")">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button class="btn btn-outline-danger btn-sm" data-bind="click: $parent.removePersonnelFromOrg" title="@Html.T("Customer.RemoveFromOrg", "Organizasyondan Çıkar")">
                                                            <i class="bi bi-x-circle"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="card-body py-2">
                                                    <!-- Team Members (Operators) -->
                                                    <div class="ms-4">
                                                        <div data-bind="foreach: teamMembers" class="mb-2">
                                                            <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                                                <div>
                                                                    <i class="bi bi-person me-2 text-muted"></i>
                                                                    <span data-bind="text: fullName"></span>
                                                                    <span class="badge bg-secondary ms-2" data-bind="text: roleName"></span>
                                                                </div>
                                                                <div class="btn-group btn-group-sm">
                                                                    <button class="btn btn-outline-warning btn-sm" data-bind="click: $parents[1].makeIndependent" title="@Html.T("Customer.MakeIndependent", "Bağımsız Yap")">
                                                                        <i class="bi bi-unlock"></i>
                                                                    </button>
                                                                    <button class="btn btn-outline-primary btn-sm" data-bind="click: $parents[1].editOrgPersonnel" title="@Html.T("Common.Edit", "Düzenle")">
                                                                        <i class="bi bi-pencil"></i>
                                                                    </button>
                                                                    <button class="btn btn-outline-danger btn-sm" data-bind="click: $parents[1].removePersonnelFromOrg" title="@Html.T("Customer.RemoveFromOrg", "Organizasyondan Çıkar")">
                                                                        <i class="bi bi-x-circle"></i>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Add Operator Button -->
                                                        <button class="btn btn-outline-success btn-sm mt-2" data-bind="click: $parent.addOperatorToSupervisor">
                                                            <i class="bi bi-plus me-1"></i>@Html.T("Customer.AddOperator", "Operatör Ekle")
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Independent Operators (no supervisor) -->
                                        <div class="card mb-3 border-secondary">
                                            <div class="card-header bg-secondary bg-opacity-10 py-2 d-flex justify-content-between align-items-center">
                                                <span><i class="bi bi-people me-2"></i>@Html.T("Customer.IndependentOperators", "Bağımsız Operatörler")</span>
                                            </div>
                                            <div class="card-body py-2">
                                                <!-- Add Independent Operator -->
                                                <div class="mb-3 border-bottom pb-3">
                                                    <button class="btn btn-outline-success btn-sm" data-bind="click: addIndependentOperator">
                                                        <i class="bi bi-person-plus me-1"></i>@Html.T("Customer.NewIndependentOperator", "Yeni Bağımsız Operatör")
                                                    </button>
                                                </div>

                                                <!-- Operator List -->
                                                <div data-bind="visible: orgPersonnelList().operators && orgPersonnelList().operators.length > 0">
                                                    <div data-bind="foreach: orgPersonnelList().operators">
                                                        <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                                            <div>
                                                                <i class="bi bi-person me-2 text-muted"></i>
                                                                <span data-bind="text: fullName"></span>
                                                                <span class="badge bg-secondary ms-2" data-bind="text: roleName"></span>
                                                            </div>
                                                            <div class="btn-group btn-group-sm">
                                                                <button class="btn btn-outline-primary btn-sm" data-bind="click: $parent.editOrgPersonnel" title="@Html.T("Common.Edit", "Düzenle")">
                                                                    <i class="bi bi-pencil"></i>
                                                                </button>
                                                                <button class="btn btn-outline-danger btn-sm" data-bind="click: $parent.removePersonnelFromOrg" title="@Html.T("Customer.RemoveFromOrg", "Organizasyondan Çıkar")">
                                                                    <i class="bi bi-x-circle"></i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Empty state for operators -->
                                                <div data-bind="visible: !orgPersonnelList().operators || orgPersonnelList().operators.length === 0" class="text-muted small text-center py-2">
                                                    <i class="bi bi-info-circle"></i> @Html.T("Customer.NoIndependentOperators", "Bağımsız operatör yok")
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Empty state -->
                                        <div data-bind="visible: (!orgPersonnelList().supervisors || orgPersonnelList().supervisors.length === 0) && (!orgPersonnelList().operators || orgPersonnelList().operators.length === 0)" class="text-center text-muted py-4">
                                            <i class="bi bi-people display-4 mb-3 d-block"></i>
                                            <p>@Html.T("Customer.NoPersonnelInOrg", "Bu organizasyonda henüz personel yok")</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeOrganizationModal">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Close", "Kapat")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showOrganizationModal }, style: { display: showOrganizationModal() ? 'block' : 'none' }"></div>

    <!-- Organization Create/Edit Modal -->
    <div class="modal fade" data-bind="css: { show: showOrgFormModal }, style: { display: showOrgFormModal() ? 'block' : 'none' }" tabindex="-1" style="z-index: 1060;">
        <div class="modal-dialog">
            <div class="modal-content" data-bind="with: editingOrganization">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <!-- ko ifnot: id -->
                        <i class="bi bi-plus-circle me-2"></i>@Html.T("Customer.NewOrganization", "Yeni Organizasyon")
                        <!-- /ko -->
                        <!-- ko if: id -->
                        <i class="bi bi-pencil me-2"></i>@Html.T("Customer.EditOrganization", "Organizasyon Düzenle")
                        <!-- /ko -->
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: $parent.closeOrgFormModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Customer.OrganizationName", "Organizasyon Adı") <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" data-bind="value: name" placeholder="@Html.T("Customer.OrganizationNamePlaceholder", "Concentrix, Teleperform vb.")" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Customer.OrganizationCode", "Organizasyon Kodu")</label>
                        <input type="text" class="form-control" data-bind="value: code" placeholder="@Html.T("Customer.OrganizationCodePlaceholder", "CONC-001")" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Customer.Description", "Açıklama")</label>
                        <textarea class="form-control" data-bind="value: description" rows="2"></textarea>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" data-bind="checked: isActive" id="orgIsActive" />
                        <label class="form-check-label" for="orgIsActive">@Html.T("Common.Active", "Aktif")</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closeOrgFormModal">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-primary" data-bind="click: $parent.saveOrganization, disable: $parent.isSavingOrg">
                        <span data-bind="visible: !$parent.isSavingOrg()">
                            <i class="bi bi-check-circle me-2"></i>@Html.T("Common.Save", "Kaydet")
                        </span>
                        <span data-bind="visible: $parent.isSavingOrg">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            @Html.T("Common.Saving", "Kaydediliyor...")
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showOrgFormModal }, style: { display: showOrgFormModal() ? 'block' : 'none' }" style="z-index: 1055;"></div>

    <!-- Add Operator Modal -->
    <div class="modal fade" data-bind="css: { show: showAddOperatorModal }, style: { display: showAddOperatorModal() ? 'block' : 'none' }" tabindex="-1" style="z-index: 1060;">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-person-plus me-2"></i>@Html.T("Customer.AddOperator", "Operatör Ekle")
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: closeAddOperatorModal"></button>
                </div>
                <div class="modal-body">
                    <!-- ko if: selectedSupervisorForOperator() -->
                    <p class="text-muted mb-3">
                        @Html.T("Customer.AddOperatorToSupervisor", "Süpervizör:") <strong data-bind="text: selectedSupervisorForOperator().fullName"></strong>
                    </p>
                    <!-- /ko -->
                    <!-- ko ifnot: selectedSupervisorForOperator() -->
                    <p class="text-muted mb-3">
                        <i class="bi bi-info-circle me-1"></i>@Html.T("Customer.IndependentOperatorInfo", "Bu operatör bağımsız olarak eklenecek (süpervizörsüz)")
                    </p>
                    <!-- /ko -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("User.FirstName", "Ad") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: newOperator().firstName" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("User.LastName", "Soyad") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: newOperator().lastName" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("User.Username", "Kullanıcı Adı") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: newOperator().username" placeholder="ali.veli" title="Sadece İngilizce harf, rakam, alt çizgi, nokta ve tire kullanılabilir" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("User.Email", "E-posta") <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" data-bind="value: newOperator().email" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("User.Password", "Şifre") <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" data-bind="value: newOperator().password" placeholder="@Html.T("User.PasswordPlaceholder", "En az 6 karakter")" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeAddOperatorModal">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-primary" data-bind="click: saveNewOperator, disable: isSavingOperator">
                        <span data-bind="visible: !isSavingOperator()">
                            <i class="bi bi-check-circle me-2"></i>@Html.T("Common.Save", "Kaydet")
                        </span>
                        <span data-bind="visible: isSavingOperator">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            @Html.T("Common.Saving", "Kaydediliyor...")
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showAddOperatorModal }, style: { display: showAddOperatorModal() ? 'block' : 'none' }" style="z-index: 1055;"></div>

    <partial name="_DeleteConfirmationModal" />

    <!-- Delegate Selection Modal (when removing supervisor with team members) -->
    <div class="modal fade" data-bind="css: { show: showDelegateModal }, style: { display: showDelegateModal() ? 'block' : 'none' }" tabindex="-1" style="z-index: 1070;">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">
                        <i class="bi bi-arrow-left-right me-2"></i>@Html.T("Customer.SelectDelegate", "Vekil Seç")
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: closeDelegateModal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning mb-3">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong data-bind="text: personnelToRemove() ? personnelToRemove().fullName : ''"></strong>
                        @Html.T("Customer.HasTeamMembers", " personelinin altında ekip üyeleri var. Lütfen bu üyeleri devralacak bir vekil seçin.")
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.T("Customer.TeamMembersCount", "Devredilecek Ekip Üyeleri")</label>
                        <div class="badge bg-info fs-6" data-bind="text: (personnelToRemove() && personnelToRemove().teamMembers ? personnelToRemove().teamMembers.length : 0) + ' kişi'"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.T("Customer.SelectNewSupervisor", "Yeni Süpervizör Seçin") <span class="text-danger">*</span></label>
                        <select class="form-select" data-bind="options: availableDelegates, optionsText: 'fullName', optionsValue: 'id', value: selectedDelegateId, optionsCaption: '@Html.T("Common.Select", "Seçiniz...")'"></select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeDelegateModal">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-warning" data-bind="click: confirmRemoveWithDelegate, enable: selectedDelegateId(), disable: isRemovingWithDelegate">
                        <span data-bind="visible: !isRemovingWithDelegate()">
                            <i class="bi bi-arrow-left-right me-2"></i>@Html.T("Customer.TransferAndRemove", "Devret ve Çıkar")
                        </span>
                        <span data-bind="visible: isRemovingWithDelegate">
                            <span class="spinner-border spinner-border-sm me-2"></span>@Html.T("Common.Processing", "İşleniyor...")
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showDelegateModal }, style: { display: showDelegateModal() ? 'block' : 'none' }" style="z-index: 1065;"></div>

</div> <!-- End of customers-app -->

@section Scripts {
    <script src="~/js/Shared/app.config.js"></script>
    <script src="~/js/Shared/api.service.js"></script>
    <script src="~/js/Shared/enums.service.js"></script>
    <script src="~/js/Shared/delete-confirmation.js"></script>
    <script src="~/js/Shared/customer.api.service.js"></script>
    <script src="~/js/Customers/customers.js"></script>
}
