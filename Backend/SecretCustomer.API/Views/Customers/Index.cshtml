@{
    ViewData["Title"] = "Müşteriler";
}

<div id="customers-app" class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Müşteriler</h2>
        <button class="btn btn-primary" data-bind="click: createNew">
            <i class="bi bi-plus-circle"></i> Yeni Müşteri
        </button>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>

    <!-- Error Message -->
    <div data-bind="visible: errorMessage" class="alert alert-danger alert-dismissible fade show">
        <span data-bind="text: errorMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { errorMessage(''); }"></button>
    </div>

    <!-- Success Message -->
    <div data-bind="visible: successMessage" class="alert alert-success alert-dismissible fade show">
        <span data-bind="text: successMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { successMessage(''); }"></button>
    </div>

    <!-- Customers Table -->
    <div data-bind="visible: !isLoading()">
        <!-- Empty State -->
        <div data-bind="visible: customers().length === 0">
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Henüz müşteri bulunmamaktadır.
            </div>
        </div>

        <!-- Table -->
        <div data-bind="visible: customers().length > 0" class="card shadow">
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Şirket Adı</th>
                            <th>Vergi Numarası</th>
                            <th>Telefon</th>
                            <th>E-posta</th>
                            <th>Şehir</th>
                            <th>Personel</th>
                            <th>Şube</th>
                            <th>Proje</th>
                            <th>Sözleşme</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: customers">
                        <tr>
                            <td data-bind="text: companyName"></td>
                            <td><span class="badge bg-secondary" data-bind="text: taxNumber || '-'"></span></td>
                            <td data-bind="text: phone || '-'"></td>
                            <td data-bind="text: email || '-'"></td>
                            <td data-bind="text: city || '-'"></td>
                            <td><span class="badge bg-info" data-bind="text: personnelCount"></span></td>
                            <td><span class="badge bg-info" data-bind="text: branchCount"></span></td>
                            <td><span class="badge bg-info" data-bind="text: projectCount"></span></td>
                            <td>
                                <small data-bind="visible: contractStartDate">
                                    <span data-bind="text: $parent.formatDate(contractStartDate)"></span> -
                                    <span data-bind="text: $parent.formatDate(contractEndDate)"></span>
                                </small>
                                <span data-bind="visible: !contractStartDate">-</span>
                            </td>
                            <td>
                                <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? 'Aktif' : 'Pasif'"></span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-info me-1" data-bind="click: $parent.showPersonnel">
                                    <i class="bi bi-people"></i> Personeller
                                </button>
                                <button class="btn btn-sm btn-warning me-1" data-bind="click: $parent.editCustomer">
                                    <i class="bi bi-pencil"></i> Düzenle
                                </button>
                                <button class="btn btn-sm btn-danger" data-bind="click: $parent.deleteCustomer">
                                    <i class="bi bi-trash"></i> Sil
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Create/Edit Modal -->
    <div class="modal fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content" data-bind="with: editingCustomer">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <span data-bind="visible: !id">Yeni Müşteri</span>
                        <span data-bind="visible: id">Müşteri Düzenle</span>
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: $parent.closeModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Şirket Adı *</label>
                            <input type="text" class="form-control" data-bind="value: companyName" placeholder="ABC Şirketi Ltd. Şti." />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Vergi Numarası</label>
                            <input type="text" class="form-control" data-bind="value: taxNumber" placeholder="1234567890" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Telefon</label>
                            <input type="tel" class="form-control" data-bind="value: phone" placeholder="+90 555 123 45 67" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">E-posta</label>
                            <input type="email" class="form-control" data-bind="value: email" placeholder="info@sirket.com" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Şehir</label>
                            <input type="text" class="form-control" data-bind="value: city" placeholder="İstanbul" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Adres</label>
                            <input type="text" class="form-control" data-bind="value: address" placeholder="Merkez Mahallesi..." />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Sözleşme Başlangıç Tarihi</label>
                            <input type="date" class="form-control" data-bind="value: contractStartDate" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Sözleşme Bitiş Tarihi</label>
                            <input type="date" class="form-control" data-bind="value: contractEndDate" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Notlar</label>
                        <textarea class="form-control" data-bind="value: notes" rows="4" placeholder="Müşteri hakkında notlar..."></textarea>
                    </div>

                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" data-bind="checked: isActive" id="isActive" />
                        <label class="form-check-label" for="isActive">Aktif</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closeModal">İptal</button>
                    <button type="button" class="btn btn-primary" data-bind="click: $parent.saveCustomer, disable: $parent.isSaving">
                        <span data-bind="visible: !$parent.isSaving()">
                            <i class="bi bi-save"></i> Kaydet
                        </span>
                        <span data-bind="visible: $parent.isSaving">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            Kaydediliyor...
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }"></div>

    <!-- Personnel Management Modal -->
    <div class="modal fade" data-bind="css: { show: showPersonnelModal }, style: { display: showPersonnelModal() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-people"></i> Müşteri Personelleri
                        <span data-bind="if: selectedCustomerForPersonnel">
                            - <span data-bind="text: selectedCustomerForPersonnel().companyName"></span>
                        </span>
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: closePersonnelModal"></button>
                </div>
                <div class="modal-body">
                    <!-- Password Reset Form (Inline) -->
                    <div data-bind="visible: showChangePasswordModal" class="card border-primary mb-3">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <span>
                                <i class="bi bi-key me-2"></i>Şifre Sıfırla
                                <span data-bind="if: selectedPersonnelForPassword">
                                    - <span data-bind="text: selectedPersonnelForPassword().fullName"></span>
                                </span>
                            </span>
                            <button type="button" class="btn-close btn-close-white" data-bind="click: cancelChangePassword"></button>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Yeni Şifre *</label>
                                    <input type="password" class="form-control" data-bind="value: newPassword" placeholder="En az 6 karakter" />
                                    <small class="text-muted">En az 6 karakter olmalıdır</small>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Yeni Şifre (Tekrar) *</label>
                                    <input type="password" class="form-control" data-bind="value: confirmPassword" placeholder="Yeni şifreyi tekrar girin" />
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-primary" data-bind="click: resetPassword, disable: isResettingPassword">
                                    <span data-bind="visible: !isResettingPassword()">
                                        <i class="bi bi-check-circle me-1"></i>Şifre Sıfırla
                                    </span>
                                    <span data-bind="visible: isResettingPassword">
                                        <span class="spinner-border spinner-border-sm me-1"></span>Sıfırlanıyor...
                                    </span>
                                </button>
                                <button type="button" class="btn btn-secondary" data-bind="click: cancelChangePassword">İptal</button>
                            </div>
                        </div>
                    </div>

                    <!-- Personnel Actions -->
                    <div data-bind="visible: showPersonnelActions">
                        <div class="d-flex justify-content-between mb-3">
                            <div class="input-group w-50">
                                <input type="text" class="form-control" placeholder="Personel ara..." data-bind="value: personnelSearchText, valueUpdate: 'input'" />
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                            </div>
                            <button class="btn btn-primary" data-bind="click: createNewPersonnel">
                                <i class="bi bi-plus-circle"></i> Yeni Personel
                            </button>
                        </div>
                    </div>

                    <!-- Personnel Loading -->
                    <div data-bind="visible: showPersonnelLoading" class="text-center py-3">
                        <div class="spinner-border text-primary"></div>
                    </div>

                    <!-- Personnel Table -->
                    <div data-bind="visible: showPersonnelTable">
                        <div data-bind="visible: filteredPersonnel().length === 0" class="alert alert-info">
                            <i class="bi bi-info-circle"></i> Bu müşteriye ait personel bulunmamaktadır.
                        </div>

                        <div data-bind="visible: filteredPersonnel().length > 0">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Ad Soyad</th>
                                        <th>Kullanıcı Adı</th>
                                        <th>E-posta</th>
                                        <th>Rol</th>
                                        <th>Durum</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody data-bind="foreach: filteredPersonnel">
                                    <tr>
                                        <td data-bind="text: fullName"></td>
                                        <td><span class="badge bg-secondary" data-bind="text: username"></span></td>
                                        <td data-bind="text: email"></td>
                                        <td><span class="badge bg-primary" data-bind="text: roleName"></span></td>
                                        <td>
                                            <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? 'Aktif' : 'Pasif'"></span>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-warning me-1" data-bind="click: $parent.editPersonnel">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm btn-info me-1" data-bind="click: $parent.showChangePasswordForPersonnel">
                                                <i class="bi bi-key"></i>
                                            </button>
                                            <button class="btn btn-sm btn-danger" data-bind="click: $parent.deletePersonnel">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closePersonnelModal, visible: showPersonnelActions">Kapat</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showPersonnelModal }, style: { display: showPersonnelModal() ? 'block' : 'none' }"></div>

    <!-- Personnel Create/Edit Modal -->
    <div class="modal fade" data-bind="css: { show: showPersonnelFormModal }, style: { display: showPersonnelFormModal() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" data-bind="with: editingPersonnel">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <span data-bind="visible: !id">Yeni Personel</span>
                        <span data-bind="visible: id">Personel Düzenle</span>
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: $parent.closePersonnelFormModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Kullanıcı Adı *</label>
                            <input type="text" class="form-control" data-bind="value: username" placeholder="ali.veli" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">E-posta *</label>
                            <input type="email" class="form-control" data-bind="value: email" placeholder="ali.veli@example.com" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ad *</label>
                            <input type="text" class="form-control" data-bind="value: firstName" placeholder="Ali" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Soyad *</label>
                            <input type="text" class="form-control" data-bind="value: lastName" placeholder="Veli" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                <span data-bind="visible: !id">Şifre *</span>
                                <span data-bind="visible: id">Şifre (Değiştirmek için doldurun)</span>
                            </label>
                            <input type="password" class="form-control" data-bind="value: password" placeholder="••••••••" />
                            <small class="text-muted" data-bind="visible: id">Boş bırakırsanız mevcut şifre değişmez</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Rol *</label>
                            <select class="form-select" data-bind="value: role">
                                <option value="1">Müşteri Yöneticisi</option>
                                <option value="2">Müşteri Süpervizörü</option>
                                <option value="3">Müşteri Operatörü</option>
                                <option value="4">Müşteri Görüntüleyici</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Telefon</label>
                            <input type="tel" class="form-control" data-bind="value: phoneNumber" placeholder="0555 123 4567" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Departman</label>
                            <input type="text" class="form-control" data-bind="value: department" placeholder="Kalite Kontrol" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ünvan</label>
                        <input type="text" class="form-control" data-bind="value: title" placeholder="Kalite Müdürü" />
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" data-bind="checked: isActive" id="personnelIsActive" />
                        <label class="form-check-label" for="personnelIsActive">Aktif</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closePersonnelFormModal">İptal</button>
                    <button type="button" class="btn btn-primary" data-bind="click: $parent.savePersonnel, disable: $parent.isSavingPersonnel">
                        <span data-bind="visible: !$parent.isSavingPersonnel()">
                            <i class="bi bi-save"></i> Kaydet
                        </span>
                        <span data-bind="visible: $parent.isSavingPersonnel">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            Kaydediliyor...
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: showPersonnelFormModal }, style: { display: showPersonnelFormModal() ? 'block' : 'none' }"></div>

    <partial name="_DeleteConfirmationModal" />

</div> <!-- End of customers-app -->

@section Scripts {
    <script src="~/js/Shared/api.service.js"></script>
    <script src="~/js/Shared/delete-confirmation.js"></script>
    <script src="~/js/Shared/customer.api.service.js"></script>
    <script src="~/js/Customers/customers.js"></script>
}
