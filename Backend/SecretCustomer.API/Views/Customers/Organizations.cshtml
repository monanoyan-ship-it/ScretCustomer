@{
    Layout = "_LayoutPopup";
    ViewData["Title"] = Html.T("Organization.Title", "Organizasyon Yönetimi");
    var customerId = ViewBag.CustomerId;
    var customerName = ViewBag.CustomerName;
    var customerPhone = ViewBag.CustomerPhone ?? "";
    var customerEmail = ViewBag.CustomerEmail ?? "";
    var customerCity = ViewBag.CustomerCity ?? "";
    var customerTaxNumber = ViewBag.CustomerTaxNumber ?? "";
    var customerIsActive = ViewBag.CustomerIsActive ?? true;
}

<link rel="stylesheet" href="~/css/pages/organizations-popup.css" asp-append-version="true" />

<div id="organizations-app">
    <!-- Customer Header -->
    <div class="org-header">
        <div class="row align-items-center">
            <div class="col-md-4">
                <div class="d-flex align-items-center">
                    <div class="bg-white bg-opacity-25 rounded-circle p-3 me-3">
                        <i class="bi bi-building fs-3"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold">@customerName</h4>
                        <span class="badge mt-1 @(customerIsActive ? "bg-success" : "bg-danger")">
                            @(customerIsActive ? Html.T("Customer.ActiveCustomer", "Aktif Müşteri") : Html.T("Common.Inactive", "Pasif"))
                        </span>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="small opacity-75 mb-1">@Html.T("Common.Contact", "İletişim")</div>
                @if (!string.IsNullOrEmpty(customerPhone))
                {
                    <div class="mb-1"><i class="bi bi-telephone-fill me-2"></i>@customerPhone</div>
                }
                @if (!string.IsNullOrEmpty(customerEmail))
                {
                    <div><i class="bi bi-envelope-fill me-2"></i>@customerEmail</div>
                }
            </div>
            <div class="col-md-3">
                <div class="small opacity-75 mb-1">@Html.T("Common.Address", "Adres")</div>
                @if (!string.IsNullOrEmpty(customerCity))
                {
                    <div><i class="bi bi-geo-alt-fill me-2"></i>@customerCity</div>
                }
            </div>
            <div class="col-md-2 text-end">
                <button class="btn btn-light btn-sm" onclick="window.close()">
                    <i class="bi bi-x-lg me-1"></i>@Html.T("Common.Close", "Kapat")
                </button>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>

    <!-- Main Content -->
    <div data-bind="visible: !isLoading()" class="row g-0" style="margin: 0 -1.5rem;">
        <!-- Left Panel -->
        <div class="col-3 left-panel p-3">
            <!-- Firma Yöneticileri -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0 text-danger"><i class="bi bi-person-badge me-1"></i>@Html.T("Organization.CompanyManagers", "Firma Yöneticileri")</h6>
                    <button class="btn btn-sm btn-outline-danger py-0 px-1" data-bind="click: toggleNewManagerForm" title="@Html.T("Organization.NewManager", "Yeni Yönetici")">
                        <i class="bi bi-plus"></i>
                    </button>
                </div>

                <!-- Inline New Manager Form -->
                <div data-bind="visible: showNewManagerForm" class="inline-form border-danger">
                    <div class="row g-1">
                        <div class="col-6"><input type="text" class="form-control form-control-sm" placeholder="@Html.T("Common.FirstName", "Ad")" data-bind="value: newManager.firstName"></div>
                        <div class="col-6"><input type="text" class="form-control form-control-sm" placeholder="@Html.T("Common.LastName", "Soyad")" data-bind="value: newManager.lastName"></div>
                        <div class="col-6"><input type="text" class="form-control form-control-sm" placeholder="@Html.T("Common.Username", "Kullanıcı Adı")" data-bind="value: newManager.username"></div>
                        <div class="col-6"><input type="email" class="form-control form-control-sm" placeholder="@Html.T("Common.Email", "E-posta")" data-bind="value: newManager.email"></div>
                        <div class="col-8"><input type="password" class="form-control form-control-sm" placeholder="@Html.T("Common.Password", "Şifre")" data-bind="value: newManager.password"></div>
                        <div class="col-4">
                            <button class="btn btn-danger btn-sm w-100" data-bind="click: saveNewManager, disable: isSavingManager">
                                <span data-bind="visible: !isSavingManager()"><i class="bi bi-check"></i></span>
                                <span data-bind="visible: isSavingManager"><span class="spinner-border spinner-border-sm"></span></span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Manager List -->
                <div data-bind="foreach: managers" class="list-group list-group-flush">
                    <div class="list-group-item py-2 px-2 d-flex justify-content-between align-items-center bg-transparent border-0 border-bottom">
                        <div>
                            <i class="bi bi-person-badge text-danger me-1"></i>
                            <span data-bind="text: fullName" class="small"></span>
                        </div>
                        <button class="btn btn-outline-danger btn-sm py-0 px-1" data-bind="click: $parent.removeManager" title="@Html.T("Common.Delete", "Sil")">
                            <i class="bi bi-x" style="font-size: 0.7rem;"></i>
                        </button>
                    </div>
                </div>
                <div data-bind="visible: managers().length === 0" class="text-muted small text-center py-2">
                    <i class="bi bi-info-circle"></i> @Html.T("Organization.NoManagers", "Henüz yönetici yok")
                </div>
            </div>

            <hr class="my-2">

            <!-- Organizasyonlar -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0"><i class="bi bi-diagram-3 me-1"></i>@Html.T("Organization.Organizations", "Organizasyonlar")</h6>
                <button class="btn btn-sm btn-primary py-0 px-1" data-bind="click: createOrganization">
                    <i class="bi bi-plus"></i>
                </button>
            </div>

            <!-- Search -->
            <div class="mb-2">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control form-control-sm" placeholder="@Html.T("Common.Search", "Ara...")" data-bind="value: orgSearchText, valueUpdate: 'afterkeydown'">
                    <button class="btn btn-outline-secondary" type="button" data-bind="visible: orgSearchText(), click: function() { orgSearchText(''); }">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            </div>

            <!-- Org List -->
            <div data-bind="foreach: filteredOrganizations" class="list-group list-group-flush">
                <div class="list-group-item org-list-item d-flex justify-content-between align-items-center"
                     data-bind="click: $parent.selectOrganization, css: { active: $parent.selectedOrganization() && $parent.selectedOrganization().id === id }">
                    <div>
                        <div class="fw-semibold" data-bind="text: name"></div>
                        <small class="text-muted" data-bind="text: personnelCount + ' personel'"></small>
                    </div>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-sm btn-outline-primary py-0 px-1" data-bind="click: function(data, event) { event.stopPropagation(); $parent.editOrganization(data); }" title="@Html.T("Common.Edit", "Düzenle")">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger py-0 px-1" data-bind="click: function(data, event) { event.stopPropagation(); $parent.deleteOrganization(data); }" title="@Html.T("Common.Delete", "Sil")">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div data-bind="visible: filteredOrganizations().length === 0" class="text-muted small py-2 text-center">
                <i class="bi bi-info-circle"></i> @Html.T("Organization.NotFound", "Organizasyon bulunamadı")
            </div>
        </div>

        <!-- Right Panel -->
        <div class="col-9 right-panel">
            <!-- No selection -->
            <div data-bind="visible: !selectedOrganization()" class="text-center text-muted py-5">
                <i class="bi bi-arrow-left-circle display-4 mb-3 d-block"></i>
                <p>@Html.T("Organization.SelectOrgHint", "Personelleri görmek için sol taraftan bir organizasyon seçin")</p>
            </div>

            <!-- Selected Organization -->
            <div data-bind="visible: selectedOrganization">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">
                        <i class="bi bi-people me-2"></i>
                        <span data-bind="text: selectedOrganization() ? selectedOrganization().name : ''"></span>
                        <small class="text-muted">- @Html.T("Organization.PersonnelStructure", "Personel Yapısı")</small>
                    </h5>
                </div>

                <!-- Add Supervisor Section -->
                <div class="card mb-3">
                    <div class="card-header bg-success text-white py-2">
                        <i class="bi bi-person-plus me-2"></i>@Html.T("Organization.AddSupervisor", "Yönetici/Süpervizör Ekle")
                    </div>
                    <div class="card-body py-2">
                        <div class="row g-2 align-items-end">
                            <!-- Havuzdan Seç -->
                            <div class="col-md-6" data-bind="visible: !showNewSupervisorForm()">
                                <div class="d-flex gap-2 align-items-end">
                                    <div class="flex-grow-1">
                                        <label class="form-label small mb-1">@Html.T("Organization.SelectFromPool", "Havuzdan Seç")</label>
                                        <select class="form-select form-select-sm" data-bind="options: personnelPoolForSupervisor, optionsText: function(item) { return item.fullName + ' (' + item.roleName + ')'; }, optionsValue: 'id', value: selectedPoolPersonnelId, optionsCaption: '@Html.T("Common.Select", "Seçiniz...")'"></select>
                                    </div>
                                    <button class="btn btn-success btn-sm" data-bind="click: assignFromPool, enable: selectedPoolPersonnelId()">
                                        <i class="bi bi-plus-circle"></i>
                                    </button>
                                </div>
                            </div>
                            <!-- Yeni Oluştur -->
                            <div class="col-md-6">
                                <div data-bind="visible: !showNewSupervisorForm()">
                                    <label class="form-label small mb-1">@Html.T("Common.OrCreateNew", "veya Yeni Oluştur")</label>
                                    <button class="btn btn-outline-primary btn-sm w-100" data-bind="click: toggleNewSupervisorForm">
                                        <i class="bi bi-person-plus me-1"></i>@Html.T("Organization.NewSupervisor", "Yeni Süpervizör")
                                    </button>
                                </div>
                                <!-- Inline Form -->
                                <div data-bind="visible: showNewSupervisorForm" class="inline-form">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <small class="text-primary fw-bold"><i class="bi bi-person-plus me-1"></i>@Html.T("Organization.NewSupervisor", "Yeni Süpervizör")</small>
                                        <button type="button" class="btn-close" style="font-size: 0.6rem;" data-bind="click: toggleNewSupervisorForm"></button>
                                    </div>
                                    <div class="row g-1">
                                        <div class="col-6"><input type="text" class="form-control form-control-sm" placeholder="@Html.T("Common.FirstName", "Ad")" data-bind="value: newSupervisor.firstName"></div>
                                        <div class="col-6"><input type="text" class="form-control form-control-sm" placeholder="@Html.T("Common.LastName", "Soyad")" data-bind="value: newSupervisor.lastName"></div>
                                        <div class="col-6"><input type="text" class="form-control form-control-sm" placeholder="@Html.T("Common.Username", "Kullanıcı Adı")" data-bind="value: newSupervisor.username"></div>
                                        <div class="col-6"><input type="email" class="form-control form-control-sm" placeholder="@Html.T("Common.Email", "E-posta")" data-bind="value: newSupervisor.email"></div>
                                        <div class="col-8"><input type="password" class="form-control form-control-sm" placeholder="@Html.T("Common.Password", "Şifre")" data-bind="value: newSupervisor.password"></div>
                                        <div class="col-4">
                                            <button class="btn btn-primary btn-sm w-100" data-bind="click: saveNewSupervisor, disable: isSavingSupervisor">
                                                <span data-bind="visible: !isSavingSupervisor()"><i class="bi bi-check"></i></span>
                                                <span data-bind="visible: isSavingSupervisor"><span class="spinner-border spinner-border-sm"></span></span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Personnel Loading -->
                <div data-bind="visible: isLoadingPersonnel" class="text-center py-3">
                    <div class="spinner-border text-primary"></div>
                </div>

                <!-- Personnel Structure -->
                <div data-bind="visible: !isLoadingPersonnel()">
                    <!-- Supervisors -->
                    <div data-bind="foreach: orgPersonnel().supervisors">
                        <div class="card mb-3 border-primary">
                            <div class="card-header bg-primary bg-opacity-10 d-flex justify-content-between align-items-center py-2">
                                <div>
                                    <i class="bi bi-person-badge me-2"></i>
                                    <strong data-bind="text: fullName"></strong>
                                    <!-- ko if: teamMembers.length === 0 -->
                                    <span class="text-warning ms-1" title="@Html.T("Organization.OrgManager", "Organizasyon Yöneticisi")">*</span>
                                    <!-- /ko -->
                                    <span class="badge bg-primary ms-2" data-bind="text: roleName"></span>
                                </div>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-danger btn-sm" data-bind="click: $parent.removePersonnelFromOrg" title="@Html.T("Organization.RemoveFromOrg", "Organizasyondan Çıkar")">
                                        <i class="bi bi-x-circle"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="card-body py-2">
                                <!-- Team Members -->
                                <div class="ms-4">
                                    <div data-bind="foreach: teamMembers" class="mb-2">
                                        <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                            <div>
                                                <i class="bi bi-person me-2 text-muted"></i>
                                                <span data-bind="text: fullName"></span>
                                                <span class="badge bg-secondary ms-2" data-bind="text: roleName"></span>
                                            </div>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-warning btn-sm" data-bind="click: $parents[1].makeIndependent" title="@Html.T("Organization.MakeIndependent", "Bağımsız Yap")">
                                                    <i class="bi bi-unlock"></i>
                                                </button>
                                                <button class="btn btn-outline-danger btn-sm" data-bind="click: $parents[1].removePersonnelFromOrg" title="@Html.T("Organization.RemoveFromOrg", "Organizasyondan Çıkar")">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Add Operator to Team -->
                                    <div class="d-flex gap-2 align-items-center mt-2 flex-wrap">
                                        <div class="d-flex gap-1 align-items-center">
                                            <select class="form-select form-select-sm" style="width: auto; min-width: 150px;"
                                                    data-bind="options: $parent.unassignedOperators,
                                                               optionsText: 'fullName',
                                                               optionsValue: 'id',
                                                               value: $parent.selectedPoolOperatorForSupervisorId,
                                                               optionsCaption: '@Html.T("Common.SelectFromPool", "Havuzdan seç...")'"></select>
                                            <button class="btn btn-success btn-sm" data-bind="click: function() { $parent.assignOperatorToSupervisor($data); }, enable: $parent.selectedPoolOperatorForSupervisorId()" title="@Html.T("Organization.AddToTeam", "Ekibe Ekle")">
                                                <i class="bi bi-plus-circle"></i>
                                            </button>
                                        </div>
                                        <span class="text-muted small">@Html.T("Common.Or", "veya")</span>
                                        <button class="btn btn-outline-success btn-sm" data-bind="click: $parent.openAddOperatorModal">
                                            <i class="bi bi-person-plus me-1"></i>@Html.T("Common.CreateNew", "Yeni Oluştur")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Independent Operators -->
                    <div class="card mb-3 border-secondary">
                        <div class="card-header bg-secondary bg-opacity-10 py-2 d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-people me-2"></i>@Html.T("Organization.IndependentOperators", "Bağımsız Operatörler")</span>
                        </div>
                        <div class="card-body py-2">
                            <!-- Add Operator Section -->
                            <div class="mb-3 border-bottom pb-3">
                                <div class="d-flex gap-2 align-items-center flex-wrap">
                                    <div class="d-flex gap-1 align-items-center" data-bind="visible: unassignedOperators().length > 0">
                                        <select class="form-select form-select-sm" style="width: auto; min-width: 180px;"
                                                data-bind="options: unassignedOperators,
                                                           optionsText: 'fullName',
                                                           optionsValue: 'id',
                                                           value: selectedPoolOperatorId,
                                                           optionsCaption: '@Html.T("Common.SelectFromPool", "Havuzdan seç...")'"></select>
                                        <button class="btn btn-success btn-sm" data-bind="click: assignOperatorFromPool, enable: selectedPoolOperatorId()" title="@Html.T("Organization.AddAsIndependent", "Bağımsız Operatör Olarak Ekle")">
                                            <i class="bi bi-plus-circle"></i>
                                        </button>
                                    </div>
                                    <span class="text-muted small" data-bind="visible: unassignedOperators().length > 0">@Html.T("Common.Or", "veya")</span>
                                    <button class="btn btn-outline-success btn-sm" data-bind="click: addIndependentOperator">
                                        <i class="bi bi-person-plus me-1"></i>@Html.T("Common.CreateNew", "Yeni Oluştur")
                                    </button>
                                </div>
                            </div>
                            <!-- Operators -->
                            <div data-bind="visible: orgPersonnel().operators && orgPersonnel().operators.length > 0">
                                <div data-bind="foreach: orgPersonnel().operators">
                                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                        <div>
                                            <i class="bi bi-person me-2 text-muted"></i>
                                            <span data-bind="text: fullName"></span>
                                            <span class="badge bg-secondary ms-2" data-bind="text: roleName"></span>
                                        </div>
                                        <button class="btn btn-outline-danger btn-sm" data-bind="click: $parent.removePersonnelFromOrg" title="@Html.T("Organization.RemoveFromOrg", "Organizasyondan Çıkar")">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div data-bind="visible: !orgPersonnel().operators || orgPersonnel().operators.length === 0" class="text-muted small text-center py-2">
                                <i class="bi bi-info-circle"></i> @Html.T("Organization.NoIndependentOperators", "Bağımsız operatör yok")
                            </div>
                        </div>
                    </div>

                    <!-- Empty state -->
                    <div data-bind="visible: (!orgPersonnel().supervisors || orgPersonnel().supervisors.length === 0) && (!orgPersonnel().operators || orgPersonnel().operators.length === 0)" class="text-center text-muted py-4">
                        <i class="bi bi-people display-4 mb-3 d-block"></i>
                        <p>@Html.T("Organization.NoPersonnel", "Bu organizasyonda henüz personel yok")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Organization Create/Edit Modal -->
    <div class="modal fade" id="orgModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" data-bind="with: editingOrganization">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <!-- ko if: id -->
                        <i class="bi bi-pencil me-2"></i>@Html.T("Organization.EditOrg", "Organizasyon Düzenle")
                        <!-- /ko -->
                        <!-- ko ifnot: id -->
                        <i class="bi bi-plus-circle me-2"></i>@Html.T("Organization.NewOrg", "Yeni Organizasyon")
                        <!-- /ko -->
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Organization.OrgName", "Organizasyon Adı") <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" data-bind="value: name">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Organization.OrgCode", "Organizasyon Kodu")</label>
                        <input type="text" class="form-control" data-bind="value: code">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Common.Description", "Açıklama")</label>
                        <textarea class="form-control" rows="2" data-bind="value: description"></textarea>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="orgIsActive" data-bind="checked: isActive">
                        <label class="form-check-label" for="orgIsActive">@Html.T("Common.Active", "Aktif")</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Cancel", "İptal")</button>
                    <button type="button" class="btn btn-primary" data-bind="click: $parent.saveOrganization, disable: $parent.isSaving">
                        <span data-bind="visible: !$parent.isSaving()">@Html.T("Common.Save", "Kaydet")</span>
                        <span data-bind="visible: $parent.isSaving"><span class="spinner-border spinner-border-sm"></span></span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Operator Modal -->
    <div class="modal fade" id="addOperatorModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>@Html.T("Organization.AddOperator", "Operatör Ekle")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- ko if: selectedSupervisorForOperator() -->
                    <p class="text-muted mb-3">
                        @Html.T("Organization.Supervisor", "Süpervizör"): <strong data-bind="text: selectedSupervisorForOperator().fullName"></strong>
                    </p>
                    <!-- /ko -->
                    <!-- ko ifnot: selectedSupervisorForOperator() -->
                    <p class="text-muted mb-3">
                        <i class="bi bi-info-circle me-1"></i>@Html.T("Organization.IndependentOperatorHint", "Bu operatör bağımsız olarak eklenecek")
                    </p>
                    <!-- /ko -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Common.FirstName", "Ad") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: newOperator.firstName">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Common.LastName", "Soyad") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: newOperator.lastName">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Common.Username", "Kullanıcı Adı") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: newOperator.username" placeholder="ali.veli">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Common.Email", "E-posta") <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" data-bind="value: newOperator.email">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Common.Password", "Şifre") <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" data-bind="value: newOperator.password" placeholder="@Html.T("Common.MinChars", "En az 6 karakter")">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Cancel", "İptal")</button>
                    <button type="button" class="btn btn-primary" data-bind="click: saveNewOperator, disable: isSavingOperator">
                        <span data-bind="visible: !isSavingOperator()">@Html.T("Common.Save", "Kaydet")</span>
                        <span data-bind="visible: isSavingOperator"><span class="spinner-border spinner-border-sm"></span></span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delegate Selection Modal -->
    <div class="modal fade" id="delegateModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title"><i class="bi bi-arrow-left-right me-2"></i>@Html.T("Organization.SelectDelegate", "Vekil Seç")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning mb-3">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong data-bind="text: personnelToRemove() ? personnelToRemove().fullName : ''"></strong>
                        @Html.T("Organization.DelegateWarning", "personelinin altında ekip üyeleri var. Lütfen bu üyeleri devralacak bir vekil seçin.")
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Organization.TeamMembersToTransfer", "Devredilecek Ekip Üyeleri")</label>
                        <div class="badge bg-info fs-6" data-bind="text: (personnelToRemove() && personnelToRemove().teamMembers ? personnelToRemove().teamMembers.length : 0) + ' @Html.T("Common.Person", "kişi")'"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Organization.SelectNewSupervisor", "Yeni Süpervizör Seçin") <span class="text-danger">*</span></label>
                        <select class="form-select" data-bind="options: availableDelegates, optionsText: 'fullName', optionsValue: 'id', value: selectedDelegateId, optionsCaption: '@Html.T("Common.Select", "Seçiniz...")'"></select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Cancel", "İptal")</button>
                    <button type="button" class="btn btn-warning" data-bind="click: confirmRemoveWithDelegate, enable: selectedDelegateId(), disable: isRemovingWithDelegate">
                        <span data-bind="visible: !isRemovingWithDelegate()"><i class="bi bi-arrow-left-right me-2"></i>@Html.T("Organization.TransferAndRemove", "Devret ve Çıkar")</span>
                        <span data-bind="visible: isRemovingWithDelegate"><span class="spinner-border spinner-border-sm"></span></span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <partial name="_DeleteConfirmationModal" />
</div>

<script>
    window.organizationsConfig = {
        customerId: @customerId
    };
</script>

@section Scripts {
    <script src="~/js/Shared/api.service.js" asp-append-version="true"></script>
    <script src="~/js/Shared/delete-confirmation.js" asp-append-version="true"></script>
    <script src="~/js/Customers/organizations.js" asp-append-version="true"></script>
}
