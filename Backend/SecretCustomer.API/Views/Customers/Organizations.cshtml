@{
    Layout = "_LayoutPopup";
    ViewData["Title"] = Html.T("Organization.Title", "Şube/Organizasyon Yönetimi");
    var customerId = ViewBag.CustomerId;
    var customerName = ViewBag.CustomerName;
}

<div id="organizations-app">
    <!-- Header -->
    <div class="popup-header">
        <h4>
            <i class="bi bi-building me-2"></i>@Html.T("Organization.Title", "Şube/Organizasyon Yönetimi")
            <small class="text-muted ms-2">- @customerName</small>
        </h4>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" data-bind="click: createOrganization">
                <i class="bi bi-plus-circle me-1"></i>@Html.T("Organization.New", "Yeni Şube")
            </button>
            <button class="btn btn-secondary" onclick="window.close()">
                <i class="bi bi-x-lg me-1"></i>@Html.T("Common.Close", "Kapat")
            </button>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>

    <div data-bind="visible: !isLoading()" class="row">
        <!-- Organizations List (Left) -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white py-2">
                    <i class="bi bi-list me-2"></i>Şubeler
                    <span class="badge bg-light text-dark ms-2" data-bind="text: organizations().length"></span>
                </div>
                <div class="list-group list-group-flush" style="max-height: 600px; overflow-y: auto;" data-bind="foreach: organizations">
                    <a href="#" class="list-group-item list-group-item-action"
                       data-bind="click: $parent.selectOrganization, css: { active: $parent.selectedOrganization() && $parent.selectedOrganization().id === id }">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-medium" data-bind="text: name"></div>
                                <small class="text-muted" data-bind="text: code || '-'"></small>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-info" data-bind="text: personnelCount + ' kişi'"></span>
                            </div>
                        </div>
                    </a>
                </div>
                <!-- Empty -->
                <div data-bind="visible: organizations().length === 0" class="p-3 text-center text-muted">
                    <i class="bi bi-building"></i> Henüz şube yok
                </div>
            </div>
        </div>

        <!-- Organization Detail (Right) -->
        <div class="col-md-8">
            <!-- No selection -->
            <div data-bind="visible: !selectedOrganization()" class="card shadow-sm">
                <div class="card-body text-center text-muted py-5">
                    <i class="bi bi-arrow-left-circle" style="font-size: 3rem;"></i>
                    <p class="mt-3">Detayları görmek için sol listeden bir şube seçin.</p>
                </div>
            </div>

            <!-- Selected organization -->
            <div data-bind="visible: selectedOrganization()">
                <!-- Organization Info Card -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
                        <span><i class="bi bi-building me-2"></i><span data-bind="text: selectedOrganization() ? selectedOrganization().name : ''"></span></span>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-light btn-sm" data-bind="click: editOrganization" title="Düzenle">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-danger btn-sm" data-bind="click: deleteOrganization" title="Sil">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Personnel in Organization -->
                <div class="card shadow-sm">
                    <div class="card-header py-2 d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-people me-2"></i>Şube Personeli</span>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-primary btn-sm" data-bind="click: addSupervisor">
                                <i class="bi bi-person-plus me-1"></i>Süpervizör Ekle
                            </button>
                            <button class="btn btn-outline-success btn-sm" data-bind="click: addOperator">
                                <i class="bi bi-person-plus me-1"></i>Operatör Ekle
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <!-- Loading personnel -->
                        <div data-bind="visible: isLoadingPersonnel" class="text-center py-4">
                            <div class="spinner-border spinner-border-sm text-primary"></div>
                        </div>

                        <!-- Personnel list -->
                        <div data-bind="visible: !isLoadingPersonnel()">
                            <!-- Supervisors -->
                            <div data-bind="foreach: orgPersonnel().supervisors">
                                <div class="border-bottom p-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="badge bg-warning text-dark me-2">Süpervizör</span>
                                            <strong data-bind="text: fullName"></strong>
                                            <small class="text-muted ms-2" data-bind="text: email"></small>
                                        </div>
                                        <button class="btn btn-outline-danger btn-sm" data-bind="click: function() { $parent.removeFromOrg($data); }" title="Şubeden Çıkar">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </div>
                                    <!-- Team members -->
                                    <!-- ko if: teamMembers && teamMembers.length > 0 -->
                                    <div class="ms-4 mt-2">
                                        <!-- ko foreach: teamMembers -->
                                        <div class="d-flex justify-content-between align-items-center py-1">
                                            <div>
                                                <i class="bi bi-arrow-return-right text-muted me-2"></i>
                                                <span data-bind="text: fullName"></span>
                                                <small class="text-muted ms-2" data-bind="text: email"></small>
                                            </div>
                                            <button class="btn btn-outline-secondary btn-sm" data-bind="click: function() { $parents[1].removeFromOrg($data); }" title="Şubeden Çıkar">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </div>
                                        <!-- /ko -->
                                    </div>
                                    <!-- /ko -->
                                </div>
                            </div>

                            <!-- Independent Operators -->
                            <!-- ko foreach: orgPersonnel().operators -->
                            <div class="border-bottom p-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="badge bg-info me-2">Operatör</span>
                                        <span data-bind="text: fullName"></span>
                                        <small class="text-muted ms-2" data-bind="text: email"></small>
                                    </div>
                                    <button class="btn btn-outline-danger btn-sm" data-bind="click: function() { $parent.removeFromOrg($data); }" title="Şubeden Çıkar">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </div>
                            </div>
                            <!-- /ko -->

                            <!-- Empty state -->
                            <div data-bind="visible: orgPersonnel().supervisors.length === 0 && orgPersonnel().operators.length === 0" class="text-center text-muted py-4">
                                <i class="bi bi-people"></i> Bu şubede henüz personel yok
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Organization Create/Edit Modal -->
    <div class="modal fade" id="orgModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" data-bind="with: editingOrganization">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <!-- ko if: id -->
                        <i class="bi bi-pencil me-2"></i>Şube Düzenle
                        <!-- /ko -->
                        <!-- ko ifnot: id -->
                        <i class="bi bi-plus-circle me-2"></i>Yeni Şube
                        <!-- /ko -->
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Şube Adı <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" data-bind="value: name">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Şube Kodu</label>
                        <input type="text" class="form-control" data-bind="value: code">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Açıklama</label>
                        <textarea class="form-control" rows="2" data-bind="value: description"></textarea>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="orgIsActive" data-bind="checked: isActive">
                        <label class="form-check-label" for="orgIsActive">Aktif</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-primary" data-bind="click: $parent.saveOrganization, disable: $parent.isSaving">
                        <span data-bind="visible: !$parent.isSaving()">Kaydet</span>
                        <span data-bind="visible: $parent.isSaving"><span class="spinner-border spinner-border-sm me-1"></span></span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Personnel Modal -->
    <div class="modal fade" id="addPersonnelModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i><span data-bind="text: addPersonnelTitle"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Select from pool -->
                    <div class="mb-3" data-bind="visible: personnelPool().length > 0">
                        <label class="form-label">Mevcut Personelden Seç</label>
                        <select class="form-select" data-bind="value: selectedPoolPersonnelId, options: personnelPool, optionsValue: 'id', optionsText: function(p) { return p.fullName + ' (' + p.email + ')'; }, optionsCaption: '-- Seçin --'"></select>
                        <button class="btn btn-primary btn-sm mt-2" data-bind="click: assignFromPool, disable: !selectedPoolPersonnelId()">
                            <i class="bi bi-plus-circle me-1"></i>Ekle
                        </button>
                    </div>
                    <hr data-bind="visible: personnelPool().length > 0">
                    <!-- Or create new -->
                    <p class="text-muted small">veya yeni personel oluşturun:</p>
                    <div class="row g-2">
                        <div class="col-6">
                            <input type="text" class="form-control form-control-sm" placeholder="Ad" data-bind="value: newPersonnel.firstName">
                        </div>
                        <div class="col-6">
                            <input type="text" class="form-control form-control-sm" placeholder="Soyad" data-bind="value: newPersonnel.lastName">
                        </div>
                        <div class="col-6">
                            <input type="text" class="form-control form-control-sm" placeholder="Kullanıcı Adı" data-bind="value: newPersonnel.username">
                        </div>
                        <div class="col-6">
                            <input type="email" class="form-control form-control-sm" placeholder="E-posta" data-bind="value: newPersonnel.email">
                        </div>
                        <div class="col-12">
                            <input type="password" class="form-control form-control-sm" placeholder="Şifre" data-bind="value: newPersonnel.password">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-success btn-sm" data-bind="click: createAndAssign, disable: isSaving">
                        <span data-bind="visible: !isSaving()">Oluştur ve Ekle</span>
                        <span data-bind="visible: isSaving"><span class="spinner-border spinner-border-sm me-1"></span></span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <partial name="_DeleteConfirmationModal" />
</div>

<script>
    window.organizationsConfig = {
        customerId: @customerId
    };
</script>

@section Scripts {
    <script src="~/js/Shared/api.service.js"></script>
    <script src="~/js/Shared/delete-confirmation.js"></script>
    <script src="~/js/Customers/organizations.js"></script>
}
