@{
    ViewData["Title"] = @Html.T("Notification.Settings.Title", "Bildirim Ayarları");
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">@Html.T("Notification.Settings.Title", "Bildirim Ayarları")</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/">@Html.T("Common.Home", "Ana Sayfa")</a></li>
                    <li class="breadcrumb-item"><a href="/Notifications">@Html.T("Menu.Notifications", "Bildirimler")</a></li>
                    <li class="breadcrumb-item active">@Html.T("Common.Settings", "Ayarlar")</li>
                </ol>
            </nav>
        </div>
        <div>
            <a href="/Notifications" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>@Html.T("Common.Back", "Geri")
            </a>
        </div>
    </div>

    <!-- Settings Card -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-cog me-2"></i>@Html.T("Notification.Settings.Preferences", "Bildirim Tercihleri")</h5>
        </div>
        <div class="card-body">
            <p class="text-muted mb-4">@Html.T("Notification.Settings.Description", "Her bildirim türü için hangi kanallardan bildirim almak istediğinizi seçin.")</p>

            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 30%">@Html.T("Notification.Settings.NotificationType", "Bildirim Türü")</th>
                            <th class="text-center">@Html.T("Notification.Settings.InApp", "Uygulama İçi")</th>
                            <th class="text-center">@Html.T("Common.Email", "E-posta")</th>
                            <th class="text-center">@Html.T("Notification.Settings.SMS", "SMS")</th>
                            <th class="text-center">@Html.T("Notification.Settings.Push", "Push")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: settings">
                        <tr>
                            <td>
                                <span data-bind="text: $parent.getNotificationTypeText(notificationType)"></span>
                            </td>
                            <td class="text-center">
                                <div class="form-check form-switch d-flex justify-content-center">
                                    <input class="form-check-input" type="checkbox" data-bind="checked: inAppEnabled, event: { change: $parent.updateSetting.bind($parent, $data) }">
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="form-check form-switch d-flex justify-content-center">
                                    <input class="form-check-input" type="checkbox" data-bind="checked: emailEnabled, event: { change: $parent.updateSetting.bind($parent, $data) }">
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="form-check form-switch d-flex justify-content-center">
                                    <input class="form-check-input" type="checkbox" data-bind="checked: smsEnabled, event: { change: $parent.updateSetting.bind($parent, $data) }">
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="form-check form-switch d-flex justify-content-center">
                                    <input class="form-check-input" type="checkbox" data-bind="checked: pushEnabled, event: { change: $parent.updateSetting.bind($parent, $data) }">
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Empty State -->
            <div class="text-center py-4" data-bind="visible: settings().length === 0 && !loading()">
                <p class="text-muted">@Html.T("Notification.Settings.NoRecords", "Henüz bildirim ayarı bulunmamaktadır.")</p>
                <button class="btn btn-primary" data-bind="click: initializeSettings">
                    <i class="fas fa-plus me-2"></i>@Html.T("Notification.Settings.CreateDefaults", "Varsayılan Ayarları Oluştur")
                </button>
            </div>

            <!-- Loading -->
            <div class="text-center py-4" data-bind="visible: loading()">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">@Html.T("Common.Loading", "Yükleniyor...")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Info Card -->
    <div class="card mt-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>@Html.T("Common.Info", "Bilgi")</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h6>@Html.T("Notification.Settings.Channels", "Bildirim Kanalları")</h6>
                    <ul class="list-unstyled">
                        <li><i class="fas fa-desktop text-primary me-2"></i><strong>@Html.T("Notification.Settings.InApp", "Uygulama İçi"):</strong> @Html.T("Notification.Settings.InApp.Desc", "Sistemde oturum açtığınızda gösterilir")</li>
                        <li><i class="fas fa-envelope text-info me-2"></i><strong>@Html.T("Common.Email", "E-posta"):</strong> @Html.T("Notification.Settings.Email.Desc", "Kayıtlı e-posta adresinize gönderilir")</li>
                        <li><i class="fas fa-sms text-success me-2"></i><strong>@Html.T("Notification.Settings.SMS", "SMS"):</strong> @Html.T("Notification.Settings.SMS.Desc", "Kayıtlı telefon numaranıza gönderilir")</li>
                        <li><i class="fas fa-mobile-alt text-warning me-2"></i><strong>@Html.T("Notification.Settings.Push", "Push"):</strong> @Html.T("Notification.Settings.Push.Desc", "Mobil cihazınıza anlık bildirim gönderilir")</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <h6>@Html.T("Notification.Settings.ImportantNotes", "Önemli Notlar")</h6>
                    <ul class="list-unstyled">
                        <li><i class="fas fa-check text-success me-2"></i>@Html.T("Notification.Settings.Note.AutoSave", "Değişiklikler otomatik olarak kaydedilir")</li>
                        <li><i class="fas fa-exclamation-triangle text-warning me-2"></i>@Html.T("Notification.Settings.Note.Urgent", "Acil öncelikli bildirimler her durumda gönderilir")</li>
                        <li><i class="fas fa-shield-alt text-secondary me-2"></i>@Html.T("Notification.Settings.Note.System", "Sistem bildirimleri devre dışı bırakılamaz")</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Notifications/settings.js"></script>
}
