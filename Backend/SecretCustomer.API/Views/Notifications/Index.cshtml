@{
    ViewData["Title"] = @Html.T("Menu.Notifications", "Bildirimler");
}

<div id="notifications-app" class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">@Html.T("Menu.Notifications", "Bildirimler")</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/">@Html.T("Common.Home", "Ana Sayfa")</a></li>
                    <li class="breadcrumb-item active">@Html.T("Menu.Notifications", "Bildirimler")</li>
                </ol>
            </nav>
        </div>
        <div>
            <button class="btn btn-outline-primary me-2" data-bind="click: markAllAsRead, visible: summary().unreadCount > 0">
                <i class="bi bi-check-all me-2"></i>@Html.T("Notification.MarkAllAsRead", "Tümünü Okundu İşaretle")
            </button>
            <a href="/Notifications/Settings" class="btn btn-outline-secondary">
                <i class="bi bi-gear me-2"></i>@Html.T("Common.Settings", "Ayarlar")
            </a>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4" data-bind="with: summary">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body text-center">
                    <h3 class="mb-0" data-bind="text: totalNotifications">0</h3>
                    <small>@Html.T("Common.Total", "Toplam")</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark">
                <div class="card-body text-center">
                    <h3 class="mb-0" data-bind="text: unreadCount">0</h3>
                    <small>@Html.T("Notification.Unread", "Okunmamış")</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body text-center">
                    <h3 class="mb-0" data-bind="text: todayCount">0</h3>
                    <small>@Html.T("Common.Today", "Bugün")</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <h3 class="mb-0" data-bind="text: totalNotifications - unreadCount">0</h3>
                    <small>@Html.T("Notification.Read", "Okunan")</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-funnel me-2"></i>@Html.T("Common.Filters", "Filtreler")</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">@Html.T("Common.Type", "Tip")</label>
                    <select class="form-select" data-bind="value: filter.notificationType">
                        <option value="">@Html.T("Common.All", "Tümü")</option>
                        <option value="Info">@Html.T("Notification.Type.Info", "Bilgi")</option>
                        <option value="Success">@Html.T("Notification.Type.Success", "Başarılı")</option>
                        <option value="Warning">@Html.T("Common.Warning", "Uyarı")</option>
                        <option value="Error">@Html.T("Common.Error", "Hata")</option>
                        <option value="ApprovalRequest">@Html.T("Notification.TypeApprovalRequest", "Onay Talebi")</option>
                        <option value="Assignment">@Html.T("Approval.Type.Assignment", "Atama")</option>
                        <option value="MeetingInvite">@Html.T("Notification.Type.MeetingInvite", "Toplantı Daveti")</option>
                        <option value="TrainingInvite">@Html.T("Notification.Type.TrainingInvite", "Eğitim Daveti")</option>
                        <option value="Reminder">@Html.T("Notification.TypeReminder", "Hatırlatma")</option>
                        <option value="System">@Html.T("Notification.Type.System", "Sistem")</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Html.T("Call.Priority", "Öncelik")</label>
                    <select class="form-select" data-bind="value: filter.priority">
                        <option value="">@Html.T("Common.All", "Tümü")</option>
                        <option value="Low">@Html.T("Priority.Low", "Düşük")</option>
                        <option value="Normal">@Html.T("Priority.Normal", "Normal")</option>
                        <option value="High">@Html.T("Priority.High", "Yüksek")</option>
                        <option value="Urgent">@Html.T("Priority.Urgent", "Acil")</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Html.T("Common.Status", "Durum")</label>
                    <select class="form-select" data-bind="value: filter.isRead">
                        <option value="">@Html.T("Common.All", "Tümü")</option>
                        <option value="false">@Html.T("Notification.Unread", "Okunmamış")</option>
                        <option value="true">@Html.T("Notification.Read", "Okunmuş")</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Html.T("Common.Search", "Arama")</label>
                    <input type="text" class="form-control" placeholder="@Html.T("Notification.SearchPlaceholder", "Başlık, mesaj...")" data-bind="value: filter.searchTerm, valueUpdate: 'afterkeydown'" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-secondary w-100" data-bind="click: clearFilters">
                        <i class="bi bi-x-lg me-2"></i>@Html.T("Common.Clear", "Temizle")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Notifications List -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-bell me-2"></i>@Html.T("Menu.Notifications", "Bildirimler")</h5>
            <span class="badge bg-primary" data-bind="text: '@Html.T("Common.Total", "Toplam"): ' + totalCount()"></span>
        </div>
        <div class="card-body p-0">
            <div class="list-group list-group-flush" data-bind="foreach: notifications">
                <div class="list-group-item list-group-item-action" data-bind="css: { 'bg-light': !isRead }">
                    <div class="d-flex w-100 justify-content-between align-items-start">
                        <div class="d-flex">
                            <div class="me-3">
                                <span class="badge rounded-circle p-2" data-bind="css: $parent.getNotificationTypeIconClass(notificationType)">
                                    <i data-bind="css: $parent.getNotificationTypeIcon(notificationType)"></i>
                                </span>
                            </div>
                            <div>
                                <h6 class="mb-1" data-bind="text: title, css: { 'fw-bold': !isRead }"></h6>
                                <p class="mb-1 text-muted" data-bind="text: message"></p>
                                <small class="text-muted">
                                    <i class="bi bi-clock me-1"></i>
                                    <span data-bind="text: $parent.formatDate(createdAt)"></span>
                                    <span class="badge ms-2" data-bind="text: $parent.getPriorityText(priority), css: $parent.getPriorityBadgeClass(priority)"></span>
                                </small>
                            </div>
                        </div>
                        <div class="btn-group btn-group-sm">
                            <!-- ko if: !isRead -->
                            <button class="btn btn-outline-success" data-bind="click: $parent.markAsRead" title="@Html.T("Notification.MarkAsRead", "Okundu İşaretle")">
                                <i class="bi bi-check-lg"></i>
                            </button>
                            <!-- /ko -->
                            <button class="btn btn-outline-primary" data-bind="click: $parent.showDetail" title="@Html.T("Common.View", "Görüntüle")">
                                <i class="bi bi-eye"></i>
                            </button>
                            <button class="btn btn-outline-danger" data-bind="click: $parent.deleteNotification" title="@Html.T("Common.Delete", "Sil")">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Empty State -->
            <div class="text-center py-5" data-bind="visible: notifications().length === 0">
                <i class="bi bi-bell-slash fs-1 text-muted mb-3 d-block"></i>
                <p class="text-muted">@Html.T("Notification.NoRecords", "Henüz bildirim bulunmamaktadır.")</p>
            </div>
        </div>

        <!-- Pagination -->
        <div class="card-footer" data-bind="visible: totalPages() > 1">
            <nav>
                <ul class="pagination mb-0">
                    <li class="page-item" data-bind="css: { disabled: currentPage() === 1 }">
                        <a class="page-link" href="#" data-bind="click: previousPage">@Html.T("Common.Previous", "Önceki")</a>
                    </li>
                    <!-- ko foreach: visiblePages -->
                    <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }">
                        <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                    </li>
                    <!-- /ko -->
                    <li class="page-item" data-bind="css: { disabled: currentPage() === totalPages() }">
                        <a class="page-link" href="#" data-bind="click: nextPage">@Html.T("Pagination.Next", "Sonraki")</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

    <!-- Detail Modal -->
    <div class="modal fade" id="notificationDetailModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" data-bind="with: selectedNotification">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <span class="badge rounded-circle p-2 me-2" data-bind="css: $parent.getNotificationTypeIconClass(notificationType)">
                            <i data-bind="css: $parent.getNotificationTypeIcon(notificationType)"></i>
                        </span>
                        <span data-bind="text: title"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p data-bind="text: message"></p>
                    <hr />
                    <div class="row g-2 small text-muted">
                        <div class="col-6">
                            <strong>@Html.T("Common.Type", "Tip"):</strong>
                            <span data-bind="text: notificationType"></span>
                        </div>
                        <div class="col-6">
                            <strong>@Html.T("Call.Priority", "Öncelik"):</strong>
                            <span class="badge" data-bind="text: $parent.getPriorityText(priority), css: $parent.getPriorityBadgeClass(priority)"></span>
                        </div>
                        <div class="col-6">
                            <strong>@Html.T("Common.Channel", "Kanal"):</strong>
                            <span data-bind="text: channel"></span>
                        </div>
                        <div class="col-6">
                            <strong>@Html.T("Common.Status", "Durum"):</strong>
                            <span class="badge" data-bind="text: isRead ? '@Html.T("Notification.Read", "Okunmuş")' : '@Html.T("Notification.Unread", "Okunmamış")', css: isRead ? 'bg-success' : 'bg-warning text-dark'"></span>
                        </div>
                        <!-- ko if: senderUserName -->
                        <div class="col-6">
                            <strong>@Html.T("Common.Sender", "Gönderen"):</strong>
                            <span data-bind="text: senderUserName"></span>
                        </div>
                        <!-- /ko -->
                        <div class="col-6">
                            <strong>@Html.T("Common.Date", "Tarih"):</strong>
                            <span data-bind="text: $parent.formatDateFull(createdAt)"></span>
                        </div>
                        <!-- ko if: readAt -->
                        <div class="col-6">
                            <strong>@Html.T("Notification.ReadAt", "Okunma Tarihi"):</strong>
                            <span data-bind="text: $parent.formatDateFull(readAt)"></span>
                        </div>
                        <!-- /ko -->
                        <!-- ko if: relatedEntityType -->
                        <div class="col-12">
                            <strong>@Html.T("Common.RelatedEntity", "İlgili Kayıt"):</strong>
                            <span data-bind="text: relatedEntityType"></span>
                            <!-- ko if: relatedEntityId -->
                            <span class="text-muted">(#<span data-bind="text: relatedEntityId"></span>)</span>
                            <!-- /ko -->
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Html.T("Common.Close", "Kapat")</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Notifications/index.js" asp-append-version="true"></script>
}
