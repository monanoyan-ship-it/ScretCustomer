@{
    ViewData["Title"] = Html.T("User.Title", "Kullanıcılar");
}

<div id="users-app" class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@Html.T("User.Title", "Kullanıcılar")</h2>
        <button class="btn btn-primary" data-bind="click: createNew">
            <i class="bi bi-plus-circle"></i> @Html.T("User.NewUser", "Yeni Kullanıcı")
        </button>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>

    <!-- Error Message -->
    <div data-bind="visible: errorMessage" class="alert alert-danger alert-dismissible fade show">
        <span data-bind="text: errorMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { errorMessage(''); }"></button>
    </div>

    <!-- Success Message -->
    <div data-bind="visible: successMessage" class="alert alert-success alert-dismissible fade show">
        <span data-bind="text: successMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { successMessage(''); }"></button>
    </div>

    <!-- Users Table -->
    <div data-bind="visible: !isLoading()">
        <!-- Empty State -->
        <div data-bind="visible: users().length === 0">
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> @Html.T("User.NoUsers", "Henüz kullanıcı bulunmamaktadır.")
            </div>
        </div>

        <!-- Table -->
        <div data-bind="visible: users().length > 0" class="card shadow">
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>@Html.T("User.Username", "Kullanıcı Adı")</th>
                            <th>@Html.T("User.FullName", "Ad Soyad")</th>
                            <th>@Html.T("User.Email", "E-posta")</th>
                            <th>@Html.T("User.Role", "Rol")</th>
                            <th>@Html.T("Common.Status", "Durum")</th>
                            <th>@Html.T("Common.Actions", "İşlemler")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: users">
                        <tr>
                            <td><strong data-bind="text: username"></strong></td>
                            <td data-bind="text: firstName + ' ' + lastName"></td>
                            <td data-bind="text: email"></td>
                            <td>
                                <span class="badge" data-bind="css: $parent.getRoleBadgeClass(role), text: $parent.getRoleDisplayName(role)"></span>
                            </td>
                            <td>
                                <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? '@Html.T("Common.Active", "Aktif")' : '@Html.T("Common.Inactive", "Pasif")'"></span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" data-bind="click: $parent.editUser" title="@Html.T("Common.Edit", "Düzenle")">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-info me-1" data-bind="click: $parent.changePassword" title="@Html.T("User.ChangePassword", "Şifre Değiştir")">
                                    <i class="bi bi-key"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deleteUser" title="@Html.T("Common.Delete", "Sil")">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Create/Edit Modal -->
    <div class="modal fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" data-bind="with: editingUser">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <!-- ko ifnot: id -->
                        <i class="bi bi-plus-circle me-2"></i>@Html.T("User.NewUser", "Yeni Kullanıcı")
                        <!-- /ko -->
                        <!-- ko if: id -->
                        <i class="bi bi-pencil me-2"></i>@Html.T("User.EditUser", "Kullanıcı Düzenle")
                        <!-- /ko -->
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: $parent.closeModal"></button>
                </div>
                <div class="modal-body">
                    <!-- Modal Hata Mesajı -->
                    <div data-bind="visible: $root.modalErrorMessage()" class="alert alert-danger alert-dismissible mb-3">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <span data-bind="text: $root.modalErrorMessage()"></span>
                        <button type="button" class="btn-close" data-bind="click: function() { $root.modalErrorMessage(''); }"></button>
                    </div>

                    <!-- Username (only for create) -->
                    <div class="mb-3" data-bind="visible: !id">
                        <label class="form-label">@Html.T("User.Username", "Kullanıcı Adı") <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" data-bind="value: username" placeholder="johndoe" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("User.FirstName", "Ad") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: firstName" placeholder="@Html.T("User.FirstNamePlaceholder", "Ahmet")" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("User.LastName", "Soyad") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: lastName" placeholder="@Html.T("User.LastNamePlaceholder", "Yılmaz")" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.T("User.Email", "E-posta") <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" data-bind="value: email" placeholder="ahmet@example.com" />
                    </div>

                    <!-- Password (only for create) -->
                    <div class="mb-3" data-bind="visible: !id">
                        <label class="form-label">@Html.T("User.Password", "Şifre") <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" data-bind="value: password" placeholder="@Html.T("User.PasswordPlaceholder", "En az 6 karakter")" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.T("User.Role", "Rol") <span class="text-danger">*</span></label>
                        <select class="form-select" data-bind="value: role">
                            <option value="1">@Html.T("User.Admin", "Admin")</option>
                            <option value="2">@Html.T("User.QualitySpecialist", "Kalite Uzmanı")</option>
                            <option value="3">@Html.T("User.FieldWorker", "Saha Çalışanı")</option>
                        </select>
                    </div>

                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" data-bind="checked: isActive" id="isActive" />
                        <label class="form-check-label" for="isActive">@Html.T("Common.Active", "Aktif")</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closeModal">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-primary" data-bind="click: $parent.saveUser, disable: $parent.isSaving">
                        <span data-bind="visible: !$parent.isSaving()">
                            <i class="bi bi-check-circle me-2"></i>@Html.T("Common.Save", "Kaydet")
                        </span>
                        <span data-bind="visible: $parent.isSaving">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            @Html.T("Common.Saving", "Kaydediliyor...")
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }"></div>

    <!-- Change Password Modal -->
    <div class="modal fade" data-bind="css: { show: isPasswordModalOpen }, style: { display: isPasswordModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" data-bind="with: passwordChangeUser">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-key me-2"></i>@Html.T("User.ChangePassword", "Şifre Değiştir")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bind="click: $parent.closePasswordModal"></button>
                </div>
                <div class="modal-body">
                    <!-- Modal Hata Mesajı -->
                    <div data-bind="visible: $root.modalErrorMessage()" class="alert alert-danger alert-dismissible mb-3">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <span data-bind="text: $root.modalErrorMessage()"></span>
                        <button type="button" class="btn-close" data-bind="click: function() { $root.modalErrorMessage(''); }"></button>
                    </div>

                    <div class="alert alert-info">
                        <strong data-bind="text: username"></strong> @Html.T("User.PasswordChangeInfo", "kullanıcısının şifresini değiştiriyorsunuz.")
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("User.NewPassword", "Yeni Şifre") <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" data-bind="value: newPassword" placeholder="@Html.T("User.PasswordPlaceholder", "En az 6 karakter")" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("User.ConfirmPassword", "Yeni Şifre (Tekrar)") <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" data-bind="value: newPasswordConfirm" placeholder="@Html.T("User.ConfirmPasswordPlaceholder", "Şifreyi tekrar girin")" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closePasswordModal">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-info" data-bind="click: $parent.savePassword, disable: $parent.isSaving">
                        <span data-bind="visible: !$parent.isSaving()">
                            <i class="bi bi-check-circle me-2"></i>@Html.T("User.ChangePasswordBtn", "Şifreyi Değiştir")
                        </span>
                        <span data-bind="visible: $parent.isSaving">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            @Html.T("User.Changing", "Değiştiriliyor...")
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isPasswordModalOpen }, style: { display: isPasswordModalOpen() ? 'block' : 'none' }"></div>

    <partial name="_DeleteConfirmationModal" />

</div> <!-- End of users-app -->

@section Scripts {
    <script src="~/js/Shared/delete-confirmation.js"></script>
    <script src="~/js/Users/Index.js"></script>
}
