@{
    ViewData["Title"] = Html.T("Menu.Users", "Kullanıcılar");
}

<div id="users-app" class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@Html.T("Menu.Users", "Kullanıcılar")</h2>
        <!-- Sadece Sistem Kullanıcıları tabında göster -->
        <button class="btn btn-primary" data-bind="visible: activeTab() === 'users', click: createNew">
            <i class="bi bi-plus-circle"></i>
            @Html.T("User.NewUser", "Yeni Kullanıcı")
        </button>
    </div>

    <!-- Tab Navigation -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link" href="#" data-bind="css: { active: activeTab() === 'users' }, click: function() { switchTab('users'); }">
                <i class="bi bi-person-gear me-2"></i>@Html.T("User.SystemUsers", "Sistem Kullanıcıları")
                <span class="badge bg-primary ms-2" data-bind="text: allUsers().length"></span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="#" data-bind="css: { active: activeTab() === 'customerPersonnel' }, click: function() { switchTab('customerPersonnel'); }">
                <i class="bi bi-people me-2"></i>@Html.T("Menu.CustomerPersonnel", "Müşteri Personeli")
                <span class="badge bg-info ms-2" data-bind="text: allCustomerPersonnel().length"></span>
            </a>
        </li>
    </ul>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>

    <!-- ==================== SISTEM KULLANICILARI TAB ==================== -->
    <div data-bind="visible: !isLoading() && activeTab() === 'users'">
        <!-- Search Filter -->
        <div class="card shadow-sm mb-3">
            <div class="card-body py-2">
                <div class="row align-items-center">
                    <div class="col-md-4">
                        <input type="text" class="form-control form-control-sm" placeholder="@Html.T("Common.Search", "Ara...")" data-bind="value: usersSearchText, valueUpdate: 'afterkeydown'" autocomplete="off">
                    </div>
                    <div class="col-md-8 text-end">
                        <span class="text-muted small" data-bind="text: usersTotalCount() + ' @Html.T("Common.RecordSuffix", "kayıt")'"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: usersTotalCount() === 0">
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> @Html.T("User.NoUsers", "Henüz sistem kullanıcısı bulunmamaktadır.")
            </div>
        </div>

        <!-- Users Table -->
        <div data-bind="visible: usersTotalCount() > 0" class="card shadow">
            <div class="card-body p-0">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th class="sortable" data-bind="click: function() { sorting.toggleSort('username'); }, css: sorting.getSortClass('username')">
                                @Html.T("User.Username", "Kullanıcı Adı")
                                <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('username')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { sorting.toggleSort('firstName'); }, css: sorting.getSortClass('firstName')">
                                @Html.T("User.FullName", "Ad Soyad")
                                <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('firstName')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { sorting.toggleSort('email'); }, css: sorting.getSortClass('email')">
                                @Html.T("Common.Email", "E-posta")
                                <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('email')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { sorting.toggleSort('role'); }, css: sorting.getSortClass('role')">
                                @Html.T("User.Role", "Rol")
                                <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('role')"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { sorting.toggleSort('isActive'); }, css: sorting.getSortClass('isActive')">
                                @Html.T("Common.Status", "Durum")
                                <i class="bi sort-icon" data-bind="css: sorting.getSortIcon('isActive')"></i>
                            </th>
                            <th>@Html.T("Common.Actions", "İşlemler")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: sortedUsers">
                        <tr>
                            <td><strong data-bind="text: username"></strong></td>
                            <td data-bind="text: firstName + ' ' + lastName"></td>
                            <td data-bind="text: email"></td>
                            <td>
                                <span class="badge" data-bind="css: $parent.getRoleBadgeClass(roleId), text: $parent.getRoleDisplayName(roleId)"></span>
                            </td>
                            <td>
                                <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? '@Html.T("Common.Active", "Aktif")' : '@Html.T("Common.Inactive", "Pasif")'"></span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" data-bind="click: $parent.editUser" title="@Html.T("Common.Edit", "Düzenle")">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-info me-1" data-bind="click: $parent.changePassword" title="@Html.T("User.ChangePassword", "Şifre Değiştir")">
                                    <i class="bi bi-key"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deleteUser" title="@Html.T("Common.Delete", "Sil")">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- Users Pagination -->
            <div class="card-footer d-flex justify-content-between align-items-center" data-bind="visible: usersTotalPages() > 1">
                <div class="text-muted small">
                    <span data-bind="text: ((usersPage() - 1) * parseInt(usersPageSize(), 10) + 1) + '-' + Math.min(usersPage() * parseInt(usersPageSize(), 10), usersTotalCount()) + ' / ' + usersTotalCount()"></span>
                    @Html.T("Common.Records", "kayıt")
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item" data-bind="css: { disabled: usersPage() === 1 }">
                            <a class="page-link" href="#" data-bind="click: usersPreviousPage"><i class="bi bi-chevron-left"></i></a>
                        </li>
                        <!-- ko foreach: ko.utils.range(1, usersTotalPages()) -->
                        <li class="page-item" data-bind="css: { active: $data === $parent.usersPage() }, visible: $data === 1 || $data === $parent.usersTotalPages() || Math.abs($data - $parent.usersPage()) <= 2">
                            <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.usersGoToPage($data); }"></a>
                        </li>
                        <!-- /ko -->
                        <li class="page-item" data-bind="css: { disabled: usersPage() === usersTotalPages() }">
                            <a class="page-link" href="#" data-bind="click: usersNextPage"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                </nav>
                <select class="form-select form-select-sm" style="width: auto;" data-bind="value: usersPageSize">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        </div>
    </div>

    <!-- ==================== MÜŞTERİ PERSONELİ TAB ==================== -->
    <div data-bind="visible: !isLoading() && activeTab() === 'customerPersonnel'">
        <!-- Filter -->
        <div class="card shadow-sm mb-3">
            <div class="card-body py-2">
                <div class="row align-items-center">
                    <div class="col-md-4">
                        <select class="form-select form-select-sm" data-bind="value: selectedCustomerId, options: customers, optionsValue: 'id', optionsText: 'companyName', optionsCaption: '@Html.T("CustomerPersonnel.AllCustomers", "Tüm Müşteriler")'"></select>
                    </div>
                    <div class="col-md-4">
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control" placeholder="@Html.T("Common.Search", "Ara...")" data-bind="value: searchText, valueUpdate: 'afterkeydown'" autocomplete="off">
                            <span class="input-group-text" data-bind="visible: cpIsLoading">
                                <span class="spinner-border spinner-border-sm"></span>
                            </span>
                        </div>
                    </div>
                    <div class="col-md-4 text-end">
                        <span class="text-muted small" data-bind="text: cpTotalCount() + ' @Html.T("Common.RecordSuffix", "kayıt")'"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: cpTotalCount() === 0 && !cpIsLoading()">
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> @Html.T("CustomerPersonnel.NoPersonnel", "Müşteri personeli bulunmamaktadır.")
            </div>
        </div>

        <!-- Customer Personnel Table -->
        <div data-bind="visible: cpTotalCount() > 0" class="card shadow">
            <div class="card-body p-0">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th class="sortable" data-bind="click: function() { cpSorting.toggleSort('username'); }, css: cpSorting.getSortClass('username')">
                                @Html.T("User.Username", "Kullanıcı Adı") <i class="bi sort-icon"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { cpSorting.toggleSort('firstName'); }, css: cpSorting.getSortClass('firstName')">
                                @Html.T("User.FullName", "Ad Soyad") <i class="bi sort-icon"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { cpSorting.toggleSort('customerName'); }, css: cpSorting.getSortClass('customerName')">
                                @Html.T("CustomerPersonnel.Customer", "Müşteri") <i class="bi sort-icon"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { cpSorting.toggleSort('email'); }, css: cpSorting.getSortClass('email')">
                                @Html.T("Common.Email", "E-posta") <i class="bi sort-icon"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { cpSorting.toggleSort('role'); }, css: cpSorting.getSortClass('role')">
                                @Html.T("User.Role", "Rol") <i class="bi sort-icon"></i>
                            </th>
                            <th class="sortable" data-bind="click: function() { cpSorting.toggleSort('isActive'); }, css: cpSorting.getSortClass('isActive')">
                                @Html.T("Common.Status", "Durum") <i class="bi sort-icon"></i>
                            </th>
                            <th>@Html.T("Common.Actions", "İşlemler")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredCustomerPersonnel">
                        <tr>
                            <td><strong data-bind="text: username"></strong></td>
                            <td data-bind="text: firstName + ' ' + lastName"></td>
                            <td>
                                <span class="badge bg-secondary" data-bind="text: customerName"></span>
                            </td>
                            <td data-bind="text: email"></td>
                            <td>
                                <span class="badge" data-bind="css: $parent.getCustomerRoleBadgeClass(role), text: $parent.getCustomerRoleDisplayName(role)"></span>
                            </td>
                            <td>
                                <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? '@Html.T("Common.Active", "Aktif")' : '@Html.T("Common.Inactive", "Pasif")'"></span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" data-bind="click: $parent.editCustomerPersonnel" title="@Html.T("Common.Edit", "Düzenle")">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-info me-1" data-bind="click: $parent.changeCustomerPersonnelPassword" title="@Html.T("User.ChangePassword", "Şifre Değiştir")">
                                    <i class="bi bi-key"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deleteCustomerPersonnel" title="@Html.T("Common.Delete", "Sil")">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- Customer Personnel Pagination -->
            <div class="card-footer d-flex justify-content-between align-items-center" data-bind="visible: cpTotalPages() > 1">
                <div class="text-muted small">
                    <span data-bind="text: ((cpPage() - 1) * parseInt(cpPageSize(), 10) + 1) + '-' + Math.min(cpPage() * parseInt(cpPageSize(), 10), cpTotalCount()) + ' / ' + cpTotalCount()"></span>
                    @Html.T("Common.Records", "kayıt")
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item" data-bind="css: { disabled: cpPage() === 1 }">
                            <a class="page-link" href="#" data-bind="click: cpPreviousPage"><i class="bi bi-chevron-left"></i></a>
                        </li>
                        <!-- ko foreach: ko.utils.range(1, cpTotalPages()) -->
                        <li class="page-item" data-bind="css: { active: $data === $parent.cpPage() }, visible: $data === 1 || $data === $parent.cpTotalPages() || Math.abs($data - $parent.cpPage()) <= 2">
                            <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.cpGoToPage($data); }"></a>
                        </li>
                        <!-- /ko -->
                        <li class="page-item" data-bind="css: { disabled: cpPage() === cpTotalPages() }">
                            <a class="page-link" href="#" data-bind="click: cpNextPage"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                </nav>
                <select class="form-select form-select-sm" style="width: auto;" data-bind="value: cpPageSize">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        </div>
    </div>

    <!-- ==================== USER MODAL ==================== -->
    <div class="modal fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" data-bind="with: editingUser">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <!-- ko ifnot: id -->
                        <i class="bi bi-plus-circle me-2"></i>@Html.T("User.NewUser", "Yeni Kullanıcı")
                        <!-- /ko -->
                        <!-- ko if: id -->
                        <i class="bi bi-pencil me-2"></i>@Html.T("User.EditUser", "Kullanıcı Düzenle")
                        <!-- /ko -->
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: $parent.closeModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3" data-bind="visible: !id">
                        <label class="form-label">@Html.T("User.Username", "Kullanıcı Adı") <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" data-bind="value: username" placeholder="johndoe" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("User.FirstName", "Ad") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: firstName" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Common.LastName", "Soyad") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: lastName" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.T("Common.Email", "E-posta") <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" data-bind="value: email" />
                    </div>

                    <div class="mb-3" data-bind="visible: !id">
                        <label class="form-label">@Html.T("User.Password", "Şifre") <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" data-bind="value: password" placeholder="@Html.T("User.PasswordPlaceholder", "En az 6 karakter")" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.T("User.Role", "Rol") <span class="text-danger">*</span></label>
                        <select class="form-select" data-bind="value: role, options: $root.userRoles, optionsValue: 'id', optionsText: 'name'"></select>
                    </div>

                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" data-bind="checked: isActive" id="userIsActive" />
                        <label class="form-check-label" for="userIsActive">@Html.T("Common.Active", "Aktif")</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closeModal">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-primary" data-bind="click: $parent.saveUser, disable: $parent.isSaving">
                        <span data-bind="visible: !$parent.isSaving()">
                            <i class="bi bi-check-circle me-2"></i>@Html.T("Common.Save", "Kaydet")
                        </span>
                        <span data-bind="visible: $parent.isSaving">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }"></div>

    <!-- ==================== CUSTOMER PERSONNEL MODAL ==================== -->
    <div class="modal fade" data-bind="css: { show: isCustomerPersonnelModalOpen }, style: { display: isCustomerPersonnelModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" data-bind="with: editingCustomerPersonnel">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title">
                        <!-- ko ifnot: id -->
                        <i class="bi bi-plus-circle me-2"></i>@Html.T("CustomerPersonnel.New", "Yeni Müşteri Personeli")
                        <!-- /ko -->
                        <!-- ko if: id -->
                        <i class="bi bi-pencil me-2"></i>@Html.T("CustomerPersonnel.Edit", "Müşteri Personeli Düzenle")
                        <!-- /ko -->
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bind="click: $parent.closeCustomerPersonnelModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@Html.T("CustomerPersonnel.Customer", "Müşteri") <span class="text-danger">*</span></label>
                        <select class="form-select" data-bind="value: customerId, options: $root.customers, optionsValue: 'id', optionsText: 'companyName', optionsCaption: '@Html.T("CustomerPersonnel.SelectCustomer", "Müşteri Seçin...")'"></select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.T("User.Username", "Kullanıcı Adı") <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" data-bind="value: username" autocomplete="username" />
                        <div class="form-text text-muted">@Html.T("User.UsernameHint", "Sadece İngilizce harf, rakam, alt çizgi, nokta ve tire")</div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("User.FirstName", "Ad") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: firstName" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Common.LastName", "Soyad") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: lastName" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Common.Email", "E-posta") <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" data-bind="value: email" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("User.Phone", "Telefon")</label>
                            <input type="tel" class="form-control" data-bind="value: phoneNumber" autocomplete="tel" />
                        </div>
                    </div>

                    <div class="mb-3" data-bind="visible: !id">
                        <label class="form-label">@Html.T("User.Password", "Şifre") <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" data-bind="value: password" placeholder="@Html.T("User.PasswordPlaceholder", "En az 6 karakter")" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("User.Role", "Rol") <span class="text-danger">*</span></label>
                            <select class="form-select" data-bind="value: role, options: $root.customerPersonnelRoles, optionsValue: 'id', optionsText: 'name'"></select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("CustomerPersonnel.Department", "Departman")</label>
                            <input type="text" class="form-control" data-bind="value: department" />
                        </div>
                    </div>

                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" data-bind="checked: isActive" id="cpIsActive" />
                        <label class="form-check-label" for="cpIsActive">@Html.T("Common.Active", "Aktif")</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closeCustomerPersonnelModal">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-info" data-bind="click: $parent.saveCustomerPersonnel, disable: $parent.isSaving">
                        <span data-bind="visible: !$parent.isSaving()">
                            <i class="bi bi-check-circle me-2"></i>@Html.T("Common.Save", "Kaydet")
                        </span>
                        <span data-bind="visible: $parent.isSaving">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isCustomerPersonnelModalOpen }, style: { display: isCustomerPersonnelModalOpen() ? 'block' : 'none' }"></div>

    <!-- ==================== PASSWORD MODAL ==================== -->
    <div class="modal fade" data-bind="css: { show: isPasswordModalOpen }, style: { display: isPasswordModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" data-bind="with: passwordChangeUser">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">
                        <i class="bi bi-key me-2"></i>@Html.T("User.ChangePassword", "Şifre Değiştir")
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: $parent.closePasswordModal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info">
                        <strong data-bind="text: username"></strong> @Html.T("User.PasswordChangeInfo", "kullanıcısının şifresini değiştiriyorsunuz.")
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("User.NewPassword", "Yeni Şifre") <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" data-bind="value: newPassword" autocomplete="new-password" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("User.ConfirmPassword", "Yeni Şifre (Tekrar)") <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" data-bind="value: newPasswordConfirm" autocomplete="new-password" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closePasswordModal">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-warning" data-bind="click: $parent.savePassword, disable: $parent.isSaving">
                        <span data-bind="visible: !$parent.isSaving()">
                            <i class="bi bi-check-circle me-2"></i>@Html.T("User.ChangePasswordBtn", "Şifreyi Değiştir")
                        </span>
                        <span data-bind="visible: $parent.isSaving">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isPasswordModalOpen }, style: { display: isPasswordModalOpen() ? 'block' : 'none' }"></div>

    <partial name="_DeleteConfirmationModal" />

</div>

@section Scripts {
    <script src="~/js/Shared/enums.service.js"></script>
    <script src="~/js/Shared/delete-confirmation.js"></script>
    <script src="~/js/Users/Index.js"></script>
}
