@{
    ViewData["Title"] = Html.T("FieldWorker.Title", "Saha Çalışanları");
}

<div id="fieldworkers-app" class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@Html.T("FieldWorker.Title", "Saha Çalışanları")</h2>
        <button class="btn btn-primary" data-bind="click: createNew">
            <i class="bi bi-plus-circle"></i> @Html.T("FieldWorker.NewFieldWorker", "Yeni Saha Çalışanı")
        </button>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>

    <!-- Error Message -->
    <div data-bind="visible: errorMessage" class="alert alert-danger alert-dismissible fade show">
        <span data-bind="text: errorMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { errorMessage(''); }"></button>
    </div>

    <!-- Success Message -->
    <div data-bind="visible: successMessage" class="alert alert-success alert-dismissible fade show">
        <span data-bind="text: successMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { successMessage(''); }"></button>
    </div>

    <!-- Field Workers Table -->
    <div data-bind="visible: !isLoading()">
        <!-- Empty State -->
        <div data-bind="visible: fieldWorkers().length === 0">
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> @Html.T("FieldWorker.NoFieldWorkers", "Henüz saha çalışanı bulunmamaktadır.")
            </div>
        </div>

        <!-- Table -->
        <div data-bind="visible: fieldWorkers().length > 0" class="card shadow">
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>@Html.T("FieldWorker.FullName", "Ad Soyad")</th>
                            <th>@Html.T("FieldWorker.Phone", "Telefon")</th>
                            <th>@Html.T("FieldWorker.Email", "E-posta")</th>
                            <th>@Html.T("FieldWorker.Address", "Adres")</th>
                            <th>@Html.T("Common.Status", "Durum")</th>
                            <th>@Html.T("Common.Actions", "İşlemler")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: fieldWorkers">
                        <tr>
                            <td data-bind="text: firstName + ' ' + lastName"></td>
                            <td data-bind="text: phoneNumber"></td>
                            <td data-bind="text: email || '-'"></td>
                            <td data-bind="text: address"></td>
                            <td>
                                <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? '@Html.T("Common.Active", "Aktif")' : '@Html.T("Common.Inactive", "Pasif")'"></span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" data-bind="click: $parent.editFieldWorker" title="@Html.T("Common.Edit", "Düzenle")">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deleteFieldWorker" title="@Html.T("Common.Delete", "Sil")">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Create/Edit Modal -->
    <div class="modal fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" data-bind="with: editingFieldWorker">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <!-- ko ifnot: id -->
                        <i class="bi bi-plus-circle me-2"></i>@Html.T("FieldWorker.NewFieldWorker", "Yeni Saha Çalışanı")
                        <!-- /ko -->
                        <!-- ko if: id -->
                        <i class="bi bi-pencil me-2"></i>@Html.T("FieldWorker.EditFieldWorker", "Saha Çalışanı Düzenle")
                        <!-- /ko -->
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: $parent.closeModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("FieldWorker.FirstName", "Ad") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: firstName" placeholder="@Html.T("FieldWorker.FirstNamePlaceholder", "Ahmet")" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("FieldWorker.LastName", "Soyad") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: lastName" placeholder="@Html.T("FieldWorker.LastNamePlaceholder", "Yılmaz")" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("FieldWorker.Username", "Kullanıcı Adı") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: username" placeholder="@Html.T("FieldWorker.UsernamePlaceholder", "ahmet.yilmaz")" />
                        </div>
                        <div class="col-md-6 mb-3" data-bind="visible: !id">
                            <label class="form-label">@Html.T("FieldWorker.Password", "Şifre") <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" data-bind="value: password" placeholder="@Html.T("FieldWorker.PasswordPlaceholder", "En az 6 karakter")" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("FieldWorker.Phone", "Telefon") <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control" data-bind="value: phoneNumber" placeholder="@Html.T("FieldWorker.PhonePlaceholder", "+90 555 123 45 67")" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("FieldWorker.Email", "E-posta")</label>
                            <input type="email" class="form-control" data-bind="value: email" placeholder="@Html.T("FieldWorker.EmailPlaceholder", "ahmet@example.com")" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.T("FieldWorker.Address", "Adres") <span class="text-danger">*</span></label>
                        <textarea class="form-control" data-bind="value: address" rows="3" placeholder="@Html.T("FieldWorker.AddressPlaceholder", "Tam adres bilgisi...")"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@Html.T("FieldWorker.Notes", "Notlar")</label>
                        <textarea class="form-control" data-bind="value: notes" rows="2" placeholder="@Html.T("FieldWorker.NotesPlaceholder", "Ek notlar...")"></textarea>
                    </div>

                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" data-bind="checked: isActive" id="isActive" />
                        <label class="form-check-label" for="isActive">@Html.T("Common.Active", "Aktif")</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closeModal">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-primary" data-bind="click: $parent.saveFieldWorker, disable: $parent.isSaving">
                        <span data-bind="visible: !$parent.isSaving()">
                            <i class="bi bi-check-circle me-2"></i>@Html.T("Common.Save", "Kaydet")
                        </span>
                        <span data-bind="visible: $parent.isSaving">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            @Html.T("Common.Saving", "Kaydediliyor...")
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isModalOpen }, style: { display: isModalOpen() ? 'block' : 'none' }"></div>

    <partial name="_DeleteConfirmationModal" />

</div> <!-- End of fieldworkers-app -->

@section Scripts {
    <script src="~/js/Shared/delete-confirmation.js"></script>
    <script src="~/js/FieldWorkers/Index.js"></script>
}
