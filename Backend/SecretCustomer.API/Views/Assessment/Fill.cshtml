@{
    Layout = "_LayoutPopup";
    ViewData["Title"] = Html.T("Assessment.Fill.Title", "Personel Değerlendirme").ToString();
    var token = ViewBag.Token as string;
}

<div id="assessment-app">
    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary spinner-lg"></div>
        <p class="mt-3 text-muted">@Html.T("Assessment.Fill.Loading", "Değerlendirme formu yükleniyor...")</p>
    </div>

    <!-- Error -->
    <div data-bind="visible: !isLoading() && errorMessage()" class="text-center py-5">
        <i class="bi bi-exclamation-triangle text-danger icon-xl"></i>
        <h4 class="mt-3 text-danger" data-bind="text: errorMessage"></h4>
        <p class="text-muted">@Html.T("Assessment.Fill.ErrorHint", "Lütfen size gönderilen linki kontrol edin veya yöneticinize başvurun.")</p>
    </div>

    <!-- All Completed -->
    <div data-bind="visible: !isLoading() && !errorMessage() && isAllCompleted()">
        <div class="text-center py-5">
            <div class="mb-4">
                <i class="bi bi-check-circle text-success icon-xxl"></i>
            </div>
            <h2 class="text-success mb-3">@Html.T("Assessment.Fill.AllCompleted", "Tüm Değerlendirmeler Tamamlandı!")</h2>
            <p class="lead text-muted mb-4">@Html.T("Assessment.Fill.AllCompletedMessage", "Tüm değerlendirme adımlarını başarıyla tamamladınız.")</p>
            <p class="text-muted">@Html.T("Assessment.Fill.CloseWindow", "Katılımınız için teşekkür ederiz. Bu pencereyi kapatabilirsiniz.")</p>
        </div>
    </div>

    <!-- Assessment Form -->
    <div data-bind="visible: !isLoading() && !errorMessage() && !isAllCompleted() && currentContext()">

        <!-- Progress Bar -->
        <div class="card shadow-sm mb-3">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <small class="text-muted">
                        <i class="bi bi-list-check me-1"></i>
                        @Html.T("Assessment.Fill.TaskProgress", "Değerlendirme İlerlemesi")
                    </small>
                    <small class="fw-bold">
                        <span data-bind="text: completedTaskCount"></span> / <span data-bind="text: totalTaskCount"></span>
                    </small>
                </div>
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar bg-success" role="progressbar"
                         data-bind="style: { width: progressPercent() + '%' }, attr: { 'aria-valuenow': progressPercent() }"
                         aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
        </div>

        <!-- Header -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h3 class="mb-1" data-bind="text: currentContext() ? currentContext().project.name : ''"></h3>
                        <!-- ko if: currentContext() && currentContext().currentTask.evaluatedPersonnelName -->
                        <p class="text-muted mb-0">
                            <i class="bi bi-person me-1"></i>
                            <span data-bind="text: '@Html.T("Assessment.Fill.Evaluating", "Değerlendirilen:")'"></span>
                            <strong data-bind="text: currentContext().currentTask.evaluatedPersonnelName"></strong>
                        </p>
                        <!-- /ko -->
                        <!-- ko if: currentContext() && !currentContext().currentTask.evaluatedPersonnelName && currentContext().currentTask.feedbackRoleId === 1 -->
                        <p class="text-muted mb-0">
                            <i class="bi bi-person me-1"></i>
                            @Html.T("Assessment.Fill.SelfEvaluating", "Kendinizi değerlendiriyorsunuz")
                        </p>
                        <!-- /ko -->
                    </div>
                    <div class="text-end">
                        <!-- Feedback Role Badge -->
                        <span class="badge fs-6" data-bind="text: feedbackRoleName(), css: feedbackRoleBadgeClass()"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Questions -->
        <div data-bind="visible: questions().length > 0">
            <!-- MODE 1: No groupName -->
            <!-- ko if: !hasAnyGroupName() -->
            <div data-bind="foreach: questions">
                <div class="card shadow-sm mb-3" data-bind="attr: { 'data-question-id': id }">
                    <div class="card-header bg-primary text-white py-2">
                        <!-- ko if: isRequired --><span class="text-warning fw-bold me-1">*</span><!-- /ko -->
                        <span data-bind="text: text"></span>
                    </div>
                    <div class="card-body">
                        <!-- ko if: description -->
                        <p class="text-muted mb-2" data-bind="text: description"></p>
                        <!-- /ko -->

                        <!-- Score Input -->
                        <!-- ko if: showScoreInput -->
                        <div class="btn-group mb-2" role="group">
                            <!-- ko foreach: $root.getScoreOptions(maxPoints) -->
                            <input type="radio" class="btn-check"
                                   data-bind="attr: { id: 'q' + $parent.id + '_' + $data, name: 'score_' + $parent.id },
                                              checked: $parent.answer().score,
                                              checkedValue: $data">
                            <label class="btn btn-outline-primary btn-sm" data-bind="attr: { for: 'q' + $parent.id + '_' + $data }, text: $data"></label>
                            <!-- /ko -->
                        </div>
                        <!-- /ko -->

                        <!-- SubCriteria Selection -->
                        <!-- ko if: hasSubCriteria -->
                        <div class="mt-2">
                            <small class="text-muted d-block mb-1">
                                <!-- ko if: selectionTypeId === 1 -->
                                <i class="bi bi-ui-radios"></i> @Html.T("Survey.SelectOne", "Birini seçin:")
                                <!-- /ko -->
                                <!-- ko if: selectionTypeId !== 1 -->
                                <i class="bi bi-ui-checks"></i> @Html.T("Survey.SelectMultiple", "Seçin (birden fazla seçilebilir):")
                                <!-- /ko -->
                            </small>
                            <div class="list-group list-group-flush" data-bind="foreach: subCriteria">
                                <!-- ko if: $parent.selectionTypeId === 1 -->
                                <label class="list-group-item list-group-item-action py-2 px-3"
                                       data-bind="css: { 'active': isSelected() }, click: function() { $root.selectSubCriteria($parent, $data); return true; }">
                                    <input type="radio" class="form-check-input me-2 form-check-input-static"
                                           data-bind="attr: { name: 'subcriteria_' + $parent.id, checked: isSelected() ? 'checked' : null }">
                                    <span data-bind="text: description"></span>
                                </label>
                                <!-- /ko -->
                                <!-- ko if: $parent.selectionTypeId !== 1 -->
                                <label class="list-group-item list-group-item-action py-2 px-3"
                                       data-bind="css: { 'active': isSelected() }, click: function() { $root.selectSubCriteria($parent, $data); }">
                                    <input type="checkbox" class="form-check-input me-2" data-bind="checked: isSelected">
                                    <span data-bind="text: description"></span>
                                </label>
                                <!-- /ko -->
                            </div>
                        </div>
                        <!-- /ko -->

                        <!-- Comment -->
                        <!-- ko if: allowComment -->
                        <div class="mt-2">
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="@Html.T("Survey.CommentPlaceholder", "Yorum (opsiyonel)")"
                                   data-bind="value: answer().comment" autocomplete="off">
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
            </div>
            <!-- /ko -->

            <!-- MODE 2: Grouped -->
            <!-- ko if: hasAnyGroupName() -->
            <div data-bind="foreach: questionGroups">
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-primary text-white py-2">
                        <i class="bi bi-list-check me-2"></i>
                        <span data-bind="text: name"></span>
                        <span class="badge bg-light text-dark ms-2" data-bind="text: questions.length + ' soru'"></span>
                    </div>
                    <div class="list-group list-group-flush" data-bind="foreach: questions">
                        <div class="list-group-item" data-bind="css: { 'bg-light': $index() % 2 === 1 }, attr: { 'data-question-id': id }">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="flex-grow-1">
                                    <!-- ko if: isRequired --><span class="text-danger fw-bold me-1">*</span><!-- /ko -->
                                    <strong data-bind="text: text"></strong>
                                    <!-- ko if: description -->
                                    <br><small class="text-muted" data-bind="text: description"></small>
                                    <!-- /ko -->
                                </div>
                            </div>

                            <div class="mt-2">
                                <!-- Score Input -->
                                <!-- ko if: showScoreInput -->
                                <div class="btn-group" role="group">
                                    <!-- ko foreach: $root.getScoreOptions(maxPoints) -->
                                    <input type="radio" class="btn-check"
                                           data-bind="attr: { id: 'q' + $parent.id + '_' + $data, name: 'score_' + $parent.id },
                                                      checked: $parent.answer().score,
                                                      checkedValue: $data">
                                    <label class="btn btn-outline-primary btn-sm" data-bind="attr: { for: 'q' + $parent.id + '_' + $data }, text: $data"></label>
                                    <!-- /ko -->
                                </div>
                                <!-- /ko -->

                                <!-- SubCriteria -->
                                <!-- ko if: hasSubCriteria -->
                                <div class="mt-2">
                                    <small class="text-muted d-block mb-1">
                                        <!-- ko if: selectionTypeId === 1 -->
                                        <i class="bi bi-ui-radios"></i> @Html.T("Survey.SelectOne", "Birini seçin:")
                                        <!-- /ko -->
                                        <!-- ko if: selectionTypeId !== 1 -->
                                        <i class="bi bi-ui-checks"></i> @Html.T("Survey.SelectMultiple", "Seçin (birden fazla seçilebilir):")
                                        <!-- /ko -->
                                    </small>
                                    <div class="list-group list-group-flush" data-bind="foreach: subCriteria">
                                        <!-- ko if: $parent.selectionTypeId === 1 -->
                                        <label class="list-group-item list-group-item-action py-2 px-3"
                                               data-bind="css: { 'active': isSelected() }, click: function() { $root.selectSubCriteria($parent, $data); return true; }">
                                            <input type="radio" class="form-check-input me-2 form-check-input-static"
                                                   data-bind="attr: { name: 'subcriteria_' + $parent.id, checked: isSelected() ? 'checked' : null }">
                                            <span data-bind="text: description"></span>
                                        </label>
                                        <!-- /ko -->
                                        <!-- ko if: $parent.selectionTypeId !== 1 -->
                                        <label class="list-group-item list-group-item-action py-2 px-3"
                                               data-bind="css: { 'active': isSelected() }, click: function() { $root.selectSubCriteria($parent, $data); }">
                                            <input type="checkbox" class="form-check-input me-2" data-bind="checked: isSelected">
                                            <span data-bind="text: description"></span>
                                        </label>
                                        <!-- /ko -->
                                    </div>
                                </div>
                                <!-- /ko -->

                                <!-- Comment -->
                                <!-- ko if: allowComment -->
                                <div class="mt-2">
                                    <input type="text" class="form-control form-control-sm"
                                           placeholder="@Html.T("Survey.CommentPlaceholder", "Yorum (opsiyonel)")"
                                           data-bind="value: answer().comment" autocomplete="off">
                                </div>
                                <!-- /ko -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- /ko -->
        </div>

        <!-- Submit -->
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="text-muted">
                        <span data-bind="text: answeredCount"></span> / <span data-bind="text: questions().length"></span> @Html.T("Survey.QuestionsAnswered", "soru cevaplandı")
                    </div>
                    <button type="button" class="btn btn-success btn-lg"
                            data-bind="click: submitTask, disable: isSubmitting() || answeredCount() === 0">
                        <span data-bind="visible: !isSubmitting()">
                            <!-- ko if: hasNextTaskHint() -->
                            <i class="bi bi-arrow-right me-2"></i>@Html.T("Assessment.Fill.SubmitAndNext", "Gönder ve Devam Et")
                            <!-- /ko -->
                            <!-- ko ifnot: hasNextTaskHint() -->
                            <i class="bi bi-send me-2"></i>@Html.T("Assessment.Fill.SubmitAndFinish", "Gönder ve Tamamla")
                            <!-- /ko -->
                        </span>
                        <span data-bind="visible: isSubmitting">
                            <span class="spinner-border spinner-border-sm me-2"></span>@Html.T("Survey.Submitting", "Gönderiliyor...")
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    window.assessmentConfig = {
        token: '@(token ?? "")'
    };
</script>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/survey.css" />
}

@section Scripts {
    <script src="~/js/Assessment/fill.js" asp-append-version="true"></script>
}
