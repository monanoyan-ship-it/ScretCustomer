@{
    ViewData["Title"] = Html.T("Menu.DraftRequests", "Taslaga Alma Talepleri").ToString();
}

<div id="draft-requests-app" class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">@Html.T("Menu.DraftRequests", "Taslaga Alma Talepleri")</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/">@Html.T("Common.Home", "Ana Sayfa")</a></li>
                    <li class="breadcrumb-item active">@Html.T("Menu.DraftRequests", "Taslaga Alma Talepleri")</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-warning text-dark">
                <div class="card-body text-center">
                    <h3 class="mb-0" data-bind="text: pendingCount">0</h3>
                    <small>@Html.T("Status.Pending", "Bekleyen")</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <h3 class="mb-0" data-bind="text: approvedCount">0</h3>
                    <small>@Html.T("Approval.Approved", "Onaylanan")</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body text-center">
                    <h3 class="mb-0" data-bind="text: rejectedCount">0</h3>
                    <small>@Html.T("Approval.Rejected", "Reddedilen")</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body text-center">
                    <h3 class="mb-0" data-bind="text: totalCount">0</h3>
                    <small>@Html.T("Common.Total", "Toplam")</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-funnel me-2"></i>@Html.T("Common.Filters", "Filtreler")</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">@Html.T("Common.Status", "Durum")</label>
                    <select class="form-select" data-bind="value: filterStatus">
                        <option value="">@Html.T("Common.All", "Tumu")</option>
                        <option value="Pending">@Html.T("Approval.Status.Pending", "Beklemede")</option>
                        <option value="Approved">@Html.T("Approval.Status.Approved", "Onaylandi")</option>
                        <option value="Rejected">@Html.T("Approval.Status.Rejected", "Reddedildi")</option>
                    </select>
                </div>
                <div class="col-md-7">
                    <label class="form-label">@Html.T("Common.Search", "Arama")</label>
                    <input type="text" class="form-control" placeholder="@Html.T("Approval.SearchPlaceholder", "Referans, baslik...")" data-bind="value: searchTerm, valueUpdate: 'afterkeydown'" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-secondary w-100" data-bind="click: clearFilters">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Clear", "Temizle")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Requests Table -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-arrow-counterclockwise me-2"></i>@Html.T("DraftRequest.AllRequests", "Tum Talepler")</h5>
            <span class="badge bg-primary" data-bind="text: totalCountText"></span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Html.T("Approval.Reference", "Referans")</th>
                            <th>@Html.T("Common.Title", "Baslik")</th>
                            <th>@Html.T("Approval.RequestedBy", "Talep Eden")</th>
                            <th>@Html.T("Common.Status", "Durum")</th>
                            <th>@Html.T("Common.Date", "Tarih")</th>
                            <th class="text-center">@Html.T("Common.Actions", "Islemler")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: requests">
                        <tr>
                            <td>
                                <a href="#" data-bind="text: referenceNumber, click: function() { $parent.showDetail($data); }" class="text-decoration-none fw-bold"></a>
                            </td>
                            <td data-bind="text: title"></td>
                            <td data-bind="text: requestedByUserName"></td>
                            <td>
                                <span class="badge" data-bind="text: $parent.getStatusText(status), css: $parent.getStatusBadgeClass(status)"></span>
                            </td>
                            <td data-bind="text: $parent.formatDate(requestedAt)"></td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <!-- ko if: status === 'Pending' -->
                                    <button class="btn btn-success" data-bind="click: function() { $parent.approveRequest($data); }" title="@Html.T("Approval.Approve", "Onayla")">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                    <button class="btn btn-danger" data-bind="click: function() { $parent.rejectRequest($data); }" title="@Html.T("Approval.Reject", "Reddet")">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                    <!-- /ko -->
                                    <button class="btn btn-outline-primary" data-bind="click: function() { $parent.showDetail($data); }" title="@Html.T("Common.Detail", "Detay")">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Empty State -->
            <div class="text-center py-5" data-bind="visible: requests().length === 0 && !isLoading()">
                <i class="bi bi-inbox fa-3x text-muted mb-3 d-block" style="font-size: 3rem;"></i>
                <p class="text-muted">@Html.T("DraftRequest.NoRecords", "Henuz taslaga alma talebi bulunmamaktadir.")</p>
            </div>

            <!-- Loading -->
            <div class="text-center py-5" data-bind="visible: isLoading">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>

        <!-- Pagination -->
        <div class="card-footer" data-bind="visible: totalPages() > 1">
            <nav>
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item" data-bind="css: { disabled: currentPage() === 1 }">
                        <a class="page-link" href="#" data-bind="click: previousPage">@Html.T("Pagination.Previous", "Onceki")</a>
                    </li>
                    <!-- ko foreach: visiblePages -->
                    <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }">
                        <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.goToPage($data); }"></a>
                    </li>
                    <!-- /ko -->
                    <li class="page-item" data-bind="css: { disabled: currentPage() === totalPages() }">
                        <a class="page-link" href="#" data-bind="click: nextPage">@Html.T("Pagination.Next", "Sonraki")</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

    <!-- ==================== DETAIL MODAL ==================== -->
    <div class="modal fade" data-bind="css: { show: isDetailModalOpen }, style: { display: isDetailModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" data-bind="with: viewingRequest">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>@Html.T("DraftRequest.Detail", "Talep Detayi")
                        <span class="badge ms-2" data-bind="text: $parent.getStatusText(status), css: $parent.getStatusBadgeClass(status)"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: $parent.closeDetailModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-8">
                            <!-- Request Info -->
                            <div class="card mb-3">
                                <div class="card-header py-2"><strong>@Html.T("DraftRequest.Info", "Talep Bilgileri")</strong></div>
                                <div class="card-body">
                                    <div class="row mb-2">
                                        <div class="col-md-6">
                                            <strong>@Html.T("Approval.Reference", "Referans"):</strong>
                                            <span data-bind="text: referenceNumber"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <strong>@Html.T("Common.Status", "Durum"):</strong>
                                            <span class="badge" data-bind="text: $parent.getStatusText(status), css: $parent.getStatusBadgeClass(status)"></span>
                                        </div>
                                    </div>
                                    <div class="mb-2">
                                        <strong>@Html.T("Common.Title", "Baslik"):</strong>
                                        <p class="mb-0" data-bind="text: title"></p>
                                    </div>
                                    <!-- ko if: description -->
                                    <div class="mb-2">
                                        <strong>@Html.T("DraftRequest.Reason", "Taslaga Alma Nedeni"):</strong>
                                        <p class="mb-0 text-muted" data-bind="text: description"></p>
                                    </div>
                                    <!-- /ko -->
                                    <!-- ko if: relatedEntityId -->
                                    <div class="mb-2">
                                        <strong>@Html.T("Evaluation.Title", "Degerlendirme"):</strong>
                                        <a class="btn btn-sm btn-outline-primary ms-2" data-bind="attr: { href: '/Evaluations?id=' + relatedEntityId }">
                                            <i class="bi bi-box-arrow-up-right me-1"></i>@Html.T("Common.View", "Goruntule")
                                        </a>
                                    </div>
                                    <!-- /ko -->
                                    <!-- ko if: responseNote -->
                                    <div class="alert alert-info mb-0 mt-3">
                                        <strong>@Html.T("Approval.ResponseNote", "Yanit Notu"):</strong>
                                        <span data-bind="text: responseNote"></span>
                                    </div>
                                    <!-- /ko -->
                                </div>
                            </div>

                            <!-- Action Section for Pending -->
                            <!-- ko if: status === 'Pending' -->
                            <div class="card">
                                <div class="card-header bg-warning text-dark py-2"><strong>@Html.T("Approval.Action", "Onay Islemi")</strong></div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label class="form-label">@Html.T("Approval.ResponseNoteOptional", "Yanit Notu (Opsiyonel)")</label>
                                        <textarea class="form-control" rows="2" data-bind="value: $parent.responseNote" placeholder="@Html.T("Approval.ResponseNotePlaceholder", "Yanitinizla ilgili not ekleyebilirsiniz...")"></textarea>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-success" data-bind="click: function() { $parent.approveFromDetail($data); }">
                                            <i class="bi bi-check-circle me-2"></i>@Html.T("Approval.Approve", "Onayla")
                                        </button>
                                        <button class="btn btn-danger" data-bind="click: function() { $parent.rejectFromDetail($data); }">
                                            <i class="bi bi-x-circle me-2"></i>@Html.T("Approval.Reject", "Reddet")
                                        </button>
                                    </div>
                                    <div class="alert alert-warning mt-3 mb-0">
                                        <i class="bi bi-info-circle me-2"></i>
                                        @Html.T("DraftRequest.ApproveWarning", "Talebi onayladiginizda degerlendirme otomatik olarak taslak durumuna alinacaktir.")
                                    </div>
                                </div>
                            </div>
                            <!-- /ko -->
                        </div>
                        <div class="col-md-4">
                            <!-- People -->
                            <div class="card mb-3">
                                <div class="card-header py-2"><strong>@Html.T("Approval.People", "Kisiler")</strong></div>
                                <div class="card-body">
                                    <div class="mb-2">
                                        <label class="text-muted small">@Html.T("Approval.RequestedBy", "Talep Eden")</label>
                                        <p class="mb-0"><i class="bi bi-person me-2"></i><span data-bind="text: requestedByUserName"></span></p>
                                    </div>
                                    <!-- ko if: approvedByUserName -->
                                    <div>
                                        <label class="text-muted small">@Html.T("Approval.RespondedBy", "Yanitlayan")</label>
                                        <p class="mb-0"><i class="bi bi-person-check me-2"></i><span data-bind="text: approvedByUserName"></span></p>
                                    </div>
                                    <!-- /ko -->
                                </div>
                            </div>
                            <!-- Dates -->
                            <div class="card">
                                <div class="card-header py-2"><strong>@Html.T("Common.Dates", "Tarihler")</strong></div>
                                <div class="card-body">
                                    <div class="mb-2">
                                        <label class="text-muted small">@Html.T("Approval.RequestDate", "Talep Tarihi")</label>
                                        <p class="mb-0" data-bind="text: $parent.formatDate(requestedAt)"></p>
                                    </div>
                                    <!-- ko if: respondedAt -->
                                    <div>
                                        <label class="text-muted small">@Html.T("Approval.ResponseDate", "Yanit Tarihi")</label>
                                        <p class="mb-0" data-bind="text: $parent.formatDate(respondedAt)"></p>
                                    </div>
                                    <!-- /ko -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closeDetailModal">@Html.T("Common.Close", "Kapat")</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isDetailModalOpen }, style: { display: isDetailModalOpen() ? 'block' : 'none' }"></div>

</div>

@section Scripts {
    <script src="~/js/DraftRequests/Index.js"></script>
}
