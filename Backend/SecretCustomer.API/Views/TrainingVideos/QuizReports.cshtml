@{
    ViewData["Title"] = Html.T("Menu.QuizReports", "Anket Raporlari");
}

<div id="quiz-reports-app">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-bar-chart me-2"></i>@Html.T("Menu.QuizReports", "Anket Raporlari")</h2>
        <button class="btn btn-success" data-bind="click: exportToExcel, disable: isExporting">
            <span data-bind="visible: !isExporting()"><i class="bi bi-file-earmark-excel me-1"></i>@Html.T("Common.ExportExcel", "Excel")</span>
            <span data-bind="visible: isExporting"><span class="spinner-border spinner-border-sm"></span></span>
        </button>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">@Html.T("QuizReports.Video", "Video")</label>
                    <select class="form-select" data-bind="options: videos, optionsText: 'title', optionsValue: 'id', value: filterVideoId, optionsCaption: '@Html.T("Common.All", "Tumu")'"></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Html.T("QuizReports.Quiz", "Anket")</label>
                    <select class="form-select" data-bind="options: quizzes, optionsText: 'title', optionsValue: 'id', value: filterQuizId, optionsCaption: '@Html.T("Common.All", "Tumu")'"></select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Html.T("QuizReports.Result", "Sonuc")</label>
                    <select class="form-select" data-bind="value: filterPassed">
                        <option value="">@Html.T("Common.All", "Tumu")</option>
                        <option value="true">@Html.T("QuizReports.Passed", "Gecti")</option>
                        <option value="false">@Html.T("Project.Failed", "Kaldi")</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Html.T("QuizReports.ParticipantType", "Katilimci")</label>
                    <select class="form-select" data-bind="value: filterIsExternal">
                        <option value="">@Html.T("Common.All", "Tumu")</option>
                        <option value="false">@Html.T("QuizReports.Internal", "Ic")</option>
                        <option value="true">@Html.T("QuizReports.External", "Dis")</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-outline-secondary w-100" data-bind="click: clearFilters">
                        <i class="bi bi-x-circle me-1"></i>@Html.T("Common.Clear", "Temizle")
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4" data-bind="visible: !isLoading()">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body text-center py-3">
                    <h3 class="mb-0" data-bind="text: responses().length"></h3>
                    <small>@Html.T("Report.TotalResponses", "Toplam Yanit")</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body text-center py-3">
                    <h3 class="mb-0" data-bind="text: passedCount()"></h3>
                    <small>@Html.T("QuizReports.PassedCount", "Gecen")</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body text-center py-3">
                    <h3 class="mb-0" data-bind="text: failedCount()"></h3>
                    <small>@Html.T("QuizReports.FailedCount", "Kalan")</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body text-center py-3">
                    <h3 class="mb-0" data-bind="text: averageScore().toFixed(2) + '%'"></h3>
                    <small>@Html.T("Dealer.AverageScore", "Ortalama Puan")</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">@Html.T("Common.Loading", "Yukleniyor...")</p>
    </div>

    <!-- Data Table -->
    <div data-bind="visible: !isLoading()">
        <div class="card shadow-sm" data-bind="visible: responses().length > 0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Html.T("Meeting.Participant", "Katilimci")</th>
                            <th>@Html.T("QuizReports.Quiz", "Anket")</th>
                            <th class="text-center">@Html.T("QuizReports.Score", "Puan")</th>
                            <th class="text-center">@Html.T("QuizReports.Percentage", "Yuzde")</th>
                            <th class="text-center">@Html.T("QuizReports.Result", "Sonuc")</th>
                            <th class="text-center">@Html.T("QuizReports.Attempt", "Deneme")</th>
                            <th>@Html.T("QuizReports.CompletedAt", "Tamamlanma")</th>
                            <th class="text-center">@Html.T("Common.Actions", "Islemler")</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: responses">
                        <tr>
                            <td>
                                <div>
                                    <span data-bind="text: participantName"></span>
                                    <!-- ko if: isExternal -->
                                    <span class="badge bg-secondary ms-1">@Html.T("QuizReports.External", "Dis")</span>
                                    <!-- /ko -->
                                </div>
                                <!-- ko if: participantEmail -->
                                <small class="text-muted" data-bind="text: participantEmail"></small>
                                <!-- /ko -->
                            </td>
                            <td data-bind="text: quizTitle"></td>
                            <td class="text-center">
                                <span data-bind="text: totalScore + '/' + maxPossibleScore"></span>
                            </td>
                            <td class="text-center">
                                <span class="badge" data-bind="text: '%' + scorePercentage.toFixed(2), css: { 'bg-success': isPassed, 'bg-danger': !isPassed }"></span>
                            </td>
                            <td class="text-center">
                                <!-- ko if: isPassed -->
                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>@Html.T("QuizReports.Passed", "Gecti")</span>
                                <!-- /ko -->
                                <!-- ko ifnot: isPassed -->
                                <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>@Html.T("Project.Failed", "Kaldi")</span>
                                <!-- /ko -->
                            </td>
                            <td class="text-center" data-bind="text: attemptNumber"></td>
                            <td data-bind="text: completedAt ? new Date(completedAt).toLocaleString('tr-TR') : '-'"></td>
                            <td class="text-center">
                                <button class="btn btn-outline-primary btn-sm" data-bind="click: $parent.showDetails" title="@Html.T("Common.Details", "Detay")">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: responses().length === 0" class="text-center py-5 text-muted">
            <i class="bi bi-bar-chart fs-1"></i>
            <p class="mt-2">@Html.T("Common.NoData", "Anket yaniti bulunmuyor.")</p>
        </div>
    </div>

    <!-- Details Modal -->
    <div class="modal fade" data-bind="css: { show: isDetailsModalOpen }, style: { display: isDetailsModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-clipboard-data me-2"></i>@Html.T("QuizReports.ResponseDetails", "Yanit Detayi")</h5>
                    <button type="button" class="btn-close btn-close-white" data-bind="click: closeDetailsModal"></button>
                </div>
                <div class="modal-body" data-bind="with: selectedResponse">
                    <!-- Participant Info -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>@Html.T("Meeting.Participant", "Katilimci"):</strong>
                            <span data-bind="text: participantName"></span>
                            <!-- ko if: participantEmail -->
                            <br><small class="text-muted" data-bind="text: participantEmail"></small>
                            <!-- /ko -->
                        </div>
                        <div class="col-md-6 text-end">
                            <span class="badge fs-5" data-bind="text: '%' + scorePercentage.toFixed(2), css: { 'bg-success': isPassed, 'bg-danger': !isPassed }"></span>
                            <span class="badge fs-5 ms-2" data-bind="text: isPassed ? '@Html.T("QuizReports.Passed", "Gecti")' : '@Html.T("Project.Failed", "Kaldi")', css: { 'bg-success': isPassed, 'bg-danger': !isPassed }"></span>
                        </div>
                    </div>

                    <!-- Answers Table -->
                    <div data-bind="visible: answers && answers.length > 0">
                        <h6 class="mb-2">@Html.T("Report.Answers", "Cevaplar")</h6>
                        <table class="table table-sm table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 50%;">@Html.T("Report.Question", "Soru")</th>
                                    <th>@Html.T("Common.Answer", "Cevap")</th>
                                    <th class="text-center" style="width: 80px;">@Html.T("QuizReports.Points", "Puan")</th>
                                    <th class="text-center" style="width: 80px;">@Html.T("QuizReports.Correct", "Dogru")</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: answers">
                                <tr data-bind="css: { 'table-success': isCorrect, 'table-danger': !isCorrect }">
                                    <td data-bind="text: questionText"></td>
                                    <td data-bind="text: selectedOptionText || '-'"></td>
                                    <td class="text-center" data-bind="text: earnedPoints"></td>
                                    <td class="text-center">
                                        <i data-bind="css: { 'bi-check-circle-fill text-success': isCorrect, 'bi-x-circle-fill text-danger': !isCorrect }"></i>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: closeDetailsModal">@Html.T("Common.Close", "Kapat")</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isDetailsModalOpen }, style: { display: isDetailsModalOpen() ? 'block' : 'none' }"></div>
</div>

@section Scripts {
    <script src="~/js/TrainingVideos/QuizReports.js" asp-append-version="true"></script>
}
