                                    <option value="true">Baslamis</option>
                                    <option value="false">Baslamadi</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Tamamlama</label>
                                <select class="form-select" data-bind="value: emailFilterIsCompleted">
                                    <option value="">Tumu</option>
                                    <option value="true">Tamamladi</option>
                                    <option value="false">Tamamlamadi</option>
                                </select>
                            </div>
                            <hr>
                            <div class="mb-3">
                                <label class="form-label">Email Turu</label>
                                <select class="form-select" data-bind="value: emailModalTypeId">
                                    <option value="1">Ilk Bildirim</option>
                                    <option value="2">Hatirlatma</option>
                                </select>
                            </div>
                            <div class="d-grid gap-2 mt-4">
                                <button type="button" class="btn btn-outline-primary" data-bind="click: selectAllEmailParticipants">
                                    <i class="bi bi-check-all"></i> Tumunu Sec
                                </button>
                                <button type="button" class="btn btn-outline-secondary" data-bind="click: clearEmailSelection">
                                    <i class="bi bi-x-circle"></i> Temizle
                                </button>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <h6 class="border-bottom pb-2 mb-3">
                                <i class="bi bi-people me-2"></i>Katilimcilar
                                <span class="badge bg-primary ms-2" data-bind="text: emailSelectedCount() + ' secili'"></span>
                            </h6>
                            <div data-bind="visible: isLoadingEmailParticipants" class="text-center py-4">
                                <div class="spinner-border text-primary"></div>
                            </div>
                            <div data-bind="visible: !isLoadingEmailParticipants()" class="border rounded" style="max-height: 400px; overflow-y: auto;">
                                <table class="table table-sm table-hover mb-0">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th style="width: 40px;"><input type="checkbox" class="form-check-input" data-bind="checked: emailSelectAll"></th>
                                            <th>Personel</th>
                                            <th class="text-center">Email</th>
                                            <th class="text-center">Durum</th>
                                            <th class="text-center">Son Email</th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: emailFilteredParticipants">
                                        <tr>
                                            <td><input type="checkbox" class="form-check-input" data-bind="checked: selected"></td>
                                            <td>
                                                <span data-bind="text: userName"></span>
                                                <!-- ko if: isExternal -->
                                                <span class="badge bg-info ms-1">Dis</span>
                                                <!-- /ko -->
                                                <br><small class="text-muted" data-bind="text: email"></small>
                                            </td>
                                            <td class="text-center">
                                                <!-- ko if: emailSentCount > 0 -->
                                                <span class="badge bg-success" data-bind="text: emailSentCount + 'x'"></span>
                                                <!-- /ko -->
                                                <!-- ko if: emailSentCount === 0 -->
                                                <span class="badge bg-secondary">-</span>
                                                <!-- /ko -->
                                            </td>
                                            <td class="text-center">
                                                <span data-bind="visible: statusId === 1" class="badge bg-warning">Bekleme</span>
                                                <span data-bind="visible: statusId === 2" class="badge bg-info">Izliyor</span>
                                                <span data-bind="visible: statusId === 3" class="badge bg-success">Tamamladi</span>
                                            </td>
                                            <td class="text-center">
                                                <small data-bind="text: lastEmailSentAt ? $parent.formatDate(lastEmailSentAt) : '-'"></small>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div data-bind="visible: !isLoadingEmailParticipants() && emailFilteredParticipants().length === 0" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-1"></i>
                                <p class="mb-0 mt-2">Filtre kriterlerine uyan katilimci yok</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                    <button type="button" class="btn btn-primary" data-bind="click: sendEmails, disable: isSendingEmails() || emailSelectedCount() === 0">
                        <span data-bind="visible: !isSendingEmails()">
                            <i class="bi bi-send me-1"></i> Email Gonder (<span data-bind="text: emailSelectedCount"></span>)
                        </span>
                        <span data-bind="visible: isSendingEmails"><span class="spinner-border spinner-border-sm"></span> Gonderiliyor...</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal fade" id="editModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-pencil me-2"></i>Atama Duzenle
                        <small class="text-muted ms-2" data-bind="text: '- ' + editVideoTitle()"></small>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Loading -->
                    <div data-bind="visible: isLoadingEdit" class="text-center py-4">
                        <div class="spinner-border text-primary"></div>
                    </div>

                    <div data-bind="visible: !isLoadingEdit()">
                        <!-- Nav Tabs -->
                        <ul class="nav nav-tabs mb-3" role="tablist">
                            <li class="nav-item">
                                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#edit-general">
                                    <i class="bi bi-gear me-1"></i>Genel
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#edit-participants">
                                    <i class="bi bi-people me-1"></i>Katilimcilar
                                    <span class="badge bg-secondary ms-1" data-bind="text: editParticipants().length + editExternalParticipants().length"></span>
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content">
                            <!-- Genel Tab -->
                            <div class="tab-pane fade show active" id="edit-general">
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label">Baslik <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" data-bind="value: editTitle">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Baslangic Tarihi <span class="text-danger">*</span></label>
                                        <input type="date" class="form-control" data-bind="value: editStartDate">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Bitis Tarihi <span class="text-danger">*</span></label>
                                        <input type="date" class="form-control" data-bind="value: editDueDate">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Email Sablonu</label>
                                        <select class="form-select" data-bind="value: editEmailTemplateId, options: emailTemplates, optionsValue: 'id', optionsText: 'name', optionsCaption: 'Sablon secin...'"></select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Durum</label>
                                        <div class="form-check form-switch mt-2">
                                            <input class="form-check-input" type="checkbox" data-bind="checked: editIsActive">
                                            <label class="form-check-label" data-bind="text: editIsActive() ? 'Aktif' : 'Pasif'"></label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Min. Izleme Sayisi</label>
                                        <input type="number" class="form-control" min="1" data-bind="value: editMinWatchCount">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Max. Izleme Sayisi</label>
                                        <input type="number" class="form-control" min="1" placeholder="Sinirsiz" data-bind="value: editMaxWatchCount">
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" data-bind="checked: editAllowSpeedChange">
                                            <label class="form-check-label">Hiz degistirmeye izin ver</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" data-bind="checked: editAllowSeeking">
                                            <label class="form-check-label">Ileri/geri sarmaya izin ver</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Katilimcilar Tab -->
                            <div class="tab-pane fade" id="edit-participants">
                                <!-- Iç Katilimcilar (isExternal=false ise göster) -->
                                <div data-bind="visible: !editIsExternal()">
                                    <h6 class="border-bottom pb-2 mb-3">
                                        <i class="bi bi-person me-1"></i>Ic Katilimcilar
                                        <span class="badge bg-primary" data-bind="text: editParticipants().length"></span>
                                    </h6>

                                    <!-- Mevcut katilimcilar -->
                                    <div class="mb-3" style="max-height: 200px; overflow-y: auto;" data-bind="visible: editParticipants().length > 0">
                                        <table class="table table-sm table-hover mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Ad Soyad</th>
                                                    <th>Email</th>
                                                    <th>Durum</th>
                                                    <th style="width: 50px;"></th>
                                                </tr>
                                            </thead>
                                            <tbody data-bind="foreach: editParticipants">
                                                <tr data-bind="css: { 'table-danger': markedForRemoval() }">
                                                    <td data-bind="text: userName"></td>
                                                    <td><small class="text-muted" data-bind="text: email"></small></td>
                                                    <td>
                                                        <span class="badge" data-bind="css: isCompleted ? 'bg-success' : (statusId === 2 ? 'bg-info' : 'bg-secondary'), text: isCompleted ? 'Tamamladi' : (statusId === 2 ? 'Izliyor' : 'Bekliyor')"></span>
                                                    </td>
                                                    <td>
                                                        <button class="btn btn-sm" data-bind="click: $parent.toggleRemoveParticipant, css: markedForRemoval() ? 'btn-success' : 'btn-outline-danger'" title="Sil/Geri Al">
                                                            <i data-bind="css: markedForRemoval() ? 'bi bi-arrow-counterclockwise' : 'bi bi-trash'"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div data-bind="visible: editParticipants().length === 0" class="text-muted small mb-3">
                                        Henuz ic katilimci yok.
                                    </div>

                                    <!-- Yeni katilimci ekle -->
                                    <div class="card bg-light mb-3">
                                        <div class="card-body py-2">
                                            <label class="form-label small mb-1">Yeni Katilimci Ekle</label>
                                            <div class="position-relative">
                                                <input type="text" class="form-control form-control-sm" placeholder="Video kapsaminda dinlemesi olan personel ara..."
                                                       data-bind="value: editNewParticipantSearch, valueUpdate: 'afterkeydown', event: { keyup: searchEditPersonnel, focus: showEditPersonnelDropdown, blur: hideEditPersonnelDropdownDelayed }">
                                                <div class="dropdown-menu w-100" data-bind="css: { show: isEditPersonnelDropdownVisible() && editPersonnelSearchResults().length > 0 }">
                                                    <!-- ko foreach: editPersonnelSearchResults -->
                                                    <a class="dropdown-item" href="#" data-bind="click: $parent.selectEditPersonnel">
                                                        <span data-bind="text: fullName || (firstName + ' ' + lastName)"></span>
                                                        <small class="text-muted ms-2" data-bind="text: email"></small>
                                                        <!-- ko if: customerName -->
                                                        <small class="text-info ms-2" data-bind="text: '(' + customerName + ')'"></small>
                                                        <!-- /ko -->
                                                    </a>
                                                    <!-- /ko -->
                                                </div>
                                            </div>
                                            <!-- Eklenmek uzere olanlar -->
                                            <div data-bind="visible: editAddParticipants().length > 0" class="mt-2">
                                                <small class="text-success">Eklenecek:</small>
                                                <!-- ko foreach: editAddParticipants -->
                                                <span class="badge bg-success me-1">
                                                    <span data-bind="text: userName"></span>
                                                    <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.6em;" data-bind="click: $parent.removeAddedParticipant"></button>
                                                </span>
                                                <!-- /ko -->
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Dis Katilimcilar -->
                                <h6 class="border-bottom pb-2 mb-3">
                                    <i class="bi bi-person-badge me-1"></i>Dis Katilimcilar
                                    <span class="badge bg-success" data-bind="text: editExternalParticipants().length"></span>
                                </h6>

                                <!-- Mevcut dis katilimcilar -->
                                <div class="mb-3" style="max-height: 200px; overflow-y: auto;" data-bind="visible: editExternalParticipants().length > 0">
                                    <table class="table table-sm table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Email</th>
                                                <th>Ad Soyad</th>
                                                <th>Durum</th>
                                                <th style="width: 50px;"></th>
                                            </tr>
                                        </thead>
                                        <tbody data-bind="foreach: editExternalParticipants">
                                            <tr data-bind="css: { 'table-danger': markedForRemoval() }">
                                                <td data-bind="text: email"></td>
                                                <td data-bind="text: fullName || '-'"></td>
                                                <td>
                                                    <span class="badge" data-bind="css: isCompleted ? 'bg-success' : (statusId === 2 ? 'bg-info' : 'bg-secondary'), text: isCompleted ? 'Tamamladi' : (statusId === 2 ? 'Izliyor' : 'Bekliyor')"></span>
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm" data-bind="click: $parent.toggleRemoveExternal, css: markedForRemoval() ? 'btn-success' : 'btn-outline-danger'" title="Sil/Geri Al">
                                                        <i data-bind="css: markedForRemoval() ? 'bi bi-arrow-counterclockwise' : 'bi bi-trash'"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div data-bind="visible: editExternalParticipants().length === 0" class="text-muted small mb-3">
                                    Henuz dis katilimci yok.
                                </div>

                                <!-- Yeni dis katilimci ekle -->
                                <div class="card bg-light">
                                    <div class="card-body py-2">
                                        <label class="form-label small mb-1">Yeni Dis Katilimci Ekle</label>
                                        <div class="row g-2">
                                            <div class="col-md-5">
                                                <input type="email" class="form-control form-control-sm" placeholder="Email *" data-bind="value: editNewExternalEmail">
                                            </div>
                                            <div class="col-md-3">
                                                <input type="text" class="form-control form-control-sm" placeholder="Ad" data-bind="value: editNewExternalFirstName">
                                            </div>
                                            <div class="col-md-3">
                                                <input type="text" class="form-control form-control-sm" placeholder="Soyad" data-bind="value: editNewExternalLastName">
                                            </div>
                                            <div class="col-md-1">
                                                <button class="btn btn-sm btn-primary w-100" data-bind="click: addEditExternal" title="Ekle">
                                                    <i class="bi bi-plus"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <!-- Eklenmek uzere olanlar -->
                                        <div data-bind="visible: editAddExternals().length > 0" class="mt-2">
                                            <small class="text-success">Eklenecek:</small>
                                            <!-- ko foreach: editAddExternals -->
                                            <span class="badge bg-success me-1">
                                                <span data-bind="text: email"></span>
                                                <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.6em;" data-bind="click: $parent.removeAddedExternal"></button>
                                            </span>
                                            <!-- /ko -->
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary" data-bind="click: saveEdit, disable: isSavingEdit">
                        <span data-bind="visible: !isSavingEdit()"><i class="bi bi-check-lg me-1"></i>Kaydet</span>
                        <span data-bind="visible: isSavingEdit"><span class="spinner-border spinner-border-sm"></span> Kaydediliyor...</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/TrainingVideos/Assignments.js"></script>
}
