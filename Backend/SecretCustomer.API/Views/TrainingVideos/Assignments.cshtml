                        <div class="spinner-border text-primary"></div>
                    </div>
                    <div data-bind="visible: !isLoadingParticipants()">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Kullanici</th>
                                    <th class="text-center">Durum</th>
                                    <th class="text-center">Izlenen</th>
                                    <th class="text-center">Tamamlama</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: participants">
                                <tr>
                                    <td>
                                        <span data-bind="text: userName"></span>
                                        <!-- ko if: isExternal -->
                                        <span class="badge bg-secondary ms-1">Dis</span>
                                        <!-- /ko -->
                                        <br><small class="text-muted" data-bind="text: email"></small>
                                    </td>
                                    <td class="text-center">
                                        <span data-bind="visible: statusId === 1" class="badge bg-warning">Bekliyor</span>
                                        <span data-bind="visible: statusId === 2" class="badge bg-info">Izliyor</span>
                                        <span data-bind="visible: statusId === 3" class="badge bg-success">Tamamladi</span>
                                    </td>
                                    <td class="text-center" data-bind="text: $parent.formatDuration(watchedSeconds)"></td>
                                    <td class="text-center" data-bind="text: completedAt ? $parent.formatDate(completedAt) : '-'"></td>
