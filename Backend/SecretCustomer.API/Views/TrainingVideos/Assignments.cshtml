                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Email Management Modal -->
    <div class="modal fade" id="emailModal" tabindex="-1" data-bs-backdrop="static">
