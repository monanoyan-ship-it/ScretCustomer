                                            <input type="date" class="form-control" data-bind="value: formSourceStartDate" placeholder="Baslangic">
                                            <span class="align-self-center">-</span>
                                            <input type="date" class="form-control" data-bind="value: formSourceEndDate" placeholder="Bitis">
                                        </div>
                                        <!-- Quick Date Range Dropdown -->
                                        <div class="dropdown">
                                            <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                <i class="bi bi-calendar-range me-1"></i>
                                                <span data-bind="text: formDateRangeType() ? dateRangeLabels[formDateRangeType()] : 'Hizli Sec'"></span>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li><h6 class="dropdown-header">Gun</h6></li>
                                                <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('today'); }">Bugun</a></li>
                                                <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('yesterday'); }">Dun</a></li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li><h6 class="dropdown-header">Hafta</h6></li>
                                                <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('thisWeek'); }">Bu Hafta</a></li>
                                                <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('lastWeek'); }">Gecen Hafta</a></li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li><h6 class="dropdown-header">Ay</h6></li>
                                                <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('thisMonth'); }">Bu Ay</a></li>
                                                <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('lastMonth'); }">Gecen Ay</a></li>
                                                <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('last3Months'); }">Son 3 Ay</a></li>
                                                <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('last6Months'); }">Son 6 Ay</a></li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li><h6 class="dropdown-header">Yil</h6></li>
                                                <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('thisYear'); }">Bu Yil</a></li>
                                                <li><a class="dropdown-item" href="#" data-bind="click: function() { setDateRange('lastYear'); }">Gecen Yil</a></li>
                                            </ul>
                                        </div>
                                    </div>

                                    <!-- Puan Araligi -->
                                    <div class="mb-3">
                                        <label class="form-label">Puan Araligi</label>
                                        <div class="row g-2">
                                            <div class="col-6">
                                                <div class="input-group">
                                                    <span class="input-group-text">Min</span>
                                                    <input type="number" class="form-control" data-bind="value: formMinScore" placeholder="0" min="0" max="100">
                                                    <span class="input-group-text">%</span>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="input-group">
                                                    <span class="input-group-text">Max</span>
                                                    <input type="number" class="form-control" data-bind="value: formMaxScore" placeholder="70" min="0" max="100">
                                                    <span class="input-group-text">%</span>
                                                </div>
                                            </div>
                                        </div>
                                        <small class="text-muted">Bu puan araligindaki personeller listelenecek</small>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between mt-4">
                                <button type="button" class="btn btn-outline-secondary" data-bind="click: goToStep1">
                                    <i class="bi bi-arrow-left"></i> Geri
                                </button>
                                <button type="button" class="btn btn-primary" data-bind="click: goToStep3, disable: !canShowPersonnel()">
                                    Personelleri Listele <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                        </div>

                        <!-- STEP 3: Personnel Selection -->
                        <div class="tab-pane fade" id="step3" role="tabpanel">
                            <h6 class="border-bottom pb-2 mb-3"><i class="bi bi-people me-2"></i>Personel Secimi</h6>

                            <!-- Scope Info -->
                            <div data-bind="visible: selectedVideoScopes().length > 0" class="alert alert-info py-2 mb-3">
                                <strong><i class="bi bi-info-circle me-1"></i>Puan hesabi:</strong>
                                <span data-bind="foreach: selectedVideoScopes">
                                    <span class="badge bg-secondary ms-1" data-bind="text: checklistName || questionGroupName || questionText"></span>
                                </span>
                            </div>

                            <!-- Loading -->
                            <div data-bind="visible: isLoadingPersonnel" class="text-center py-4">
                                <div class="spinner-border text-primary"></div>
                                <p class="mt-2 text-muted">Personel listesi yukleniyor...</p>
                            </div>

                            <!-- Toolbar -->
                            <div data-bind="visible: !isLoadingPersonnel() && personnelWithScores().length > 0" class="mb-3">
                                <div class="row g-2 align-items-center">
                                    <div class="col-md-4">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                                            <input type="text" class="form-control" placeholder="Isim ile ara..."
                                                   data-bind="value: personnelSearchText, valueUpdate: 'input'">
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <span class="badge bg-primary" data-bind="text: selectedCount() + ' secildi'"></span>
                                        <span class="badge bg-secondary ms-1" data-bind="text: visiblePersonnel().length + '/' + personnelWithScores().length + ' gosteriliyor'"></span>
                                    </div>
                                    <div class="col-md-4 text-end">
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-bind="click: selectBelowThreshold">
                                            <i class="bi bi-check-all"></i> Max puan altini sec
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary ms-1" data-bind="click: clearSelection">
                                            <i class="bi bi-x-circle"></i> Temizle
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Personnel Table -->
                            <div data-bind="visible: !isLoadingPersonnel() && personnelWithScores().length > 0" class="border rounded" style="max-height: 350px; overflow-y: auto;">
                                <table class="table table-sm table-hover mb-0">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th style="width: 40px;">
                                                <input type="checkbox" class="form-check-input" data-bind="checked: selectAll" title="Tumunu Sec">
                                            </th>
                                            <th>Personel</th>
                                            <th>Musteri</th>
                                            <!-- Dinamik Scope Kolonlari -->
                                            <!-- ko foreach: scopeColumnHeaders -->
                                            <th class="text-center" style="min-width: 100px;" data-bind="text: $data"></th>
                                            <!-- /ko -->
                                            <th class="text-center" style="width: 100px;">Ort. Puan</th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="foreach: visiblePersonnel">
                                        <tr data-bind="css: { 'table-warning': avgScore < 50, 'table-danger': avgScore < 30 }">
                                            <td>
                                                <input type="checkbox" class="form-check-input" data-bind="checked: selected">
                                            </td>
                                            <td>
                                                <span data-bind="text: userName"></span>
                                                <!-- ko if: email -->
                                                <br><small class="text-muted" data-bind="text: email"></small>
                                                <!-- /ko -->
                                            </td>
                                            <td>
                                                <small data-bind="text: customerName || '-'"></small>
                                            </td>
                                            <!-- Dinamik Scope Puanlari -->
                                            <!-- ko foreach: scopeScores -->
                                            <td class="text-center">
                                                <span class="badge" data-bind="text: score !== null ? score.toFixed(1) + '%' : '-',
                                                    css: { 'bg-danger': score !== null && score < 30, 'bg-warning text-dark': score !== null && score >= 30 && score < 50, 'bg-info': score !== null && score >= 50 && score < 70, 'bg-success': score !== null && score >= 70, 'bg-secondary': score === null }"></span>
                                            </td>
                                            <!-- /ko -->
                                            <td class="text-center">
                                                <strong class="badge" data-bind="text: avgScore.toFixed(1) + '%',
                                                    css: { 'bg-danger': avgScore < 30, 'bg-warning text-dark': avgScore >= 30 && avgScore < 50, 'bg-info': avgScore >= 50 && avgScore < 70, 'bg-success': avgScore >= 70 }"></strong>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Empty State -->
                            <div data-bind="visible: !isLoadingPersonnel() && personnelWithScores().length === 0" class="text-center py-4 text-muted">
                                <i class="bi bi-info-circle fs-3"></i>
                                <p class="mb-0 mt-2">Bu kriterlere uyan personel bulunamadi</p>
                            </div>

                            <div class="d-flex justify-content-between mt-4">
                                <button type="button" class="btn btn-outline-secondary" data-bind="click: goToStep2">
                                    <i class="bi bi-arrow-left"></i> Geri
                                </button>
                                <button type="button" class="btn btn-primary" data-bind="click: goToStep4, disable: selectedCount() === 0">
                                    Ozete Git <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                        </div>

                        <!-- STEP 4: Summary -->
                        <div class="tab-pane fade" id="step4" role="tabpanel">
                            <h6 class="border-bottom pb-2 mb-3"><i class="bi bi-check-circle me-2"></i>Atama Ozeti</h6>

                            <div class="row">
                                <div class="col-md-6">
                                    <!-- Temel Bilgiler -->
                                    <div class="card mb-3">
                                        <div class="card-header bg-light py-2">
                                            <i class="bi bi-info-circle me-2"></i>Temel Bilgiler
                                        </div>
                                        <div class="card-body py-2">
                                            <table class="table table-sm mb-0">
                                                <tr>
                                                    <th style="width: 40%;">Atama Basligi:</th>
                                                    <td><strong data-bind="text: formTitle"></strong></td>
                                                </tr>
                                                <tr>
                                                    <th>Video:</th>
                                                    <td><span class="badge bg-primary" data-bind="text: selectedVideoTitle"></span></td>
                                                </tr>
                                                <tr>
                                                    <th>Baslangic:</th>
                                                    <td data-bind="text: formatDate(formStartDate())"></td>
                                                </tr>
                                                <tr>
                                                    <th>Bitis:</th>
                                                    <td data-bind="text: formatDate(formDueDate())"></td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>

                                    <!-- Izleme Ayarlari -->
                                    <div class="card mb-3">
                                        <div class="card-header bg-light py-2">
                                            <i class="bi bi-gear me-2"></i>Izleme Ayarlari
                                        </div>
                                        <div class="card-body py-2">
                                            <table class="table table-sm mb-0">
                                                <tr>
                                                    <th style="width: 40%;">Min Izleme:</th>
                                                    <td data-bind="text: (formMinWatchCount() || 1) + ' kere'"></td>
                                                </tr>
                                                <tr>
                                                    <th>Max Izleme:</th>
                                                    <td data-bind="text: formMaxWatchCount() ? formMaxWatchCount() + ' kere' : 'Sinirsiz'"></td>
                                                </tr>
                                                <tr>
                                                    <th>Hiz Degisimi:</th>
                                                    <td>
                                                        <span data-bind="visible: formAllowSpeedChange" class="badge bg-success">Izin var</span>
                                                        <span data-bind="visible: !formAllowSpeedChange()" class="badge bg-danger">Izin yok</span>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <th>Ileri/Geri Sarma:</th>
                                                    <td>
                                                        <span data-bind="visible: formAllowSeeking" class="badge bg-success">Izin var</span>
                                                        <span data-bind="visible: !formAllowSeeking()" class="badge bg-danger">Izin yok</span>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <!-- Email Ayarlari -->
                                    <div class="card mb-3">
                                        <div class="card-header bg-light py-2">
                                            <i class="bi bi-envelope me-2"></i>Email Ayarlari
                                        </div>
                                        <div class="card-body py-2">
                                            <table class="table table-sm mb-0">
                                                <tr>
                                                    <th style="width: 40%;">Email Gonder:</th>
                                                    <td>
                                                        <span data-bind="visible: formSendEmail" class="badge bg-success">Evet</span>
                                                        <span data-bind="visible: !formSendEmail()" class="badge bg-secondary">Hayir</span>
                                                    </td>
                                                </tr>
                                                <tr data-bind="visible: formSendEmail">
                                                    <th>Sablon:</th>
                                                    <td data-bind="text: selectedEmailTemplateName() || 'Varsayilan'"></td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>

                                    <!-- Personel Ozeti -->
                                    <div class="card mb-3">
                                        <div class="card-header bg-light py-2">
                                            <i class="bi bi-people me-2"></i>Secilen Personel
                                        </div>
                                        <div class="card-body py-2">
                                            <div class="d-flex align-items-center justify-content-center">
                                                <div class="text-center">
                                                    <h2 class="mb-0 text-primary" data-bind="text: selectedCount()"></h2>
                                                    <span class="text-muted">kisi</span>
                                                </div>
                                            </div>
                                            <div class="mt-2" data-bind="visible: selectedPersonnelPreview().length > 0">
                                                <ul class="list-unstyled mb-0 small" style="max-height: 100px; overflow-y: auto;">
                                                    <!-- ko foreach: selectedPersonnelPreview -->
                                                    <li><i class="bi bi-person me-1"></i><span data-bind="text: userName"></span></li>
                                                    <!-- /ko -->
                                                    <!-- ko if: selectedCount() > 5 -->
                                                    <li class="text-muted">... ve <span data-bind="text: selectedCount() - 5"></span> kisi daha</li>
                                                    <!-- /ko -->
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="alert alert-warning mb-3">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                Lutfen yukaridaki bilgileri kontrol edin. "Atamayi Olustur" butonuna tikladiginizda islem geri alinamaz.
                            </div>

                            <div class="d-flex justify-content-between">
                                <button type="button" class="btn btn-outline-secondary" data-bind="click: goToStep3">
                                    <i class="bi bi-arrow-left"></i> Geri
                                </button>
                                <button type="button" class="btn btn-success btn-lg" data-bind="click: createAssignment, disable: isSaving">
                                    <span data-bind="visible: !isSaving()"><i class="bi bi-check-lg me-1"></i> Atamayi Olustur</span>
                                    <span data-bind="visible: isSaving"><span class="spinner-border spinner-border-sm"></span> Olusturuluyor...</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Participants Modal -->
    <div class="modal fade" id="participantsModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-people me-2"></i>Katilimcilar</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
