                                    <div class="mb-3">
                                        <label class="form-label">Proje</label>
                                        <select class="form-select" data-bind="value: formProjectId, options: filteredProjects, optionsValue: 'id', optionsText: 'name', optionsCaption: 'Tum projeler...'"></select>
                                        <small class="text-muted" data-bind="visible: filteredProjects().length > 0">
