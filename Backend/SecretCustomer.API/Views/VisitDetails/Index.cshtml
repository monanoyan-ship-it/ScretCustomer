@{
    ViewData["Title"] = Html.T("VisitDetails.Title", "Ziyaret Detay Yönetimi");
}

<div id="visit-details-app" class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@Html.T("VisitDetails.Title", "Ziyaret Detay Yönetimi")</h2>
    </div>

    <!-- Error/Success Messages -->
    <div data-bind="visible: errorMessage" class="alert alert-danger alert-dismissible fade show">
        <span data-bind="text: errorMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { errorMessage(''); }"></button>
    </div>
    <div data-bind="visible: successMessage" class="alert alert-success alert-dismissible fade show">
        <span data-bind="text: successMessage"></span>
        <button type="button" class="btn-close" data-bind="click: function() { successMessage(''); }"></button>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="sectors-tab" data-bs-toggle="tab" data-bs-target="#sectors-panel"
                    type="button" role="tab" aria-controls="sectors-panel" aria-selected="true">
                <i class="bi bi-grid me-2"></i>@Html.T("VisitDetails.Sectors", "Sektörler")
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="fields-tab" data-bs-toggle="tab" data-bs-target="#fields-panel"
                    type="button" role="tab" aria-controls="fields-panel" aria-selected="false">
                <i class="bi bi-list-columns me-2"></i>@Html.T("VisitDetails.FieldDefinitions", "Alan Tanımları")
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content">
        <!-- Sectors Tab -->
        <div class="tab-pane fade show active" id="sectors-panel" role="tabpanel" aria-labelledby="sectors-tab">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4>@Html.T("VisitDetails.SectorList", "Sektör Listesi")</h4>
                <button class="btn btn-primary" data-bind="click: createSector">
                    <i class="bi bi-plus-circle me-2"></i>@Html.T("VisitDetails.NewSector", "Yeni Sektör")
                </button>
            </div>

            <!-- Loading -->
            <div data-bind="visible: isLoadingSectors" class="text-center py-5">
                <div class="spinner-border text-primary"></div>
            </div>

            <!-- Empty State -->
            <div data-bind="visible: !isLoadingSectors() && sectors().length === 0" class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>@Html.T("VisitDetails.NoSectors", "Henüz sektör tanımlanmamış.")
            </div>

            <!-- Sectors Table -->
            <div data-bind="visible: !isLoadingSectors() && sectors().length > 0" class="card shadow">
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 60px;">#</th>
                                <th>@Html.T("Common.Code", "Kod")</th>
                                <th>@Html.T("Common.Name", "Ad")</th>
                                <th>@Html.T("Common.Description", "Açıklama")</th>
                                <th class="text-center">@Html.T("VisitDetails.FieldCount", "Alan Sayısı")</th>
                                <th class="text-center">@Html.T("Common.Status", "Durum")</th>
                                <th style="width: 150px;">@Html.T("Common.Actions", "İşlemler")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: sectors">
                            <tr>
                                <td data-bind="text: sortOrder"></td>
                                <td>
                                    <span class="badge bg-secondary" data-bind="text: code"></span>
                                </td>
                                <td>
                                    <i class="me-2" data-bind="class: iconClass || 'bi-folder'"></i>
                                    <span data-bind="text: name"></span>
                                </td>
                                <td data-bind="text: description || '-'"></td>
                                <td class="text-center">
                                    <span class="badge bg-info" data-bind="text: fieldCount || 0"></span>
                                </td>
                                <td class="text-center">
                                    <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-danger', text: isActive ? '@Html.T("Common.Active", "Aktif")' : '@Html.T("Common.Inactive", "Pasif")'"></span>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1" data-bind="click: $parent.editSector" title="@Html.T("Common.Edit", "Düzenle")">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-info me-1" data-bind="click: $parent.viewSectorFields" title="@Html.T("VisitDetails.ViewFields", "Alanları Görüntüle")">
                                        <i class="bi bi-list-ul"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deleteSector" title="@Html.T("Common.Delete", "Sil")">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Field Definitions Tab -->
        <div class="tab-pane fade" id="fields-panel" role="tabpanel" aria-labelledby="fields-tab">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center">
                    <h4 class="mb-0 me-3">@Html.T("VisitDetails.FieldDefinitionList", "Alan Tanımları")</h4>
                    <select class="form-select" style="width: 250px;" data-bind="value: selectedSectorIdForFields, options: sectorOptions, optionsText: 'name', optionsValue: 'id', optionsCaption: '@Html.T("VisitDetails.AllSectors", "Tüm Sektörler")'"></select>
                </div>
                <button class="btn btn-primary" data-bind="click: createField">
                    <i class="bi bi-plus-circle me-2"></i>@Html.T("VisitDetails.NewField", "Yeni Alan")
                </button>
            </div>

            <!-- Loading -->
            <div data-bind="visible: isLoadingFields" class="text-center py-5">
                <div class="spinner-border text-primary"></div>
            </div>

            <!-- Empty State -->
            <div data-bind="visible: !isLoadingFields() && filteredFields().length === 0" class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>@Html.T("VisitDetails.NoFields", "Henüz alan tanımı yapılmamış.")
            </div>

            <!-- Fields Table -->
            <div data-bind="visible: !isLoadingFields() && filteredFields().length > 0" class="card shadow">
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 60px;">#</th>
                                <th>@Html.T("Common.Code", "Kod")</th>
                                <th>@Html.T("Common.Name", "Ad")</th>
                                <th>@Html.T("VisitDetails.Sector", "Sektör")</th>
                                <th>@Html.T("VisitDetails.FieldType", "Alan Tipi")</th>
                                <th>@Html.T("VisitDetails.Category", "Kategori")</th>
                                <th class="text-center">@Html.T("VisitDetails.Required", "Zorunlu")</th>
                                <th class="text-center">@Html.T("Common.Status", "Durum")</th>
                                <th style="width: 120px;">@Html.T("Common.Actions", "İşlemler")</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: filteredFields">
                            <tr>
                                <td data-bind="text: sortOrder"></td>
                                <td>
                                    <code data-bind="text: code"></code>
                                </td>
                                <td data-bind="text: name"></td>
                                <td>
                                    <!-- ko if: sectorName -->
                                    <span class="badge bg-primary" data-bind="text: sectorName"></span>
                                    <!-- /ko -->
                                    <!-- ko ifnot: sectorName -->
                                    <span class="badge bg-secondary">@Html.T("VisitDetails.Common", "Ortak")</span>
                                    <!-- /ko -->
                                </td>
                                <td>
                                    <span class="badge bg-info" data-bind="text: $parent.getFieldTypeName(fieldType)"></span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary" data-bind="text: $parent.getCategoryName(category)"></span>
                                </td>
                                <td class="text-center">
                                    <i data-bind="css: isRequired ? 'bi bi-check-circle-fill text-success' : 'bi bi-circle text-muted'"></i>
                                </td>
                                <td class="text-center">
                                    <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-danger', text: isActive ? '@Html.T("Common.Active", "Aktif")' : '@Html.T("Common.Inactive", "Pasif")'"></span>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary me-1" data-bind="click: $parent.editField" title="@Html.T("Common.Edit", "Düzenle")">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deleteField" title="@Html.T("Common.Delete", "Sil")">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Sector Modal -->
    <div class="modal fade" data-bind="css: { show: isSectorModalOpen }, style: { display: isSectorModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" data-bind="with: editingSector">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <!-- ko ifnot: id -->
                        <i class="bi bi-plus-circle me-2"></i>@Html.T("VisitDetails.NewSector", "Yeni Sektör")
                        <!-- /ko -->
                        <!-- ko if: id -->
                        <i class="bi bi-pencil me-2"></i>@Html.T("VisitDetails.EditSector", "Sektör Düzenle")
                        <!-- /ko -->
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: $parent.closeSectorModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Common.Code", "Kod") <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" data-bind="value: code" maxlength="50" placeholder="BANK, CAFE, HOTEL vb.">
                        <small class="text-muted">@Html.T("VisitDetails.CodeHelp", "Benzersiz sektör kodu (büyük harf, boşluksuz)")</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Common.Name", "Ad") <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" data-bind="value: name" maxlength="200">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Common.Description", "Açıklama")</label>
                        <textarea class="form-control" data-bind="value: description" rows="2" maxlength="500"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("VisitDetails.IconClass", "İkon Sınıfı")</label>
                            <input type="text" class="form-control" data-bind="value: iconClass" placeholder="bi-bank, bi-cup-hot vb.">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Common.SortOrder", "Sıra")</label>
                            <input type="number" class="form-control" data-bind="value: sortOrder" min="0">
                        </div>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="sectorIsActive" data-bind="checked: isActive">
                        <label class="form-check-label" for="sectorIsActive">@Html.T("Common.Active", "Aktif")</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closeSectorModal">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-primary" data-bind="click: $parent.saveSector, disable: $parent.isSaving">
                        <i class="bi bi-check-circle me-2"></i>@Html.T("Common.Save", "Kaydet")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isSectorModalOpen }, style: { display: isSectorModalOpen() ? 'block' : 'none' }"></div>

    <!-- Field Definition Modal -->
    <div class="modal fade" data-bind="css: { show: isFieldModalOpen }, style: { display: isFieldModalOpen() ? 'block' : 'none' }" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" data-bind="with: editingField">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <!-- ko ifnot: id -->
                        <i class="bi bi-plus-circle me-2"></i>@Html.T("VisitDetails.NewField", "Yeni Alan Tanımı")
                        <!-- /ko -->
                        <!-- ko if: id -->
                        <i class="bi bi-pencil me-2"></i>@Html.T("VisitDetails.EditField", "Alan Tanımı Düzenle")
                        <!-- /ko -->
                    </h5>
                    <button type="button" class="btn-close" data-bind="click: $parent.closeFieldModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("VisitDetails.Sector", "Sektör")</label>
                            <select class="form-select" data-bind="value: sectorId, options: $parent.sectorOptions, optionsText: 'name', optionsValue: 'id', optionsCaption: '@Html.T("VisitDetails.CommonField", "Ortak Alan (Tüm Sektörler)")'"></select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("VisitDetails.Category", "Kategori") <span class="text-danger">*</span></label>
                            <select class="form-select" data-bind="value: category, options: $parent.categoryOptions, optionsText: 'name', optionsValue: 'value'"></select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Common.Code", "Kod") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: code" maxlength="100" placeholder="wait_time, staff_count vb.">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("Common.Name", "Ad") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: name" maxlength="200">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Html.T("Common.Description", "Açıklama")</label>
                        <textarea class="form-control" data-bind="value: description" rows="2" maxlength="500"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">@Html.T("VisitDetails.FieldType", "Alan Tipi") <span class="text-danger">*</span></label>
                            <select class="form-select" data-bind="value: fieldType, options: $parent.fieldTypeOptions, optionsText: 'name', optionsValue: 'value'"></select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">@Html.T("Common.SortOrder", "Sıra")</label>
                            <input type="number" class="form-control" data-bind="value: sortOrder" min="0">
                        </div>
                        <div class="col-md-4 mb-3 d-flex align-items-end">
                            <div class="form-check me-3">
                                <input type="checkbox" class="form-check-input" id="fieldIsRequired" data-bind="checked: isRequired">
                                <label class="form-check-label" for="fieldIsRequired">@Html.T("VisitDetails.Required", "Zorunlu")</label>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="fieldIsActive" data-bind="checked: isActive">
                                <label class="form-check-label" for="fieldIsActive">@Html.T("Common.Active", "Aktif")</label>
                            </div>
                        </div>
                    </div>

                    <!-- Rating-specific fields -->
                    <div data-bind="visible: fieldType() == 5" class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">@Html.T("VisitDetails.MaxRating", "Maksimum Puan")</label>
                            <input type="number" class="form-control" data-bind="value: maxRating" min="1" max="10">
                        </div>
                    </div>

                    <!-- String-specific fields -->
                    <div data-bind="visible: fieldType() == 3" class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">@Html.T("VisitDetails.MaxLength", "Maksimum Uzunluk")</label>
                            <input type="number" class="form-control" data-bind="value: maxLength" min="1">
                        </div>
                    </div>

                    <!-- Numeric-specific fields -->
                    <div data-bind="visible: fieldType() == 0 || fieldType() == 1" class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">@Html.T("VisitDetails.MinValue", "Minimum Değer")</label>
                            <input type="number" class="form-control" data-bind="value: minValue" step="0.01">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">@Html.T("VisitDetails.MaxValue", "Maksimum Değer")</label>
                            <input type="number" class="form-control" data-bind="value: maxValue" step="0.01">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("VisitDetails.Placeholder", "Placeholder")</label>
                            <input type="text" class="form-control" data-bind="value: placeholder" maxlength="200">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">@Html.T("VisitDetails.HelpText", "Yardım Metni")</label>
                            <input type="text" class="form-control" data-bind="value: helpText" maxlength="500">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bind="click: $parent.closeFieldModal">
                        <i class="bi bi-x-circle me-2"></i>@Html.T("Common.Cancel", "İptal")
                    </button>
                    <button type="button" class="btn btn-primary" data-bind="click: $parent.saveField, disable: $parent.isSaving">
                        <i class="bi bi-check-circle me-2"></i>@Html.T("Common.Save", "Kaydet")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" data-bind="css: { show: isFieldModalOpen }, style: { display: isFieldModalOpen() ? 'block' : 'none' }"></div>

    <!-- Delete Confirmation -->
    <partial name="_DeleteConfirmationModal" />
</div>

@section Scripts {
    <script src="~/js/Shared/delete-confirmation.js"></script>
    <script src="~/js/VisitDetails/Index.js"></script>
}
