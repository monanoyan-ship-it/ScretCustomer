@{
    Layout = "_LayoutPopup";
    ViewData["Title"] = Html.T("Survey.Completed.Title", "Anket Tamamlandı").ToString();
}

<div class="text-center py-5">
    <div class="mb-4">
        <i class="bi bi-check-circle text-success icon-xxl"></i>
    </div>
    <h2 class="text-success mb-3">@Html.T("Survey.Completed.Thanks", "Teşekkürler!")</h2>
    <p class="lead text-muted mb-4">@Html.T("Survey.Completed.Success", "Anketiniz başarıyla gönderildi.")</p>
    <p class="text-muted">@Html.T("Survey.Completed.CloseWindow", "Katılımınız için teşekkür ederiz. Bu pencereyi kapatabilirsiniz.")</p>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/survey.css" />
}
