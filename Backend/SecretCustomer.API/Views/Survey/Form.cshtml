@{
    Layout = "_LayoutPopup";
    ViewData["Title"] = "Anket";
    var token = ViewBag.Token as string;
}

<div id="survey-app">
    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;"></div>
        <p class="mt-3 text-muted">Anket yükleniyor...</p>
    </div>

    <!-- Error -->
    <div data-bind="visible: !isLoading() && errorMessage()" class="text-center py-5">
        <i class="bi bi-exclamation-triangle text-danger" style="font-size: 4rem;"></i>
        <h4 class="mt-3 text-danger" data-bind="text: errorMessage"></h4>
        <p class="text-muted">Lütfen size gönderilen linki kontrol edin veya yöneticinize başvurun.</p>
    </div>

    <!-- Survey Form -->
    <div data-bind="visible: !isLoading() && !errorMessage() && surveyInfo()">
        <!-- Header -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h3 class="mb-1" data-bind="text: surveyInfo() ? surveyInfo().projectName : ''"></h3>
                        <p class="text-muted mb-0">
                            <span data-bind="text: surveyInfo() ? surveyInfo().customerName : ''"></span>
                            <!-- ko if: surveyInfo() && surveyInfo().organizationName -->
                            <span> | </span><span data-bind="text: surveyInfo().organizationName"></span>
                            <!-- /ko -->
                        </p>
                    </div>
                    <div class="text-end">
                        <!-- ko if: surveyInfo() && !surveyInfo().isAnonymous && surveyInfo().personnel -->
                        <span class="badge bg-primary fs-6">
                            <i class="bi bi-person me-1"></i>
                            <span data-bind="text: surveyInfo().personnel.fullName"></span>
                        </span>
                        <!-- /ko -->
                        <!-- ko if: surveyInfo() && surveyInfo().isAnonymous -->
                        <span class="badge bg-secondary fs-6">
                            <i class="bi bi-incognito me-1"></i> Anonim
                        </span>
                        <!-- /ko -->
                    </div>
                </div>
            </div>
        </div>

        <!-- Questions -->
        <div data-bind="visible: questions().length > 0">
            <!-- Question Groups -->
            <div data-bind="foreach: questionGroups">
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-dark text-white py-2">
                        <i class="bi bi-list-check me-2"></i>
                        <span data-bind="text: name"></span>
                        <span class="badge bg-light text-dark ms-2" data-bind="text: questions.length + ' soru'"></span>
                    </div>
                    <div class="list-group list-group-flush" data-bind="foreach: questions">
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="flex-grow-1">
                                    <span class="badge bg-secondary me-2" data-bind="text: '#' + order"></span>
                                    <strong data-bind="text: text"></strong>
                                    <!-- ko if: description -->
                                    <br><small class="text-muted" data-bind="text: description"></small>
                                    <!-- /ko -->
                                </div>
                            </div>

                            <!-- Answer Input -->
                            <div class="mt-2">
                                <!-- Score Input (if showScoreInput is true) -->
                                <!-- ko if: showScoreInput -->
                                <div class="btn-group" role="group">
                                    <!-- ko foreach: $root.getScoreOptions(maxPoints) -->
                                    <input type="radio" class="btn-check"
                                           data-bind="attr: { id: 'q' + $parent.id + '_' + $data, name: 'score_' + $parent.id },
                                                      checked: $parent.answer().score,
                                                      checkedValue: $data">
                                    <label class="btn btn-outline-primary btn-sm" data-bind="attr: { for: 'q' + $parent.id + '_' + $data }, text: $data"></label>
                                    <!-- /ko -->
                                </div>
                                <!-- /ko -->

                                <!-- SubCriteria Selection (if available) - Puanın altında -->
                                <!-- ko if: hasSubCriteria -->
                                <div class="mt-2">
                                    <small class="text-muted d-block mb-1">
                                        <!-- ko if: selectionTypeId === 1 -->
                                        <i class="bi bi-ui-radios"></i> Birini seçin:
                                        <!-- /ko -->
                                        <!-- ko if: selectionTypeId !== 1 -->
                                        <i class="bi bi-ui-checks"></i> Seçin (birden fazla seçilebilir):
                                        <!-- /ko -->
                                    </small>
                                    <div class="list-group list-group-flush" data-bind="foreach: subCriteria">
                                        <!-- Single Selection (Radio) -->
                                        <!-- ko if: $parent.selectionTypeId === 1 -->
                                        <label class="list-group-item list-group-item-action py-2 px-3"
                                               data-bind="css: { 'active': isSelected() }, click: function() { $root.selectSubCriteria($parent, $data); }">
                                            <input type="radio" class="form-check-input me-2"
                                                   data-bind="attr: { name: 'subcriteria_' + $parent.id }, checked: isSelected">
                                            <span data-bind="text: description"></span>
                                        </label>
                                        <!-- /ko -->
                                        <!-- Multiple Selection (Checkbox) -->
                                        <!-- ko if: $parent.selectionTypeId !== 1 -->
                                        <label class="list-group-item list-group-item-action py-2 px-3"
                                               data-bind="css: { 'active': isSelected() }, click: function() { $root.selectSubCriteria($parent, $data); }">
                                            <input type="checkbox" class="form-check-input me-2" data-bind="checked: isSelected">
                                            <span data-bind="text: description"></span>
                                        </label>
                                        <!-- /ko -->
                                    </div>
                                </div>
                                <!-- /ko -->

                                <!-- Comment (if allowComment is true) - En sonda -->
                                <!-- ko if: allowComment -->
                                <div class="mt-2">
                                    <input type="text" class="form-control form-control-sm"
                                           placeholder="Yorum (opsiyonel)"
                                           data-bind="value: answer().comment">
                                </div>
                                <!-- /ko -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Submit -->
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="text-muted">
                        <span data-bind="text: answeredCount"></span> / <span data-bind="text: questions().length"></span> soru cevaplandı
                    </div>
                    <button type="button" class="btn btn-success btn-lg"
                            data-bind="click: submitSurvey, disable: isSubmitting() || answeredCount() === 0">
                        <span data-bind="visible: !isSubmitting()">
                            <i class="bi bi-send me-2"></i>Anketi Gönder
                        </span>
                        <span data-bind="visible: isSubmitting">
                            <span class="spinner-border spinner-border-sm me-2"></span>Gönderiliyor...
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    window.surveyConfig = {
        token: '@(token ?? "")'
    };
</script>

@section Scripts {
    <script src="~/js/Survey/form.js"></script>
}
